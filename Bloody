local AimCore = { prediction = 1, easing = 0.8, cooldown = false }
local function PredictNext(part)
    if not part then return Vector3.zero end
    return part.Position + part.AssemblyLinearVelocity * AimCore.prediction
end
local function SyncAimbot(targetPart, duration)
    if not targetPart or AimCore.cooldown then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    AimCore.cooldown = true
    local t0 = os.clock()
    local conn
    conn = RunService.PostSimulation:Connect(function()
        if os.clock() - t0 >= (duration or 1) or not targetPart or not targetPart.Parent then
            AimCore.cooldown = false
            if conn then conn:Disconnect() end
            return
        end
        if not hrp.Parent then return end
        local pred = PredictNext(targetPart)
        local flat = Vector3.new(pred.X, hrp.Position.Y, pred.Z)
        if (flat - hrp.Position).Magnitude < 0.01 then return end
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, flat), AimCore.easing)
    end)
    TrackConnection(conn)
end
