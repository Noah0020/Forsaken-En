-- Ability-name filters. Matching is case-insensitive and uses plain substring checks.
-- "shot" catches OneShot, ShotgunShot, and any other name containing "shot".
-- Backstab is checked before stab so it keeps its more specific label.
local aimAbilityNameFilters = { "slash", "shot", "hatchet", "backstab", "stab" }

local function getMatchingAimKeyword(value)
    if type(value) ~= "string" or value == "" then return nil end
    local normalized = string.lower(value)
    for _, keyword in ipairs(aimAbilityNameFilters) do
        if string.find(normalized, keyword, 1, true) then return keyword end
    end
    return nil
end

-- Uses the source-pack animation-type lookup pattern, but listens to the
-- local survivor Animator. IDs are indexed from Survivor/Killer/Skin configs.
local function getM1TypeFromConfigPath(path)
    local token = string.lower(tostring(path or "")):gsub("[^%w]", "")
    -- Killer-specific attack identifiers. Check the longer/special names first
    -- so they cannot be swallowed by the generic "slash" match.
    if string.find(token, "enragedslash", 1, true) then return "enragedslash" end
    if string.find(token, "eviscerate", 1, true) then return "eviscerate" end
    if string.find(token, "perforating", 1, true) then return "perforating" end
    if string.find(token, "lacerate", 1, true) or string.find(token, "laceration", 1, true) then return "lacerate" end
    if string.find(token, "coolkidm1nm", 1, true) or token == "tag" then return "tag" end
    if string.find(token, "g666slash", 1, true) then return "g666slash" end
    if string.find(token, "guestm1", 1, true) then return "guestm1" end
    if string.find(token, "carvingslash", 1, true) then return "carvingslash" end
    if string.find(token, "parry", 1, true) then return "parry" end
    if string.find(token, "block", 1, true) then return "block" end
    if string.find(token, "punch", 1, true) then return "punch" end
    if string.find(token, "backstab", 1, true) then return "backstab" end
    if string.find(token, "hatchet", 1, true) then return "hatchet" end
    if string.find(token, "shot", 1, true) then return "shot" end
    if token == "stab" or string.find(token, "nolim1stab", 1, true) then return "stab" end
    if string.find(token, "slash", 1, true) then return "slash" end
    return nil
end

function AttackLunge.isAttackAnimationPath(path)
    local token = string.lower(tostring(path or "")):gsub("[^%w]", "")
    local blocked = { "idle", "walk", "run", "sprint", "stun", "hurt", "death", "emote", "victory", "intro", "crouch" }
    for _, word in ipairs(blocked) do
        if string.find(token, word, 1, true) then return false end
    end
    local attackWords = {
        "slash", "shot", "hatchet", "backstab", "stab", "carving", "eviscerate",
        "perforating", "lacerate", "tag", "m1", "attack", "parry", "block",
        "punch", "strike", "hit", "swing", "sword", "knife", "punching",
    }
    for _, word in ipairs(attackWords) do
        if string.find(token, word, 1, true) then return true end
    end
    return false
end

local function indexAimAnimationIds(value, path, depth, characterName, sourceCategory)
    if depth > 8 then return end
    if type(value) == "string" then
        local keyword = getMatchingAimKeyword(path)
        local m1Type = getM1TypeFromConfigPath(path)
        local id = string_match(value, "%d+")
        -- Survivor configs are indexed first; don't let a later killer/skin
        -- config overwrite a matching animation ID.
        if id and keyword and not aimAnimationTypeById[id] then aimAnimationTypeById[id] = keyword end
        if id and m1Type and not m1AnimationTypeById[id] then m1AnimationTypeById[id] = m1Type end
        if id and sourceCategory == "Survivors" and AttackLunge.isAttackAnimationPath(path) then
            AttackLunge.animationIds[id] = true
            AttackLunge.characterById[id] = AttackLunge.characterById[id] or characterName
        end
    elseif type(value) == "table" then
        for key, child in pairs(value) do
            local nextPath = (path ~= "" and (path .. " ") or "") .. tostring(key)
            indexAimAnimationIds(child, nextPath, depth + 1, characterName, sourceCategory)
        end
    end
end

function AttackLunge.getConfigCharacterName(module, root)
    local node = module
    while node and node.Parent and node.Parent ~= root do
        node = node.Parent
    end
    if node and node.Parent == root then return node.Name end
    return module.Parent and module.Parent.Name or "Unknown"
end

local function indexAimConfigModule(module, root)
    if not module or not module:IsA("ModuleScript") or module.Name ~= "Config" then return end
    local ok, config = pcall(require, module)
    if ok and type(config) == "table" and type(config.Animations) == "table" then
        local category = root and root.Name or ""
        local characterName = root and AttackLunge.getConfigCharacterName(module, root) or "Unknown"
        if category == "Survivors" then
            AttackLunge.characterEnabled[characterName] = true
            AttackLunge.characterOptions[characterName] = true
        end
        indexAimAnimationIds(config.Animations, "", 0, characterName, category)
    end
end

local function buildAimAnimationIdIndex()
    local assets = ReplicatedStorage:FindFirstChild("Assets") or ReplicatedStorage:WaitForChild("Assets", 10)
    if not assets then return end
    -- Mirror the source-pack GetAnimationType approach: build an ID -> animation-type
    -- lookup from the game's own survivor, killer, and skin Config modules.
    local roots = {
        assets:FindFirstChild("Survivors"),
        assets:FindFirstChild("Killers"),
        assets:FindFirstChild("Skins"),
    }
    for _, root in ipairs(roots) do
        if root then
            for _, module in ipairs(root:GetDescendants()) do
                indexAimConfigModule(module, root)
            end
        end
    end
    -- Also index Config modules that appear after the initial pass.
    assets.DescendantAdded:Connect(function(instance)
        if instance:IsA("ModuleScript") and instance.Name == "Config" then
            local root = instance
            while root and root.Parent ~= assets do root = root.Parent end
            if root and (root.Name == "Survivors" or root.Name == "Killers" or root.Name == "Skins") then
                task.defer(indexAimConfigModule, instance, root)
            end
        end
    end)
end

local function getAnimationAbilityName(track)
    if not track then return nil, nil end
    local animation = track.Animation
    local candidates = {
        track.Name,
        animation and animation.Name,
        track:GetAttribute("AbilityName"),
        animation and animation:GetAttribute("AbilityName"),
    }
    for _, candidate in ipairs(candidates) do
        local keyword = getMatchingAimKeyword(candidate)
        if keyword then return candidate, keyword end
    end
    local animId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")
    local mappedKeyword = animId and aimAnimationTypeById[animId]
    if mappedKeyword then return mappedKeyword, mappedKeyword end
    return nil, nil
end

local hitboxDraggingTech = false
local HITBOX_DRAG_DURATION = 1.4
local Dspeed = 5.6
local Ddelay = 0
local hdtActiveDrag = nil

-- Block animation IDs from the supplied Ivy.lua HDT implementation.
local hdtBlockAnimSet = {
    ["72722244508749"] = true, ["96959123077498"] = true,
    ["95802026624883"] = true, ["140671644163156"] = true,
    ["100926346851492"] = true,
}
-- Treat the existing HDT block/parry animation IDs as attack triggers too,
-- so Guest's parry/block animation path can activate the same lunge handler.
for animationId in pairs(hdtBlockAnimSet) do
    AttackLunge.animationIds[animationId] = true
end

local function getNearestHDTKiller()
    local char = lp.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDistance = nil, math.huge
    for _, killer in ipairs(KillersFolder:GetChildren()) do
        if killer:IsA("Model") then
            local root = killer:FindFirstChild("HumanoidRootPart")
            local hum = killer:FindFirstChildOfClass("Humanoid")
            if root and (not hum or hum.Health > 0) then
                local distance = (root.Position - myRoot.Position).Magnitude
                if distance < closestDistance then
                    closest, closestDistance = killer, distance
                end
            end
        end
    end
    return closest
end

local function snapPunchAim(targetKiller)
    if not punchAimEnabled then return end
    local char = lp.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local killer = (targetKiller and targetKiller.Parent == KillersFolder) and targetKiller or getNearestHDTKiller()
    local targetRoot = killer and killer:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local predictedPosition = targetRoot.Position
        + targetRoot.AssemblyLinearVelocity * 0.06
        + targetRoot.CFrame.LookVector * punchAimPrediction
    local flatTarget = Vector3.new(predictedPosition.X, myRoot.Position.Y, predictedPosition.Z)
    if (flatTarget - myRoot.Position).Magnitude < 0.05 then return end

    if punchAimMode == "Character Lock" or punchAimMode == "Character + Camera Lock" then
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, flatTarget)
    end
    if punchAimMode == "Camera Lock" or punchAimMode == "Character + Camera Lock" then
        local camera = Workspace.CurrentCamera
        if camera then camera.CFrame = CFrame.lookAt(camera.CFrame.Position, predictedPosition) end
    end
end

-- Small optional movement correction on recognised local survivor attack
-- animations. Distance is user-adjustable and character filters are opt-in.
function AttackLunge.getLocalSurvivorCharacterKey()
    local char = lp.Character
    if not char then return nil end
    local candidates = {
        char:GetAttribute("CharacterName"),
        char:GetAttribute("SurvivorName"),
        char:GetAttribute("ActorName"),
        char.Name,
    }
    for _, candidate in ipairs(candidates) do
        if type(candidate) == "string" and candidate ~= "" then
            local key = string.lower(candidate):gsub("[^%w]", "")
            for configuredName in pairs(AttackLunge.characterOptions) do
                if string.lower(configuredName):gsub("[^%w]", "") == key then
                    return configuredName
                end
            end
        end
    end
    return nil
end

function AttackLunge.isAllowedForLocalCharacter(animationId)
    local mappedCharacter = animationId and AttackLunge.characterById[animationId]
    local localCharacter = AttackLunge.getLocalSurvivorCharacterKey()
    local characterName = mappedCharacter or localCharacter
    if not characterName then return true end -- fail open if the game doesn't expose a matching character name
    return AttackLunge.characterEnabled[characterName] ~= false
end

local function lungeTowardNearestKiller()
    if not AttackLunge.enabled then return end
    local now = tick_ref()
    if now - AttackLunge.lastAt < AttackLunge.cooldown then return end

    local char = lp.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not myRoot or not humanoid or humanoid.Health <= 0 then return end

    local killer = getNearestHDTKiller()
    local targetRoot = killer and killer:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local offset = targetRoot.Position - myRoot.Position
    local flatOffset = Vector3.new(offset.X, 0, offset.Z)
    local distance = flatOffset.Magnitude
    if distance < 0.05 then return end

    -- Preserve height and leave a small gap rather than moving through the target.
    local moveDistance = math.min(AttackLunge.studs, math.max(0, distance - 1.5))
    if moveDistance < 0.05 then return end

    AttackLunge.lastAt = now
    myRoot.CFrame = myRoot.CFrame + flatOffset.Unit * moveDistance
end

local function stopHDTDrag()
    local drag = hdtActiveDrag
    if not drag then return end
    hdtActiveDrag = nil
    if drag.connection then pcall(function() drag.connection:Disconnect() end) end
    if drag.velocity then pcall(function() drag.velocity:Destroy() end) end
    if drag.humanoid and drag.humanoid.Parent then
        drag.humanoid.WalkSpeed = drag.walkSpeed
        drag.humanoid.JumpPower = drag.jumpPower
    end
end

local function beginHDTDrag(killer)
    if not hitboxDraggingTech or hdtActiveDrag or not killer or not killer.Parent then return end
    local char = lp.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local targetRoot = killer:FindFirstChild("HumanoidRootPart")
    if not myRoot or not humanoid or not targetRoot then return end

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "BloodsakenHDTVelocity"
    velocity.MaxForce = Vector3.new(100000, 0, 100000)
    velocity.P = 15000
    velocity.Velocity = Vector3.zero
    velocity.Parent = myRoot

    local drag = {
        velocity = velocity,
        humanoid = humanoid,
        walkSpeed = humanoid.WalkSpeed,
        jumpPower = humanoid.JumpPower,
    }
    hdtActiveDrag = drag
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0

    drag.connection = RunService.Heartbeat:Connect(function()
        if hdtActiveDrag ~= drag or not hitboxDraggingTech
            or not myRoot.Parent or not killer.Parent then
            stopHDTDrag()
            return
        end
        targetRoot = killer:FindFirstChild("HumanoidRootPart")
        if not targetRoot then stopHDTDrag(); return end
        local offset = targetRoot.Position - myRoot.Position
        local horizontal = Vector3.new(offset.X, 0, offset.Z)
        if horizontal.Magnitude > 0.05 then
            local direction = horizontal.Unit
            velocity.Velocity = Vector3.new(direction.X * Dspeed, 0, direction.Z * Dspeed)
        else
            velocity.Velocity = Vector3.zero
        end
        if offset.Magnitude <= 2 then stopHDTDrag() end
    end)
    task.delay(math.max(0.15, HITBOX_DRAG_DURATION), function()
        if hdtActiveDrag == drag then stopHDTDrag() end
    end)
end

local function onLocalAnimationPlayed(track)
    if not track then return end
    local animation = track.Animation
    local animId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")

    -- Aim/lunge are triggered by the LOCAL survivor's animation event, not
    -- by the killer's Animator. Resolve the animation type by name, then ID.
    local abilityName, abilityKeyword = getAnimationAbilityName(track)
    local mappedM1Type = animId and m1AnimationTypeById[animId]
    local isMappedAttack = animId and AttackLunge.animationIds[animId]
    local isNamedAttack = abilityKeyword ~= nil or getM1TypeFromConfigPath(
        tostring_ref(track.Name) .. " " .. tostring_ref(animation and animation.Name or "")
    ) ~= nil
    if AttackLunge.enabled and (isMappedAttack or mappedM1Type or isNamedAttack)
        and AttackLunge.isAllowedForLocalCharacter(animId) then
        lungeTowardNearestKiller()
    end
    if punchAimEnabled then
        if abilityKeyword then
            local now = tick_ref()
            local debounceKey = animId or string.lower(tostring_ref(abilityName))
            local previous = lastPunchAimByAnimationId[debounceKey]
            if not previous or now - previous >= punchAimCooldown then
                lastPunchAimByAnimationId[debounceKey] = now
                local killer = getNearestHDTKiller()
                if killer then snapPunchAim(killer) end
            end
        elseif aimDebugUnknownAnimations and animId and not loggedUnknownAimAnimations[animId] then
            loggedUnknownAimAnimations[animId] = true
            warn("[Bloodsaken Aim Tracker] Unmatched local animation ID: " .. animId
                .. " | track=" .. tostring_ref(track.Name)
                .. " | animation=" .. tostring_ref(animation and animation.Name or "?"))
        end
    end

    -- HDT continues to use its own local block-animation ID list.
    if animId and hitboxDraggingTech and hdtBlockAnimSet[animId] and not hdtActiveDrag then
        local killer = getNearestHDTKiller()
        if killer then
            task.delay(math.max(0, Ddelay), function()
                if hitboxDraggingTech and not hdtActiveDrag then beginHDTDrag(killer) end
            end)
        end
    end
end

local function bindAimAnimator(character)
    if aimAnimatorConnection then
        pcall(function() aimAnimatorConnection:Disconnect() end)
        aimAnimatorConnection = nil
    end
    character = character or lp.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5))
    if animator then aimAnimatorConnection = animator.AnimationPlayed:Connect(onLocalAnimationPlayed) end
end

-- Build the animation-ID index once, then listen to the local survivor Animator.
pcall(buildAimAnimationIdIndex)
if lp.Character then task.spawn(bindAimAnimator, lp.Character) end
lp.CharacterAdded:Connect(function(character)
    stopHDTDrag()
    task.spawn(bindAimAnimator, character)
end)

