KB_R:AddLabel("Uses same animsToDetect list as Raging Pace")
KB_R:AddLabel("Auto Aim also uses the same list")
KB_R:AddLabel("Mode = which ability YOU fire")
KB_R:AddLabel("Auto = detect from your char name")
KB_R:AddInput("AB_AddAnim", { Text = "Add Anim ID to detection list",
    Default = "", Numeric = true, Finished = true,
    Callback = function(t)
        local id = tostring(t):match("%d+")
        if id then animsToDetect[id] = true; print("[Doggysaken] Added anim:", id) end
    end })

-- ==== AUTO AIM TAB ====
local AA_L = Tabs.AutoAim:AddLeftGroupbox("Aim Lock (shared animsToDetect)")
local AA_R = Tabs.AutoAim:AddRightGroupbox("Punch / Utility")

AA_L:AddToggle("AA_Enabled", { Text = "Auto Aim", Default = false, Callback = function(v) AUTO_AIM.Enabled = v end })
AA_L:AddSlider("AA_Duration", { Text = "Aim Lock Duration (s)", Default = 0.8, Min = 0.1, Max = 3, Rounding = 1,
    Callback = function(v) AUTO_AIM.Duration = v end })
AA_L:AddSlider("AA_Pred", { Text = "Prediction (studs ahead)", Default = 4, Min = 0, Max = 20, Rounding = 1,
    Callback = function(v) AUTO_AIM.Prediction = v end })
AA_L:AddDropdown("AA_Mode", { Text = "Aim Mode", Values = {"Character", "Camera"}, Default = "Character",
    Callback = function(v) AUTO_AIM.Mode = v end })
AA_L:AddButton({ Text = "Lock Aim Now (nearest)", Func = function()
    local killer = getNearestKillerModel()
    if killer then
        local plr = Players:GetPlayerFromCharacter(killer)
        if plr then startAimLock(plr) end
    end
end })

AA_R:AddToggle("AP_Enabled", { Text = "Auto Punch (parry)", Default = false, Callback = function(v) AUTO_PUNCH.Enabled = v end })
AA_R:AddButton({ Text = "Chat Visibility", Func = function()
    pcall(function()
        TextChatService.ChatWindowConfiguration.Enabled = true
        TextChatService.ChatInputBarConfiguration.Enabled = true
    end)
end })

