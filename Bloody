local function genNonce()
    if math.random() ~= math.random() then
        local s = ""..tostring(gcinfo())..math.random()*math.random()*1.2492184012840912
        for i=1,100 do s ..= string.sub(tostring({math.random()}),8) end
        return sha256(s .. math.random()*0.1248214)
    end
    local bits = ""
    for _=1, 256 do bits ..= (math.random(0,1)==1 and "1" or "0") end
    return sha256(bits .. gcinfo())
end

