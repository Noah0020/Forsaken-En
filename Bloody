local function IsRagdoll(m) local r=Workspace:FindFirstChild("Ragdolls"); return r and (m:IsDescendantOf(r) or m.Parent==r) end
local function IsSpectating(p) if not p then return false end local pf=Workspace:FindFirstChild("Players") if not pf then return false end local sp=pf:FindFirstChild("Spectating") return sp and sp:FindFirstChild(p.Name)~=nil end
local function GetGeneratorPart(model)
    if not model then return nil end
    local inst=model:FindFirstChild("Instances")
    if inst then local g=inst:FindFirstChild("Generator") if g then local c=g:FindFirstChild("Cube.003") if c and c:IsA("BasePart") then return c end for _,v in ipairs(g:GetDescendants()) do if v:IsA("BasePart") then return v end end end for _,v in ipairs(inst:GetDescendants()) do if v:IsA("BasePart") and tostring(v.Name):lower():find("cube") then return v end end end
    for _,v in ipairs(model:GetDescendants()) do if v:IsA("BasePart") then return v end end
    return nil
end

local function applyESPText(data)
    if not data or not data.model or not data.model.Parent then return end
    local m,isK=data.model,data.isKiller
    local showName=isK and ESPSettings.killerNameESP or (not isK and ESPSettings.survivorNameESP)
    local showHealth=isK and ESPSettings.killerHealthESP or (not isK and ESPSettings.survivorHealthESP)
    local showSkin=isK and ESPSettings.killerSkinESP or (not isK and ESPSettings.survivorSkinESP)
    if data.nameLabel and data.nameLabel.Parent then
        if showName then
            local dn=m:GetAttribute("ActorDisplayName") or (isK and "KILLER" or "SURVIVOR")
            if showSkin then local sn=m:GetAttribute("SkinNameDisplay") if sn and sn~="" then dn=dn.." | "..sn end end
            data.nameLabel.Text=dn; data.nameLabel.Visible=true
        else data.nameLabel.Visible=false end
    end
    if data.hpLabel and data.hpLabel.Parent then
        if showHealth then local h=m:FindFirstChild("Humanoid") if h then data.hpLabel.Text=string.format("HP: %d/%d",math.floor(h.Health),math.floor(h.MaxHealth)) end data.hpLabel.Visible=true
        else data.hpLabel.Visible=false end
    end
    if data.highlight and data.highlight.Parent then
        if isK then data.highlight.FillTransparency=ESPSettings.killerFillTransparency; data.highlight.OutlineTransparency=ESPSettings.killerOutlineTransparency
        else data.highlight.FillTransparency=ESPSettings.survivorFillTransparency; data.highlight.OutlineTransparency=ESPSettings.survivorOutlineTransparency end
    end
end

local function createPlayerESP(model,color,isKiller)
    if model:FindFirstChild("Fixsaken_Highlight") or IsRagdoll(model) then return end
    local hrp=model:FindFirstChild("HumanoidRootPart") if not hrp then return end
    local hl=Instance.new("Highlight") hl.Name="Fixsaken_Highlight" hl.Adornee=model hl.FillColor=color hl.OutlineColor=color
    hl.FillTransparency=isKiller and ESPSettings.killerFillTransparency or ESPSettings.survivorFillTransparency
    hl.OutlineTransparency=isKiller and ESPSettings.killerOutlineTransparency or ESPSettings.survivorOutlineTransparency
    hl.Parent=model
    local bb=Instance.new("BillboardGui") bb.Name="Fixsaken_Billboard" bb.Adornee=hrp bb.Size=UDim2.new(0,120,0,50) bb.StudsOffset=Vector3.new(0,4,0) bb.AlwaysOnTop=true bb.Parent=model
    local nl=Instance.new("TextLabel") nl.Size=UDim2.new(1,0,0.4,0) nl.BackgroundTransparency=1 nl.Font=Enum.Font.GothamMedium nl.TextColor3=color nl.TextSize=8 nl.TextStrokeTransparency=0.6 nl.Parent=bb
    local hp=Instance.new("TextLabel") hp.Size=UDim2.new(1,0,0.4,0) hp.Position=UDim2.new(0,0,0.4,0) hp.BackgroundTransparency=1 hp.Font=Enum.Font.GothamMedium hp.TextColor3=color hp.TextSize=8 hp.TextStrokeTransparency=0.6 hp.Parent=bb
    local data={model=model,nameLabel=nl,hpLabel=hp,isKiller=isKiller,highlight=hl}
    table.insert(PlayerESPData,data) applyESPText(data)
    model:GetAttributeChangedSignal("ActorDisplayName"):Connect(function() applyESPText(data) end)
    model:GetAttributeChangedSignal("SkinNameDisplay"):Connect(function() applyESPText(data) end)
    local hum=model:FindFirstChild("Humanoid") if hum then hum:GetPropertyChangedSignal("Health"):Connect(function() applyESPText(data) end) hum:GetPropertyChangedSignal("MaxHealth"):Connect(function() applyESPText(data) end) end
end

local function removePlayerESP(model)
    for i=#PlayerESPData,1,-1 do if PlayerESPData[i].model==model then table.remove(PlayerESPData,i) end end
    pcall(function() if model:FindFirstChild("Fixsaken_Highlight") then model.Fixsaken_Highlight:Destroy() end if model:FindFirstChild("Fixsaken_Billboard") then model.Fixsaken_Billboard:Destroy() end end)
end

local function CreateObjectESP(model,color,isGenerator,isItem,isPizza,isPizzaDelivery,isZombie,isTaph,isTripMine,isRespawn,isGraffiti,displayText)
    if not model or model:FindFirstChild("TAOWARE_Highlight") or IsRagdoll(model) then return end
    if isGenerator and model:FindFirstChild("Progress") and model.Progress.Value==100 then return end
    local tp
    if isGenerator then tp=GetGeneratorPart(model) elseif isItem then tp=model:FindFirstChild("ItemRoot")
    elseif isPizza or isPizzaDelivery or isZombie then tp=model:IsA("BasePart") and model or model:FindFirstChildWhichIsA("BasePart",true)
    elseif isTaph or isTripMine or isRespawn then tp=model:IsA("Model") and (GetGeneratorPart(model) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)) or model
    elseif isGraffiti then tp=model:IsA("BasePart") and model or model:FindFirstChildWhichIsA("BasePart",true) else return end
    if not tp then return end
    local hl=Instance.new("Highlight") hl.Name="TAOWARE_Highlight" hl.Adornee=model hl.FillColor=color hl.OutlineColor=color hl.FillTransparency=0.7 hl.OutlineTransparency=0.3 hl.Parent=model
    local bb=Instance.new("BillboardGui") bb.Name="TAOWARE_Billboard" bb.Adornee=tp bb.Size=UDim2.new(0,120,0,50) bb.StudsOffset=Vector3.new(0,4,0) bb.AlwaysOnTop=true bb.Parent=model
    local tl=Instance.new("TextLabel") tl.Size=UDim2.new(1,0,1,0) tl.BackgroundTransparency=1 tl.Text=displayText or (model:GetAttribute("Type") or model.Name) tl.Font=Enum.Font.GothamMedium tl.TextColor3=color tl.TextSize=8 tl.TextStrokeTransparency=0.6 tl.Parent=bb
    table.insert(ObjectESPData,{model=model,highlight=hl,billboard=bb})
end

local function RemoveObjectESP(model)
    if not model then return end
    for i=#ObjectESPData,1,-1 do if ObjectESPData[i].model==model then table.remove(ObjectESPData,i) end end
    pcall(function() if model:FindFirstChild("TAOWARE_Highlight") then model.TAOWARE_Highlight:Destroy() end if model:FindFirstChild("TAOWARE_Billboard") then model.TAOWARE_Billboard:Destroy() end end)
end

local function UpdateESP()
    local pf=Workspace:FindFirstChild("Players")
    if pf then
        local kf=pf:FindFirstChild("Killers") local sf=pf:FindFirstChild("Survivors")
        if kf then for _,k in ipairs(kf:GetChildren()) do
            if k==LP.Character then continue end
            if IsRagdoll(k) then removePlayerESP(k); continue end
            local p=Players:GetPlayerFromCharacter(k)
            if not p or IsSpectating(p) then removePlayerESP(k); continue end
            if ESPSettings.killerESP then if not k:FindFirstChild("Fixsaken_Highlight") then createPlayerESP(k,ESPSettings.killerColor,true) end
            else removePlayerESP(k) end
        end end
        if sf then for _,s in ipairs(sf:GetChildren()) do
            if s==LP.Character then continue end
            if IsRagdoll(s) then removePlayerESP(s); continue end
            local p=Players:GetPlayerFromCharacter(s)
            if not p or IsSpectating(p) then removePlayerESP(s); continue end
            if ESPSettings.playerESP then if not s:FindFirstChild("Fixsaken_Highlight") then createPlayerESP(s,ESPSettings.survivorColor,false) end
            else removePlayerESP(s) end
        end end
    end
    if not MapFolder then return end
    local ing=MapFolder
    if ing:FindFirstChild("Map") then
        for _,g in ipairs(ing.Map:GetChildren()) do
            if g:IsA("Model") and g.Name:lower():find("generator") and g.Name~="FakeGenerator" then
                local pr=g:FindFirstChild("Progress")
                if ESPSettings.generatorESP and pr and pr.Value<100 and not g:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(g,ESPSettings.generatorColor,true)
                elseif not ESPSettings.generatorESP or (pr and pr.Value>=100) then RemoveObjectESP(g) end
            end
        end
        for _,it in ipairs(ing.Map:GetDescendants()) do
            if it.Name=="ItemRoot" and it.Parent and it.Parent:IsA("Model") then
                if ESPSettings.itemESP and not it.Parent:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(it.Parent,ESPSettings.itemColor,false,true)
                elseif not ESPSettings.itemESP then RemoveObjectESP(it.Parent) end
            end
        end
    end
    for _,o in ipairs(ing:GetChildren()) do
        if o.Name=="Pizza" and o:IsA("BasePart") then
            if ESPSettings.pizzaEsp and not o:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(o,ESPSettings.pizzaColor,false,false,true)
            elseif not ESPSettings.pizzaEsp then RemoveObjectESP(o) end
        end
        if o:IsA("Model") and table.find(DummyNames,o.Name) then
            if ESPSettings.pizzaDeliveryEsp and not o:FindFirstChild("TAOWARE_Highlight") and o:FindFirstChild("HumanoidRootPart") then CreateObjectESP(o,ESPSettings.pizzaDeliveryColor,false,false,false,true)
            elseif not ESPSettings.pizzaDeliveryEsp then RemoveObjectESP(o) end
        end
        if o.Name=="1x1x1x1Zombie" and o:IsA("Model") then
            if ESPSettings.zombieEsp and not o:FindFirstChild("TAOWARE_Highlight") and o:FindFirstChild("HumanoidRootPart") then CreateObjectESP(o,ESPSettings.zombieColor,false,false,false,false,true)
            elseif not ESPSettings.zombieEsp then RemoveObjectESP(o) end
        end
        if o.Name:match("TaphTripwire$") and o:IsA("Model") then
            if ESPSettings.taphTripwireEsp and not o:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(o,ESPSettings.taphTripwireColor,false,false,false,false,false,true)
            elseif not ESPSettings.taphTripwireEsp then RemoveObjectESP(o) end
        end
        if o.Name=="SubspaceTripmine" and o:IsA("Model") then
            if ESPSettings.tripMineEsp and not o:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(o,ESPSettings.tripMineColor,false,false,false,false,false,false,true)
            elseif not ESPSettings.tripMineEsp then RemoveObjectESP(o) end
        end
        if o.Name=="GraffitiCL" and o:IsA("BasePart") then
            if ESPSettings.graffitiEsp and not o:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(o,ESPSettings.graffitiColor,false,false,false,false,false,false,false,false,true)
            elseif not ESPSettings.graffitiEsp then RemoveObjectESP(o) end
        end
    end
    for _,o in ipairs(ing:GetDescendants()) do
        if o and o.Name and tostring(o.Name):lower():find("respawnlocation") then
            local t=o:IsA("Model") and o or o:IsA("BasePart") and o or (o:FindFirstAncestorOfClass("Model") or o)
            if not t or IsRagdoll(t) then continue end
            if ESPSettings.twoTimeRespawnEsp and not t:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(t,ESPSettings.twoTimeRespawnColor,false,false,false,false,false,false,false,true)
            elseif not ESPSettings.twoTimeRespawnEsp then RemoveObjectESP(t) end
        end
    end
    if MapFolder then for _,o in ipairs(MapFolder:GetDescendants()) do
        if o:IsA("Model") then
            local n=o.Name:lower()
            if n=="groundbulbmodel" then
                if ESPSettings.azureGroundBulbESP then if not o:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(o,ESPSettings.azureGroundBulbColor,false,false,false,false,false,false,false,false,true,"GroundBulb") end
                else RemoveObjectESP(o) end
            elseif n=="vinemodel" then
                if ESPSettings.azureVineESP then if not o:FindFirstChild("TAOWARE_Highlight") then CreateObjectESP(o,ESPSettings.azureVineColor,false,false,false,false,false,false,false,false,true,"Vine") end
                else RemoveObjectESP(o) end
            end
        end
    end end
end
