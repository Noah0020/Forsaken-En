safe("HDT", function()
    HDT_Trigger = function()
        if not HDT.enabled or IsPlayerKiller() or HDT.busy then return end
        task.spawn(function()
            HDT.busy=true
            if HDT.delay and HDT.delay>0 then task.wait(HDT.delay) end
            if not HDT.enabled or IsPlayerKiller() then HDT.busy=false; return end
            local character=LP.Character
            local killer=GetNearestKillerModel(math.huge)
            if not character or not killer then HDT.busy=false; return end
            local hrp=character:FindFirstChild("HumanoidRootPart")
            local hum=character:FindFirstChildOfClass("Humanoid")
            local primaryPart=character.PrimaryPart or hrp
            if not hrp or not hum then HDT.busy=false; return end
            local kHRP=killer:FindFirstChild("HumanoidRootPart")
            if not kHRP then HDT.busy=false; return end
            hrp.CFrame=CFrame.lookAt(hrp.Position, Vector3.new(kHRP.Position.X,hrp.Position.Y,kHRP.Position.Z))
            local part2=Instance.new("Part")
            part2.Size=Vector3.new(2,2,2); part2.Transparency=1; part2.CanCollide=false; part2.Anchored=true
            part2.CFrame=hrp.CFrame; part2.Parent=character; character.PrimaryPart=part2
            local start=os.clock(); local dur=math.max(0.05,HDT.duration or 0.3); local behind=HDT.behind or 3
            while os.clock()-start<dur and HDT.enabled and not IsPlayerKiller() do
                local k=GetNearestKillerModel(math.huge)
                local kr=k and k:FindFirstChild("HumanoidRootPart")
                if kr and hrp.Parent then
                    local targetPos=(kr.CFrame*CFrame.new(0,0,-behind)).Position
                    local flat=Vector3.new(kr.Position.X,hrp.Position.Y,kr.Position.Z)
                    local rot=CFrame.lookAt(hrp.Position,flat).Rotation
                    part2.CFrame=CFrame.new(targetPos)*rot
                    hrp.AssemblyLinearVelocity=Vector3.zero
                    local to=targetPos-hrp.Position
                    if to.Magnitude>0.5 then hum:Move(to.Unit*(HDT.speed or 12),false) end
                end
                RunService.PreRender:Wait()
            end
            if part2 and part2.Parent then part2:Destroy() end
            if character and character.Parent then character.PrimaryPart=primaryPart end
            if hum then hum:Move(Vector3.zero,false) end
            HDT.busy=false
        end)
    end
    local left=Tabs.HDT:AddLeftGroupbox("Hitbox Dragging Tech","activity")
    left:AddToggle("HDT_Enable",{Text="Enable HDT",Default=false,Callback=function(v)
        if v and IsPlayerKiller() then pcall(function() Toggles.HDT_Enable:SetValue(false) end); return end
        HDT.enabled=v
    end})
    left:AddSlider("HDT_DurS",{Text="Drag Duration",Default=0.35,Min=0.05,Max=2,Rounding=2,Callback=function(v) HDT.duration=v end})
    left:AddSlider("HDT_DelayS",{Text="Start Delay",Default=0.05,Min=0,Max=1,Rounding=2,Callback=function(v) HDT.delay=v end})
    left:AddSlider("HDT_SpeedS",{Text="Drag Speed",Default=12,Min=5,Max=30,Rounding=0,Callback=function(v) HDT.speed=v end})
    left:AddSlider("HDT_BehindS",{Text="Behind Studs",Default=3,Min=1,Max=8,Rounding=1,Callback=function(v) HDT.behind=v end})
    left:AddButton({Text="Test HDT",Func=function() HDT_Trigger() end})
end)

