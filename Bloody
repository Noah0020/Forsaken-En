-- CUSTOM ZONE
-- ═══════════════════════════════════════════════════════════════
local CustomZone = { running=false, connections={}, folder=nil, killerZones={} }
local PLAYER_RADIUS = 1.5

local function GetKillerGroundCF(kr)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {kr.Parent, LocalPlayer.Character}
    params.IgnoreWater = true
    local ray = Workspace:Raycast(kr.Position, Vector3.new(0, -30, 0), params)
    local groundY = ray and (kr.Position.Y - ray.Distance) or (kr.Position.Y - 3)
    return CFrame.new(kr.Position.X, groundY + (Settings.ZoneHeight or 0.5), kr.Position.Z) * kr.CFrame.Rotation
end

local function BuildZone(killer)
    local model = Instance.new("Model")
    model.Name = "ABCustomZone_" .. killer.Name
    model.Parent = CustomZone.folder
    local edges = {}
    for i = 1, 4 do
        local p = Instance.new("Part")
        p.Name="Edge"..i; p.Anchored=true; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false
        p.CastShadow=false; p.Material=Enum.Material.Neon
        p.Color=Color3.fromRGB(255,0,0); p.Transparency=0.3
        p.Size=Vector3.new(0.35,0.08,1); p.CFrame=CFrame.new(0,-5000,0)
        p.Parent = model
        edges[i] = p
    end
    local circle = Instance.new("Part")
    circle.Shape=Enum.PartType.Cylinder; circle.Name="Circle"
    circle.Anchored=true; circle.CanCollide=false; circle.CanQuery=false; circle.CanTouch=false
    circle.CastShadow=false; circle.Material=Enum.Material.Neon
    circle.Color=Color3.fromRGB(255,0,0); circle.Transparency=0.65
    circle.Size=Vector3.new(0.08,10,10); circle.CFrame=CFrame.new(0,-5000,0)
    circle.Parent = model
    return { model=model, edges=edges, circle=circle, killer=killer }
end

local function IsPlayerInDiamond(myPos, killerCF, killerPos)
    local fwd = Vector3.new(killerCF.LookVector.X, 0, killerCF.LookVector.Z)
    local right = Vector3.new(killerCF.RightVector.X, 0, killerCF.RightVector.Z)
    if fwd.Magnitude < 0.01 or right.Magnitude < 0.01 then return false end
    fwd, right = fwd.Unit, right.Unit
    local delta = Vector3.new(myPos.X-killerPos.X, 0, myPos.Z-killerPos.Z)
    local forwardDist, sideDist = delta:Dot(fwd), delta:Dot(right)
    local centerDist = Settings.CustomDiamondOffset + Settings.CustomDiamondLength/2
    local halfW = Settings.CustomDiamondWidth/2 + PLAYER_RADIUS
    local halfL = Settings.CustomDiamondLength/2 + PLAYER_RADIUS
    return math.abs(sideDist)/halfW + math.abs(forwardDist-centerDist)/halfL <= 1
end

local function IsPlayerInCircleCheck(myPos, killerCF, killerPos)
    local fwd = Vector3.new(killerCF.LookVector.X, 0, killerCF.LookVector.Z)
    if fwd.Magnitude < 0.01 then return false end
    fwd = fwd.Unit
    local right = Vector3.new(-fwd.Z, 0, fwd.X)
    local delta = Vector3.new(myPos.X-killerPos.X, 0, myPos.Z-killerPos.Z)
    local centerDist = Settings.CustomCircleOffset + Settings.CustomCircleRadius
    local fromCenter = delta - fwd*centerDist
    local radius = Settings.CustomCircleRadius + PLAYER_RADIUS
    return fromCenter:Dot(fromCenter) <= radius*radius
end

local function IsPlayerInFacingZone(killer)
    if not killer or not killer.Parent then return false end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not kr or not myRoot then return false end
    local mode = Settings.FacingMode
    if mode ~= "Circle Check" and mode ~= "Diamond Check" then mode = "Off" end
    local delta = Vector3.new(myRoot.Position.X-kr.Position.X, 0, myRoot.Position.Z-kr.Position.Z)
    if mode == "Off" then
        local radius = (Settings.FacingOffRadius or 15) + PLAYER_RADIUS
        return delta:Dot(delta) <= radius*radius
    elseif mode == "Circle Check" then
        return IsPlayerInCircleCheck(myRoot.Position, kr.CFrame, kr.Position)
    elseif mode == "Diamond Check" then
        return IsPlayerInDiamond(myRoot.Position, kr.CFrame, kr.Position)
    end
    return false
end

local function UpdateZone(zone, kr, myRoot)
    if not zone or not zone.model or not zone.model.Parent or not kr or not kr.Parent then return end
    local mode = Settings.FacingMode or "Off"
    local baseCF = GetKillerGroundCF(kr)
    local show = Settings.ShowFacingVisual == true
    local inZone = myRoot and IsPlayerInFacingZone(zone.killer) or false
    local zoneColor = inZone and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)

    for i, edge in ipairs(zone.edges) do
        if edge and edge.Parent then
            if show and mode == "Diamond Check" then
                local offset, length, width = Settings.CustomDiamondOffset, Settings.CustomDiamondLength, Settings.CustomDiamondWidth
                local points = {
                    baseCF:PointToWorldSpace(Vector3.new(0,0,-offset)),
                    baseCF:PointToWorldSpace(Vector3.new(0,0,-(offset+length))),
                    baseCF:PointToWorldSpace(Vector3.new(-width/2,0,-(offset+length/2))),
                    baseCF:PointToWorldSpace(Vector3.new(width/2,0,-(offset+length/2))),
                }
                local pairsForEdges = {{1,3},{1,4},{2,3},{2,4}}
                local pair = pairsForEdges[i]
                local a,b = points[pair[1]],points[pair[2]]
                local mid,diff = (a+b)/2,b-a
                edge.Size = Vector3.new(0.18,0.08,diff.Magnitude)
                edge.CFrame = CFrame.lookAt(mid,mid+diff.Unit)
                edge.Transparency = 0.2
                edge.Color = zoneColor
            else
                edge.Transparency = 1
            end
        end
    end

    local circle = zone.circle
    if circle and circle.Parent then
        local isCircle = mode == "Off" or mode == "Circle Check"
        local radius, center
        if mode == "Off" then
            -- Off means radial detection around the killer until a directional check is selected.
            radius = (Settings.FacingOffRadius or 15) + PLAYER_RADIUS
            center = baseCF.Position
        else
            radius = Settings.CustomCircleRadius + PLAYER_RADIUS
            center = baseCF:PointToWorldSpace(Vector3.new(0,0,-(Settings.CustomCircleOffset + Settings.CustomCircleRadius)))
        end
        circle.Size = Vector3.new(0.08,radius*2,radius*2)
        circle.CFrame = CFrame.new(center + Vector3.new(0,0.04,0)) * CFrame.Angles(0,0,math.rad(90))
        circle.Transparency = (show and isCircle) and 0.55 or 1
        circle.Color = zoneColor
    end
end

local function StartCustomZoneVisuals()
    if CustomZone.running then return end
    CustomZone.running = true
    CustomZone.connections = {}
    CustomZone.killerZones = {}
    CustomZone.folder = Instance.new("Folder"); CustomZone.folder.Name = "ABCustomZoneVisuals"; CustomZone.folder.Parent = Workspace
    table.insert(CustomZone.connections, RunService.RenderStepped:Connect(function()
        if not CustomZone.running then return end
        local killersFolder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
        if not killersFolder then return end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        for _, killer in ipairs(killersFolder:GetChildren()) do
            if killer:IsA("Model") then
                local kr = killer:FindFirstChild("HumanoidRootPart")
                if kr then
                    local zone = CustomZone.killerZones[killer]
                    if not zone or not zone.model or not zone.model.Parent then
                        if zone and zone.model then pcall(function() zone.model:Destroy() end) end
                        zone = BuildZone(killer)
                        CustomZone.killerZones[killer] = zone
                    end
                    UpdateZone(zone, kr, myRoot)
                end
            end
        end
        for killer, zone in pairs(CustomZone.killerZones) do
            if not killer.Parent or not killer:IsDescendantOf(Workspace) then
                if zone.model then pcall(function() zone.model:Destroy() end) end
                CustomZone.killerZones[killer] = nil
            end
        end
    end))
    print("[shitsaken] Custom Zone ON")
end

local function StopCustomZoneVisuals()
    if not CustomZone.running then return end
    CustomZone.running = false
    for _, c in ipairs(CustomZone.connections) do pcall(function() c:Disconnect() end) end
    CustomZone.connections = {}
    for killer, zone in pairs(CustomZone.killerZones) do
        if zone.model then pcall(function() zone.model:Destroy() end) end
    end
    CustomZone.killerZones = {}
    if CustomZone.folder then pcall(function() CustomZone.folder:Destroy() end); CustomZone.folder = nil end
    print("[shitsaken] Custom Zone OFF")
end

local function UpdateCustomZoneVisibility()
    local shouldShow = Settings.ShowFacingVisual == true
    if shouldShow and not CustomZone.running then
        StartCustomZoneVisuals()
    elseif not shouldShow and CustomZone.running then
        StopCustomZoneVisuals()
    end
end

