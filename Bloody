safe("ESP", function()
    local S = {
        killerESP = false, survivorESP = false, generatorESP = false, itemESP = false,
        killerName = true, killerHealth = true, survivorName = true, survivorHealth = true,
        killerSkin = false, survivorSkin = false,
        MaxDist = 250,
        killerColor = Color3.fromRGB(255, 100, 100),
        survivorColor = Color3.fromRGB(100, 255, 100),
        generatorColor = Color3.fromRGB(200, 100, 200),
        itemColor = Color3.fromRGB(200, 200, 0),
        killerFill = 0.7, survivorFill = 0.7,
    }
    local PlayerESPData, ObjectESPData = {}, {}
    local Folder = Instance.new("Folder")
    Folder.Name = "Nos_ESP"
    Folder.Parent = CoreGui

    local function clearModel(model)
        for i = #PlayerESPData, 1, -1 do
            if PlayerESPData[i].model == model then table.remove(PlayerESPData, i) end
        end
        for i = #ObjectESPData, 1, -1 do
            if ObjectESPData[i].model == model then table.remove(ObjectESPData, i) end
        end
        pcall(function()
            if model:FindFirstChild("Nos_HL") then model.Nos_HL:Destroy() end
            if model:FindFirstChild("Nos_BB") then model.Nos_BB:Destroy() end
        end)
    end

    local function createPlayerESP(model, isKiller)
        if not model or model == LP.Character then return end
        if model:FindFirstChild("Nos_HL") then return end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local col = isKiller and S.killerColor or S.survivorColor
        local hl = Instance.new("Highlight")
        hl.Name = "Nos_HL"
        hl.Adornee = model
        hl.FillColor = col
        hl.OutlineColor = col
        hl.FillTransparency = isKiller and S.killerFill or S.survivorFill
        hl.OutlineTransparency = 0.3
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = model
        local bb = Instance.new("BillboardGui")
        bb.Name = "Nos_BB"
        bb.Adornee = hrp
        bb.Size = UDim2.new(0, 120, 0, 36)
        bb.StudsOffset = Vector3.new(0, 3.5, 0)
        bb.AlwaysOnTop = true
        bb.Parent = model
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 12
        nameLabel.TextColor3 = col
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.Parent = bb
        local hpLabel = Instance.new("TextLabel")
        hpLabel.Size = UDim2.new(1, 0, 0.5, 0)
        hpLabel.Position = UDim2.new(0, 0, 0.5, 0)
        hpLabel.BackgroundTransparency = 1
        hpLabel.Font = Enum.Font.GothamBold
        hpLabel.TextSize = 11
        hpLabel.TextColor3 = col
        hpLabel.TextStrokeTransparency = 0.5
        hpLabel.Parent = bb
        local data = { model = model, nameLabel = nameLabel, hpLabel = hpLabel, isKiller = isKiller, hl = hl }
        table.insert(PlayerESPData, data)
        local function refresh()
            if not model.Parent then return end
            local actor = model:GetAttribute("ActorDisplayName") or model.Name
            local skin = model:GetAttribute("SkinNameDisplay")
            local showName = data.isKiller and S.killerName or S.survivorName
            local showSkin = data.isKiller and S.killerSkin or S.survivorSkin
            local txt = actor
            if showSkin and skin and tostring(skin) ~= "" then txt = txt .. " | " .. skin end
            nameLabel.Text = showName and txt or ""
            nameLabel.Visible = showName
            local showHp = data.isKiller and S.killerHealth or S.survivorHealth
            if hum then
                hpLabel.Text = string.format("%d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
            end
            hpLabel.Visible = showHp
            hl.Enabled = data.isKiller and S.killerESP or S.survivorESP
        end
        refresh()
        pcall(function()
            model:GetAttributeChangedSignal("ActorDisplayName"):Connect(refresh)
            model:GetAttributeChangedSignal("SkinNameDisplay"):Connect(refresh)
            hum:GetPropertyChangedSignal("Health"):Connect(refresh)
        end)
    end

    local function createGenESP(model)
        if not model or model:FindFirstChild("Nos_HL") then return end
        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end
        local hl = Instance.new("Highlight")
        hl.Name = "Nos_HL"
        hl.Adornee = model
        hl.FillColor = S.generatorColor
        hl.OutlineColor = S.generatorColor
        hl.FillTransparency = 0.7
        hl.Parent = model
        local bb = Instance.new("BillboardGui")
        bb.Name = "Nos_BB"
        bb.Adornee = part
        bb.Size = UDim2.new(0, 100, 0, 28)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = model
        local lab = Instance.new("TextLabel")
        lab.Size = UDim2.fromScale(1, 1)
        lab.BackgroundTransparency = 1
        lab.Font = Enum.Font.GothamBold
        lab.TextSize = 11
        lab.TextColor3 = S.generatorColor
        lab.TextStrokeTransparency = 0.5
        lab.Text = "Generator"
        lab.Parent = bb
        local prog = model:FindFirstChild("Progress")
        if prog then
            local function upd()
                lab.Text = string.format("Gen %d%%", math.floor(prog.Value or 0))
            end
            upd()
            prog:GetPropertyChangedSignal("Value"):Connect(upd)
        end
        table.insert(ObjectESPData, { model = model })
    end

    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.45)
            local pf = Workspace:FindFirstChild("Players")
            local seen = {}
            if pf then
                if S.killerESP then
                    local kf = pf:FindFirstChild("Killers")
                    if kf then
                        for _, k in ipairs(kf:GetChildren()) do
                            if k:IsA("Model") then
                                seen[k] = true
                                if not k:FindFirstChild("Nos_HL") then createPlayerESP(k, true) end
                            end
                        end
                    end
                end
                if S.survivorESP then
                    local sf = pf:FindFirstChild("Survivors")
                    if sf then
                        for _, s in ipairs(sf:GetChildren()) do
                            if s:IsA("Model") and s ~= LP.Character then
                                seen[s] = true
                                if not s:FindFirstChild("Nos_HL") then createPlayerESP(s, false) end
                            end
                        end
                    end
                end
            end
            if S.generatorESP then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "Generator" and obj:IsA("Model") then
                        local prog = obj:FindFirstChild("Progress")
                        if not prog or prog.Value < 100 then
                            seen[obj] = true
                            if not obj:FindFirstChild("Nos_HL") then createGenESP(obj) end
                        end
                    end
                end
            end
            if S.itemESP then
                for _, name in ipairs({"Medkit", "BloxyCola"}) do
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == name and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            seen[obj] = true
                            if not obj:FindFirstChild("Nos_HL") then
                                local hl = Instance.new("Highlight")
                                hl.Name = "Nos_HL"
                                hl.Adornee = obj
                                hl.FillColor = S.itemColor
                                hl.OutlineColor = S.itemColor
                                hl.FillTransparency = 0.6
                                hl.Parent = obj
                            end
                        end
                    end
                end
            end
            for i = #PlayerESPData, 1, -1 do
                local d = PlayerESPData[i]
                local want = d.isKiller and S.killerESP or S.survivorESP
                if not d.model.Parent or not want then
                    clearModel(d.model)
                elseif d.hl then
                    d.hl.Enabled = want
                end
            end
            for i = #ObjectESPData, 1, -1 do
                local d = ObjectESPData[i]
                if not d.model.Parent or not S.generatorESP then
                    clearModel(d.model)
                end
            end
        end
    end)

    local left = Tabs.ESP:AddLeftGroupbox("Highlights", "eye")
    left:AddToggle("ESP_Killer", { Text = "Killer ESP", Default = false, Callback = function(v) S.killerESP = v end })
    left:AddToggle("ESP_Survivor", { Text = "Survivor ESP", Default = false, Callback = function(v) S.survivorESP = v end })
    left:AddToggle("ESP_Generator", { Text = "Generator ESP", Default = false, Callback = function(v) S.generatorESP = v end })
    left:AddToggle("ESP_Items", { Text = "Item ESP (Medkit/Bloxy)", Default = false, Callback = function(v) S.itemESP = v end })
    left:AddLabel("Killer Color"):AddColorPicker("ESP_KC", { Default = S.killerColor, Title = "Killer", Callback = function(c) S.killerColor = c end })
    left:AddLabel("Survivor Color"):AddColorPicker("ESP_SC", { Default = S.survivorColor, Title = "Survivor", Callback = function(c) S.survivorColor = c end })

    local right = Tabs.ESP:AddRightGroupbox("Tags", "settings")
    right:AddToggle("ESP_KName", { Text = "Killer Names", Default = true, Callback = function(v) S.killerName = v end })
    right:AddToggle("ESP_KHP", { Text = "Killer Health", Default = true, Callback = function(v) S.killerHealth = v end })
    right:AddToggle("ESP_KSkin", { Text = "Killer Skin", Default = false, Callback = function(v) S.killerSkin = v end })
    right:AddToggle("ESP_SName", { Text = "Survivor Names", Default = true, Callback = function(v) S.survivorName = v end })
    right:AddToggle("ESP_SHP", { Text = "Survivor Health", Default = true, Callback = function(v) S.survivorHealth = v end })
