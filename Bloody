local function VeerFindTrickHighlight(char)
    if not char then return nil end
    for _, d in ipairs(Workspace:GetChildren()) do
        if d:IsA("Highlight") and d.Adornee == char then return d end
    end
    local h = char:FindFirstChild("Highlight")
    if h and h:IsA("Highlight") and h.Adornee == char then return h end
    return nil
end
local function VeerTriggerSprintBtn()
    pcall(function()
        local ui = LP:FindFirstChild("PlayerGui")
        local m = ui and ui:FindFirstChild("MainUI")
        local btn = m and m:FindFirstChild("SprintingButton", true)
        if btn and getconnections and btn.MouseButton1Down then
            for _, c in pairs(getconnections(btn.MouseButton1Down)) do
                pcall(function() c:Fire() end)
                return
            end
        end
    end)
end
local function VeerTriggerTrick()
    local now = tick()
    if now - VeeAutoTrickState.lastTrigger < 0.15 then return end
    VeeAutoTrickState.lastTrigger = now
    local isPC = not UserInputService.TouchEnabled or UserInputService.MouseEnabled
    if isPC then
        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    else
        pcall(VeerTriggerSprintBtn)
    end
end
local function VeerATStart()
    if VeeAutoTrickState.running then return end
    VeeAutoTrickState.running = true
    VeeAutoTrickState.thread = task.spawn(function()
        while VeeAutoTrickState.running do
            task.wait(0.1)
            if not VeeAutoTrickState.running then break end
            local char = LP.Character
            if char and char.Name == "Veeronica" then
                if VeerFindTrickHighlight(char) then VeerTriggerTrick() end
            end
        end
        VeeAutoTrickState.thread = nil
    end)
end
local function VeerATStop()
    if not VeeAutoTrickState.running then return end
    VeeAutoTrickState.running = false
    if VeeAutoTrickState.thread then
        pcall(task.cancel, VeeAutoTrickState.thread)
        VeeAutoTrickState.thread = nil
    end
end

-- Auto Phase
local function VeeGetNetwork()
    local ok, m = pcall(require, ReplicatedStorage.Modules.Network.Network)
    if ok and type(m) == "table" then return m end
    ok, m = pcall(require, ReplicatedStorage.Modules.Network)
    if ok and type(m) == "table" and m.FireServerConnection then return m end
    return nil
end
local function VeeGetPhaseTime()
    local ok, m = pcall(require, ReplicatedStorage.Assets.Survivors.Veeronica.Behavior)
    if ok and type(m) == "table" then
        local ok2, v = pcall(function() return m.Sk8PhaseTime end)
        if ok2 and type(v) == "number" then return v end
    end
    return 3
end
local function VeerPhaseStart()
    if VeeAutoPhase.running then return end
    VeeAutoPhase.running = true
    local Network = VeeGetNetwork()
    VeeAutoPhase.thread = task.spawn(function()
        while VeeAutoPhase.running do
            task.wait(0.5)
            if not VeeAutoPhase.running then break end
            if not Network then Network = VeeGetNetwork() end
            local char = LP.Character
            if not Network or not char or char.Name ~= "Veeronica" then continue end
            local kf = GetKillersFolder()
            if not kf then continue end
            local phaseTime = VeeGetPhaseTime()
            for _, killer in ipairs(kf:GetChildren()) do
                if not VeeAutoPhase.running then break end
                local hum = killer:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    pcall(function()
                        Network:FireServerConnection(LP.Name.."SkatePhase", "REMOTE_EVENT", killer)
                    end)
                    task.wait(phaseTime + 0.6)
                end
            end
        end
        VeeAutoPhase.thread = nil
    end)
end
local function VeerPhaseStop()
    if not VeeAutoPhase.running then return end
    VeeAutoPhase.running = false
    if VeeAutoPhase.thread then
        pcall(task.cancel, VeeAutoPhase.thread)
        VeeAutoPhase.thread = nil
    end
end

