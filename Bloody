local staminaGainValue  = defaultStaminaGain
local staminaDrainValue = defaultStaminaDrain
local regenDelayValue   = defaultRegenDelay
local infinityStaminaActive = false
local staminaThread = nil

local function applyStaminaSettings()
    if not sprintModule then return end
    sprintModule.MaxStamina = maxStaminaValue
    sprintModule.SprintSpeed = sprintSpeedValue
    sprintModule.StaminaGain = staminaGainValue
    sprintModule.StaminaDrain = staminaDrainValue
    sprintModule.StaminaRegenDelay = regenDelayValue
end

local function EnableInfinityStamina()
    if not sprintModule or infinityStaminaActive then return end
    infinityStaminaActive = true
    applyStaminaSettings()
    staminaThread = task.spawn(function()
        while infinityStaminaActive do
            applyStaminaSettings()
            sprintModule.Stamina = sprintModule.MaxStamina or maxStaminaValue
            task.wait(0.03)
        end
    end)
end

local function DisableInfinityStamina()
    infinityStaminaActive = false
    if staminaThread then
        pcall(task.cancel, staminaThread)
        staminaThread = nil
    end
end

local StamMain = Tabs.Stamina:CreateGroupbox({ Name = "Stamina", Column = 1 }, "Group_StamMain")
StamMain:CreateToggle({
    Name = "Infinite Stamina",
    CurrentValue = false,
    Callback = function(state)
        if not sprintModule then
            warn("[Bloodsaken] Stamina controls unavailable: Sprinting module was not found.")
            return
        end
        if state then EnableInfinityStamina() else DisableInfinityStamina() end
    end,
}, "InfStamina")
StamMain:CreateSlider({
    Name = "Max Stamina", Range = {1, 1000}, Increment = 1,
    CurrentValue = maxStaminaValue,
    Callback = function(val)
        maxStaminaValue = tonumber(val) or defaultMaxStamina
        if sprintModule then
            applyStaminaSettings()
            if not infinityStaminaActive and sprintModule.Stamina > maxStaminaValue then
                sprintModule.Stamina = maxStaminaValue
            end
        end
    end,
}, "MaxStaminaSlider")
StamMain:CreateSlider({
    Name = "Sprint Speed", Range = {1, 30}, Increment = 1,
    CurrentValue = sprintSpeedValue,
    Callback = function(val)
        sprintSpeedValue = tonumber(val) or defaultSprintSpeed
        if sprintModule then applyStaminaSettings() end
    end,
}, "SprintSpeedSlider")
StamMain:CreateSlider({
    Name = "Stamina Gain", Range = {1, 1000}, Increment = 1,
    CurrentValue = staminaGainValue,
    Callback = function(val)
        staminaGainValue = tonumber(val) or defaultStaminaGain
        if sprintModule then applyStaminaSettings() end
    end,
}, "StaminaGainSlider")
StamMain:CreateSlider({
    Name = "Stamina Drain", Range = {0, 1000}, Increment = 1,
    CurrentValue = staminaDrainValue,
    Callback = function(val)
        staminaDrainValue = tonumber(val) or defaultStaminaDrain
        if sprintModule then applyStaminaSettings() end
    end,
}, "StaminaDrainSlider")
StamMain:CreateSlider({
    Name = "Regen Delay", Range = {0, 10}, Increment = 0.1,
    CurrentValue = regenDelayValue,
    Callback = function(val)
        regenDelayValue = tonumber(val) or defaultRegenDelay
        if sprintModule then applyStaminaSettings() end
    end,
}, "RegenDelaySlider")

