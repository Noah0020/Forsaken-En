            if not cam or tick() - camStart > (dur or 0.5) then pcall(function() camConn:Disconnect() end); return end
            local t = GetNearestKillerHrp()
            if t and t.Parent then
                local aim = predictHRP(t, (Settings.AIM_Prediction or 4) * 0.05) or t.Position
                pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aim) end)
