-- Predictive block loop
local killerInRangeSince, predictiveCooldown = nil, 0
local PREDICTIVE_DELAY = 3
RunService.Heartbeat:Connect(function()
    if not audioBlock.PredictiveBlock then return end
    if tick() < predictiveCooldown then return end
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local anyInRange = false
    for _, k in ipairs(KillersFolder:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        if hrp and (myRoot.Position - hrp.Position).Magnitude <= detectionRange then
            if hasLineOfSight(hrp) then anyInRange = true; break end
        end
    end
    if anyInRange then
        killerInRangeSince = killerInRangeSince or tick()
        if tick() - killerInRangeSince >= PREDICTIVE_DELAY then
            fireAbility("Block")
            predictiveCooldown = tick() + 2
            killerInRangeSince = nil
        end
    else
        killerInRangeSince = nil
    end
end)

