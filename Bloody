local function AB_IsBlockReady()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(Settings.AB_Mode == "007n7" and "Clone" or "Block")
    if btn then
        local cd = btn:FindFirstChild("CooldownTime")
        if cd then
            local t = cd.Text
            if t == nil or t == "" or t == " " then return true end
            return false
        end
    end
    return (tick() - (AB.lastBlock or 0)) >= (AB.BLOCK_COOLDOWN - 1.2)
end

local function AB_FireNetwork(name)
    if not NetworkEvent then return end
    if buffer and buffer.fromstring then
        pcall(function()
            NetworkEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0"..name) })
        end)
    end
    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
end

local function AB_FireUI(name)
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(name)
    if btn and firesignal then
        local sig = btn:FindFirstChildOfClass("MouseButton1Click")
        if sig then pcall(firesignal, sig) end
    end
    -- also try VirtualInput as backup
    if btn then
        pcall(function()
            local target = btn:IsA("GuiButton") and btn or btn:FindFirstChildWhichIsA("GuiButton", true)
            if target and target.Visible then
                local pos = target.AbsolutePosition + target.AbsoluteSize/2
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                task.wait(0.012)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
            end
        end)
    end
end

local function AB_FireBlock()
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    if Settings.AB_UseNetwork then AB_FireNetwork(name) end
    if Settings.AB_UseAnimation then AB_FireUI(name) end
end

local function AB_FireSpam()
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local count = math.max(1, tonumber(Settings.AB_SpamCount) or 5)
    if Settings.AB_UseNetwork and NetworkEvent then
        if buffer and buffer.fromstring then
            local buf = buffer.fromstring("\3\5\0\0\0"..name)
            for i = 1, count do
                task.spawn(function() pcall(function() NetworkEvent:FireServer("UseActorAbility", {buf}) end) end)
            end
        end
        local dur = tonumber(Settings.AB_SpamDuration) or 0.06
        if dur > 0 then
            task.spawn(function()
                local endT = tick() + dur
                while tick() < endT do
                    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
                    task.wait(0.001)
                end
            end)
        end
    end
    if Settings.AB_UseAnimation then
        for i = 1, math.min(count, 4) do
            task.spawn(function() AB_FireUI(name) end)
        end
    end
end

local function AB_Fire()
    if Settings.AB_SpamEnabled then AB_FireSpam() else AB_FireBlock() end
end

local function AB_TryFire(killer)
    local st = AB.perKiller[killer]
    if not st or st.pendingUntil <= 0 or tick() > st.pendingUntil then return end

    Box_ShowOnM1(killer)
    if not AB_IsBlockReady() then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not hum or hum.Health <= 0 then return end

    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp or not hrp.Parent then return end
    if not AB_ShouldBlock(killer) then return end

    st.pendingUntil = 0
    st.lastFireAt = tick()
    AB.lastBlock = tick()
    AB_Fire()
end

local function AB_OnAttributeChanged(killer)
    if not AB.running then return end
    local st = AB.perKiller[killer]
    if not st then return end

    local aU = killer:GetAttribute("AbilitiesUsed") or 0
    if aU > st.lastUsed then
        st.lastUsed = aU
        st.baitFlag = true
    end

    local aLU = killer:GetAttribute("AbilityLastUsed") or 0
    if aLU <= st.lastAbility then return end
    st.lastAbility = aLU

    if st.baitFlag then
        st.baitFlag = false
        return
    end

    st.pendingUntil = tick() + Settings.AB_PendingWindow
    AB_TryFire(killer)
end

local function AB_HookKiller(killer)
    if not killer:IsA("Model") or AB.perKiller[killer] then return end
    local st = {
        lastAbility = killer:GetAttribute("AbilityLastUsed") or 0,
        lastUsed    = killer:GetAttribute("AbilitiesUsed") or 0,
        baitFlag    = false,
        pendingUntil= 0,
        lastFireAt  = 0,
    }
    local ok, conn = pcall(function()
        return killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            AB_OnAttributeChanged(killer)
        end)
    end)
    if ok and conn then st.signalConn = conn end
    AB.perKiller[killer] = st
end

local function AB_UnhookKiller(killer)
    local st = AB.perKiller[killer]
    if st and st.signalConn then pcall(function() st.signalConn:Disconnect() end) end
    AB.perKiller[killer] = nil
end

local function AB_FrameLoop()
    if not AB.running then return end
    local kf = GetKillersFolder()
    if not kf then return end

    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            if not AB.perKiller[killer] then AB_HookKiller(killer) end
            local st = AB.perKiller[killer]
            if st then
                local aU = killer:GetAttribute("AbilitiesUsed") or 0
                if aU > st.lastUsed then
                    st.lastUsed = aU
                    st.baitFlag = true
                end
                if st.pendingUntil > 0 then AB_TryFire(killer) end
            end
        end
    end
    for k in pairs(AB.perKiller) do
        if not k.Parent then AB_UnhookKiller(k) end
    end
end

local function AB_Enable()
    if AB.running then return end
    AB.running = true
    AB.perKiller = {}
    AB.lastBlock = 0
    Settings.AB_Enabled = true

    local kf = GetKillersFolder()
    if kf then
        for _, k in ipairs(kf:GetChildren()) do AB_HookKiller(k) end
    end
    AB.frameConn = RunService.RenderStepped:Connect(AB_FrameLoop)
end

local function AB_Disable()
    AB.running = false
    Settings.AB_Enabled = false
    if AB.frameConn then
        pcall(function() AB.frameConn:Disconnect() end)
        AB.frameConn = nil
    end
    for k in pairs(AB.perKiller) do AB_UnhookKiller(k) end
    AB.perKiller = {}

    for killer, box in pairs(BoxState.killerBoxes) do
        Box_DestroyWireframe(box.parts)
    end
    BoxState.killerBoxes = {}
    if BoxState.playerBox then
        Box_DestroyWireframe(BoxState.playerBox.parts)
        BoxState.playerBox = nil
    end
    BoxState.killers = {}
    BoxState.player = nil
    Box_DestroyRootFolder()
end

