local _aimbotVelocityData = {}
local function getVelocity(hrp)
    if not hrp then return Vector3.zero end
    local data = _aimbotVelocityData[hrp]
    local now = tick()
    if not data then
        _aimbotVelocityData[hrp] = {lastPos = hrp.Position, lastTime = now, velocity = Vector3.zero}
        return Vector3.zero
    end
    local dt = now - data.lastTime
    if dt <= 0 then return data.velocity end
    local vel = (hrp.Position - data.lastPos) / dt
    data.lastPos = hrp.Position; data.lastTime = now; data.velocity = vel
    return vel
end

local function getNearestKillerAim()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not KillersFolder then return nil end
    local best, bestDist = nil, CONFIG.AimbotRange
    for _, model in ipairs(KillersFolder:GetChildren()) do
        if model:IsA("Model") then
            local r = model:FindFirstChild("HumanoidRootPart")
            local h = model:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local vel = getVelocity(r)
                local predicted = r.Position + (vel * CONFIG.AimbotPrediction)
                local d = (predicted - root.Position).Magnitude
                if d < bestDist then bestDist = d; best = {root = r, pos = predicted} end
            end
        end
    end
    return best
end

local function rotateToTarget(target)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not target or not target.root or not root then return end
    local tp = target.pos or target.root.Position
    local dir = Vector3.new(tp.X - root.Position.X, 0, tp.Z - root.Position.Z)
    if dir.Magnitude < 0.1 then return end
    root.CFrame = CFrame.new(root.Position, root.Position + dir.Unit)
end

