    if VeeAutoTrickState.running then return end
    VeeAutoTrickState.running = true
    VeerScanAllHighlights()
    VeeAutoTrickState.descConn = Workspace.DescendantAdded:Connect(function(d)
        if d:IsA("Highlight") then VeeAutoTrickState.candidates[d] = true end
    end)
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        VeeAutoTrickState.pgConn = pg.DescendantAdded:Connect(function(d)
            if d:IsA("Highlight") then VeeAutoTrickState.candidates[d] = true end
        end)
    end
    VeeAutoTrickState.thread = task.spawn(function()
        while VeeAutoTrickState.running do
            task.wait(0.1)
            if not VeeAutoTrickState.running then break end
            local char = LP.Character
            if IsVeeronica(char) then
                for h in pairs(VeeAutoTrickState.candidates) do
                    if h and h.Parent then
                        if HighlightTargetsChar(h, char) then
                            VeerFireTrick()
                            break
                        end
                    else
                        VeeAutoTrickState.candidates[h] = nil
                    end
                end
            end
        end
        VeeAutoTrickState.thread = nil
    end)
