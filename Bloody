-- Facing Visual
local function updateFacingVisual(killer, visual)
    if not (killer and visual and visual.Parent) then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dot = math.clamp(customFacingDot or -0.3, -1, 1)
    local frac = math.acos(dot) / math.pi
    local minFrac = 0.20
    local radius = math.max(1, detectionRange * (minFrac + (1 - minFrac) * frac))
    visual.Radius = radius
    visual.Height = 0.12
    local fwd = detectionRange * (0.35 + 0.15 * frac)
    local yOff = -(hrp.Size.Y / 2 + 0.05)
    visual.CFrame = CFrame.new(0, yOff, -fwd) * CFrame.Angles(math.rad(90), 0, 0)
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local inR = myRoot and ((hrp.Position - myRoot.Position).Magnitude <= detectionRange)
    visual.Color3 = inR and Color3.fromRGB(255,0,0) or Color3.fromRGB(255,255,0)
    visual.Transparency = inR and 0.40 or 0.85
end

local function addFacingVisual(killer)
    if not killer or not killer:IsA("Model") or facingVisuals[killer] then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local v = Instance.new("CylinderHandleAdornment")
    v.Name = "FacingCheckVisual"
    v.Adornee = hrp
    v.AlwaysOnTop = true
    v.ZIndex = 2
    v.Transparency = 0.55
    v.Color3 = Color3.fromRGB(255,255,0)
    v.Parent = hrp
    facingVisuals[killer] = v
    updateFacingVisual(killer, v)
end

local function removeFacingVisual(killer)
    if facingVisuals[killer] then
        facingVisuals[killer]:Destroy()
        facingVisuals[killer] = nil
    end
end

RunService.RenderStepped:Connect(function()
    for k, v in pairs(facingVisuals) do
        if not k.Parent or not k:FindFirstChild("HumanoidRootPart") then
            removeFacingVisual(k)
        else
            updateFacingVisual(k, v)
        end
    end
end)

-- Detection circle
local function addDetectionCircle(killer)
    if not killer:FindFirstChild("HumanoidRootPart") or detectionCircles[killer] then return end
    local hrp = killer.HumanoidRootPart
    local c = Instance.new("CylinderHandleAdornment")
    c.Name = "KillerDetectionCircle"
    c.Adornee = hrp
    c.Color3 = Color3.fromRGB(255,255,0)
    c.AlwaysOnTop = true; c.ZIndex = 1; c.Transparency = 0.6
    c.Radius = detectionRange; c.Height = 0.12
    local yOff = -(hrp.Size.Y / 2 + 0.05)
    c.CFrame = CFrame.new(0, yOff, 0) * CFrame.Angles(math.rad(90), 0, 0)
    c.Parent = hrp
    detectionCircles[killer] = c
end

local function removeDetectionCircle(killer)
    if detectionCircles[killer] then detectionCircles[killer]:Destroy(); detectionCircles[killer] = nil end
end

RunService.RenderStepped:Connect(function()
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    for k, c in pairs(detectionCircles) do
        if c and c.Parent and k:FindFirstChild("HumanoidRootPart") then
            c.Radius = detectionRange
            if myRoot then
                local d = (k.HumanoidRootPart.Position - myRoot.Position).Magnitude
                c.Color3 = d <= detectionRange and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,255,0)
            end
        end
    end
end)

