-- VEE (multi-path + getgc throttle — BUG FIX)
--═══════════════════════════════════════════════════════════════════
local VeeModule = nil
local VeeThread = nil
local _veeLastGCScan = 0

local function getVeeModule()
    if VeeModule then return VeeModule end
    local ok, m = pcall(function() return require(ReplicatedStorage.Assets.Survivors.Veeronica.Behavior) end)
    if ok and type(m) == "table" then VeeModule = m; return m end
    ok, m = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Assets", 5):WaitForChild("Survivors", 5):WaitForChild("Veeronica", 5):WaitForChild("Behavior", 5))
    end)
    if ok and type(m) == "table" then VeeModule = m; return m end
    ok, m = pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local behavior = assets and assets:FindFirstChild("Behavior", true)
        return behavior and require(behavior)
    end)
    if ok and type(m) == "table" then VeeModule = m; return m end
    return nil
end

local function setVeeStat(name, value)
    local m = getVeeModule()
    if m then pcall(function() m[name] = value end) end
    -- Throttle getgc scan to once per 0.5s
    if not getgc then return end
    if os.clock() - _veeLastGCScan < 0.5 then return end
    _veeLastGCScan = os.clock()
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "DisplayName") == "Veeronica" then
                obj[name] = value
            end
        end
    end)
end

local function applyVeeStats()
    if not Settings.Vee_Enabled then return end
    setVeeStat("Sk8Speed",              Settings.Vee_Sk8Speed)
    setVeeStat("Sk8SpeedExhaust",       Settings.Vee_Sk8SpeedExhaust)
    setVeeStat("Sk8TrickAirborneSpeed", Settings.Vee_Sk8TrickAirborneSpeed)
    setVeeStat("Sk8BumpPower",          Settings.Vee_Sk8BumpPower)
    setVeeStat("Sk8BumpChargedPower",   Settings.Vee_Sk8BumpChargedPower)
    setVeeStat("Sk8TrickStamina",       Settings.Vee_Sk8TrickStamina)
    setVeeStat("Sk8TrickStaminaNerfed", Settings.Vee_Sk8TrickStaminaNerfed)
    setVeeStat("Sk8TrickCooldown",      Settings.Vee_Sk8TrickCooldown)
    setVeeStat("Sk8TurnControl",        Settings.Vee_Sk8TurnControl)
end

local function startVeeWatcher()
    if VeeThread then return end
    applyVeeStats()
    VeeThread = task.spawn(function()
        while Settings.Vee_Enabled and not _ShuttingDown do
            task.wait(2)
            if Settings.Vee_Enabled then applyVeeStats() end
        end
        VeeThread = nil
    end)
end
local function stopVeeWatcher()
    if VeeThread then pcall(task.cancel, VeeThread); VeeThread = nil end
end

