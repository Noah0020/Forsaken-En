-- AUTO GEN (Flex-style: enter + fire puzzle remote)
--══════════════════════════════════════════════════════════════
local genThread
local function solveNearbyGen()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    RefreshFolders()
    local root = MapIngame or workspace:FindFirstChild("Map")
    if not root then return false end
    for _, gen in ipairs(root:GetDescendants()) do
        if gen:IsA("Model") and gen.Name == "Generator" and gen.PrimaryPart then
            local prog = gen:FindFirstChild("Progress")
            if prog and prog.Value >= 100 then continue end
            if (gen.PrimaryPart.Position - hrp.Position).Magnitude > 10 then continue end
            local remotes = gen:FindFirstChild("Remotes")
            if not remotes then continue end
            local rf = remotes:FindFirstChild("RF") or remotes:FindFirstChildOfClass("RemoteFunction")
            local re = remotes:FindFirstChild("RE") or remotes:FindFirstChildOfClass("RemoteEvent")
            pcall(function()
                if rf then rf:InvokeServer("Enter") end
                task.wait(0.08)
                if re then re:FireServer() end
                -- also fire any remote under gen while PuzzleUI is open
                if LocalPlayer.PlayerGui:FindFirstChild("PuzzleUI") and re then
                    re:FireServer()
                end
            end)
            return true
        end
    end
    return false
end

local function setAutoGen(on)
    C.AutoGen = on
    if genThread then task.cancel(genThread); genThread = nil end
    if on then
        genThread = task.spawn(function()
            while C.AutoGen do
                pcall(solveNearbyGen)
                task.wait(C.GenCD)
            end
            genThread = nil
        end)
        Notify("Auto Gen ON")
    end
end

