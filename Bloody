    if StabAim.aimMode == "Camera" or StabAim.aimMode == "Character + Camera" then
        local camera = Workspace.CurrentCamera
        if camera then camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, predicted), smooth) end
    end
end)

