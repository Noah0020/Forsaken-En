    if not r then return end
    pcall(function() r:FireServer("UseActorAbility", { "Punch" }) end)
end

local function extractId(s)
    if not s then return nil end
    return tostring(s):match("%d+")
end

local function nearestKiller(maxD)
    if not LocalRoot or not KillersFolder then return nil end
    local best, bd = nil, maxD or 50
    for _, m in ipairs(KillersFolder:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart")
        local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - LocalRoot.Position).Magnitude
            if d < bd then
                bd = d
                best = m
            end
        end
    end
    return best
end

local function aimAt(kr, dur)
    if not LocalRoot or not kr then return end
    dur = dur or 0.18
    local t0 = os.clock()
    local c
    c = RS.RenderStepped:Connect(function()
        if os.clock() - t0 > dur or not LocalRoot or not kr.Parent then
            if c then c:Disconnect() end
            return
        end
        local p = kr.Position
        LocalRoot.CFrame = CFrame.lookAt(LocalRoot.Position, Vector3.new(p.X, LocalRoot.Position.Y, p.Z))
    end)
end

local function IsPlayingAnim(id)
    if not LocalHum then return false end
    for _, tr in ipairs(LocalHum:GetPlayingAnimationTracks()) do
        if tr.Animation and extractId(tr.Animation.AnimationId) == id then
            return true
        end
    end
    return false
end

