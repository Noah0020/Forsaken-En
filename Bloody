local AB = { running = false, perKiller = {}, lastBlock = 0 }
local GREEN = Color3.fromRGB(70, 255, 120)
local BLUE  = Color3.fromRGB(80, 150, 255)
local RED   = Color3.fromRGB(255, 35, 35)
local BoxState = { killers = {}, player = nil, killerBoxes = {}, playerBox = nil, rootFolder = nil, renderConn = nil }

local function Box_GetRootFolder()
    local f = BoxState.rootFolder
    if f and f.Parent then return f end
    if f and not f.Parent then pcall(function() f:Destroy() end) end
    local folder = Instance.new("Folder"); folder.Name = "Cupcake_BoxVisuals"; folder.Parent = Workspace
    BoxState.rootFolder = folder; return folder
end
local function Box_DestroyRootFolder()
    local f = BoxState.rootFolder
    if f then pcall(function() f:Destroy() end); BoxState.rootFolder = nil end
end
local function Box_Alpha(dt) return 1 - math.exp(-dt / math.max(Settings.BoxFollowDelay, 0.001)) end
local function Box_UpdateSmoothing(dt)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if not BoxState.player then BoxState.player = hrp.Position
        else BoxState.player = BoxState.player:Lerp(hrp.Position, Box_Alpha(dt)) end
    end
    local kf = GetKillersFolder()
    if kf then
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") then
                local khrp = k:FindFirstChild("HumanoidRootPart")
                if khrp then
                    local st = BoxState.killers[k]
                    if not st then
                        st = { pos = khrp.Position, look = khrp.CFrame.LookVector, facingDot = 0, lastFacingDot = 0, turnRate = 0 }
                        BoxState.killers[k] = st
                    else
                        local a = Box_Alpha(dt)
                        st.pos = st.pos:Lerp(khrp.Position, a)
                        local nl = khrp.CFrame.LookVector
                        st.look = st.look:Lerp(nl, a)
                        if st.look.Magnitude > 0.01 then st.look = st.look.Unit else st.look = nl.Unit end
                    end
                else BoxState.killers[k] = nil end
            end
        end
    end
    for k in pairs(BoxState.killers) do if not k.Parent then BoxState.killers[k] = nil end end
end

local function AB_IsFacingPlayer(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end
    local toPlayer = BoxState.player - st.pos
    if toPlayer.Magnitude < 0.5 then return false end
    local fl = Vector3.new(st.look.X, 0, st.look.Z)
    local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    if fl.Magnitude < 0.01 or ft.Magnitude < 0.01 then return false end
    return fl.Unit:Dot(ft.Unit) >= Settings.BoxFacingDot
end

local function AB_PlayerInFacingZone(killer)
    if not BoxState.player then return false end
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp or not khrp.Parent then return false end
    local offset = BoxState.player - khrp.Position
    local forward = khrp.CFrame.LookVector
    local right = khrp.CFrame.RightVector
    local fwdDist = offset:Dot(forward)
    local sideDist = math.abs(offset:Dot(right))
    return fwdDist > 0 and fwdDist <= Settings.BoxRange and sideDist <= Settings.BoxKillerW / 2
end

-- FIX C2: fresh killer position for range check (not smoothed st.pos)
local function AB_ShouldBlock(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end

    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp or not khrp.Parent then return false end

    local toPlayer = BoxState.player - khrp.Position
    local dist = toPlayer.Magnitude
    if dist > Settings.BoxRange or dist < 0.5 then return false end

    if Settings.UseBoxFacing then
        if not AB_PlayerInFacingZone(killer) then return false end
    else
        local fl = Vector3.new(st.look.X, 0, st.look.Z)
        local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
        if fl.Magnitude < 0.01 or ft.Magnitude < 0.01 then return false end
        if fl.Unit:Dot(ft.Unit) < Settings.BoxFacingDot then return false end
    end

    local kv = khrp.AssemblyLinearVelocity
    if kv.Magnitude > Settings.BoxFastThreshold then
        local fv = Vector3.new(kv.X, 0, kv.Z)
        local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
        if fv.Magnitude > 0.5 and ft.Magnitude > 0.5 and fv.Unit:Dot(ft.Unit) < Settings.BoxFastDot then
            return false
        end
    end
    return true
end

local _WIRE = nil
local function GetWire()
    if _WIRE then return _WIRE end
    local c = {
        Vector3.new(-0.5,-0.5,-0.5), Vector3.new(0.5,-0.5,-0.5),
        Vector3.new(0.5,-0.5,0.5), Vector3.new(-0.5,-0.5,0.5),
        Vector3.new(-0.5,0.5,-0.5), Vector3.new(0.5,0.5,-0.5),
        Vector3.new(0.5,0.5,0.5), Vector3.new(-0.5,0.5,0.5),
    }
    local e = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    _WIRE = { corners = c, edges = e }; return _WIRE
end
local function Box_CreateWireframe(parent)
    local wire = GetWire(); local parts = {}
    for i, e in ipairs(wire.edges) do
        local part = Instance.new("Part")
        part.Name = "Cupcake_BoxEdge"; part.Anchored = true; part.CanCollide = false
        part.CanTouch = false; part.CanQuery = false
        part.CastShadow = false; part.Material = Enum.Material.Neon
        part.Transparency = 1; part.Parent = parent
        parts[i] = { part = part, c1 = wire.corners[e[1]], c2 = wire.corners[e[2]] }
    end
    return parts
end
local function Box_IsWireframeValid(parts)
    if not parts or #parts == 0 then return false end
    for _, p in ipairs(parts) do if not p.part or not p.part.Parent then return false end end
    return true
end
local function Box_DestroyWireframe(parts)
    if not parts then return end
    for _, p in ipairs(parts) do if p.part then pcall(function() p.part:Destroy() end) end end
end
local function Box_UpdateWireframe(parts, cf, size, color)
    for _, p in ipairs(parts) do
        if p.part and p.part.Parent then
            local a = cf:PointToWorldSpace(Vector3.new(p.c1.X*size.X, p.c1.Y*size.Y, p.c1.Z*size.Z))
            local b = cf:PointToWorldSpace(Vector3.new(p.c2.X*size.X, p.c2.Y*size.Y, p.c2.Z*size.Z))
            local len = (b - a).Magnitude
            if len > 0.001 then
                p.part.Transparency = 0.35; p.part.Color = color
                p.part.Size = Vector3.new(0.06, 0.06, len)
                p.part.CFrame = CFrame.lookAt((a+b)/2, b)
            else p.part.Transparency = 1 end
        end
    end
end
local function Box_HideWireframe(parts)
    if not parts then return end
    for _, p in ipairs(parts) do if p.part and p.part.Parent then p.part.Transparency = 1 end end
end
local function Box_GetKillerBox(killer)
    local b = BoxState.killerBoxes[killer]
    if b and Box_IsWireframeValid(b.parts) then return b end
    if b then Box_DestroyWireframe(b.parts) end
    local parts = Box_CreateWireframe(Box_GetRootFolder())
    b = { parts = parts, showUntil = 0 }; BoxState.killerBoxes[killer] = b; return b
end
local function Box_GetPlayerBox()
    local pb = BoxState.playerBox
    if pb and Box_IsWireframeValid(pb.parts) then return pb end
    if pb then Box_DestroyWireframe(pb.parts) end
    local parts = Box_CreateWireframe(Box_GetRootFolder())
    pb = { parts = parts, showUntil = 0 }; BoxState.playerBox = pb; return pb
end
local function Box_ShowOnM1(killer)
    if not Settings.BoxVisualEnabled then return end
    local khrp = killer:FindFirstChild("HumanoidRootPart"); if not khrp then return end
    local chrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if not chrp then return end
    local existing = BoxState.killers[killer]
    if existing then existing.pos = khrp.Position; existing.look = khrp.CFrame.LookVector
    else BoxState.killers[killer] = { pos = khrp.Position, look = khrp.CFrame.LookVector, facingDot=0, lastFacingDot=0, turnRate=0 } end
    BoxState.player = chrp.Position
    local now = os.clock()
    Box_GetKillerBox(killer).showUntil = now + Settings.BoxDisplayDuration
    if (chrp.Position - khrp.Position).Magnitude <= Settings.BoxRange then
        Box_GetPlayerBox().showUntil = now + Settings.BoxDisplayDuration
    end
end

-- FIX H2: collect dead killers, then remove (avoid skip-during-pairs)
local function Box_RenderAll()
    if not Settings.BoxVisualEnabled then
        for _, box in pairs(BoxState.killerBoxes) do Box_HideWireframe(box.parts) end
        if BoxState.playerBox then Box_HideWireframe(BoxState.playerBox.parts) end
        return
    end
    local now = os.clock()
    local blockLen = math.max(Settings.BoxRange - Settings.BoxBlockDistance, 0.5)
    local dead = {}

    for killer, box in pairs(BoxState.killerBoxes) do
        if not killer.Parent then
            Box_DestroyWireframe(box.parts)
            dead[#dead + 1] = killer
        elseif not Box_IsWireframeValid(box.parts) then
            Box_DestroyWireframe(box.parts); box.parts = {}
        elseif now > box.showUntil then
            Box_HideWireframe(box.parts)
        else
            local st = BoxState.killers[killer]
            if st then
                local size = Vector3.new(Settings.BoxKillerW, Settings.BoxKillerH, blockLen)
                local center = st.pos + st.look * (blockLen / 2)
                local cf = CFrame.lookAt(center, center + st.look)
                local isFacing = Settings.UseBoxFacing and AB_PlayerInFacingZone(killer) or AB_IsFacingPlayer(killer)
                Box_UpdateWireframe(box.parts, cf, size, isFacing and GREEN or BLUE)
            else
                Box_HideWireframe(box.parts)
            end
        end
    end
    for _, k in ipairs(dead) do BoxState.killerBoxes[k] = nil end

    local pb = BoxState.playerBox
    if pb then
        if not Box_IsWireframeValid(pb.parts) then Box_DestroyWireframe(pb.parts); pb.parts = {}
        elseif now > pb.showUntil or not BoxState.player then Box_HideWireframe(pb.parts)
        else
            local s = Settings.BoxBlockDistance * 2
            local inDanger = false
            for killer, kbox in pairs(BoxState.killerBoxes) do
                if killer.Parent and now <= kbox.showUntil and AB_PlayerInFacingZone(killer) then
                    inDanger = true; break
                end
            end
            Box_UpdateWireframe(pb.parts, CFrame.new(BoxState.player), Vector3.new(s, s, s), inDanger and RED or BLUE)
        end
    end
end
local function Box_StartRender()
    if BoxState.renderConn then return end
    BoxState.renderConn = RunService.RenderStepped:Connect(function(dt)
        Box_UpdateSmoothing(dt or 0.016); Box_RenderAll()
    end)
end
local function Box_StopRender()
    if BoxState.renderConn then pcall(function() BoxState.renderConn:Disconnect() end); BoxState.renderConn = nil end
end
