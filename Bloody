safe("Auto Block", function()
    _G.HitboxWidth = 4.5
    _G.HitboxHeight = 6
    _G.HitboxLength = 7.5
    _G.HitboxOffset = -1.4
    _G.HitboxColor = Color3.fromRGB(220, 40, 50)
    _G.ShowOutline = true
    _G.OutlineThickness = 0.01
    _G.ShowHitboxVisual = true
    _G.HitboxTransparency = 0.5
    _G.HitboxDuration = 1.5
    _G.BlockDelay = 0
    _G.AutoBlockEnabled = false

    _G.BlockAbilityNames = {
        "PERFORATING", "LACERATE", "EVISCERATE", "CARVING SLASH",
        "STAB", "TAG", "SLASH", "ENRAGED SLASH",
    }

    local function shouldBlockAbility(name)
        if type(name) ~= "string" or name == "" then return false end
        local upper = string.upper(name)
        for _, bn in ipairs(_G.BlockAbilityNames) do
            if string.find(upper, string.upper(bn), 1, true) then return true end
        end
        return false
    end

    local function getAbilityName(killer)
        if not killer then return nil end
        for _, attr in ipairs({"AbilityName", "LastAbility", "CurrentAbility", "LastAbilityName", "AbilityUsed", "Ability", "CurrentAttack"}) do
            local ok, val = pcall(function() return killer:GetAttribute(attr) end)
            if ok and type(val) == "string" and val ~= "" then return val end
        end
        return nil
    end

    local function createSpatialOverlapBox(killerChar, size, onHit)
        if IsPlayerKiller() then return end
        if not killerChar or killerChar == LP.Character then return end
        local root = killerChar:FindFirstChild("HumanoidRootPart") or killerChar:FindFirstChild("RootPart")
        if not root then return end
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        op.FilterDescendantsInstances = { killerChar }
        task.spawn(function()
            local elapsed = 0
            while killerChar.Parent and root.Parent and elapsed < _G.HitboxDuration do
                if IsPlayerKiller() then return end
                local Part = Instance.new("Part")
                Part.Name = "Nos_BlockBox"
                Part.Transparency = _G.ShowHitboxVisual and _G.HitboxTransparency or 1
                Part.CanCollide = false; Part.CanTouch = false; Part.CanQuery = false
                Part.CastShadow = false; Part.Anchored = true
                Part.Size = size; Part.Color = _G.HitboxColor
                Part.Material = Enum.Material.ForceField
                Part.CFrame = root.CFrame * CFrame.new(0, 0, _G.HitboxOffset)
                Part.Parent = Workspace
                if _G.ShowOutline and _G.ShowHitboxVisual then
                    local sb = Instance.new("SelectionBox")
                    sb.Adornee = Part; sb.Color3 = _G.HitboxColor
                    sb.LineThickness = _G.OutlineThickness
                    sb.Transparency = 0.1; sb.Visible = true
                    sb.Parent = Part
                end
                Debris:AddItem(Part, 0.05)
                for _, v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                    local hum = v.Parent and v.Parent:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                        if _G.BlockDelay > 0 then task.wait(_G.BlockDelay) end
                        if onHit then onHit() end
                        return
                    end
                end
                elapsed = elapsed + RunService.Heartbeat:Wait()
            end
        end)
    end

    local lastTrigger = 0
    local function triggerBoxCheck(killer)
        if IsPlayerKiller() then return end
        if not killer or killer == LP.Character or not killer.Parent then return end
        local now = tick()
        if now - lastTrigger < 0.05 then return end
        lastTrigger = now
        -- Advanced box facing: spawn boxes and let green-touch fire block
        if FacingMode == "AdvancedBox" then
            AdvBox.SetKiller(killer)
            AdvBox.Trigger()
            -- still allow spatial box as backup hit volume when green
            return
        end
        if FacingMode == "Normal" and not PassesNormalFacing(killer) then
            return
        end
        createSpatialOverlapBox(killer, Vector3.new(_G.HitboxWidth, _G.HitboxHeight, _G.HitboxLength), FireBlockBuffer)
    end

    local monitoredKillers = {}
    local function monitorKiller(killer)
        if not killer or monitoredKillers[killer] or not killer:IsA("Model") then return end
        if killer == LP.Character then return end
        monitoredKillers[killer] = true
        local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
        local lastUsed = killer:GetAttribute("AbilitiesUsed") or 0
        local function onNewAbility()
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local name = getAbilityName(killer)
            if name == nil or shouldBlockAbility(name) then triggerBoxCheck(killer) end
        end
        killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            local cur = killer:GetAttribute("AbilityLastUsed") or 0
            if cur == lastAbility then return end
            lastAbility = cur
            local curUsed = killer:GetAttribute("AbilitiesUsed") or 0
            if curUsed > lastUsed then lastUsed = curUsed; return end
            onNewAbility()
        end)
        for _, attr in ipairs({"AbilityName", "LastAbility", "CurrentAbility", "LastAbilityName"}) do
            pcall(function() killer:GetAttributeChangedSignal(attr):Connect(onNewAbility) end)
        end
    end

    local remoteHooked = false
    local function hookAbilityRemote()
        if remoteHooked then return end
        remoteHooked = true
        local remote = getNetworkEvent()
        if not remote then return end
        local function argMatches(arg)
            if type(arg) == "string" then return shouldBlockAbility(arg) end
            if typeof(arg) == "buffer" then
                local ok, str = pcall(buffer.tostring, arg)
                if ok and str then return shouldBlockAbility(str) end
            end
            return false
        end
        remote.OnClientEvent:Connect(function(...)
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            for _, arg in ipairs({...}) do
                if argMatches(arg) then
                    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
                    if kf then
                        for _, k in ipairs(kf:GetChildren()) do
                            if k:IsA("Model") and k ~= LP.Character then triggerBoxCheck(k); break end
                        end
                    end
                    break
                end
            end
        end)
    end

    task.spawn(function()
        while not _ShuttingDown do
            task.wait(1)
            if _G.AutoBlockEnabled and not IsPlayerKiller() then
                local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
                if kf then
                    for _, k in ipairs(kf:GetChildren()) do
                        if k:IsA("Model") and k ~= LP.Character then monitorKiller(k) end
                    end
                end
            end
        end
    end)

    AdvBox.OnValid = function(killer)
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        if FacingMode == "AdvancedBox" then
            FireBlockBuffer()
        end
    end

    local function EnableAutoBlock()
        if IsPlayerKiller() then return end
        hookAbilityRemote()
        local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
        if kf then
            for _, k in ipairs(kf:GetChildren()) do
                if k:IsA("Model") and k ~= LP.Character then monitorKiller(k) end
            end
        end
    end

    local BlockLeft = Tabs.Block:AddLeftGroupbox("Auto Block", "shield")
    local BlockRight = Tabs.Block:AddRightGroupbox("Hitbox Settings", "sliders")
    BlockLeft:AddToggle("AutoBlockToggle", {
        Text = "Enable AutoBlock", Default = false,
        Callback = function(v)
            if v and IsPlayerKiller() then
                Library:Notify({ Title = "Nos Hub", Description = "Auto-Block disabled (Killer)", Time = 3 })
                pcall(function() Toggles.AutoBlockToggle:SetValue(false) end)
                return
            end
            _G.AutoBlockEnabled = v
            if v then EnableAutoBlock() end
        end,
    })
    BlockLeft:AddToggle("ShowBox_T", {
        Text = "Show Hitbox", Default = true,
        Callback = function(v) _G.ShowHitboxVisual = v end,
    })
    BlockLeft:AddSlider("HitboxTransparency", {
        Text = "Transparency", Default = 0.5, Min = 0, Max = 1, Rounding = 2,
        Callback = function(v) _G.HitboxTransparency = v end,
    })
    BlockLeft:AddLabel("Hitbox Color"):AddColorPicker("HitboxColor", {
        Default = _G.HitboxColor, Title = "Hitbox Color",
        Callback = function(c) _G.HitboxColor = c end,
    })
    BlockLeft:AddSlider("BlockDelay", {
        Text = "Block Delay", Default = 0, Min = 0, Max = 1, Rounding = 2,
        Callback = function(v) _G.BlockDelay = v end,
    })
    BlockLeft:AddButton({ Text = "Force Block", Func = function() FireBlockBuffer() end })
    BlockLeft:AddButton({ Text = "Force Punch", Func = function() FirePunch() end })

    BlockRight:AddSlider("HitboxWidth", {
        Text = "Width (X)", Default = 4.5, Min = 1, Max = 30, Rounding = 1,
        Callback = function(v) _G.HitboxWidth = v end,
    })
    BlockRight:AddSlider("HitboxHeight", {
        Text = "Height (Y)", Default = 6, Min = 1, Max = 30, Rounding = 1,
        Callback = function(v) _G.HitboxHeight = v end,
    })
    BlockRight:AddSlider("HitboxLength", {
        Text = "Length (Z)", Default = 7.5, Min = 1, Max = 30, Rounding = 1,
        Callback = function(v) _G.HitboxLength = v end,
    })
    BlockRight:AddSlider("HitboxOffset", {
        Text = "Offset (Z)", Default = -1.4, Min = -10, Max = 5, Rounding = 1,
        Callback = function(v) _G.HitboxOffset = v end,
    })
    BlockRight:AddSlider("HitboxDuration", {
        Text = "Duration", Default = 1.5, Min = 0.1, Max = 5, Rounding = 2,
        Callback = function(v) _G.HitboxDuration = v end,
    })
end)

print("[Nos Hub] Gen/Block OK")

