function KillerParry.getLocalKiller()
    local character = lp.Character
    if not character or character.Parent ~= KillersFolder then return nil end
    local name = string.lower(tostring_ref(character.Name)):gsub("[^%w]", "")
    if name == "johndoe" and KillerParry.enabled404 then
        return character, "JohnDoe", "404Error", 20
    elseif name == "slasher" and KillerParry.enabledRaging then
        return character, "Slasher", "RagingPace", 30
    end
    return nil
end

function KillerParry.fireAbility(abilityName)
    if type(abilityName) ~= "string" or abilityName == "" then return false end
    local ok = pcall(function()
        local bytes = { 3, #abilityName, 0, 0, 0 }
        for i = 1, #abilityName do bytes[#bytes + 1] = string.byte(abilityName, i) end
        local payload = buffer.create(#bytes)
        for i = 1, #bytes do buffer.writeu8(payload, i - 1, bytes[i]) end
        testRemote:FireServer("UseActorAbility", payload)
    end)
    return ok
end

function KillerParry.onTrack(survivorModel, track)
    if not track or KillerParry.seenTracks[track] then return end
    local animation = track.Animation
    local animationId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")
    if not animationId or not KillerParry.animsToDetect[animationId] then return end

    local killerCharacter, killerKey, abilityName, abilityCooldown = KillerParry.getLocalKiller()
    if not killerCharacter then return end
    local killerRoot = killerCharacter:FindFirstChild("HumanoidRootPart")
    local survivorRoot = survivorModel and survivorModel:FindFirstChild("HumanoidRootPart")
    if not killerRoot or not survivorRoot then return end
    if (survivorRoot.Position - killerRoot.Position).Magnitude > KillerParry.range then return end

    local now = os.clock()
    if now - (KillerParry.lastUse[killerKey] or 0) < abilityCooldown then return end
    -- Trigger once per qualifying animation. The previous code spammed
    -- the ability repeatedly for three seconds after a single detection.
    KillerParry.seenTracks[track] = true
    KillerParry.lastUse[killerKey] = now
    KillerParry.fireAbility(abilityName)
end

function KillerParry.attachAnimator(animator, survivorModel)
    if not animator or not animator:IsA("Animator") or KillerParry.animatorConnections[animator] then return end
    KillerParry.animatorConnections[animator] = animator.AnimationPlayed:Connect(function(track)
        KillerParry.onTrack(survivorModel, track)
    end)
end

function KillerParry.attachSurvivor(model)
    if not model or not model:IsA("Model") or KillerParry.modelConnections[model] then return end
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("Animator") then KillerParry.attachAnimator(descendant, model) end
    end
    KillerParry.modelConnections[model] = model.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Animator") then KillerParry.attachAnimator(descendant, model) end
    end)
end

for _, survivor in ipairs(Workspace:WaitForChild("Players"):WaitForChild("Survivors"):GetChildren()) do
    KillerParry.attachSurvivor(survivor)
end
Workspace.Players.Survivors.ChildAdded:Connect(KillerParry.attachSurvivor)

function KillerParry.updateVisual()
    if not KillerParry.showRange then
        if KillerParry.visual then pcall(function() KillerParry.visual:Destroy() end); KillerParry.visual = nil end
        return
    end
    local killerCharacter = lp.Character
    local killerRoot = killerCharacter and killerCharacter.Parent == KillersFolder
        and killerCharacter:FindFirstChild("HumanoidRootPart") or nil
    if not killerRoot then
        if KillerParry.visual then pcall(function() KillerParry.visual:Destroy() end); KillerParry.visual = nil end
        return
    end
    if not KillerParry.visual or KillerParry.visual.Parent ~= killerRoot then
        if KillerParry.visual then pcall(function() KillerParry.visual:Destroy() end) end
        local ok, adornment = pcall(function() return Instance.new("CylinderHandleAdornment") end)
        if not ok or not adornment then return end
        KillerParry.visual = adornment
        adornment.Name = "BloodsakenKillerParryRadius"
        adornment.Adornee = killerRoot
        adornment.Color3 = Color3.fromRGB(255, 65, 80)
        adornment.Transparency = 0.55
        adornment.AlwaysOnTop = true
        adornment.Height = 0.08
        adornment.Parent = killerRoot
    end
    pcall(function()
        KillerParry.visual.Radius = KillerParry.range
        KillerParry.visual.CFrame = CFrame.new(0, -(killerRoot.Size.Y * 0.5 + 0.08), 0)
    end)
end
