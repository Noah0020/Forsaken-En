local SyncESPBoxSettings = addGroup(Tabs.ESP, "Right", "Sync ESP Box Editor", "Resize and position Syncsaken ESP labels", "box")
local function UpdateSyncESPBoxSettings()
    local width = math.clamp(tonumber(Settings.SyncESPBoxWidth) or 133, 60, 320)
    local height = math.clamp(tonumber(Settings.SyncESPBoxHeight) or 15, 10, 60)
    local offset = math.clamp(tonumber(Settings.SyncESPBoxOffset) or 3, 0, 12)
    local maxDistance = math.clamp(tonumber(Settings.SyncESPBoxMaxDistance) or 2000, 50, 5000)
    local fillTransparency = math.clamp(tonumber(Settings.SyncESPFillTransparency) or 0.7, 0, 1)
    if t7 and t7.highlighter then t7.highlighter.FillTransparency = fillTransparency end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Name == "__SBB" then
            obj.Size = UDim2.fromOffset(width, height)
            obj.StudsOffset = Vector3.new(0, offset, 0)
            obj.MaxDistance = maxDistance
        elseif obj:IsA("Highlight") and obj.Name == "__SESP" then
            obj.FillTransparency = fillTransparency
        end
    end
end
