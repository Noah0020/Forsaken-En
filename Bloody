        local function tpSlash()
            if busy or not Character or not Character.PrimaryPart then return end
            busy = true
            pcall(function()
                local k = Killers:GetChildren()[1]
                if not k then busy=false; return end
                local kr = k:FindFirstChild("HumanoidRootPart")
                local kh = k:FindFirstChildOfClass("Humanoid")
                if not kh or not kh:FindFirstChild("Animator") then busy=false; return end
                local mr = Character:FindFirstChild("HumanoidRootPart")
                local base = mr.CFrame; local t0 = os.clock()
                aim:Aimbot(kr, 0.7); task.wait(0.125)
                while os.clock()-t0 < 0.7 and kr and mr do
                    task.wait()
                    mr.CFrame = CFrame.new(aim:PredictNextPosition(kr), kr.Position*vector.create(1.001,1.001,1.001)) end
                mr.CFrame = base end)
            busy = false
        end
