--[[ ============================================================
     DOGGYSAKNE | EXTENDED ESP
     Survivor, Killer, Generator, Spray, Minion, Trap, Item, Jane Quest
     Local visual overlays only. Each category owns and cleans its own objects.
============================================================ ]]
local DoggysakneESP = {}
local DS_ESP = {categories={}, highlightFolder=nil, billboardFolder=nil}

local ESP_DEFAULT_COLORS = {
    survivor = Color3.fromRGB(70, 235, 120),
    killer = Color3.fromRGB(255, 75, 75),
    generator = Color3.fromRGB(80, 155, 255),
    spray = Color3.fromRGB(70, 220, 235),
    minion = Color3.fromRGB(255, 160, 60),
    trap = Color3.fromRGB(220, 90, 255),
    item = Color3.fromRGB(255, 225, 80),
    contract = Color3.fromRGB(255, 110, 190),
}

local function ensureESPFolders()
    local highlightParent = CoreGui or PlayerGui
    local billboardParent = PlayerGui or CoreGui
    if not highlightParent or not billboardParent then return false end
    if not DS_ESP.highlightFolder or not DS_ESP.highlightFolder.Parent then
        local old = highlightParent:FindFirstChild("Doggysakne_ExtendedESP_Highlights")
        if old then old:Destroy() end
        local folder = Instance.new("Folder")
        folder.Name = "Doggysakne_ExtendedESP_Highlights"
        folder.Parent = highlightParent
        DS_ESP.highlightFolder = folder
    end
    if not DS_ESP.billboardFolder or not DS_ESP.billboardFolder.Parent then
        local old = billboardParent:FindFirstChild("Doggysakne_ExtendedESP_Labels")
        if old then old:Destroy() end
        local folder = Instance.new("Folder")
        folder.Name = "Doggysakne_ExtendedESP_Labels"
        folder.Parent = billboardParent
        DS_ESP.billboardFolder = folder
    end
    return true
end

local function getIngameRoot()
    local map = Workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Ingame")
end

local function getCategoryRoot(key)
    local playersFolder = Workspace:FindFirstChild("Players")
    if key == "survivor" then return playersFolder and playersFolder:FindFirstChild("Survivors") end
    if key == "killer" then return playersFolder and playersFolder:FindFirstChild("Killers") end
    if key == "generator" or key == "spray" then return getIngameRoot() end
    return Workspace
end

local function isContractMesh(obj)
    return obj and obj:IsA("MeshPart") and obj.Name == "Model"
        and (obj.MeshId == "rbxassetid://116433898437270" or obj.MeshId == "rbxassetid://81503280733693")
end

local function isExtendedCandidate(key, obj)
    if not obj or not obj.Parent then return false end
    if key == "survivor" or key == "killer" then
        if not obj:IsA("Model") then return false end
        local player = Players:GetPlayerFromCharacter(obj)
        if not player or player == LocalPlayer then return false end
        local playersFolder = Workspace:FindFirstChild("Players")
        local group = playersFolder and playersFolder:FindFirstChild(key == "survivor" and "Survivors" or "Killers")
        return group ~= nil and obj:IsDescendantOf(group)
    elseif key == "generator" then
        if not obj:IsA("Model") or obj.Name ~= "Generator" then return false end
        local progress = obj:FindFirstChild("Progress") or obj:FindFirstChildOfClass("NumberValue")
        return progress ~= nil and progress:IsA("NumberValue") and progress.Value < 100
    elseif key == "spray" then
        return obj:IsA("Model") and string.find(string.lower(obj.Name), "spray", 1, true) ~= nil
    elseif key == "minion" then
        return obj:IsA("Model") and (obj.Name == "PizzaDeliveryRig" or obj.Name == "1x1x1x1Zombie")
    elseif key == "trap" then
        if not obj:IsA("Model") then return false end
        local playersFolder = Workspace:FindFirstChild("Players")
        local survivors = playersFolder and playersFolder:FindFirstChild("Survivors")
        if survivors and obj:IsDescendantOf(survivors) then return false end
        return obj.Name == "SubspaceTripmine"
            or string.find(obj.Name, "TaphTripwire", 1, true) ~= nil
    elseif key == "item" then
        if not obj:IsA("Tool") or (obj.Name ~= "BloxyCola" and obj.Name ~= "Medkit") then return false end
        local playersFolder = Workspace:FindFirstChild("Players")
        return playersFolder == nil or not obj:IsDescendantOf(playersFolder)
    elseif key == "contract" then
        return isContractMesh(obj)
    end
    return false
end

local function getESPAnchor(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    if obj:IsA("Tool") then
        return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function getESPText(key, obj)
    if key == "survivor" or key == "killer" then
        local humanoid = obj:FindFirstChildOfClass("Humanoid")
        if humanoid then return string.format("%s  |  %d HP", obj.Name, math.max(0, math.floor(humanoid.Health))) end
    elseif key == "generator" then
        local progress = obj:FindFirstChild("Progress") or obj:FindFirstChildOfClass("NumberValue")
        if progress and progress:IsA("NumberValue") then
            return string.format("Generator  |  %d%%", math.floor(progress.Value))
        end
    end
    return obj.Name
end

local function disposeESPRecord(category, obj)
    local record = category.tracked[obj]
    if not record then return end
    category.tracked[obj] = nil
    for _, connection in ipairs(record.connections) do
        if connection and connection.Connected then pcall(function() connection:Disconnect() end) end
    end
    if record.highlight and record.highlight.Parent then pcall(function() record.highlight:Destroy() end) end
    if record.billboard and record.billboard.Parent then pcall(function() record.billboard:Destroy() end) end
end

local function addESPRecord(key, category, obj)
    if not category.enabled or category.tracked[obj] or not isExtendedCandidate(key, obj) then return end
    if not ensureESPFolders() then return end
    local anchor = getESPAnchor(obj)
    if not anchor then return end

    local color = category.color
    local highlight = Instance.new("Highlight")
    highlight.Name = "Doggysakne_" .. key .. "_Highlight"
    highlight.Adornee = obj
    highlight.FillColor = color
    highlight.FillTransparency = 0.72
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = DS_ESP.highlightFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Doggysakne_" .. key .. "_Label"
    billboard.Adornee = anchor
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 2000
    billboard.Size = UDim2.fromOffset(160, 22)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = DS_ESP.billboardFolder

    local label = Instance.new("TextLabel")
    label.Name = "Text"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Text = getESPText(key, obj)
    label.TextColor3 = color
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextStrokeTransparency = 0.2
    label.TextWrapped = true
    label.Parent = billboard

    local record = {highlight=highlight, billboard=billboard, label=label, connections={}}
    category.tracked[obj] = record

    local humanoid = obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid")
    if humanoid then
        table.insert(record.connections, humanoid.HealthChanged:Connect(function()
            if label.Parent then label.Text = getESPText(key, obj) end
        end))
    end
    if key == "generator" then
        local progress = obj:FindFirstChild("Progress") or obj:FindFirstChildOfClass("NumberValue")
        if progress and progress:IsA("NumberValue") then
            table.insert(record.connections, progress.Changed:Connect(function()
                if label.Parent then label.Text = getESPText(key, obj) end
                if progress.Value >= 100 then disposeESPRecord(category, obj) end
            end))
        end
    end
    table.insert(record.connections, obj.AncestryChanged:Connect(function(_, parent)
        if parent == nil then disposeESPRecord(category, obj) end
    end))
end

local function tryESPObject(key, category, obj)
    if not category.enabled or not obj then return end
    addESPRecord(key, category, obj)

    -- The game can parent a character before its Player.Character mapping settles.
    -- Retry player models after their normal spawn delay instead of silently missing them.
    local candidateModel = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if (key == "survivor" or key == "killer") and candidateModel then
        category.pending = category.pending or setmetatable({}, {__mode="k"})
        if not category.pending[candidateModel] then
            category.pending[candidateModel] = true
            task.delay(3.6, function()
                category.pending[candidateModel] = nil
                if category.enabled and candidateModel.Parent then
                    addESPRecord(key, category, candidateModel)
                end
            end)
        end
    end

    -- Some game objects receive their Progress/Handle after the Model/Tool is parented.
    local ancestor = obj:FindFirstAncestorOfClass("Model")
    if ancestor and ancestor ~= obj then addESPRecord(key, category, ancestor) end
    local toolAncestor = obj:FindFirstAncestorOfClass("Tool")
    if toolAncestor and toolAncestor ~= obj then addESPRecord(key, category, toolAncestor) end
end

function DoggysakneESP.SetEnabled(key, enabled)
    local category = DS_ESP.categories[key]
    if not category then return false end
    enabled = enabled == true
    if category.enabled == enabled then return true end
    category.enabled = enabled

    if not enabled then
        if category.addedConnection then
            pcall(function() category.addedConnection:Disconnect() end)
            category.addedConnection = nil
        end
        local objects = {}
        for obj in pairs(category.tracked) do table.insert(objects, obj) end
        for _, obj in ipairs(objects) do disposeESPRecord(category, obj) end
        return true
    end

    if not ensureESPFolders() then
        category.enabled = false
        return false
    end
    local root = getCategoryRoot(key)
    if root then
        if isExtendedCandidate(key, root) then addESPRecord(key, category, root) end
        for _, obj in ipairs(root:GetDescendants()) do
            if not category.enabled then break end
            if isExtendedCandidate(key, obj) then
                addESPRecord(key, category, obj)
            elseif key == "survivor" or key == "killer" then
                tryESPObject(key, category, obj)
            end
        end
    end
    category.addedConnection = Workspace.DescendantAdded:Connect(function(obj)
        task.defer(function()
            if category.enabled then tryESPObject(key, category, obj) end
        end)
    end)
    return true
end

function DoggysakneESP.SetColor(key, color)
    local category = DS_ESP.categories[key]
    if not category or typeof(color) ~= "Color3" then return false end
    category.color = color
    for _, record in pairs(category.tracked) do
        if record.highlight and record.highlight.Parent then
            record.highlight.FillColor = color
            record.highlight.OutlineColor = color
        end
        if record.label and record.label.Parent then record.label.TextColor3 = color end
    end
    return true
end

function DoggysakneESP.DisableAll()
    for key in pairs(DS_ESP.categories) do DoggysakneESP.SetEnabled(key, false) end
end

function DoggysakneESP.IsEnabled(key)
    local category = DS_ESP.categories[key]
    return category and category.enabled or false
end

for key, color in pairs(ESP_DEFAULT_COLORS) do
    DS_ESP.categories[key] = {enabled=false, color=color, tracked=setmetatable({}, {__mode="k"}), addedConnection=nil}
end

function DoggysakneESP.Destroy()
    DoggysakneESP.DisableAll()
    if DS_ESP.highlightFolder then pcall(function() DS_ESP.highlightFolder:Destroy() end); DS_ESP.highlightFolder=nil end
    if DS_ESP.billboardFolder then pcall(function() DS_ESP.billboardFolder:Destroy() end); DS_ESP.billboardFolder=nil end
end

_G.DoggysakneESP = DoggysakneESP
