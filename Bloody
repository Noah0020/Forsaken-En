local ESP = { folder=nil }
local function StartESP()
    if ESP.folder and ESP.folder.Parent then return end
    ESP.folder = Instance.new("Folder"); ESP.folder.Name = "Ivy_FullESP"; ESP.folder.Parent = Workspace
end
local function buildHL(part, color, tagId)
    if not part or not part.Parent then return end
    if not ESP.folder or not ESP.folder.Parent then StartESP() end
    local name = "IvyHL_"..tagId
    local existing = ESP.folder and ESP.folder:FindFirstChild(name)
    if existing then existing.FillColor = color; existing.OutlineColor = color; existing.Adornee = part; return end
    local h = Instance.new("Highlight"); h.Name = name; h.Adornee = part
    h.FillColor = color; h.OutlineColor = color; h.FillTransparency = 0.6; h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; h.Parent = ESP.folder
end
local function applyFullESP()
    if not ESP.folder or not ESP.folder.Parent then
        ESP.folder = Instance.new("Folder"); ESP.folder.Name = "Ivy_FullESP"; ESP.folder.Parent = Workspace
    end
    local active = {}
    if Settings.ESP_Killer then for _, k in ipairs(getKillers()) do local r = getRoot(k); local h = getHum(k); if r and h and h.Health > 0 then buildHL(k, Settings.ESP_KillerColor, "K_"..k:GetDebugId()); active["K_"..k:GetDebugId()] = true end end end
    if Settings.ESP_Survivor then for _, s in ipairs(getSurvivors()) do if s ~= LocalPlayer.Character then local r = getRoot(s); local h = getHum(s); if r and h and h.Health > 0 then buildHL(s, Settings.ESP_SurvivorColor, "S_"..s:GetDebugId()); active["S_"..s:GetDebugId()] = true end end end end
    if Settings.ESP_Generator then
        local ingame = getIngame(); local map = ingame and ingame:FindFirstChild("Map")
        if map then for _, g in ipairs(map:GetChildren()) do
            if g.Name == "Generator" or g.Name == "FakeGenerator" then
                local prog = g:FindFirstChild("Progress")
                local color = g.Name == "FakeGenerator" and Color3.fromRGB(255,130,40) or (prog and prog:IsA("NumberValue") and prog.Value >= 100) and Color3.fromRGB(0,255,100) or Settings.ESP_GeneratorColor
                buildHL(g, color, "G_"..g:GetDebugId()); active["G_"..g:GetDebugId()] = true
            end
        end end
    end
    if Settings.ESP_Item then
        local ingame = getIngame()
        if ingame then for _, t in ipairs(ingame:GetDescendants()) do
            if t:IsA("Tool") then local p = t:FindFirstChildWhichIsA("BasePart"); if p then buildHL(p, Settings.ESP_ItemColor, "I_"..t:GetDebugId()); active["I_"..t:GetDebugId()] = true end end
        end end
    end
    if Settings.ESP_Trap then
        local ingame = getIngame()
        if ingame then for _, d in ipairs(ingame:GetDescendants()) do
            local n = d.Name:lower()
            if d:IsA("Model") and (n:find("tripwire") or n:find("traph") or n:find("trap")) then buildHL(d, Settings.ESP_TrapColor, "T_"..d:GetDebugId()); active["T_"..d:GetDebugId()] = true
            elseif d:IsA("BasePart") and (n:find("tripwire") or n:find("subspace")) then buildHL(d, Settings.ESP_TrapColor, "T_"..d:GetDebugId()); active["T_"..d:GetDebugId()] = true end
        end end
    end
    if Settings.ESP_Footprint then
        local ingame = getIngame()
        if ingame then for _, f in ipairs(ingame:GetChildren()) do
            if f:IsA("Folder") and f.Name:lower():find("shadows") then
                for _, p in ipairs(f:GetChildren()) do if p:IsA("BasePart") then buildHL(p, Settings.ESP_FootprintColor, "F_"..p:GetDebugId()); active["F_"..p:GetDebugId()] = true end end
            end
        end end
    end
    if Settings.ESP_Minion then for _, k in ipairs(getKillers()) do if not Players:GetPlayerFromCharacter(k) then local r = getRoot(k); local h = getHum(k); if r and h and h.Health > 0 then buildHL(k, Settings.ESP_MinionColor, "M_"..k:GetDebugId()); active["M_"..k:GetDebugId()] = true end end end end
    if Settings.ESP_EventItem then
        local ingame = getIngame()
        if ingame then for _, d in ipairs(ingame:GetDescendants()) do
            local n = d.Name:lower()
            if (d:IsA("Model") or d:IsA("BasePart")) and (n:find("gingerbread") or n:find("sukkar") or n:find("sukar")) then
                buildHL(d, Settings.ESP_EventItemColor, "E_"..d:GetDebugId()); active["E_"..d:GetDebugId()] = true
            end
        end end
    end
    if Settings.ESP_Sentry then
        local ingame = getIngame()
        if ingame then for _, d in ipairs(ingame:GetDescendants()) do
            local n = d.Name:lower()
            if d:IsA("Model") and (n:find("sentry") or n:find("dispenser")) then buildHL(d, Settings.ESP_SentryColor, "SN_"..d:GetDebugId()); active["SN_"..d:GetDebugId()] = true end
        end end
    end
    if Settings.ESP_Graffiti then
        local ingame = getIngame()
        if ingame then for _, d in ipairs(ingame:GetDescendants()) do
            local n = d.Name:lower()
            if (d:IsA("Decal") or d:IsA("Texture")) and (n:find("graffiti") or n:find("spray")) then
                local p = d.Parent; if p and p:IsA("BasePart") then buildHL(p, Settings.ESP_GraffitiColor, "GR_"..p:GetDebugId()); active["GR_"..p:GetDebugId()] = true end
            end
        end end
    end
    if Settings.ESP_Subspace then for _, d in ipairs(Workspace:GetDescendants()) do
        local n = d.Name:lower()
        if d:IsA("BasePart") and (n:find("subspace") or n == "groundbulb" or n == "vine") then buildHL(d, Settings.ESP_SubspaceColor, "SB_"..d:GetDebugId()); active["SB_"..d:GetDebugId()] = true end
    end end
    for _, c in ipairs(ESP.folder:GetChildren()) do
        if c:IsA("Highlight") then
            local tag = (c.Name:gsub("^IvyHL_", ""))
            if not active[tag] then c:Destroy() end
        end
    end
end

