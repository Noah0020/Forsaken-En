local BoxState = {
    killers = {}, player = nil, killerBoxes = {}, playerBox = nil,
    rootFolder = nil, renderConn = nil,
}

local function Box_GetRoot()
    if BoxState.rootFolder and BoxState.rootFolder.Parent then return BoxState.rootFolder end
    if BoxState.rootFolder then pcall(function() BoxState.rootFolder:Destroy() end) end
    local f = Instance.new("Folder")
    f.Name = "FMO_Box"
    f.Parent = Workspace
    BoxState.rootFolder = f
    return f
end

local function Box_Alpha(dt)
    return 1 - math.exp(-dt / math.max(Settings.BoxFollowDelay, 0.001))
end

local function Box_UpdateSmoothing(dt)
    local hrp = LocalRoot
    if hrp then
        if not BoxState.player then BoxState.player = hrp.Position
        else BoxState.player = BoxState.player:Lerp(hrp.Position, Box_Alpha(dt)) end
    end
    local kf = GetKillersFolder()
    if not kf then return end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            local khrp = k:FindFirstChild("HumanoidRootPart")
            if khrp then
                local st = BoxState.killers[k]
                if not st then
                    st = { pos = khrp.Position, look = khrp.CFrame.LookVector, facingDot = 0, lastFacingDot = 0, turnRate = 0, angularVel = 0 }
                    BoxState.killers[k] = st
                else
                    local a = Box_Alpha(dt)
                    st.pos = st.pos:Lerp(khrp.Position, a)
                    local nl = khrp.CFrame.LookVector
                    local prev = st.look
                    st.look = st.look:Lerp(nl, a)
                    if st.look.Magnitude > 0.01 then st.look = st.look.Unit else st.look = nl.Unit end
                    st.angularVel = prev:Cross(nl).Magnitude / math.max(dt, 0.001)
                end
                if BoxState.player then
                    local toP = BoxState.player - st.pos
                    local fl = Vector3.new(st.look.X, 0, st.look.Z)
                    local ft = Vector3.new(toP.X, 0, toP.Z)
                    if fl.Magnitude > 0.01 and ft.Magnitude > 0.01 then
                        local dot = fl.Unit:Dot(ft.Unit)
                        st.lastFacingDot = st.facingDot or dot
                        st.facingDot = dot
                        st.turnRate = (st.facingDot - st.lastFacingDot) / math.max(dt, 0.001)
                    end
                end
            else
                BoxState.killers[k] = nil
            end
        end
    end
    for k in pairs(BoxState.killers) do if not k.Parent then BoxState.killers[k] = nil end end
end

local function AB_IsFacing(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end
    local toP = BoxState.player - st.pos
    if toP.Magnitude < 0.4 then return false end
    local fl = Vector3.new(st.look.X, 0, st.look.Z)
    local ft = Vector3.new(toP.X, 0, toP.Z)
    if fl.Magnitude < 0.01 or ft.Magnitude < 0.01 then return false end
    return fl.Unit:Dot(ft.Unit) >= Settings.BoxFacingDot
end

local function AB_ShouldBlock(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end
    local toP = BoxState.player - st.pos
    local dist = toP.Magnitude
    if dist > Settings.BoxRange or dist < 0.3 then return false end
    local fl = Vector3.new(st.look.X, 0, st.look.Z)
    local ft = Vector3.new(toP.X, 0, toP.Z)
    if fl.Magnitude < 0.01 or ft.Magnitude < 0.01 then return false end
    local facingDot = fl.Unit:Dot(ft.Unit)
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if khrp then
        local kv = khrp.AssemblyLinearVelocity
        if kv.Magnitude > Settings.BoxFastThreshold then
            local fv = Vector3.new(kv.X, 0, kv.Z)
            if fv.Magnitude > 0.4 and fv.Unit:Dot(ft.Unit) < Settings.BoxFastDot then return false end
        end
    end
    local blockLen = math.max(Settings.BoxRange - Settings.BoxBlockDistance, 0.5)
    if ft:Dot(fl.Unit) > (blockLen + Settings.BoxBlockDistance + Settings.BoxOffset) then return false end
    if facingDot >= Settings.BoxFacingDot then return true end
    if Settings.BoxAntiBait then
        if st.turnRate and st.turnRate > Settings.BoxTurnRate and facingDot >= 0.08 then return true end
        if st.angularVel and st.angularVel > 3.8 and facingDot >= 0.04 then return true end
    end
    return false
end

local WIRE_C = {
    Vector3.new(-0.5,-0.5,-0.5), Vector3.new(0.5,-0.5,-0.5),
    Vector3.new(0.5,-0.5,0.5), Vector3.new(-0.5,-0.5,0.5),
    Vector3.new(-0.5,0.5,-0.5), Vector3.new(0.5,0.5,-0.5),
    Vector3.new(0.5,0.5,0.5), Vector3.new(-0.5,0.5,0.5),
}
local WIRE_E = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}

local function Box_CreateParts(parent)
    local parts = {}
    for i, e in ipairs(WIRE_E) do
        local p = Instance.new("Part")
        p.Name = "Edge"; p.Anchored = true; p.CanCollide = false; p.CanTouch = false
        p.CanQuery = false; p.CastShadow = false; p.Material = Enum.Material.Neon
        p.Transparency = 1; p.Size = Vector3.new(0.05,0.05,1); p.Parent = parent
        parts[i] = { part = p, c1 = WIRE_C[e[1]], c2 = WIRE_C[e[2]] }
    end
    return parts
end

local function Box_UpdateParts(parts, cf, size, color)
    if not parts then return end
    for _, p in ipairs(parts) do
        if p.part and p.part.Parent then
            local a = cf:PointToWorldSpace(Vector3.new(p.c1.X*size.X, p.c1.Y*size.Y, p.c1.Z*size.Z))
            local b = cf:PointToWorldSpace(Vector3.new(p.c2.X*size.X, p.c2.Y*size.Y, p.c2.Z*size.Z))
            local len = (b - a).Magnitude
            if len > 0.001 then
                p.part.Transparency = Settings.BoxTransparency
                p.part.Color = color
                p.part.Size = Vector3.new(0.055, 0.055, len)
                p.part.CFrame = CFrame.lookAt((a+b)/2, b)
            else
                p.part.Transparency = 1
            end
        end
    end
end

local function Box_Hide(parts)
    if not parts then return end
    for _, p in ipairs(parts) do if p.part then p.part.Transparency = 1 end end
end

local function Box_DestroyParts(parts)
    if not parts then return end
    for _, p in ipairs(parts) do if p.part then pcall(function() p.part:Destroy() end) end end
end

local function Box_GetKillerBox(killer)
    local b = BoxState.killerBoxes[killer]
    if b and b.parts and b.parts[1] and b.parts[1].part and b.parts[1].part.Parent then return b end
    if b then Box_DestroyParts(b.parts) end
    b = { parts = Box_CreateParts(Box_GetRoot()), showUntil = 0 }
    BoxState.killerBoxes[killer] = b
    return b
end

local function Box_GetPlayerBox()
    local pb = BoxState.playerBox
    if pb and pb.parts and pb.parts[1] and pb.parts[1].part and pb.parts[1].part.Parent then return pb end
    if pb then Box_DestroyParts(pb.parts) end
    pb = { parts = Box_CreateParts(Box_GetRoot()), showUntil = 0 }
    BoxState.playerBox = pb
    return pb
end

local function Box_Show(killer)
    if not Settings.AB_ShowZone then return end
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp then return end
    local chrp = LocalRoot
    if not chrp then return end
    local st = BoxState.killers[killer]
    if st then st.pos = khrp.Position; st.look = khrp.CFrame.LookVector
    else BoxState.killers[killer] = { pos = khrp.Position, look = khrp.CFrame.LookVector, facingDot=0, lastFacingDot=0, turnRate=0, angularVel=0 } end
    BoxState.player = chrp.Position
    local now = os.clock()
    Box_GetKillerBox(killer).showUntil = now + Settings.BoxDisplayDuration
    if (chrp.Position - khrp.Position).Magnitude <= Settings.BoxRange + 3 then
        Box_GetPlayerBox().showUntil = now + Settings.BoxDisplayDuration
    end
end

local GREEN = Color3.fromRGB(70, 255, 130)
local BLUE  = Color3.fromRGB(70, 150, 255)
local BAIT  = Color3.fromRGB(40, 130, 255)

local function Box_Render()
    if not Settings.AB_ShowZone then
        for _, box in pairs(BoxState.killerBoxes) do Box_Hide(box.parts) end
        if BoxState.playerBox then Box_Hide(BoxState.playerBox.parts) end
        return
    end
    local now = os.clock()
    local blockLen = math.max(Settings.BoxRange - Settings.BoxBlockDistance, 0.5)
    for killer, box in pairs(BoxState.killerBoxes) do
        if not killer.Parent then
            Box_DestroyParts(box.parts); BoxState.killerBoxes[killer] = nil
        elseif now > box.showUntil then
            Box_Hide(box.parts)
        else
            local st = BoxState.killers[killer]
            if st then
                local size = Vector3.new(Settings.BoxKillerW, Settings.BoxKillerH, blockLen)
                local center = st.pos + st.look * (blockLen/2 + Settings.BoxOffset)
                local cf = CFrame.lookAt(center, center + st.look)
                local color = BLUE
                if AB_IsFacing(killer) then color = GREEN
                elseif Settings.BoxAntiBait and st.turnRate and st.turnRate > Settings.BoxTurnRate * 0.55 then color = BAIT end
                Box_UpdateParts(box.parts, cf, size, color)
            else
                Box_Hide(box.parts)
            end
        end
    end
    local pb = BoxState.playerBox
    if pb then
        if now > pb.showUntil or not BoxState.player then Box_Hide(pb.parts)
        else
            local s = Settings.BoxBlockDistance * 2
            Box_UpdateParts(pb.parts, CFrame.new(BoxState.player), Vector3.new(s,s,s), BLUE)
        end
    end
end

BoxState.renderConn = RunService.RenderStepped:Connect(function(dt)
    Box_UpdateSmoothing(dt or 0.016)
    Box_Render()
end)

