local Stam = { running=false, thread=nil, mod=nil, Infinite=false }
local function Stam_GetMod()
    if Stam.mod then return Stam.mod end
    local ok, m = pcall(function() return require(ReplicatedStorage.Systems.Character.Game.Sprinting) end)
    if ok and type(m) == "table" then Stam.mod = m; return m end
    ok, m = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Character"):WaitForChild("Game"):WaitForChild("Sprinting"))
    end)
    if ok and type(m) == "table" then Stam.mod = m; return m end
    return nil
end
local function Stam_StartLoop()
    if Stam.running then return end
    Stam.running = true
    Stam.thread = task.spawn(function()
        while Stam.running and not _ShuttingDown do
            task.wait(0.01)
            local m = Stam.mod
            if m and Stam.Infinite then
                pcall(function()
                    m.Stamina = m.MaxStamina or 1000
                    m.StaminaLoss = 0
                    if m.StaminaDrain ~= nil then m.StaminaDrain = 0 end
                end)
            end
        end
    end)
end
local function Stam_StopLoop()
    Stam.running = false
    if Stam.thread then pcall(task.cancel, Stam.thread); Stam.thread = nil end
end
local function Stam_SetInfinite(v)
