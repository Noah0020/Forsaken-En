    hl.OutlineColor = Color3.fromRGB(255,255,0)
    hl.FillTransparency = 0.5
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = obj; hl.Parent = obj
end
local function detachGenESP(obj)
    local h = obj:FindFirstChild("GenESP"); if h then h:Destroy() end
end
local function scanGens(on)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Generator" then
            if on then attachGenESP(obj) else detachGenESP(obj) end
        end
    end
end

local function attachItemESP(obj, name, color)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end
    if obj.Name ~= name or obj:FindFirstChild("ItemESP_" .. name) then return end
    local hl = Instance.new("Highlight")
    hl.Name = "ItemESP_" .. name
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.5
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = obj; hl.Parent = obj
end
local function detachItemESP(name)
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o.Name == name then
            local h = o:FindFirstChild("ItemESP_" .. name)
            if h then h:Destroy() end
        end
    end
end
local function scanItems(name, color)
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o.Name == name then attachItemESP(o, name, color) end
    end
end

