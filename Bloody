local function getSoundPos(s)
    if not s or not s.Parent then return nil, nil end
    if s.Parent:IsA("BasePart") then return s.Parent.Position, s.Parent end
    if s.Parent:IsA("Attachment") and s.Parent.Parent and s.Parent.Parent:IsA("BasePart") then
        return s.Parent.Parent.Position, s.Parent.Parent
    end
    local f = s.Parent:FindFirstChildWhichIsA("BasePart", true)
    if f then return f.Position, f end
    return nil, nil
end

local function getCharFromDesc(inst)
    if not inst then return nil end
    local m = inst:FindFirstAncestorOfClass("Model")
    if m and m:FindFirstChildOfClass("Humanoid") then
        local kf = GetKillersFolder()
        if kf and m:IsDescendantOf(kf) then return m end
