local function IsPlayerKiller()
    local c = LP.Character
    if not c then return false end
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if kf and c:IsDescendantOf(kf) then return true end
    return KILLER_NAMES[c:GetAttribute("CharacterName") or c.Name] == true
end

local RemoteEvent, RemoteFunction
pcall(function()
    local n = ReplicatedStorage:FindFirstChild("Modules")
    n = n and n:FindFirstChild("Network")
    n = n and (n:FindFirstChild("Network") or n)
    if n then
        RemoteEvent = n:FindFirstChild("RemoteEvent")
        RemoteFunction = n:FindFirstChild("RemoteFunction")
    end
end)

local function getRE()
    if RemoteEvent and RemoteEvent.Parent then return RemoteEvent end
    pcall(function()
        RemoteEvent = ReplicatedStorage.Modules.Network.Network.RemoteEvent
    end)
    return RemoteEvent
end

local function getRF()
    if RemoteFunction and RemoteFunction.Parent then return RemoteFunction end
    pcall(function()
        RemoteFunction = ReplicatedStorage.Modules.Network.Network.RemoteFunction
    end)
    return RemoteFunction
end

local function FireAbility(name)
    local re = getRE()
    if not re then return end
    pcall(function()
        local b = buffer.create(5 + #name)
        buffer.writeu8(b, 0, 3)
        buffer.writeu32(b, 1, #name)
        buffer.writestring(b, 5, name)
        re:FireServer("UseActorAbility", { b })
    end)
    pcall(function()
        re:FireServer("UseActorAbility", { name })
    end)
end

local function GetNearestKiller(maxDist)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= LP.Character then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

