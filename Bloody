local function makeBillboard(target, kind)
    if kind=="killer" or kind=="survivor" then kind="player" end
    if kind=="footstep" then return end
    local bb=Instance.new("BillboardGui"); local st=Instance.new("UIStroke"); local lbl=Instance.new("TextLabel")
    bb.Name="__DogsakenBB"; bb.Archivable=false; bb.Parent=target; bb.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    bb.Active=true; bb.MaxDistance=2000; bb.AlwaysOnTop=true; bb.Size=UDim2.new(0,133,0,15)
    bb.StudsOffset=Vector3.new(0,3,0); lbl.Parent=bb; lbl.BackgroundTransparency=1
    lbl.Size=UDim2.new(1,0,1,0); lbl.Font=Enum.Font.Code; lbl.Text=target.Name
    lbl.TextColor3=Color3.fromRGB(255,255,255); lbl.TextScaled=true; lbl.TextSize=14; lbl.TextWrapped=true
    st.Parent=lbl; st.Color=Color3.fromRGB(0,0,0); st.Thickness=1.25
    table.insert(esp.visuals, bb)
    if kind=="player" then
        bb.Parent=target.PrimaryPart
        local h=target:FindFirstChildOfClass("Humanoid")
        if h then
            lbl.Text=target.Name.." | "..math.floor(h.Health).."HP"
            local c; c=h.HealthChanged:Connect(function(hp)
                if not bb or not lbl then c:Disconnect(); return end
                lbl.Text=target.Name.." | "..math.floor(hp).."HP" end)
        end
        local ac; ac=bb.AncestryChanged:Connect(function(_,p)
            if p==Ragdolls then bb:Destroy(); ac:Disconnect() end end)
    elseif kind=="generator" then
        local nv=target:FindFirstChildOfClass("NumberValue")
        lbl.Text=target.Name.." | "..math.floor(nv.Value).."%"
        local c; c=nv.Changed:Connect(function(v)
            if nv and bb and lbl then lbl.Text=target.Name.." | "..math.floor(v).."%"
            else c:Disconnect() end end)
    else lbl.Text = kind=="item" and target.Name or kind end
    return bb
end

local function attachESP(target, kind)
    if typeof(kind)~="string" or typeof(target)~="Instance" then return end
    if target:FindFirstChild("__DogsakenESP") then return end
    local c = esp.highlighter:Clone(); c.Archivable=false; c.FillColor=esp.colors[kind]
    c.Parent = kind~="spray" and target or target:FindFirstChildOfClass("BasePart")
    makeBillboard(target, kind)
end

local function removeESP(kind)
    local container = ({killer=Killers,survivor=Survivors,generator=mapRoot(),item=workspace})[kind]
    if not container then return end
    for _,d in pairs(container:GetDescendants()) do
        if kind=="item" then
            if not d:IsA("Tool") or d:IsDescendantOf(PlayersContainer) then continue end
        elseif d:IsA("Tool") then continue end
        local e=d:FindFirstChild("__DogsakenESP",true); if e then e:Destroy() end
        local b=d:FindFirstChild("__DogsakenBB",true); if b then b:Destroy() end
    end
end

local function makeESPGroup(cfg)
    assert(cfg.container and cfg.addedSignal and cfg.valid and cfg.highlightType)
    local grp = {Instances={},Connections={}}
    local function check(inst)
        if not cfg.valid(inst) then return end
        if not grp.Instances[inst] then grp.Instances[inst]=true; attachESP(inst,cfg.highlightType) end
        local conn
        if not cfg.removalSignal then
            conn = inst.Destroying:Connect(function() grp.Instances[inst]=nil; conn:Disconnect() end)
        elseif cfg.removalSignal=="Changed" then
            local nv = inst:FindFirstChildOfClass("NumberValue")
            conn = nv and nv.Changed:Connect(function(v)
                if cfg.removalCheck(v) then
                    local e=inst:FindFirstChild("__DogsakenESP",true); if e then e:Destroy() end
                    local b=inst:FindFirstChild("__DogsakenBB",true); if b then b:Destroy() end
                    grp.Instances[inst]=nil; conn:Disconnect() end end)
        else
            conn = inst[cfg.removalSignal]:Connect(function(...)
                if cfg.removalCheck(...) then
                    local e=inst:FindFirstChild("__DogsakenESP",true); if e then e:Destroy() end
                    local b=inst:FindFirstChild("__DogsakenBB",true); if b then b:Destroy() end
                    grp.Instances[inst]=nil; conn:Disconnect() end end)
        end
        grp.Connections[inst] = conn
    end
    for _,d in pairs(cfg.container:GetDescendants()) do tick_(); task.spawn(function() check(d) end) end
    grp.Connections.Added = cfg.container[cfg.addedSignal]:Connect(function(x) tick_(); task.spawn(function() check(x) end) end)
    grp.Cleanup = function(g)
        if g.Connections.Added then g.Connections.Added:Disconnect(); g.Connections.Added=nil end
        for _,c in pairs(g.Connections) do
            if typeof(c)=="RBXScriptConnection" and c.Connected then c:Disconnect() end end
        for k in pairs(g.Instances) do
            local e=k:FindFirstChild("__DogsakenESP",true); if e then e:Destroy() end
            local b=k:FindFirstChild("__DogsakenBB",true); if b then b:Destroy() end
            g.Instances[k]=nil end
        for _,d in pairs(Ragdolls:GetDescendants()) do tick_()
            if d.Name=="__DogsakenESP" or d.Name=="__DogsakenBB" then d:Destroy() end end
        table.clear(g.Connections); table.clear(g.Instances)
    end
    return grp
end

