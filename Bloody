--═══════════════════════════════════════════════════════════════════
-- FACING CHECK (BoxFacing — client-side adaptation of BoxFacingCheck.lua)
--═══════════════════════════════════════════════════════════════════
local FacingMode = "None" -- "None" | "BoxFacing"
local AB = { enabled = false, delay = 0, last = 0 }

local FacingConfig = {
    ShowVisuals = true,
    GiantSize = Vector3.new(18, 12, 32),
    GiantOffset = Vector3.new(0, 0, -16),
    SmallSize = Vector3.new(3, 3, 3),
    IdleOffset = Vector3.new(0, 0, -6),
    TravelSpeed = 55,
    HitDistance = 3.5,
    DisappearDelay = 0.2,
    OutOfRangeDespawnDelay = 0.3,
    UpdateRate = 1 / 30,
    RequireLoS = false,
    OnlyBlockOnValid = false,
    Colors = {
        Red = Color3.fromRGB(255, 70, 70),
        Yellow = Color3.fromRGB(255, 210, 60),
        Green = Color3.fromRGB(70, 255, 120),
    },
}

local FacingCheck = {}
FacingCheck.__index = FacingCheck

local function createFacingBox(self)
    local part = Instance.new("Part")
    part.Name = "FacingCheckBox"
    part.Size = self.Settings.SmallSize
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Transparency = self.Settings.ShowVisuals and 0.55 or 1
    part.Color = self.Settings.Colors.Red

    local sel = Instance.new("SelectionBox")
    sel.Name = "Outline"
    sel.Adornee = part
    sel.LineThickness = 0.08
    sel.Color3 = self.Settings.Colors.Red
    sel.SurfaceTransparency = 1
    sel.Transparency = self.Settings.ShowVisuals and 0 or 1
    sel.Parent = part

    local light = Instance.new("PointLight")
    light.Color = self.Settings.Colors.Red
    light.Range = math.max(part.Size.X, part.Size.Y, part.Size.Z) * 2.2
    light.Brightness = 2
    light.Enabled = self.Settings.ShowVisuals
    light.Parent = part

    part.Parent = self._boxFolder
    return part
end

local function setFacingBoxColor(box, color)
    box.Color = color
    local sel = box:FindFirstChild("Outline")
    if sel then sel.Color3 = color end
    local light = box:FindFirstChildOfClass("PointLight")
    if light then light.Color = color end
end

local function getGiantCFrame(self)
    return self.HRP.CFrame * CFrame.new(self.Settings.GiantOffset)
end

local function clampToGiantBox(self, worldPos)
    local giantCFrame = getGiantCFrame(self)
    local half = self.Settings.GiantSize * 0.5
    local rel = giantCFrame:PointToObjectSpace(worldPos)
    rel = Vector3.new(
        math.clamp(rel.X, -half.X, half.X),
        math.clamp(rel.Y, -half.Y, half.Y),
        math.clamp(rel.Z, -half.Z, half.Z)
    )
    return giantCFrame:PointToWorldSpace(rel)
end

local function classifyLP(self)
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local giantCFrame = getGiantCFrame(self)
    local half = self.Settings.GiantSize * 0.5
    local rel = giantCFrame:PointToObjectSpace(hrp.Position)

    local inside = math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
    if not inside then return "OUT" end

    if self.Settings.RequireLoS then
        local origin = self.HRP.Position
        local dir = hrp.Position - origin
        local params = self._defaultRayParams
        local result = Workspace:Raycast(origin, dir, params)
        if result and result.Instance and not result.Instance:IsDescendantOf(char) then
            return "INVALID"
        end
    end

    return "VALID"
end

function FacingCheck.new(killerCharacter)
    local hrp = killerCharacter:FindFirstChild("HumanoidRootPart")
    assert(hrp, "Killer character needs a HumanoidRootPart")

    local self = setmetatable({}, FacingCheck)
    self.Killer = killerCharacter
    self.HRP = hrp
    self.Settings = FacingConfig
    self.OnBoxHit = Instance.new("BindableEvent")
    self._slot = nil
    self._scanAccum = 0

    self._defaultRayParams = RaycastParams.new()
    self._defaultRayParams.FilterType = Enum.RaycastFilterType.Exclude
    self._defaultRayParams.FilterDescendantsInstances = { killerCharacter }

    self._boxFolder = Instance.new("Folder")
    self._boxFolder.Name = "Nos_FacingBoxes_" .. killerCharacter.Name
    self._boxFolder.Parent = Workspace

    self._conn = RunService.Heartbeat:Connect(function(dt) self:_update(dt) end)
    return self
end

function FacingCheck:_addSlot(status)
    if self._slot then return end
    local box = createFacingBox(self)
    setFacingBoxColor(box, status == "VALID" and self.Settings.Colors.Green or self.Settings.Colors.Yellow)
    self._slot = { box = box, state = status, travelling = false, travelStart = 0, removeAt = nil, index = 1 }
end

function FacingCheck:_removeSlot()
    if not self._slot then return end
    pcall(function() self._slot.box:Destroy() end)
    self._slot = nil
end

function FacingCheck:_onHit()
    local slot = self._slot
    if not slot then return end
    slot.travelling = false
    self.OnBoxHit:Fire(slot.state == "VALID")
    task.delay(self.Settings.DisappearDelay, function()
        self:_removeSlot()
    end)
end

function FacingCheck:_scan()
    local slot = self._slot
    if not slot then
        local status = classifyLP(self)
        if status == "VALID" or status == "INVALID" then
            self:_addSlot(status)
        end
        return
    end

    if slot.travelling then
        if classifyLP(self) == "OUT" then
            self:_removeSlot()
        end
        return
    end

    local status = classifyLP(self)
    if status == "OUT" or status == nil then
        if slot.state ~= "OUT" then
            slot.state = "OUT"
            slot.removeAt = os.clock() + self.Settings.OutOfRangeDespawnDelay
            setFacingBoxColor(slot.box, self.Settings.Colors.Red)
        end
    elseif status == "VALID" then
        slot.state = "VALID"
        slot.removeAt = nil
        setFacingBoxColor(slot.box, self.Settings.Colors.Green)
    elseif status == "INVALID" then
        slot.state = "INVALID"
        slot.removeAt = nil
        setFacingBoxColor(slot.box, self.Settings.Colors.Yellow)
    end
end

function FacingCheck:_stepBoxes(dt)
    if not self.HRP or not self.HRP.Parent then return end
    local sb = self.Settings
    local slot = self._slot
    if not slot then return end

    if slot.removeAt and os.clock() >= slot.removeAt then
        self:_removeSlot()
    elseif slot.travelling then
        if slot.travelStart > 0 and os.clock() - slot.travelStart > 2 then
            self:_removeSlot()
            return
        end

        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local current = slot.box.Position
            local target = hrp.Position
            local delta = target - current
            local dist = delta.Magnitude
            if dist <= sb.HitDistance then
                self:_onHit()
            else
                local step = math.min(sb.TravelSpeed * dt, dist)
                local newPos = current + delta.Unit * step
                newPos = clampToGiantBox(self, newPos)
                slot.box.CFrame = CFrame.new(newPos, Vector3.new(target.X, newPos.Y, target.Z))
            end
        else
            self:_removeSlot()
        end
    else
        local idleCFrame = self.HRP.CFrame * CFrame.new(sb.IdleOffset)
        local pos = clampToGiantBox(self, idleCFrame.Position)
        slot.box.CFrame = CFrame.new(pos, pos + self.HRP.CFrame.LookVector)
    end
end

function FacingCheck:_update(dt)
    if not self.HRP or not self.HRP.Parent then return end
    self._scanAccum += dt
    if self._scanAccum >= self.Settings.UpdateRate then
        self._scanAccum = 0
        self:_scan()
    end
    self:_stepBoxes(dt)
end

function FacingCheck:M1()
    local slot = self._slot
    if slot and (slot.state == "VALID" or slot.state == "INVALID") and not slot.travelling then
        slot.travelling = true
        slot.travelStart = os.clock()
    end
end

function FacingCheck:SetVisualsEnabled(enabled)
    self.Settings.ShowVisuals = enabled
    if self._slot then
        local box = self._slot.box
        box.Transparency = enabled and 0.55 or 1
        local sel = box:FindFirstChild("Outline")
        if sel then sel.Transparency = enabled and 0 or 1 end
        local light = box:FindFirstChildOfClass("PointLight")
        if light then light.Enabled = enabled end
    end
end

function FacingCheck:Destroy()
    if self._conn then pcall(function() self._conn:Disconnect() end) end
    self:_removeSlot()
    if self._boxFolder then pcall(function() self._boxFolder:Destroy() end) end
    pcall(function() self.OnBoxHit:Destroy() end)
end

--═══════════════════════════════════════════════════════════════════
-- CHECKER MANAGEMENT
--═══════════════════════════════════════════════════════════════════
local FacingCheckers = {}

local function destroyAllCheckers()
    for k, c in pairs(FacingCheckers) do
        pcall(function() c:Destroy() end)
    end
    FacingCheckers = {}
end

local function ensureChecker(killer)
    if IsPlayerKiller() then return nil end
    if not killer or not killer:IsA("Model") or killer == LP.Character then return nil end
    if FacingMode ~= "BoxFacing" then return nil end

    local existing = FacingCheckers[killer]
    if existing and existing.HRP and existing.HRP.Parent == killer then
        return existing
    end
    if existing then
        pcall(function() existing:Destroy() end)
        FacingCheckers[killer] = nil
    end

    if not killer:FindFirstChild("HumanoidRootPart") then return nil end

    local checker = FacingCheck.new(killer)

    checker.OnBoxHit.Event:Connect(function(wasValid)
        if not AB.enabled then return end
        if IsPlayerKiller() then return end
        if FacingConfig.OnlyBlockOnValid and not wasValid then return end

        local now = tick()
        if now - AB.last < 0.08 then return end
        AB.last = now
        if AB.delay > 0 then
            task.delay(AB.delay, FireBlock)
        else
            FireBlock()
        end
    end)

    FacingCheckers[killer] = checker
    return checker
end

local function syncCheckers()
    if not AB.enabled or FacingMode ~= "BoxFacing" or IsPlayerKiller() then
        destroyAllCheckers()
        return
    end

    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then
        destroyAllCheckers()
        return
    end

    local current = {}
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            current[k] = true
            ensureChecker(k)
        end
    end

    for k in pairs(FacingCheckers) do
        if not current[k] or not k.Parent then
            pcall(function() FacingCheckers[k]:Destroy() end)
            FacingCheckers[k] = nil
        end
    end
end

--═══════════════════════════════════════════════════════════════════
-- AUTO BLOCK TRIGGERS
--═══════════════════════════════════════════════════════════════════
local function triggerBlock(killer)
    if not AB.enabled or IsPlayerKiller() then return end

    if FacingMode == "BoxFacing" then
        local checker = FacingCheckers[killer]
        if checker then
            checker:M1()
            return
        end
    end

    local now = tick()
    if now - AB.last < 0.08 then return end
    AB.last = now
    if AB.delay > 0 then
        task.delay(AB.delay, FireBlock)
    else
        FireBlock()
    end
end

local monitored = {}
local function monitorKiller(k)
    if not k or monitored[k] or not k:IsA("Model") or k == LP.Character then return end
    monitored[k] = true
    local lastAbility = k:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = k:GetAttribute("AbilitiesUsed") or 0
    k:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not AB.enabled or IsPlayerKiller() then return end
        local cur = k:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local curU = k:GetAttribute("AbilitiesUsed") or 0
        if curU > lastUsed then lastUsed = curU; return end
        triggerBlock(k)
    end)
end

task.spawn(function()
    while true do
        task.wait(1)
        syncCheckers()
        if AB.enabled and not IsPlayerKiller() then
            local kf = Workspace:FindFirstChild("Players")
            kf = kf and kf:FindFirstChild("Killers")
            if kf then
                for _, k in ipairs(kf:GetChildren()) do
                    if k:IsA("Model") then monitorKiller(k) end
                end
            end
        end
    end
end)

