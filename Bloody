    "Default", "AmberGlow", "Amethyst", "Bloom", "DarkBlue", "Green", "Light", "Ocean", "Serenity"
}, "AmberGlow", function(option)
    local themeName = type(option) == "table" and option[1] or option
    if type(themeName) ~= "string" then return end
    local ok = pcall(function()
        if type(Window.ModifyTheme) == "function" then
            Window.ModifyTheme(themeName)
