--═══ AIM HELPERS ═══
local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, s = pcall(function()
            local len = buffer.readu8(arg, 1)
            if len < 1 or len > 64 then return nil end
            local out = ""
            for i = 5, 5 + len - 1 do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out = out .. string.char(b) end
            end
            return out
        end)
        return ok and s or nil
    end
    if t == "table" then return ExtractAbility(arg[1]) end
    return nil
end

local function GetTarget(maxRange, minDist, pred)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local kf = GetKillersFolder(); if not kf then return nil, nil end
    local killer, kr, dist = nil, nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then dist = d; killer = k; kr = krp end
        end
    end
    if not killer or dist > maxRange or dist < minDist then return nil, nil end
    local vel = kr.AssemblyLinearVelocity
    if not vel or vel.Magnitude < 0.1 then vel = kr.Velocity end
    if vel.Magnitude > 60 then vel = vel.Unit * 60 end
    local leadTime = math.clamp(pred or 4, 1, 10) * 0.1
    return hrp, kr.Position + vel * leadTime
end

