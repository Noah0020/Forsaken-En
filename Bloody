--═══ AIM HELPERS ═══
local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, s = pcall(function()
            local len = buffer.readu8(arg, 1)
            if len < 1 or len > 64 then return nil end
            local out = ""
            for i = 5, 5 + len - 1 do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out = out .. string.char(b) end
            end
            return out
        end)
        return ok and s or nil
    end
    if t == "table" then return ExtractAbility(arg[1]) end
    return nil
end

local function GetTarget(maxRange, minDist, pred)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local kf = GetKillersFolder(); if not kf then return nil, nil end
    local killer, kr, dist = nil, nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then dist = d; killer = k; kr = krp end
        end
    end
    if not killer or dist > maxRange or dist < minDist then return nil, nil end
    local vel = kr.AssemblyLinearVelocity
    if not vel or vel.Magnitude < 0.1 then vel = kr.Velocity end
    if vel.Magnitude > 60 then vel = vel.Unit * 60 end
    local leadTime = math.clamp(pred or 4, 1, 10) * 0.1
    return hrp, kr.Position + vel * leadTime
end

--═══ NORMAL AIM (character body rotation) ═══
local NormalAim = { active=false, endT=0, hookDone=false }

local function IsNormalAimAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower()
    if Settings.AIM_OnSlash and l == "slash" then return true end
    if Settings.AIM_OnBlock and (l == "block" or l == "parry" or l == "punch") then return true end
    if Settings.AIM_OnDagger and l:find("dagger", 1, true) then return true end
    if Settings.AIM_OnAxe and (l == "axe" or l == "hatchet") then return true end
    if Settings.AIM_OnShoot then
        if l == "shoot" or l:find("oneshot",1,true) or l:find("flintlock",1,true)
           or l:find("sixshot",1,true) or l:find("sixshooter",1,true)
           or l:find("gun",1,true) or l:find("shot",1,true) then return true end
    end
    return false
end

local function NormalAim_Instant()
    local hrp, target = GetTarget(Settings.AIM_Range, Settings.AIM_MinDist, Settings.AIM_Prediction)
    if not hrp or not target then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = false end
    pcall(function()
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z))
    end)
    local cam = Workspace.CurrentCamera
    if cam and (Settings.AIM_Mode == "Camera" or Settings.AIM_Mode == "Both") then
        pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target) end)
    end
    NormalAim.active = true
    NormalAim.endT = tick() + (Settings.AIM_LockTime or 0.7)
    return true
end

local function NormalAim_SetupHook()
    if NormalAim.hookDone or not NetworkEvent or not hookmetamethod then return end
    pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if Settings.AIM_Enabled and getnamecallmethod() == "FireServer" and self == NetworkEvent then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsNormalAimAbility(n) then NormalAim_Instant() end
                end
            end
            return old(self, ...)
        end)
        NormalAim.hookDone = true
    end)
end

RunService.RenderStepped:Connect(function()
