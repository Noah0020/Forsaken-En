                Rectangle.boxes[k] = nil
            end
        end
        local now = tick()
        for k, until_ in pairs(Rectangle.m1FlashUntil) do
            if now > until_ or not k.Parent then Rectangle.m1FlashUntil[k] = nil end
        end
    end)
end
local function StopRectLoop()
