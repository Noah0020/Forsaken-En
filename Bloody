local HDT = { running = false, debounce = false, animConn = nil, watcher = nil, charConn = nil,
    bind = "Cupcake_HDT_", dashId = 0, Speed = 40, Duration = 0.6, Delay = 0.05 }
local function HDT_Nearest()
    local kf = GetKillersFolder(); if not kf or not LocalRoot then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        if kr then
            local d = (kr.Position - LocalRoot.Position).Magnitude
            if d < bd then best, bd = k, d end
        end
    end
    return best
end
local function HDT_Dash(killer)
    if HDT.debounce then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if not killer or not killer.Parent then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true; HDT.dashId = HDT.dashId + 1
    local thisBind = HDT.bind .. tostring(HDT.dashId)
    local startT = tick(); local active = true
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 0, 1e6); bv.Velocity = Vector3.zero; bv.Parent = hrp
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); bg.P = 100000; bg.D = 1000; bg.Parent = hrp
    local oldWS = hum.WalkSpeed; local oldAR = hum.AutoRotate
    hum.WalkSpeed = 0; hum.AutoRotate = false
    local function stop()
        if not active then return end
        active = false; HDT.debounce = false
        pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        if bv and bv.Parent then bv:Destroy() end
        if bg and bg.Parent then bg:Destroy() end
        if hum and hum.Parent then pcall(function() hum.WalkSpeed = oldWS; hum.AutoRotate = oldAR end) end
    end
    pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
    RunService:BindToRenderStep(thisBind, Enum.RenderPriority.Camera.Value, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health <= 0 or not kr.Parent then stop(); return end
        if tick() - startT > HDT.Duration then stop(); return end
        local toK = kr.Position - hrp.Position
        local flat = Vector3.new(toK.X, 0, toK.Z)
        if flat.Magnitude < 1 then stop(); return end
        if bv.Parent then bv.Velocity = flat.Unit * HDT.Speed end
        if bg.Parent then bg.CFrame = CFrame.new(hrp.Position, hrp.Position + flat.Unit) end
    end)
    task.delay(HDT.Duration + 0.2, stop)
end
local function HDT_OnAnim(track)
    if not HDT.running or HDT.debounce then return end
    local aid = track.Animation and track.Animation.AnimationId
    if not aid or not HDT_Anims[aid] then return end
    local k = HDT_Nearest(); if not k then return end
    task.delay(HDT.Delay, function() if HDT.running and not HDT.debounce then HDT_Dash(k) end end)
end
local function HDT_Attach()
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator"); if not anim then return end
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end) end
    HDT.animConn = anim.AnimationPlayed:Connect(HDT_OnAnim)
end
local function HDT_Enable()
    if HDT.running then return end
    HDT.running = true; HDT_Attach()
    HDT.charConn = LP.CharacterAdded:Connect(function()
        task.wait(0.5); if HDT.running then HDT_Attach() end
    end)
    HDT.watcher = task.spawn(function()
        while HDT.running and not _ShuttingDown do
            if not HDT.animConn then HDT_Attach() end
            task.wait(1)
        end
    end)
end
local function HDT_Disable()
    HDT.running = false; HDT.debounce = false
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end); HDT.animConn = nil end
    if HDT.charConn then pcall(function() HDT.charConn:Disconnect() end); HDT.charConn = nil end
    if HDT.watcher then pcall(task.cancel, HDT.watcher); HDT.watcher = nil end
    for i = 1, HDT.dashId do pcall(function() RunService:UnbindFromRenderStep(HDT.bind .. tostring(i)) end) end
end
