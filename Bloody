-- Silent (Dusekkar / Crystal style)
local Silent = {
    crystal=false, crystalPred=2.5, crystalY=1.5,
    dusk=false, duskPred=0.5, wallbang=false, infDist=false, hooked=false,
}

local function aimCamCF()
    local killer = GetNearestKiller(Silent.infDist and math.huge or 200)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if not (killer and my and cam) then return nil end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hrp then return nil end
    local pos = hrp.Position
    if hum and hum.MoveDirection.Magnitude > 0.1 then
        pos = pos + hum.MoveDirection * Silent.crystalPred
    end
    local dir = pos - my.Position + Vector3.new(0, Silent.crystalY, 0)
    if dir.Magnitude < 0.01 then return nil end
    return CFrame.new(cam.CFrame.Position) * CFrame.lookAt(Vector3.zero, dir.Unit).Rotation
end

local function aimMousePos()
    local killer = GetNearestKiller(Silent.infDist and math.huge or 200)
    if not killer then return nil end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hrp then return nil end
    local pos = hrp.Position
    if hum and hum.MoveDirection.Magnitude > 0.05 then
        pos = pos + hum.MoveDirection * Silent.duskPred
    end
    return pos
end

local function installSilent()
    if Silent.hooked then return true end
    local rf = getRF()
    if not rf then return false end
    local ok = pcall(function()
        local old = rf.OnClientInvoke
        rf.OnClientInvoke = function(name, ...)
            if name == "GetCameraCF" and Silent.crystal and not IsPlayerKiller() then
                local cf = aimCamCF(); if cf then return cf end
            end
            if name == "GetMousePosition" and Silent.dusk and not IsPlayerKiller() then
                local p = aimMousePos(); if p then return p end
            end
            if old then return old(name, ...) end
        end
    end)
    Silent.hooked = ok
    return ok
end

task.spawn(function()
    for _ = 1, 20 do if installSilent() then break end; task.wait(0.5) end
end)

-- Two Time backstab
local TT = { enabled=false, range=3, duration=0.5 }
local STAB_IDS = {
    ["100725497418533"]=true, ["89448354637442"]=true,
    ["106086955212611"]=true, ["107640065977686"]=true,
}

local function runBackstab()
    if not TT.enabled or IsPlayerKiller() then return end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local k = GetNearestKiller(20)
    local kr = k and k:FindFirstChild("HumanoidRootPart")
    if not hrp or not kr then return end
    local untilT = tick() + TT.duration
    while tick() < untilT and kr.Parent do
        hrp.CFrame = CFrame.new((kr.CFrame * CFrame.new(0, 0, TT.range)).Position) * (kr.CFrame - kr.CFrame.Position)
        task.wait()
    end
end

local function onStab(track)
    if not TT.enabled or not track or not track.Animation then return end
    local id = tostring(track.Animation.AnimationId):match("%d+")
    if id and STAB_IDS[id] then task.spawn(runBackstab) end
end

