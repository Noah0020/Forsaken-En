local function GetNearestKillerHrp()
    local char = LP.Character; if not char then return nil end
    local kf = GetKillersFolder(); if not kf then return nil end
    local myHrp = char:FindFirstChild("HumanoidRootPart"); if not myHrp then return nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") then
            local mHrp = m:FindFirstChild("HumanoidRootPart"); local mHum = m:FindFirstChildOfClass("Humanoid")
            if mHrp and mHum and mHum.Health > 0 then
                local d = (mHrp.Position - myHrp.Position).Magnitude
                if d < bd then bd = d; best = mHrp end
            end
        end
    end
    return best
end
local function HardLockFacing(dur, wantCam)
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local savedWS = hum.WalkSpeed
    hum.WalkSpeed = 0; hum.AutoRotate = false
    pcall(function() hum:Move(Vector3.zero, false) end)
    local startT = tick(); local conn; local released = false
    local function release()
        if released then return end; released = true
        if conn then pcall(function() conn:Disconnect() end); conn = nil end
        if not (hum and hum.Parent) then return end
        pcall(function() hum.WalkSpeed = savedWS; hum.AutoRotate = true; hum:Move(Vector3.zero, false) end)
    end
    conn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent or not hum.Parent then release(); return end
        if tick() - startT > (dur or 0.5) then release(); return end
        local t = GetNearestKillerHrp(); if not t or not t.Parent then return end
        local aim = predictHRP(t, (Settings.AIM_Prediction or 4) * 0.05) or t.Position
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(aim.X, hrp.Position.Y, aim.Z))
    end)
    if wantCam then
        local cam = Workspace.CurrentCamera; local camStart = tick(); local camConn
        camConn = RunService.RenderStepped:Connect(function()
            if not cam or tick() - camStart > (dur or 0.5) then pcall(function() camConn:Disconnect() end); return end
            local t = GetNearestKillerHrp()
            if t and t.Parent then
                local aim = predictHRP(t, (Settings.AIM_Prediction or 4) * 0.05) or t.Position
                pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aim) end)
            end
        end)
    end
end
