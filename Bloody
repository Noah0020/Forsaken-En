-- FLIP SYSTEM
-- ════════════════════════════════════════════
local flipCooldown = false
local function doFlip(dir)
	if flipCooldown then return end
	flipCooldown = true
	local HRP  = Character and Character:FindFirstChild("HumanoidRootPart")
	local Hum  = Character and Character:FindFirstChildOfClass("Humanoid")
	local Anim = Hum and Hum:FindFirstChildOfClass("Animator")
	if not HRP or not Hum then flipCooldown = false; return end
	local saved = {}
	if Anim then
		for _, tr in ipairs(Anim:GetPlayingAnimationTracks()) do
			saved[#saved+1] = {track = tr, time = tr.TimePosition}
			tr:Stop(0)
		end
	end
	Hum:ChangeState(Enum.HumanoidStateType.Physics)
	for _, s in ipairs({"FallingDown","Freefall","Running","Seated","Climbing"}) do
		Hum:SetStateEnabled(Enum.HumanoidStateType[s], false)
	end
	local cf   = HRP.CFrame
	local look = dir == "front" and cf.LookVector or -cf.LookVector
	local up   = Vector3.new(0, 1, 0)
	task.spawn(function()
		local t0 = os.clock()
		for i = 1, 120 do
			local frac = i / 120
			local newPos = cf.Position + look*(35*frac) + up*(4*(frac - frac^2)*10)
			local rot    = cf.Rotation * CFrame.Angles(math.rad(-i*3), 0, 0)
			HRP.CFrame   = CFrame.new(newPos) * rot
			local wait   = 0.00375*i - (os.clock()-t0)
			if wait > 0 then task.wait(wait) end
		end
		HRP.CFrame = CFrame.new(cf.Position + look*35) * cf.Rotation
		for _, s in ipairs({"FallingDown","Freefall","Running","Seated","Climbing"}) do
			Hum:SetStateEnabled(Enum.HumanoidStateType[s], true)
		end
		Hum:ChangeState(Enum.HumanoidStateType.Running)
		if Anim then
			for _, t in ipairs(saved) do t.track:Play(); t.track.TimePosition = t.time end
		end
		task.wait(0.25)
		flipCooldown = false
	end)
end

