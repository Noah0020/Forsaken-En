local function refreshESP()
    if not (ESP.survivor or ESP.killer or ESP.generator or ESP.item or ESP.minion or ESP.trap or ESP.spray) then
        for inst in pairs(ESP.tracked) do clearOne(inst) end
        return
    end
    local seen = {}
    local pf = Workspace:FindFirstChild("Players")
    local killers = pf and pf:FindFirstChild("Killers")
    local survivors = pf and pf:FindFirstChild("Survivors")
