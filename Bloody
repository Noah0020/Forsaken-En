local HDT = { running=false, debounce=false, animConn=nil, charConn=nil, bind="Cupcake_HDT_", dashId=0, Speed=40, Duration=0.6 }
local HDT_Anims = {}
for _, id in ipairs({72722244508749,96959123077498,95802026624883,140671644163156,100926346851492}) do
    HDT_Anims["rbxassetid://"..id] = true
end
local function HDT_Nearest()
    local kf = GetKillersFolder(); if not kf then return nil end
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        if kr then
            local d = (kr.Position - myRoot.Position).Magnitude
            if d < bd then best, bd = k, d end
        end
    end
    return best
end
local function HDT_Dash(killer)
    if HDT.debounce then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if not killer or not killer.Parent then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true
    HDT.dashId = HDT.dashId + 1
    local thisBind = HDT.bind..tostring(HDT.dashId)
    local startT = tick()
    local oWS = hum.WalkSpeed
    local oAR = hum.AutoRotate
    hum.WalkSpeed = HDT.Speed
    hum.AutoRotate = false
    pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
    RunService:BindToRenderStep(thisBind, Enum.RenderPriority.Last.Value + 1, function()
        if not HDT.debounce then
            pcall(function() RunService:UnbindFromRenderStep(thisBind) end); return
        end
        if not char.Parent or not hum.Parent or hum.Health <= 0 or not killer.Parent then
            HDT.debounce = false
            pcall(function() RunService:UnbindFromRenderStep(thisBind) end); return
        end
        local krCur = killer:FindFirstChild("HumanoidRootPart")
        if not krCur then
            HDT.debounce = false
            pcall(function() RunService:UnbindFromRenderStep(thisBind) end); return
        end
        local flat = Vector3.new(krCur.Position.X - hrp.Position.X, 0, krCur.Position.Z - hrp.Position.Z)
        if flat.Magnitude < 2 then
            HDT.debounce = false
            pcall(function() RunService:UnbindFromRenderStep(thisBind) end); return
        end
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(krCur.Position.X, hrp.Position.Y, krCur.Position.Z))
        hum.WalkSpeed = HDT.Speed
        hum:Move(flat.Unit, false)
        if tick() - startT > HDT.Duration then
            HDT.debounce = false
            pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        end
    end)
    task.delay(HDT.Duration + 0.15, function()
        if HDT.debounce then
            HDT.debounce = false
            pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        end
        if hum and hum.Parent then
            pcall(function()
                hum:Move(Vector3.zero, false)
                hum.WalkSpeed = oWS
                hum.AutoRotate = oAR
            end)
        end
    end)
end
local function HDT_OnAnim(track)
    if not HDT.running or HDT.debounce then return end
    local aid = track.Animation and track.Animation.AnimationId
    if not aid or not HDT_Anims[aid] then return end
    local k = HDT_Nearest(); if not k then return end
    task.delay(0.05, function() if HDT.running and not HDT.debounce then HDT_Dash(k) end end)
end
local function HDT_Attach()
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator"); if not anim then return end
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end) end
    HDT.animConn = anim.AnimationPlayed:Connect(HDT_OnAnim)
end
local function HDT_Enable()
    if HDT.running then return end
    HDT.running = true; HDT_Attach()
    HDT.charConn = LP.CharacterAdded:Connect(function()
        task.wait(0.5); if HDT.running then HDT_Attach() end
    end)
end
local function HDT_Disable()
    HDT.running = false; HDT.debounce = false
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end); HDT.animConn = nil end
    if HDT.charConn then pcall(function() HDT.charConn:Disconnect() end); HDT.charConn = nil end
    for i = 1, HDT.dashId do pcall(function() RunService:UnbindFromRenderStep(HDT.bind..tostring(i)) end) end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:Move(Vector3.zero, false) end) end
end
local function HDT_ForceNow() local k = HDT_Nearest(); if k then HDT_Dash(k) end end

