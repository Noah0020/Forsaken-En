local TT = {on=false, range=10, behind=1.8, cd=4, last=0, dagger=true}
task.spawn(function()
    while true do
        task.wait(0.12)
        if not TT.on then continue end
        local char = LocalPlayer.Character
        if not char or not string.find(char.Name or "", "TwoTime") then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        RefreshFolders()
        if not KillersFolder then continue end
        for _, killer in pairs(KillersFolder:GetChildren()) do
            local kr = killer:FindFirstChild("HumanoidRootPart")
            if not kr then continue end
            if (kr.Position - hrp.Position).Magnitude <= TT.range and os.clock() - TT.last >= TT.cd then
                TT.last = os.clock()
                local behindPos = kr.Position - kr.CFrame.LookVector * TT.behind
                pcall(function() hrp.CFrame = CFrame.new(behindPos, kr.Position) end)
                if TT.dagger then
                    task.delay(0.08, function()
                        FireAbility("Stab"); FireAbility("Backstab"); FireAbility("Dagger")
                    end)
                end
                break
            end
        end
    end
end)

