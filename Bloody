-- ── PREDICTION ────────────────────────────────────────────────────
local _pingCache = { value = 100, at = 0 }
local function getPingMs()
    if os.clock() - _pingCache.at < 0.25 then return _pingCache.value end
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString() end)
    if ok and v then
        local n = tonumber((string.split(tostring(v), "("))[1])
        if n then _pingCache.value = n; _pingCache.at = os.clock(); return n end
    end
    return 100
end
local function pingPrediction()
    local p = getPingMs()
    if p >= 225 then return 1.4 elseif p >= 215 then return 1.2 elseif p >= 205 then return 1.0
    elseif p >= 190 then return 0.10 elseif p >= 180 then return 0.12 elseif p >= 170 then return 0.15
    elseif p >= 160 then return 0.18 elseif p >= 150 then return 0.11 elseif p >= 140 then return 0.113
    elseif p >= 130 then return 0.116 elseif p >= 120 then return 0.120 elseif p >= 110 then return 0.124
    elseif p >= 105 then return 0.127 elseif p >= 90 then return 0.130 elseif p >= 80 then return 0.133
    elseif p >= 70 then return 0.136 elseif p >= 60 then return 0.15038 elseif p >= 50 then return 0.15038
    elseif p >= 40 then return 0.145 elseif p >= 30 then return 0.155 elseif p >= 20 then return 0.157
    else return 0.16 end
end

