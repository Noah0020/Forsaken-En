-- HDT (Hitbox Dragging Tech) — with Speed / Duration / Delay
-- ============================================================
local HDT = {
    Enabled = false,
    Speed = 5.6,
    Duration = 0.4,
    Delay = 0,
}
local _hdtDebounce = false
local HDT_DETECT_RADIUS = 6

local function getKillerHRP(km)
    if not km then return nil end
    return km:FindFirstChild("HumanoidRootPart") or km.PrimaryPart or km:FindFirstChildWhichIsA("BasePart", true)
end

local function beginDragIntoKiller(km)
    if _hdtDebounce then return end
    if not km or not km.Parent then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local targetHRP = getKillerHRP(km)
    if not targetHRP then return end

    _hdtDebounce = true
    local oldWalk, oldJump, oldPS = hum.WalkSpeed, hum.JumpPower, hum.PlatformStand
    hum.WalkSpeed = 0; hum.JumpPower = 0; hum.PlatformStand = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = Vector3.new(0,0,0)
    bv.Parent = hrp

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not _hdtDebounce then
            conn:Disconnect(); bv:Destroy()
            hum.WalkSpeed, hum.JumpPower, hum.PlatformStand = oldWalk, oldJump, oldPS
            return
        end
        if not (char.Parent and km.Parent) then _hdtDebounce = false; return end
        targetHRP = getKillerHRP(km)
        if not targetHRP then _hdtDebounce = false; return end
        local toT = targetHRP.Position - hrp.Position
        local horiz = Vector3.new(toT.X, 0, toT.Z)
        if horiz.Magnitude > 0.01 then
            bv.Velocity = Vector3.new(horiz.Unit.X*HDT.Speed, bv.Velocity.Y, horiz.Unit.Z*HDT.Speed)
        else
            bv.Velocity = Vector3.new(0, bv.Velocity.Y, 0)
        end
        if toT.Magnitude <= 2.0 then _hdtDebounce = false end
    end)
    task.delay(HDT.Duration, function() if _hdtDebounce then _hdtDebounce = false end end)
end

local cachedAnimator
local function refreshAnimator()
    local char = lp.Character
    if not char then cachedAnimator = nil; return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    cachedAnimator = hum and hum:FindFirstChildOfClass("Animator") or nil
end
lp.CharacterAdded:Connect(function() task.wait(0.5); refreshAnimator() end)
if lp.Character then task.spawn(refreshAnimator) end

-- Trigger HDT when a block anim is playing
RunService.RenderStepped:Connect(function()
    if not HDT.Enabled then return end
    if not cachedAnimator then refreshAnimator() end
    local animator = cachedAnimator
    if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local ok, id = pcall(function()
            return track.Animation and tostring(track.Animation.AnimationId):match("%d+")
        end)
        if ok and id and blockAnimSet[id] then
            local tp = 0
            pcall(function() tp = track.TimePosition or 0 end)
            if tp <= 0.12 then
                local nearest = getNearestKillerModel()
                if nearest then
                    task.wait(HDT.Delay)
                    task.spawn(beginDragIntoKiller, nearest)
                end
            end
        end
    end
end)

