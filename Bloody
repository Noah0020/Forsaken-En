    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not KillersFolder then return nil, nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(KillersFolder:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart")
        local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - myRoot.Position).Magnitude
            if d < bd then bd = d; best = m end
        end
    end
    return best, myRoot
end

local function setCrystalSA(on)
    C.CrystalSA = on
    if on and not SA.crystalHook then
        if typeof(hookfunction) ~= "function" or typeof(getcallbackvalue) ~= "function" then
            Notify("Need hookfunction + getcallbackvalue"); return
        end
        local ok, rf = pcall(function() return ReplicatedStorage.Modules.Network.Network.RemoteFunction end)
        if not ok or not rf then Notify("RemoteFunction missing"); return end
        local ang = -0.32175
        SA.crystalHook = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] ~= "GetCameraCF" or not C.CrystalSA then
                return SA.crystalHook(table.unpack(args, 1, args.n))
            end
            local killer, myRoot = getNearestKillerModel()
            if killer and myRoot then
                local hum = killer:FindFirstChildOfClass("Humanoid")
                local pos = killer.HumanoidRootPart.Position
                if hum and hum.MoveDirection.Magnitude > 0.15 then
                    pos = pos + hum.MoveDirection * C.CrystalPred
                end
                local cf = CFrame.lookAt(Vector3.zero, (pos - myRoot.Position + Vector3.new(0,1.5,0)).Unit)
                if LocalPlayer:GetAttribute("Device") == "Mobile" or UserInputService.TouchEnabled then
                    cf = cf * CFrame.Angles(ang, 0, 0)
                end
                return CFrame.new(Camera.CFrame.Position) * cf.Rotation
            end
            return SA.crystalHook(table.unpack(args, 1, args.n))
        end)
        Notify("Crystal Silent Aim ON")
    elseif not on then
        Notify("Crystal Silent Aim OFF")
    end
end

local function setDusekkarSA(on)
    C.DusekkarSA = on
    if on and not SA.dusekkarHook then
        if typeof(hookfunction) ~= "function" or typeof(getcallbackvalue) ~= "function" then
            Notify("Need hookfunction + getcallbackvalue"); return
        end
        local ok, rf = pcall(function() return ReplicatedStorage.Modules.Network.Network.RemoteFunction end)
        if not ok or not rf then Notify("RemoteFunction missing"); return end
        SA.dusekkarHook = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] == "GetMousePosition" and C.DusekkarSA then
                local killer = select(1, getNearestKillerModel())
                if killer then
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    local pos = killer.HumanoidRootPart.Position
                    if hum and hum.MoveDirection.Magnitude > 0.05 then
                        pos = pos + hum.MoveDirection * C.DusekkarPred
                    end
                    return pos
                end
            end
            return SA.dusekkarHook(table.unpack(args, 1, args.n))
        end)
        Notify("Dusekkar Silent Aim ON")
    elseif not on then
        Notify("Dusekkar Silent Aim OFF")
    end
end

