        if ex then ex.expiresAt = os.clock() + ConeCfg.WindowDuration
        else activeBlocks[k] = {expiresAt=os.clock() + ConeCfg.WindowDuration, fired=false} end
    end
    if lUI and st.locked then st.locked = false end
    st.lastUsed = cu; st.used = cus
end
