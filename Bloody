local function extractAnimIds(v)
    local out = {}
    if type(v) == "string" or type(v) == "number" then
        local id = tostring(v):match("%d+"); if id then table.insert(out, id) end
    elseif type(v) == "table" then
        for _, x in pairs(v) do for _, id in ipairs(extractAnimIds(x)) do table.insert(out, id) end end
    end
    return out
end
local function isStunName(n)
    if type(n) ~= "string" then return false end
    if STUN_ABILITY_NAMES[n] then return true end
    local clean = n:lower():gsub("[%s_%-]", "")
    for s in pairs(STUN_ABILITY_NAMES) do
        if clean == s:lower():gsub("[%s_%-]", "") then return true end
    end
    return false
end
local function readConfigModule(m)
    local ok, cfg = pcall(require, m); if not ok or type(cfg) ~= "table" then return end
    local function processAnims(t)
        if type(t) ~= "table" then return end
        for n, v in pairs(t) do if isStunName(n) then for _, id in ipairs(extractAnimIds(v)) do STUN_ANIM_IDS[id] = n end end end
    end
    if type(cfg.Animations) == "table" then processAnims(cfg.Animations) end
    if type(cfg.Config) == "table" and type(cfg.Config.Animations) == "table" then processAnims(cfg.Config.Animations) end
    local function processSounds(t)
        if type(t) ~= "table" then return end
        for n, v in pairs(t) do if isStunName(n) then for _, id in ipairs(extractAnimIds(v)) do STUN_SOUND_IDS[id] = n end end end
    end
    for _, f in ipairs(STUN_SOUND_FIELDS) do
        if type(cfg[f]) == "table" then processSounds(cfg[f]) end
        if type(cfg.Config) == "table" and type(cfg.Config[f]) == "table" then processSounds(cfg.Config[f]) end
    end
end
local function LoadAbilityIds(char)
    STUN_ANIM_IDS, STUN_SOUND_IDS = {}, {}
    for id, n in pairs(STATIC_STUN_ANIM_IDS) do STUN_ANIM_IDS[id] = n end
