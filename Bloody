local function addConnection(connection)
    if connection then
        table.insert(State.Connections, connection)
    end
    return connection
end

local function findRemote()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local network = modules and modules:FindFirstChild("Network")
    local nestedNetwork = network and network:FindFirstChild("Network")
    local remote = nestedNetwork and nestedNetwork:FindFirstChild("RemoteEvent")
    if remote and remote:IsA("RemoteEvent") then
        return remote
    end

    -- Use the exact helper path exposed by the supplied SkidSaken source if present.
    local helper = SharedEnv.GetGHNetworkObjects or _G.GetGHNetworkObjects
    if type(helper) == "function" then
        local ok, result = pcall(helper)
        if ok and typeof(result) == "Instance" and result:IsA("RemoteEvent") then
            return result
        end
    end
    return nil
end

local function getRemote()
    if State.Remote and State.Remote.Parent then
        return State.Remote
    end
    local now = os.clock()
    if now - State.LastRemoteSearch < 0.5 then
        return nil
    end
    State.LastRemoteSearch = now
    State.Remote = findRemote()
    return State.Remote
end

local function getAbilityName()
    local settings = SharedEnv.Settings or _G.Settings
    if type(settings) == "table" and settings.RectangleABMode == "007n7" then
        return "Clone"
    end
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        local hasClone = false
        local hasBlock = false
        for _, item in ipairs(playerGui:GetDescendants()) do
            if item:IsA("GuiButton") then
                local name = string.lower(item.Name)
                if name == "clone" then hasClone = true end
                if name == "block" then hasBlock = true end
            end
        end
        if hasClone and not hasBlock then return "Clone" end
    end
    return "Block"
end

local function fireBlock()
    local remote = getRemote()
    if not remote then
        return false
    end
    local abilityName = getAbilityName()
    local ok = pcall(function()
        local abilityBuffer = buffer.fromstring("\003\005\000\000\000" .. abilityName)
        remote:FireServer("UseActorAbility", { abilityBuffer })
    end)
    return ok
end

local function getKillersFolder()
    local playersFolder = Workspace:FindFirstChild("Players")
    return playersFolder and playersFolder:FindFirstChild("Killers") or nil
end

local function getRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model.PrimaryPart
end

local function normalize(value)
    return string.lower(tostring(value or "")):gsub("[^%w]", "")
end

local function killerIdentity(model)
    local names = { model.Name }
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        table.insert(names, humanoid.DisplayName)
    end
    for _, attributeName in ipairs({ "ActorName", "CharacterName", "KillerName", "DisplayName" }) do
        local value = model:GetAttribute(attributeName)
        if type(value) == "string" then
            table.insert(names, value)
        end
    end
    return table.concat(names, " ")
end

local function isWatchedKiller(model)
    if not model or not model:IsA("Model") then return false end
    local identity = normalize(killerIdentity(model))
    for _, wanted in ipairs(WATCHED_KILLERS) do
        if string.find(identity, wanted, 1, true) then
            return true
        end
    end
    return false
end

local function getKillerFromInstance(instance)
    local folder = getKillersFolder()
    local cursor = instance
    while cursor and cursor ~= folder do
        if cursor:IsA("Model") and isWatchedKiller(cursor) then
            return cursor
        end
        cursor = cursor.Parent
    end
    return nil
end

local function getLocalParts()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or humanoid.Health <= 0 or not root then
        return nil, nil, nil
    end
    return character, humanoid, root
end

local function isLocalPlayerKiller()
    local state = SharedEnv.KillerState or _G.KillerState
    if type(state) == "table" and state.isKiller == true then
        return true
    end
    local helper = SharedEnv.IsLocalPlayerKiller or _G.IsLocalPlayerKiller
    if type(helper) == "function" then
        local ok, result = pcall(helper)
        if ok and result == true then return true end
    end
    local folder = getKillersFolder()
    local character = LocalPlayer.Character
    return folder ~= nil and character ~= nil and character:IsDescendantOf(folder)
end

local function pingSeconds()
    local ping = 0.08
    pcall(function()
        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    return math.clamp(tonumber(ping) or 0.08, 0, 0.60)
end

local function getBoxCFrame(root)
    return root.CFrame * CFrame.new(0, 0, -(CONFIG.BoxDepth / 2) - CONFIG.BoxDistance)
end

local function getState(killer)
    local state = State.KillerStates[killer]
    if not state then
        state = {
            LastBlock = 0,
            BoxEntered = false,
            LastAbility = killer:GetAttribute("AbilityLastUsed"),
            LastUsed = tonumber(killer:GetAttribute("AbilitiesUsed")) or 0,
            SkipNextAbility = false,
            Box = nil,
            Animator = nil,
            Tracked = false,
        }
        State.KillerStates[killer] = state
    end
    return state
end

local function showBox(killerRoot, red)
    if not killerRoot or not killerRoot.Parent then return end
    local part = Instance.new("Part")
    part.Name = "SimpleHub_AutoBlockBox"
    part.Size = Vector3.new(CONFIG.BoxWidth, CONFIG.BoxHeight, CONFIG.BoxDepth)
    part.CFrame = getBoxCFrame(killerRoot)
    part.Color = red and Color3.fromRGB(255, 65, 65) or Color3.fromRGB(70, 230, 135)
    part.Transparency = CONFIG.BoxTransparency
    part.Material = Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Parent = Workspace
    Debris:AddItem(part, CONFIG.BoxVisibleTime)
end

local function withinCueRange(killerRoot)
    local _, _, localRoot = getLocalParts()
    if not localRoot or not killerRoot then return false end
    return (localRoot.Position - killerRoot.Position).Magnitude <= CONFIG.MaxCueRange
end

local function requestBlock(killer, reason)
    if not State.Enabled or not killer or not killer.Parent or isLocalPlayerKiller() then
        return false
    end
    if not isWatchedKiller(killer) then
        return false
    end
    local killerRoot = getRoot(killer)
    if not killerRoot or not withinCueRange(killerRoot) then
        return false
    end

    local state = getState(killer)
    local now = os.clock()
    if now - state.LastBlock < CONFIG.TriggerDebounce then
        return false
    end
    state.LastBlock = now

    local fired = fireBlock()
    if fired then
        showBox(killerRoot, true)
    end
    return fired
end

local function matchesCue(text)
    local lowered = string.lower(tostring(text or ""))
    if lowered == "" then return false end
    for _, cue in ipairs(ATTACK_CUES) do
        if cue == "tab" then
            local cleaned = " " .. lowered:gsub("[^%w]+", " ") .. " "
            if string.find(cleaned, " tab ", 1, true) then return true end
        elseif string.find(lowered, cue, 1, true) then
            return true
        end
    end
    return false
end

local function soundMatches(sound, killer)
    if not sound then return false end
    local id = string.match(tostring(sound.SoundId or ""), "%d+$")
    local names = {}
    local cursor = sound
    while cursor and cursor ~= killer do
        table.insert(names, cursor.Name)
        cursor = cursor.Parent
    end
    local nameMatch = matchesCue(table.concat(names, " "))
    return nameMatch or (id ~= nil and DUCK_SOUND_IDS[id] == true)
end

local function handleSound(sound)
    if not State.Enabled or not sound or not sound:IsA("Sound") then return end
    local killer = getKillerFromInstance(sound)
    if not killer or not soundMatches(sound, killer) then return end
    requestBlock(killer, "sound")
end

local function attachSound(sound)
    if not sound or not sound:IsA("Sound") or State.SeenSounds[sound] then return end
    State.SeenSounds[sound] = true

    local function check()
        if sound.IsPlaying then
            handleSound(sound)
        end
    end

    pcall(function()
        addConnection(sound.Played:Connect(function()
            handleSound(sound)
        end))
    end)
    pcall(function()
        addConnection(sound.Resumed:Connect(function()
            handleSound(sound)
        end))
    end)
    pcall(function()
        addConnection(sound:GetPropertyChangedSignal("Playing"):Connect(check))
    end)
    pcall(function()
        addConnection(sound:GetPropertyChangedSignal("SoundId"):Connect(function()
            if sound.IsPlaying then handleSound(sound) end
        end))
    end)
    if sound.IsPlaying then
        handleSound(sound)
    end
end

local function attachAnimator(killer)
    local state = getState(killer)
    local humanoid = killer:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator or state.Animator == animator then return end
    state.Animator = animator

    local ok, connection = pcall(function()
        return animator.AnimationPlayed:Connect(function(track)
            if not State.Enabled then return end
            local animation = track and track.Animation
            local cueText = tostring(track and track.Name or "")
                .. " " .. tostring(animation and animation.Name or "")
            if matchesCue(cueText) then
                requestBlock(killer, "animation")
            end
        end)
    end)
    if ok then addConnection(connection) end
end

local function trackKiller(killer)
    if not killer or not killer:IsA("Model") or not isWatchedKiller(killer) then return end
    local state = getState(killer)
    attachAnimator(killer)
    if state.Tracked then return end
    state.Tracked = true

    for _, descendant in ipairs(killer:GetDescendants()) do
        if descendant:IsA("Sound") then
            attachSound(descendant)
        end
    end

    addConnection(killer.DescendantAdded:Connect(function(descendant)
        if not State.Enabled then return end
        if descendant:IsA("Sound") then
            attachSound(descendant)
        elseif descendant:IsA("Animator") or descendant:IsA("Humanoid") then
            task.defer(function()
                if State.Enabled and killer.Parent then attachAnimator(killer) end
            end)
        end
    end))
end

local function scanBox(killer)
    local character, _, localRoot = getLocalParts()
    local killerRoot = getRoot(killer)
    if not character or not localRoot or not killerRoot then return end

    local estimatedLead = pingSeconds() * 22
    local maxRange = CONFIG.BoxDepth + CONFIG.BoxDistance + 3 + estimatedLead
    if (localRoot.Position - killerRoot.Position).Magnitude > maxRange then
        local state = getState(killer)
        state.BoxEntered = false
        if state.Box and state.Box.Parent then state.Box.Color = Color3.fromRGB(70, 230, 135) end
        return
    end

    State.Overlap.FilterDescendantsInstances = { character }
    local success, parts = pcall(function()
        return Workspace:GetPartBoundsInBox(
            getBoxCFrame(killerRoot),
            Vector3.new(CONFIG.BoxWidth, CONFIG.BoxHeight, CONFIG.BoxDepth),
            State.Overlap
        )
    end)
    if not success then return end

    local inside = false
    for _, part in ipairs(parts) do
        if part and part:IsDescendantOf(character) then
            inside = true
            break
        end
    end

    -- Position-space fallback keeps the box check reliable when a character
    -- limb is temporarily non-queryable on a client frame.
    if not inside then
        local localPosition = getBoxCFrame(killerRoot):PointToObjectSpace(localRoot.Position)
        inside = math.abs(localPosition.X) <= (CONFIG.BoxWidth / 2) + 1.25
            and math.abs(localPosition.Y) <= (CONFIG.BoxHeight / 2) + 2.0
            and math.abs(localPosition.Z) <= (CONFIG.BoxDepth / 2) + 1.25
    end

    local state = getState(killer)
    if state.Box and state.Box.Parent then
        state.Box.CFrame = getBoxCFrame(killerRoot)
        state.Box.Color = inside and Color3.fromRGB(255, 65, 65) or Color3.fromRGB(70, 230, 135)
    end

    if inside and not state.BoxEntered then
        local fired = requestBlock(killer, "duck-box")
        local recentlyAttempted = os.clock() - state.LastBlock < CONFIG.TriggerDebounce
        if fired or recentlyAttempted then
            state.BoxEntered = true
        end
    elseif not inside then
        state.BoxEntered = false
    end
end

local function scanAbilityAttributes(killer)
    local state = getState(killer)
    local abilityLastUsed = killer:GetAttribute("AbilityLastUsed")
    local abilitiesUsed = tonumber(killer:GetAttribute("AbilitiesUsed")) or 0

    if abilitiesUsed > state.LastUsed then
        state.SkipNextAbility = true
    end

    if abilityLastUsed ~= nil and state.LastAbility ~= nil and abilityLastUsed ~= state.LastAbility then
        if state.SkipNextAbility then
            state.SkipNextAbility = false
        else
            requestBlock(killer, "ability-attribute")
        end
    end

    state.LastAbility = abilityLastUsed
    state.LastUsed = abilitiesUsed
end

local function makeBox(killer)
    local root = getRoot(killer)
    if not root then return end
    local state = getState(killer)
    if state.Box and state.Box.Parent then return end

    local box = Instance.new("Part")
    box.Name = "SimpleHub_AutoBlockBox"
    box.Size = Vector3.new(CONFIG.BoxWidth, CONFIG.BoxHeight, CONFIG.BoxDepth)
    box.CFrame = getBoxCFrame(root)
    box.Color = Color3.fromRGB(70, 230, 135)
    box.Transparency = CONFIG.BoxTransparency
    box.Material = Enum.Material.Neon
    box.Anchored = true
    box.CanCollide = false
    box.CanTouch = false
    box.CanQuery = false
    box.CastShadow = false
    box.Parent = Workspace
    state.Box = box
end

local function updateFolder()
    local folder = getKillersFolder()
    if folder == State.Folder then return end

    if State.FolderConnection then
        pcall(function() State.FolderConnection:Disconnect() end)
        State.FolderConnection = nil
    end
    State.Folder = folder

    if folder then
        State.FolderConnection = folder.ChildAdded:Connect(function(child)
            task.defer(function()
                if State.Enabled then trackKiller(child); makeBox(child) end
            end)
        end)
        addConnection(State.FolderConnection)
        addConnection(folder.ChildRemoved:Connect(function(child)
            local state = State.KillerStates[child]
            if state and state.Box then
                pcall(function() state.Box:Destroy() end)
                state.Box = nil
            end
            State.KillerStates[child] = nil
        end))
        for _, killer in ipairs(folder:GetChildren()) do
            trackKiller(killer)
            makeBox(killer)
        end
    end
end

local function stop()
    State.Enabled = false
    if State.FolderConnection then
        pcall(function() State.FolderConnection:Disconnect() end)
        State.FolderConnection = nil
    end
    for _, connection in ipairs(State.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    State.Connections = {}
    for killer, state in pairs(State.KillerStates) do
        if state.Box then pcall(function() state.Box:Destroy() end) end
        State.KillerStates[killer] = nil
    end
    State.SeenSounds = setmetatable({}, { __mode = "k" })
    State.KillerStates = setmetatable({}, { __mode = "k" })
    State.Folder = nil
end

local function start()
    if State.Enabled then return true end
    State.Enabled = true
    State.Connections = {}
    State.KillerStates = setmetatable({}, { __mode = "k" })
    State.SeenSounds = setmetatable({}, { __mode = "k" })
    State.Folder = nil
    State.Remote = findRemote()
    State.LastScan = 0
    updateFolder()

    addConnection(Workspace.DescendantAdded:Connect(function(descendant)
        if not State.Enabled then return end
        if descendant:IsA("Sound") then
            attachSound(descendant)
        elseif descendant:IsA("Model") then
            if isWatchedKiller(descendant) then
                trackKiller(descendant)
                makeBox(descendant)
            end
        end
    end))

    addConnection(RunService.Heartbeat:Connect(function()
        if not State.Enabled then return end
        local now = os.clock()
        if now - State.LastRemoteSearch >= 0.5 and (not State.Remote or not State.Remote.Parent) then
            State.Remote = findRemote()
            State.LastRemoteSearch = now
        end
        updateFolder()
        if now - State.LastScan < CONFIG.BoxScanInterval then return end
        State.LastScan = now

        if isLocalPlayerKiller() then return end
        local folder = State.Folder
        if not folder or not folder.Parent then return end

        for _, killer in ipairs(folder:GetChildren()) do
            if killer:IsA("Model") and isWatchedKiller(killer) then
                trackKiller(killer)
                makeBox(killer)
                scanAbilityAttributes(killer)
                scanBox(killer)
            end
        end
    end))
    return true
end

State.Stop = stop
