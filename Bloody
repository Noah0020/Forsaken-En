local function isFacingPlayer(killerRoot, myPos)
    if not Facing.enabled then return true end
    local look = killerRoot.CFrame.LookVector
    local toMe = Vector3.new(myPos.X - killerRoot.Position.X, 0, myPos.Z - killerRoot.Position.Z)
    if toMe.Magnitude < 0.01 then return true end
    return look:Dot(toMe.Unit) >= (Facing.dot or 0.25)
end

local function createSpatialOverlapBox(killerChar, size, onHit)
    if IsPlayerKiller() or not killerChar or killerChar == LP.Character then return end
    local root = killerChar:FindFirstChild("HumanoidRootPart") or killerChar:FindFirstChild("RootPart")
    if not root then return end
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return end
    if (root.Position - my.Position).Magnitude > (Facing.maxDist or 40) then return end
    if Facing.required and not isFacingPlayer(root, my.Position) then return end

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killerChar }

    task.spawn(function()
        local elapsed = 0
        while killerChar.Parent and root.Parent and elapsed < _G.HitboxDuration do
            if IsPlayerKiller() then return end
            local Part = Instance.new("Part")
            Part.Name = "UH_BlockBox"
            Part.Transparency = _G.ShowHitboxVisual and _G.HitboxTransparency or 1
            Part.CanCollide = false
            Part.CanTouch = false
            Part.CanQuery = true
            Part.CastShadow = false
            Part.Anchored = true
            Part.Size = size
            Part.Color = _G.HitboxColor
            Part.Material = Enum.Material.ForceField
            Part.CFrame = root.CFrame * CFrame.new(0, 0, _G.HitboxOffset)
            Part.Parent = Workspace
            if _G.ShowOutline and _G.ShowHitboxVisual then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = Part
                sb.Color3 = _G.HitboxColor
                sb.LineThickness = _G.OutlineThickness
                sb.Transparency = 0.1
                sb.Parent = Part
            end
            Debris:AddItem(Part, 0.05)
            for _, v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                local model = v.Parent and (v.Parent:FindFirstAncestorOfClass("Model") or v.Parent)
                local hum = model and model:FindFirstChildOfClass("Humanoid")
                if not hum and v.Parent then hum = v.Parent:FindFirstChildOfClass("Humanoid") end
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    if _G.BlockDelay > 0 then task.wait(_G.BlockDelay) end
                    if onHit then onHit() end
                    return
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

local lastTrigger = 0
local function triggerBoxCheck(killer)
    if IsPlayerKiller() or not killer or killer == LP.Character or not killer.Parent then return end
    local now = tick()
    if now - lastTrigger < 0.03 then return end
    lastTrigger = now
    createSpatialOverlapBox(killer, Vector3.new(_G.HitboxWidth, _G.HitboxHeight, _G.HitboxLength), FireBlockBuffer)
end

