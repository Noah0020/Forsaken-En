    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if Vee.Sk8Control then
        if IsPlayingAnim("117058860640843") then
            if not ControlActive and hum then
                ControlActive = true
                SavedHumanoid[hum] = {WalkSpeed=hum.WalkSpeed, AutoRotate=hum.AutoRotate}
                pcall(function() hum.WalkSpeed=60; hum.AutoRotate=false end)
                ControlConnection = RunService.RenderStepped:Connect(function()
                    if not hum.Parent or not root then return end
                    pcall(function() hum.WalkSpeed=60; hum.AutoRotate=false end)
                    local look = root.CFrame.LookVector
                    local flat = Vector3.new(look.X, 0, look.Z)
                    if flat.Magnitude > 0 then hum:Move(flat.Unit) end
                end)
            end
        elseif ControlActive then
            ControlActive=false
            if ControlConnection then ControlConnection:Disconnect(); ControlConnection=nil end
            if hum and SavedHumanoid[hum] then
                pcall(function()
                    hum.WalkSpeed=SavedHumanoid[hum].WalkSpeed; hum.AutoRotate=true; hum:Move(Vector3.zero)
