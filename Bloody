RunService.RenderStepped:Connect(function()
    aimPunch = MyAnimLockOn or aimPunchToggles["Character Lock"]
    local camLockEnabled = aimPunchToggles["Camera Lock"]
    if not (aimPunch or camLockEnabled) then return end

    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    if not cachedAnimator then refreshAnimator() end
    local animator = cachedAnimator
    if not animator then return end

    local camera = workspace.CurrentCamera
    local playersFolder = workspace:FindFirstChild("Players")
    local killersFolder = playersFolder and playersFolder:FindFirstChild("Killers")
    if not killersFolder then return end

    for _, name in ipairs(killerNames) do
        local killer = killersFolder:FindFirstChild(name)
        if killer and killer:FindFirstChild("HumanoidRootPart") then
            local root = killer.HumanoidRootPart
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local animId = string_match(tostring_ref(track.Animation.AnimationId), "%d+")
                if punchAnimSet[animId] then
                    local last = lastAimTrigger[track]
                    if not (last and tick_ref() - last < AIM_COOLDOWN) then
                        local timePos = 0
                        pcall(function() timePos = track.TimePosition or 0 end)
                        if timePos <= 0.1 then
                            lastAimTrigger[track] = tick_ref()
                            local humanoid = myChar:FindFirstChild("Humanoid")
                            if humanoid and aimPunch then humanoid.AutoRotate = false end
                            spawn_ref(function()
                                local start = tick_ref()
                                while tick_ref() - start < AIM_WINDOW do
                                    if myRoot and root and root.Parent then
                                        local predictedPos = root.Position + (root.CFrame.LookVector * predictionValue)
                                        if aimPunch then
                                            myRoot.CFrame = CFrame.lookAt(myRoot.Position, predictedPos)
                                        end
                                        if camLockEnabled then
                                            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, predictedPos)
                                        end
                                    end
                                    wait_ref()
                                end
                                if humanoid and aimPunch then humanoid.AutoRotate = true end
                                task.delay(AIM_COOLDOWN - AIM_WINDOW, function()
                                    lastAimTrigger[track] = nil
                                end)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

