local TT = { running = false, conn = nil }
local function TT_Enable()
    if TT.running then return end; TT.running = true
    TT.conn = RunService.Heartbeat:Connect(function()
        if not Settings.TT_AutoBackstab then return end
        local root = LocalRoot; if not root then return end
        local kf = GetKillersFolder(); if not kf then return end
        for _, k in ipairs(kf:GetChildren()) do
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr and (kr.Position - root.Position).Magnitude <= Settings.TT_Range then
                local behind = kr.CFrame.LookVector:Dot((root.Position - kr.Position).Unit) < -0.25
                if behind then
                    local ne = ResolveNetwork()
                    if ne then
                        pcall(function() ne:FireServer("UseActorAbility", {"Dagger"}) end)
                        pcall(function() ne:FireServer("UseActorAbility", {"Backstab"}) end)
                    end
                end
            end
        end
    end)
end
local function TT_Disable()
    TT.running = false
    if TT.conn then pcall(function() TT.conn:Disconnect() end); TT.conn = nil end
end

