local function buildUniqueList()
    animationEntries = {}
    local seen = {}
    local function addEntry(name, idle, walk, run)
        local key = idle .. "|" .. walk .. "|" .. run
        if not seen[key] then
            table.insert(animationEntries, { Name = name, Idle = idle, Walk = walk, Run = run })
            seen[key] = true
        end
    end
    for charName, data in pairs(baseAnimations) do
        addEntry(data.DisplayName or charName, data.Idle or "", data.Walk or "", data.Run or "")
