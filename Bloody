--═══════════════════════════════════════════════════════════════════
-- RF DISPATCHER
--═══════════════════════════════════════════════════════════════════
local rfDispatch = { hooks = {}, installed = false, originalCallback = nil, activeRemote = nil }

function rfDispatch:register(id, cb) self.hooks[id] = cb end
function rfDispatch:unregister(id) self.hooks[id] = nil end
function rfDispatch:install(rf)
    if self.installed then return end
    self.activeRemote = rf
    if typeof(getcallbackvalue) == "function" then
        self.originalCallback = getcallbackvalue(rf, "OnClientInvoke")
    else
        self.originalCallback = rf.OnClientInvoke
    end
    rf.OnClientInvoke = function(requestName, ...)
        local shouldIntercept = (requestName == "GetMousePosition" or requestName == "GetCameraCF")
        if shouldIntercept then
            for id, hookFunc in pairs(self.hooks) do
                local success, result = pcall(hookFunc, requestName, ...)
                if success and result ~= nil then return result end
            end
        end
        if self.originalCallback then
            local ok, res = pcall(self.originalCallback, requestName, ...)
            if ok then return res end
        end
    end
    self.installed = true
end
function rfDispatch:uninstall(rf)
    if not self.installed then return end
    if rf and self.originalCallback then rf.OnClientInvoke = self.originalCallback end
    self.hooks = {}; self.originalCallback = nil
    self.installed = false; self.activeRemote = nil
end

--═══════════════════════════════════════════════════════════════════
-- PATCH #1: NetworkRF — synchronous lookup + async fallback
--═══════════════════════════════════════════════════════════════════
local NetworkRF = nil
local _pendingRFRegisters = {}

local function registerRFWhenReady(id, hookFunc)
    if NetworkRF then
        rfDispatch:register(id, hookFunc)
        return
    end
    table.insert(_pendingRFRegisters, {id = id, func = hookFunc})
    task.spawn(function()
        for _ = 1, 40 do
            task.wait(0.25)
            if NetworkRF then break end
        end
        if NetworkRF then
            for _, pending in ipairs(_pendingRFRegisters) do
                rfDispatch:register(pending.id, pending.func)
            end
            _pendingRFRegisters = {}
        end
    end)
end

do
    local ok, rf = pcall(function()
        return ReplicatedStorage:FindFirstChild("Modules")
            and ReplicatedStorage.Modules:FindFirstChild("Network")
            and ReplicatedStorage.Modules.Network:FindFirstChild("Network")
            and ReplicatedStorage.Modules.Network.Network:FindFirstChild("RemoteFunction")
    end)
    if ok and rf then
        NetworkRF = rf
        rfDispatch:install(rf)
        print("[Cupcake] NetworkRF installed synchronously")
    else
        task.spawn(function()
            for _ = 1, 40 do
                task.wait(0.25)
                local ok2, rf2 = pcall(function()
                    return ReplicatedStorage:FindFirstChild("Modules")
                        and ReplicatedStorage.Modules:FindFirstChild("Network")
                        and ReplicatedStorage.Modules.Network:FindFirstChild("Network")
                        and ReplicatedStorage.Modules.Network.Network:FindFirstChild("RemoteFunction")
                end)
                if ok2 and rf2 then
                    NetworkRF = rf2
                    rfDispatch:install(rf2)
                    print("[Cupcake] NetworkRF installed async")
                    for _, pending in ipairs(_pendingRFRegisters) do
                        rfDispatch:register(pending.id, pending.func)
                    end
                    _pendingRFRegisters = {}
                    return
                end
            end
            print("[Cupcake] WARNING: NetworkRF never appeared — silent aim disabled")
        end)
    end
end

--═══════════════════════════════════════════════════════════════════
-- VELOCITY TRACKING
--═══════════════════════════════════════════════════════════════════
local _velHistory = setmetatable({}, {__mode = "k"})
local _VEL_SMOOTH = 6
local function getHRPVelocity(hrp)
    if not hrp or not hrp.Parent then return Vector3.zero end
    local now = tick()
    local data = _velHistory[hrp]
    if not data then
        _velHistory[hrp] = { lastPos = hrp.Position, lastTime = now, velocity = Vector3.zero, samples = {} }
        return Vector3.zero
    end
    local dt = now - data.lastTime
    if dt > 0.001 then
        local instVel = (hrp.Position - data.lastPos) / dt
        table.insert(data.samples, instVel)
        if #data.samples > _VEL_SMOOTH then table.remove(data.samples, 1) end
        local sum = Vector3.zero
        for _, v in ipairs(data.samples) do sum = sum + v end
        data.velocity = sum / #data.samples
        data.lastPos = hrp.Position
        data.lastTime = now
    end
    return data.velocity
end
local function predictHRP(hrp, lead)
    if not hrp then return nil end
    local vel = getHRPVelocity(hrp)
    if vel.Magnitude < 0.5 then return hrp.Position end
    return hrp.Position + vel * (lead or 0.2)
end

