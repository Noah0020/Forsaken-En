local AIM_STATE = { lastTick=0, silentHooked=false, silentOrig=nil }
local AIM_MAP = {
    ["Guest"]={toggle="AimGuest",pred="AimGuestPred"}, ["Guest1337"]={toggle="AimGuest",pred="AimGuestPred"},
    ["Chance"]={toggle="AimChance",pred="AimChancePred"},
    ["JaneDoe"]={toggle="AimJane",pred="AimJanePred"}, ["Jane Doe"]={toggle="AimJane",pred="AimJanePred"},
    ["Dusekkar"]={toggle="AimDusekkar",pred="AimDusekkarPred"},
    ["TwoTime"]={toggle="AimTwoTime",pred="AimTwoTimePred"}, ["Two Time"]={toggle="AimTwoTime",pred="AimTwoTimePred"},
    ["Shedletsky"]={toggle="AimShedletsky",pred="AimShedletskyPred"},
    ["Veeronica"]={toggle="AimVeeronica",pred="AimVeeronicaPred"},
    ["Elliot"]={toggle="AimPizza",pred="AimPizzaPred"}, ["Pizza"]={toggle="AimPizza",pred="AimPizzaPred"},
}
local function getMyAimConfig()
    if not Settings.SurvivorAimEnabled then return nil end
    local char = LocalPlayer.Character; if not char then return nil end
    local name = char:GetAttribute("CharacterName") or char.Name
    local cfg = AIM_MAP[name]; if cfg and Settings[cfg.toggle] then return Settings[cfg.pred] end
    return nil
end
local function hasLOS(targetPart)
    if not Settings.AimWallCheck then return true end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart"); if not myRoot or not targetPart then return true end
    local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {myChar, targetPart.Parent}
    return Workspace:Raycast(myRoot.Position, targetPart.Position - myRoot.Position, rp) == nil
end
local function findClosestKiller()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart"); if not myRoot then return nil end
    local best, bestDist = nil, Settings.AimDist
    for _, k in ipairs(getKillers()) do
        local kr = getRoot(k); local hum = getHum(k)
        if kr and hum and hum.Health > 0 then
            local d = (kr.Position - myRoot.Position).Magnitude
            if d < bestDist then bestDist = d; best = kr end
        end
    end
    return best
end
local function applyAim(targetPos)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart"); if not myRoot then return end
    local smooth = Settings.AimSmooth
    if Settings.AimMethod == "HRP" or Settings.AimMethod == "HRP + Camera Lock" then
        local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
        if (flat - myRoot.Position).Magnitude > 0.1 then
            myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, flat), smooth)
        end
    end
    if Settings.AimMethod == "Camera" or Settings.AimMethod == "HRP + Camera Lock" then
        local cam = Workspace.CurrentCamera
        if cam then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, targetPos), smooth) end
    end
end
RunService.RenderStepped:Connect(function()
    local now = os.clock(); if now - AIM_STATE.lastTick < 0.016 then return end
    AIM_STATE.lastTick = now
    local pred = getMyAimConfig(); if not pred then return end
    local killerRoot = findClosestKiller(); if not killerRoot then return end
    if not hasLOS(killerRoot) then return end
    applyAim(killerRoot.Position + (killerRoot.AssemblyLinearVelocity or Vector3.zero) * pred)
end)
local function installSilent()
    if AIM_STATE.silentHooked then return true end
    if type(hookfunction) ~= "function" then return false end
    local ok, mod = pcall(function() return require(ReplicatedStorage.Systems.Player.Miscellaneous.GetPlayerMousePosition) end)
    if not ok or type(mod) ~= "table" or type(mod.GetMousePos) ~= "function" then return false end
    AIM_STATE.silentOrig = mod.GetMousePos
    local newFn = function(...)
        if Settings.SilentAim then
            local pred = getMyAimConfig()
            if pred then
                local killerRoot = findClosestKiller()
                if killerRoot and hasLOS(killerRoot) then return killerRoot.Position + (killerRoot.AssemblyLinearVelocity or Vector3.zero) * (Settings.SilentLead or pred) end
            end
        end
        return AIM_STATE.silentOrig(...)
    end
    if not pcall(function() hookfunction(AIM_STATE.silentOrig, newFn) end) then return false end
    AIM_STATE.silentHooked = true; return true
