                            end
                        end
                    end
                end
                if S.survivorESP then
                    local sf = pf:FindFirstChild("Survivors")
                    if sf then
                        for _, s in ipairs(sf:GetChildren()) do
                            if s:IsA("Model") and s ~= LP.Character then
                                seen[s] = true
                                if not s:FindFirstChild("Nos_HL") then createPlayerESP(s, false) end
                            end
                        end
                    end
                end
            end
            if S.generatorESP then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "Generator" and obj:IsA("Model") then
                        local prog = obj:FindFirstChild("Progress")
                        if not prog or prog.Value < 100 then
                            seen[obj] = true
                            if not obj:FindFirstChild("Nos_HL") then createGenESP(obj) end
                        end
                    end
                end
            end
            if S.itemESP then
                for _, name in ipairs({"Medkit", "BloxyCola"}) do
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == name and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            seen[obj] = true
                            if not obj:FindFirstChild("Nos_HL") then
                                local hl = Instance.new("Highlight")
                                hl.Name = "Nos_HL"
                                hl.Adornee = obj
                                hl.FillColor = S.itemColor
                                hl.OutlineColor = S.itemColor
                                hl.FillTransparency = 0.6
                                hl.Parent = obj
                            end
                        end
                    end
                end
            end
            for i = #PlayerESPData, 1, -1 do
                local d = PlayerESPData[i]
                local want = d.isKiller and S.killerESP or S.survivorESP
                if not d.model.Parent or not want then
                    clearModel(d.model)
                elseif d.hl then
                    d.hl.Enabled = want
                end
            end
            for i = #ObjectESPData, 1, -1 do
                local d = ObjectESPData[i]
                if not d.model.Parent or not S.generatorESP then
                    clearModel(d.model)
                end
            end
        end
    end)

    local left = Tabs.ESP:AddLeftGroupbox("Highlights", "eye")
