local STAB_ANIM_IDS = { ["100725497418533"] = true, ["89448354637442"] = true }
local STAB_SPEED_MAX = 6
local stabState = { enabled = false, behindStuds = 4, lerpDuration = 0.4, lerpSpeed = STAB_SPEED_MAX, cooldown = 0.6, lastStab = 0 }
local function getClosestKillerForStab()
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local char = LP.Character; if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart"); if not my then return nil end
    local closest, cd = nil, math.huge
    for _, inst in ipairs(kf:GetChildren()) do
        if inst:IsA("Model") and inst ~= char then
            local hum = inst:FindFirstChildOfClass("Humanoid")
            local hrp = inst:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local dist = (hrp.Position - my.Position).Magnitude
                if dist < cd then cd = dist; closest = inst end
            end
        end
    end
    return closest
end
local function runStabLerp()
    if not stabState.enabled or IsPlayerKiller() then return end
    local now = tick()
    if now - stabState.lastStab < stabState.cooldown then return end
    stabState.lastStab = now
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local killer = getClosestKillerForStab(); if not killer then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local startCF = hrp.CFrame
    local startT = tick()
    local dur = math.max(0.1, stabState.lerpDuration)
    local speedFactor = math.clamp(stabState.lerpSpeed / STAB_SPEED_MAX, 0, 1)
    while tick() - startT < dur do
        if IsPlayerKiller() then break end
        if not char.Parent or not killer.Parent or not kr.Parent then break end
        local alpha = math.clamp((tick() - startT) / dur, 0, 1)
        local smooth = alpha * alpha * (3 - 2 * alpha)
        local targetCF = kr.CFrame * CFrame.new(0, 0, stabState.behindStuds)
        hrp.CFrame = startCF:Lerp(targetCF, smooth * speedFactor)
        RunService.RenderStepped:Wait()
    end
    if char.Parent and killer.Parent and kr.Parent then
        hrp.CFrame = kr.CFrame * CFrame.new(0, 0, stabState.behindStuds)
    end
end
local function hookStabCharacter(character)
    local hum = character:WaitForChild("Humanoid", 10); if not hum then return end
    local an = hum:WaitForChild("Animator", 5); if not an then return end
    an.AnimationPlayed:Connect(function(track)
        if IsPlayerKiller() then return end
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId or ""):gsub("%D", "")
        if STAB_ANIM_IDS[id] then task.spawn(runStabLerp) end
    end)
end
