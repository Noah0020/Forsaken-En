-- HDT — Hitbox Drag (fires only after successful block)
-- ═══════════════════════════════════════════════════════════════
local HDT = {
    running = false,
    dragging = false,
    dragId = 0,
    conn = nil,
    lastFire = 0,
    cooldownUntil = 0,
    -- FIX #3: store saved humanoid props here so StopHDT can restore them
    savedWalk = nil,
    savedAutoRotate = nil,
}

local function hdtNearestKiller()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local bestRoot, bestDist = nil, math.huge
    for _, k in ipairs(getKillers()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        local h = k:FindFirstChildOfClass("Humanoid")
        if hrp and h and h.Health > 0 then
            local d = (hrp.Position - myRoot.Position).Magnitude
            if d < bestDist then bestDist = d; bestRoot = hrp end
        end
    end
    return bestRoot
end

local function hdtStartDrag(target)
    if not target or not target.Parent then return end
    if hasHelplessEffect() then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if (target.Position - hrp.Position).Magnitude <= Settings.HDTStopDistance + 0.5 then return end

    HDT.dragId = HDT.dragId + 1
    local myId = HDT.dragId
    if HDT.conn then HDT.conn:Disconnect(); HDT.conn = nil end
    HDT.dragging = true

    -- FIX #3: save into HDT table so StopHDT can restore if drag is interrupted
    HDT.savedWalk = hum.WalkSpeed
    HDT.savedAutoRotate = hum.AutoRotate
    hum.WalkSpeed = 0
    hum.AutoRotate = false

    local finished = false
    local startedAt = tick()
    local function cleanup()
        if finished then return end
        finished = true
        if HDT.dragId ~= myId then return end
        HDT.dragging = false
        HDT.cooldownUntil = tick() + (Settings.HDTCooldown or 27)
        if HDT.conn then HDT.conn:Disconnect(); HDT.conn = nil end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if hum and hum.Parent then
            pcall(function()
                hum.WalkSpeed = HDT.savedWalk or 16
                hum.AutoRotate = HDT.savedAutoRotate ~= nil and HDT.savedAutoRotate or true
            end)
        end
        HDT.savedWalk = nil
        HDT.savedAutoRotate = nil
    end

    HDT.conn = RunService.Heartbeat:Connect(function(dt)
        if hasHelplessEffect()
           or HDT.dragId ~= myId
           or not HDT.dragging
           or not (char and char.Parent and target and target.Parent)
           or tick() - startedAt > (Settings.HDTDragDuration or 2) then
            cleanup()
            return
        end
        local mp = hrp.Position
        local flat = Vector3.new(target.Position.X, mp.Y, target.Position.Z)
        local delta = flat - mp
        local dist = delta.Magnitude
        if dist <= Settings.HDTStopDistance then cleanup(); return end
        local step = math.min(Settings.HDTSpeed * dt, dist - Settings.HDTStopDistance)
        hrp.CFrame = CFrame.lookAt(mp + delta.Unit * step, flat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- Called by Auto Block after fireBlockNow() succeeds — no range gate, specific killer
HDT_DragTo = function(target)
    if not Settings.HDT then return end
    if hasHelplessEffect() or tick() < HDT.cooldownUntil or HDT.dragging then return end
    if tick() - HDT.lastFire < 0.15 then return end
    if not target or not target.Parent then return end
    HDT.lastFire = tick()
    hdtStartDrag(target)
end

-- Manual Q trigger — nearest killer, no range gate
HDT_Trigger = function(force)
    if not force and not Settings.HDT then return end
    if hasHelplessEffect() or tick() < HDT.cooldownUntil or HDT.dragging then return end
    if tick() - HDT.lastFire < 0.15 then return end
    local target = hdtNearestKiller()
    if not target then return end
    HDT.lastFire = tick()
    hdtStartDrag(target)
end

local function StartHDT()
    if HDT.running then return end
    HDT.running = true
    Settings.HDT = true
    print("[Ivy Hub] HDT ON")
end

local function StopHDT()
    HDT.running = false
    Settings.HDT = false
    -- FIX #3: invalidate any running drag before disconnecting so the
    -- cleanup branch inside the Heartbeat won't fire after disconnect
    HDT.dragId = HDT.dragId + 1
    if HDT.conn then pcall(function() HDT.conn:Disconnect() end); HDT.conn = nil end
    -- Restore humanoid if a drag was in progress when Stop was called
    if HDT.dragging then
        HDT.dragging = false
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Parent then
            pcall(function()
                hum.WalkSpeed = HDT.savedWalk or 16
                hum.AutoRotate = HDT.savedAutoRotate ~= nil and HDT.savedAutoRotate or true
            end)
        end
        HDT.savedWalk = nil
        HDT.savedAutoRotate = nil
    end
    print("[Ivy Hub] HDT OFF")
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Q and HDT_Trigger then
        task.spawn(function() pcall(HDT_Trigger, true) end)
    end
end)

