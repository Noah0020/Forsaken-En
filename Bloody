    })
    Tabs.Aim:AddSection("Enable Per Survivor")
    for _, key in ipairs({ "Guest1337", "Shedlekey", "TwoTime", "Chance", "JaneDoe", "Pizza" }) do
        Tabs.Aim:AddToggle("Aim_"..key, {
            Title = key, Default = getgenv().AimbotValues[key].Enabled,
            Callback = function(v)
                if getgenv().AimbotValues[key] then getgenv().AimbotValues[key].Enabled = v end
                if key == "Chance" then ChanceAim.enabled = v end
            end,
        })
    end
    local function addSurv(key, title, dd, dp)
        Tabs.Aim:AddSection(title)
        Tabs.Aim:AddSlider(key.."_Dur", {
