local function pushIdsFromValue(value, intoSet, abilityName)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id and not intoSet[id] then intoSet[id] = abilityName end
    elseif type(value) == "table" then
        for _, v in pairs(value) do pushIdsFromValue(v, intoSet, abilityName) end
    end
end

local function readConfig(module, label)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for abilityName, animValue in pairs(cfg.Animations) do
            local normalized = abilityName:lower():gsub("[%s_%-]", "")
            local isStun = false
            for stunName in pairs(STUN_ABILITY_NAMES) do
                if normalized == stunName:lower():gsub("[%s_%-]", "") then isStun = true; break end
            end
            if isStun then pushIdsFromValue(animValue, STUN_ANIM_IDS, abilityName) end
        end
    end
    for _, field in ipairs(STUN_SOUND_FIELDS) do
        local soundTable = cfg[field]
        if type(soundTable) == "table" then
            for abilityName, soundValue in pairs(soundTable) do
                local normalized = abilityName:lower():gsub("[%s_%-]", "")
                local isStun = false
                for stunName in pairs(STUN_ABILITY_NAMES) do
                    if normalized == stunName:lower():gsub("[%s_%-]", "") then isStun = true; break end
                end
                if isStun then pushIdsFromValue(soundValue, STUN_SOUND_IDS, abilityName) end
            end
        end
    end
end

local function LoadAbilityIds(char)
    STUN_ANIM_IDS, STUN_SOUND_IDS = {}, {}
    for id, name in pairs(STATIC_STUN_ANIM_IDS) do STUN_ANIM_IDS[id] = name end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"
    for _, role in ipairs({"Survivors", "Killers"}) do
        local roleFolder = assets:FindFirstChild(role)
        if roleFolder then
            local charFolder = roleFolder:FindFirstChild(charName)
            if charFolder then
                local cfg = charFolder:FindFirstChild("Config")
                if cfg then readConfig(cfg, charName .. ":Default") end
            end
        end
    end
    if skinName and skinName ~= "Default" then
        local skinsRoot = assets:FindFirstChild("Skins")
        if skinsRoot then
            for _, role in ipairs({"Survivors", "Killers"}) do
                local skinsRole = skinsRoot:FindFirstChild(role)
                if skinsRole then
                    local skinChar = skinsRole:FindFirstChild(charName)
                    if skinChar then
                        local skinFolder = skinChar:FindFirstChild(skinName)
                        if skinFolder then
                            local cfg = skinFolder:FindFirstChild("Config")
                            if cfg then readConfig(cfg, charName .. ":" .. skinName) end
                        end
                    end
                end
            end
        end
    end
end

