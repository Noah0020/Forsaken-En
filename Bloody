        Callback = function(v) Stam.autoUnsprint = v end,
    })
    left:AddSlider("Stam_UnAt", {
        Text = "Unsprint At", Default = 10, Min = 0, Max = 50, Rounding = 0,
        Callback = function(v) Stam.unsprintAt = v end,
    })
    local right = Tabs.Stam:AddRightGroupbox("Values")
    right:AddSlider("Stam_Min", {
        Text = "Min", Default = 0, Min = 0, Max = 100, Rounding = 0,
        Callback = function(v) Stam.minS = v; if not Stam.unlimited then apply() end end,
    })
    right:AddSlider("Stam_Max", {
