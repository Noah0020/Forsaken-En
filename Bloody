local function createSpatialOverlapBox(killerChar, size, onHit)
    if IsPlayerKiller() then return end
    if not killerChar or killerChar == LP.Character then return end
    local root = killerChar:FindFirstChild("HumanoidRootPart") or killerChar:FindFirstChild("RootPart")
    if not root then return end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killerChar }
    task.spawn(function()
        local elapsed = 0
        while killerChar.Parent and root.Parent and elapsed < _G.HitboxDuration do
            if IsPlayerKiller() then return end
            local Part = Instance.new("Part")
            Part.Name = "Perfect_BlockBox"
            Part.Transparency = _G.HitboxTransparency
            Part.CanCollide = false; Part.CanTouch = false; Part.CanQuery = false
            Part.CastShadow = false; Part.Anchored = true
            Part.Size = size; Part.Color = _G.HitboxColor
            Part.Material = Enum.Material.ForceField
