local AimCore = {
    enabled = false,
    prediction = 0.1,
    easing = 0.35,
    lookAngle = 90,
    distance = 50,
    mode = "Character Lock",
    cooldown = false,
    aimPingComp = true,
}

local function PredictPos(part)
    if not part then return Vector3.zero end
    local pred = AimCore.prediction or 0.1
    if AimCore.aimPingComp then
        local ok, ping = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        end)
        if ok and type(ping) == "number" then pred = pred + ping * 0.5 end
    end
    return part.Position + part.AssemblyLinearVelocity * pred
end

local function SyncAimbot(targetPart, duration)
    if not targetPart or AimCore.cooldown then return end
    local char = LP.Character
    local hrp = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
    if not hrp then return end
    AimCore.cooldown = true
    local t0 = os.clock()
    local conn
    conn = RunService.PostSimulation:Connect(function()
        if os.clock() - t0 >= (duration or 1) or not targetPart or not targetPart.Parent then
            AimCore.cooldown = false
            if conn then conn:Disconnect() end
            return
        end
        if not hrp.Parent then return end
        local pred = PredictPos(targetPart)
        local flat = Vector3.new(pred.X, hrp.Position.Y, pred.Z)
        if (flat - hrp.Position).Magnitude < 0.01 then return end
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, flat), AimCore.easing)
        if AimCore.mode == "Char + Cam Lock" then
            local cam = Workspace.CurrentCamera
            if cam then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pred), AimCore.easing) end
        end
    end)
end

