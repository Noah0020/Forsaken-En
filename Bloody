safe("Two Time", function()
    local BS = {
        enabled = false,
        method = "Lerp", -- Teleport | Lerp | PrimaryPart
        duration = 0.35,
        delay = 0.05,
        normalRange = 3,
        crouchRange = 3,
        lerpSpeed = 25,
        tpBack = false,
        pivotTo = false,
        primaryMode = "Character", -- Character | Root
        partTransparency = 1,
    }
    local STAB_IDS = {
        ["106086955212611"] = true,
        ["100725497418533"] = true,
    }
    local CROUCH_IDS = {
        ["89448354637442"] = true,
        ["107640065977686"] = true,
    }

    local function nearestKillerRoot()
        local k = GetNearestKillerModel(80)
        return k and k:FindFirstChild("HumanoidRootPart")
    end

    local function doTeleport(behind)
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local target = nearestKillerRoot()
        if not hrp or not target then return end
        task.wait(BS.delay)
        local saved = hrp.CFrame
        local endT = tick() + BS.duration
        while tick() < endT do
            if not hrp.Parent or not target.Parent then break end
            hrp.CFrame = CFrame.new((target.CFrame * CFrame.new(0, 0, behind)).Position)
                * (target.CFrame - target.CFrame.Position)
            task.wait()
        end
        if BS.tpBack and hrp.Parent then hrp.CFrame = saved end
    end

    local function doLerp(behind)
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local target = nearestKillerRoot()
        if not hrp or not target then return end
        task.wait(BS.delay)
        local start = tick()
        while tick() - start < BS.duration do
            if not hrp.Parent or not target.Parent then break end
            local goal = (target.CFrame * CFrame.new(0, 0, behind)).Position
            local dt = task.wait()
            local mag = (goal - hrp.Position).Magnitude
            if mag > 0 then
                local alpha = math.min((BS.lerpSpeed * dt) / mag, 1)
                local pos = hrp.Position:Lerp(goal, alpha)
                hrp.CFrame = CFrame.new(pos, pos + target.CFrame.LookVector)
            end
        end
    end

    local function doPrimary(behind)
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local target = nearestKillerRoot()
        if not char or not hrp or not target then return end
        task.wait(BS.delay)
        local host = BS.primaryMode == "Character" and char or hrp
        local Part = Instance.new("Part")
        Part.Name = "NosBroom"
        Part.Size = Vector3.new(1, 1, 1)
        Part.Transparency = BS.partTransparency
        Part.Anchored = true
        Part.CanCollide = false
        Part.Parent = host
        local oldPrimary = char.PrimaryPart
        char.PrimaryPart = Part
        local start = tick()
        while tick() - start < BS.duration do
            target = nearestKillerRoot() or target
            if not target or not target.Parent then break end
            hrp.AssemblyLinearVelocity = Vector3.zero
            local goal = CFrame.new((target.CFrame * CFrame.new(0, 0, behind)).Position)
                * (target.CFrame - target.CFrame.Position)
            Part.CFrame = Part.CFrame:Lerp(goal, math.clamp(BS.lerpSpeed * 0.016, 0, 1))
            if BS.pivotTo then pcall(function() host:PivotTo(Part.CFrame) end) end
            task.wait()
        end
        char.PrimaryPart = oldPrimary
        Part:Destroy()
    end

    local function activate(behind)
        if not BS.enabled or IsPlayerKiller() then return end
        if BS.method == "Teleport" then
            task.spawn(doTeleport, behind)
        elseif BS.method == "PrimaryPart" then
            task.spawn(doPrimary, behind)
        else
            task.spawn(doLerp, behind)
        end
    end

    local function hookChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 8)
            if not hum then return end
            local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)
            if not anim then return end
            anim.AnimationPlayed:Connect(function(track)
                if not BS.enabled then return end
                local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                if not id then return end
                if STAB_IDS[id] then
                    activate(BS.normalRange)
                elseif CROUCH_IDS[id] then
                    activate(BS.crouchRange)
                end
            end)
        end)
    end
    if LP.Character then hookChar(LP.Character) end
    LP.CharacterAdded:Connect(hookChar)

    local left = Tabs.TwoTime:AddLeftGroupbox("Auto Backstab", "sword")
    left:AddToggle("BS_Enable", {
        Text = "Enable Auto Backstab", Default = false,
        Callback = function(v) BS.enabled = v end,
    })
    left:AddDropdown("BS_Method", {
        Text = "Method",
        Values = { "Teleport", "Lerp", "PrimaryPart" },
        Default = 2,
        Callback = function(v) BS.method = v end,
    })
    left:AddSlider("BS_Dur", {
        Text = "Duration", Default = 0.35, Min = 0.05, Max = 2, Rounding = 2,
        Callback = function(v) BS.duration = v end,
    })
    left:AddSlider("BS_Delay", {
        Text = "Start Delay", Default = 0.05, Min = 0, Max = 0.5, Rounding = 2,
        Callback = function(v) BS.delay = v end,
    })
    left:AddSlider("BS_Norm", {
        Text = "Normal Stab Behind", Default = 3, Min = 1, Max = 10, Rounding = 1,
        Callback = function(v) BS.normalRange = v end,
    })
    left:AddSlider("BS_Crouch", {
        Text = "Crouch Stab Behind", Default = 3, Min = 1, Max = 10, Rounding = 1,
        Callback = function(v) BS.crouchRange = v end,
    })

    local right = Tabs.TwoTime:AddRightGroupbox("Method Options", "sliders")
    right:AddSlider("BS_LerpSpd", {
        Text = "Lerp / PP Speed", Default = 25, Min = 5, Max = 80, Rounding = 0,
        Callback = function(v) BS.lerpSpeed = v end,
    })
    right:AddToggle("BS_TPBack", {
        Text = "Teleport Back", Default = false,
        Callback = function(v) BS.tpBack = v end,
    })
    right:AddDropdown("BS_PPMode", {
        Text = "PrimaryPart Host",
        Values = { "Character", "Root" },
        Default = 1,
        Callback = function(v) BS.primaryMode = v end,
    })
    right:AddToggle("BS_Pivot", {
        Text = "PivotTo (PrimaryPart)", Default = false,
        Callback = function(v) BS.pivotTo = v end,
    })
end)

