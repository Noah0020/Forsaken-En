local GS = { installed=false, generation=0, lockBoard=nil }
local GSM = {}
local function gs_safeRequire(path) if not path then return nil end; local ok, res = pcall(function() return require(path) end); return ok and res or nil end
local function gs_loadModules()
    if GSM.flow and GSM.gear and GSM.connect and GSM.lock and GSM.flowBoard and GSM.lockBoard then return true end
    local systems = ReplicatedStorage:FindFirstChild("Systems")
