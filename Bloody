local function UpdateESP()
    local pf = Workspace:FindFirstChild("Players")
    if pf then
        local killersFolder = pf:FindFirstChild("Killers")
        local survivorsFolder = pf:FindFirstChild("Survivors")
        if killersFolder then
            for _, k in ipairs(killersFolder:GetChildren()) do
                if k ~= LP.Character and not IsRagdoll(k) then
                    if ESPSettings.killerESP then
                        if not k:FindFirstChild("Vortex_Highlight") then
                            createPlayerESP(k, ESPSettings.killerColor, true)
                        end
                    else removePlayerESP(k) end
                end
            end
        end
        if survivorsFolder then
            for _, s in ipairs(survivorsFolder:GetChildren()) do
                if s ~= LP.Character and not IsRagdoll(s) then
                    if ESPSettings.playerESP then
                        if not s:FindFirstChild("Vortex_Highlight") then
                            createPlayerESP(s, ESPSettings.survivorColor, false)
                        end
                    else removePlayerESP(s) end
                end
            end
        end
    end
    if not MapFolder then return end
    local ingame = MapFolder
    if ingame:FindFirstChild("Map") then
        for _, gen in ipairs(ingame.Map:GetChildren()) do
            if gen:IsA("Model") and gen.Name:lower():find("generator") then
                local progress = gen:FindFirstChild("Progress")
                if ESPSettings.generatorESP and progress and progress.Value < 100 then
                    if not gen:FindFirstChild("Vortex_ObjectHighlight") then
                        CreateObjectESP(gen, ESPSettings.generatorColor)
                    end
                elseif not ESPSettings.generatorESP then RemoveObjectESP(gen) end
            end
        end
    end
end
task.spawn(function() while task.wait(0.5) do pcall(UpdateESP) end end)

