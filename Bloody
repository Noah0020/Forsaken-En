local function hookKillerAnims(killer)
    if not killer or not killer:IsA("Model") then return end
    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    animator.AnimationPlayed:Connect(function(track)
        if not CONFIG.AutoBlock then return end
        local id = track.Animation and tostring(track.Animation.AnimationId):match("%d+")
        if id and attackAnimIds[id] then makeHitboxAndCheck(killer) end
    end)
