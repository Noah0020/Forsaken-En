    if not char then return false end
    if char:GetAttribute("Helpless") then return true end
    if char:FindFirstChild("Helpless") then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum:GetAttribute("Helpless") then return true end
