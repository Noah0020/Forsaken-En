--═══════════════════════════════════════════════════════════════════
safe("Auto Block", function()
    -- Box (A1) settings
    _G.HitboxWidth=5; _G.HitboxHeight=6; _G.HitboxLength=8; _G.HitboxOffset=-1
    _G.HitboxColor=Color3.fromRGB(40,200,90)
    _G.ShowOutline=true; _G.OutlineThickness=0.01; _G.ShowHitboxVisual=true
    _G.HitboxTransparency=0.5; _G.HitboxDuration=0.5; _G.BlockDelay=0
    _G.AutoBlockEnabled=false

    -- Detection options (can combine Sound + Anim)
    local AB = {
        detectSound = true,
        detectAnim = true,
        useA1Box = true,          -- our spatial overlap method
        useCone = false,          -- Nerg-style range gate without full box
        facingCheck = true,
        range = 18,
        visionRange = 13.5,
        visionAngle = 85,
        blockCooldown = 0.35,
        lastBlock = 0,
    }

    _G.BlockAbilityNames = {
        "PERFORATING","LACERATE","EVISCERATE","CARVING SLASH",
        "STAB","TAG","SLASH","ENRAGED SLASH",
    }
    local BLOCK_NAMES_LOWER={}
    for _,n in ipairs(_G.BlockAbilityNames) do BLOCK_NAMES_LOWER[n:lower()]=true end

    local function nameMatchesBlock(raw)
        if type(raw)~="string" or raw=="" then return false end
        local l=raw:lower()
        for bn in pairs(BLOCK_NAMES_LOWER) do
            if string.find(l,bn,1,true) then return true end
        end
        return false
    end

    local BLOCK_ANIM_IDS, BLOCK_SOUND_IDS = {}, {}
    local function collectBlockAssets(cfg)
        if type(cfg)~="table" then return end
        if type(cfg.Animations)=="table" then
            for name,v in pairs(cfg.Animations) do
                if nameMatchesBlock(name) then
                    for _,id in ipairs(extractAnimIds(v)) do BLOCK_ANIM_IDS[id]=true end
                end
            end
        end
        for _,field in ipairs({"Sounds","Sound","SFX","Sfx"}) do
            if type(cfg[field])=="table" then
                for name,v in pairs(cfg[field]) do
                    if nameMatchesBlock(name) then
                        for _,id in ipairs(extractAnimIds(v)) do BLOCK_SOUND_IDS[id]=true end
                    end
                end
            end
        end
    end
    local function scanFolder(folder)
        if not folder then return end
        for _,sub in ipairs(folder:GetChildren()) do
            if sub:IsA("Folder") then
                for _,cfgName in ipairs({"Config","Behavior"}) do
                    local mod=sub:FindFirstChild(cfgName)
                    if mod and mod:IsA("ModuleScript") then
                        local ok,data=pcall(require,mod)
                        if ok then collectBlockAssets(data) end
                    end
                end
            end
        end
    end
    local function scanAll()
        BLOCK_ANIM_IDS={}; BLOCK_SOUND_IDS={}
        local assets=ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
        scanFolder(assets:FindFirstChild("Killers"))
        local skins=assets:FindFirstChild("Skins")
        local sk=skins and skins:FindFirstChild("Killers")
        if sk then for _,base in ipairs(sk:GetChildren()) do if base:IsA("Folder") then scanFolder(base) end end end
    end
    pcall(scanAll)

    local function shouldBlockAbility(name)
        if type(name)~="string" or name=="" then return false end
        local upper=string.upper(name)
        for _,bn in ipairs(_G.BlockAbilityNames) do
            if string.find(upper,string.upper(bn),1,true) then return true end
        end
        return false
    end

    local function canBlockNow()
        local now=tick()
        if now-AB.lastBlock < AB.blockCooldown then return false end
        return true
    end

    local function passesGates(killer)
        local my=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local kr=killer and killer:FindFirstChild("HumanoidRootPart")
        if not my or not kr then return false end
        local dist=(kr.Position-my.Position).Magnitude
        if dist > AB.range then return false end
        if AB.facingCheck then
            -- killer facing us OR we in their front cone
            if not IsFacingTarget(kr, my, AB.visionAngle) and not IsFacingTarget(my, kr, AB.visionAngle) then
                -- if only one direction fails, still allow if close
                if dist > AB.visionRange then return false end
            end
        end
        return true
    end

    local AutoPunch={enabled=false,afterBlock=true,range=15,delay=0.05,last=0}
    local function FireAbility(name)
        local remote=getNetworkEvent(); if not remote then return end
        local ok=pcall(function() remote:FireServer("UseActorAbility",name) end)
        if not ok then
            pcall(function()
                remote:FireServer("UseActorAbility",{buffer.fromstring(string.pack("<Bi4",3,#name)..name)})
            end)
        end
    end
    local function DoPunch()
        if IsPlayerKiller() then return end
        local now=tick(); if now-AutoPunch.last<0.35 then return end
        AutoPunch.last=now
        if AutoPunch.delay>0 then task.wait(AutoPunch.delay) end
        FireAbility("Punch")
    end

    local function createSpatialOverlapBox(killerChar, size, onHit)
        if IsPlayerKiller() or not killerChar or killerChar==LP.Character then return end
        local root=killerChar:FindFirstChild("HumanoidRootPart") or killerChar:FindFirstChild("RootPart")
        if not root then return end
        local op=OverlapParams.new()
        op.FilterType=Enum.RaycastFilterType.Exclude
        op.FilterDescendantsInstances={killerChar}
        task.spawn(function()
            local elapsed=0
            while killerChar.Parent and root.Parent and elapsed<_G.HitboxDuration do
                if IsPlayerKiller() then return end
                local Part=Instance.new("Part")
                Part.Name="Perfect_BlockBox"
                Part.Transparency=_G.ShowHitboxVisual and _G.HitboxTransparency or 1
                Part.CanCollide=false; Part.CanTouch=false; Part.CanQuery=false; Part.CastShadow=false; Part.Anchored=true
                Part.Size=size; Part.Color=_G.HitboxColor; Part.Material=Enum.Material.ForceField
                Part.CFrame=root.CFrame*CFrame.new(0,0,_G.HitboxOffset); Part.Parent=Workspace
                if _G.ShowOutline and _G.ShowHitboxVisual then
                    local sb=Instance.new("SelectionBox")
                    sb.Adornee=Part; sb.Color3=_G.HitboxColor
                    sb.LineThickness=_G.OutlineThickness; sb.Transparency=0.1; sb.Visible=true; sb.Parent=Part
                end
                Debris:AddItem(Part,0.05)
                for _,v in ipairs(Workspace:GetPartsInPart(Part,op)) do
                    local hum=v.Parent and v.Parent:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health>0 and Players:GetPlayerFromCharacter(hum.Parent)==LP then
                        if _G.BlockDelay>0 then task.wait(_G.BlockDelay) end
                        if onHit then onHit() end
                        return
                    end
                end
                elapsed=elapsed+RunService.Heartbeat:Wait()
            end
        end)
    end

    local function doBlockFire()
        if not canBlockNow() then return end
        AB.lastBlock=tick()
        FireBlockBuffer()
        if AutoPunch.enabled and AutoPunch.afterBlock then
            task.spawn(function()
                task.wait(0.15)
                DoPunch()
            end)
        end
    end

    local lastTrigger=0
    local function triggerBoxCheck(killer)
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        if not killer or killer==LP.Character or not killer.Parent then return end
        if not passesGates(killer) then return end
        local now=tick(); if now-lastTrigger<0.03 then return end
        lastTrigger=now

        if AB.useA1Box then
            createSpatialOverlapBox(
                killer,
                Vector3.new(_G.HitboxWidth,_G.HitboxHeight,_G.HitboxLength),
                doBlockFire
            )
        elseif AB.useCone then
            -- cone-only: block immediately if gates passed
            if _G.BlockDelay>0 then task.wait(_G.BlockDelay) end
            doBlockFire()
        else
            -- no box/cone method selected — still allow direct fire if gates ok
            doBlockFire()
        end
    end

    -- Attribute / ability poll
    local AB_poll={
        lastAbility=setmetatable({}, {__mode="k"}),
        lastUsed=setmetatable({}, {__mode="k"}),
    }
    RunService.PreRender:Connect(function()
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        local kf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
        if not kf then return end
        for _,k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") and k~=LP.Character then
                local cur=k:GetAttribute("AbilityLastUsed") or 0
                local prev=AB_poll.lastAbility[k] or 0
                if cur>prev then
                    AB_poll.lastAbility[k]=cur
                    local curU=k:GetAttribute("AbilitiesUsed") or 0
                    local prevU=AB_poll.lastUsed[k] or 0
                    AB_poll.lastUsed[k]=curU
                    if curU==prevU then triggerBoxCheck(k) end
                end
            end
        end
    end)

    local remoteHooked=false
    local function hookAbilityRemote()
        if remoteHooked then return end
        remoteHooked=true
        local remote=getNetworkEvent(); if not remote then return end
        local function argMatches(arg)
            if type(arg)=="string" then return shouldBlockAbility(arg) end
            if typeof(arg)=="buffer" then
                local ok,str=pcall(buffer.tostring,arg)
                if ok and str then return shouldBlockAbility(str) end
            end
            return false
        end
        local function fireOnMatch(...)
            for _,arg in ipairs({...}) do
                if argMatches(arg) then
                    local kf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
                    if kf then
                        for _,k in ipairs(kf:GetChildren()) do
                            if k:IsA("Model") and k~=LP.Character then triggerBoxCheck(k); return end
                        end
                    end
                    return
                end
            end
        end
        if getconnections then
            local ok,conns=pcall(getconnections,remote.OnClientEvent)
            if ok and conns then
                for _,conn in pairs(conns) do
                    pcall(function()
                        local orig=conn.Function; if not orig then return end
                        conn.Function=function(...)
                            if _G.AutoBlockEnabled and not IsPlayerKiller() then fireOnMatch(...) end
                            return orig(...)
                        end
                    end)
                end
            end
        end
        remote.OnClientEvent:Connect(function(...)
            if _G.AutoBlockEnabled and not IsPlayerKiller() then fireOnMatch(...) end
        end)
    end

    local hookedKillers, monitoredKillers = {}, {}
    local function hookKillerM1(killer)
        if not killer or hookedKillers[killer] or not killer:IsA("Model") or killer==LP.Character then return end
        hookedKillers[killer]=true
        local hum=killer:FindFirstChildOfClass("Humanoid")
        local animator=hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            animator.AnimationPlayed:Connect(function(track)
                if not _G.AutoBlockEnabled or not AB.detectAnim or IsPlayerKiller() then return end
                local id=tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                if id and BLOCK_ANIM_IDS[id] then triggerBoxCheck(killer) end
            end)
        end
        local function hookSound(s)
            if not s:IsA("Sound") then return end
            s.Played:Connect(function()
                if not _G.AutoBlockEnabled or not AB.detectSound or IsPlayerKiller() then return end
                local sid=tostring(s.SoundId):match("%d+")
                if sid and BLOCK_SOUND_IDS[sid] then
                    triggerBoxCheck(killer)
                elseif AB.detectSound and sid then
                    -- soft match: any played combat sound near us still gated by range/facing
                    -- only use known block sounds for reliability
                end
            end)
        end
        for _,d in ipairs(killer:GetDescendants()) do hookSound(d) end
        killer.DescendantAdded:Connect(function(d) hookSound(d) end)
    end

    local function monitorKiller(killer)
        if not killer or monitoredKillers[killer] or not killer:IsA("Model") or killer==LP.Character then return end
        monitoredKillers[killer]=true
        hookKillerM1(killer)
        local lastAbility=killer:GetAttribute("AbilityLastUsed") or 0
        local lastUsed=killer:GetAttribute("AbilitiesUsed") or 0
        local function onNewAbility()
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local name=nil
            for _,attr in ipairs({"AbilityName","LastAbility","CurrentAbility","LastAbilityName","Ability"}) do
                local ok,val=pcall(function() return killer:GetAttribute(attr) end)
                if ok and type(val)=="string" and val~="" then name=val; break end
            end
            if name==nil or shouldBlockAbility(name) then triggerBoxCheck(killer) end
        end
        killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            local cur=killer:GetAttribute("AbilityLastUsed") or 0
            if cur==lastAbility then return end
            lastAbility=cur
            local curUsed=killer:GetAttribute("AbilitiesUsed") or 0
            if curUsed>lastUsed then lastUsed=curUsed; return end
            onNewAbility()
        end)
        for _,attr in ipairs({"AbilityName","LastAbility","CurrentAbility","LastAbilityName"}) do
            pcall(function() killer:GetAttributeChangedSignal(attr):Connect(onNewAbility) end)
        end
    end

    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.25)
            if _G.AutoBlockEnabled and not IsPlayerKiller() then
                local kf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
                if kf then
                    for _,k in ipairs(kf:GetChildren()) do
                        if k:IsA("Model") and k~=LP.Character then monitorKiller(k) end
                    end
                end
            end
        end
    end)

    local function EnableAutoBlock()
        if IsPlayerKiller() then return end
        pcall(scanAll)
        hookAbilityRemote()
        local kf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
        if kf then
            for _,k in ipairs(kf:GetChildren()) do
                if k:IsA("Model") and k~=LP.Character then monitorKiller(k) end
            end
        end
    end
    getgenv().PerfectEnableAutoBlock=EnableAutoBlock

    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.2)
            if AutoPunch.enabled and not AutoPunch.afterBlock and not IsPlayerKiller() then
                if GetNearestKillerModel(AutoPunch.range) then DoPunch() end
            end
        end
    end)

    -- UI
    local left=Tabs.Block:AddLeftGroupbox("Auto Block","shield")
    left:AddToggle("AutoBlockToggle",{Text="Enable AutoBlock",Default=false,Callback=function(v)
        if v and IsPlayerKiller() then
            Library:Notify({Title="Perfect",Description="Auto-Block disabled (Killer)",Time=3})
            pcall(function() Toggles.AutoBlockToggle:SetValue(false) end); return
        end
        _G.AutoBlockEnabled=v
        if v then EnableAutoBlock() end
    end})
    left:AddToggle("AB_DetectSound",{Text="Detect Sound",Default=true,Callback=function(v) AB.detectSound=v end})
    left:AddToggle("AB_DetectAnim",{Text="Detect Animation",Default=true,Callback=function(v) AB.detectAnim=v end})
    left:AddToggle("AB_UseA1Box",{Text="A1 Box Method",Default=true,Callback=function(v) AB.useA1Box=v end})
    left:AddToggle("AB_UseCone",{Text="Cone / Range Method",Default=false,Callback=function(v) AB.useCone=v end})
    left:AddToggle("AB_Facing",{Text="Facing Check",Default=true,Callback=function(v) AB.facingCheck=v end})
    left:AddSlider("AB_Range",{Text="Block Range",Default=18,Min=5,Max=40,Rounding=1,Callback=function(v) AB.range=v end})
    left:AddSlider("AB_VisionRange",{Text="Vision Range",Default=13.5,Min=5,Max=30,Rounding=1,Callback=function(v) AB.visionRange=v end})
    left:AddSlider("AB_VisionAngle",{Text="Vision Angle",Default=85,Min=30,Max=180,Rounding=0,Callback=function(v) AB.visionAngle=v end})
    left:AddSlider("AB_Cooldown",{Text="Block Cooldown",Default=0.35,Min=0,Max=1.5,Rounding=2,Callback=function(v) AB.blockCooldown=v end})
    left:AddLabel({Text="Sound + Anim can both be on. A1 Box uses spatial overlap; Cone fires on range/facing only.",DoesWrap=true})

    local punch=Tabs.Block:AddLeftGroupbox("Auto Punch","swords")
    punch:AddToggle("AutoPunch_T",{Text="Enable Auto Punch",Default=false,Callback=function(v)
        if v and IsPlayerKiller() then pcall(function() Toggles.AutoPunch_T:SetValue(false) end); return end
        AutoPunch.enabled=v
    end})
    punch:AddToggle("AutoPunchAfterBlock_T",{Text="Punch After Block",Default=true,Callback=function(v) AutoPunch.afterBlock=v end})
    punch:AddSlider("AutoPunchRange_S",{Text="Proximity Range",Default=15,Min=5,Max=40,Rounding=0,Callback=function(v) AutoPunch.range=v end})
    punch:AddButton({Text="Force Punch",Func=function() DoPunch() end})

    local right=Tabs.Block:AddRightGroupbox("A1 Hitbox Settings","sliders")
    right:AddToggle("ShowBox_T",{Text="Show Box",Default=true,Callback=function(v) _G.ShowHitboxVisual=v end})
    right:AddSlider("HitboxTransparency",{Text="Transparency",Default=0.5,Min=0,Max=1,Rounding=2,Callback=function(v) _G.HitboxTransparency=v end})
    right:AddLabel("Hitbox Color"):AddColorPicker("HitboxColor",{Default=_G.HitboxColor,Title="Hitbox Color",Callback=function(c) _G.HitboxColor=c end})
    right:AddSlider("HitboxWidth",{Text="Width (X)",Default=5,Min=1,Max=30,Rounding=0,Callback=function(v) _G.HitboxWidth=v end})
    right:AddSlider("HitboxHeight",{Text="Height (Y)",Default=6,Min=1,Max=30,Rounding=0,Callback=function(v) _G.HitboxHeight=v end})
    right:AddSlider("HitboxLength",{Text="Length (Z)",Default=8,Min=1,Max=30,Rounding=0,Callback=function(v) _G.HitboxLength=v end})
    right:AddSlider("HitboxOffset",{Text="Offset (Z)",Default=-1,Min=-10,Max=0,Rounding=0,Callback=function(v) _G.HitboxOffset=v end})
    right:AddSlider("HitboxDuration",{Text="Duration",Default=0.5,Min=0.1,Max=5,Rounding=2,Callback=function(v) _G.HitboxDuration=v end})
    right:AddSlider("BlockDelay",{Text="Block Delay",Default=0,Min=0,Max=1,Rounding=2,Callback=function(v) _G.BlockDelay=v end})
end)

