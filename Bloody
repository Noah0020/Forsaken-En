-- WATCHDOG (suspend on Killer, restore on Survivor)
--═══════════════════════════════════════════════════════════════════
task.spawn(function()
    local wasKiller=false
    local snapshot=nil
    while not _ShuttingDown do
        task.wait(0.4)
        local nowKiller=IsPlayerKiller()
        if nowKiller and not wasKiller then
            snapshot={
                autoBlock=_G.AutoBlockEnabled==true, hdt=HDT.enabled==true, stab=stabState.enabled==true,
                sa=SA.active==true, elliot=elliot.enabled==true, chance=chance.enabled==true,
                jane=(jd.enabled==true) or (jd.aimbotOn==true), dusk=dusekkar.enabled==true,
                veeAT=VeerState.atRunning==true, veeSkate=Vee.SkateControl==true, veeStats=Vee.CustomStats==true,
            }
            if snapshot.autoBlock then _G.AutoBlockEnabled=false end
            if snapshot.hdt then HDT_Stop() end
            if snapshot.stab then stabState.enabled=false end
            if snapshot.sa then SA.active=false; if SA.animConn then pcall(function() SA.animConn:Disconnect() end); SA.animConn=nil end end
            if snapshot.elliot then elliot_stop() end
            if snapshot.chance then chance.enabled=false; if chance.bodyGyro then pcall(function() chance.bodyGyro:Destroy() end); chance.bodyGyro=nil end end
            if snapshot.jane then jd.enabled=false; jd.aimbotOn=false; jd_removePatch() end
            if snapshot.dusk then dusekkar.enabled=false end
            if snapshot.veeAT then VeerATStop() end
            if snapshot.veeSkate then Vee.SkateControl=false; pcall(function() Vee_SkateControl(false) end) end
            Notify("Vortex","Survivor features suspended (Killer)",4)
        elseif not nowKiller and wasKiller and snapshot then
            task.wait(0.6)
            local restored={}
            if snapshot.autoBlock then _G.AutoBlockEnabled=true; table.insert(restored,"Block") end
            if snapshot.hdt then HDT.enabled=true; HDT_Start(); table.insert(restored,"HDT") end
            if snapshot.stab then stabState.enabled=true; table.insert(restored,"Stab") end
            if snapshot.sa then SA.active=true; if LP.Character then attachSurvivorWatcher(LP.Character) end; table.insert(restored,"SA") end
            if snapshot.elliot then elliot.enabled=true; elliot_start(); table.insert(restored,"Elliot") end
