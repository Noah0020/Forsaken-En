local function extractAnimIds(value)
    local out = {}
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id then table.insert(out, id) end
    elseif type(value) == "table" then
        for _, v in pairs(value) do
            for _, id in ipairs(extractAnimIds(v)) do table.insert(out, id) end
        end
    end
    return out
end
local function isStunAbilityName(name)
    if type(name) ~= "string" then return false end
    if STUN_ABILITY_NAMES[name] then return true end
    local n = name:lower():gsub("[%s_%-]", "")
    for s in pairs(STUN_ABILITY_NAMES) do
        if n == s:lower():gsub("[%s_%-]", "") then return true end
    end
    return false
end
local function readConfigModule(module)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end
    local function processAnimTable(t)
        if type(t) ~= "table" then return end
        for abilityName, animValue in pairs(t) do
            if isStunAbilityName(abilityName) then
                for _, id in ipairs(extractAnimIds(animValue)) do STUN_ANIM_IDS[id] = abilityName end
            end
        end
    end
    if type(cfg.Animations) == "table" then processAnimTable(cfg.Animations) end
    if type(cfg.Config) == "table" and type(cfg.Config.Animations) == "table" then processAnimTable(cfg.Config.Animations) end
    local function processSoundTable(t)
        if type(t) ~= "table" then return end
        for abilityName, soundValue in pairs(t) do
            if isStunAbilityName(abilityName) then
                for _, id in ipairs(extractAnimIds(soundValue)) do STUN_SOUND_IDS[id] = abilityName end
            end
        end
    end
    for _, field in ipairs(STUN_SOUND_FIELDS) do
        if type(cfg[field]) == "table" then processSoundTable(cfg[field]) end
        if type(cfg.Config) == "table" and type(cfg.Config[field]) == "table" then processSoundTable(cfg.Config[field]) end
    end
end
local function LoadAbilityIds(char)
    STUN_ANIM_IDS, STUN_SOUND_IDS = {}, {}
    for id, name in pairs(STATIC_STUN_ANIM_IDS) do STUN_ANIM_IDS[id] = name end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"
    for _, role in ipairs({"Survivors", "Killers"}) do
        local rf = assets:FindFirstChild(role)
        local cf = rf and rf:FindFirstChild(charName)
        if cf then
            local c = cf:FindFirstChild("Config"); if c then readConfigModule(c) end
            local b = cf:FindFirstChild("Behavior"); if b then readConfigModule(b) end
        end
    end
    if skinName and skinName ~= "Default" then
        local sr = assets:FindFirstChild("Skins")
        if sr then
            for _, role in ipairs({"Survivors", "Killers"}) do
                local srole = sr:FindFirstChild(role)
                local sc = srole and srole:FindFirstChild(charName)
                local sf = sc and sc:FindFirstChild(skinName)
                if sf then
                    local c = sf:FindFirstChild("Config"); if c then readConfigModule(c) end
                    local b = sf:FindFirstChild("Behavior"); if b then readConfigModule(b) end
                end
            end
        end
    end
end

