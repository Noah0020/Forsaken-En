TabUtil:Toggle({ Title = "Fullbright", Value = false, Callback = setFullbright })
TabUtil:Toggle({ Title = "Custom FOV", Value = false, Callback = setFOV })
TabUtil:Slider({
    Title = "FOV Value",
    Value = { Min = 40, Max = 120, Default = 70 },
    Step = 1,
    Callback = function(v)
        Util.FOV = v
        if Util.FOVOn and workspace.CurrentCamera then
            workspace.CurrentCamera.FieldOfView = v
        end
    end,
})
TabUtil:Section({ Title = "Movement" })
TabUtil:Toggle({ Title = "No Slowness", Value = false, Callback = setNoSlow })
TabUtil:Section({ Title = "World" })
TabUtil:Toggle({ Title = "Disable Trails", Value = false, Callback = function(v) getgenv()._GH_NoTrails = v end })
TabUtil:Toggle({ Title = "Disable Footprints", Value = false, Callback = function(v) getgenv()._GH_NoPrints = v end })
TabUtil:Button({
    Title = "Server Hop",
    Callback = function()
        pcall(function()
            local placeId = game.PlaceId
            local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"))
            for _, s in ipairs(servers.data or {}) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(placeId, s.id, LP)
                    break
                end
            end
        end)
    end,
})
TabUtil:Button({
    Title = "Rejoin",
    Callback = function()
        pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    end,
})

-- Config
TabCfg:Section({ Title = "Config" })
TabCfg:Button({ Title = "Save Config", Callback = saveConfig })
TabCfg:Button({ Title = "Load Config", Callback = loadConfig })

Notify("Golden Hub", "Loaded · RightShift")
print("[Golden Hub] Ready")
