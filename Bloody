local function AttrHeartbeat()
    if not AB.running or KillerState.isKiller then return end
    if not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not AB.KillersFolder or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    local nowW = tick()

    for k, expiry in pairs(_killerWindow) do
        if not k or not k.Parent or nowW > expiry then
            _killerWindow[k] = nil
        else
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local shouldFire = false
                if Settings.AutoBlockCustom then
                    local inZone = false
                    pcall(function() inZone = IsInCustomZone(k) end)
                    if inZone then shouldFire = true end
                elseif Settings.AutoBlock then
                    local dir = AB.LocalRoot.Position - kr.Position
                    local abRange = Settings.AntiBaitRange or 15
                    local abDot = (Settings.AntiBaitFacingCheck == false) and -1 or (Settings.AntiBaitFacingDot or 0.3)
                    local facingOk = true
                    if abDot > -1 then
                        local fl = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
                        local fd = Vector3.new(dir.X, 0, dir.Z)
                        facingOk = fl.Magnitude > 0.01 and fd.Magnitude > 0.01 and fl.Unit:Dot(fd.Unit) >= abDot
                    end
                    if dir.Magnitude <= abRange and dir.Magnitude > 0 and facingOk then shouldFire = true end
                end
                if shouldFire then
                    FireAbilityByMode(Settings.AutoBlockCustom and true or nil, k)
                    _killerWindow[k] = nil
                end
            end
        end
    end

    for _, k in ipairs(AB.KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local alu = k:GetAttribute("AbilityLastUsed") or 0
                local au  = k:GetAttribute("AbilitiesUsed") or 0
                local st  = AB.attrStates[k]
                if st then
                    if au > st.lastUsed then st.isBait = true end
                    if alu > st.lastAbility then
                        local n = tick()
                        if st.castLockUntil and n < st.castLockUntil then
                            st.lastAbility, st.lastUsed = alu, au
                        else
                            if st.isBait then
                                st.isBait = false
                            else
                                st.castLockUntil = n + 0.1
                                if Settings.AutoBlockCustom then
                                    local inZone = false
                                    pcall(function() inZone = IsInCustomZone(k) end)
                                    if inZone then
                                        if n - AB.attrDebounce >= 0.08 then
                                            AB.attrDebounce = n
                                            FireAbilityByMode(true, k)
                                        end
                                    else
                                        _killerWindow[k] = n + (Settings.Duration_Custom or 0.25)
                                    end
                                else
                                    local dir = AB.LocalRoot.Position - kr.Position
                                    local abRange = Settings.AntiBaitRange or 15
                                    local abDot = (Settings.AntiBaitFacingCheck == false) and -1 or (Settings.AntiBaitFacingDot or 0.3)
                                    local facingOk = true
                                    if abDot > -1 then
                                        local fl = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
                                        local fd = Vector3.new(dir.X, 0, dir.Z)
                                        facingOk = fl.Magnitude > 0.01 and fd.Magnitude > 0.01 and fl.Unit:Dot(fd.Unit) >= abDot
                                    end
                                    if dir.Magnitude <= abRange and dir.Magnitude > 0 and facingOk then
                                        if n - AB.attrDebounce >= 0.08 then
                                            AB.attrDebounce = n
                                            FireAbilityByMode(nil, k)
                                        end
                                    else
                                        _killerWindow[k] = n + (Settings.Duration_AntiBait or 0.25)
                                    end
                                    st.castLockUntil = 0
                                end
                            end
                            st.lastAbility, st.lastUsed = alu, au
                        end
                    else
                        st.lastAbility, st.lastUsed = alu, au
                    end
                else
                    AB.attrStates[k] = { lastAbility = alu, lastUsed = au, isBait = false, castLockUntil = 0 }
                end
            end
        end
    end
end

