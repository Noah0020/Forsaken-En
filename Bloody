                                local part=obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                                if part and (part.Position-my.Position).Magnitude<=S.MaxDist then seen[obj]=true; apply(obj,col) end
                            end
                        end
                    end
                end
                for m in pairs(HL) do if not seen[m] or not m.Parent then clear(m) end end
            end
        end
    end)
