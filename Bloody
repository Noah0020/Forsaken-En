local SyncControlCounts = {}
local SyncUsedIds = {}
local function SyncSlug(value)
    local valueText = tostring(value or "Control")
    local clean = valueText:gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", "")
    if clean == "" then clean = "Control" end
    return clean
end
local function SyncUniqueId(category, config)
    local baseId = "SS_" .. SyncSlug(category) .. "_" .. SyncSlug(config.Flag or config.Name or "Control")
    local count = (SyncControlCounts[baseId] or 0) + 1
    SyncControlCounts[baseId] = count
    local id = count == 1 and baseId or (baseId .. "_" .. tostring(count))
    while SyncUsedIds[id] do
        count += 1
        id = baseId .. "_" .. tostring(count)
    end
    SyncUsedIds[id] = true
    return id
end
local function SyncHandle(control)
    local handle = { _control = control }
    function handle:Set(value)
        local c = self._control
        if not c then return end
        if type(c.SetValue) == "function" then c:SetValue(value)
        elseif type(c.Set) == "function" then c:Set(value)
        elseif type(c.SetText) == "function" then c:SetText(tostring(value)) end
    end
    return setmetatable(handle, {
        __index = function(self, key)
            local c = rawget(self, "_control")
            if c then return c[key] end
        end,
    })
end
