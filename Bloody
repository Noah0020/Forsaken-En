local TARGET_ABILITIES = {
    ["SLASH"]=true, ["TAG"]=true, ["STAB"]=true,
    ["CARVING SLASH"]=true, ["EVISCERATE"]=true,
    ["LACERATE"]=true, ["PERFORATING"]=true,
}

local _killerLastAnim = setmetatable({}, {__mode="k"})
local _hookedKillers  = setmetatable({}, {__mode="k"})

local function getKillerAbilityName(killer)
    if not killer then return nil end
    for _, attr in ipairs({
        "AbilityName","CurrentAbility","LastAbility","LastAbilityName",
        "ActiveAbility","CastingAbility","PlayingAbility","CurrentAction",
        "LastAction","Action","AttackName","CurrentAttack","Ability",
    }) do
        local ok, v = pcall(function() return killer:GetAttribute(attr) end)
        if ok and type(v) == "string" and v ~= "" then return v end
    end
    for _, child in ipairs(killer:GetChildren()) do
        if child:IsA("StringValue") then
            local n = child.Name:lower()
            if n:find("ability") or n:find("action") or n:find("attack") then
                if child.Value ~= "" then return child.Value end
            end
        end
    end
    local ok3, attrs = pcall(function() return killer:GetAttributes() end)
    if ok3 and attrs then
        for _, val in pairs(attrs) do
            if type(val) == "string" and #val < 64 then
                local upper = string.upper(val)
                for target in pairs(TARGET_ABILITIES) do
                    if string.find(upper, target, 1, true) then return val end
                end
            end
        end
    end
    local anim = _killerLastAnim[killer]
    if anim and anim.name and anim.name ~= "" and (tick() - anim.time) < 1.5 then
        return anim.name
    end
    return nil
end

local function matchesAbilityFilter(name)
    if not name then return false end
    local upper = string.upper(tostring(name))
    local norm  = upper:gsub("^%s+",""):gsub("%s+$",""):gsub("%s+"," ")
    if TARGET_ABILITIES[norm] then return true end
    for target in pairs(TARGET_ABILITIES) do
        if string.find(upper, "%f[%w]" .. target .. "%f[%W]") then return true end
    end
    return false
end

local function hookKillerAnimator(killer)
    if not killer or _hookedKillers[killer] then return end
    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    _hookedKillers[killer] = true
    animator.AnimationPlayed:Connect(function(track)
        if track and track.Animation then
            _killerLastAnim[killer] = {
                id = track.Animation.AnimationId,
                name = track.Animation.Name,
                time = tick(),
            }
        end
    end)
end

task.spawn(function()
