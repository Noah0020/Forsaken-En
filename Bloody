local function runBackstab()
    local c=getChar() local h=c:WaitForChild("HumanoidRootPart") task.wait(backstabDelay)
    local k=getFVK(); if not k or not c.Parent then return end
    local kr=k:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local a=Instance.new("Part") a.Size=Vector3.new(1,1,1) a.Transparency=1 a.Anchored=true a.CanCollide=false a.Parent=Workspace
    local st=tick() while tick()-st<backstabDur do if not c.Parent then break end a.CFrame=kr.CFrame*CFrame.new(0,0,behindStuds) h.CFrame=a.CFrame RunService.PreRender:Wait() end a:Destroy()
end
local function runDashstab()
    local c=getChar() task.wait(dashstabDelay) local h=c and c:FindFirstChild("HumanoidRootPart"); if not c.Parent or not h then return end
    local k=getFVK(); if not k then return end local kr=k:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local a=Instance.new("Part") a.Size=Vector3.new(1,1,1) a.Transparency=1 a.Anchored=true a.CanCollide=false a.Parent=Workspace
    local st=tick() while tick()-st<backstabDur do if not c.Parent then break end a.CFrame=kr.CFrame*CFrame.new(0,0,behindStuds) h.CFrame=a.CFrame RunService.PreRender:Wait() end a:Destroy()
end
local function hookChar(c)
    local h=c:WaitForChild("Humanoid") local a=h:WaitForChild("Animator")
    a.AnimationPlayed:Connect(function(t) if not t or not t.Animation then return end local id=tostring(t.Animation.AnimationId or ""):gsub("%D","") if id==TARGET_ANIMATION_ID and stabBack then task.spawn(runBackstab) elseif id==DASHSTAB_ANIM_ID and stabDash then task.spawn(runDashstab) end end)
end
if LP.Character then hookChar(LP.Character) end
