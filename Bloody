end
local function elliot_aimAt(tgt)
    if not tgt or not tgt.Parent then return end
    local now = tick(); if now - elliot.lastAimTime < 0.016 then return end
    elliot.lastAimTime = now
    local vel = getHRPVelocity(tgt)
    local predPos = tgt.Position
    if vel.Magnitude > 2 then
        local dist = (tgt.Position - elliot.hrp.Position).Magnitude
        local pt = math.min(dist / elliot.throwForce, 1.0)
        predPos = tgt.Position + (vel * pt * (elliot.predDist / 5))
    end
    if elliot.aimType == "HRP Aimbot" or elliot.aimType == "Camera + Character" then
        if elliot.hrp and elliot.hum then
            if elliot.autoRotBak == nil then
                elliot.autoRotBak = elliot.hum.AutoRotate
                elliot.hum.AutoRotate = false
            end
            elliot.hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
            local dir = predPos - elliot.hrp.Position
            local flat = Vector3.new(dir.X, 0, dir.Z)
            if flat.Magnitude > 0.1 then
                local look = CFrame.lookAt(elliot.hrp.Position, elliot.hrp.Position + flat.Unit)
                elliot.hrp.CFrame = elliot.hrp.CFrame:Lerp(
                    CFrame.new(elliot.hrp.CFrame.Position) * look.Rotation,
                    elliot.smoothness)
            end
        end
    end
    if elliot.aimType == "Camera Aimbot" or elliot.aimType == "Camera + Character" then
        local cam = Workspace.CurrentCamera
        if cam then
            local cf = CFrame.lookAt(cam.CFrame.Position, predPos)
            cam.CFrame = cam.CFrame:Lerp(cf, elliot.smoothness * 1.5)
        end
    end
end
local function elliot_startAimbot()
    if elliot.conn then elliot.conn:Disconnect() end
