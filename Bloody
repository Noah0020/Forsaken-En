-- SILENT AIM
--═══════════════════════════════════════════════════════════════════
do
    local Silent = {
        crystal = false, crystalPred = 2.5, crystalY = 1.5,
        dusk = false, duskPred = 0.5,
        hooked = false,
    }

    local function aimCamCF()
        local killer = GetNearestKiller(math.huge)
        local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local cam = Workspace.CurrentCamera
        if not (killer and my and cam) then return nil end
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        local hum = killer:FindFirstChildOfClass("Humanoid")
        if not hrp then return nil end
        local pos = hrp.Position
        if hum and hum.MoveDirection.Magnitude > 0.1 then
            pos = pos + hum.MoveDirection * Silent.crystalPred
        end
        local dir = pos - my.Position + Vector3.new(0, Silent.crystalY, 0)
        if dir.Magnitude < 0.01 then return nil end
        return CFrame.new(cam.CFrame.Position) * CFrame.lookAt(Vector3.zero, dir.Unit).Rotation
    end

    local function aimMousePos()
        local killer = GetNearestKiller(math.huge)
        if not killer then return nil end
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        local hum = killer:FindFirstChildOfClass("Humanoid")
        if not hrp then return nil end
        local pos = hrp.Position
        if hum and hum.MoveDirection.Magnitude > 0.05 then
            pos = pos + hum.MoveDirection * Silent.duskPred
        end
        return pos
    end

    local function install()
        if Silent.hooked then return true end
        local rf = getRF()
        if not rf then
            task.spawn(function()
                for _ = 1, 20 do
                    task.wait(0.5)
                    rf = getRF()
                    if rf then break end
                end
                if rf and not Silent.hooked then install() end
            end)
            return false
        end
        local ok = false
        if typeof(getcallbackvalue) == "function" and typeof(hookfunction) == "function" then
            ok = pcall(function()
                local old = getcallbackvalue(rf, "OnClientInvoke")
                if type(old) ~= "function" then error("no callback") end
                hookfunction(old, function(...)
                    local name = ({...})[1]
                    if name == "GetCameraCF" and Silent.crystal and not IsPlayerKiller() then
                        local cf = aimCamCF()
                        if cf then return cf end
                    end
                    if name == "GetMousePosition" and Silent.dusk and not IsPlayerKiller() then
                        local p = aimMousePos()
                        if p then return p end
                    end
                    return old(...)
                end)
            end)
        end
        if not ok then
            ok = pcall(function()
                local old = rf.OnClientInvoke
                rf.OnClientInvoke = function(name, ...)
                    if name == "GetCameraCF" and Silent.crystal and not IsPlayerKiller() then
                        local cf = aimCamCF()
                        if cf then return cf end
                    end
                    if name == "GetMousePosition" and Silent.dusk and not IsPlayerKiller() then
                        local p = aimMousePos()
                        if p then return p end
                    end
                    if old then return old(name, ...) end
                end
            end)
        end
        Silent.hooked = ok
        return ok
    end
    task.defer(install)

    local left = Tabs.Silent:AddLeftGroupbox("Crystal Pinch")
    left:AddToggle("Crystal_T", {
        Text = "Crystal Pinch Silent Aim", Default = false,
        Callback = function(v) Silent.crystal = v; if v then install() end end,
    })
    left:AddSlider("CrystalPred", {
        Text = "Prediction", Default = 2.5, Min = 0, Max = 10, Rounding = 1,
        Callback = function(v) Silent.crystalPred = v end,
    })
    left:AddSlider("CrystalY", {
        Text = "Y Offset", Default = 1.5, Min = -2, Max = 5, Rounding = 1,
        Callback = function(v) Silent.crystalY = v end,
    })

    local right = Tabs.Silent:AddRightGroupbox("Dusekkar")
    right:AddToggle("Dusk_T", {
        Text = "Dusekkar Silent Aim", Default = false,
        Callback = function(v) Silent.dusk = v; if v then install() end end,
