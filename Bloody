local function IsPlayerKiller()
    local char = LP.Character
    if not char then return false end
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return false end
    for _, k in ipairs(kf:GetChildren()) do
        if k == char then return true end
    end
    return false
end

local function GetNearestKiller(range)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bestD = nil, range or math.huge
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") and k ~= LP.Character then
            local r = k:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - my.Position).Magnitude
                if d < bestD then best, bestD = k, d end
            end
        end
    end
    return best
end

local function getRE()
    local rs = ReplicatedStorage
    for _, name in ipairs({ "GameEvent","AbilityEvent","RemoteEvent","MainEvent" }) do
        local r = rs:FindFirstChild(name, true)
        if r and r:IsA("RemoteEvent") then return r end
    end
    return nil
end

local HDT = { enabled = false, range = 30 }

local function DragToward(root)
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not root then return end
    hrp.CFrame = CFrame.new(root.Position + (hrp.Position - root.Position).Unit * 2)
end

local function FireAbility(abilityName)
    local re = getRE()
    if re then pcall(function() re:FireServer(abilityName) end) end
end

local function isKillerChar(char)
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return false end
    for _, k in ipairs(kf:GetChildren()) do if k == char then return true end end
    return false
end

