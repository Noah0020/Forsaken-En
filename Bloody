        MaxDist=200, KillerColor=Color3.fromRGB(255,60,60), SurvColor=Color3.fromRGB(80,255,120),
    }
    local HL, BB, tags, Folder = {}, {}, {}, nil
    local function ensure()
        if Folder and Folder.Parent then return Folder end
        Folder = Instance.new("Folder"); Folder.Name = "Perfect_ESP"; Folder.Parent = CoreGui
        return Folder
    end
    local function clearAll(m)
        if HL[m] then pcall(function() HL[m]:Destroy() end); HL[m]=nil end
        if BB[m] then pcall(function() BB[m]:Destroy() end); BB[m]=nil end
        if tags[m] then pcall(function() tags[m]:Destroy() end); tags[m]=nil end
    end
    local function applyHL(m, col)
        local hl = HL[m]
        if hl and hl.Parent and hl.Adornee == m then hl.FillColor=col; hl.OutlineColor=col; return end
        if hl then pcall(function() hl:Destroy() end) end
        hl = Instance.new("Highlight")
        hl.Adornee=m; hl.FillColor=col; hl.OutlineColor=col
        hl.FillTransparency=0.55; hl.OutlineTransparency=0
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent=ensure(); HL[m]=hl
    end
    local function applyTag(m, text, col)
        local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
        if not part then return end
        local bb = tags[m]
        if not bb or not bb.Parent then
            bb = Instance.new("BillboardGui")
            bb.Name="PerfectTag"; bb.AlwaysOnTop=true; bb.Size=UDim2.fromOffset(160,40)
            bb.StudsOffset=Vector3.new(0,3.2,0); bb.Adornee=part; bb.Parent=ensure()
            local lab = Instance.new("TextLabel")
            lab.BackgroundTransparency=1; lab.Size=UDim2.fromScale(1,1)
            lab.Font=Enum.Font.GothamBold; lab.TextSize=14; lab.TextStrokeTransparency=0.4
            lab.Parent=bb
            tags[m]=bb
        end
        local lab = bb:FindFirstChildOfClass("TextLabel")
        if lab then lab.Text=text; lab.TextColor3=col end
        bb.Adornee=part
    end
    local function applyBox(m, col)
        local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
        if not part then return end
        local box = BB[m]
        if not box or not box.Parent then
            box = Instance.new("BoxHandleAdornment")
            box.Name="PerfectBox"; box.AlwaysOnTop=true; box.ZIndex=5
            box.Transparency=0.7; box.Size=Vector3.new(4,6,2)
            box.Adornee=part; box.Parent=ensure(); BB[m]=box
        end
        box.Color3=col; box.Adornee=part
    end
    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.35)
            local any = S.Killer or S.Survivor or S.Generator or S.Medkit or S.Bloxy
            local seen = {}
            local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local pf = Workspace:FindFirstChild("Players")
            local function handleChar(m, col, isKiller)
                if not m or m == LP.Character then return end
                local r = m:FindFirstChild("HumanoidRootPart")
                local h = m:FindFirstChildOfClass("Humanoid")
                if not r or not h or h.Health <= 0 then return end
                if my and (r.Position - my.Position).Magnitude > S.MaxDist then return end
                seen[m]=true
                if (isKiller and S.Killer) or ((not isKiller) and S.Survivor) then applyHL(m, col) end
                if S.Boxes then applyBox(m, col) end
                if S.Names or S.Distance or S.Health then
                    local parts = {}
                    if S.Names then table.insert(parts, m.Name) end
                    if S.Health then table.insert(parts, string.format("%d HP", math.floor(h.Health))) end
                    if S.Distance and my then table.insert(parts, string.format("%dm", math.floor((r.Position-my.Position).Magnitude))) end
                    applyTag(m, table.concat(parts, " | "), col)
                end
            end
            if any or S.Names or S.Distance or S.Health or S.Boxes then
                if pf then
                    local kf = pf:FindFirstChild("Killers")
                    if kf then for _,k in ipairs(kf:GetChildren()) do handleChar(k, S.KillerColor, true) end end
                    local sf = pf:FindFirstChild("Survivors")
                    if sf then for _,s in ipairs(sf:GetChildren()) do handleChar(s, S.SurvColor, false) end end
                end
            end
            if my and (S.Generator or S.Medkit or S.Bloxy) then
                for _,obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") or obj:IsA("BasePart") then
