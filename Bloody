        if ok and type(m) == "table" then return m end
    end
    if getgc then
        local ok, res = pcall(function()
            for _, v in pairs(getgc(true)) do
                if type(v) == "table" and rawget(v, "MaxStamina") and rawget(v, "SprintSpeed") then return v end
            end
        end)
        if ok and res then return res end
    end
    return nil
end
local function Stam_Ensure()
    if Stam.mod then return Stam.mod end
    local m = Stam_Find()
    if m then
        Stam.mod = m
        Stam.saved = { MaxStamina = m.MaxStamina, SprintSpeed = m.SprintSpeed, StaminaGain = m.StaminaGain, StaminaDrain = m.StaminaDrain, StaminaRegenDelay = m.StaminaRegenDelay, Stamina = m.Stamina }
    end
    return m
end
local function Stam_Apply()
    local m = Stam_Ensure(); if not m then return end
    pcall(function()
        if Stam.MaxStamina ~= nil then m.MaxStamina = Stam.MaxStamina end
        if Stam.SprintSpeed ~= nil then m.SprintSpeed = Stam.SprintSpeed end
        if Stam.StaminaGain ~= nil then m.StaminaGain = Stam.StaminaGain end
        if Stam.StaminaDrain ~= nil then m.StaminaDrain = Stam.StaminaDrain end
        if Stam.StaminaRegenDelay ~= nil then m.StaminaRegenDelay = Stam.StaminaRegenDelay end
        if Stam.MaxStamina and m.Stamina and m.Stamina > Stam.MaxStamina then m.Stamina = Stam.MaxStamina end
    end)
end
local function Stam_Start()
    if Stam.running then return end; Stam.running = true
    Stam.thread = task.spawn(function()
        while Stam.running do
            task.wait(0.02)
            local m = Stam.mod or Stam_Ensure()
            if m then
                pcall(function()
                    if Stam.MaxStamina ~= nil then m.MaxStamina = Stam.MaxStamina end
                    if Stam.SprintSpeed ~= nil then m.SprintSpeed = Stam.SprintSpeed end
                    if Stam.StaminaGain ~= nil then m.StaminaGain = Stam.StaminaGain end
                    if Stam.StaminaDrain ~= nil then m.StaminaDrain = Stam.StaminaDrain end
                    if Stam.StaminaRegenDelay ~= nil then m.StaminaRegenDelay = Stam.StaminaRegenDelay end
                    if Stam.Infinite then m.Stamina = m.MaxStamina or 999; m.StaminaDrain = 0 end
                end)
            end
        end
    end)
end
local function Stam_Stop()
    Stam.running = false
    if Stam.thread then pcall(task.cancel, Stam.thread); Stam.thread = nil end
end
local function Stam_Restore()
    if Stam.mod and Stam.saved then
        pcall(function() for k, v in pairs(Stam.saved) do if v ~= nil then Stam.mod[k] = v end end end)
    end
    Stam.MaxStamina = nil; Stam.SprintSpeed = nil; Stam.StaminaGain = nil
    Stam.StaminaDrain = nil; Stam.StaminaRegenDelay = nil; Stam.Infinite = false
end
local function Stam_SetInfinite(v)
    Stam.Infinite = not not v
    if Stam.Infinite then Stam_Ensure(); Stam_Start()
    else
        Stam_Stop()
        if Stam.mod and Stam.saved and Stam.saved.StaminaDrain then pcall(function() Stam.mod.StaminaDrain = Stam.saved.StaminaDrain end) end
        Stam_Apply()
    end
end
local function Stam_Set(field, v)
    local n = tonumber(v); if not n then return end
    Stam[field] = n; Stam_Ensure(); Stam_Apply()
    if not Stam.running then Stam_Start() end
end
task.spawn(function()
    task.wait(1.2)
    local m = Stam_Find()
    if m then
        Stam.mod = m
        Stam.saved = { MaxStamina = m.MaxStamina, SprintSpeed = m.SprintSpeed, StaminaGain = m.StaminaGain, StaminaDrain = m.StaminaDrain, StaminaRegenDelay = m.StaminaRegenDelay, Stamina = m.Stamina }
    end
end)

