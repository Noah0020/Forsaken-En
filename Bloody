--=====================================================================
-- GLOBAL API (still available for quick console control)
--=====================================================================
_G.Cupcake = {
    Config = v1,
    Set = function(k, v) if v1[k] ~= nil then v1[k] = v end end,
    Get = function(k) return v1[k] end,
    Status = function()
        print("=== Cupcake Hub Status ===")
        for k, val in pairs(v1) do
            if type(val) == "boolean" or type(val) == "number" then
                print(string.format("  %s = %s", k, tostring(val)))
            end
        end
    end,
    Generator = function(on)
        MinigameSolver.ManualEnabled = on; MinigameSolver.Enabled = on
        MinigameSolver.Generation += 1
    end,
    Emotes = function()
        local t = {}; for _, m in ipairs(emoteMods) do table.insert(t, m.Name) end; return t
    end,
    PlayEmote = function(name)
        for _, m in ipairs(emoteMods) do
            if m.Name == name then emPlay(m); return end
        end
    end,
    StopEmote = function() emStop() end,
    ForceHDT = function() local k = hdtNearest(); if k then hdtDash(k) end end,
    Stab = function() hunterstab() end,
    Block = function() fireBlock(hdtNearest()) end,
    LMS = function(name, on) if name then v1.lmsTrack = name end; onLMSToggle(on) end,
    LowGraphics = function(on) v1.LowGraphics = on; ApplyExtremeLowGraphics(on) end,
    ShowPing = function(on) v1.ShowPing = on end,
}

