    if not hookmetamethod or not getnamecallmethod then return end
    NoliAim.hooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if not _ShuttingDown and getnamecallmethod() == "FireServer" and self == NetworkEvent then
            local args = {...}
            if args[1] == "UseActorAbility" then
                local ability = args[2]
                if type(ability) == "table" then
                    for _, v in ipairs(ability) do
                        if type(v) == "buffer" then
                            local ok, str = pcall(buffer.tostring, v)
                            if ok and str and NoliIsVoidRushAbility(str) then pcall(NoliAimTrigger); break end
                        elseif NoliIsVoidRushAbility(v) then pcall(NoliAimTrigger); break end
                    end
                elseif NoliIsVoidRushAbility(ability) then pcall(NoliAimTrigger) end
            end
        end
        return oldNamecall(self, ...)
    end)
end
