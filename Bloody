        local r = m:FindFirstChild("HumanoidRootPart"); local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - my.Position).Magnitude
            if d < bd then bd = d; best = r end
        end
    end
    return best
end
local function chance_predict(hrp)
    local char = LP.Character; local my = char and char:FindFirstChild("HumanoidRootPart")
    if not my then return hrp.Position end
    local vel = getHRPVelocity(hrp)
    if chance.predMode == "Look" then return hrp.Position + hrp.CFrame.LookVector * (vel.Magnitude * chance.predValue) end
    if vel.Magnitude < 0.5 then return hrp.Position end
    return hrp.Position + vel * (chance.predValue + ((hrp.Position - my.Position).Magnitude * 0.003))
end
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if chance.holdToAim and i.KeyCode == chance.aimKey then chance.holdingKey = true; chance.aiming = true; chance.startTime = tick() end
end)
UserInputService.InputEnded:Connect(function(i)
    if chance.holdToAim and i.KeyCode == chance.aimKey then chance.holdingKey = false; chance.aiming = false end
end)
RunService.RenderStepped:Connect(function(dt)
    if not chance.enabled then return end
    local char = LP.Character; local my = char and char:FindFirstChild("HumanoidRootPart"); if not my then return end
    if chance.holdToAim then if not chance.holdingKey then return end
    else if not chance.aiming then return end; if tick() - chance.startTime > chance.aimDuration then chance.aiming = false; return end end
    local target = chance_getNearest(); if not target then return end
    local pos = chance_predict(target); if not pos then return end
    if chance.aimBehavior == "360" then
        local prog = (tick() - chance.startTime) / 0.5
        if prog < 1 then my.CFrame = CFrame.new(my.Position) * CFrame.Angles(0, math.rad(360*prog), 0); return end
    end
