    ["123825742002486"]=true,["125854302746190"]=true,["132298811847315"]=true,["135209101640984"]=true,
}

local function getVel(hrp)
    if not hrp then return Vector3.zero end
    local d = _aimVel[hrp]; local now = tick()
    if not d then _aimVel[hrp] = {pos=hrp.Position, t=now, v=Vector3.zero}; return Vector3.zero end
    local dt = now - d.t
    if dt <= 0 then return d.v end
    local v = (hrp.Position - d.pos) / dt
    d.pos, d.t, d.v = hrp.Position, now, v
    return v
end

local function getNearestKillerAim()
    if not LocalRoot then return nil end
    RefreshFolders()
    if not KillersFolder then return nil end
    local best, bd = nil, C.AimbotRange
    for _, m in ipairs(KillersFolder:GetChildren()) do
        if m:IsA("Model") then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local pp = r.Position + getVel(r) * C.Prediction + Vector3.new(0, C.DepthOffset, 0)
                local d = (pp - LocalRoot.Position).Magnitude
                if d < bd then bd = d; best = {root=r, pos=pp} end
            end
        end
    end
    return best
end

local function rotateTo(target)
    if not target or not target.root or not LocalRoot then return end
    local tp = target.pos or target.root.Position
    local dir = Vector3.new(tp.X - LocalRoot.Position.X, 0, tp.Z - LocalRoot.Position.Z)
    if dir.Magnitude < 0.1 then return end
    LocalRoot.CFrame = CFrame.new(LocalRoot.Position, LocalRoot.Position + dir.Unit)
end

local faceConn
local function setSoftFace(on)
    C.SoftFace = on
    if faceConn then faceConn:Disconnect(); faceConn = nil end
    if on then
        faceConn = RunService.RenderStepped:Connect(function()
            if C.SoftFace then
                local t = getNearestKillerAim()
                if t then rotateTo(t) end
            end
        end)
        Notify("Soft Face Aim ON")
    end
end

local function setupPunchAimbot(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator")
    if not anim then return end
    anim.AnimationPlayed:Connect(function(track)
        if not C.PunchAimbot then return end
        local id = track.Animation and track.Animation.AnimationId:match("%d+")
        if id and _punchAnimIds[id] then
            local t = getNearestKillerAim()
            if t then task.spawn(rotateTo, t) end
        end
    end)
end

