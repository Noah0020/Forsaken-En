-- NETWORK HOOK (t12)
-- ════════════════════════════════════════════
local t12 = { Tasks = {}, originalFunctions = {} }
if t1.requiring then
	t12.AddTask    = function(self, name, fn) self.Tasks[name] = fn end
	t12.RemoveTask = function(self, name) self.Tasks[name] = nil end
	t12.ExecuteTasks = function(self, args)
		local exit = false
		for _, task_ in pairs(self.Tasks) do
			local _, r = xpcall(task_, function(e) task.spawn(v13, e, 0) end, args)
			if r == "exit" then exit = true end
		end
		return exit
	end
	for k, v in pairs(Network) do t12.originalFunctions[k] = v end
	for k in pairs(Network) do
		Network[k] = function(...)
			local args = {...}
			if t12:ExecuteTasks(args) then return end
			return t12.originalFunctions[k](table.unpack(args))
		end
	end
end

-- ════════════════════════════════════════════
-- METATABLE HOOK (t14)
-- ════════════════════════════════════════════
local t14 = { Tasks = {} }
if t1.hooking then
	t14.AddTask    = function(self, name, fn) self.Tasks[name] = fn end
	t14.RemoveTask = function(self, name) self.Tasks[name] = nil end
	t14.ExecuteTasks = function(self, ...)
		for _, task_ in pairs(self.Tasks) do
			local _, r = xpcall(task_, function(e) task.spawn(v13, e, 0) end, select(2, ...))
			if r == "exit" then return true end
		end
	end
	local mt   = getrawmetatable(game)
	local orig = mt.__namecall
	setreadonly(mt, false)
	mt.__namecall = newcclosure(function(obj, ...)
		if t14:ExecuteTasks(obj, ...) then return end
		return orig(obj, ...)
	end)
	setreadonly(mt, true)
end

