local HDT = { enabled = false, speed = 40, delay = 0.05, duration = 0.6, debounce = false }
local HDT_BLOCK_ANIM_IDS = {}
local HDT_BLOCK_SOUND_IDS = {}
local HDT_animConn = nil
local HDT_soundConns = {}
local HDT_charConn = nil

local function normalizeForBlock(s)
    if type(s) ~= "string" then return "" end
    return s:upper():gsub("[%s_%-]", "")
end

local function scanHDTBlockAssets()
    HDT_BLOCK_ANIM_IDS = {}
    HDT_BLOCK_SOUND_IDS = {}
    if IsPlayerKiller() then return end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end

    local function scanFolder(folder)
        if not folder then return end
        for _, cfgName in ipairs({"Config", "Behavior"}) do
            local mod = folder:FindFirstChild(cfgName)
            if mod and mod:IsA("ModuleScript") then
                local ok, data = pcall(require, mod)
                if ok and type(data) == "table" then
                    if type(data.Animations) == "table" then
                        for name, v in pairs(data.Animations) do
                            if normalizeForBlock(name):find("BLOCK", 1, true) then
                                for _, id in ipairs(extractAnimIds(v)) do
                                    HDT_BLOCK_ANIM_IDS[id] = true
                                end
                            end
                        end
                    end
                    for _, field in ipairs({"Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds"}) do
                        if type(data[field]) == "table" then
                            for name, v in pairs(data[field]) do
                                if normalizeForBlock(name):find("BLOCK", 1, true) then
                                    for _, id in ipairs(extractAnimIds(v)) do
                                        HDT_BLOCK_SOUND_IDS[id] = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local survivors = assets:FindFirstChild("Survivors")
    if survivors then
        for _, charFolder in ipairs(survivors:GetChildren()) do
            if charFolder:IsA("Folder") then scanFolder(charFolder) end
        end
    end
    local skins = assets:FindFirstChild("Skins")
    local survSkins = skins and skins:FindFirstChild("Survivors")
    if survSkins then
        for _, base in ipairs(survSkins:GetChildren()) do
            if base:IsA("Folder") then
                for _, skin in ipairs(base:GetChildren()) do
                    if skin:IsA("Folder") then scanFolder(skin) end
                end
            end
        end
    end
end

local function HDT_NearestKiller()
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local c = LP.Character
    local mr = c and c:FindFirstChild("HumanoidRootPart")
    if not mr then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") and k ~= c then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local d = (kr.Position - mr.Position).Magnitude
                if d < bd then best, bd = k, d end
            end
        end
    end
    return best
end

local function HDT_Dash(target)
    if IsPlayerKiller() then return end
    if not HDT.enabled or HDT.debounce then return end
    if not target or target == LP.Character or not target.Parent then return end

    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local targetHRP = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
    if not targetHRP then return end

    if HDT.delay > 0 then
        task.wait(HDT.delay)
        if not HDT.enabled or IsPlayerKiller() then return end
    end

    if (targetHRP.Position - hrp.Position).Magnitude < 2.5 then return end

    local originalWS = hum.WalkSpeed
    local originalAR = hum.AutoRotate
    local speed = math.max(1, HDT.speed)
    local duration = math.max(0.1, HDT.duration)
    local startTime = tick()

    HDT.debounce = true
    hum.WalkSpeed = speed
    hum.AutoRotate = false   -- we control rotation ourselves so the body turns

    local conn
    local function cleanup()
        if conn then pcall(function() conn:Disconnect() end); conn = nil end
        HDT.debounce = false
        if hum and hum.Parent then
            pcall(function()
                hum.WalkSpeed = originalWS
                hum.AutoRotate = originalAR
                hum:Move(Vector3.zero, false)
            end)
        end
    end

    conn = RunService.Heartbeat:Connect(function()
        if IsPlayerKiller() then cleanup(); return end
        if not HDT.enabled then cleanup(); return end
        if not char.Parent or not hum.Parent or not hrp.Parent then cleanup(); return end
        if not target.Parent then cleanup(); return end

        local curTargetHRP = target:FindFirstChild("HumanoidRootPart")
        if not curTargetHRP then cleanup(); return end

        if tick() - startTime >= duration then cleanup(); return end

        hum.WalkSpeed = speed

        local flat = Vector3.new(
            curTargetHRP.Position.X - hrp.Position.X,
            0,
            curTargetHRP.Position.Z - hrp.Position.Z
        )
        if flat.Magnitude <= 2 then cleanup(); return end

        -- Turn the body to face the killer and walk toward them
        local look = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
        hrp.CFrame = CFrame.new(hrp.Position) * look.Rotation
        hum:Move(flat.Unit, false)
    end)

    task.delay(duration + 0.5, function()
        if HDT.debounce then cleanup() end
    end)
end

local function HDT_TriggerFromBlock()
    if not HDT.enabled or IsPlayerKiller() or HDT.debounce then return end
    local killer = HDT_NearestKiller()
    if not killer then return end
    task.spawn(function() HDT_Dash(killer) end)
end

local function attachHDTWatcher(char)
    if HDT_animConn then pcall(function() HDT_animConn:Disconnect() end); HDT_animConn = nil end
    for _, c in ipairs(HDT_soundConns) do pcall(function() c:Disconnect() end) end
    HDT_soundConns = {}

    if IsPlayerKiller() then
        HDT_BLOCK_ANIM_IDS = {}
        HDT_BLOCK_SOUND_IDS = {}
        return
    end

    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 5)

    if animator then
        HDT_animConn = animator.AnimationPlayed:Connect(function(track)
            if not HDT.enabled or IsPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if id and HDT_BLOCK_ANIM_IDS[id] then
                HDT_TriggerFromBlock()
            end
        end)
    end

    local function hookSound(s)
        if not s:IsA("Sound") then return end
        local conn = s.Played:Connect(function()
            if not HDT.enabled or IsPlayerKiller() then return end
            local sid = tostring(s.SoundId):match("%d+")
            if sid and HDT_BLOCK_SOUND_IDS[sid] then
                HDT_TriggerFromBlock()
            end
        end)
        table.insert(HDT_soundConns, conn)
    end

    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d) end
    end
    local descConn = char.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d) end
    end)
    table.insert(HDT_soundConns, descConn)
end

local function HDT_Start()
    if IsPlayerKiller() then return end
    scanHDTBlockAssets()
    if LP.Character then attachHDTWatcher(LP.Character) end
    if not HDT_charConn then
        HDT_charConn = LP.CharacterAdded:Connect(function(c)
            task.wait(0.5)
            if HDT.enabled then
                scanHDTBlockAssets()
                attachHDTWatcher(c)
            end
        end)
    end
end

local function HDT_Stop()
    HDT.enabled = false
    HDT.debounce = false
    if HDT_animConn then pcall(function() HDT_animConn:Disconnect() end); HDT_animConn = nil end
    for _, c in ipairs(HDT_soundConns) do pcall(function() c:Disconnect() end) end
    HDT_soundConns = {}
    if HDT_charConn then pcall(function() HDT_charConn:Disconnect() end); HDT_charConn = nil end
    HDT_BLOCK_ANIM_IDS = {}
    HDT_BLOCK_SOUND_IDS = {}
end

