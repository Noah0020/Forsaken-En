if type(IsWallBetween) ~= "function" then
    function IsWallBetween(myRoot, targetRoot, myCharacter, targetCharacter)
        if not myRoot or not targetRoot then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {myCharacter, targetCharacter}
        local direction = targetRoot.Position - myRoot.Position
        if direction.Magnitude <= 0.01 then return false end
        return workspace:Raycast(myRoot.Position, direction, params) ~= nil
    end
end
if type(PassesFacingCheck) ~= "function" then
    function PassesFacingCheck(myRoot, killerRoot)
        if not myRoot or not killerRoot then return false end
        local toPlayer = myRoot.Position - killerRoot.Position
        if toPlayer.Magnitude <= 0.01 then return true end
        local threshold = tonumber(Settings.FacingDot) or 0.3
        return killerRoot.CFrame.LookVector:Dot(toPlayer.Unit) >= threshold
    end
end
