local FlipGroupMisc = Tabs.Misc:AddLeftGroupbox("Front Flip", "rotate-cw")
local ffEnabled = false
local jumpHeight = 72
local jumpDistance = 35
local function flip()
    if ffEnabled then return end
    ffEnabled = true
    local char = LP.Character; if not char then ffEnabled = false; return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then ffEnabled = false; return end
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    for _, state in ipairs({Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Climbing}) do
        hum:SetStateEnabled(state, false)
    end
    local dur = 0.45; local steps = 120
    local startCF = hrp.CFrame; local fwd = startCF.LookVector; local up = Vector3.new(0, 1, 0)
    task.spawn(function()
        local st = tick()
        for i = 1, steps do
            local t = i / steps; local h = jumpHeight * (t - t * t)
            local pos = startCF.Position + fwd * (jumpDistance * t) + up * h
            local rot = startCF.Rotation * CFrame.Angles(-math.rad(i * (360 / steps)), 0, 0)
            hrp.CFrame = CFrame.new(pos) * rot
            local elapsed = tick() - st; local waitTime = (dur / steps) * i - elapsed
            if waitTime > 0 then task.wait(waitTime) end
        end
        hrp.CFrame = CFrame.new(startCF.Position + fwd * jumpDistance) * startCF.Rotation
        for _, state in ipairs({Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Climbing}) do
            hum:SetStateEnabled(state, true)
        end
        hum:ChangeState(Enum.HumanoidStateType.Running)
        task.wait(0.25); ffEnabled = false
    end)
end
FlipGroupMisc:AddButton({ Text = "Front Flip", Func = flip })

