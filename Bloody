local function doParry()
    if not AutoParryConfig.Enabled then return end
    if AutoParryConfig.UsePrediction then
        local killerHRP = getNearestKillerHRP()
        local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if killerHRP and myHRP then
            local vel = killerHRP.AssemblyLinearVelocity or Vector3.zero
            if vel.Magnitude > 60 then vel = vel.Unit * 60 end
            local pred = killerHRP.Position + vel * (settings.aimPrediction * 0.03)
            local flat = Vector3.new(pred.X - myHRP.Position.X, 0, pred.Z - myHRP.Position.Z)
            if flat.Magnitude > 0.01 then
                flat = flat.Unit
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                local wasAuto = hum and hum.AutoRotate
                if hum then hum.AutoRotate = false end
                myHRP.CFrame = CFrame.lookAt(myHRP.Position, myHRP.Position + flat)
                task.delay(0.2, function()
                    if hum and hum.Parent then hum.AutoRotate = wasAuto end
                end)
            end
        end
    end
    fireParryPunch()
end

local function onBlockSound()
    if not AutoParryConfig.Enabled then return end
    local now = tick()
    if now - lastParryTime < 0.3 then return end
    lastParryTime = now
    if AutoParryConfig.Delay > 0 then
        task.delay(AutoParryConfig.Delay, doParry)
    else
        doParry()
    end
end

local function hookSound(snd)
    if not snd:IsA("Sound") then return end
    if not BlockSoundIds[snd.SoundId] then return end
    if snd:GetAttribute("AutoParryHooked") then return end
    snd:SetAttribute("AutoParryHooked", true)
    snd.Played:Connect(onBlockSound)
end

