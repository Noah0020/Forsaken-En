-- SURVIVOR AIM (BodyGyro-based, no desync)
--═══════════════════════════════════════════════════════════
local activeSnapConn = nil
local activeSnapHum = nil
local activeSnapWasAuto = true
local activeSnapGyro = nil

local function findClosestTargetHRP(targetType, excludeChar, fromPos, maxDist)
    local folder = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(targetType)
    if not folder then return nil end
    local best, bd = nil, maxDist
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m ~= excludeChar then
            local trg = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if trg and h and h.Health > 0 then
                local d = (trg.Position - fromPos).Magnitude
                if d < bd then bd = d; best = trg end
            end
        end
    end
    return best
end

local function stopSnapLock()
    if activeSnapConn then pcall(function() activeSnapConn:Disconnect() end); activeSnapConn = nil end
    if activeSnapGyro and activeSnapGyro.Parent then pcall(function() activeSnapGyro:Destroy() end); activeSnapGyro = nil end
    if activeSnapHum and activeSnapHum.Parent then
        pcall(function() activeSnapHum.AutoRotate = activeSnapWasAuto end)
    end
    activeSnapHum = nil
end

local function performSnap(targetType, useCamera)
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not hum or hum.Health <= 0 then return end

    local targetHRP = findClosestTargetHRP(targetType, char, hrp.Position, settings.distance)
    if not targetHRP then return end

    stopSnapLock()

    if useCamera then
        local cam = workspace.CurrentCamera
        local vel = targetHRP.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        local pred = targetHRP.Position + vel * (settings.aimPrediction * 0.03)
        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, pred) end
        return
    end

    -- Character mode: BodyGyro lock (physics-safe, no CFrame write to HRP)
    activeSnapHum = hum
    activeSnapWasAuto = hum.AutoRotate
    hum.AutoRotate = false

    local bg = Instance.new("BodyGyro")
    bg.Name = "Ck_SnapGyro"
    bg.MaxTorque = Vector3.new(0, 1e6, 0)
    bg.P = 5000
    bg.D = 500
    bg.Parent = hrp
    activeSnapGyro = bg

    local vel0 = targetHRP.AssemblyLinearVelocity or Vector3.zero
    if vel0.Magnitude > 60 then vel0 = vel0.Unit * 60 end
    local pred0 = targetHRP.Position + vel0 * (settings.aimPrediction * 0.03)
    local dir0 = Vector3.new(pred0.X - hrp.Position.X, 0, pred0.Z - hrp.Position.Z)
    if dir0.Magnitude > 0.01 then
        dir0 = dir0.Unit
        bg.CFrame = CFrame.new(hrp.Position, hrp.Position + dir0)
    end

    local startT = tick()
    activeSnapConn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent then stopSnapLock(); return end
        if tick() - startT > 0.4 then stopSnapLock(); return end
        local t = findClosestTargetHRP(targetType, char, hrp.Position, settings.distance)
        if not t then return end
        local vel = t.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        local pred = t.Position + vel * (settings.aimPrediction * 0.03)
        local dir = Vector3.new(pred.X - hrp.Position.X, 0, pred.Z - hrp.Position.Z)
        if dir.Magnitude > 0.01 then
            dir = dir.Unit
            bg.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
        end
    end)
end

