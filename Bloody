local SURVIVOR_ABILITY_NAMES = {
    "SLASH", "PUNCH", "PARRY", "SACRIFICIAL DAGGER", "SAC DAGGER", "HATCHET",
}

local function normalizeAbilityName(s)
    if type(s) ~= "string" then return "" end
    return s:upper():gsub("[%s_%-]", "")
end

local SURVIVOR_ABILITY_NORMALIZED = {}
for _, name in ipairs(SURVIVOR_ABILITY_NAMES) do
    SURVIVOR_ABILITY_NORMALIZED[normalizeAbilityName(name)] = true
end

local function isSurvivorAbilityName(name)
    return SURVIVOR_ABILITY_NORMALIZED[normalizeAbilityName(name)] == true
end

local SURVIVOR_ANIM_IDS = {}
local SURVIVOR_SOUND_IDS = {}

local function scanSurvivorAbilityAssets(char)
    SURVIVOR_ANIM_IDS = {}
    SURVIVOR_SOUND_IDS = {}
    if not char or IsPlayerKiller() then return end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    local survivors = assets:FindFirstChild("Survivors")
    if not survivors then return end

    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"

    local function scanFolder(folder)
        if not folder then return end
        for _, cfgName in ipairs({"Config", "Behavior"}) do
            local mod = folder:FindFirstChild(cfgName)
            if mod and mod:IsA("ModuleScript") then
                local ok, data = pcall(require, mod)
                if ok and type(data) == "table" then
                    if type(data.Animations) == "table" then
                        for name, v in pairs(data.Animations) do
                            if isSurvivorAbilityName(name) then
                                for _, id in ipairs(extractAnimIds(v)) do
                                    SURVIVOR_ANIM_IDS[id] = true
                                end
                            end
                        end
                    end
                    for _, field in ipairs({"Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds"}) do
                        if type(data[field]) == "table" then
                            for name, v in pairs(data[field]) do
                                if isSurvivorAbilityName(name) then
                                    for _, id in ipairs(extractAnimIds(v)) do
                                        SURVIVOR_SOUND_IDS[id] = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local baseFolder = survivors:FindFirstChild(charName)
    if not baseFolder then
        for _, child in ipairs(survivors:GetChildren()) do
            if child:IsA("Folder") then
                local cfg = child:FindFirstChild("Config")
                if cfg and cfg:IsA("ModuleScript") then
                    local ok, data = pcall(require, cfg)
                    if ok and type(data) == "table" then
                        if data.DisplayName == charName or data.CharacterName == charName then
                            baseFolder = child; break
                        end
                    end
                end
            end
        end
    end
    if baseFolder then scanFolder(baseFolder) end

    if skinName ~= "Default" then
        local skins = assets:FindFirstChild("Skins")
        local survSkins = skins and skins:FindFirstChild("Survivors")
        local charSkins = survSkins and survSkins:FindFirstChild(charName)
        local skinFolder = charSkins and charSkins:FindFirstChild(skinName)
        if skinFolder then scanFolder(skinFolder) end
    end
end

local function findNearestKiller()
    local char = LP.Character; if not char then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local myHRP = char:FindFirstChild("HumanoidRootPart"); if not myHRP then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") and k ~= char then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bd then bd = d; best = k end
            end
        end
    end
    return best
end

local function aimAtKiller(killer, duration)
    if IsPlayerKiller() then return end
    if not killer or not killer.Parent then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local killerHRP = killer:FindFirstChild("HumanoidRootPart")
    if not killerHRP then return end

    local savedAR = hum.AutoRotate
    hum.AutoRotate = false

    local startTime = tick()
    local dur = math.max(0.2, duration or SA.lockTime)
    local conn
    local released = false

    local function release()
        if released then return end
        released = true
        if conn then pcall(function() conn:Disconnect() end); conn = nil end
        if hum and hum.Parent then
            pcall(function() hum.AutoRotate = savedAR end)
        end
    end

    conn = RunService.RenderStepped:Connect(function()
        if IsPlayerKiller() then release(); return end
        if not char.Parent or not hrp.Parent or not hum.Parent then release(); return end
        if tick() - startTime > dur then release(); return end

        local curKillerHRP = killer and killer.Parent and killer:FindFirstChild("HumanoidRootPart")
        if not curKillerHRP then release(); return end

        local lead = (SA.prediction or 4) * 0.05
        local vel = getHRPVelocity(curKillerHRP)
        local targetPos = curKillerHRP.Position + vel * lead

        if SA.mode == "Character" or SA.mode == "Both" then
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
        end
        if SA.mode == "Camera" or SA.mode == "Both" then
            local cam = Workspace.CurrentCamera
            if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos) end
        end
    end)
end

local function fireSurvivorAim(animLength)
    if not SA.active or IsPlayerKiller() then return end
    local killer = findNearestKiller(); if not killer then return end
    local dur = math.max(0.3, (animLength or 0.5) + 0.1)
    task.spawn(function() aimAtKiller(killer, dur) end)
end

local function attachSurvivorWatcher(char)
    if not char then return end
    task.spawn(function()
        local start = tick()
        while tick() - start < 1.5 do
            if IsPlayerKiller() then break end
            local pf = Workspace:FindFirstChild("Players")
            local kf = pf and pf:FindFirstChild("Killers")
            local sf = pf and pf:FindFirstChild("Survivors")
            if (kf and char:IsDescendantOf(kf)) or (sf and char:IsDescendantOf(sf)) then break end
            task.wait(0.1)
        end

        if SA.animConn then pcall(function() SA.animConn:Disconnect() end); SA.animConn = nil end
        for _, c in ipairs(SA.soundConns) do pcall(function() c:Disconnect() end) end
        SA.soundConns = {}

        if IsPlayerKiller() then
            SURVIVOR_ANIM_IDS = {}
            SURVIVOR_SOUND_IDS = {}
            return
        end

        scanSurvivorAbilityAssets(char)

        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local animator = hum:WaitForChild("Animator", 5)

        if animator then
            SA.animConn = animator.AnimationPlayed:Connect(function(track)
                if not SA.active or IsPlayerKiller() then return end
                local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                if id and SURVIVOR_ANIM_IDS[id] then
                    fireSurvivorAim(track.Length)
                end
            end)
        end

        local function hookSound(s)
            if not s:IsA("Sound") then return end
            local conn = s.Played:Connect(function()
                if not SA.active or IsPlayerKiller() then return end
                local sid = tostring(s.SoundId):match("%d+")
                if sid and SURVIVOR_SOUND_IDS[sid] then
                    fireSurvivorAim(s.TimeLength or 0.5)
                end
            end)
            table.insert(SA.soundConns, conn)
        end

        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Sound") then hookSound(d) end
        end
        local descConn = char.DescendantAdded:Connect(function(d)
            if d:IsA("Sound") then hookSound(d) end
        end)
        table.insert(SA.soundConns, descConn)
    end)
end

