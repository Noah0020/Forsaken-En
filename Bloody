            local st = _ns_attrStates[killer]
            if not st then
                _ns_attrStates[killer] = { lastAbility = curAbilityLastUsed, lastUsed = curAbilitiesUsed, locked = false }
            else
                local abilityInc = (curAbilityLastUsed > st.lastAbility)
                local usedInc = (curAbilitiesUsed > st.lastUsed)
                if usedInc then st.locked = true end
                if abilityInc then
                    if st.locked then st.locked = false
                    else NS_makeHitboxAndCheck(killer, function() end) end
                end
                st.lastAbility = curAbilityLastUsed
                st.lastUsed = curAbilitiesUsed
            end
        end
    end
