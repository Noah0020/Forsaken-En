local function IsPlayerKiller()
    local c = LP.Character
    if not c then return false end
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if kf and c:IsDescendantOf(kf) then return true end
    return KILLER_NAMES[c:GetAttribute("CharacterName") or c.Name] == true
