local function onLocalAnimationPlayed(track)
    if not track then return end
    local animation = track.Animation
    local animId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")

    -- Auto Aim listens to the local survivor Animator. Resolve the animation
    -- type by name, then by the game's own animation-ID index.
    local abilityName, abilityKeyword = getAnimationAbilityName(track)
    local mappedM1Type = animId and m1AnimationTypeById[animId]
    local isNamedAttack = abilityKeyword ~= nil or getM1TypeFromConfigPath(
        tostring_ref(track.Name) .. " " .. tostring_ref(animation and animation.Name or "")
    ) ~= nil
    if punchAimEnabled then
        if abilityKeyword then
            local now = tick_ref()
            local debounceKey = animId or string.lower(tostring_ref(abilityName))
            local previous = lastPunchAimByAnimationId[debounceKey]
            if not previous or now - previous >= punchAimCooldown then
                lastPunchAimByAnimationId[debounceKey] = now
                local killer = getNearestKiller()
                if killer then snapPunchAim(killer) end
            end
        elseif aimDebugUnknownAnimations and animId and not loggedUnknownAimAnimations[animId] then
            loggedUnknownAimAnimations[animId] = true
            warn("[Bloodsaken Aim Tracker] Unmatched local animation ID: " .. animId
                .. " | track=" .. tostring_ref(track.Name)
                .. " | animation=" .. tostring_ref(animation and animation.Name or "?"))
        end
    end

    -- Guest Auto Aim is independent of the generic Aim-tab toggle and only
    -- runs for Guest when a recognised attack animation starts.
    if Settings.GuestAutoAimEnabled and Settings.IsLocalGuestCharacter(lp.Character)
        and (abilityKeyword or mappedM1Type or isNamedAttack) then
        local now = tick_ref()
        local debounceKey = "GuestAutoAim:" .. tostring_ref(animId or abilityName or track.Name)
        local previous = lastPunchAimByAnimationId[debounceKey]
        if not previous or now - previous >= punchAimCooldown then
            lastPunchAimByAnimationId[debounceKey] = now
            local killer = getNearestKiller()
            if killer then snapPunchAim(killer, true) end
        end
    end

end

local function bindAimAnimator(character)
    if aimAnimatorConnection then
        pcall(function() aimAnimatorConnection:Disconnect() end)
        aimAnimatorConnection = nil
    end
    character = character or lp.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5))
    if animator then aimAnimatorConnection = animator.AnimationPlayed:Connect(onLocalAnimationPlayed) end
end

-- Build the animation-ID index once, then listen to the local survivor Animator.
pcall(buildAimAnimationIdIndex)
if lp.Character then task.spawn(bindAimAnimator, lp.Character) end
lp.CharacterAdded:Connect(function(character)
    task.spawn(bindAimAnimator, character)
end)

local IntegratedAim = {}
do
-- ============================================================
-- HUNTER AIM (isolated from the legacy Aim tracker)
-- Extracted from the supplied HunterAim script and adapted to
-- Bloodsaken's UI. Sound detection uses Sound.Played (not Playing).
-- ============================================================
local HunterAim = {
    enabled = false,
    aimMode = "Camera",
    predictMode = "Both",
    velocityLead = 0.15,
    pingMultiplier = 1,
    smooth = 0.35,
    debug = false,
    animationIds = {},
    soundIds = {},
    soundConnections = {},
    hookedSounds = setmetatable({}, { __mode = "k" }),
    watchedSounds = setmetatable({}, { __mode = "k" }),
    animatorConnection = nil,
    characterConnection = nil,
    activeEvents = {},
    eventSerial = 0,
    currentAbility = nil,
    lastTarget = nil,
}

local HUNTER_ANIM_KEYS = {
    Slash = true, AimGun = true, GunFire = true, GunExplode = true,
    GunFail = true, Stab = true, LungeStart = true, Lunge = true,
}
local HUNTER_SOUND_KEYS = {
    Slash = true, GunFire = true, GunExplode = true, GunFail = true,
    Shoot = true, Stab = true, Lunge = true,
}
local HUNTER_PING_KEYS = { AimGun = true, GunFire = true, GunExplode = true, GunFail = true }
local HUNTER_SOUND_FIELDS = { "Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds" }

local function hunterPushIds(value, destination, abilityName)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring_ref(value):match("%d+")
        if id and not destination[id] then destination[id] = abilityName end
    elseif type(value) == "table" then
        for _, child in pairs(value) do hunterPushIds(child, destination, abilityName) end
    end
end

local function hunterReadConfig(module)
    if not module or not module:IsA("ModuleScript") then return end
    local ok, config = pcall(require, module)
    if not ok or type(config) ~= "table" then return end
    if type(config.Animations) == "table" then
        for key, value in pairs(config.Animations) do
            if HUNTER_ANIM_KEYS[key] then hunterPushIds(value, HunterAim.animationIds, key) end
        end
    end
    for _, field in ipairs(HUNTER_SOUND_FIELDS) do
        local soundTable = config[field]
        if type(soundTable) == "table" then
            for key, value in pairs(soundTable) do
                if HUNTER_SOUND_KEYS[key] then hunterPushIds(value, HunterAim.soundIds, key) end
            end
        end
    end
end

local function hunterLoadAbilityIds(character)
    table.clear(HunterAim.animationIds)
    table.clear(HunterAim.soundIds)
    local assets = ReplicatedStorage:FindFirstChild("Assets") or ReplicatedStorage:WaitForChild("Assets", 8)
    if not assets then
        warn("[Bloodsaken HunterAim] ReplicatedStorage.Assets was not found")
        return 0, 0
    end
    character = character or lp.Character
    if not character then return 0, 0 end
    local charName = character:GetAttribute("CharacterName") or character:GetAttribute("SurvivorName") or character.Name
    local skinName = character:GetAttribute("SkinName") or "Default"
    local survivorRoot = assets:FindFirstChild("Survivors")
    local survivorFolder = survivorRoot and survivorRoot:FindFirstChild(charName)
    local baseConfig = survivorFolder and survivorFolder:FindFirstChild("Config")
    hunterReadConfig(baseConfig)

    if skinName ~= "Default" then
        local skins = assets:FindFirstChild("Skins")
        local skinsSurvivors = skins and skins:FindFirstChild("Survivors")
        local skinCharacter = skinsSurvivors and skinsSurvivors:FindFirstChild(charName)
        local skinFolder = skinCharacter and skinCharacter:FindFirstChild(skinName)
        hunterReadConfig(skinFolder and skinFolder:FindFirstChild("Config"))
    end

    local animCount, soundCount = 0, 0
    for _ in pairs(HunterAim.animationIds) do animCount += 1 end
    for _ in pairs(HunterAim.soundIds) do soundCount += 1 end
    if HunterAim.debug then
        print(string.format("[Bloodsaken HunterAim] %s / %s: %d animations, %d sounds", tostring_ref(charName), tostring_ref(skinName), animCount, soundCount))
    end
    return animCount, soundCount
end

local function hunterIsSurvivor(character)
    character = character or lp.Character
    local playersFolder = Workspace:FindFirstChild("Players")
    local survivors = playersFolder and playersFolder:FindFirstChild("Survivors")
    return character ~= nil and survivors ~= nil and character.Parent == survivors
end

local function hunterRefreshCurrentAbility()
    local latest
    for _, event in pairs(HunterAim.activeEvents) do
        if not latest or event.started > latest.started then latest = event end
    end
    HunterAim.currentAbility = latest and latest.ability or nil
end

local function hunterEndEvent(token)
    if token then HunterAim.activeEvents[token] = nil end
    hunterRefreshCurrentAbility()
end

local function hunterBeginEvent(kind, id, abilityName, duration)
    HunterAim.eventSerial = HunterAim.eventSerial + 1
    local token = HunterAim.eventSerial
    HunterAim.activeEvents[token] = { kind = kind, id = id, ability = abilityName, started = os.clock() }
    HunterAim.currentAbility = abilityName
    if HunterAim.debug then
        print(string.format("[Bloodsaken HunterAim] %s start: %s (%s)", tostring_ref(kind), tostring_ref(abilityName), tostring_ref(id)))
    end
    task.delay(math.max(0.15, duration or 0.5), function()
        hunterEndEvent(token)
    end)
    return token
end

local function hunterGetPingSeconds()
    local ok, value = pcall(function() return lp:GetNetworkPing() end)
    if ok and type(value) == "number" then return math.clamp(value * 0.5, 0, 0.5) end
    local okStats, ms = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if okStats and type(ms) == "number" then return math.clamp(ms / 2000, 0, 0.5) end
    return 0
end

local function hunterPredictedPosition(root)
    if not root then return nil end
    if HunterAim.predictMode == "Off" then return root.Position end
    local velocity = root.AssemblyLinearVelocity
    if velocity.Magnitude > 200 then velocity = Vector3.zero end
    local velocityLead, pingLead = 0, 0
    if HunterAim.predictMode == "Velocity" or HunterAim.predictMode == "Both" then
        velocityLead = HunterAim.velocityLead
    end
    local ability = HunterAim.currentAbility
    if HUNTER_PING_KEYS[ability] and (HunterAim.predictMode == "Ping" or HunterAim.predictMode == "Both") then
        pingLead = math.clamp(hunterGetPingSeconds() * HunterAim.pingMultiplier, 0, 0.5)
    end
    return root.Position + velocity * math.clamp(velocityLead + pingLead, 0, 0.75)
end

local function hunterApplyAim(targetPosition)
    if not targetPosition then return end
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local smooth = math.clamp(HunterAim.smooth, 0.01, 1)
    if HunterAim.aimMode == "Character" or HunterAim.aimMode == "Character + Camera" then
        local flat = Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z)
        if (flat - root.Position).Magnitude > 0.05 then
            root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, flat), smooth)
        end
    end
    if HunterAim.aimMode == "Camera" or HunterAim.aimMode == "Character + Camera" then
        local camera = Workspace.CurrentCamera
        if camera then
            camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, targetPosition), smooth)
        end
    end
end

local function hunterWatchSound(sound)
    if not sound or not sound:IsA("Sound") or HunterAim.hookedSounds[sound]
        or HunterAim.watchedSounds[sound] then return end
    HunterAim.watchedSounds[sound] = true

    local function attachKnownSoundId()
        if HunterAim.hookedSounds[sound] then return end
        local id = tostring_ref(sound.SoundId):match("%d+")
        local ability = id and HunterAim.soundIds[id]
        if not ability then return end

        HunterAim.hookedSounds[sound] = true
        -- Sound.Playing is a boolean property. Played is the correct event signal.
        local connection = sound.Played:Connect(function()
            if not HunterAim.enabled or not hunterIsSurvivor(lp.Character) then return end
            local duration = sound.TimeLength
            if not duration or duration <= 0 then duration = 0.45 end
            hunterBeginEvent("sound", id, ability, math.min(duration + 0.12, 3))
        end)
        table.insert(HunterAim.soundConnections, connection)
    end

    attachKnownSoundId()
    -- Some game sounds are cloned before their SoundId is assigned.
    table.insert(HunterAim.soundConnections,
        sound:GetPropertyChangedSignal("SoundId"):Connect(attachKnownSoundId))
end

local function hunterDisconnectCharacter()
    if HunterAim.animatorConnection then pcall(function() HunterAim.animatorConnection:Disconnect() end) end
    HunterAim.animatorConnection = nil
    for _, connection in ipairs(HunterAim.soundConnections) do pcall(function() connection:Disconnect() end) end
    table.clear(HunterAim.soundConnections)
    HunterAim.hookedSounds = setmetatable({}, { __mode = "k" })
    HunterAim.watchedSounds = setmetatable({}, { __mode = "k" })
    HunterAim.activeEvents = {}
    HunterAim.currentAbility = nil
end

local function hunterBindCharacter(character)
    hunterDisconnectCharacter()
    if not character then return end
    hunterLoadAbilityIds(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5))
    if animator then
        HunterAim.animatorConnection = animator.AnimationPlayed:Connect(function(track)
            if not HunterAim.enabled or not hunterIsSurvivor(character) then return end
            local animation = track and track.Animation
            local id = animation and tostring_ref(animation.AnimationId):match("%d+")
            local ability = id and HunterAim.animationIds[id]
            if not ability then return end
            local duration = track.Length
            if not duration or duration <= 0 then duration = 0.55 end
            local eventToken = hunterBeginEvent("animation", id, ability, math.min(duration + 0.15, 3))
            local stopped = false
            local stopConnection
            local function finish()
                if stopped then return end
                stopped = true
                if stopConnection then pcall(function() stopConnection:Disconnect() end) end
                hunterEndEvent(eventToken)
            end
            stopConnection = track.Stopped:Connect(finish)
            task.delay(math.min(duration + 0.2, 3.2), finish)
        end)
    end
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Sound") then hunterWatchSound(descendant) end
