local _punchAnimIds = {
    ["87259391926321"]=true,["99100240941590"]=true,["72685103823181"]=true,["81905101227053"]=true,
    ["140703210927645"]=true,["136007065400978"]=true,["129843313690921"]=true,["86709774283672"]=true,
    ["108807732150251"]=true,["138040001965654"]=true,["86096387000557"]=true,["119850211147676"]=true,
