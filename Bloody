local NoliAim = { active=false, endTime=0, conn=nil, pathFolder=nil, segments={},
    waypoints={}, lastPathUpdate=0, lastRetarget=0, currentTarget=nil,
    smoothDir=nil, cameWithin=nil, savedWalkSpeed=nil }
local function NoliClearPath()
    for _, s in ipairs(NoliAim.segments) do if s and s.Parent then pcall(function() s:Destroy() end) end end
    NoliAim.segments = {}; NoliAim.waypoints = {}
end
local function NoliGetClosestSurvivor()
    local char = LP.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart"); if not myHRP then return nil end
    local sf = GetSurvivorsFolder(); if not sf then return nil end
    local best, bd = nil, Settings.Noli_MaxRange or 500
    for _, s in ipairs(sf:GetChildren()) do
        if s:IsA("Model") and s ~= char then
            local sHRP = s:FindFirstChild("HumanoidRootPart")
            local sHum = s:FindFirstChildOfClass("Humanoid")
            if sHRP and sHum and sHum.Health > 0 then
                local d = (sHRP.Position - myHRP.Position).Magnitude
                if d < bd then bd = d; best = s end
            end
        end
    end
    return best
end
local function NoliAimStop()
    if NoliAim.conn then pcall(function() NoliAim.conn:Disconnect() end); NoliAim.conn = nil end
    NoliClearPath()
    NoliAim.active = false; NoliAim.currentTarget = nil; NoliAim.smoothDir = nil
    local char = LP.Character; local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum:Move(Vector3.zero, false); hum.AutoRotate = true
            if NoliAim.savedWalkSpeed then hum.WalkSpeed = NoliAim.savedWalkSpeed end
        end)
    end
    NoliAim.savedWalkSpeed = nil
end
local function NoliTrigger()
    if not Settings.Noli_AIM_Enabled or not IsPlayerKiller() then return end
    local target = NoliGetClosestSurvivor(); if not target then return end
    if NoliAim.active then
        NoliAim.endTime = math.max(NoliAim.endTime, tick() + (Settings.Noli_AimDuration or 3.5))
        return
    end
    NoliAim.active = true
    NoliAim.endTime = tick() + (Settings.Noli_AimDuration or 3.5)
    NoliAim.lastPathUpdate = 0; NoliAim.lastRetarget = 0
    NoliAim.currentTarget = target; NoliAim.smoothDir = nil
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then NoliAim.savedWalkSpeed = hum.WalkSpeed end
    NoliAim.conn = RunService.RenderStepped:Connect(function(dt)
        if not NoliAim.active then return end
        if tick() >= NoliAim.endTime then NoliAimStop(); return end
        local char = LP.Character; if not char then NoliAimStop(); return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum2 = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum2 or hum2.Health <= 0 then NoliAimStop(); return end
        hum2.AutoRotate = false
        hum2.WalkSpeed = Settings.Noli_MoveSpeed or 45
        if tick() - NoliAim.lastRetarget > 0.2 then
            NoliAim.lastRetarget = tick()
            local tgt = NoliAim.currentTarget
            local tHum = tgt and tgt.Parent and tgt:FindFirstChildOfClass("Humanoid")
            if not tHum or tHum.Health <= 0 then
                local n = NoliGetClosestSurvivor()
                if n then NoliAim.currentTarget = n; NoliAim.smoothDir = nil; NoliAim.lastPathUpdate = 0 end
            end
        end
        local tgt = NoliAim.currentTarget
        local tHRP = tgt and tgt.Parent and tgt:FindFirstChild("HumanoidRootPart")
        if not tHRP then NoliAimStop(); return end
        local targetDir = tHRP.Position - hrp.Position
        targetDir = Vector3.new(targetDir.X, 0, targetDir.Z)
        if targetDir.Magnitude < 0.1 then return end
        targetDir = targetDir.Unit
        if not NoliAim.smoothDir then NoliAim.smoothDir = targetDir
        else
            local turn = Settings.Noli_TurnSmoothness or 10
            local alpha = 1 - math.exp(-dt * turn)
            NoliAim.smoothDir = NoliAim.smoothDir:Lerp(targetDir, alpha)
            if NoliAim.smoothDir.Magnitude > 0.01 then NoliAim.smoothDir = NoliAim.smoothDir.Unit end
        end
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + NoliAim.smoothDir) end)
        pcall(function() hum2:Move(NoliAim.smoothDir, false) end)
    end)
end

