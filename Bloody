local ABTP = {
    enabled=false, daggerEnabled=true, directBehind=false, predEnabled=false,
    rangeMode="Around", backstabType="lerp", defaultProximity=8, behindDist=1.7,
    lerpSpeed=0.37, delayBeforeStab=0.08, cooldown=5, predStrength=0.6, predTime=0.12,
    checkInterval=0.12, defaultDuration=0.35, lastTrigger=0,
}
task.spawn(function()
    while true do
        task.wait(ABTP.checkInterval)
        if not ABTP.enabled then continue end
        local char = LocalPlayer.Character
        if not char or not string.find(char.Name or "", "TwoTime") then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then continue end
        RefreshFolders(); if not KillersFolder then continue end
        for _, killer in pairs(KillersFolder:GetChildren()) do
            local khrp = killer:FindFirstChild("HumanoidRootPart"); if not khrp then continue end
            local dist = (khrp.Position - hrp.Position).Magnitude
            local should = false
            if ABTP.rangeMode == "Around" then
                should = dist <= ABTP.defaultProximity
            else
                local rel = hrp.Position - khrp.Position
                local fwdDot = rel:Dot(khrp.CFrame.LookVector)
                local behindDist = -fwdDot
                local angleDot = rel.Magnitude > 0 and rel.Unit:Dot(khrp.CFrame.LookVector) or 0
                local passed = ABTP.directBehind and angleDot <= -0.85 or fwdDot < 0.3
                should = passed and behindDist <= ABTP.defaultProximity and dist <= ABTP.defaultProximity
            end
            if should and os.clock() - ABTP.lastTrigger >= ABTP.cooldown then
                ABTP.lastTrigger = os.clock()
                task.spawn(function()
                    local targetPos = khrp.Position - khrp.CFrame.LookVector * ABTP.behindDist
                    if ABTP.predEnabled then
                        local hum = killer:FindFirstChildOfClass("Humanoid")
                        if hum and hum.MoveDirection.Magnitude > 0 then
                            targetPos = targetPos + hum.MoveDirection * ABTP.predStrength * 10 * ABTP.predTime
                        end
                    end
                    local t0 = os.clock()
                    local conn
                    conn = RunService.Heartbeat:Connect(function()
                        if os.clock()-t0 >= ABTP.defaultDuration then conn:Disconnect(); return end
                        if not khrp.Parent or not hrp.Parent then return end
                        if ABTP.backstabType == "teleport" then
                            hrp.CFrame = CFrame.new(targetPos, khrp.Position)
                        elseif ABTP.backstabType == "lerp" then
                            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(targetPos, khrp.Position), ABTP.lerpSpeed)
                        else
                            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + khrp.CFrame.LookVector)
                        end
                    end)
                    if ABTP.daggerEnabled then
                        task.wait(ABTP.delayBeforeStab)
                        FireAbility("Stab"); FireAbility("Backstab"); FireAbility("Dagger")
                    end
                end)
                break
            end
        end
    end
end)

