local rfDispatch = { hooks = {}, installed = false, originalCallback = nil }
function rfDispatch:register(id, cb) self.hooks[id] = cb end
function rfDispatch:unregister(id) self.hooks[id] = nil end
function rfDispatch:install(rf)
    if self.installed or not rf then return end
    if typeof(getcallbackvalue) == "function" then
        self.originalCallback = getcallbackvalue(rf, "OnClientInvoke")
    else
        self.originalCallback = rf.OnClientInvoke
    end
    rf.OnClientInvoke = function(name, ...)
        if name == "GetMousePosition" or name == "GetCameraCF" then
            for _, cb in pairs(self.hooks) do
                local ok, res = pcall(cb, name, ...)
                if ok and res ~= nil then return res end
            end
        end
        if self.originalCallback then
            local ok, res = pcall(self.originalCallback, name, ...)
            if ok then return res end
        end
    end
    self.installed = true
end
if NetworkRF then pcall(function() rfDispatch:install(NetworkRF) end) end

