local UtilitiesGroup = addGroup(Tabs.Utilities, "Left", "Syncsaken Utilities", "Imported utility controls", "wrench")
local UtilityRight = addGroup(Tabs.Utilities, "Right", "Device", "Client device presentation", "smartphone")
local noclipConnection
local noclipEnabled = false
local function setNoclip(enabled)
    noclipEnabled = enabled == true
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if noclipEnabled then
        noclipConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, name in ipairs({ "CollisionHitbox", "HumanoidRootPart", "Head" }) do
                local part = char:FindFirstChild(name)
                if part and part:IsA("BasePart") then part.CanCollide = false end
            end
        end)
    else
        local char = LocalPlayer.Character
        if char then
            for _, name in ipairs({ "CollisionHitbox", "HumanoidRootPart", "Head" }) do
                local part = char:FindFirstChild(name)
                if part and part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end
addToggle(UtilitiesGroup, "Syncsaken_Noclip", "Noclip", false, setNoclip)
addButton(UtilitiesGroup, "Infinite Yield", function()
    local source = game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source")
    local loader = loadstring(source)
    assert(type(loader) == "function", "Infinite Yield failed to compile")
    loader()
end)
