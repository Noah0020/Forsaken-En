local ZONE_OFF = 0.15; local DIA_H, CIR_H = 3, 1
local function GetZoneColor() return Color3.fromRGB(255, 60, 60) end
local function GetZoneReadyColor() return Color3.fromRGB(80, 255, 80) end
CustomZone = { running=false, connections={}, folder=nil, killerZones={} }
local function ComputeFootOff(k, kr)
    local names = { "LeftFoot", "RightFoot", "Left Leg", "Right Leg" }
    local low = nil
    for _, n in ipairs(names) do local p = k:FindFirstChild(n); if p and p:IsA("BasePart") then local b = p.Position.Y - p.Size.Y/2; if not low or b < low then low = b end end end
    return (low and (low - kr.Position.Y)) or -3
end
local function GetZoneBaseY(kr, z) return kr.Position.Y + (z.footOffsetY or -3) + ZONE_OFF end
local function GetFlatLook(kr, y)
    local lv = kr.CFrame.LookVector; local f = Vector3.new(lv.X, 0, lv.Z)
    if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    local p = Vector3.new(kr.Position.X, y, kr.Position.Z)
    return CFrame.lookAt(p, p + f)
end
local function BuildZone(k)
    local m = Instance.new("Model"); m.Name = "ABZone_"..k.Name; m.Parent = CustomZone.folder
    local kr = k:FindFirstChild("HumanoidRootPart"); local fo = (kr and ComputeFootOff(k, kr)) or -3
    local edges = {}
    for i = 1, 4 do
        local p = Instance.new("Part"); p.Name="Edge"..i; p.Anchored=true; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false; p.CastShadow=false
        p.Material=Enum.Material.Neon; p.Color=GetZoneColor(); p.Transparency=0.6; p.Size=Vector3.new(0.35, 0.08, 1); p.CFrame=CFrame.new(0,-5000,0); p.Parent = m
        edges[i] = p
    end
    local c = Instance.new("Part"); c.Shape=Enum.PartType.Cylinder; c.Name="Circle"; c.Anchored=true; c.CanCollide=false; c.CanQuery=false; c.CanTouch=false; c.CastShadow=false
    c.Material=Enum.Material.Neon; c.Color=GetZoneColor(); c.Transparency=0.7; c.Size=Vector3.new(CIR_H, 10, 10); c.CFrame=CFrame.new(0,-5000,0); c.Parent = m
    return { model=m, edges=edges, circle=c, killer=k, footOffsetY=fo }
end
local function IsInDiamond(myPos, kCF, kPos)
    local fwd = kCF.LookVector; local rgt = kCF.RightVector
    local ff = Vector3.new(fwd.X, 0, fwd.Z); local rr = Vector3.new(rgt.X, 0, rgt.Z)
    if ff.Magnitude < 0.01 or rr.Magnitude < 0.01 then return false end
    ff = ff.Unit; rr = rr.Unit
    local tp = Vector3.new(myPos.X - kPos.X, 0, myPos.Z - kPos.Z)
    local dF = tp:Dot(ff); local dR = tp:Dot(rr)
    local cd = Settings.CustomDiamondOffset + Settings.CustomDiamondLength/2
    local d = dF - cd
    local hw = Settings.CustomDiamondWidth/2 + PLAYER_R; local hl = Settings.CustomDiamondLength/2 + PLAYER_R
    local dY = math.abs(myPos.Y - kPos.Y); if dY > 10 + PLAYER_R then return false end
    return math.abs(dR)/hw + math.abs(d)/hl <= 1
end
local function IsInCircle(myPos, kPos)
    local dx = myPos.X - kPos.X; local dz = myPos.Z - kPos.Z
    local r = Settings.CustomCircleRadius + PLAYER_R
    if math.abs(myPos.Y - kPos.Y) > 10 + PLAYER_R then return false end
    return dx*dx + dz*dz <= r*r
end
function IsInCustomZone(k)
    if not k or not k.Parent then return false end
    local kr = k:FindFirstChild("HumanoidRootPart"); local c = LP.Character; local mr = c and c:FindFirstChild("HumanoidRootPart")
    if not kr or not mr then return false end
    return IsInDiamond(mr.Position, kr.CFrame, kr.Position) or IsInCircle(mr.Position, kr.Position)
end
local function UpdateZone(z, kr, mr)
    if not z or not z.model or not z.model.Parent or not kr or not kr.Parent then return end
    if KillerState.isKiller then
        for _, e in ipairs(z.edges) do if e and e.Parent then e.Transparency = 1 end end
        if z.circle and z.circle.Parent then z.circle.Transparency = 1 end
        return
    end
    local bY = GetZoneBaseY(kr, z); local dCF = GetFlatLook(kr, bY + DIA_H); local cCF = GetFlatLook(kr, bY + CIR_H)
    local off = Settings.CustomDiamondOffset; local L = Settings.CustomDiamondLength; local W = Settings.CustomDiamondWidth
    local wA = dCF:PointToWorldSpace(Vector3.new(0, 0, -off)); local wB = dCF:PointToWorldSpace(Vector3.new(0, 0, -(off + L)))
    local wC = dCF:PointToWorldSpace(Vector3.new(-W/2, 0, -(off + L/2))); local wD = dCF:PointToWorldSpace(Vector3.new(W/2, 0, -(off + L/2)))
    local specs = { {wA,wC}, {wA,wD}, {wB,wC}, {wB,wD} }
    for i, sp in ipairs(specs) do
        local p1, p2 = sp[1], sp[2]; local mid = (p1+p2)/2; local diff = p2-p1; local len = diff.Magnitude
        if len > 0.01 then local e = z.edges[i]; if e then e.Size = Vector3.new(0.35, 0.08, len); e.CFrame = CFrame.lookAt(mid, mid + diff.Unit); e.Transparency = (Settings.ShowDiamond and Settings.AutoBlockCustom) and 0.6 or 1 end end
    end
    if z.circle then
        local cc = Vector3.new(cCF.Position.X, cCF.Position.Y, cCF.Position.Z)
        z.circle.Size = Vector3.new(CIR_H, Settings.CustomCircleRadius*2, Settings.CustomCircleRadius*2)
        z.circle.CFrame = CFrame.new(cc) * CFrame.Angles(0, 0, math.rad(90))
        z.circle.Transparency = (Settings.ShowCircle and Settings.AutoBlockCustom) and 0.7 or 1
    end
    local inD = mr and IsInDiamond(mr.Position, kr.CFrame, kr.Position) or false
    local inC = mr and IsInCircle(mr.Position, kr.Position) or false
    local nc = GetZoneColor(); local rc = GetZoneReadyColor()
    for _, e in ipairs(z.edges) do if e and e.Parent then e.Color = inD and rc or nc end end
    if z.circle and z.circle.Parent then z.circle.Color = inC and rc or nc end
end
local function StartCustomZone()
    if CustomZone.running then return end
    CustomZone.running = true; CustomZone.connections = {}; CustomZone.killerZones = {}
    CustomZone.folder = Instance.new("Folder"); CustomZone.folder.Name = "ABZoneVisuals"; CustomZone.folder.Parent = Workspace
    table.insert(CustomZone.connections, RunService.RenderStepped:Connect(function()
        if not CustomZone.running or KillerState.isKiller then return end
        local kf = GetKillersFolder(); if not kf then return end
        local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") then
                local kr = k:FindFirstChild("HumanoidRootPart")
                if kr then
                    local z = CustomZone.killerZones[k]
                    if not z or not z.model or not z.model.Parent then
                        if z and z.model then pcall(function() z.model:Destroy() end) end
                        z = BuildZone(k); CustomZone.killerZones[k] = z
                    end
                    UpdateZone(z, kr, mr)
                end
            end
        end
        for k, z in pairs(CustomZone.killerZones) do
            if not k.Parent or not k:IsDescendantOf(Workspace) then
                if z.model then pcall(function() z.model:Destroy() end) end
                CustomZone.killerZones[k] = nil
            end
        end
    end))
end
local function StopCustomZone()
    if not CustomZone.running then return end
    CustomZone.running = false
    for _, c in ipairs(CustomZone.connections) do pcall(function() c:Disconnect() end) end
    CustomZone.connections = {}
    for _, z in pairs(CustomZone.killerZones) do if z.model then pcall(function() z.model:Destroy() end) end end
    CustomZone.killerZones = {}
    if CustomZone.folder then pcall(function() CustomZone.folder:Destroy() end); CustomZone.folder = nil end
end
function UpdateCustomZoneVisibility()
