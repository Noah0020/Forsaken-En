--═══════════════════════════════════════════════════════════
local BoxConfig = {
    BoxCount = 3,
    BoxLength = 5,
    BoxWidth = 5,
    MaxDistance = 25,
    TravelTime = 0.25,
    HeightOffset = 0.15,
    Transparency = 0.35,
    Color = Color3.fromRGB(255, 45, 45),
    ConnectedColor = Color3.fromRGB(50, 255, 120),
    ShowBoxes = true,
}

local BoxFolder = Instance.new("Folder")
BoxFolder.Name = "Ck_BlockBoxes"
BoxFolder.Parent = Workspace

local boxActive = false
local boxGeneration = 0
local AutoBlockEnabled = false

local function clearBoxes()
    for _, obj in ipairs(BoxFolder:GetChildren()) do pcall(function() obj:Destroy() end) end
end

local function getBoxZone(killerRoot, targetRoot)
    local offset = targetRoot.Position - killerRoot.Position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    if horizontal.Magnitude < 0.01 then return nil end
    local direction = horizontal.Unit
    local flatForward = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z)
    if flatForward.Magnitude < 0.01 then return nil end
    flatForward = flatForward.Unit
    local dot = flatForward:Dot(direction)
    if dot <= 0 then return nil end
    local right = killerRoot.CFrame.RightVector
    local side = right:Dot(direction)
    if side > 0.12 then return "FrontRight"
    elseif side < -0.12 then return "FrontLeft" end
    return "FrontCenter"
end

local function createBox()
    local box = Instance.new("Part")
    box.Name = "ConnectionSegment"
    box.Size = Vector3.new(BoxConfig.BoxWidth, 0.12, BoxConfig.BoxLength)
    box.Anchored = true
    box.CanCollide = false
    box.CanTouch = false
    box.CanQuery = false
    box.CastShadow = false
    box.Material = Enum.Material.Neon
    box.Color = BoxConfig.Color
    box.Transparency = BoxConfig.Transparency
    box.Parent = BoxFolder
    return box
end

-- Forward declaration
local fireBlock, HDT_Fire

local function startBoxConnection(killer)
    if not AutoBlockEnabled then return end
    if boxActive then return end
    if not killer or not killer.Parent then return end
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    local char = LP.Character
    local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not killerRoot or not targetRoot then return end
    local distance = (targetRoot.Position - killerRoot.Position).Magnitude
    if distance > BoxConfig.MaxDistance then return end
    local zone = getBoxZone(killerRoot, targetRoot)
    if not zone then return end
    local count = math.clamp(BoxConfig.BoxCount, 1, 5)
    if distance > count * BoxConfig.BoxLength then return end

    boxGeneration += 1
    local myGen = boxGeneration
    boxActive = true

    local boxes = {}
    if BoxConfig.ShowBoxes then
        for i = 1, count do boxes[i] = createBox() end
    end

    local startT = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if myGen ~= boxGeneration then conn:Disconnect(); return end
        if not killerRoot.Parent or not targetRoot.Parent then
            conn:Disconnect(); clearBoxes(); boxActive = false; return
        end
        local origin = killerRoot.Position
        local dest = targetRoot.Position
        local offset = dest - origin
        local currDist = offset.Magnitude
        if currDist > BoxConfig.MaxDistance or currDist > count * BoxConfig.BoxLength or not getBoxZone(killerRoot, targetRoot) then
            conn:Disconnect(); clearBoxes(); boxActive = false; return
        end
        local dir = Vector3.new(offset.X, 0, offset.Z)
        if dir.Magnitude < 0.001 then return end
        dir = dir.Unit
        local prog = math.clamp((os.clock() - startT) / BoxConfig.TravelTime, 0, 1)
        for i, box in ipairs(boxes) do
            if box.Parent then
                local alpha = (i - 0.5) / count
                local pos = origin:Lerp(dest, alpha * prog) + Vector3.new(0, BoxConfig.HeightOffset, 0)
                box.CFrame = CFrame.lookAt(pos, pos + dir)
            end
        end
        if prog >= 1 then
            for _, box in ipairs(boxes) do
                if box.Parent then box.Color = BoxConfig.ConnectedColor end
            end
            conn:Disconnect()
            -- CONNECTION CONFIRMED — fire block
            fireBlock()
            HDT_Fire(killer)
            task.delay(0.12, function()
                if myGen == boxGeneration then
                    clearBoxes()
                    boxActive = false
                end
            end)
        end
    end)
end

