MapESP = {}
function StartMapESP(key, matcher, color)
    if type(key) ~= "string" or type(matcher) ~= "function" then return end
    local current = MapESP[key]
    if current and current.running then
        current.setColor(color)
        return
    end

    local folder = Instance.new("Folder")
    folder.Name = "Doggysakne_ESP_" .. key
    folder.Parent = Workspace
    local tracked = setmetatable({}, {__mode="k"})
    local connections = {}
    local currentColor = color or Color3.fromRGB(244, 190, 62)
    local entry = {running=true, folder=folder, tracked=tracked, connections=connections}
    MapESP[key] = entry

    local function createHL(part)
        if not part or not part:IsA("BasePart") or not part.Parent or tracked[part] then return end
        local hl = Instance.new("Highlight")
        hl.Name = "DoggysakneMapESP"
        hl.Adornee = part
        hl.FillColor = currentColor
        hl.FillTransparency = 0.5
        hl.OutlineColor = currentColor
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = folder
        tracked[part] = hl

        local ancestryConn
        ancestryConn = part.AncestryChanged:Connect(function(_, parent)
            if parent == nil then
                if ancestryConn and ancestryConn.Connected then ancestryConn:Disconnect() end
                connections[ancestryConn] = nil
                if hl and hl.Parent then hl:Destroy() end
                tracked[part] = nil
            end
        end)
        connections[ancestryConn] = true
    end

    local function check(object)
        if not entry.running or not object or not object.Parent then return end
        local ok, part = pcall(matcher, object)
        if ok and part then createHL(part) end
    end

    entry.setColor = function(nextColor)
        if typeof(nextColor) ~= "Color3" then return end
        currentColor = nextColor
        for _, hl in pairs(tracked) do
            if hl and hl.Parent then
                hl.FillColor = nextColor
                hl.OutlineColor = nextColor
            end
        end
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        pcall(check, object)
    end
    entry.addedConnection = Workspace.DescendantAdded:Connect(function(object)
        task.defer(function() pcall(check, object) end)
    end)
end
function StopMapESP(key)
    local entry = MapESP[key]
    if not entry then return end
    entry.running = false
    if entry.addedConnection then pcall(function() entry.addedConnection:Disconnect() end) end
    for connection in pairs(entry.connections or {}) do
        if connection and connection.Connected then pcall(function() connection:Disconnect() end) end
    end
    if entry.folder then pcall(function() entry.folder:Destroy() end) end
    MapESP[key] = nil
