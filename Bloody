local function abIsFacing(myRoot, kHRP)
    if not AB.verifyFacing then return true end
    if not myRoot or not kHRP then return false end
    local dir = myRoot.Position - kHRP.Position
    local dSq = dir.Magnitude ^ 2
    if dSq < 0.0001 then return true end
    if dSq < 25 then return true end
    return kHRP.CFrame.LookVector:Dot(dir.Unit) >= math.cos(math.rad(AB.visionAngle / 2))
end
local function abAttributeHeartbeat()
    if not AB.running or not AB.attributeBlockOn or IsPlayerKiller() then return end
    local kf = GetKillersFolder(); if not kf then return end
    local myRoot = getHRP(); if not myRoot then return end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local dist = (kr.Position - myRoot.Position).Magnitude
                if dist <= AB.detectionRange and abIsFacing(myRoot, kr) then
                    local alu = k:GetAttribute("AbilityLastUsed") or 0
                    local au = k:GetAttribute("AbilitiesUsed") or 0
                    local st = AB.attrStates[k]
                    if st then
                        local inc = alu > st.lastAbility
                        if au > st.lastUsed then st.isBait = true end
                        if inc then
                            local n = tick()
                            if st.castLockUntil and n < st.castLockUntil then
                                st.lastAbility = alu; st.lastUsed = au
                            else
                                if st.isBait then st.isBait = false
                                else
                                    st.castLockUntil = n + 0.1
                                    if Rectangle and Rectangle.m1FlashUntil then
                                        Rectangle.m1FlashUntil[k] = n + (Settings.RectDuration or 0.3)
                                    end
                                    if n - AB.attrDebounce >= (Settings.AB_Debounce or 0.08) then
                                        AB.attrDebounce = n
                                        abDoBlock()
                                    end
                                end
                                st.lastAbility = alu; st.lastUsed = au
                            end
                        else
                            st.lastAbility = alu; st.lastUsed = au
                        end
                    else
                        AB.attrStates[k] = { lastAbility=alu, lastUsed=au, isBait=false, castLockUntil=0 }
                    end
                end
            end
        end
    end
end
