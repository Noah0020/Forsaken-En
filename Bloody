local function Killer_TryDodge()
    if not KillerF.AutoDodge or not IsPlayerKiller() then return end
    local now = tick()
    if now - (KillerF.lastDodge or 0) < (KillerF.DodgeCooldown or 0.8) then return end
    local char = LP.Character
