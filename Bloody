MinigameSolver.Available = FlowBoardModule ~= nil and LockBoardModule ~= nil
    and FlowInputModule ~= nil and GearInputModule ~= nil
    and LockInputModule ~= nil and ConnectInputModule ~= nil
local function solverDelay() return math.max(0, Config_Gen.ActionDelay or 0.05) end
local function connectSolverDelay() return math.max(0, Config_Gen.ConnectDelay or 1) end
local function gearSolverDelay() return math.max(0, Config_Gen.GearDelay or 0.03) end
local function solverIsEnabled() return MinigameSolver.Enabled end
local function stillSolving(_, obj) return solverIsEnabled() and obj and not obj.Ended end
local function waitForSolver(obj, token)
    while obj and not obj.Ended and not solverIsEnabled() and MinigameSolver.Generation == token do task.wait(0.05) end
    if not (obj and not obj.Ended and solverIsEnabled()) or MinigameSolver.Generation ~= token then return false end
    local started = os.clock()
    while obj and not obj.Ended and solverIsEnabled() and MinigameSolver.Generation == token
          and os.clock() - started < (Config_Gen.StartDelay or 1.5) do task.wait(0.05) end
    return obj and not obj.Ended and solverIsEnabled() and MinigameSolver.Generation == token
end
local function solveFlowBoard(board)
    local size, pairMap = board.Size, board.Pairs
    local occupied, answer = {}, {}
    local directions = { {-1,0},{1,0},{0,-1},{0,1} }
    local endpointOwner = {}
    for color, pair in pairs(pairMap) do endpointOwner[pair[1]], endpointOwner[pair[2]] = color, color end
    local remaining = {}
    for color in pairs(pairMap) do table.insert(remaining, color) end
    local function candidates(color, limit)
        local pair = pairMap[color]; local from, target = pair[1], pair[2]
        local results, path, seen = {}, {from}, {[from] = true}
        local function distance(cell)
            local r, c = FlowBoardModule.ToRowCol(size, cell)
            local tr, tc = FlowBoardModule.ToRowCol(size, target)
            return math.abs(r - tr) + math.abs(c - tc)
        end
        local function walk(cell)
            if #results >= limit then return end
            if cell == target then table.insert(results, table.clone(path)); return end
            local row, col = FlowBoardModule.ToRowCol(size, cell)
            local nextCells = {}
            for _, d in ipairs(directions) do
                local nr, nc = row + d[1], col + d[2]
                if nr >= 1 and nr <= size and nc >= 1 and nc <= size then
                    local n = FlowBoardModule.ToIndex(size, nr, nc)
                    local owner = endpointOwner[n]
                    if not seen[n] and not occupied[n] and (not owner or (owner == color and n == target)) then
                        table.insert(nextCells, n)
                    end
                end
            end
            table.sort(nextCells, function(a, b) return distance(a) < distance(b) end)
            for _, n in ipairs(nextCells) do
                seen[n] = true; table.insert(path, n); walk(n)
                path[#path] = nil; seen[n] = nil
                if #results >= limit then break end
            end
        end
        walk(from)
        table.sort(results, function(a, b) return #a < #b end)
        return results
    end
    local function search(colors)
        if #colors == 0 then return true end
        local bestIndex, bestPaths
        for i, color in ipairs(colors) do
            local list = candidates(color, 300)
            if #list == 0 then return false end
            if not bestPaths or #list < #bestPaths then bestIndex, bestPaths = i, list end
        end
        local color = colors[bestIndex]
        local nextColors = table.clone(colors)
        table.remove(nextColors, bestIndex)
        for _, path in ipairs(bestPaths) do
            for _, cell in ipairs(path) do occupied[cell] = true end
            answer[color] = path
            if search(nextColors) then return true end
            answer[color] = nil
            for _, cell in ipairs(path) do occupied[cell] = nil end
        end
        return false
    end
    return search(remaining) and answer or nil
end
local function installMinigameHooks()
    if MinigameSolver.Installed then return end
    if not MinigameSolver.Available then return end
    MinigameSolver.Installed = true
    MinigameSolver.Originals.LockBoard    = LockBoardModule.new
    MinigameSolver.Originals.FlowInput    = FlowInputModule.new
    MinigameSolver.Originals.ConnectInput = ConnectInputModule.new
    MinigameSolver.Originals.GearInput    = GearInputModule.new
    MinigameSolver.Originals.LockInput    = LockInputModule.new
    local oldLockBoardNew = LockBoardModule.new
    LockBoardModule.new = function(...)
        local board = oldLockBoardNew(...); MinigameSolver.LockBoard = board; return board
    end
    local oldFlowNew = FlowInputModule.new
    FlowInputModule.new = function(board, renderer, callbacks)
        local obj = oldFlowNew(board, renderer, callbacks)
        local token = MinigameSolver.Generation
        task.spawn(function()
            if not waitForSolver(obj, token) then return end
            task.wait(solverDelay())
            local paths = solveFlowBoard(board)
            if not paths then warn("[Cupcake] Flow: no solution"); return end
            for color, path in pairs(paths) do
                if not stillSolving(token, obj) then return end
                local drawing = board:Begin(path[1])
                renderer:Render(); task.wait(solverDelay())
                for i = 2, #path do
                    if not stillSolving(token, obj) then return end
                    board:Step(drawing, path[i], 0); renderer:Render(); task.wait(solverDelay())
                end
                board:Release(drawing, true); renderer:Render(); task.wait(solverDelay())
            end
            if stillSolving(token, obj) and board:IsSolved() then obj:__finish(); callbacks.OnSolved() end
        end)
        return obj
    end
    local oldConnectNew = ConnectInputModule.new
    ConnectInputModule.new = function(board, renderer, callbacks)
        local obj = oldConnectNew(board, renderer, callbacks)
        local token = MinigameSolver.Generation
        task.spawn(function()
            if not waitForSolver(obj, token) then return end
            task.wait(connectSolverDelay())
            for blob in pairs(board.Blobs) do
                if not stillSolving(token, obj) then return end
                if not board:GetLink(blob) then
                    local mate = board:GetMate(blob)
                    if mate then board:Connect(blob, mate); renderer:Render(); task.wait(connectSolverDelay()) end
                end
            end
            if stillSolving(token, obj) and board:IsSolved() then obj:__finish(); callbacks.OnSolved() end
        end)
        return obj
    end
    local oldGearNew = GearInputModule.new
    GearInputModule.new = function(getCenter, callbacks, enabled)
        local obj = oldGearNew(getCenter, callbacks, enabled)
        local token = MinigameSolver.Generation
        task.spawn(function()
            if not waitForSolver(obj, token) then return end
            task.wait(math.max(0.55, solverDelay()))
            for _ = 1, 100 do
                if not stillSolving(token, obj) then return end
                callbacks.OnTurn(90); task.wait(gearSolverDelay())
            end
        end)
        return obj
    end
    local oldLockNew = LockInputModule.new
    LockInputModule.new = function(ui, callbacks)
        local obj = oldLockNew(ui, callbacks)
        local board = MinigameSolver.LockBoard
        local token = MinigameSolver.Generation
        task.spawn(function()
            if not waitForSolver(obj, token) then return end
            while stillSolving(token, obj) and board and not board:IsBroken() do
                local now = workspace:GetServerTimeNow()
                if board:IsOnTarget(board:AngleAt(now)) then
                    callbacks.OnPress(); task.wait(math.max(0.08, solverDelay()))
                else
                    RunService.Heartbeat:Wait()
                end
            end
        end)
        return obj
    end
end
pcall(installMinigameHooks)
local function uninstallMinigameHooks()
    if not MinigameSolver.Installed then return end
    if MinigameSolver.Originals.LockBoard then pcall(function() LockBoardModule.new = MinigameSolver.Originals.LockBoard end) end
    if MinigameSolver.Originals.FlowInput then pcall(function() FlowInputModule.new = MinigameSolver.Originals.FlowInput end) end
    if MinigameSolver.Originals.ConnectInput then pcall(function() ConnectInputModule.new = MinigameSolver.Originals.ConnectInput end) end
    if MinigameSolver.Originals.GearInput then pcall(function() GearInputModule.new = MinigameSolver.Originals.GearInput end) end
    if MinigameSolver.Originals.LockInput then pcall(function() LockInputModule.new = MinigameSolver.Originals.LockInput end) end
    MinigameSolver.Originals = {}
    MinigameSolver.Installed = false
    MinigameSolver.Generation += 1
    MinigameSolver.Enabled = false
    MinigameSolver.ManualEnabled = false
end
