local CFG = "GoldenHub_Config.json"

local function saveConfig()
    local ok = pcall(function()
        if typeof(writefile) ~= "function" then error("no writefile") end
        local data = {
            ESP = ESP, Stam = { Inf = Stam.Inf, Edit = Stam.Edit, Min = Stam.Min, Max = Stam.Max, Loss = Stam.Loss, Gain = Stam.Gain },
            AB = AB, Aim = { Distance = Aim.Distance, Duration = Aim.Duration, Prediction = Aim.Prediction, CamLock = Aim.CamLock },
            ABTP = ABTP, Vee = Vee, Util = { FOV = Util.FOV },
        }
        writefile(CFG, HttpService:JSONEncode(data))
    end)
    Notify("Config", ok and "Saved" or "Failed")
end

local function loadConfig()
    local ok, data = pcall(function()
        if typeof(readfile) ~= "function" then error("no readfile") end
        return HttpService:JSONDecode(readfile(CFG))
    end)
    if ok and data then
        if data.ESP then for k, v in pairs(data.ESP) do if ESP[k] ~= nil then ESP[k] = v end end end
        if data.AB then for k, v in pairs(data.AB) do if AB[k] ~= nil then AB[k] = v end end end
        if data.Aim then for k, v in pairs(data.Aim) do if Aim[k] ~= nil then Aim[k] = v end end end
        if data.ABTP then for k, v in pairs(data.ABTP) do if ABTP[k] ~= nil then ABTP[k] = v end end end
        if data.Vee then for k, v in pairs(data.Vee) do if Vee[k] ~= nil then Vee[k] = v end end end
        Notify("Config", "Loaded")
    else
        Notify("Config", "Failed")
    end
end

