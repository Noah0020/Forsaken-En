                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = true end
            end
        end,
    })
    left:AddDropdown("Aim_Pick", {
        Text = "Pick Aimbots",
        Values = { "Guest1337", "Shedlekey", "TwoTime", "Chance", "JaneDoe" },
        Default = { "Guest1337", "Shedlekey", "TwoTime" },
        Multi = true,
        Callback = function(sel)
            for k, cfg in pairs(getgenv().AimbotValues) do cfg.Enabled = false end
            if type(sel) == "table" then
                -- handle both list and map forms
                for k, v in pairs(sel) do
                    if v == true and type(k) == "string" and getgenv().AimbotValues[k] then
                        getgenv().AimbotValues[k].Enabled = true
                    elseif type(v) == "string" and getgenv().AimbotValues[v] then
                        getgenv().AimbotValues[v].Enabled = true
                    end
                end
            end
        end,
    })
    left:AddDropdown("Aim_Mode", {
        Text = "Aimlock Mode",
        Values = { "Character Lock", "Char + Cam Lock" },
        Default = 1,
        Callback = function(v) getgenv().GlobalAimlockMode = v end,
    })
    left:AddLabel("Locks when your ability animation plays (Guesting style).", true)

    local function addSurv(key, title, dd, dp)
        local box = Tabs.Aimbot:AddRightGroupbox(title)
        box:AddSlider(key .. "_Dur", {
            Text = "Duration", Default = dd, Min = 0.1, Max = 3, Rounding = 2,
