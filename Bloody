--═══════════════════════════════════════════════════════════════════
-- GENERATOR SOLVER (unchanged from v2.2)
--═══════════════════════════════════════════════════════════════════
local GS = { installed=false, generation=0, lockBoard=nil }
local GSM = {}
local function gs_safeRequire(path) if not path then return nil end; local ok, r = pcall(require, path); return ok and r or nil end
local function gs_loadModules()
    if GSM.flow and GSM.gear and GSM.connect and GSM.lock and GSM.flowBoard and GSM.lockBoard then return true end
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local playerMod = systems and systems:FindFirstChild("Player")
    local gameMod = playerMod and playerMod:FindFirstChild("Game")
    local miniFolder = gameMod and gameMod:FindFirstChild("Minigames")
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local miniMods = mods and mods:FindFirstChild("Minigames")
    if not miniFolder or not miniMods then return false end
    GSM.flow = gs_safeRequire(miniFolder:FindFirstChild("FlowClientMinigame") and miniFolder.FlowClientMinigame:FindFirstChild("FlowInput"))
    GSM.gear = gs_safeRequire(miniFolder:FindFirstChild("GearClientMinigame") and miniFolder.GearClientMinigame:FindFirstChild("GearInput"))
    GSM.connect = gs_safeRequire(miniFolder:FindFirstChild("ConnectClientMinigame") and miniFolder.ConnectClientMinigame:FindFirstChild("ConnectInput"))
    GSM.lock = gs_safeRequire(miniFolder:FindFirstChild("LockClientMinigame") and miniFolder.LockClientMinigame:FindFirstChild("LockInput"))
    GSM.flowBoard = gs_safeRequire(miniMods:FindFirstChild("FlowBoard"))
    GSM.lockBoard = gs_safeRequire(miniMods:FindFirstChild("LockBoard"))
    return GSM.flow and GSM.gear and GSM.connect and GSM.lock and GSM.flowBoard and GSM.lockBoard
end
local function gs_isEnabled() return Settings.GS_Enabled end
local function gs_stillSolving(o) return gs_isEnabled() and o and not o.Ended end
local function gs_waitForSolver(o)
    while o and not o.Ended and not gs_isEnabled() do task.wait(0.05) end
    if not (o and not o.Ended and gs_isEnabled()) then return false end
    local st = os.clock()
    while o and not o.Ended and gs_isEnabled() and os.clock() - st < Settings.GS_StartDelay do task.wait(0.05) end
    return o and not o.Ended and gs_isEnabled()
end
local function gs_solveFlow(board, FBM)
    local size, pairMap = board.Size, board.Pairs
    local occ, ans = {}, {}
    local dirs = {{-1,0},{1,0},{0,-1},{0,1}}
    local owner = {}
    for c, p in pairs(pairMap) do owner[p[1]], owner[p[2]] = c, c end
    local rem = {}
    for c in pairs(pairMap) do table.insert(rem, c) end
    local function cands(color, limit)
        local pair = pairMap[color]; local from, target = pair[1], pair[2]
        local res, path, seen = {}, {from}, {[from]=true}
        local function dist(cell)
            local r, cc = FBM.ToRowCol(size, cell)
            local tr, tc = FBM.ToRowCol(size, target)
            return math.abs(r-tr) + math.abs(cc-tc)
        end
        local function walk(cell)
            if #res >= limit then return end
            if cell == target then table.insert(res, table.clone(path)); return end
            local r, cc = FBM.ToRowCol(size, cell)
            local nc = {}
            for _, d in ipairs(dirs) do
                local nr, ncc = r+d[1], cc+d[2]
                if nr>=1 and nr<=size and ncc>=1 and ncc<=size then
                    local n = FBM.ToIndex(size, nr, ncc)
                    local o = owner[n]
                    if not seen[n] and not occ[n] and (not o or (o==color and n==target)) then
                        table.insert(nc, n)
                    end
                end
            end
            table.sort(nc, function(a,b) return dist(a) < dist(b) end)
            for _, n in ipairs(nc) do
                seen[n] = true; table.insert(path, n); walk(n)
                path[#path] = nil; seen[n] = nil
                if #res >= limit then break end
            end
        end
        walk(from)
        table.sort(res, function(a,b) return #a < #b end)
        return res
    end
    local function search(colors)
        if #colors == 0 then return true end
        local bi, bp
        for i, c in ipairs(colors) do
            local l = cands(c, 300)
            if #l == 0 then return false end
            if not bp or #l < #bp then bi, bp = i, l end
        end
        local color = colors[bi]
        local nc = table.clone(colors); table.remove(nc, bi)
        for _, p in ipairs(bp) do
            for _, cc in ipairs(p) do occ[cc] = true end
            ans[color] = p
            if search(nc) then return true end
            ans[color] = nil
            for _, cc in ipairs(p) do occ[cc] = nil end
        end
        return false
    end
    return search(rem) and ans or nil
end
local function gs_install()
    if GS.installed then return true end
    if not gs_loadModules() then return false end
    GS.installed = true
    local oLB = GSM.lockBoard.new
    GSM.lockBoard.new = function(...) local b = oLB(...); GS.lockBoard = b; return b end
    local oF = GSM.flow.new
    GSM.flow.new = function(board, renderer, callbacks)
        local o = oF(board, renderer, callbacks)
        task.spawn(function()
            if not gs_waitForSolver(o) then return end
            task.wait(Settings.GS_FlowDelay)
            local paths = gs_solveFlow(board, GSM.flowBoard); if not paths then return end
            for color, path in pairs(paths) do
                if not gs_stillSolving(o) then return end
                local dr = board:Begin(path[1]); renderer:Render(); task.wait(Settings.GS_FlowDelay)
                for i = 2, #path do
                    if not gs_stillSolving(o) then return end
                    board:Step(dr, path[i], 0); renderer:Render(); task.wait(Settings.GS_FlowDelay)
                end
                board:Release(dr, true); renderer:Render(); task.wait(Settings.GS_FlowDelay)
            end
            if gs_stillSolving(o) and board:IsSolved() then o:__finish(); callbacks.OnSolved() end
        end)
        return o
    end
    local oC = GSM.connect.new
    GSM.connect.new = function(board, renderer, callbacks)
        local o = oC(board, renderer, callbacks)
        task.spawn(function()
            if not gs_waitForSolver(o) then return end
            task.wait(Settings.GS_ConnectDelay)
            for blob in pairs(board.Blobs) do
                if not gs_stillSolving(o) then return end
                if not board:GetLink(blob) then
                    local mate = board:GetMate(blob)
                    if mate then board:Connect(blob, mate); renderer:Render(); task.wait(Settings.GS_ConnectDelay) end
                end
            end
            if gs_stillSolving(o) and board:IsSolved() then o:__finish(); callbacks.OnSolved() end
        end)
        return o
    end
    local oG = GSM.gear.new
    GSM.gear.new = function(center, callbacks, en)
        local o = oG(center, callbacks, en)
        task.spawn(function()
            if not gs_waitForSolver(o) then return end
            task.wait(math.max(0.55, Settings.GS_FlowDelay))
            for _ = 1, 100 do
                if not gs_stillSolving(o) then return end
                callbacks.OnTurn(90); task.wait(Settings.GS_GearDelay)
            end
        end)
        return o
    end
    local oL = GSM.lock.new
    GSM.lock.new = function(ui, callbacks)
        local o = oL(ui, callbacks)
        task.spawn(function()
            if not gs_waitForSolver(o) then return end
            while gs_stillSolving(o) and GS.lockBoard and not GS.lockBoard:IsBroken() do
                local now = Workspace:GetServerTimeNow()
                if GS.lockBoard:IsOnTarget(GS.lockBoard:AngleAt(now)) then
                    callbacks.OnPress(); task.wait(math.max(Settings.GS_LockDelay, Settings.GS_FlowDelay))
                else RunService.Heartbeat:Wait() end
            end
        end)
        return o
    end
    return true
end
local function GS_Enable() if not gs_install() then return false end; Settings.GS_Enabled = true; GS.generation += 1; return true end
local function GS_Disable() Settings.GS_Enabled = false; GS.generation += 1 end

