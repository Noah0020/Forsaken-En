--═══════════════════════════════════════════════════════════════════
-- PREDICTION (Chance's smoothed velocity + turn compensation)
--═══════════════════════════════════════════════════════════════════
local _velHistoryByHrp = setmetatable({}, {__mode = "k"})
local PRED_MIN, PRED_MAX = 2, 3

local function smoothedVelocity(hrp)
    if not hrp then return Vector3.zero end
    local v = hrp.AssemblyLinearVelocity
    local hist = _velHistoryByHrp[hrp]
    if not hist then hist = {}; _velHistoryByHrp[hrp] = hist end
    table.insert(hist, v)
    if #hist > 10 then table.remove(hist, 1) end
    local sum = Vector3.zero
    for i = 1, #hist do sum = sum + hist[i] end
    return sum / math.max(#hist, 1)
end

local function PredictPosition(hrp)
    if not hrp then return nil end
    local pos = hrp.Position
    local vel = smoothedVelocity(hrp)
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local speed = horiz.Magnitude
    if speed < 1.2 then return pos end
    local slider = math.clamp(Settings.AIM_Prediction or 4, 1, 10)
    local mul = slider / 4
    local lead = (PRED_MIN + (PRED_MAX - PRED_MIN) * math.clamp(speed / 28, 0, 1)) * mul
    local hist = _velHistoryByHrp[hrp]
    if hist and #hist >= 3 then
        local a = hist[#hist - 2]
        local b = hist[#hist]
        local ah = Vector3.new(a.X, 0, a.Z)
        local bh = Vector3.new(b.X, 0, b.Z)
        if ah.Magnitude > 2 and bh.Magnitude > 2 and ah.Unit:Dot(bh.Unit) < 0.45 then
            lead = lead + 0.9 * mul
        end
    end
    return pos + horiz.Unit * lead
end

local function GetNearestKillerHrp()
    local char = LP.Character; if not char then return nil end
    local kf = GetKillersFolder(); if not kf then return nil end
    local myHrp = char:FindFirstChild("HumanoidRootPart"); if not myHrp then return nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") then
            local mHrp = m:FindFirstChild("HumanoidRootPart")
            local mHum = m:FindFirstChildOfClass("Humanoid")
            if mHrp and mHum and mHum.Health > 0 then
                local d = (mHrp.Position - myHrp.Position).Magnitude
                if d < bestD then bestD = d; best = mHrp end
            end
        end
    end
    return best
end

