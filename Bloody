local Remote
pcall(function() Remote = ReplicatedStorage.Modules.Network.Network:WaitForChild("RemoteEvent", 8) end)
local function getRemote()
    if Remote and Remote.Parent then return Remote end
    pcall(function() Remote = ReplicatedStorage.Modules.Network.Network.RemoteEvent end)
    return Remote
end
local function FireAbility(name)
    local r = getRemote(); if not r then return end
    pcall(function() r:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0" .. name) }) end)
end
local function FireBlock() FireAbility("Block") end
local function FirePunch()
    local r = getRemote(); if not r then return end
    pcall(function() r:FireServer("UseActorAbility", { "Punch" }) end)
end
local function extractId(s) return s and tostring(s):match("%d+") end

local function nearestKiller(maxD)
    if not LocalRoot or not KillersFolder then return nil end
    local best, bd = nil, maxD or 50
    for _, m in ipairs(KillersFolder:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart")
        local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - LocalRoot.Position).Magnitude
            if d < bd then bd = d; best = m end
        end
    end
    return best
end

local function aimAtKiller(kr, duration)
    if not LocalRoot or not kr then return end
    duration = duration or 0.2
    local t0 = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if os.clock() - t0 > duration or not LocalRoot or not kr.Parent then
            if conn then conn:Disconnect() end; return
        end
        local pos = kr.Position
        LocalRoot.CFrame = CFrame.lookAt(LocalRoot.Position, Vector3.new(pos.X, LocalRoot.Position.Y, pos.Z))
    end)
end


