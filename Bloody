-- FIX 1: No Shadows / No Fog act independently of Fullbright
_G.Fullbright   = false
_G.NoShadows    = false
_G.NoFog        = false
local bright    = 0

local LightOrig = {
    Brightness=nil, GlobalShadows=nil, OutdoorAmbient=nil,
    FogStart=nil, FogEnd=nil, Atmosphere=nil, AtmosphereDensity=nil,
}
local function captureLighting()
    if LightOrig.Brightness ~= nil then return end
    pcall(function()
        LightOrig.Brightness     = Lighting.Brightness
        LightOrig.GlobalShadows  = Lighting.GlobalShadows
        LightOrig.OutdoorAmbient = Lighting.OutdoorAmbient
        LightOrig.FogStart       = Lighting.FogStart
        LightOrig.FogEnd         = Lighting.FogEnd
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            LightOrig.Atmosphere        = atm
            LightOrig.AtmosphereDensity = atm.Density
        end
    end)
end
local function applyFullbright()
    captureLighting()
    pcall(function()
        if _G.Fullbright then
            Lighting.OutdoorAmbient = Color3.new(1,1,1)
            Lighting.Brightness     = bright
        else
            if LightOrig.OutdoorAmbient then Lighting.OutdoorAmbient = LightOrig.OutdoorAmbient end
            if LightOrig.Brightness     then Lighting.Brightness     = LightOrig.Brightness     end
        end
    end)
end
local function applyShadows()
    captureLighting()
    pcall(function()
        if _G.NoShadows then
            Lighting.GlobalShadows = false
        elseif LightOrig.GlobalShadows ~= nil then
            Lighting.GlobalShadows = LightOrig.GlobalShadows
        end
    end)
end
local function applyFog()
    captureLighting()
    pcall(function()
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if _G.NoFog then
            Lighting.FogStart = 0
            Lighting.FogEnd   = 1e9
            if atm then atm.Density = 0 end
        else
            if LightOrig.FogStart ~= nil then Lighting.FogStart = LightOrig.FogStart end
            if LightOrig.FogEnd   ~= nil then Lighting.FogEnd   = LightOrig.FogEnd   end
