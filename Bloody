    local t = Tabs.Box:AddRightGroupbox("Debug")
    t:AddButton({ Text = "Force Show on Nearest Killer", Func = function()
        local kf = GetKillersFolder()
        if not kf then return end
        local best, bd = nil, math.huge
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        for _, k in ipairs(kf:GetChildren()) do
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local d = (kr.Position - root.Position).Magnitude
                if d < bd then bd = d; best = k end
            end
        end
        if best then FB_Show(best); Library:Notify({ Title="Debug", Content="Box shown", Time=2 }) end
    end })
    t:AddButton({ Text = "Force Block Now", Func = function()
        local kf = GetKillersFolder()
        if not kf then return end
        for _, k in ipairs(kf:GetChildren()) do
            if AB_ShouldBlock(k) then
                AB.lastBlock = tick(); AB_FireBlock()
                Library:Notify({ Title="Debug", Content="Block fired", Time=2 })
                return
            end
        end
        Library:Notify({ Title="Debug", Content="No killer in zone", Time=2 })
    end })
    t:AddButton({ Text = "Print Killer Attributes", Func = function()
        local kf = GetKillersFolder()
        if not kf then return end
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") then
                print("=== Killer:", k.Name, "===")
                for _, attr in ipairs(k:GetAttributes()) do
                    print("  ", attr, "=", k:GetAttribute(attr))
                end
            end
        end
        Library:Notify({ Title="Debug", Content="Printed attributes to F9", Time=3 })
    end })
end

