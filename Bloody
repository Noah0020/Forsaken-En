local function DragToward(kr)
    if not AB.HitboxDrag or not HDT_Active or not LocalRoot or not kr then return end
    if os.clock() > HDT_Until then HDT_Active=false; return end
    if (kr.Position-LocalRoot.Position).Magnitude > (AB.DragRange or 30) then return end
    local speed, t0 = AB.DragSpeed or 14, os.clock()
    task.spawn(function()
        while os.clock()-t0 < 0.3 and AB.Enabled and HDT_Active and LocalRoot and kr.Parent do
            local dt = RunService.Heartbeat:Wait()
            local dir = Vector3.new(kr.Position.X-LocalRoot.Position.X, 0, kr.Position.Z-LocalRoot.Position.Z)
            if dir.Magnitude <= 3 then break end
            local ramp = math.sin(math.pi*(os.clock()-t0)/0.3)
            LocalRoot.CFrame = LocalRoot.CFrame + dir.Unit * speed * ramp * dt
        end
    end)
end

local function DoBlock(kr)
    local now = os.clock()
    if now - lastBlock < 0.02 then return end
    lastBlock = now
    local function burst() FireBlock(); FireBlock(); FireBlock(); FireBlock() end
    local ms = tonumber(AB.BlockDelayMs) or 0
    if ms > 0 then task.delay(ms/1000, burst) else burst() end
    if AB.HitboxDrag and HDT_Active and kr then DragToward(kr) end
    -- aim killer FIRST, then Punch
    if AB.AutoPunch and kr then
        task.spawn(function()
            aimAtKiller(kr, 0.18)
            task.wait(AB.PunchDelay or 0.12)
            if LocalRoot and kr.Parent then aimAtKiller(kr, 0.1) end
            FirePunch()
        end)
    end
end

local function armKiller(model, dur)
    if not model or model == LocalChar then return end
    pending[model] = { expiry = os.clock()+(dur or AB.SoundTimer), blocked = false }
end

local function hookSound(sound, model)
    if not sound or not sound:IsA("Sound") then return end
    table.insert(abConns, sound.Played:Connect(function()
        if not AB.Enabled then return end
        local id = extractId(sound.SoundId)
        if id and AttackSounds[id] then armKiller(model or sound:FindFirstAncestorOfClass("Model"), AB.SoundTimer) end
    end))
end

local function trackKiller(model)
    if not model or not model:IsA("Model") then return end
    pcall(function() for _,d in ipairs(model:GetDescendants()) do if d:IsA("Sound") then hookSound(d, model) end end end)
    table.insert(abConns, model.DescendantAdded:Connect(function(d) if d:IsA("Sound") then hookSound(d, model) end end))
    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 5); if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4); if not anim then return end
        table.insert(abConns, anim.AnimationPlayed:Connect(function(track)
            if not AB.Enabled or not track.Animation then return end
            local id = extractId(track.Animation.AnimationId)
            if not id or not AttackAnims[id] then return end
            armKiller(model, AB.SoundTimer)
            task.spawn(function()
                local q = model:FindFirstChild("QueryHitbox"); if not q then return end
                local lq = LocalChar and LocalChar:FindFirstChild("QueryHitbox")
                local params = OverlapParams.new(); params.MaxParts = 2
                if lq then params.FilterType=Enum.RaycastFilterType.Include; params.FilterDescendantsInstances={lq}
                else params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={model} end
                for _=1,14 do
                    if not AB.Enabled then break end
                    local kr = model:FindFirstChild("HumanoidRootPart")
                    local hits = workspace:GetPartBoundsInBox(q.CFrame*CFrame.new(0,0,-3.5), Vector3.new(5.2,6,5.65)*2.2*(AB.HitboxMult or 1), params)
                    if #hits > 0 then DoBlock(kr); break end
                    task.wait(0.01)
                end
            end)
        end))
    end)
end

local function makeALUBox(killer)
    if not AB.Enabled or not killer or not LocalRoot then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local m = AB.HitboxMult or 1
    local size = Vector3.new(6*m, 6*m, 9*m)
    local op = OverlapParams.new(); op.FilterType=Enum.RaycastFilterType.Exclude; op.FilterDescendantsInstances={killer}
    task.spawn(function()
        local t0, blocked = tick(), false
        while tick()-t0 < 0.28 and AB.Enabled and not blocked do
            local krr = killer:FindFirstChild("HumanoidRootPart"); if not krr then break end
            local hb = Instance.new("Part"); hb.Name="SH_ALU"; hb.Size=size
            hb.CFrame=krr.CFrame*CFrame.new(0,0,-(AB.HitboxDist or 3)); hb.Anchored=true
            hb.CanCollide=false; hb.CanTouch=false; hb.CanQuery=false; hb.CastShadow=false
            hb.Material=Enum.Material.ForceField; hb.Color=Color3.fromRGB(180,180,180)
            hb.Transparency=AB.HitboxVis and 0.7 or 1; hb.Parent=workspace; Debris:AddItem(hb, 0.28)
            for _,p in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = p.Parent and p.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health>0 and Players:GetPlayerFromCharacter(hum.Parent)==LocalPlayer then
                    blocked=true; hb.Color=Color3.fromRGB(0,220,0); DoBlock(krr); break
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

-- HDT only on local block anims
local localAnimConns = {}
local function hookLocalBlockAnims(char)
    for _,c in ipairs(localAnimConns) do pcall(function() c:Disconnect() end) end
    table.clear(localAnimConns)
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4); if not anim then return end
        table.insert(localAnimConns, anim.AnimationPlayed:Connect(function(track)
            local id = track.Animation and extractId(track.Animation.AnimationId)
            if id and blockAnimIds[id] then
                HDT_Active = true; HDT_Until = os.clock() + 0.55
                track.Stopped:Once(function() if os.clock() >= HDT_Until-0.05 then HDT_Active=false end end)
                task.delay(0.55, function() if os.clock() >= HDT_Until then HDT_Active=false end end)
            end
        end))
    end)
end
if LocalPlayer.Character then hookLocalBlockAnims(LocalPlayer.Character) end
