local sprintModule
pcall(function() sprintModule = require(ReplicatedStorage.Systems.Character.Game.Sprinting) end)

local staminaValues = {
    Inf = false,
    Max = sprintModule and sprintModule.MaxStamina or 100,
    Speed = sprintModule and sprintModule.SprintSpeed or 24,
    Gain = sprintModule and sprintModule.StaminaGain or 1,
    Drain = sprintModule and (sprintModule.StaminaDrain or 1) or 1,
    Regen = sprintModule and (sprintModule.StaminaRegenDelay or 0.5) or 0.5,
}
local _staminaThread

local function applyStamina()
    if not sprintModule then return end
    pcall(function()
        sprintModule.MaxStamina = staminaValues.Max
        sprintModule.SprintSpeed = staminaValues.Speed
        sprintModule.StaminaGain = staminaValues.Gain
        sprintModule.StaminaDrain = staminaValues.Drain
        sprintModule.StaminaRegenDelay = staminaValues.Regen
        if staminaValues.Inf then sprintModule.Stamina = staminaValues.Max end
    end)
end

local function startStaminaLoop()
    if _staminaThread then return end
    _staminaThread = task.spawn(function()
        while staminaValues.Inf do
            applyStamina()
            task.wait(0.05)
        end
        _staminaThread = nil
    end)
end

