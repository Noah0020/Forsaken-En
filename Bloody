        if not AB.enabled or not AB.useAudio or IsPlayerKiller() then return end
        local k = model or snd:FindFirstAncestorOfClass("Model")
        if k then onDetect(k) end
    end
    pcall(function() snd.Played:Connect(fire) end)
    if snd.IsPlaying then task.defer(fire) end
end
