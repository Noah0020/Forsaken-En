local function createBillboardGui(inst, kind)
    if kind == "killer" or kind == "survivor" then kind = "player" end
    if kind == "footstep" then return end
    local bb = Instance.new("BillboardGui")
    local stroke = Instance.new("UIStroke")
    local label = Instance.new("TextLabel")
    bb.Name = "__SBB"; bb.Archivable = false; bb.Parent = inst
    bb.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    bb.Active = true; bb.MaxDistance = 2000; bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 133, 0, 15); bb.StudsOffset = Vector3.new(0, 3, 0)
    label.Parent = bb; label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0); label.Font = Enum.Font.Code
    label.Text = inst.Name; label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true; label.TextWrapped = true
    stroke.Parent = label; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    stroke.Color = Color3.new(0, 0, 0); stroke.Thickness = 1.25
    if kind == "player" then
        bb.Parent = inst.PrimaryPart
        local hum = inst:FindFirstChildOfClass("Humanoid")
        if hum then
            label.Text = inst.Name .. " | " .. math.floor(hum.Health) .. "HP"
            hum.HealthChanged:Connect(function(h)
                if bb and label then label.Text = inst.Name .. " | " .. math.floor(h) .. "HP" end
