local function pushIdsFromValue(value, intoSet, abilityName)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id and not intoSet[id] then intoSet[id] = abilityName end
    elseif type(value) == "table" then
        for _, v in pairs(value) do pushIdsFromValue(v, intoSet, abilityName) end
    end
end
local function readConfig(module)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for abilityName, animValue in pairs(cfg.Animations) do
            local normalized = abilityName:lower():gsub("[%s_%-]", "")
            for stunName in pairs(STUN_ABILITY_NAMES) do
                if normalized == stunName:lower():gsub("[%s_%-]", "") then
                    pushIdsFromValue(animValue, STUN_ANIM_IDS, abilityName); break
                end
            end
        end
    end
    for _, field in ipairs(STUN_SOUND_FIELDS) do
        local soundTable = cfg[field]
        if type(soundTable) == "table" then
            for abilityName, soundValue in pairs(soundTable) do
                local normalized = abilityName:lower():gsub("[%s_%-]", "")
                for stunName in pairs(STUN_ABILITY_NAMES) do
                    if normalized == stunName:lower():gsub("[%s_%-]", "") then
                        pushIdsFromValue(soundValue, STUN_SOUND_IDS, abilityName); break
                    end
                end
            end
        end
    end
end
