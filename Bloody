_spinData = {}; _fallData = {}
function _IsKillerTargetingOther(killer)
    if not Settings.AntiWrongBlockEnabled then return false end
    local kr = killer:FindFirstChild("HumanoidRootPart"); local kh = killer:FindFirstChildOfClass("Humanoid")
    if not kr or not kh then return false end
    local myChar = LocalPlayer.Character; local mr = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not mr then return false end
    local tp = kh.TargetPoint
    if not tp or tp.Magnitude < 0.1 then return false end
    if (tp - mr.Position).Magnitude > (Settings.AntiWrongBlockRange or 15) then return false end
    local dP = (tp - mr.Position).Magnitude; local dK = (tp - kr.Position).Magnitude
    return dP > dK * (1 + (Settings.AntiWrongBlockTolerance or 0.15))
end
function _UpdateSpinData(killer)
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local now = tick(); local data = _spinData[killer]; local look = kr.CFrame.LookVector
    if not data then _spinData[killer] = { lastLook=look, lastTime=now, angles={} }; return end
    local dt = now - data.lastTime
    if dt > 0 then
        local dot = math.clamp(data.lastLook:Dot(look), -1, 1)
        local angle = math.deg(math.acos(dot)); local speed = angle / dt
        table.insert(data.angles, { angle=angle, speed=speed, time=now })
        local dur = Settings.AntiSpinBaitCheckDuration or 0.5
        while #data.angles > 0 and now - data.angles[1].time > dur do table.remove(data.angles, 1) end
    end
    data.lastLook = look; data.lastTime = now
end
function _IsKillerSpinning(killer)
    if not Settings.AntiSpinBaitEnabled then return false end
    local data = _spinData[killer]; if not data or #data.angles < 2 then return false end
    local total, mx = 0, 0
    for _, a in ipairs(data.angles) do total = total + a.angle; if a.speed > mx then mx = a.speed end end
    if mx > (Settings.AntiSpinBaitMaxAngularSpeed or 300) then return true end
    if total > (Settings.AntiSpinBaitMaxAngle or 100) then return true end
    return false
end
function _UpdateFallData(killer)
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local d = _fallData[killer]
    if not d then _fallData[killer] = { lastY=kr.Position.Y }; return end
    d.deltaY = kr.Position.Y - d.lastY; d.lastY = kr.Position.Y
end
function FireAbilityByMode(skipSafety, forcedKiller)
    local mode = GetActiveMode()
    local myChar = LocalPlayer.Character; local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    local killer, killerRoot = nil, nil
    if forcedKiller and forcedKiller.Parent then killer = forcedKiller; killerRoot = forcedKiller:FindFirstChild("HumanoidRootPart")
    elseif kf and myRoot then
        local bd = math.huge
        for _, k in ipairs(kf:GetChildren()) do
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then local d = (kr.Position - myRoot.Position).Magnitude; if d < bd then bd = d; killer = k; killerRoot = kr end end
        end
    end
    if not skipSafety and killer and killerRoot then
        if _IsKillerTargetingOther(killer) then return end
        if _IsKillerSpinning(killer) then return end
    end
    if Settings.WallCheckEnabled and killer and killerRoot and myRoot and myChar then if IsWallBetween(myRoot, killerRoot, myChar, killer) then return end end
    if mode == "hitbox" and Settings.FacingCheckEnabled and killer and killerRoot and myRoot then if not PassesFacingCheck(myRoot, killerRoot) then return end end
    if mode == "hitbox" then if Settings.RectangleABMode == "007n7" then FireClone() else FireBlock() end
    elseif mode == "zone" then if Settings.CustomABMode == "007n7" then FireClone() else FireBlock() end
    else if Settings.ABMode == "007n7" then FireClone() else FireBlock() end end
end
