        if not ABConfig.Enabled then return end
        local animId=tostring(track.Animation.AnimationId):match("%d+") if not animId then return end
        if getgenv().BlockAnimations[animId] then
            local myHRP=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") local kHRP=killerModel:FindFirstChild("HumanoidRootPart")
            if not myHRP or not kHRP then return end
            if (myHRP.Position-kHRP.Position).Magnitude<=ABConfig.Range and tick()-lastBlock>=ABConfig.Delay then
                if ABConfig.WallCheck then local p=RaycastParams.new() p.FilterType=Enum.RaycastFilterType.Exclude p.FilterDescendantsInstances={LP.Character,Workspace:FindFirstChild("Players")} if Workspace:Raycast(myHRP.Position,kHRP.Position-myHRP.Position,p) then return end end
                if ABConfig.RequireFacing then local dir=(kHRP.Position-myHRP.Position).Unit if myHRP.CFrame.LookVector:Dot(dir)>ABConfig.FacingDot then return end end
                lastBlock=tick() FireBlock() if ABConfig.Visualizer then Obsidian:Notify({Title="Auto Block",Description="Blocked "..killerModel.Name,Time=1}) end
