    local old
    pcall(function()
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if checkcaller() or getnamecallmethod() ~= "FireServer" then return old(self, ...) end
            if typeof(self) ~= "Instance" or not self:IsA("RemoteEvent") then return old(self, ...) end
            if not anySilentOn() then return old(self, ...) end
            local ok, newArgs = pcall(function()
                local args = {...}
