-- HDT
--═══════════════════════════════════════════════════════════════════
local HDT = { enabled = false, duration = 0.35, running = false }

local function RunHDT()
    if not HDT.enabled or HDT.running or IsPlayerKiller() then return end
    HDT.running = true
    task.spawn(function()
        local character = LP.Character
        if not character then HDT.running = false; return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then HDT.running = false; return end
        local oldPrimary = character.PrimaryPart or hrp
        local part2 = Instance.new("Part")
        part2.Size = Vector3.new(2, 2, 2)
        part2.Transparency = 1
        part2.CanCollide = false
        part2.Anchored = true
        part2.CFrame = hrp.CFrame
        part2.Parent = character
        character.PrimaryPart = part2
        local t0 = os.clock()
        local dur = HDT.duration or 0.35
        while os.clock() - t0 < dur and HDT.enabled do
            local k = GetNearestKiller(80)
            local kr = k and k:FindFirstChild("HumanoidRootPart")
            if kr and hrp.Parent then
                local rot = hrp.CFrame.Rotation
                part2.CFrame = CFrame.new((kr.CFrame * CFrame.new(0, 0, -3)).Position) * rot
                hrp.AssemblyLinearVelocity = Vector3.zero
            else
                break
            end
            RunService.PreRender:Wait()
        end
        if part2 and part2.Parent then part2:Destroy() end
        if character and character.Parent then
            character.PrimaryPart = oldPrimary
        end
        HDT.running = false
    end)
end

