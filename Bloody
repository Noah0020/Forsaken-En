local function AddToggle(parent, label, default, callback)
    local Row = Create("Frame", {
        Size = UDim2.new(1, -5, 0, 44),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ZIndex = 8,
    }, parent)
    Corner(Row, 10)
    Stroke(Row, Theme.Border, 0.5)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 13, 0, 0),
        Size = UDim2.new(1, -70, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = label,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 9,
    }, Row)

    local Switch = Create("Frame", {
        Position = UDim2.new(1, -50, 0.5, -10),
        Size = UDim2.fromOffset(36, 20),
        BackgroundColor3 = default and Theme.Accent or Theme.Surface,
        BorderSizePixel = 0,
        ZIndex = 9,
    }, Row)
    Corner(Switch, 10)

    local Knob = Create("Frame", {
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 10,
    }, Switch)
    Corner(Knob, 8)

    local Clicker = Create("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 11,
    }, Row)

    local state = default

    local function setState(newState)
        state = newState
        Tween(Switch, 0.18, { BackgroundColor3 = state and Theme.Accent or Theme.Surface })
        Tween(Knob, 0.18, {
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        })
        if callback then callback(state) end
    end

    Clicker.MouseButton1Click:Connect(function()
        setState(not state)
    end)
end

local function AddSlider(parent, label, min, max, default, rounding, callback)
    local Row = Create("Frame", {
        Size = UDim2.new(1, -5, 0, 54),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ZIndex = 8,
    }, parent)
    Corner(Row, 10)
    Stroke(Row, Theme.Border, 0.5)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 13, 0, 8),
        Size = UDim2.new(1, -70, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = label,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 9,
    }, Row)

    local fmt = "%d"
    if rounding == 1 then fmt = "%.1f" elseif rounding == 2 then fmt = "%.2f" end

    local ValueLabel = Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -70, 0, 8),
        Size = UDim2.new(0, 57, 0, 16),
        Font = Enum.Font.Gotham,
        Text = string.format(fmt, default),
        TextSize = 10,
        TextColor3 = Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 9,
    }, Row)

    local Track = Create("Frame", {
        Position = UDim2.new(0, 13, 0, 34),
        Size = UDim2.new(1, -26, 0, 6),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        ZIndex = 9,
    }, Row)
    Corner(Track, 3)

    local pct = (default - min) / (max - min)
    local Fill = Create("Frame", {
        Size = UDim2.fromScale(pct, 1),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 10,
    }, Track)
    Corner(Fill, 3)

    local Knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(pct, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 11,
    }, Track)
    Corner(Knob, 6)

    local value = default
    local dragging = false

    local function applyFromX(x)
        local trackX = Track.AbsolutePosition.X
        local trackW = Track.AbsoluteSize.X
        local rel = math.clamp((x - trackX) / trackW, 0, 1)
        value = min + (max - min) * rel
        local p = (value - min) / (max - min)
        Tween(Fill, 0.05, { Size = UDim2.fromScale(p, 1) })
        Tween(Knob, 0.05, { Position = UDim2.new(p, 0, 0.5, 0) })
        ValueLabel.Text = string.format(fmt, value)
        if callback then callback(value) end
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            applyFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            applyFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function AddButton(parent, label, callback)
    local Button = Create("TextButton", {
        Size = UDim2.new(1, -5, 0, 40),
        BackgroundColor3 = Theme.Panel,
        Text = label,
        Font = Enum.Font.GothamSemibold,
        TextSize = 11,
        TextColor3 = Theme.Text,
        AutoButtonColor = false,
        ZIndex = 8,
    }, parent)
    Corner(Button, 10)
    Stroke(Button, Theme.Border, 0.5)

    local hovered = false
    Button.MouseEnter:Connect(function()
        if hovered then return end
        hovered = true
        Tween(Button, 0.15, { BackgroundColor3 = Theme.Surface })
    end)
    Button.MouseLeave:Connect(function()
        hovered = false
        Tween(Button, 0.15, { BackgroundColor3 = Theme.Panel })
    end)
    Button.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
end

