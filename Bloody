-- FACING: Normal check + ADVANCED PREDICTIVE BOX (multi-color)
-- Giant invisible boundary in front of killer; small fancy boxes
-- travel toward player when attack fires, clamped inside giant.
-- Red = outside giant | Yellow = inside giant invalid | Green = valid hit
--═══════════════════════════════════════════════════════════════════
local FacingMode = "None" -- "None" | "Normal" | "AdvancedBox"
local NormalFacing = { requireFacing = false, facingDot = -0.1, range = 18 }

local AdvBox = {
    Enabled = false,
    BoxCount = 3,
    SmallW = 5, SmallH = 6, SmallL = 8,
    GiantW = 16, GiantH = 10, GiantL = 22,
    GiantForward = 10,
    SpawnForward = 4,
    VerticalOffset = 0,
    LaneSpacing = 0.9,
    Lifetime = 0.55,
    PredSpeed = 70,
    PredDist = 35,
    ShowSmall = true,
    ShowGiant = false,
    FillTrans = 0.55,
    OutlineThick = 0.06,
    Colors = {
        Out = Color3.fromRGB(255, 55, 55),
        Invalid = Color3.fromRGB(255, 210, 40),
        Valid = Color3.fromRGB(40, 255, 110),
        Boundary = Color3.fromRGB(100, 160, 255),
    },
    OnValid = nil, -- callback when green
}

do
    local Folder = Instance.new("Folder")
    Folder.Name = "Nos_AdvBoxFacing"
    Folder.Parent = Workspace
    local KillerCharacter = nil
    local Active = {}
    local lastValid = 0

    local function getRoot(c)
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function makePart(name)
        local p = Instance.new("Part")
        p.Name = name
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
        p.Material = Enum.Material.ForceField
        p.Transparency = AdvBox.FillTrans
        p.Size = Vector3.one
        p.Parent = Folder
        -- double neon outline for fancy look
        local o1 = Instance.new("SelectionBox")
        o1.Name = "Outer"; o1.Adornee = p; o1.SurfaceTransparency = 1
        o1.LineThickness = AdvBox.OutlineThick; o1.Parent = p
        local o2 = Instance.new("SelectionBox")
        o2.Name = "Inner"; o2.Adornee = p; o2.SurfaceTransparency = 1
        o2.LineThickness = AdvBox.OutlineThick * 0.4; o2.Parent = p
        -- soft glow core
        local light = Instance.new("PointLight")
        light.Name = "Glow"; light.Range = 8; light.Brightness = 0.8; light.Parent = p
        return p
    end

    local function style(p, size, cf, color)
        p.Size = size
        p.CFrame = cf
        p.Color = color
        p.Transparency = AdvBox.ShowSmall and AdvBox.FillTrans or 1
        local o1 = p:FindFirstChild("Outer")
        local o2 = p:FindFirstChild("Inner")
        if o1 then o1.Color3 = color; o1.LineThickness = AdvBox.OutlineThick end
        if o2 then o2.Color3 = Color3.new(
            math.min(1, color.R + 0.25),
            math.min(1, color.G + 0.25),
            math.min(1, color.B + 0.25)
        ); o2.LineThickness = AdvBox.OutlineThick * 0.4 end
        local light = p:FindFirstChild("Glow")
        if light then light.Color = color; light.Enabled = AdvBox.ShowSmall end
    end

    local Boundary = makePart("GiantBoundary")
    Boundary.Material = Enum.Material.ForceField
    Boundary.Transparency = 1

    local function syncCount()
        local want = math.clamp(math.floor(AdvBox.BoxCount), 1, 12)
        while #Active < want do
            local idx = #Active + 1
            table.insert(Active, { Part = makePart("AdvBox_" .. idx), Pos = Vector3.zero, Active = false, Age = 0, Index = idx })
        end
        while #Active > want do
            local o = table.remove(Active)
            o.Part:Destroy()
        end
    end
    syncCount()

    local function boundaryCF(root)
        return root.CFrame * CFrame.new(0, AdvBox.VerticalOffset, -AdvBox.GiantForward)
    end
    local function giantSize()
        return Vector3.new(AdvBox.GiantW, AdvBox.GiantH, AdvBox.GiantL)
    end
    local function smallSize()
        return Vector3.new(AdvBox.SmallW, AdvBox.SmallH, AdvBox.SmallL)
    end

    local function clampIn(worldPos, bCF, bSize, sSize)
        local lp = bCF:PointToObjectSpace(worldPos)
        local hx = math.max(0, bSize.X/2 - sSize.X/2)
        local hy = math.max(0, bSize.Y/2 - sSize.Y/2)
        local hz = math.max(0, bSize.Z/2 - sSize.Z/2)
        lp = Vector3.new(math.clamp(lp.X,-hx,hx), math.clamp(lp.Y,-hy,hy), math.clamp(lp.Z,-hz,hz))
        return bCF:PointToWorldSpace(lp)
    end

    local function inside(worldPos, cf, size)
        local lp = cf:PointToObjectSpace(worldPos)
        return math.abs(lp.X) <= size.X/2 and math.abs(lp.Y) <= size.Y/2 and math.abs(lp.Z) <= size.Z/2
    end

    local function boxCF(pos, bCF)
        return CFrame.new(pos) * (bCF - bCF.Position)
    end

    function AdvBox.SetKiller(m)
        if m and m:IsA("Model") then KillerCharacter = m end
    end

    function AdvBox.Trigger()
        if FacingMode ~= "AdvancedBox" and not AdvBox.Enabled then return end
        local kr = getRoot(KillerCharacter)
        local pr = getRoot(LP.Character)
        if not kr or not pr then return end
        syncCount()
        local bCF = boundaryCF(kr)
        local bSize, sSize = giantSize(), smallSize()
        local spawn = kr.Position + kr.CFrame.LookVector * AdvBox.SpawnForward
        for i, o in ipairs(Active) do
            local lane = (i - (#Active+1)/2) * AdvBox.LaneSpacing
            local lanePos = spawn + bCF.RightVector * lane
            o.Pos = clampIn(lanePos, bCF, bSize, sSize)
            o.Age = 0
            o.Active = true
        end
    end

    function AdvBox.Clear()
        for _, o in ipairs(Active) do o.Active = false; o.Part.Transparency = 1 end
    end

    function AdvBox.IsValidAgainstPlayer()
        local kr = getRoot(KillerCharacter)
        local pr = getRoot(LP.Character)
        if not kr or not pr then return false end
        local bCF = boundaryCF(kr)
        local bSize, sSize = giantSize(), smallSize()
        if not inside(pr.Position, bCF, bSize) then return false end
        for _, o in ipairs(Active) do
            if o.Active then
                local cf = boxCF(o.Pos, bCF)
                if inside(pr.Position, cf, sSize) then return true end
            end
        end
        return false
    end

    RunService.Heartbeat:Connect(function(dt)
        if _ShuttingDown then return end
        if FacingMode ~= "AdvancedBox" and not AdvBox.Enabled then
            AdvBox.Clear()
            Boundary.Transparency = 1
            return
        end
        local kr = getRoot(KillerCharacter)
        local pr = getRoot(LP.Character)
        if not kr or not pr then
            AdvBox.Clear()
            return
        end
        local bCF = boundaryCF(kr)
        local bSize, sSize = giantSize(), smallSize()
        Boundary.Size = bSize
        Boundary.CFrame = bCF
        Boundary.Color = AdvBox.Colors.Boundary
        Boundary.Transparency = AdvBox.ShowGiant and 0.88 or 1
        local oB = Boundary:FindFirstChild("Outer")
        if oB then oB.Color3 = AdvBox.Colors.Boundary; oB.Transparency = AdvBox.ShowGiant and 0 or 1 end

        local target = pr.Position
        local inGiant = inside(target, bCF, bSize)
        local dest = clampIn(target, bCF, bSize, sSize)
        local anyGreen = false
        syncCount()
        -- Idle spawn positions in front of killer (used when player is outside giant)
        local spawnBase = kr.Position + kr.CFrame.LookVector * AdvBox.SpawnForward
        for _, o in ipairs(Active) do
            if o.Active then
                o.Age = o.Age + dt
                if o.Age >= AdvBox.Lifetime then
                    o.Active = false
                    o.Part.Transparency = 1
                else
                    if inGiant then
                        -- Only follow player while they are inside the giant box
                        local step = math.min(AdvBox.PredSpeed * dt, AdvBox.PredDist)
                        local diff = dest - o.Pos
                        if diff.Magnitude > 0.001 then
                            o.Pos = o.Pos + diff.Unit * math.min(diff.Magnitude, step)
                        end
                        o.Pos = clampIn(o.Pos, bCF, bSize, sSize)
                    else
                        -- Outside giant: ignore player, stay in front of killer
                        local lane = (o.Index - (#Active + 1) / 2) * AdvBox.LaneSpacing
                        local lanePos = spawnBase + bCF.RightVector * lane
                        o.Pos = clampIn(lanePos, bCF, bSize, sSize)
                    end
                    local cf = boxCF(o.Pos, bCF)
                    local col
                    if not inGiant then
                        col = AdvBox.Colors.Out -- red: player outside giant
                    elseif inside(target, cf, sSize) then
                        col = AdvBox.Colors.Valid -- green: touching player
                        anyGreen = true
                    else
                        col = AdvBox.Colors.Invalid -- yellow: inside giant, not on player
                    end
                    -- Always draw small box visuals when active
                    style(o.Part, sSize, cf, col)
                    o.Part.Transparency = AdvBox.ShowSmall and AdvBox.FillTrans or 1
                end
            end
        end
        if anyGreen and AdvBox.OnValid then
            local now = tick()
            if now - lastValid > 0.12 then
                lastValid = now
                pcall(AdvBox.OnValid, KillerCharacter)
            end
        end
    end)
end

local function PassesNormalFacing(killer)
    if FacingMode ~= "Normal" then return true end
    if not NormalFacing.requireFacing then return true end
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not my or not kr then return false end
    if (kr.Position - my.Position).Magnitude > NormalFacing.range then return false end
    local to = Vector3.new(my.Position.X - kr.Position.X, 0, my.Position.Z - kr.Position.Z)
    if to.Magnitude < 0.1 then return true end
    local look = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
    if look.Magnitude < 0.1 then return true end
    return look.Unit:Dot(to.Unit) > (NormalFacing.facingDot or -0.1)
end


