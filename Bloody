-- STACKED BOX AUTO BLOCK (killer-front column that travels forward)
--═══════════════════════════════════════════════════════════════════
local AB = {
    enabled = false,
    delay = 0,
    last = 0,
}

local StackConfig = {
    angle = 120,
    radius = 20,
    verticalTolerance = 6,
    boxWidth = 3,
    boxHeight = 3,
    boxDepth = 3,
    boxSize = Vector3.new(3, 3, 3),
    boxCount = 5,
    boxGap = 0.15,
    speed = 90,
    timeout = 1.5,
    touchPadding = 1.25,
    showRange = true,
    showBoxes = true,
    rangeSegments = 32,
    rangeColor = Color3.fromRGB(255, 65, 75),
    boxColor = Color3.fromRGB(255, 90, 100),
}

local FacingMode = "Stacked Boxes" -- Stacked Boxes | None
local StackFolder = Instance.new("Folder")
StackFolder.Name = "Nos_StackedAutoBlock"
StackFolder.Parent = Workspace

local RangeFolder = Instance.new("Folder")
RangeFolder.Name = "Nos_StackedRange"
RangeFolder.Parent = Workspace

local killerStacks = {}
local rangeParts = {}
local stackHeartbeat = nil

local function getRoot(model)
    return model and model:FindFirstChild("HumanoidRootPart")
end

local function getKillerForward(root)
    local f = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if f.Magnitude < 0.001 then return Vector3.new(0, 0, -1) end
    return f.Unit
end

-- The detection sector always belongs to the killer and only extends forward.
local function IsPlayerInsideKillerZone(killer)
    local killerRoot = getRoot(killer)
    local playerRoot = getRoot(LP.Character)
    if not killerRoot or not playerRoot then return false end

    local offset = playerRoot.Position - killerRoot.Position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    local distance = horizontal.Magnitude
    if distance > StackConfig.radius then return false end
    if math.abs(offset.Y) > StackConfig.verticalTolerance then return false end
    if distance < 0.01 then return true end

    local dot = math.clamp(getKillerForward(killerRoot):Dot(horizontal.Unit), -1, 1)
    return dot >= math.cos(math.rad(math.clamp(StackConfig.angle, 1, 180) / 2))
end

local function makeLinePart(parent, name, color)
    local part = Instance.new("Part")
    part.Name = name
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = 0.12
    part.Size = Vector3.new(0.08, 0.08, 1)
    part.Parent = parent
    return part
end

local function clearRange(killer)
    local parts = rangeParts[killer]
    if parts then
        for _, part in ipairs(parts) do
            pcall(function() part:Destroy() end)
        end
        rangeParts[killer] = nil
    end
end

local function updateKillerRange(killer)
    local root = getRoot(killer)
    if not root or not StackConfig.showRange or FacingMode ~= "Stacked Boxes" then
        clearRange(killer)
        return
    end

    local parts = rangeParts[killer]
    if not parts then
        parts = {}
        for i = 1, StackConfig.rangeSegments + 2 do
            parts[i] = makeLinePart(RangeFolder, "Nos_RangeOutline", StackConfig.rangeColor)
        end
        rangeParts[killer] = parts
    end

    local forward = getKillerForward(root)
    local right = Vector3.new(-forward.Z, 0, forward.X)
    local half = math.rad(math.clamp(StackConfig.angle, 1, 180) / 2)
    local center = root.Position + Vector3.new(0, 0.12, 0)
    local points = {}

    for i = 0, StackConfig.rangeSegments do
        local a = -half + (2 * half) * (i / StackConfig.rangeSegments)
        local dir = forward * math.cos(a) + right * math.sin(a)
        points[i + 1] = center + dir * StackConfig.radius
    end

    local function placeLine(part, a, b)
        local delta = b - a
        part.Size = Vector3.new(0.08, 0.08, math.max(delta.Magnitude, 0.05))
        part.CFrame = CFrame.lookAt((a + b) / 2, b)
        part.Color = StackConfig.rangeColor
    end

    for i = 1, StackConfig.rangeSegments do
        placeLine(parts[i], points[i], points[i + 1])
    end
    placeLine(parts[StackConfig.rangeSegments + 1], center, points[1])
    placeLine(parts[StackConfig.rangeSegments + 2], center, points[#points])
end

local function destroyStack(killer)
    local data = killerStacks[killer]
    if not data then return end
    for _, part in ipairs(data.parts) do
        pcall(function() part:Destroy() end)
    end
    killerStacks[killer] = nil
end

local function createStack(killer)
    local data = killerStacks[killer]
    if data then return data end

    data = { parts = {}, active = false, started = 0, position = nil }
    for i = 1, StackConfig.boxCount do
        local part = Instance.new("Part")
        part.Name = "Nos_StackedBlockBox_" .. i
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Color = StackConfig.boxColor
        part.Transparency = StackConfig.showBoxes and 0.2 or 1
        part.Size = StackConfig.boxSize
        part.Parent = StackFolder
        data.parts[i] = part
    end
    killerStacks[killer] = data
    return data
end

local function resizeStack(data)
    while #data.parts > StackConfig.boxCount do
        local part = table.remove(data.parts)
        if part then part:Destroy() end
    end
    while #data.parts < StackConfig.boxCount do
        local i = #data.parts + 1
        local part = Instance.new("Part")
        part.Name = "Nos_StackedBlockBox_" .. i
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Color = StackConfig.boxColor
        part.Transparency = StackConfig.showBoxes and 0.2 or 1
        part.Size = StackConfig.boxSize
        part.Parent = StackFolder
        data.parts[i] = part
    end
    for _, part in ipairs(data.parts) do
        part.Size = StackConfig.boxSize
        part.Color = StackConfig.boxColor
        part.Transparency = StackConfig.showBoxes and 0.2 or 1
    end
end

local function getStackFrontPosition(root)
    local forward = getKillerForward(root)
    local frontOffset = math.max(StackConfig.boxSize.Z * 0.5 + 0.75, 1.5)
    return root.Position + forward * frontOffset, forward
end

local function placeStack(killer, data, basePosition, forward)
    local right = Vector3.new(-forward.Z, 0, forward.X)
    local baseY = StackConfig.boxSize.Y * 0.5
    local spacing = StackConfig.boxSize.Y + StackConfig.boxGap
    for i, part in ipairs(data.parts) do
        local pos = basePosition + Vector3.new(0, baseY + (i - 1) * spacing, 0)
        part.CFrame = CFrame.lookAt(pos, pos + forward, Vector3.yAxis)
        part.Transparency = StackConfig.showBoxes and 0.2 or 1
    end
end

local function resetStackToKillerFront(killer, data)
    local root = getRoot(killer)
    if not root then return end
    local base, forward = getStackFrontPosition(root)
    data.active = false
    data.position = base
    placeStack(killer, data, base, forward)
end

local function startStackTravel(killer)
    if not killer or not killer.Parent then return end
    local root = getRoot(killer)
    if not root then return end
    local data = createStack(killer)
    resizeStack(data)

    -- Outside the forward range: keep the complete stack parked at the killer's front.
    if not IsPlayerInsideKillerZone(killer) then
        resetStackToKillerFront(killer, data)
        return
    end

    local front = getStackFrontPosition(root)
    data.position = front
    data.active = true
    data.started = os.clock()
end

local function removeAllStacks()
    for killer in pairs(killerStacks) do destroyStack(killer) end
    for killer in pairs(rangeParts) do clearRange(killer) end
end

-- Kept for the hub's unload button and Library unload callback.
local function clearStack()
    if stackHeartbeat then
        pcall(function() stackHeartbeat:Disconnect() end)
        stackHeartbeat = nil
    end
    removeAllStacks()
    pcall(function() StackFolder:Destroy() end)
    pcall(function() RangeFolder:Destroy() end)
end

local function triggerBlock(killer)
    if not AB.enabled or IsPlayerKiller() then return end
    if FacingMode == "None" then
        local now = os.clock()
        if now - AB.last < 0.08 then return end
        AB.last = now
        if AB.delay > 0 then
            task.delay(AB.delay, function() if AB.enabled then FireBlock() end end)
        else
            FireBlock()
        end
        return
    end
    startStackTravel(killer)
end

-- Keep one vertical stack parked at each killer's front. On an M1 signal,
-- that stack moves as a column toward the survivor if they are in the forward range.
stackHeartbeat = RunService.Heartbeat:Connect(function(dt)
    local playersFolder = Workspace:FindFirstChild("Players")
    local killersFolder = playersFolder and playersFolder:FindFirstChild("Killers")
    local present = {}

    if killersFolder then
        for _, killer in ipairs(killersFolder:GetChildren()) do
            if killer:IsA("Model") then
                present[killer] = true
                updateKillerRange(killer)
                local root = getRoot(killer)
                if root and FacingMode == "Stacked Boxes" then
                    local data = createStack(killer)
                    resizeStack(data)
                    local playerRoot = getRoot(LP.Character)

                    if data.active then
                        if not playerRoot or not IsPlayerInsideKillerZone(killer)
                            or os.clock() - data.started >= StackConfig.timeout then
                            resetStackToKillerFront(killer, data)
                        else
                            local front = getStackFrontPosition(root)
                            local target = playerRoot.Position
                            local targetOffset = target - root.Position
                            local horizontalTarget = Vector3.new(targetOffset.X, 0, targetOffset.Z)
                            local forward = getKillerForward(root)

                            -- Refuse any target vector that points behind the killer.
                            if horizontalTarget.Magnitude < 0.01
                                or forward:Dot(horizontalTarget.Unit) <= 0 then
                                resetStackToKillerFront(killer, data)
                            else
                                local destination = target
                                local current = data.position or front
                                local delta = destination - current
                                local distance = delta.Magnitude
                                local step = math.max(StackConfig.speed, 1) * math.max(dt, 0)
                                local collisionRadius = math.max(StackConfig.boxSize.Magnitude * 0.5 + StackConfig.touchPadding, 1)
                                local anyBoxTouches = false
                                for _, box in ipairs(data.parts) do
                                    if box and box.Parent and (box.Position - playerRoot.Position).Magnitude <= collisionRadius then
                                        anyBoxTouches = true
                                        break
                                    end
                                end
                                if anyBoxTouches or distance <= collisionRadius + step then
                                    -- Any individual box reaching the player counts as contact.
                                    data.active = false
                                    resetStackToKillerFront(killer, data)
                                    local now = os.clock()
                                    if AB.enabled and now - AB.last >= 0.08 then
                                        AB.last = now
                                        if AB.delay > 0 then
                                            task.delay(AB.delay, function()
                                                if AB.enabled then FireBlock() end
                                            end)
                                        else
                                            FireBlock()
                                        end
                                    end
                                elseif distance > 0.01 then
                                    local nextPosition = current + delta.Unit * math.min(step, distance)
                                    -- Clamp the column to the killer's forward half-space.
                                    local fromKiller = nextPosition - root.Position
                                    local forwardDistance = Vector3.new(fromKiller.X, 0, fromKiller.Z):Dot(forward)
                                    if forwardDistance < math.max(StackConfig.boxSize.Z * 0.5, 0.5) then
                                        resetStackToKillerFront(killer, data)
                                    else
                                        data.position = nextPosition
                                        placeStack(killer, data, nextPosition, delta.Unit)
                                    end
                                end
                            end
                        end
                    else
                        resetStackToKillerFront(killer, data)
                    end
                end
            end
        end
    end

    for killer in pairs(killerStacks) do
        if not present[killer] or not killer.Parent then destroyStack(killer) end
    end
    for killer in pairs(rangeParts) do
        if not present[killer] or not killer.Parent then clearRange(killer) end
    end
end)

-- This uses the same killer attribute signal as the previous version.
-- It still depends on AbilityLastUsed corresponding to the game's M1 signal.
local monitored = {}
local function monitorKiller(killer)
    if not killer or monitored[killer] or not killer:IsA("Model") or killer == LP.Character then return end
    monitored[killer] = true
    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = killer:GetAttribute("AbilitiesUsed") or 0

    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not AB.enabled or IsPlayerKiller() then return end
        local currentAbility = killer:GetAttribute("AbilityLastUsed") or 0
        if currentAbility == lastAbility then return end
        lastAbility = currentAbility

        local currentUsed = killer:GetAttribute("AbilitiesUsed") or 0
        if currentUsed > lastUsed then
            lastUsed = currentUsed
            return
        end
        triggerBlock(killer)
    end)
end

