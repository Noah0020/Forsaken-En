        end
        if getgenv().AimMode == "Char + Cam Lock" then
            local cam = Workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, position), 0.75)
            end
        end
    end)

