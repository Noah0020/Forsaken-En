-- Killer aim (animation-based)
local killerAimAnimIds = {
    ["1x4"] = { ["99050723653468"] = true, ["119181003138006"] = true },
    ["C00kidd"] = { ["18885919947"] = true },
    ["JohnDoe"] = { ["127172483138092"] = true },
    ["Nosferatu"] = { ["79282445348798"] = true, ["128009545282102"] = true },
}
local killerAimCam = { ["C00kidd"] = true, ["JohnDoe"] = true, ["Nosferatu"] = true }
local function makeAnimTrigger(name)
    local ids = killerAimAnimIds[name]
    local useCam = killerAimCam[name]
    local active, animConn, charConn = false, nil, nil
    local function onAnim(track)
        if not active then return end
        local aid = track.Animation and track.Animation.AnimationId
        if not aid then return end
        local num = tostring(aid):match("%d+")
        if num and ids[num] then
            local char = LP.Character; if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp or not hum or hum.Health <= 0 then return end
            local target = findClosestTarget("Survivors", char, hrp.Position, aimSettings.distance)
            if not target then return end
            local vel = target.AssemblyLinearVelocity or Vector3.zero
            if vel.Magnitude > 60 then vel = vel.Unit * 60 end
            local pred = target.Position + vel * (aimSettings.prediction * 0.03)
            if useCam then
                local cam = workspace.CurrentCamera
                if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, pred) end
            else
                local dir = Vector3.new(pred.X - hrp.Position.X, 0, pred.Z - hrp.Position.Z)
                if dir.Magnitude > 0.01 then
                    dir = dir.Unit
                    local bg = Instance.new("BodyGyro")
                    bg.MaxTorque = Vector3.new(0, 1e6, 0); bg.P = 10000; bg.D = 1000
                    bg.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
                    bg.Parent = hrp
                    Debris:AddItem(bg, 0.2)
                end
            end
        end
    end
    local function attach(char)
        if not char or not active then return end
        local hum = char:WaitForChild("Humanoid", 3); if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
        if not anim then return end
        if animConn then pcall(function() animConn:Disconnect() end) end
        animConn = anim.AnimationPlayed:Connect(onAnim)
    end
    registerAim(name, function()
        if active then return end
        active = true
        if LP.Character then attach(LP.Character) end
        if charConn then pcall(function() charConn:Disconnect() end) end
        charConn = LP.CharacterAdded:Connect(function(c) task.wait(0.1); attach(c) end)
    end, function()
        active = false
        if animConn then pcall(function() animConn:Disconnect() end); animConn = nil end
        if charConn then pcall(function() charConn:Disconnect() end); charConn = nil end
    end)
end
for name in pairs(killerAimAnimIds) do makeAnimTrigger(name) end

