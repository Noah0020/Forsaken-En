local function startLock(modeKey, track)
    if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then return end
    local cfg = getgenv().AimbotValues[modeKey]
    if not cfg or not cfg.Enabled or getgenv().ActiveLock.IsActive then return end
    if track and track == getgenv().LastFinishedTrack then return end
    local target = GetNearestKiller(cfg.Distance or 50)
    if not target then return end
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    getgenv().ActiveLock.IsActive = true
    getgenv().ActiveLock.Target = target
    getgenv().ActiveLock.StartTime = tick()
    getgenv().ActiveLock.Mode = modeKey
    getgenv().ActiveLock.Track = track
    if hum then hum.AutoRotate = false end
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    if tRoot then
        if (cfg.Prediction or 0) > 0 then AimCore.prediction = cfg.Prediction * 0.05 end
        SyncAimbot(tRoot, cfg.LockDuration or 1)
    end
end

local function tryTrack(track)
    if not track or not track.Animation then return end
    local id = tostring(track.Animation.AnimationId):match("%d+")
    if not id then return end
    for modeKey, idMap in pairs(getgenv().AnimationData) do
        local cfg = getgenv().AimbotValues[modeKey]
        if cfg and cfg.Enabled and idMap[id] then startLock(modeKey, track); return end
    end
end

