                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

-- Range gate: Circle (Nerg cone/circle) OR Hitbox (A1 spatial)
local RangeGate = {
    mode = "Circle", -- "Circle" | "Hitbox"
    -- Circle
    circleRange = 18,
    visionRange = 13.5,
    visionAngle = 85,
    showVisual = true,
    -- Hitbox
    width = 5,
    height = 6,
    length = 8,
    offset = -1,
    duration = 0.5,
    transparency = 0.5,
    color = Color3.fromRGB(40, 200, 90),
}

