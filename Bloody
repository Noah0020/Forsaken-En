local HDT = { debounce = false, Speed = 40, Duration = 0.6, bindId = 0 }
local HDT_Enabled = false
local function HDT_Fire(killer)
    if not HDT_Enabled or HDT.debounce then return end
    if hasHelpless() then return end
    if not killer or not killer.Parent then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true; HDT.bindId += 1
    local bind = "GS_HDT_" .. HDT.bindId
    local startT = tick(); local sp = HDT.Speed; local dur = HDT.Duration; local active = true
    local bv = Instance.new("BodyVelocity")
    bv.Name = "GS_HDT_BV"; bv.MaxForce = Vector3.new(1e6, 0, 1e6); bv.Velocity = Vector3.zero; bv.Parent = hrp
    local bg = Instance.new("BodyGyro")
    bg.Name = "GS_HDT_BG"; bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6); bg.P = 3000; bg.D = 500
    bg.CFrame = hrp.CFrame; bg.Parent = hrp
    local function stop()
        if not active then return end
        active = false; HDT.debounce = false
        pcall(function() RunService:UnbindFromRenderStep(bind) end)
        if bv and bv.Parent then bv:Destroy() end
        if bg and bg.Parent then bg:Destroy() end
    end
    RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 1, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health <= 0 then stop(); return end
        if hasHelpless() then stop(); return end
        if not kr.Parent then stop(); return end
        if tick() - startT > dur then stop(); return end
        local to = kr.Position - hrp.Position
        local flat = Vector3.new(to.X, 0, to.Z)
        if flat.Magnitude < 1 then stop(); return end
        if bv.Parent then bv.Velocity = flat.Unit * sp end
        if bg.Parent then bg.CFrame = CFrame.new(hrp.Position, Vector3.new(kr.Position.X, hrp.Position.Y, kr.Position.Z)) end
    end)
    task.delay(dur + 0.3, stop)
end

local AutoBlockEnabled = false
local function checkKiller(k)
    if not AutoBlockEnabled or not LP.Character then return end
    local cu = k:GetAttribute("AbilityLastUsed") or 0
    local cus = k:GetAttribute("AbilitiesUsed") or 0
    local st = blockPerKiller[k]
    if not st then blockPerKiller[k] = { lastUsed = cu, used = cus, locked = false } return end
    local lUI = cu > st.lastUsed
    local uI = cus > st.used
    if uI then st.locked = true end
    if lUI and not st.locked then
        local ex = activeBlocks[k]
        if ex then ex.expiresAt = os.clock() + ConeCfg.WindowDuration
        else activeBlocks[k] = { expiresAt = os.clock() + ConeCfg.WindowDuration, fired = false } end
    end
    if lUI and st.locked then st.locked = false end
    st.lastUsed = cu; st.used = cus
end
RunService.Heartbeat:Connect(function()
    if not AutoBlockEnabled then return end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return end
    for _, k in ipairs(kf:GetChildren()) do if k:IsA("Model") then pcall(checkKiller, k) end end
end)
RunService.RenderStepped:Connect(function(dt)
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not AutoBlockEnabled or not kf then
        for _, s in pairs(ConeState) do hideCone(s) end
        return
    end
    local char = LP.Character
    local pHRP = char and char:FindFirstChild("HumanoidRootPart")
    local now = os.clock()
    local exp = {}
    for k, d in pairs(activeBlocks) do if now > d.expiresAt or not k.Parent then table.insert(exp, k) end end
    for _, k in ipairs(exp) do activeBlocks[k] = nil end
    local dead = {}
    for k in pairs(ConeState) do if not k.Parent then table.insert(dead, k) end end
    for _, k in ipairs(dead) do destroyCone(k) end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            local kR = k:FindFirstChild("HumanoidRootPart")
            local kH = k:FindFirstChildOfClass("Humanoid")
            if kR and kH and kH.Health > 0 then
                local s = getCone(k)
                local ab = activeBlocks[k]
                local cf = kR.CFrame; local look = cf.LookVector
                local yaw = math.atan2(-look.X, -look.Z)
                local half = ConeCfg.NormalAngle / 2
                local lA, rA = half, half
                if s.turnDir == 1 then lA = s.currentAngle - half elseif s.turnDir == -1 then rA = s.currentAngle - half end
                local inside = pHRP and inCone(kR, pHRP.Position, yaw, lA, rA) or false
                if ConeCfg.ShowBox then
                    updateCone(s, kR, dt, inside and ConeCfg.ColorHit or ConeCfg.Color)
                elseif not inside and s.currentAngle == ConeCfg.NormalAngle then hideCone(s) end
                if ab and inside and not ab.fired then ab.fired = true fireBlock() HDT_Fire(k) end
            else destroyCone(k) end
        end
    end
end)

