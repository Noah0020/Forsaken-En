local SA = { active=false, mode="Character", prediction=3, lockTime=0.7, animConn=nil, soundConns={} }
local SURVIVOR_ABILITY_NAMES = {"PUNCH","PARRY","SLASH","HATCHET","AXE","SACRIFICIAL DAGGER","SAC DAGGER","SACRIFICIAL","DAGGER","LUNGE","STAB"}
local function normalizeAbilityName(s)
    if type(s)~="string" then return "" end
    return s:upper():gsub("[%s_%-]","")
end
local SURVIVOR_ABILITY_NORMALIZED={}
for _,n in ipairs(SURVIVOR_ABILITY_NAMES) do SURVIVOR_ABILITY_NORMALIZED[normalizeAbilityName(n)]=true end
local function isSurvivorAbilityName(name) return SURVIVOR_ABILITY_NORMALIZED[normalizeAbilityName(name)]==true end
local SURVIVOR_ANIM_IDS, SURVIVOR_SOUND_IDS, SA_SCANNED = {}, {}, false
local _SA_aimConn=nil

local function scanSurvivorAbilityAssets(force)
    if SA_SCANNED and not force then return end
    if IsPlayerKiller() then return end
    SURVIVOR_ANIM_IDS={}; SURVIVOR_SOUND_IDS={}
    local assets=ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
    local survivors=assets:FindFirstChild("Survivors"); if not survivors then return end
    local function scanFolder(folder)
        if not folder then return end
        for _,cfgName in ipairs({"Config","Behavior"}) do
            local mod=folder:FindFirstChild(cfgName)
            if mod and mod:IsA("ModuleScript") then
                local ok,data=pcall(require,mod)
                if ok and type(data)=="table" then
                    if type(data.Animations)=="table" then
                        for name,v in pairs(data.Animations) do
                            if isSurvivorAbilityName(name) then
                                for _,id in ipairs(extractAnimIds(v)) do SURVIVOR_ANIM_IDS[id]=true; STAB_ANIM_IDS[id]=true end
                            end
                        end
                    end
                    for _,field in ipairs({"Sounds","Sound","SFX","Sfx"}) do
                        if type(data[field])=="table" then
                            for name,v in pairs(data[field]) do
                                if isSurvivorAbilityName(name) then
                                    for _,id in ipairs(extractAnimIds(v)) do SURVIVOR_SOUND_IDS[id]=true end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    for _,sFolder in ipairs(survivors:GetChildren()) do
        if sFolder:IsA("Folder") then pcall(scanFolder,sFolder) end
    end
    pcall(function()
        local skins=assets:FindFirstChild("Skins")
        local ss=skins and skins:FindFirstChild("Survivors")
        if ss then
            for _,base in ipairs(ss:GetChildren()) do
                if base:IsA("Folder") then
                    for _,skin in ipairs(base:GetChildren()) do
                        if skin:IsA("Folder") then pcall(scanFolder,skin) end
                    end
                end
            end
        end
    end)
    local ac=0; for _ in pairs(SURVIVOR_ANIM_IDS) do ac+=1 end
    print("[Vortex SA] Loaded", ac, "ability anims")
    SA_SCANNED=true
end

local function aimAtKiller(killer, duration)
    if IsPlayerKiller() or not killer or not killer.Parent then return end
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if _SA_aimConn then pcall(function() _SA_aimConn:Disconnect() end); _SA_aimConn=nil end
    local savedAR=hum.AutoRotate; hum.AutoRotate=false
    local startTime=tick(); local dur=math.max(0.2, duration or SA.lockTime)
    local released=false
    local function release()
        if released then return end; released=true
        if _SA_aimConn then pcall(function() _SA_aimConn:Disconnect() end); _SA_aimConn=nil end
        if hum and hum.Parent then pcall(function() hum.AutoRotate=savedAR end) end
    end
    _SA_aimConn=RunService.RenderStepped:Connect(function()
        if IsPlayerKiller() or not SA.active then release(); return end
        if not char.Parent or not hrp.Parent then release(); return end
        if tick()-startTime>dur then release(); return end
        local cur=killer:FindFirstChild("HumanoidRootPart"); if not cur then release(); return end
        local pred=SA.prediction or 0
        local targetPos=cur.Position
        local killerHum=killer:FindFirstChildOfClass("Humanoid")
        if pred>0 and killerHum and killerHum.MoveDirection.Magnitude>0.05 then
            targetPos=targetPos+killerHum.MoveDirection.Unit*pred
        end
        local lookCF=CFrame.lookAt(hrp.Position, Vector3.new(targetPos.X,hrp.Position.Y,targetPos.Z))
        if SA.mode=="Character" or SA.mode=="Both" then
            if (cur.Position-hrp.Position).Magnitude<6 then hrp.CFrame=lookCF
            else hrp.CFrame=hrp.CFrame:Lerp(lookCF,0.65) end
        end
        if SA.mode=="Camera" or SA.mode=="Both" then
            local cam=Workspace.CurrentCamera
            if cam then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,targetPos),0.75) end
        end
    end)
end

local function fireSurvivorAim(animLength)
    if not SA.active or IsPlayerKiller() then return end
    local killer=GetNearestKillerModel(); if not killer then return end
    local base=SA.lockTime or 0.7
    local extra=0
    if type(animLength)=="number" and animLength>base then extra=math.min(0.25,animLength-base) end
    task.spawn(function() aimAtKiller(killer, math.max(0.2, base+extra)) end)
end

local function attachSurvivorWatcher(char)
    if not char or not SA.active or IsPlayerKiller() then return end
    task.spawn(function()
        task.wait(0.4)
        if SA.animConn then pcall(function() SA.animConn:Disconnect() end); SA.animConn=nil end
        for _,c in ipairs(SA.soundConns) do pcall(function() c:Disconnect() end) end
        SA.soundConns={}
        scanSurvivorAbilityAssets(false)
        local hum=char:WaitForChild("Humanoid",5); if not hum then return end
        local animator=hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator",3)
        if animator then
            SA.animConn=animator.AnimationPlayed:Connect(function(track)
                if not SA.active or IsPlayerKiller() then return end
                local id=tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                if id and SURVIVOR_ANIM_IDS[id] then fireSurvivorAim(track.Length) end
            end)
        end
    end)
end

