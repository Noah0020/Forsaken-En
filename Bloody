local AB = { running=false, perKiller={}, lastBlock=0, lastFire=0 }

local function AB_GetBtn()
    local m = PlayerGui:FindFirstChild("MainUI")
    local ac = m and m:FindFirstChild("AbilityContainer")
    return ac and ac:FindFirstChild(Settings.AB_Mode == "007n7" and "Clone" or "Block")
end
local function AB_IsReady()
    local btn = AB_GetBtn(); if not btn then return true end
    local cd = btn:FindFirstChild("CooldownTime"); if not cd then return true end
    local t = cd.Text
    if t == nil or t == "" or t == " " then return true end
    local n = tonumber(t:match("^-?%d+%.?%d*"))
    return n and n <= 0 or false
end
local function AB_Fire()
    local now = tick()
    if now - AB.lastFire < 0.02 then return false end
    AB.lastFire = now
    local btn = AB_GetBtn()
    if firesignalF and btn then
        if pcall(firesignalF, btn.MouseButton1Click) then AB.lastBlock=tick(); return true end
    end
    if NetworkEvent then
        pcall(function() NetworkEvent:FireServer("UseActorAbility", "Block") end)
        pcall(function() NetworkEvent:FireServer("UseActorAbility", {"Block"}) end)
        AB.lastBlock = tick(); return true
    end
    return false
end
local function AB_ShouldBlock(killer)
    if not AB_IsFacingPlayer(killer) then return false end
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local kRoot = killer:FindFirstChild("HumanoidRootPart")
    if not myRoot or not kRoot then return false end
    return (myRoot.Position-kRoot.Position).Magnitude <= Settings.BoxRange
end
local function AB_Log(s, r)
    if Settings.AB_Debug then print("[Cupcake AB]", s, r) end
end

local hookedAnims   = setmetatable({}, { __mode="k" })
local hookedSounds  = setmetatable({}, { __mode="k" })
local hookedKillers = setmetatable({}, { __mode="k" })

local function OnKillerM1(killer, source)
    if not killer or not killer.Parent then return end
    if Settings.BoxVisualEnabled then Box_ShowOnM1(killer) end
    if not AB.running then return end
    if source=="anim"  and not Settings.AB_AnimDetect  then return end
    if source=="sound" and not Settings.AB_SoundDetect then return end
    if source=="attr"  and not Settings.AB_AttrDetect  then return end
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local deadline = tick() + (Settings.AB_PendingWindow or 0.35)
    local function attempt()
        if not AB.running or not killer.Parent then return end
        if not AB_IsReady() then
            AB_Log("retry", "cooldown")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end
        if not AB_ShouldBlock(killer) then
            AB_Log("retry", "facing/range")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end
        if not AB.perKiller[killer] then AB.perKiller[killer] = { lastFireAt=0 } end
        local st = AB.perKiller[killer]
        if tick() - st.lastFireAt < 0.05 then
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end
        st.lastFireAt = tick()
        AB_Fire()
        AB_Log("fire", "ok")
    end
    attempt()
end

local function HookAnimator(k, anim)
    if not anim or hookedAnims[anim] then return end
    hookedAnims[anim] = true
    anim.AnimationPlayed:Connect(function(track)
        local aid = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
        if aid and IS_BLOCK_ANIM[aid] then OnKillerM1(k, "anim") end
    end)
end
local function HookSound(s)
    if not s:IsA("Sound") or hookedSounds[s] then return end
    hookedSounds[s] = true
    local function handler()
        local killer = s:FindFirstAncestorOfClass("Model")
        if not killer or not killer.Parent then return end
        local sid = tostring(s.SoundId):match("%d+")
        if sid and TRIGGER_SOUNDS[sid] then OnKillerM1(killer, "sound") end
    end
    s.Played:Connect(handler); s.Playing:Connect(handler)
    if s.IsPlaying then handler() end
end
local function HookKiller(k)
    if not k:IsA("Model") or hookedKillers[k] then return end
    hookedKillers[k] = true
    local hum = k:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if anim then HookAnimator(k, anim) end
    for _, d in ipairs(k:GetDescendants()) do
        if d:IsA("Sound") then HookSound(d) end
        if d:IsA("Animator") then HookAnimator(k, d) end
    end
    k.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then HookSound(d) end
        if d:IsA("Animator") then HookAnimator(k, d) end
    end)
    pcall(function()
        k:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            OnKillerM1(k, "attr")
        end)
    end)
end
task.spawn(function()
    while not _ShuttingDown do
        task.wait(0.5)
        local kf = GetKillersFolder()
        if kf then
            for _, k in ipairs(kf:GetChildren()) do
                if k:IsA("Model") and k ~= LP.Character then HookKiller(k) end
            end
        end
    end
end)

