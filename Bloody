            Gen.gen += 1
            getgenv().GlobalAimbotToggle = false
            getgenv().ActiveLock.IsActive = false
            -- Destroy UI
            if FloatingGui then FloatingGui:Destroy() end
            if Fluent and Fluent.GUI then Fluent.GUI:Destroy() end
        end)
        Notify("Settings", "Hub fully unloaded")
        print("[UNSERIOUS HUB] Fully unloaded - all connections disconnected")
    end)
end

