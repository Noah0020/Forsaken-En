local Stam = { running = false, thread = nil, mod = nil, saved = nil, Infinite = false }
local function Stam_GetMod()
    local ok, m = pcall(function() return require(ReplicatedStorage.Systems.Character.Game.Sprinting) end)
    if ok and m then return m end
    ok, m = pcall(function() return require(ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Character"):WaitForChild("Game"):WaitForChild("Sprinting")) end)
    return ok and m or nil
end
local function Stam_EnsureMod()
    if Stam.mod then return Stam.mod end
    local m = Stam_GetMod()
    if m then
        Stam.mod = m
        Stam.saved = { MaxStamina=m.MaxStamina, SprintSpeed=m.SprintSpeed, StaminaGain=m.StaminaGain, StaminaDrain=m.StaminaDrain, StaminaRegenDelay=m.StaminaRegenDelay, Stamina=m.Stamina }
    end
    return m
end
local function Stam_ApplyOnce()
    local m = Stam_EnsureMod(); if not m then return end
    if Stam.MaxStamina ~= nil then m.MaxStamina = Stam.MaxStamina end
    if Stam.SprintSpeed ~= nil then m.SprintSpeed = Stam.SprintSpeed end
    if Stam.StaminaGain ~= nil then m.StaminaGain = Stam.StaminaGain end
    if Stam.StaminaDrain ~= nil then m.StaminaDrain = Stam.StaminaDrain end
    if Stam.StaminaRegenDelay ~= nil then m.StaminaRegenDelay = Stam.StaminaRegenDelay end
end
local function Stam_StartLoop()
    if Stam.running then return end
    Stam.running = true
    Stam.thread = task.spawn(function()
        while Stam.running and not _ShuttingDown do
            task.wait(0.01)
            local m = Stam.mod
            if m then
                pcall(function()
                    if Stam.MaxStamina ~= nil then m.MaxStamina = Stam.MaxStamina end
                    if Stam.SprintSpeed ~= nil then m.SprintSpeed = Stam.SprintSpeed end
                    if Stam.StaminaGain ~= nil then m.StaminaGain = Stam.StaminaGain end
                    if Stam.StaminaDrain ~= nil then m.StaminaDrain = Stam.StaminaDrain end
                    if Stam.StaminaRegenDelay ~= nil then m.StaminaRegenDelay = Stam.StaminaRegenDelay end
                    if Stam.Infinite then
                        m.Stamina = m.MaxStamina or 1000
                        if m.StaminaDrain ~= nil then m.StaminaDrain = 0 end
                    end
                end)
            end
        end
    end)
end
local function Stam_StopLoop()
    Stam.running = false
    if Stam.thread then pcall(task.cancel, Stam.thread); Stam.thread = nil end
end
local function Stam_Restore()
    if Stam.mod and Stam.saved then
        pcall(function()
            local m, s = Stam.mod, Stam.saved
            if s.MaxStamina ~= nil then m.MaxStamina = s.MaxStamina end
            if s.SprintSpeed ~= nil then m.SprintSpeed = s.SprintSpeed end
            if s.StaminaGain ~= nil then m.StaminaGain = s.StaminaGain end
            if s.StaminaDrain ~= nil then m.StaminaDrain = s.StaminaDrain end
            if s.StaminaRegenDelay ~= nil then m.StaminaRegenDelay = s.StaminaRegenDelay end
            if s.Stamina ~= nil then m.Stamina = s.Stamina end
        end)
    end
    Stam.MaxStamina, Stam.SprintSpeed, Stam.StaminaGain = nil, nil, nil
    Stam.StaminaDrain, Stam.StaminaRegenDelay, Stam.Infinite = nil, nil, false
end
local function Stam_SetInfinite(v)
    Stam.Infinite = v and true or false
    if Stam.Infinite then Stam_EnsureMod(); Stam_StartLoop()
    else Stam_StopLoop(); Stam_ApplyOnce() end
end
local function Stam_SetField(field, v)
    local n = tonumber(v); if not n then return end
    Stam[field] = n; Stam_EnsureMod(); Stam_ApplyOnce()
end
local STAM_DEFAULT = { MaxStamina = 100, SprintSpeed = 26, StaminaGain = 20, StaminaDrain = 10, StaminaRegenDelay = 0.5 }
do
    local m = Stam_GetMod()
    if m then
        if m.MaxStamina ~= nil then STAM_DEFAULT.MaxStamina = m.MaxStamina end
        if m.SprintSpeed ~= nil then STAM_DEFAULT.SprintSpeed = m.SprintSpeed end
        if m.StaminaGain ~= nil then STAM_DEFAULT.StaminaGain = m.StaminaGain end
        if m.StaminaDrain ~= nil then STAM_DEFAULT.StaminaDrain = m.StaminaDrain end
        if m.StaminaRegenDelay ~= nil then STAM_DEFAULT.StaminaRegenDelay = m.StaminaRegenDelay end
        Stam.mod = m
        Stam.saved = { MaxStamina=m.MaxStamina, SprintSpeed=m.SprintSpeed, StaminaGain=m.StaminaGain, StaminaDrain=m.StaminaDrain, StaminaRegenDelay=m.StaminaRegenDelay, Stamina=m.Stamina }
    end
end

