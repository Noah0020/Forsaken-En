local function IsPlayerKiller()
    local c = LP.Character; if not c then return false end
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if kf and c:IsDescendantOf(kf) then return true end
    return KILLER_NAMES[c:GetAttribute("CharacterName") or c.Name] == true
end

local function GetNearestKillerModel(maxDist)
    local char = LP.Character; if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart"); if not my then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

local function GetNearestSurvivorModel(maxDist, mode)
    local char = LP.Character; if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart"); if not my then return nil end
    local sf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not sf then return nil end
    local best, score = nil, (mode == "Lowest HP") and math.huge or (maxDist or math.huge)
    for _, m in ipairs(sf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if mode == "Lowest HP" then
                    if d <= (maxDist or 9999) and h.Health < score then score = h.Health; best = m end
                elseif d < score then score = d; best = m end
            end
        end
    end
    return best
end

local function extractAnimIds(v, depth)
    depth = depth or 0
    if depth > 6 then return {} end
    local o = {}
    local t = type(v)
    if t == "string" or t == "number" then
        local id = tostring(v):match("%d+")
        if id then table.insert(o, id) end
    elseif t == "table" then
        for _, x in pairs(v) do for _, id in ipairs(extractAnimIds(x, depth+1)) do table.insert(o, id) end end
    end
    return o
end

