local function createAnimationTrigger(moduleName,animIds,targetType,useCamera)
    local isActive=false local animConn=nil local charConn=nil
    local function getTarget()
        if targetType then
            local folder=workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(targetType)
            if not folder then return nil end
            local char=game.Players.LocalPlayer.Character; if not char then return nil end
            local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
            local closest,cd=nil,math.huge
            for _,model in ipairs(folder:GetChildren()) do if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") and model~=char then local d=(model.HumanoidRootPart.Position-hrp.Position).Magnitude if d<cd and d<=settings.distance then cd=d closest=model end end end
            return closest
        end
        return getNearestTarget()
    end
    local function doSnap()
        local char=game.Players.LocalPlayer.Character; if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid") local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local target=getTarget(); if not target then return end
        local trgHRP=target:FindFirstChild("HumanoidRootPart"); if not trgHRP then return end
        local rawPos=trgHRP.Position
        local vel=trgHRP.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude>60 then vel=vel.Unit*60 end
        local pred=rawPos+vel*(settings.aimPrediction*0.03)
        if useCamera then local cam=workspace.CurrentCamera if cam then cam.CFrame=CFrame.lookAt(cam.CFrame.Position,pred) end
        else
            local dir=pred-hrp.Position local flat=Vector3.new(dir.X,0,dir.Z)
            if flat.Magnitude>0.01 then
                flat=flat.Unit local ncf=CFrame.lookAt(hrp.Position,hrp.Position+flat)
                local wa=hum and hum.AutoRotate if hum then hum.AutoRotate=false end
                pcall(function() char:PivotTo(ncf) end) pcall(function() hrp.CFrame=ncf end)
                task.delay(0.15,function() if hum and hum.Parent then hum.AutoRotate=wa end end)
            end
        end
    end
    local function onAnimPlayed(track)
        if not isActive then return end
        local aid=track.Animation and track.Animation.AnimationId; if not aid then return end
        local num=tostring(aid):match("%d+")
        if num and animIds[num] then doSnap() end
    end
    local function attach(char)
        if not char or not isActive then return end
        local hum=char:WaitForChild("Humanoid",3); if not hum then return end
        local anim=hum:FindFirstChildOfClass("Animator") if not anim then anim=Instance.new("Animator"); anim.Parent=hum end
        if animConn then pcall(function() animConn:Disconnect() end) end
        animConn=anim.AnimationPlayed:Connect(onAnimPlayed)
    end
    local function enable()
        if isActive then return end
        isActive=true
        local p=game.Players.LocalPlayer
        if p.Character then attach(p.Character) end
        if charConn then pcall(function() charConn:Disconnect() end) end
        charConn=p.CharacterAdded:Connect(function(c) task.wait(0.1); attach(c) end)
    end
    local function disable()
        isActive=false
        if animConn then pcall(function() animConn:Disconnect() end); animConn=nil end
        if charConn then pcall(function() charConn:Disconnect() end); charConn=nil end
    end
    registerTriggerModule(moduleName,enable,disable)
end

