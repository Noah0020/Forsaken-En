                            end
                            add("Guest1337", a.Punch); add("Guest1337", a.ParryPunch)
                            add("Shedlekey", a.Slash); add("JaneDoe", a.Axe)
                            add("Chance", a.AimGun); add("Chance", a.Shoot)
                        end
                    end
                end
            end
        end
    end)

    getgenv().ActiveLock = { IsActive=false, Target=nil, StartTime=0, Mode="", Track=nil }
    getgenv().LastFinishedTrack = nil
    getgenv().GlobalAimbotToggle = false
    getgenv().GlobalAimlockMode = "Character Lock"

    local function startLock(modeKey, track)
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then return end
        local cfg = getgenv().AimbotValues[modeKey]
        if not cfg or not cfg.Enabled or getgenv().ActiveLock.IsActive then return end
        if track and track == getgenv().LastFinishedTrack then return end
        local target = GetNearestKiller(cfg.Distance or 50)
        if not target then return end
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        getgenv().ActiveLock.IsActive = true
        getgenv().ActiveLock.Target = target
        getgenv().ActiveLock.StartTime = tick()
        getgenv().ActiveLock.Mode = modeKey
        getgenv().ActiveLock.Track = track
        if hum then hum.AutoRotate = false end
        local tRoot = target:FindFirstChild("HumanoidRootPart")
        if tRoot then
            if (cfg.Prediction or 0) > 0 then AimCore.prediction = cfg.Prediction * 0.05 end
            SyncAimbot(tRoot, cfg.LockDuration or 1)
        end
    end

    local function tryTrack(track)
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId):match("%d+")
        if not id then return end
        for modeKey, idMap in pairs(getgenv().AnimationData) do
            local cfg = getgenv().AimbotValues[modeKey]
            if cfg and cfg.Enabled and idMap[id] then startLock(modeKey, track); return end
        end
    end

    local function hookChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10)
            if not hum then return end
            local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 6)
            if animator then animator.AnimationPlayed:Connect(tryTrack) end
        end)
    end
    if LP.Character then hookChar(LP.Character) end
    LP.CharacterAdded:Connect(hookChar)

    task.spawn(function()
        pcall(function()
            if typeof(hookmetamethod) ~= "function" then return end
            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                local args = {...}
                if method == "FireServer" and args[1] == "UseActorAbility" then
                    local ability = args[2]
                    local name = type(ability) == "table" and ability[1] or ability
                    if name == "Shoot" and ChanceAim.enabled and getgenv().GlobalAimbotToggle
                        and getgenv().AimbotValues.Chance and getgenv().AimbotValues.Chance.Enabled then
                        local k = GetNearestKiller(math.huge)
                        local root = k and k:FindFirstChild("HumanoidRootPart")
                        if root then
                            task.spawn(function()
                                AimCore.prediction = getgenv().AimbotValues.Chance.Prediction * 0.05
                                SyncAimbot(root, getgenv().AimbotValues.Chance.LockDuration or 1.5)
                            end)
                        end
                    end
                end
                return old(self, ...)
            end)
        end)
    end)

    RunService.Heartbeat:Connect(function()
        if not getgenv().GlobalAimbotToggle or getgenv().ActiveLock.IsActive or IsPlayerKiller() then return end
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return end
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying then tryTrack(track); if getgenv().ActiveLock.IsActive then break end end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not getgenv().ActiveLock.IsActive then return end
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then
            getgenv().ActiveLock.IsActive = false
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
            return
        end
        local character = LP.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then getgenv().ActiveLock.IsActive = false; return end
        local cfg = getgenv().AimbotValues[getgenv().ActiveLock.Mode]
        if not cfg then getgenv().ActiveLock.IsActive = false; humanoid.AutoRotate = true; return end
        local elapsed = tick() - getgenv().ActiveLock.StartTime
        local target = getgenv().ActiveLock.Target
        local tHRP = target and target:FindFirstChild("HumanoidRootPart")
        local tHum = target and target:FindFirstChildOfClass("Humanoid")
        if not tHRP or (tHum and tHum.Health <= 0) then
            target = GetNearestKiller(cfg.Distance or 50)
            getgenv().ActiveLock.Target = target
            tHRP = target and target:FindFirstChild("HumanoidRootPart")
            tHum = target and target:FindFirstChildOfClass("Humanoid")
        end
        if elapsed > (cfg.LockDuration or 1) or not tHRP then
            getgenv().LastFinishedTrack = getgenv().ActiveLock.Track
            getgenv().ActiveLock.IsActive = false
            getgenv().ActiveLock.Target = nil
            getgenv().ActiveLock.Track = nil
            humanoid.AutoRotate = true
            return
        end
        local position = PredictNext(tHRP)
        local pred = cfg.Prediction or 0
        if pred > 0 and tHum and tHum.MoveDirection.Magnitude > 0.05 then
            position = position + tHum.MoveDirection.Unit * pred
        end
        local lookAt = Vector3.new(position.X, hrp.Position.Y, position.Z)
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, lookAt), AimCore.easing)
        if getgenv().GlobalAimlockMode == "Char + Cam Lock" then
            local cam = Workspace.CurrentCamera
            if cam then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, position), 0.85) end
        end
    end)

    Tabs.Aim:AddSection("Aim Settings")
    Tabs.Aim:AddToggle("Aim_Enable", {
