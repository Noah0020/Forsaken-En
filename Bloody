local function safeCall(fn, ...)
    if type(fn) ~= "function" then return false end
    local ok, result = pcall(fn, ...)
    if not ok then warn("[Doggysaken] " .. tostring(result)) end
    return ok, result
end

local function addGroup(tab, side, name, description, icon)
    return tab:AddGroupbox({
        Side = side,
        Name = name,
        Description = description,
        IconName = icon,
    })
end

local function addToggle(group, index, title, default, callback, tooltip)
    return group:AddToggle(index, {
        Text = title,
        Default = default == true,
        Tooltip = tooltip,
        Callback = function(value)
            if callback then safeCall(callback, value) end
        end,
    })
end

local function addSlider(group, index, title, settingKey, minimum, maximum, rounding, callback, suffix)
    local initial = tonumber(Settings[settingKey]) or minimum
    initial = math.clamp(initial, minimum, maximum)
    Settings[settingKey] = initial
    local slider = group:AddSlider(index, {
        Text = title,
        Default = initial,
        Min = minimum,
        Max = maximum,
        Rounding = rounding or 0,
        Suffix = suffix or "",
        Callback = function(value)
            Settings[settingKey] = value
            if callback then safeCall(callback, value) end
        end,
    })
    if callback then safeCall(callback, initial) end
    return slider
end

local function addDropdown(group, index, title, values, default, callback, multi)
    return group:AddDropdown(index, {
        Text = title,
        Values = values,
        Default = default,
        Multi = multi == true,
        MaxVisibleDropdownItems = 10,
        Callback = function(value)
            if callback then safeCall(callback, value) end
        end,
    })
end

local function addButton(group, title, callback, tooltip)
    return group:AddButton({
        Text = title,
        Func = function() safeCall(callback) end,
        Tooltip = tooltip,
    })
end

