local settings = { distance = 100, smoothness = 20, duration = 50, targetPath = "auto", globalSound = false, silentAim = false, aimPrediction = 4 }
local triggerConnections = {}
local modules = {}

local function registerTriggerModule(name, enableFunc, disableFunc)
    modules[name] = { enabled = false, enable = enableFunc, disable = disableFunc }
end

local function toggleModule(name, state)
    local mod = modules[name]; if not mod then return end
    if state and not mod.enabled then
        if mod.enable then pcall(mod.enable) end
        mod.enabled = true
    elseif not state and mod.enabled then
        if mod.disable then pcall(mod.disable) end
        mod.enabled = false
    end
end

local function getNearestTarget()
    local player = game.Players.LocalPlayer
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myHRP = player.Character.HumanoidRootPart
    local nearest, nearestDist = nil, math.huge
    local targetContainer = nil
    local path = settings.targetPath
    if path == "auto" then
        local candidates = { workspace:FindFirstChild("Players"), workspace:FindFirstChild("Characters"), workspace:FindFirstChild("Living") }
        for _, container in ipairs(candidates) do
            if container and (container:IsA("Folder") or container:IsA("Model")) then
                local hasPlayer = false
                for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("Model") and child:FindFirstChild("HumanoidRootPart") then hasPlayer = true; break end
                end
                if hasPlayer then targetContainer = container; break end
            end
        end
        if not targetContainer then targetContainer = workspace end
    else
        local parts = {}
        for part in string.gmatch(path, "[^%.]+") do table.insert(parts, part) end
        local cur = _G
        for _, part in ipairs(parts) do cur = cur[part]; if not cur then break end end
        targetContainer = cur or workspace
    end
    local function processModel(model)
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            if model == player.Character then return end
            local hrp = model.HumanoidRootPart
            local dist = (hrp.Position - myHRP.Position).Magnitude
            if dist < nearestDist and dist <= settings.distance then nearestDist = dist; nearest = model end
        end
    end
    if targetContainer == workspace then
        for _, child in ipairs(workspace:GetChildren()) do processModel(child) end
    else
        for _, child in ipairs(targetContainer:GetChildren()) do processModel(child) end
    end
    return nearest
end

local function SmoothCameraLookAt(currentCamCF, targetPos, progress)
    local targetLook = (targetPos - currentCamCF.Position).Unit
    local currentLook = currentCamCF.LookVector
    local newLook = currentLook:Lerp(targetLook, progress)
    return CFrame.lookAt(currentCamCF.Position, currentCamCF.Position + newLook * 100)
end

local activeAimConnection = nil
local function executeAim()
    if activeAimConnection then activeAimConnection:Disconnect(); activeAimConnection = nil end
    local target = getNearestTarget()
    if not target or not target:FindFirstChild("HumanoidRootPart") then return end
    local totalFrames = settings.duration
    local smoothPower = settings.smoothness / 100
    local currentFrame = 0
    local conn
    conn = RunService.RenderStepped:Connect(function()
        currentFrame = currentFrame + 1
        local progress = math.clamp(currentFrame / totalFrames, 0, 1)
        progress = progress ^ (1 - smoothPower)
        if currentFrame <= totalFrames then
            local currentCamCF = workspace.CurrentCamera.CFrame
            workspace.CurrentCamera.CFrame = SmoothCameraLookAt(currentCamCF, target.HumanoidRootPart.Position, progress)
        else
            conn:Disconnect()
            if activeAimConnection == conn then activeAimConnection = nil end
        end
    end)
    activeAimConnection = conn
end

--═══ KILLER AIM (animation-based) ═══
local function createAnimationTrigger(moduleName, animIds, targetType, useCamera)
    local isActive = false
    local animConn = nil
    local charConn = nil
    local function getTarget()
        if targetType then
            local folder = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(targetType)
            if not folder then return nil end
            local char = game.Players.LocalPlayer.Character
            if not char then return nil end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            local closest, closestDist = nil, math.huge
            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") and model ~= char then
                    local dist = (model.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < closestDist and dist <= settings.distance then closestDist = dist; closest = model end
                end
            end
            return closest
        end
        return getNearestTarget()
    end
    local function doSnap()
        local char = game.Players.LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local target = getTarget()
        if not target then return end
        local targetHRP = target:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end
        local rawPos = targetHRP.Position
        local vel = targetHRP.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        local predictedPos = rawPos + vel * (settings.aimPrediction * 0.03)
        if useCamera then
            local cam = workspace.CurrentCamera
            if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, predictedPos) end
        else
            local direction = predictedPos - hrp.Position
            local flatDir = Vector3.new(direction.X, 0, direction.Z)
            if flatDir.Magnitude > 0.01 then
                flatDir = flatDir.Unit
                local newCF = CFrame.lookAt(hrp.Position, hrp.Position + flatDir)
                local wasAuto = hum and hum.AutoRotate
                if hum then hum.AutoRotate = false end
                pcall(function() char:PivotTo(newCF) end)
                pcall(function() hrp.CFrame = newCF end)
                task.delay(0.15, function()
                    if hum and hum.Parent then hum.AutoRotate = wasAuto end
                end)
            end
        end
    end
    local function onAnimationPlayed(track)
        if not isActive then return end
        local aid = track.Animation and track.Animation.AnimationId
        if not aid then return end
        local numericId = tostring(aid):match("%d+")
        if numericId and animIds[numericId] then doSnap() end
    end
    local function attachToChar(char)
        if not char or not isActive then return end
        local hum = char:WaitForChild("Humanoid", 3)
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
        if animConn then pcall(function() animConn:Disconnect() end) end
        animConn = animator.AnimationPlayed:Connect(onAnimationPlayed)
    end
    local function enable()
        if isActive then return end
        isActive = true
        local player = game.Players.LocalPlayer
        if player.Character then attachToChar(player.Character) end
        if charConn then pcall(function() charConn:Disconnect() end) end
        charConn = player.CharacterAdded:Connect(function(c) task.wait(0.1); attachToChar(c) end)
    end
    local function disable()
        isActive = false
        if animConn then pcall(function() animConn:Disconnect() end); animConn = nil end
        if charConn then pcall(function() charConn:Disconnect() end); charConn = nil end
    end
    registerTriggerModule(moduleName, enable, disable)
end

--═══ SURVIVOR AIM (button-based, frame-locked) ═══
local activeSnapConn = nil
local activeSnapHum = nil
local activeSnapWasAuto = true

local function findClosestTargetHRP(targetType, excludeChar, fromPos, maxDist)
    local folder = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(targetType)
    if not folder then return nil end
    local best, bd = nil, maxDist
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= excludeChar then
            local trg = model:FindFirstChild("HumanoidRootPart")
            local h = model:FindFirstChildOfClass("Humanoid")
            if trg and h and h.Health > 0 then
                local d = (trg.Position - fromPos).Magnitude
                if d < bd then bd = d; best = trg end
            end
        end
    end
    return best
end

local function stopSnapLock()
    if activeSnapConn then pcall(function() activeSnapConn:Disconnect() end); activeSnapConn = nil end
    if activeSnapHum and activeSnapHum.Parent then
        pcall(function() activeSnapHum.AutoRotate = activeSnapWasAuto end)
    end
    activeSnapHum = nil
end

local function performSnap(targetType, useCamera)
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local targetHRP = findClosestTargetHRP(targetType, char, hrp.Position, settings.distance)
    if not targetHRP then return end
    stopSnapLock()
    if useCamera then
        local cam = workspace.CurrentCamera
        local vel = targetHRP.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        local predicted = targetHRP.Position + vel * (settings.aimPrediction * 0.03)
        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, predicted) end
        if hum then
            activeSnapHum = hum
            activeSnapWasAuto = hum.AutoRotate
            hum.AutoRotate = false
            task.delay(0.35, stopSnapLock)
        end
        return
    end
    if hum then
        activeSnapHum = hum
        activeSnapWasAuto = hum.AutoRotate
        hum.AutoRotate = false
    end
    local startT = tick()
    local lockDuration = 0.5
    activeSnapConn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent then stopSnapLock(); return end
        if tick() - startT > lockDuration then stopSnapLock(); return end
        local target = findClosestTargetHRP(targetType, char, hrp.Position, settings.distance)
        if not target then return end
        local vel = target.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        local predicted = target.Position + vel * (settings.aimPrediction * 0.03)
        local dx = predicted.X - hrp.Position.X
        local dz = predicted.Z - hrp.Position.Z
        if dx * dx + dz * dz > 0.01 then
            local len = math.sqrt(dx * dx + dz * dz)
            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + Vector3.new(dx / len, 0, dz / len))
        end
    end)
end

