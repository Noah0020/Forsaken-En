}

local BoxState = {
    killers     = {},
    player      = nil,
    killerBoxes = {},
    playerBox   = nil,
    rootFolder  = nil,
    renderConn  = nil,
}

local function Box_GetRootFolder()
    local f = BoxState.rootFolder
    if f and f.Parent then return f end
    if f and not f.Parent then pcall(function() f:Destroy() end) end
    local folder = Instance.new("Folder")
    folder.Name = "FMO_BoxVisuals"
    folder.Parent = Workspace
    BoxState.rootFolder = folder
    return folder
end

local function Box_DestroyRootFolder()
    local f = BoxState.rootFolder
    if f then pcall(function() f:Destroy() end); BoxState.rootFolder = nil end
end

local function Box_Alpha(dt)
    return 1 - math.exp(-dt / math.max(Settings.BoxFollowDelay, 0.001))
end

local function Box_UpdateSmoothing(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if not BoxState.player then
            BoxState.player = hrp.Position
        else
            BoxState.player = BoxState.player:Lerp(hrp.Position, Box_Alpha(dt))
        end
    end

    local kf = GetKillersFolder()
    if kf then
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") then
                local khrp = k:FindFirstChild("HumanoidRootPart")
                if khrp then
                    local st = BoxState.killers[k]
                    if not st then
                        st = {
                            pos = khrp.Position,
                            look = khrp.CFrame.LookVector,
                            facingDot = 0,
                            lastFacingDot = 0,
                            turnRate = 0,
                            angularVel = 0,
                        }
                        BoxState.killers[k] = st
                    else
                        local a = Box_Alpha(dt)
                        st.pos = st.pos:Lerp(khrp.Position, a)
                        local nl = khrp.CFrame.LookVector
                        st.look = st.look:Lerp(nl, a)
                        if st.look.Magnitude > 0.01 then st.look = st.look.Unit else st.look = nl.Unit end

                        -- Angular velocity for anti-spin (SKIDSAKEN style)
                        local prevLook = st.look
                        local cross = prevLook:Cross(nl)
                        st.angularVel = cross.Magnitude / math.max(dt, 0.001)
                    end

                    if BoxState.player then
                        local toPlayer = BoxState.player - st.pos
                        local fl = Vector3.new(st.look.X, 0, st.look.Z)
                        local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                        if fl.Magnitude > 0.01 and ft.Magnitude > 0.01 then
                            local dot = fl.Unit:Dot(ft.Unit)
                            st.lastFacingDot = st.facingDot or dot
                            st.facingDot = dot
                            st.turnRate = (st.facingDot - st.lastFacingDot) / math.max(dt, 0.001)
                        end
                    end
                else
                    BoxState.killers[k] = nil
                end
            end
        end
    end

    for k in pairs(BoxState.killers) do
        if not k.Parent then BoxState.killers[k] = nil end
    end
end

local function AB_IsFacingPlayer(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end
    local toPlayer = BoxState.player - st.pos
    if toPlayer.Magnitude < 0.5 then return false end
    local fl = Vector3.new(st.look.X, 0, st.look.Z)
    local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    if fl.Magnitude < 0.01 or ft.Magnitude < 0.01 then return false end
    return fl.Unit:Dot(ft.Unit) >= Settings.BoxFacingDot
end

local function AB_ShouldBlock(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end

    local toPlayer = BoxState.player - st.pos
    local dist = toPlayer.Magnitude
    if dist > Settings.BoxRange or dist < 0.4 then return false end

    local fl = Vector3.new(st.look.X, 0, st.look.Z)
    local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    if fl.Magnitude < 0.01 or ft.Magnitude < 0.01 then return false end
    local facingDot = fl.Unit:Dot(ft.Unit)

    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if khrp then
        local kv = khrp.AssemblyLinearVelocity
        if kv.Magnitude > Settings.BoxFastThreshold then
            local fv = Vector3.new(kv.X, 0, kv.Z)
            if fv.Magnitude > 0.5 and fv.Unit:Dot(ft.Unit) < Settings.BoxFastDot then
                return false
            end
        end
    end

    local blockLen = math.max(Settings.BoxRange - Settings.BoxBlockDistance, 0.5)
    local alongLook = ft:Dot(fl.Unit)
    if alongLook > (blockLen + Settings.BoxBlockDistance + Settings.BoxOffset) then return false end

    if facingDot >= Settings.BoxFacingDot then return true end

    -- Anti-bait / anti-spin (SKIDSAKEN style)
    if Settings.BoxAntiBait then
        if st.turnRate and st.turnRate > Settings.BoxTurnRate then
            if facingDot >= 0.12 then return true end
        end
        if st.angularVel and st.angularVel > 4.5 and facingDot >= 0.08 then
            return true
        end
    end

    return false
end

-- Wireframe helpers
local _WIRE = nil
local function GetWire()
    if _WIRE then return _WIRE end
    local c = {
        Vector3.new(-0.5,-0.5,-0.5), Vector3.new(0.5,-0.5,-0.5),
        Vector3.new(0.5,-0.5,0.5),  Vector3.new(-0.5,-0.5,0.5),
        Vector3.new(-0.5,0.5,-0.5),  Vector3.new(0.5,0.5,-0.5),
        Vector3.new(0.5,0.5,0.5),   Vector3.new(-0.5,0.5,0.5),
    }
    local e = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    _WIRE = { corners = c, edges = e }
    return _WIRE
end

local function Box_CreateWireframe(parent)
    local wire = GetWire()
    local parts = {}
    for i, e in ipairs(wire.edges) do
        local part = Instance.new("Part")
        part.Name = "FMO_BoxEdge"
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Transparency = 1
        part.Parent = parent
        parts[i] = { part = part, c1 = wire.corners[e[1]], c2 = wire.corners[e[2]] }
    end
    return parts
end

local function Box_IsWireframeValid(parts)
    if not parts or #parts == 0 then return false end
    for _, p in ipairs(parts) do
        if not p.part or not p.part.Parent then return false end
    end
    return true
end

local function Box_DestroyWireframe(parts)
    if not parts then return end
    for _, p in ipairs(parts) do
        if p.part then pcall(function() p.part:Destroy() end) end
    end
end

local function Box_UpdateWireframe(parts, cf, size, color)
    local t = Settings.BoxTransparency
    for _, p in ipairs(parts) do
        if p.part and p.part.Parent then
            local a = cf:PointToWorldSpace(Vector3.new(p.c1.X*size.X, p.c1.Y*size.Y, p.c1.Z*size.Z))
            local b = cf:PointToWorldSpace(Vector3.new(p.c2.X*size.X, p.c2.Y*size.Y, p.c2.Z*size.Z))
            local len = (b - a).Magnitude
            if len > 0.001 then
                p.part.Transparency = t
                p.part.Color = color
                p.part.Size = Vector3.new(0.055, 0.055, len)
                p.part.CFrame = CFrame.lookAt((a+b)/2, b)
            else
                p.part.Transparency = 1
            end
        end
    end
end

local function Box_HideWireframe(parts)
    if not parts then return end
    for _, p in ipairs(parts) do
        if p.part and p.part.Parent then p.part.Transparency = 1 end
    end
end

local function Box_GetKillerBox(killer)
    local b = BoxState.killerBoxes[killer]
    if b and Box_IsWireframeValid(b.parts) then return b end
    if b then Box_DestroyWireframe(b.parts) end
    local parts = Box_CreateWireframe(Box_GetRootFolder())
    b = { parts = parts, showUntil = 0 }
    BoxState.killerBoxes[killer] = b
    return b
end

local function Box_GetPlayerBox()
    local pb = BoxState.playerBox
    if pb and Box_IsWireframeValid(pb.parts) then return pb end
    if pb then Box_DestroyWireframe(pb.parts) end
    local parts = Box_CreateWireframe(Box_GetRootFolder())
    pb = { parts = parts, showUntil = 0 }
    BoxState.playerBox = pb
    return pb
end

local function Box_ShowOnM1(killer)
    if not Settings.AB_ShowZone then return end
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp then return end
    local chrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not chrp then return end

    local existing = BoxState.killers[killer]
    if existing then
        existing.pos = khrp.Position
        existing.look = khrp.CFrame.LookVector
    else
        BoxState.killers[killer] = {
            pos = khrp.Position, look = khrp.CFrame.LookVector,
            facingDot = 0, lastFacingDot = 0, turnRate = 0, angularVel = 0
        }
    end
    BoxState.player = chrp.Position

    local now = os.clock()
    Box_GetKillerBox(killer).showUntil = now + Settings.BoxDisplayDuration
    if (chrp.Position - khrp.Position).Magnitude <= Settings.BoxRange then
        Box_GetPlayerBox().showUntil = now + Settings.BoxDisplayDuration
    end
end

local function Box_RenderAll()
    if not Settings.AB_ShowZone then
        for _, box in pairs(BoxState.killerBoxes) do Box_HideWireframe(box.parts) end
        if BoxState.playerBox then Box_HideWireframe(BoxState.playerBox.parts) end
        return
    end

    local now = os.clock()
    local blockLen = math.max(Settings.BoxRange - Settings.BoxBlockDistance, 0.5)

    for killer, box in pairs(BoxState.killerBoxes) do
        if not killer.Parent then
            Box_DestroyWireframe(box.parts)
            BoxState.killerBoxes[killer] = nil
        elseif not Box_IsWireframeValid(box.parts) then
            Box_DestroyWireframe(box.parts)
            box.parts = {}
        elseif now > box.showUntil then
            Box_HideWireframe(box.parts)
        else
            local st = BoxState.killers[killer]
            if st then
                local size = Vector3.new(Settings.BoxKillerW, Settings.BoxKillerH, blockLen)
                local center = st.pos + st.look * (blockLen / 2 + Settings.BoxOffset)
                local cf = CFrame.lookAt(center, center + st.look)

                local color = Settings.BoxColorNeutral
                if AB_IsFacingPlayer(killer) then
                    color = Settings.BoxColorFacing
                elseif Settings.BoxAntiBait and st.turnRate and st.turnRate > Settings.BoxTurnRate * 0.7 then
                    color = Settings.BoxColorBait
                end

                Box_UpdateWireframe(box.parts, cf, size, color)
            else
                Box_HideWireframe(box.parts)
            end
        end
    end

    local pb = BoxState.playerBox
    if pb then
        if not Box_IsWireframeValid(pb.parts) then
            Box_DestroyWireframe(pb.parts)
            pb.parts = {}
        elseif now > pb.showUntil or not BoxState.player then
            Box_HideWireframe(pb.parts)
        else
            local s = Settings.BoxBlockDistance * 2
            Box_UpdateWireframe(pb.parts, CFrame.new(BoxState.player), Vector3.new(s,s,s), Settings.BoxColorNeutral)
        end
    end
end

local function Box_StartRender()
    if BoxState.renderConn then return end
    BoxState.renderConn = RunService.RenderStepped:Connect(function(dt)
        Box_UpdateSmoothing(dt or 0.016)
        Box_RenderAll()
    end)
end

local function Box_StopRender()
    if BoxState.renderConn then
        pcall(function() BoxState.renderConn:Disconnect() end)
        BoxState.renderConn = nil
    end
end

Box_StartRender()

LocalPlayer.CharacterAdded:Connect(function()
    BoxState.player = nil
    if BoxState.playerBox and BoxState.playerBox.parts then
        Box_HideWireframe(BoxState.playerBox.parts)
    end
end)

