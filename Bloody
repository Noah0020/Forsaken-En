local genThread
local function solveGen()
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local map = workspace:FindFirstChild("Map")
    map = map and map:FindFirstChild("Ingame") and map.Ingame:FindFirstChild("Map")
    if not map then return end
    for _, gen in ipairs(map:GetChildren()) do
        if gen.Name == "Generator" then
            local main = gen:FindFirstChild("Main") or gen.PrimaryPart
            if main and (main.Position - char.PrimaryPart.Position).Magnitude < 8 then
                local remotes = gen:FindFirstChild("Remotes")
                local re = remotes and remotes:FindFirstChildOfClass("RemoteEvent")
                if re and LocalPlayer.PlayerGui:FindFirstChild("PuzzleUI") then
                    re:FireServer(); return true
                end
            end
        end
    end
end
local function setAutoGen(on)
    C.AutoGen = on
    if genThread then task.cancel(genThread); genThread = nil end
    if on then
        genThread = task.spawn(function()
            while C.AutoGen do pcall(solveGen); task.wait(C.GenCD) end
            genThread = nil
        end)
        Notify("Auto Gen ON")
    end
end

