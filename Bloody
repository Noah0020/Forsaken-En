local function AM1_IsGuest(s) return s.Name:gsub("%s+",""):lower() == "guest1337" end
local function AM1_InZone(s, myRoot)
    local r = s:FindFirstChild("HumanoidRootPart"); if not r then return false end
    if Settings.AM1_UseFacing then
        local boxCF = myRoot.CFrame * CFrame.new(0, 0, -Settings.AM1_FacingZ/2)
        local rel = boxCF:PointToObjectSpace(r.Position)
        return math.abs(rel.X) <= Settings.AM1_FacingX/2
           and math.abs(rel.Y) <= Settings.AM1_FacingY/2
           and math.abs(rel.Z) <= Settings.AM1_FacingZ/2
    end
    local dx = r.Position.X - myRoot.Position.X
    local dz = r.Position.Z - myRoot.Position.Z
    return math.sqrt(dx*dx + dz*dz) <= Settings.AM1_Range
end
local function AM1_Trigger(useAll)
    if not NetworkEvent then return end
    if useAll then
        for _, name in ipairs(AM1_Abilities) do FireAbilityBuf(name) end
    else
        for _, name in ipairs(AM1_Abilities) do FireAbilityBuf(name) end
    end
end
