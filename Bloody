        Callback = function(v) Silent.crystalY = v end,
    })

    local d = TabSilent:Section("Dusekkar")
    d:Toggle({
        Name = "Dusekkar Silent Aim",
        Default = false,
        Callback = function(v) Silent.dusk = v; if v then install() end end,
    })
