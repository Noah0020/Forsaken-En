RunService.RenderStepped:Connect(function(dt)
    local kf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not AutoBlockEnabled or not kf then for _,s in pairs(ConeState) do hideCone(s) end return end
    local char=LP.Character local pHRP=char and char:FindFirstChild("HumanoidRootPart") local now=os.clock()
    local exp={} for k,d in pairs(activeBlocks) do if now>d.expiresAt or not k.Parent then table.insert(exp,k) end end
    for _,k in ipairs(exp) do activeBlocks[k]=nil end
    local dead={} for k in pairs(ConeState) do if not k.Parent then table.insert(dead,k) end end
    for _,k in ipairs(dead) do destroyCone(k) end
    for _,killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") then
            local kR=killer:FindFirstChild("HumanoidRootPart") local kH=killer:FindFirstChildOfClass("Humanoid")
            if kR and kH and kH.Health>0 then
                local st=getOrCreateCone(killer) local ab=activeBlocks[killer]
                local cf=kR.CFrame local look=cf.LookVector local yaw=math.atan2(-look.X,-look.Z)
                local half=ConeConfig.NormalAngle/2 local lA,rA=half,half
                if st.turnDir==1 then lA=st.currentAngle-half elseif st.turnDir==-1 then rA=st.currentAngle-half end
                local inCone=false
                if pHRP then inCone=isPlayerInCone(kR,pHRP.Position,yaw,lA,rA) end
                if ConeConfig.ShowBox then updateCone(st,kR,dt,inCone and ConeConfig.ColorHit or ConeConfig.Color)
                elseif not inCone and st.currentAngle==ConeConfig.NormalAngle then hideCone(st) end
                if ab and inCone and not ab.fired then ab.fired=true fireBlock() HDT_Fire(killer) end
            else destroyCone(killer) end
        end
    end
end)

