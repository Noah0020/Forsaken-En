local function abHeartbeat()
    if not AB.Enabled or not LocalRoot then return end
    local now = os.clock()
    if HDT_Active and now > HDT_Until then HDT_Active=false end
    for model, st in pairs(pending) do
        if not model.Parent or now > st.expiry then pending[model]=nil
        elseif not st.blocked then
            local kr = model:FindFirstChild("HumanoidRootPart")
            if kr and (LocalRoot.Position-kr.Position).Magnitude <= (AB.Range or 15) then
                st.blocked=true; DoBlock(kr)
            end
        end
    end
    if KillersFolder then
        local killer = KillersFolder:GetChildren()[1]
        if killer and killer:IsA("Model") then
            local alu = killer:GetAttribute("AbilityLastUsed") or 0
            local au = killer:GetAttribute("AbilitiesUsed") or 0
            if aluLast == nil then aluLast, aluUsed = alu, au
            else
                if au > aluUsed then aluLock=true end
                if alu > aluLast then if aluLock then aluLock=false else makeALUBox(killer) end end
                aluLast, aluUsed = alu, au
            end
        end
    end
end

local function SetAutoBlock(on)
    AB.Enabled = on
    for _,c in ipairs(abConns) do pcall(function() c:Disconnect() end) end
    table.clear(abConns); table.clear(pending); aluLast, aluUsed, aluLock = nil, nil, false
    if not on then
        for _,o in ipairs(workspace:GetChildren()) do if o.Name=="SH_ALU" then o:Destroy() end end
        Notify("Auto Block", "OFF"); return
    end
    refreshFolders()
    if KillersFolder then
        for _,m in ipairs(KillersFolder:GetChildren()) do if m:IsA("Model") then trackKiller(m) end end
        table.insert(abConns, KillersFolder.ChildAdded:Connect(function(c) if c:IsA("Model") then trackKiller(c) end end))
    end
    table.insert(abConns, RunService.Heartbeat:Connect(abHeartbeat))
    Notify("Auto Block", "ON · anim + sound + AbilityLastUsed")
end

