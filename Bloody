local function applyStamGH()
    local S=getSprinting(); if not S then return end
    if StamGH.infinite then
        pcall(function() S.StaminaLossDisabled=true; S.Stamina=9999999; S.StaminaLoss=0 end)
    elseif StamGH.settingsOn then
        pcall(function()
            S.MinStamina=math.clamp(StamGH.min,0,StamGH.max)
            S.MaxStamina=math.max(StamGH.max,S.MinStamina)
            S.StaminaLoss=math.max(StamGH.loss,0)
            S.StaminaGain=math.max(StamGH.gain,0)
            if S.SprintSpeed~=nil then S.SprintSpeed=math.max(StamGH.sprintSpeed,0) end
            if S.ChangeStat then S:ChangeStat("MinStamina",S.MinStamina); S:ChangeStat("MaxStamina",S.MaxStamina); S:ChangeStat("StaminaLoss",S.StaminaLoss); S:ChangeStat("StaminaGain",S.StaminaGain) end
        end)
    else
        pcall(function() S.StaminaLossDisabled=false; S.StaminaLoss=10; S.StaminaGain=25 end)
    end
end
