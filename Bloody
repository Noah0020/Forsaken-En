local function getAbilityName(killer)
    local attrs = { "AbilityName", "LastAbility", "CurrentAbility", "LastAbilityName", "AbilityUsed", "Ability", "CurrentAttack" }
    for i = 1, #attrs do
        local ok, val = pcall(function() return killer:GetAttribute(attrs[i]) end)
        if ok and type(val) == "string" and val ~= "" then return val end
    end
    return nil
end

local HDT_Active = false
local HDT_Until = 0
local HDT_CD = 27
local HDT_Last = 0
local DragToken = 0
local abConns = {}
local pending = {}
local lastBlock = 0

local function DragToward(kr)
    if not AB.HitboxDrag or not HDT_Active or not LocalRoot or not kr then return end
    if os.clock() > HDT_Until then HDT_Active = false return end
    if os.clock() - HDT_Last < HDT_CD then return end
    if (kr.Position - LocalRoot.Position).Magnitude > AB.DragRange then return end
    HDT_Last = os.clock()
    DragToken = DragToken + 1
    local my = DragToken
    local speed = AB.DragSpeed
    local dur = AB.DragDuration
    local t0 = os.clock()
    task.spawn(function()
        while my == DragToken and os.clock() - t0 < dur do
            local dt = RS.Heartbeat:Wait()
            if not LocalRoot or not kr.Parent or not HDT_Active then break end
            local dir = Vector3.new(kr.Position.X - LocalRoot.Position.X, 0, kr.Position.Z - LocalRoot.Position.Z)
            if dir.Magnitude <= 2.5 then break end
            local ramp = math.sin(math.pi * (os.clock() - t0) / dur)
            if LocalHum then pcall(function() LocalHum:Move(dir.Unit, false) end) end
            LocalRoot.CFrame = LocalRoot.CFrame + dir.Unit * speed * ramp * dt
            LocalRoot.CFrame = CFrame.lookAt(LocalRoot.Position, LocalRoot.Position + dir.Unit)
        end
        if LocalHum then pcall(function() LocalHum:Move(Vector3.zero, false) end) end
    end)
end

local function DoBlock(kr)
    local now = os.clock()
    if now - lastBlock < 0.01 then return end
    lastBlock = now
    local function burst()
        for _ = 1, 6 do FireBlock() end
    end
    if AB.BlockDelayMs > 0 then
        task.delay(AB.BlockDelayMs / 1000, burst)
    else
        burst()
    end
    if AB.HitboxDrag and HDT_Active and kr then DragToward(kr) end
    if AB.AutoPunch and kr then
        task.spawn(function()
            aimAt(kr, 0.18)
            task.wait(AB.PunchDelay)
            if LocalRoot and kr.Parent then aimAt(kr, 0.1) end
            FirePunch()
        end)
    end
end

local function armKiller(model, dur)
    if not model or model == LocalChar then return end
    pending[model] = { expiry = os.clock() + (dur or AB.SoundTimer), blocked = false }
end

local function hookSound(sound, model)
    if not sound:IsA("Sound") then return end
    table.insert(abConns, sound.Played:Connect(function()
        if not AB.Enabled then return end
        local id = extractId(sound.SoundId)
        if id and (AttackSounds[id] or BLOCK_SOUND_IDS[id]) then
            armKiller(model or sound:FindFirstAncestorOfClass("Model"), AB.SoundTimer)
        end
    end))
end

local function trackKiller(model)
    if not model or not model:IsA("Model") then return end

    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Sound") then hookSound(d, model) end
        end
    end)
    table.insert(abConns, model.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d, model) end
    end))

    local lastAbility = model:GetAttribute("AbilityLastUsed") or 0
    local function onAbilityChange()
        if not AB.Enabled then return end
        local cur = model:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local name = getAbilityName(model)
        if name and nameMatches(name) then
            local kr = model:FindFirstChild("HumanoidRootPart")
            if LocalRoot and kr and (kr.Position - LocalRoot.Position).Magnitude <= AB.Range then
                DoBlock(kr)
            end
        end
    end
    pcall(function()
        table.insert(abConns, model:GetAttributeChangedSignal("AbilityLastUsed"):Connect(onAbilityChange))
    end)

    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
        if not anim then return end
        table.insert(abConns, anim.AnimationPlayed:Connect(function(track)
            if not AB.Enabled or not track.Animation then return end
            local id = extractId(track.Animation.AnimationId)
            if not id or not (AttackAnims[id] or BLOCK_ANIM_IDS[id]) then return end
            armKiller(model, AB.SoundTimer)
            task.spawn(function()
                local q = model:FindFirstChild("QueryHitbox")
                if not q then return end
                local lq = LocalChar and LocalChar:FindFirstChild("QueryHitbox")
                local params = OverlapParams.new()
                params.MaxParts = 2
                if lq then
                    params.FilterType = Enum.RaycastFilterType.Include
                    params.FilterDescendantsInstances = { lq }
                else
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = { model }
                end
                for _ = 1, 14 do
                    if not AB.Enabled then break end
                    local kr = model:FindFirstChild("HumanoidRootPart")
                    local hits = workspace:GetPartBoundsInBox(
                        q.CFrame * CFrame.new(0, 0, -3.5),
                        Vector3.new(5.2, 6, 5.65) * 2.2 * AB.HitboxMult,
                        params
                    )
                    if #hits > 0 then
                        DoBlock(kr)
                        break
                    end
                    task.wait(0.01)
                end
            end)
        end))
    end)
end

