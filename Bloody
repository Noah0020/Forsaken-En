local function GetNearestKillerModel(maxDist)
    local char = LP.Character
    if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

local function GetNearestSurvivorModel(maxDist)
    local char = LP.Character
    if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local sf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not sf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(sf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

