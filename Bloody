end)

safe("Silent Aim", function()
    local Silent = { crystal = false, crystalPred = 2.5, crystalY = 1.5, dusk = false, duskPred = 0.5, hooked = false }
    local function install()
        if Silent.hooked then return true end
        local rf = getRF()
        if not rf then return false end
        local old = rf.OnClientInvoke
        rf.OnClientInvoke = function(name, ...)
            if name == "GetCameraCF" and Silent.crystal and not IsPlayerKiller() then
                local killer = GetNearestKillerModel(math.huge)
                local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local cam = Workspace.CurrentCamera
                if killer and my and cam then
                    local hrp = killer:FindFirstChild("HumanoidRootPart")
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    if hrp then
                        local pos = hrp.Position
                        if hum and hum.MoveDirection.Magnitude > 0.15 then pos = pos + hum.MoveDirection * Silent.crystalPred end
                        local cf = CFrame.lookAt(Vector3.zero, (pos - my.Position + Vector3.new(0, Silent.crystalY, 0)).Unit)
                        return CFrame.new(cam.CFrame.Position) * cf.Rotation
                    end
                end
            end
            if name == "GetMousePosition" and Silent.dusk and not IsPlayerKiller() then
                local killer = GetNearestKillerModel(math.huge)
                if killer then
                    local hrp = killer:FindFirstChild("HumanoidRootPart")
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    if hrp then
                        local pos = hrp.Position
                        if hum and hum.MoveDirection.Magnitude > 0.05 then pos = pos + hum.MoveDirection * Silent.duskPred end
                        return pos
                    end
                end
            end
            if old then return old(name, ...) end
        end
        Silent.hooked = true
        return true
    end
    local left = Tabs.Silent:AddLeftGroupbox("Jane Doe", "crosshair")
    left:AddToggle("Crystal_T", { Text = "Crystal Silent Aim", Default = false, Callback = function(v) Silent.crystal = v; if v then install() end end })
    left:AddSlider("CrystalPred_S", { Text = "Prediction", Default = 2.5, Min = 0, Max = 10, Rounding = 1, Callback = function(v) Silent.crystalPred = v end })
    local right = Tabs.Silent:AddRightGroupbox("Dusekkar", "zap")
    right:AddToggle("Plasma_T", { Text = "Plasma Silent Aim", Default = false, Callback = function(v) Silent.dusk = v; if v then install() end end })
    right:AddSlider("PlasmaPred_S", { Text = "Prediction", Default = 0.5, Min = 0, Max = 5, Rounding = 1, Callback = function(v) Silent.duskPred = v end })
end)

