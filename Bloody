local AB_lastCheck = {}

local function attemptBlockFromSound(sound, preId)
    if not AB.soundBlockOn then return end
    local id = preId or extractSoundId(sound)
    if not id or not g_triggerSounds[id] then return end
    local now = tick()
    if now - AB.blockLastTime < AB.BLOCK_CD then return end
    if AB.soundBlockedUntil[sound] and now < AB.soundBlockedUntil[sound] then return end
    local root = getHRP(); if not root then return end
    local _, soundPart = getSoundPos(sound); if not soundPart then return end
    local killer = getCharFromDesc(soundPart); if not killer then return end
    local killerPos = getKillerPos(killer); if not killerPos then return end
    local distSq = (killerPos - root.Position).Magnitude ^ 2
    local effRange = AB.detectionRange + 0.2 * AB.detectionRange
    if distSq > effRange * effRange then return end
    AB.blockLastTime = now
    FireByMode()
    AB.soundBlockedUntil[sound] = now + 0.5
end

local function hookSound(sound)
    if not sound or not sound:IsA("Sound") or AB.soundHooks[sound] then return end
    local preId = extractSoundId(sound); if not preId then return end
    local pc = sound.Played:Connect(function()
        if AB.soundBlockOn then
            local now = tick()
            if not AB_lastCheck[preId] or (now - AB_lastCheck[preId]) > 0.05 then
                AB_lastCheck[preId] = now
                task.spawn(attemptBlockFromSound, sound, preId)
            end
        end
    end)
    local pp = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying and AB.soundBlockOn then
            local now = tick()
            if not AB_lastCheck[preId] or (now - AB_lastCheck[preId]) > 0.05 then
                AB_lastCheck[preId] = now
                task.spawn(attemptBlockFromSound, sound, preId)
            end
        end
    end)
    local dc
    dc = sound.Destroying:Connect(function()
        pcall(function() pc:Disconnect(); pp:Disconnect(); dc:Disconnect() end)
        AB.soundHooks[sound] = nil
        AB.soundBlockedUntil[sound] = nil
    end)
    AB.soundHooks[sound] = {pc, pp, dc}
    if sound.IsPlaying and AB.soundBlockOn then
        task.spawn(attemptBlockFromSound, sound, preId)
    end
end

