    end
    local char = LP.Character
    local lArm = char and (char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand"))
    local sp = lArm and lArm.Position or (elliot.hrp.Position + Vector3.new(-1,1,0) + elliot.hrp.CFrame.LookVector*2)
    local pts = elliot_arcCalc(sp, elliot.hrp.CFrame.LookVector)
    elliot_clearArc()
    for _, p in ipairs(pts) do
        local part = Instance.new("Part")
        part.Size = Vector3.new(0.25,0.25,0.25)
        part.Position = p
        part.Anchored = true; part.CanCollide = false
        part.Material = Enum.Material.Neon; part.Shape = Enum.PartType.Ball
        part.Color = Color3.fromRGB(255,0,0); part.Transparency = 0.15
        part.Parent = elliot.arcFolder
