--═══════════════════════════════════════════════════════════════════
-- SILENT AIM
--═══════════════════════════════════════════════════════════════════
local SilentAim = { installed = false, enabled = false }
local _targetCache = { target = nil, nextScan = 0 }

local function SilentAim_GetTarget()
    local now = tick()
    if now < _targetCache.nextScan then return _targetCache.target end
    _targetCache.nextScan = now + 0.1
    _targetCache.target = nil

    local cam = Workspace.CurrentCamera; if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local kf = GetKillersFolder(); if not kf then return nil end
    local best, bestScore = nil, math.huge

    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if kr and kh and kh.Health > 0 then
            local sp, onscreen = cam:WorldToViewportPoint(kr.Position)
            if onscreen then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d <= Settings.SA_FOV and d < bestScore then
                    if Settings.SA_WallCheck then
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        rp.FilterDescendantsInstances = { LocalPlayer.Character, k, cam }
                        local hit = Workspace:Raycast(cam.CFrame.Position, kr.Position - cam.CFrame.Position, rp)
                        if hit then
                            d = math.huge
                        end
                    end
                    if d < bestScore then best, bestScore = kr, d end
                end
            end
        end
    end
    if not best then return nil end

    local ping = 0.05
