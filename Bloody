local DAGGER_IDS = { ["100725497418533"] = true, ["89448354637442"] = true }
local stabbing, lastStab, followConn, origAutoRot = false, 0, nil, true
local function getMyHRP() return LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart") end
local function getMyHum() return LocalCharacter and LocalCharacter:FindFirstChildOfClass("Humanoid") end
local function getKillerModel()
    if not KillersFolder then return nil, nil end
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local h = k:FindFirstChildOfClass("Humanoid"); local r = k:FindFirstChild("HumanoidRootPart") or k.PrimaryPart
            if h and r and h.Health > 0 then return k, r end
        end
    end
end
local function stopFollow()
    if followConn then followConn:Disconnect(); followConn = nil end
    local h = getMyHum(); if h then h.AutoRotate = origAutoRot end
    stabbing = false
end
local function followBehind(killer)
    if followConn then followConn:Disconnect(); followConn = nil end
    local h = getMyHum(); origAutoRot = h and h.AutoRotate or true
    if h then h.AutoRotate = false end
    local endT = os.clock() + v1.backstabFollowDuration
    followConn = RunService.RenderStepped:Connect(function()
        if os.clock() >= endT or not stabbing then stopFollow(); return end
        local hrp = getMyHRP(); if not hrp then stopFollow(); return end
        local kHRP = killer and killer:FindFirstChild("HumanoidRootPart")
        if not kHRP or not kHRP.Parent then stopFollow(); return end
        local kcf = kHRP.CFrame
        local behind = kcf.Position - kcf.LookVector * v1.backstabBehindOffset
        local target = CFrame.lookAt(Vector3.new(behind.X, hrp.Position.Y, behind.Z),
            Vector3.new(kcf.Position.X, hrp.Position.Y, kcf.Position.Z))
        hrp.CFrame = hrp.CFrame:Lerp(target, 0.5)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
end
local function hunterstab()
    if not v1.backstabEnabled or stabbing then return end
    if os.clock() - lastStab < v1.backstabCooldown then return end
    local hrp = getMyHRP(); if not hrp then return end
    local killer, kHRP = getKillerModel(); if not killer or not kHRP then return end
    if (kHRP.Position - hrp.Position).Magnitude > v1.backstabMaxRange then return end
    stabbing = true; lastStab = os.clock()
    local kcf = kHRP.CFrame
    local behind = kcf.Position - kcf.LookVector * v1.backstabBehindOffset
    local dest = CFrame.lookAt(Vector3.new(behind.X, hrp.Position.Y, behind.Z),
        Vector3.new(kcf.Position.X, hrp.Position.Y, kcf.Position.Z))
    task.wait(0.02)
    local now = getMyHRP(); if not now then stabbing = false; return end
    now.CFrame = dest; now.AssemblyLinearVelocity = Vector3.zero
    followBehind(killer)
end
local hookedStab = setmetatable({}, { __mode = "k" })
local function hookStabAnim(anim)
    if not anim or not anim:IsA("Animator") or hookedStab[anim] then return end
    hookedStab[anim] = true
    anim.AnimationPlayed:Connect(function(t)
        if not t or not t.Animation then return end
        local id = tostring(t.Animation.AnimationId):match("%d+")
        if id and DAGGER_IDS[id] and v1.backstabEnabled then hunterstab() end
    end)
end
local function bindStab(char)
    if not char then return end
    local h = char:FindFirstChildOfClass("Humanoid"); if not h then return end
    local a = h:FindFirstChildOfClass("Animator") or h:WaitForChild("Animator", 3)
    if a then hookStabAnim(a) end
