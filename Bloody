-- GENERATOR SOLVER
--═══════════════════════════════════════════════════════════
local GenCfg = { StartDelay = 1.5, ActionDelay = 0.05, ConnectDelay = 1.0, GearDelay = 0.03 }
local MinigameSolver = { ManualEnabled = false, Generation = 0, LockBoard = nil, Installed = false }
local GenMods = {}

task.spawn(function()
    local function safeReq(label, inst)
        if not inst then return nil end
        local ok, m = pcall(require, inst)
        return ok and m or nil
    end
    local sys = ReplicatedStorage:FindFirstChild("Systems")
    local pMod = sys and sys:FindFirstChild("Player")
    local gMod = pMod and pMod:FindFirstChild("Game")
    local mf = gMod and gMod:FindFirstChild("Minigames")
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local miniMods = mods and mods:FindFirstChild("Minigames")
    GenMods.FlowBoard = safeReq("FlowBoard", miniMods and miniMods:FindFirstChild("FlowBoard"))
    GenMods.LockBoard = safeReq("LockBoard", miniMods and miniMods:FindFirstChild("LockBoard"))
    GenMods.FlowInput = safeReq("FlowInput", mf and mf:FindFirstChild("FlowClientMinigame") and mf.FlowClientMinigame:FindFirstChild("FlowInput"))
    GenMods.GearInput = safeReq("GearInput", mf and mf:FindFirstChild("GearClientMinigame") and mf.GearClientMinigame:FindFirstChild("GearInput"))
    GenMods.LockInput = safeReq("LockInput", mf and mf:FindFirstChild("LockClientMinigame") and mf.LockClientMinigame:FindFirstChild("LockInput"))
    GenMods.ConnectInput = safeReq("ConnectInput", mf and mf:FindFirstChild("ConnectClientMinigame") and mf.ConnectClientMinigame:FindFirstChild("ConnectInput"))

    local function solverOn() return MinigameSolver.ManualEnabled end
    local function stillSolving(tok, obj) return tok == MinigameSolver.Generation and solverOn() and obj and not obj.Ended end
    local function waitSolver(obj)
        while obj and not obj.Ended and not solverOn() do task.wait(0.05) end
        if not (obj and not obj.Ended and solverOn()) then return false end
        local s = os.clock()
        while obj and not obj.Ended and solverOn() and os.clock() - s < GenCfg.StartDelay do task.wait(0.05) end
        return obj and not obj.Ended and solverOn()
    end
    local function solveFlow(board)
        if not GenMods.FlowBoard then return nil end
        local size, pairs = board.Size, board.Pairs
        local occupied, answer = {}, {}
        local dirs = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }
        local owner = {}
        for color, pair in pairsFn or pairs, pairs do end
        for color, pair in pairs(board.Pairs) do owner[pair[1]], owner[pair[2]] = color, color end
        local remaining = {}
        for color in pairs(board.Pairs) do table.insert(remaining, color) end
        local function candidates(color, limit)
            local pair = board.Pairs[color]
            local from, target = pair[1], pair[2]
            local results, path, seen = {}, { from }, { [from] = true }
            local function dist(cell)
                local r, c = GenMods.FlowBoard.ToRowCol(size, cell)
                local tr, tc = GenMods.FlowBoard.ToRowCol(size, target)
                return math.abs(r - tr) + math.abs(c - tc)
            end
            local function walk(cell)
                if #results >= limit then return end
                if cell == target then table.insert(results, table.clone(path)); return end
                local r, c = GenMods.FlowBoard.ToRowCol(size, cell)
                local nxt = {}
                for _, d in ipairs(dirs) do
                    local nr, nc = r + d[1], c + d[2]
                    if nr >= 1 and nr <= size and nc >= 1 and nc <= size then
                        local n = GenMods.FlowBoard.ToIndex(size, nr, nc)
                        local o = owner[n]
                        if not seen[n] and not occupied[n] and (not o or (o == color and n == target)) then
                            table.insert(nxt, n)
                        end
                    end
                end
                table.sort(nxt, function(a, b) return dist(a) < dist(b) end)
                for _, n in ipairs(nxt) do
                    seen[n] = true; table.insert(path, n); walk(n)
                    path[#path] = nil; seen[n] = nil
                    if #results >= limit then break end
                end
            end
            walk(from); table.sort(results, function(a, b) return #a < #b end)
            return results
        end
        local function search(colors)
            if #colors == 0 then return true end
            local bi, bp
            for i, c in ipairs(colors) do
                local list = candidates(c, 300)
                if #list == 0 then return false end
                if not bp or #list < #bp then bi, bp = i, list end
            end
            local col = colors[bi]
            local nc = table.clone(colors); table.remove(nc, bi)
            for _, p in ipairs(bp) do
                for _, cell in ipairs(p) do occupied[cell] = true end
                answer[col] = p
                if search(nc) then return true end
                answer[col] = nil
                for _, cell in ipairs(p) do occupied[cell] = nil end
            end
            return false
        end
        return search(remaining) and answer or nil
    end

    if MinigameSolver.Installed then return end
    local hooked = 0
    if GenMods.LockBoard and GenMods.LockBoard.new then
        local old = GenMods.LockBoard.new
        GenMods.LockBoard.new = function(...) local b = old(...); MinigameSolver.LockBoard = b; return b end
        hooked += 1
    end
    if GenMods.FlowInput and GenMods.FlowInput.new and GenMods.FlowBoard then
        local old = GenMods.FlowInput.new
        GenMods.FlowInput.new = function(board, renderer, cb)
            local obj = old(board, renderer, cb)
            task.spawn(function()
                if not waitSolver(obj) then return end
                local tok = MinigameSolver.Generation
                task.wait(GenCfg.ActionDelay)
                local paths = solveFlow(board)
                if not paths then warn("[Cupcake Gen] Flow solve failed") return end
                for color, path in pairs(paths) do
                    if not stillSolving(tok, obj) then return end
                    local draw = board:Begin(path[1]); renderer:Render(); task.wait(GenCfg.ActionDelay)
                    for i = 2, #path do
                        if not stillSolving(tok, obj) then return end
                        board:Step(draw, path[i], 0); renderer:Render(); task.wait(GenCfg.ActionDelay)
                    end
                    board:Release(draw, true); renderer:Render(); task.wait(GenCfg.ActionDelay)
                end
                if stillSolving(tok, obj) and board:IsSolved() then obj:__finish(); cb.OnSolved() end
            end)
            return obj
        end
        hooked += 1
    end
    if GenMods.ConnectInput and GenMods.ConnectInput.new then
        local old = GenMods.ConnectInput.new
        GenMods.ConnectInput.new = function(board, renderer, cb)
            local obj = old(board, renderer, cb)
            task.spawn(function()
                if not waitSolver(obj) then return end
                local tok = MinigameSolver.Generation
                task.wait(GenCfg.ConnectDelay)
                for blob in pairs(board.Blobs) do
                    if not stillSolving(tok, obj) then return end
                    if not board:GetLink(blob) then
                        local mate = board:GetMate(blob)
                        if mate then board:Connect(blob, mate); renderer:Render(); task.wait(GenCfg.ConnectDelay) end
                    end
                end
                if stillSolving(tok, obj) and board:IsSolved() then obj:__finish(); cb.OnSolved() end
            end)
            return obj
        end
        hooked += 1
    end
    if GenMods.GearInput and GenMods.GearInput.new then
        local old = GenMods.GearInput.new
        GenMods.GearInput.new = function(getCenter, cb, enabled)
            local obj = old(getCenter, cb, enabled)
            task.spawn(function()
                if not waitSolver(obj) then return end
                local tok = MinigameSolver.Generation
                task.wait(math.max(0.55, GenCfg.ActionDelay))
                for _ = 1, 100 do
                    if not stillSolving(tok, obj) then return end
                    cb.OnTurn(90); task.wait(GenCfg.GearDelay)
                end
            end)
            return obj
        end
        hooked += 1
    end
    if GenMods.LockInput and GenMods.LockInput.new then
        local old = GenMods.LockInput.new
        GenMods.LockInput.new = function(ui, cb)
            local obj = old(ui, cb)
            local board = MinigameSolver.LockBoard
            task.spawn(function()
                if not waitSolver(obj) then return end
                local tok = MinigameSolver.Generation
                while stillSolving(tok, obj) and board and not board:IsBroken() do
                    local n = workspace:GetServerTimeNow()
                    if board:IsOnTarget(board:AngleAt(n)) then cb.OnPress(); task.wait(math.max(0.08, GenCfg.ActionDelay))
                    else RunService.Heartbeat:Wait() end
                end
            end)
            return obj
        end
        hooked += 1
    end
    MinigameSolver.Installed = hooked > 0
end)

