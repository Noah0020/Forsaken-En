    if not myRoot then return end
    local sf = GetSurvivorsFolder(); if not sf then return end
    local found, isGuest = false, false
    for _, s in ipairs(sf:GetChildren()) do
        if s:IsA("Model") and AM1_InZone(s, myRoot) then
            found = true
            if AM1_IsGuest(s) then isGuest = true end
            break
        end
    end
    if not found then return end
    AM1.attacking = true
    task.spawn(function()
        local d = tonumber(Settings.AM1_M1Delay) or 0
        if isGuest and (tonumber(Settings.AM1_GuestDelay) or 0) > 0 then d = d + Settings.AM1_GuestDelay end
        if d > 0 then task.wait(d) end
        if AM1.running then AM1_Trigger(isGuest) end
        task.wait(0.5)
        AM1.attacking = false
    end)
