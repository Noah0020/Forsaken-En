local function getSprinting()
    local ok, S = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Character"):WaitForChild("Game"):WaitForChild("Sprinting"))
    end)
    return ok and S or nil
end

local function applyStamSettings()
    local S = getSprinting(); if not S then return end
    if Stam.infinite then
        pcall(function() S.StaminaLossDisabled = true end)
        pcall(function() S.StaminaLoss = 0 end)
        pcall(function() S.StaminaGain = 9999 end)
        pcall(function() S.Stamina = 9999999 end)
    elseif Stam.settingsOn then
        pcall(function() S.MinStamina = Stam.min end)
        pcall(function() S.MaxStamina = math.max(Stam.max, Stam.min) end)
        pcall(function() S.StaminaLoss = math.max(Stam.loss, 0) end)
        pcall(function() S.StaminaGain = math.max(Stam.gain, 0) end)
        pcall(function() if S.ChangeStat then S:ChangeStat("MinStamina", S.MinStamina); S:ChangeStat("MaxStamina", S.MaxStamina); S:ChangeStat("StaminaLoss", S.StaminaLoss); S:ChangeStat("StaminaGain", S.StaminaGain) end end)
    else
        pcall(function() S.StaminaLossDisabled = false end)
        pcall(function() S.StaminaLoss = 10 end)
        pcall(function() S.StaminaGain = 25 end)
    end
end

task.spawn(function()
