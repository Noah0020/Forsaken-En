local elliot = { enabled=false, conn=nil, autoRotBak=nil, aimType="Camera + Character", throwDur=0.6, isThrowing=false, throwTS=0, requireAnim=true, hum=nil, hrp=nil, smoothness=0.15, predDist=5, throwForce=80, throwAnimId="114155003741146" }
local function elliot_setupChar(char)
    elliot.hum=char:WaitForChild("Humanoid",3)
    elliot.hrp=char:WaitForChild("HumanoidRootPart",3)
    if elliot.hum then
        local an=elliot.hum:FindFirstChildOfClass("Animator")
        if an then
            an.AnimationPlayed:Connect(function(track)
                if not track or not track.Animation or IsPlayerKiller() then return end
                local aid=""; pcall(function() aid=tostring(track.Animation.AnimationId) end)
                if aid:find(elliot.throwAnimId) then elliot.isThrowing=true; elliot.throwTS=tick() end
            end)
        end
    end
end
if LP.Character then elliot_setupChar(LP.Character) end
LP.CharacterAdded:Connect(elliot_setupChar)

local function elliot_findTarget()
    local sf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not sf or not elliot.hrp then return nil end
    local best,bv=nil,math.huge
    for _,s in ipairs(sf:GetChildren()) do
        if s~=LP.Character and s:IsA("Model") then
            local h=s:FindFirstChildOfClass("Humanoid"); local r=s:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health>0 and h.Health<bv then bv=h.Health; best=r end
        end
    end
    return best
end

local function elliot_start()
    if elliot.conn then elliot.conn:Disconnect() end
    elliot.conn=RunService.RenderStepped:Connect(function()
        if not elliot.enabled or not elliot.hum or not elliot.hrp or IsPlayerKiller() then
            if elliot.autoRotBak~=nil and elliot.hum then elliot.hum.AutoRotate=elliot.autoRotBak; elliot.autoRotBak=nil end
            return
        end
        local should=(not elliot.requireAnim) or (elliot.isThrowing and (tick()-elliot.throwTS)<=elliot.throwDur)
        if elliot.isThrowing and (tick()-elliot.throwTS)>elliot.throwDur then elliot.isThrowing=false end
        if not should then
            if elliot.autoRotBak~=nil and elliot.hum then elliot.hum.AutoRotate=elliot.autoRotBak; elliot.autoRotBak=nil end
            return
        end
        local t=elliot_findTarget(); if not t then return end
        local pred=t.Position
        local hum=t.Parent and t.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude>0.05 then pred=pred+hum.MoveDirection.Unit*(elliot.predDist or 5) end
        if elliot.autoRotBak==nil then elliot.autoRotBak=elliot.hum.AutoRotate; elliot.hum.AutoRotate=false end
        local flat=Vector3.new(pred.X-elliot.hrp.Position.X,0,pred.Z-elliot.hrp.Position.Z)
        if flat.Magnitude>0.1 then
            local look=CFrame.lookAt(elliot.hrp.Position, elliot.hrp.Position+flat.Unit)
            elliot.hrp.CFrame=elliot.hrp.CFrame:Lerp(CFrame.new(elliot.hrp.Position)*look.Rotation, elliot.smoothness)
        end
        if elliot.aimType~="HRP Aimbot" then
            local cam=Workspace.CurrentCamera
            if cam then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,pred), elliot.smoothness*1.5) end
        end
    end)
end
local function elliot_stop()
    elliot.enabled=false
    if elliot.conn then pcall(function() elliot.conn:Disconnect() end); elliot.conn=nil end
    if elliot.hum then pcall(function() elliot.hum.AutoRotate=true end) end
end

