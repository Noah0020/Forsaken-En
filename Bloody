local noclipConn, noSlowConn, noSlowChar, footConn, invisConn

local function setNoclip(on)
    C.Noclip = on
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if on then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    end
end

local function setNoSlow(on)
    C.NoSlow = on
    if noSlowConn then noSlowConn:Disconnect(); noSlowConn = nil end
    if noSlowChar then noSlowChar:Disconnect(); noSlowChar = nil end
    if on then
        local function clean(char)
            if not char then return end
            for _, d in pairs(char:GetDescendants()) do
                if d.Name == "SlowedStatus" then d:Destroy() end
            end
            if noSlowConn then noSlowConn:Disconnect() end
            noSlowConn = char.DescendantAdded:Connect(function(d)
                if d.Name == "SlowedStatus" then d:Destroy() end
            end)
        end
        if LocalPlayer.Character then clean(LocalPlayer.Character) end
        noSlowChar = LocalPlayer.CharacterAdded:Connect(clean)
        Notify("No Slowness ON")
    end
end

local function setHideFoot(on)
    C.HideFoot = on
    if footConn then footConn:Disconnect(); footConn = nil end
    if on then
        footConn = workspace.DescendantAdded:Connect(function(o)
            if o:IsA("Sound") and (o.Name == "FootSP" or string.find(string.lower(o.Name), "foot")) then
                o.Volume = 0; o:Stop()
            end
        end)
    end
end

local function setInvis(on)
    C.Invisible = on
    if invisConn then invisConn:Disconnect(); invisConn = nil end
    if on then
        invisConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.LocalTransparencyModifier = 1
                elseif p:IsA("Decal") or p:IsA("Texture") then
                    p.Transparency = 1
                end
            end
        end)
    end
end

local function setFB(on)
    C.Fullbright = on
    if on then
        Lighting.Brightness = 3; Lighting.ClockTime = 14
        Lighting.Ambient = Color3.new(1,1,1); Lighting.OutdoorAmbient = Color3.new(1,1,1)
        Lighting.FogEnd = 1e9; Lighting.GlobalShadows = false
    end
end

