local AntiGlitch = { running=false, connections={} }
local function StartAntiGlitch()
    if AntiGlitch.running then return end
    AntiGlitch.running = true
    local T = { Glitched=true, Hallucination=true }
    local function proc(o)
        if not o or not o.Parent then return end
        if T[o.Name] then
            local m = PlayerGui:FindFirstChild("MainUI"); local tu = PlayerGui:FindFirstChild("TemporaryUI")
            if (m and m:FindFirstChild("StatusContainer") and o:IsDescendantOf(m.StatusContainer)) or (tu and o:IsDescendantOf(tu)) then
                pcall(function() o:Destroy() end)
            end
        end
    end
    table.insert(AntiGlitch.connections, PlayerGui.DescendantAdded:Connect(proc))
    for _, o in ipairs(PlayerGui:GetDescendants()) do proc(o) end
end
local function StopAntiGlitch() AntiGlitch.running = false; for _, c in ipairs(AntiGlitch.connections) do pcall(function() c:Disconnect() end) end AntiGlitch.connections = {} end

