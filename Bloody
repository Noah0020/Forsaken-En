local function IsWallBetween(r1, r2, c1, c2)
    if not r1 or not r2 then return false end
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = { c1, c2, Players2 }
    return Workspace:Raycast(r1.Position, r2.Position - r1.Position, p) ~= nil
end
local function PassesFacingCheck(myRoot, kRoot)
    if not myRoot or not kRoot then return false end
    local dir = (myRoot.Position - kRoot.Position).Unit
    local dot = (Settings.AntiBaitFacingCheck == false) and -1 or (Settings.AntiBaitFacingDot or 0.3)
    return kRoot.CFrame.LookVector:Dot(dir) >= dot
end
local function IsInCustomZone(_) return false end

local function GetActiveMode()
