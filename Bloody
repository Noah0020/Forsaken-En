-- PREDICTION
--═══════════════════════════════════════════════════════════════════
local PRED_MIN, PRED_MAX = 2, 3
local _velHistory, _posHistory = {}, {}
local function getVelocity(hrp)
    if not hrp then return Vector3.zero end
    local now = os.clock()
    local v = hrp.AssemblyLinearVelocity
    if (not v or v.Magnitude < 0.5) then v = hrp.Velocity end
    if not v then v = Vector3.zero end
    local prev = _posHistory[hrp]
    local deltaVel = Vector3.zero
    if prev and (now - prev.time) > 0.01 then
        deltaVel = (hrp.Position - prev.pos) / (now - prev.time)
    end
    _posHistory[hrp] = { pos = hrp.Position, time = now }
    if deltaVel.Magnitude > v.Magnitude then return deltaVel end
    return v
end
local function smoothedVelocity(hrp)
    if not hrp then return Vector3.zero end
    local v = getVelocity(hrp)
    local h = _velHistory[hrp]
    if not h then h = {}; _velHistory[hrp] = h end
    table.insert(h, v)
    if #h > 10 then table.remove(h, 1) end
    local sum = Vector3.zero
    for i = 1, #h do sum = sum + h[i] end
    return sum / math.max(#h, 1)
end
local function PredictPosition(hrp, sliderPred)
    if not hrp then return nil end
    local pos = hrp.Position
    local vel = smoothedVelocity(hrp)
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local speed = horiz.Magnitude
    local slider = math.clamp(sliderPred or 4, 1, 10)
    local mul = slider / 4
    if speed < 1.2 then return pos end
    local lead = (PRED_MIN + (PRED_MAX - PRED_MIN) * math.clamp(speed / 28, 0, 1)) * mul
    local h = _velHistory[hrp]
    if h and #h >= 3 then
        local a = h[#h - 2]; local b = h[#h]
        local ah = Vector3.new(a.X, 0, a.Z)
        local bh = Vector3.new(b.X, 0, b.Z)
        if ah.Magnitude > 2 and bh.Magnitude > 2 and ah.Unit:Dot(bh.Unit) < 0.45 then
            lead = lead + 0.9 * mul
        end
    end
    return pos + horiz.Unit * lead
end
