        Mist.noFog = false; setNoFog(false)
        Mist.cameraNoclip = false; setCharacterNoclip(false)
        Mist.antiSlow = false; Mist.disableTrails = false
        Gen.enabled = false; Gen.gen += 1
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == "__SESP" or obj.Name == "__SBB" or obj.Name == "Nos_BlockBox" or obj.Name == "Vortex_BlockBox" then
                    obj:Destroy()
                end
            end
        end)
        Notify("Settings", "Complete reset done - GUI + internal vars synced")
        print("[UNSERIOUS HUB] Complete reset - controls visually OFF and synced")
    end)

    AddButton(Tab, "Unload Hub - FULL CLEANUP", function()
        Notify("Settings", "Unloading - full cleanup...")
        -- Full cleanup of all connections and states
        pcall(function()
            -- Reset controls first
            for Id, Default in pairs(ControlDefaults) do
                local ctrl = FluentControls[Id]
                if ctrl and ctrl.SetValue then pcall(function() ctrl:SetValue(Default) end) end
            end
            -- Disconnect all tracked connections
            for _, conn in ipairs(AllConnections) do pcall(function() conn:Disconnect() end) end
            AllConnections = {}
            if Mist.noclipConn then Mist.noclipConn:Disconnect(); Mist.noclipConn = nil end
            if Mist.fullbright then setFullbright(false) end
            if Mist.noFog then setNoFog(false) end
            -- Clear ESP
            for inst in pairs(ESP.tracked) do clearOne(inst) end
            -- Clear boxes
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == "__SESP" or obj.Name == "__SBB" or obj.Name == "Nos_BlockBox" or obj.Name == "Vortex_BlockBox" then
