t5.toggleInvisible = function(enabled)
	t5.enabled = enabled
	if not Character then Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() end
	local Humanoid   = Character:WaitForChild("Humanoid")
	local PrimaryPart = Character.PrimaryPart
	if not Humanoid or not PrimaryPart then return end

	if enabled then
		if not t5.invisCharacterConnection then
			t5.invisCharacterConnection = LocalPlayer.CharacterAdded:Connect(function()
				if t5.currentLoaded then
					t5.currentLoaded:Stop()
					t5.currentLoaded:Destroy()
					t5.currentLoaded = nil
				end
				repeat task.wait() until Character and Character.PrimaryPart
				t5.toggleInvisible(enabled)
			end)
		end
		if isInLobby() then Notify("You're in the lobby. Waiting...", 3); return end
		if Character.Parent ~= Killers or (Character.Parent == Killers and t5.ghostface) then
			Notify("Killers see you underground – people with Visible Hitboxes see your hitbox.", 8)
			PrimaryPart.Transparency = 0.2
			local Animator = Humanoid:FindFirstChildOfClass("Animator")
			if not Animator then return end
			t5.currentLoaded = Animator:LoadAnimation(t5.animation)
			t5.currentLoaded.Priority = Enum.AnimationPriority.Action4
			t5.currentLoaded:Play()
			t5.currentLoaded:AdjustSpeed(0)
		end
	else
		PrimaryPart.Transparency = 1
		if t5.currentLoaded then
			t5.currentLoaded:Stop()
			t5.currentLoaded:Destroy()
			t5.currentLoaded = nil
		end
		if t5.invisCharacterConnection then
			t5.invisCharacterConnection:Disconnect()
			t5.invisCharacterConnection = nil
		end
	end
end

