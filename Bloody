}
local musicList={}
for k in pairs(musicTracks) do table.insert(musicList,k) end
table.sort(musicList)
local musicDir = "CupcakeHubMusic"
if not isfolder(musicDir) then makefolder(musicDir) end
local musicState={on=false, cached={}, origId=nil, thread=nil}
local function mFetch(name)
    if musicState.cached[name] then return musicState.cached[name] end
    local url=musicTracks[name]; if not url then return nil end
    local p=musicDir.."/"..name..".mp3"
    if not isfile(p) then
        local ok,data=pcall(function() return game:HttpGet(url) end)
        if not ok or not data then return nil end
        writefile(p,data)
    end
    local ok,asset=pcall(function() return getcustomasset(p) end)
    if ok and asset then musicState.cached[name]=asset; return asset end
end
local function mSound()
    return (workspace:FindFirstChild("Themes") and workspace.Themes:FindFirstChild("LastSurvivor")) or workspace:FindFirstChild("LastSurvivor",true)
end
local function applyLMS(name)
    pcall(function()
        local s=mSound(); if not s then return end
        if not musicState.origId then musicState.origId=s.SoundId end
        local a=mFetch(name); if not a then return end
        if s.SoundId~=a then s.SoundId=a; s:Stop(); task.wait(0.05); s:Play()
        elseif not s.IsPlaying then s:Play() end
    end)
end
local function resetLMS()
    pcall(function()
        local s=mSound()
        if s and musicState.origId then s.SoundId=musicState.origId; s:Stop(); task.wait(0.05); s:Play() end
    end)
end
local function monitorLMS()
    while musicState.on do
        pcall(function()
            local s=mSound()
            if s then
                local a=musicState.cached[C.lmsTrack]
                if a then
                    if s.SoundId~=a then
                        if not musicState.origId then musicState.origId=s.SoundId end
                        s.SoundId=a; s:Stop(); task.wait(0.05); s:Play()
                    elseif not s.IsPlaying then s:Play() end
                else task.spawn(function() mFetch(C.lmsTrack); applyLMS(C.lmsTrack) end) end
            end
        end)
        task.wait(1)
    end
end
musicSec:Toggle({Title="Apply LMS Music", Value=false, Callback=function(v)
    musicState.on=v
    if v then
        task.spawn(function() mFetch(C.lmsTrack); applyLMS(C.lmsTrack) end)
        musicState.thread=task.spawn(monitorLMS)
    else
        if musicState.thread then task.cancel(musicState.thread); musicState.thread=nil end
        resetLMS()
    end
end})
musicSec:Dropdown({Title="Track", Values=musicList, Value=C.lmsTrack,
    Callback=function(v) C.lmsTrack=v; if musicState.on then task.spawn(function() mFetch(v); applyLMS(v) end) end end})
