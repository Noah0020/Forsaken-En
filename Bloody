local _remote
local function getRemote()
    if _remote and _remote.Parent then return _remote end
    pcall(function()
        _remote = ReplicatedStorage:WaitForChild("Modules", 6)
            :WaitForChild("Network", 4)
            :WaitForChild("Network", 4)
            :WaitForChild("RemoteEvent", 4)
    end)
    return _remote
end

local function FireAbility(name)
    local r = getRemote()
    if not r then return end
    pcall(function()
        local buf = buffer.create(5 + #name)
        buffer.writeu8(buf, 0, 3)
        buffer.writeu32(buf, 1, #name)
        buffer.writestring(buf, 5, name)
        r:FireServer("UseActorAbility", {buf})
    end)
end

local function fireBlock()
    FireAbility("Block")
end

