-- GENERATOR SOLVER (Full)
--═══════════════════════════════════════════════════════════════════
local GenConfig = { StartDelay = 1.5, ActionDelay = 0.05, ConnectDelay = 1.0, GearDelay = 0.03 }
local MinigameSolver = { Enabled = false, Generation = 0, LockBoard = nil, Installed = false }
local function genSolverDelay() return math.max(0, GenConfig.ActionDelay or 0.05) end
local function genConnectDelay() return math.max(0, GenConfig.ConnectDelay or 1.0) end
local function genIsEnabled() return MinigameSolver.Enabled == true end
local function genStillSolving(token, object)
    return genIsEnabled() and token == MinigameSolver.Generation and object and not object.Ended
end
local function genWaitForSolver(object)
    while object and not object.Ended and not genIsEnabled() do task.wait(0.05) end
    if not (object and not object.Ended and genIsEnabled()) then return false end
    local started = os.clock()
    while object and not object.Ended and genIsEnabled() and os.clock() - started < GenConfig.StartDelay do
        task.wait(0.05)
    end
    return object and not object.Ended and genIsEnabled()
end

local function solveFlowBoard(board, FlowBoardModule)
    if not board or not FlowBoardModule then return nil end
    local size, pairMap = board.Size, board.Pairs
    if type(size) ~= "number" or type(pairMap) ~= "table" then return nil end
    local occupied, answer = {}, {}
    local directions = { {-1, 0}, {1, 0}, {0, -1}, {0, 1} }
    local endpointOwner = {}
    for color, pair in pairs(pairMap) do
        endpointOwner[pair[1]] = color; endpointOwner[pair[2]] = color
    end
    local remaining = {}
    for color in pairs(pairMap) do table.insert(remaining, color) end
    local function candidates(color, limit)
        local pair = pairMap[color]
        local from, target = pair[1], pair[2]
        local results, path, seen = {}, {from}, {[from] = true}
        local function distance(cell)
            local r, c = FlowBoardModule.ToRowCol(size, cell)
            local tr, tc = FlowBoardModule.ToRowCol(size, target)
            return math.abs(r - tr) + math.abs(c - tc)
        end
        local function walk(cell)
            if #results >= limit then return end
            if cell == target then table.insert(results, table.clone(path)); return end
            local row, col = FlowBoardModule.ToRowCol(size, cell)
            local nextCells = {}
            for _, d in ipairs(directions) do
                local nr, nc = row + d[1], col + d[2]
                if nr >= 1 and nr <= size and nc >= 1 and nc <= size then
                    local n = FlowBoardModule.ToIndex(size, nr, nc)
                    local owner = endpointOwner[n]
                    if not seen[n] and not occupied[n] and (not owner or (owner == color and n == target)) then
                        table.insert(nextCells, n)
                    end
                end
            end
            table.sort(nextCells, function(a, b) return distance(a) < distance(b) end)
            for _, n in ipairs(nextCells) do
                seen[n] = true; table.insert(path, n); walk(n)
                path[#path] = nil; seen[n] = nil
                if #results >= limit then break end
            end
        end
        walk(from)
        table.sort(results, function(a, b) return #a < #b end)
        return results
    end
    local function search(colors)
        if #colors == 0 then return true end
        local bestIndex, bestPaths
        for i, color in ipairs(colors) do
            local list = candidates(color, 300)
            if #list == 0 then return false end
            if not bestPaths or #list < #bestPaths then bestIndex, bestPaths = i, list end
        end
        local color = colors[bestIndex]
        local nextColors = table.clone(colors)
        table.remove(nextColors, bestIndex)
        for _, path in ipairs(bestPaths) do
            for _, cell in ipairs(path) do occupied[cell] = true end
            answer[color] = path
            if search(nextColors) then return true end
            answer[color] = nil
            for _, cell in ipairs(path) do occupied[cell] = nil end
        end
        return false
    end
    return search(remaining) and answer or nil
end

local function installMinigameHooks()
    if MinigameSolver.Installed then return end
    MinigameSolver.Installed = true
    local ok, err = pcall(function()
        local MinigameFolder = ReplicatedStorage.Systems.Player.Game.Minigames
        local FlowBoardModule = require(ReplicatedStorage.Modules.Minigames.FlowBoard)
        local LockBoardModule = require(ReplicatedStorage.Modules.Minigames.LockBoard)
        local FlowInputModule = require(MinigameFolder.FlowClientMinigame.FlowInput)
        local GearInputModule = require(MinigameFolder.GearClientMinigame.GearInput)
        local LockInputModule = require(MinigameFolder.LockClientMinigame.LockInput)
        local ConnectInputModule = require(MinigameFolder.ConnectClientMinigame.ConnectInput)

        local oldLockBoardNew = LockBoardModule.new
        LockBoardModule.new = function(...)
            local board = oldLockBoardNew(...)
            MinigameSolver.LockBoard = board
            return board
        end

        local oldFlowNew = FlowInputModule.new
        FlowInputModule.new = function(board, renderer, callbacks)
            local object = oldFlowNew(board, renderer, callbacks)
            local token = MinigameSolver.Generation
            task.spawn(function()
                if not genWaitForSolver(object) then return end
                task.wait(genSolverDelay())
                local paths = solveFlowBoard(board, FlowBoardModule)
                if not paths then warn("[Vortex] Flow not found"); return end
                for _, path in pairs(paths) do
                    if not genStillSolving(token, object) then return end
                    local drawing = board:Begin(path[1])
                    renderer:Render(); task.wait(genSolverDelay())
                    for i = 2, #path do
                        if not genStillSolving(token, object) then return end
                        board:Step(drawing, path[i], 0)
                        renderer:Render(); task.wait(genSolverDelay())
                    end
                    board:Release(drawing, true)
                    renderer:Render(); task.wait(genSolverDelay())
                end
                if genStillSolving(token, object) and board:IsSolved() then
                    object:__finish()
                    if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                end
            end)
            return object
        end

        local oldConnectNew = ConnectInputModule.new
        ConnectInputModule.new = function(board, renderer, callbacks)
            local object = oldConnectNew(board, renderer, callbacks)
            local token = MinigameSolver.Generation
            task.spawn(function()
                if not genWaitForSolver(object) then return end
                task.wait(genConnectDelay())
                if not board.Blobs then return end
                for blob in pairs(board.Blobs) do
                    if not genStillSolving(token, object) then return end
                    if not board:GetLink(blob) then
                        local mate = board:GetMate(blob)
                        if mate then
                            board:Connect(blob, mate)
                            renderer:Render(); task.wait(genConnectDelay())
                        end
                    end
                end
                if genStillSolving(token, object) and board:IsSolved() then
                    object:__finish()
                    if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                end
            end)
            return object
        end

        local oldGearNew = GearInputModule.new
        GearInputModule.new = function(getCenter, callbacks, enabled)
            local object = oldGearNew(getCenter, callbacks, enabled)
            local token = MinigameSolver.Generation
            task.spawn(function()
                if not genWaitForSolver(object) then return end
                task.wait(math.max(0.55, genSolverDelay()))
                for _ = 1, 100 do
                    if not genStillSolving(token, object) then return end
                    if callbacks and callbacks.OnTurn then callbacks.OnTurn(90) end
                    task.wait(math.max(0, GenConfig.GearDelay or 0.03))
                end
            end)
            return object
        end

        local oldLockNew = LockInputModule.new
        LockInputModule.new = function(ui, callbacks)
            local object = oldLockNew(ui, callbacks)
            local board = MinigameSolver.LockBoard
            local token = MinigameSolver.Generation
            task.spawn(function()
                if not genWaitForSolver(object) then return end
                while genStillSolving(token, object) and board and not board:IsBroken() do
                    local now = workspace:GetServerTimeNow()
                    if board:IsOnTarget(board:AngleAt(now)) then
                        if callbacks and callbacks.OnPress then callbacks.OnPress() end
                        task.wait(math.max(0.08, genSolverDelay()))
                    else RunService.Heartbeat:Wait() end
                end
            end)
            return object
        end
    end)
    if not ok then warn("[Vortex Gen] " .. tostring(err)) end
end
