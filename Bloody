local PA = { running=false, looking=false, lookStarted=nil, loop=nil }
local function PA_NormalizeAnim(id)
    return tostring(id or ""):match("(%d+)$") or tostring(id or "")
end
local function PA_AimOnce(humanoid, root, targetRoot)
    if not humanoid or not humanoid.Parent or not root or not root.Parent or not targetRoot or not targetRoot.Parent then return end
    local oldAuto = humanoid.AutoRotate
    pcall(function() humanoid.AutoRotate = false end)
    local endT = tick() + 0.5
    while tick() < endT and PA.running do
        if not humanoid.Parent or not root.Parent or not targetRoot.Parent then break end
        local target = targetRoot.Position
        local velocity = targetRoot.AssemblyLinearVelocity
        if velocity.Magnitude > 50 then velocity = velocity.Unit * 50 end
        target = target + velocity * (math.clamp(tonumber(Settings.PA_Prediction) or 4, 0, 20) * 0.05)
        pcall(function()
            root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.X, root.Position.Y, target.Z))
        end)
        RunService.Heartbeat:Wait()
    end
    if humanoid.Parent then pcall(function() humanoid.AutoRotate = oldAuto end) end
end
local function PA_Loop()
    while PA.running do
        RunService.Heartbeat:Wait()
        if PA.looking and PA.lookStarted and (tick() - PA.lookStarted) > 2 then
            PA.looking = false; PA.lookStarted = nil
        end
        if not PA.looking then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root and root.Parent and hum.Health > 0 then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    local aid = track.Animation and PA_NormalizeAnim(track.Animation.AnimationId)
                    if aid and PunchAnims["rbxassetid://"..aid] then
                        local kf = GetKillersFolder()
                        if kf then
                            local closest, cd = nil, math.huge
                            for _, k in ipairs(kf:GetChildren()) do
                                local kr = k:FindFirstChild("HumanoidRootPart")
                                local kh = k:FindFirstChildOfClass("Humanoid")
                                if kr and kh and kh.Health > 0 then
                                    local d = (root.Position - kr.Position).Magnitude
                                    if d < cd and d <= Settings.AIM_Range then cd = d; closest = kr end
                                end
                            end
                            if closest then
                                PA.looking = true; PA.lookStarted = tick()
                                task.spawn(function()
                                    pcall(PA_AimOnce, hum, root, closest)
                                    PA.looking = false; PA.lookStarted = nil
                                end)
                            end
                        end
                        break
                    end
                end
            end
        end
    end
end
local function PA_Enable() if PA.running then return end; PA.running = true; PA.loop = task.spawn(PA_Loop) end
local function PA_Disable()
    PA.running = false
    if PA.loop then pcall(task.cancel, PA.loop); PA.loop=nil end
    PA.looking = false; PA.lookStarted = nil
end

