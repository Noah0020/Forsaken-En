local spoofedName = ""
local nameConns   = {}
local spoofInput

local randomWords = {"cat","wall","super","bail","song","ride","soul","job","party","blow","gamer","pop","star","night","neo","boom","cold","duck"}
local function makeRandomName()
	local n = #randomWords
	local a, b = randomWords[math.random(n)], randomWords[math.random(n)]
	while a == b do b = randomWords[math.random(n)] end
	return a .. b .. "_" .. math.random(101)
end

local function applyNameSpoof(newName)
	if not newName or newName == "" then return end
	for _, c in pairs(nameConns) do c:Disconnect() end
	table.clear(nameConns)
	local function replace(desc)
		if (desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton")) and desc.Text then
			if string.find(desc.Text, LocalPlayer.Name) then
				desc.Text = string.gsub(desc.Text, LocalPlayer.Name, newName)
			end
		end
	end
	for _, d in pairs(PlayerGui:GetDescendants()) do replace(d); v6() end
	for _, d in pairs(CoreGui:GetDescendants())  do replace(d); v6() end
	table.insert(nameConns, PlayerGui.DescendantAdded:Connect(replace))
	table.insert(nameConns, CoreGui.DescendantAdded:Connect(replace))
end

