local AB = { running=false, frameConn=nil, visual={}, perKiller={}, lastBlock=0, BLOCK_COOLDOWN=27 }
local PLAYER_R = 1.5
local RED, GREEN = Color3.fromRGB(255,70,70), Color3.fromRGB(70,255,120)

local function getHitboxConfig(killerName)
    if not killerName then return Settings.KillerHitbox["Default"] end
    for name, cfg in pairs(Settings.KillerHitbox) do
        if string.find(killerName, name, 1, true) then return cfg end
    end
    return Settings.KillerHitbox["Default"]
end

local function AB_IsInZone(myPos, killerRoot, killerModel)
    local mode = Settings.AB_FacingMode
    local kPos, kCF = killerRoot.Position, killerRoot.CFrame
    if mode == "Circle" then
        local dx, dz = myPos.X - kPos.X, myPos.Z - kPos.Z
        local r = Settings.AB_CircleRadius + PLAYER_R
        return dx*dx + dz*dz <= r*r
    end
    local look = kCF.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) end
    flatLook = flatLook.Unit
    local right = Vector3.new(-flatLook.Z, 0, flatLook.X)
    if mode == "Dot" then
        local center = kPos + flatLook * Settings.AB_DotDistance
        local dx, dz = myPos.X - center.X, myPos.Z - center.Z
        local r = Settings.AB_DotRadius + PLAYER_R
        return dx*dx + dz*dz <= r*r
    elseif mode == "Diamond" then
        local rel = myPos - kPos
        local dF, dR = rel:Dot(flatLook), rel:Dot(right)
        local cd = Settings.AB_DiamondOffset + Settings.AB_DiamondLength/2
        local d = dF - cd
        local hw = Settings.AB_DiamondWidth/2 + PLAYER_R
        local hl = Settings.AB_DiamondLength/2 + PLAYER_R
        return math.abs(dR)/hw + math.abs(d)/hl <= 1
    elseif mode == "Box" then
        local cfg = getHitboxConfig(killerModel and killerModel.Name)
        local boxCenter = kPos + flatLook * cfg.distance
        local rel = myPos - boxCenter
        local dx, dy, dz = rel:Dot(right), rel.Y, rel:Dot(flatLook)
        local hw = cfg.width/2 + PLAYER_R
        local hh = cfg.height/2 + PLAYER_R
        local hl = cfg.length/2 + PLAYER_R
        return math.abs(dx) <= hw and math.abs(dy) <= hh and math.abs(dz) <= hl
    end
    return false
end

local function AB_IsBlockReady()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(Settings.AB_Mode == "007n7" and "Clone" or "Block")
    if btn then
        local cd = btn:FindFirstChild("CooldownTime")
        if cd then
            local t = cd.Text
            if t == nil or t == "" or t == " " then return true end
            return false
        end
    end
    return (tick() - (AB.lastBlock or 0)) >= (AB.BLOCK_COOLDOWN - 1)
end

local function AB_FireBlock()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    if buffer and buffer.fromstring then
        pcall(function()
            NetworkEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0"..name) })
        end)
    end
    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(name)
    if btn and firesignal then
        local sig = btn:FindFirstChildOfClass("MouseButton1Click")
        if sig then pcall(firesignal, sig) end
    end
end

local function AB_FireSpam()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local count = math.max(1, tonumber(Settings.AB_SpamCount) or 4)
    if buffer and buffer.fromstring then
        local buf = buffer.fromstring("\3\5\0\0\0"..name)
        for i = 1, count do
            task.spawn(function()
                pcall(function() NetworkEvent:FireServer("UseActorAbility", {buf}) end)
            end)
        end
    end
    local dur = tonumber(Settings.AB_SpamDuration) or 0.05
    if dur > 0 then
        task.spawn(function()
            local endT = tick() + dur
            while tick() < endT do
                pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
                task.wait(0.001)
            end
        end)
    end
end

local function AB_Fire() if Settings.AB_SpamEnabled then AB_FireSpam() else AB_FireBlock() end end

local function AB_TryFire(killer)
    local st = AB.perKiller[killer]
    if not st then return end
    if st.pendingUntil <= 0 or tick() > st.pendingUntil then return end
    if not AB_IsBlockReady() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not hum or hum.Health <= 0 then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp or not hrp.Parent then return end
    if not AB_IsInZone(root.Position, hrp, killer) then return end
    st.pendingUntil = 0
    st.lastFireAt = tick()
    AB.lastBlock = tick()
    AB_Fire()
end

local function AB_OnAttributeChanged(killer)
    if not AB.running then return end
    local st = AB.perKiller[killer]
    if not st then return end
    local aU = killer:GetAttribute("AbilitiesUsed") or 0
    if aU > st.lastUsed then st.lastUsed = aU; st.baitFlag = true end
    local aLU = killer:GetAttribute("AbilityLastUsed") or 0
    if aLU <= st.lastAbility then return end
    st.lastAbility = aLU
    if st.baitFlag then st.baitFlag = false; return end
    st.pendingUntil = tick() + Settings.AB_PendingWindow
    AB_TryFire(killer)
end

local function AB_HookKiller(killer)
    if not killer:IsA("Model") or AB.perKiller[killer] then return end
    local st = {
        lastAbility = killer:GetAttribute("AbilityLastUsed") or 0,
        lastUsed    = killer:GetAttribute("AbilitiesUsed")   or 0,
        baitFlag    = false, pendingUntil = 0, lastFireAt = 0,
    }
    local ok, conn = pcall(function()
        return killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            AB_OnAttributeChanged(killer)
        end)
    end)
    if ok and conn then st.signalConn = conn end
    AB.perKiller[killer] = st
end

local function AB_UnhookKiller(killer)
    local st = AB.perKiller[killer]
    if st and st.signalConn then pcall(function() st.signalConn:Disconnect() end) end
    AB.perKiller[killer] = nil
end

local function AB_FrameLoop()
    if not AB.running then return end
    local kf = GetKillersFolder(); if not kf then return end
    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            if not AB.perKiller[killer] then AB_HookKiller(killer) end
            local st = AB.perKiller[killer]
            if st then
                local aU = killer:GetAttribute("AbilitiesUsed") or 0
                if aU > st.lastUsed then st.lastUsed = aU; st.baitFlag = true end
                if st.pendingUntil > 0 then AB_TryFire(killer) end
            end
        end
    end
    for k in pairs(AB.perKiller) do if not k.Parent then AB_UnhookKiller(k) end end
end

local function AB_RemoveVisual(model)
    local v = AB.visual[model]
    if v and v.folder then v.folder:Destroy() end
    AB.visual[model] = nil
end

local function AB_MakePart(folder)
    local p = Instance.new("Part")
    p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.CastShadow=false
    p.Material=Enum.Material.Neon; p.Transparency=0.35; p.Parent=folder
    return p
end

local function AB_UpdateVisual(model, hrp)
    if not hrp or not hrp.Parent then AB_RemoveVisual(model); return end
    if not Settings.AB_ShowZone then AB_RemoveVisual(model); return end
    if not LocalRoot or not LocalRoot.Parent then return end
    local v = AB.visual[model]
    if not v then
        local folder = Instance.new("Folder"); folder.Name="GS_AB_Visual"; folder.Parent=Workspace
        v = { folder=folder, parts={}, mode=nil }; AB.visual[model]=v
    end
    local inZoneNow = AB_IsInZone(LocalRoot.Position, hrp, model)
    local color = inZoneNow and GREEN or RED
    local mode  = Settings.AB_FacingMode
    local origin = hrp.Position
    if v.mode ~= mode then
        for _, p in ipairs(v.parts) do p:Destroy() end
        table.clear(v.parts)
        v.mode = mode; v.circle = nil
        if mode == "Circle" or mode == "Dot" then
            local c = AB_MakePart(v.folder); c.Shape = Enum.PartType.Cylinder
            table.insert(v.parts, c); v.circle = c
        elseif mode == "Diamond" then
            for i=1,4 do table.insert(v.parts, AB_MakePart(v.folder)) end
            for i=1,4 do
                local b = Instance.new("Part")
                b.Shape=Enum.PartType.Ball; b.Anchored=true; b.CanCollide=false
                b.CanTouch=false; b.CanQuery=false; b.CastShadow=false
                b.Material=Enum.Material.Neon; b.Size=Vector3.new(0.7,0.7,0.7)
                b.Parent=v.folder; table.insert(v.parts, b)
            end
        elseif mode == "Box" then
            for i=1,12 do table.insert(v.parts, AB_MakePart(v.folder)) end
        end
    end
    if mode == "Circle" or mode == "Dot" then
        local c = v.circle
        local center, radius
        if mode == "Circle" then
            center, radius = origin, Settings.AB_CircleRadius
        else
            local fwd = hrp.CFrame.LookVector
            local flatFwd = Vector3.new(fwd.X, 0, fwd.Z)
            if flatFwd.Magnitude < 0.01 then flatFwd = Vector3.new(0,0,-1) end
            flatFwd = flatFwd.Unit
            center = origin + flatFwd * Settings.AB_DotDistance
            radius = Settings.AB_DotRadius
        end
        c.Color = color
        c.Size  = Vector3.new(0.18, radius*2, radius*2)
        c.CFrame = CFrame.new(center + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, 0, math.rad(90))
    elseif mode == "Diamond" then
        local fwd = hrp.CFrame.LookVector
        local flatFwd = Vector3.new(fwd.X, 0, fwd.Z)
        if flatFwd.Magnitude < 0.01 then flatFwd = Vector3.new(0,0,-1) end
        flatFwd = flatFwd.Unit
        local rgt = Vector3.new(-flatFwd.Z, 0, flatFwd.X)
        local off, L, W = Settings.AB_DiamondOffset, Settings.AB_DiamondLength, Settings.AB_DiamondWidth
        local yOff = 0.06
        local pBase  = origin + flatFwd*off          + Vector3.new(0, yOff, 0)
        local pTip   = origin + flatFwd*(off + L)    + Vector3.new(0, yOff, 0)
        local pLeft  = origin + flatFwd*(off + L/2) - rgt*(W/2) + Vector3.new(0, yOff, 0)
        local pRight = origin + flatFwd*(off + L/2) + rgt*(W/2) + Vector3.new(0, yOff, 0)
        local function posLine(part, a, b)
            local diff = b - a; local len = diff.Magnitude
            if len <= 0.001 then part.Transparency = 1; return end
            part.Transparency = 0.35; part.Color = color
            part.Size = Vector3.new(0.18, 0.18, len)
            part.CFrame = CFrame.lookAt((a+b)/2, b)
        end
        posLine(v.parts[1], pBase, pLeft); posLine(v.parts[2], pBase, pRight)
        posLine(v.parts[3], pLeft, pTip); posLine(v.parts[4], pRight, pTip)
        local b1,b2,b3,b4 = v.parts[5], v.parts[6], v.parts[7], v.parts[8]
        for _, b in ipairs({b1,b2,b3,b4}) do b.Color = color; b.Transparency = 0.2 end
        b1.Position = pBase; b2.Position = pLeft; b3.Position = pRight; b4.Position = pTip
    elseif mode == "Box" then
        local cfg = getHitboxConfig(model.Name)
        local boxCF = hrp.CFrame * CFrame.new(0, 0, -cfg.distance)
        local w, h, l = cfg.width, cfg.height, cfg.length
        local hw, hh, hl = w/2, h/2, l/2
        local corners = {
            Vector3.new(-hw, -hh, -hl), Vector3.new(hw, -hh, -hl),
            Vector3.new(hw, -hh, hl), Vector3.new(-hw, -hh, hl),
            Vector3.new(-hw, hh, -hl), Vector3.new(hw, hh, -hl),
            Vector3.new(hw, hh, hl), Vector3.new(-hw, hh, hl),
        }
        local edges = {
            {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8},
        }
        for i, e in ipairs(edges) do
            local p1 = boxCF:PointToWorldSpace(corners[e[1]])
            local p2 = boxCF:PointToWorldSpace(corners[e[2]])
            local len = (p2-p1).Magnitude
            local part = v.parts[i]
            if part and len > 0.001 then
                part.Transparency = 0.35; part.Color = color
                part.Size = Vector3.new(0.15, 0.15, len)
                part.CFrame = CFrame.lookAt((p1+p2)/2, p2)
            elseif part then part.Transparency = 1 end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not Settings.AB_ShowZone then
        for m in pairs(AB.visual) do AB_RemoveVisual(m) end
        return
    end
    local kf = GetKillersFolder()
    if kf then
        for _, m in ipairs(kf:GetChildren()) do
            if m:IsA("Model") then AB_UpdateVisual(m, m:FindFirstChild("HumanoidRootPart")) end
