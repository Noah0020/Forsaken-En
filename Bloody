local function setInvis(on)
    C.Invisible = on
    if invisConn then invisConn:Disconnect(); invisConn = nil end
    if on then
        invisConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.LocalTransparencyModifier = 1
                elseif p:IsA("Decal") or p:IsA("Texture") then
                    p.Transparency = 1
                end
            end
        end)
        Notify("Invisible ON")
    end
end

local gbConn, gbLock = nil, false
local function setGhostBurger(on)
    C.GhostBurger = on
    if gbConn then gbConn:Disconnect(); gbConn = nil end
    if on then
        gbConn = RunService.Heartbeat:Connect(function()
            if gbLock or not C.GhostBurger then return end
            RefreshFolders()
            local char = LocalPlayer.Character
            if not char or not SurvivorsFolder or char.Parent ~= SurvivorsFolder then return end
            if #SurvivorsFolder:GetChildren() > 1 then return end
            gbLock = true
            task.delay(12, function() gbLock = false end)
            FireAbility("Ghostburger"); FireAbility("GhostBurger")
            Notify("Ghost Burger LMS")
        end)
        Notify("Auto Ghost Burger ON")
    end
end

local noclipConn
local function setNoclip(on)
    C.Noclip = on
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if on then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    end
end

local function setFB(on)
    C.Fullbright = on
    if on then
        Lighting.Brightness = 3; Lighting.ClockTime = 14
        Lighting.Ambient = Color3.new(1,1,1); Lighting.OutdoorAmbient = Color3.new(1,1,1)
        Lighting.FogEnd = 1e9; Lighting.GlobalShadows = false
    end
end

