--═══ SILENT AIM (true metatable silent aim — no cam/char rotation) ═══
local SilentAim = {
    active = false,
    aimPoint = nil,
    fireHookDone = false,
    mouseHookDone = false,
    buttonConns = {},
    scanConn = nil,
    lastAim = nil,
    lastAimTime = 0,
}

local function SilentAim_ComputeAimPoint()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local kf = GetKillersFolder()
    if not kf then return nil end

    local killer, kr, dist = nil, nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then dist = d; killer = k; kr = krp end
        end
    end
    if not killer or dist > Settings.SILENT_Range or dist < Settings.SILENT_MinDist then
        return nil
    end

    -- Predict killer's position (studs in front)
    local vel = kr.AssemblyLinearVelocity
    if not vel or vel.Magnitude < 0.1 then vel = kr.Velocity end
    if vel.Magnitude > 60 then vel = vel.Unit * 60 end
    local leadTime = math.clamp(Settings.SILENT_Prediction or 4, 1, 10) * 0.1
    return kr.Position + vel * leadTime
end

local function SilentAim_Arm(duration)
    local aim = SilentAim_ComputeAimPoint()
    if not aim then return false end
    SilentAim.aimPoint = aim
    SilentAim.active = true
    SilentAim.lastAim = aim
    SilentAim.lastAimTime = os.clock()
    local myGen = SilentAim.lastAimTime
    task.delay(duration or 0.15, function()
        if SilentAim.lastAimTime == myGen then
            SilentAim.active = false
            SilentAim.aimPoint = nil
        end
    end)
    return true
end

local function SilentAim_Disarm()
    SilentAim.active = false
    SilentAim.aimPoint = nil
end

local function IsSilentAimAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower()
    if Settings.SILENT_OnCorrupt and (l:find("corrupt", 1, true) or l:find("nature", 1, true)) then return true end
    if Settings.SILENT_OnNova and (l:find("nova", 1, true) or l:find("void", 1, true)) then return true end
    if Settings.SILENT_OnDemonic and (l:find("demonic", 1, true) or l:find("infernal", 1, true) or l:find("pursuit", 1, true)) then return true end
    if Settings.SILENT_OnAscension and (l:find("ascension", 1, true) or l:find("cataclysm", 1, true)) then return true end
    if Settings.SILENT_OnPlasma and l:find("plasma", 1, true) then return true end
    if Settings.SILENT_OnCrystal and (l:find("crystal", 1, true) or l:find("pitch", 1, true)) then return true end
    return false
end

-- Replace any Vector3 / CFrame position args with the aim point
local function SilentAim_RewriteArgs(args, aim)
    if not aim then return end
    for i = 2, #args do
        local v = args[i]
        local tv = typeof(v)
        if tv == "Vector3" then
            args[i] = aim
        elseif tv == "CFrame" then
            args[i] = CFrame.new(aim)
        elseif type(v) == "table" then
            for k, vv in pairs(v) do
                local ttv = typeof(vv)
                if ttv == "Vector3" then
                    v[k] = aim
                elseif ttv == "CFrame" then
                    v[k] = CFrame.new(aim)
                end
            end
        end
    end
end

local function SilentAim_SetupMouseHook()
    if SilentAim.mouseHookDone then return end
    pcall(function()
        local mouse = LocalPlayer:GetMouse()
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if SilentAim.active and self == mouse and SilentAim.aimPoint then
                if key == "Hit" or key == "Target" then
                    return CFrame.new(SilentAim.aimPoint)
                elseif key == "UnitRay" then
                    local cam = Workspace.CurrentCamera
                    if cam then
                        return Ray.new(cam.CFrame.Position, (SilentAim.aimPoint - cam.CFrame.Position).Unit)
                    end
                elseif key == "X" then
                    return SilentAim.aimPoint.X
                elseif key == "Y" then
                    return SilentAim.aimPoint.Y
                end
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
        SilentAim.mouseHookDone = true
    end)
end

local function SilentAim_SetupFireHook()
    if SilentAim.fireHookDone or not NetworkEvent or not hookmetamethod then return end
    pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if Settings.SILENT_Enabled and getnamecallmethod() == "FireServer" and self == NetworkEvent then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsSilentAimAbility(n) then
                        -- Arm aim (also enables mouse.Hit override in case the
                        -- game reads it right before firing)
                        local aim = SilentAim_ComputeAimPoint()
                        if aim then
                            SilentAim.aimPoint = aim
                            SilentAim.active = true
                            -- Rewrite any position args in the FireServer call
                            SilentAim_RewriteArgs(args, aim)
                        end
                        local result = old(self, table.unpack(args, 1, #args))
                        SilentAim_Disarm()
                        return result
                    end
                end
            end
            return old(self, ...)
        end)
        SilentAim.fireHookDone = true
    end)
end

local function SilentAim_HookButton(btn)
    if not btn or not btn:IsA("GuiButton") or SilentAim.buttonConns[btn] then return end
    local conn = btn.MouseButton1Down:Connect(function()
        if not Settings.SILENT_Enabled then return end
        if IsSilentAimAbility(btn.Name) then
            -- Pre-arm so if the game reads mouse.Hit BEFORE calling FireServer,
            -- it already sees the aim point
            SilentAim_Arm(0.15)
        end
    end)
    SilentAim.buttonConns[btn] = conn
end

local function SilentAim_ScanButtons()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    if not mainUI then return end
    local ac = mainUI:FindFirstChild("AbilityContainer")
    if not ac then return end
