local function HookKiller(killerModel)
    if not killerModel then return end
    local hum=killerModel:FindFirstChildOfClass("Humanoid")
    if not hum then killerModel.ChildAdded:Connect(function(c) if c:IsA("Humanoid") then task.wait(0.3) HookKiller(killerModel) end end) return end
    local animator=hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator",3) if not animator then return end
