local jd = { enabled = false, aimbotOn = false, patched = false, aimOffset = -0.3, prediction = 0.6 }
local function jd_applyPatch()
    if jd.patched or not NetworkRF then return end
    rfDispatch:register("jd", function(reqName, ...)
        if not (jd.enabled and jd.aimbotOn) then return nil end
        local char = LP.Character; local myHRP = char and char:FindFirstChild("HumanoidRootPart")
        if not myHRP then return nil end
        local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
        if not kf then return nil end
        local best, bd = nil, math.huge
        for _, k in ipairs(kf:GetChildren()) do
            local hrp = k:FindFirstChild("HumanoidRootPart"); local h = k:FindFirstChildOfClass("Humanoid")
            if hrp and h and h.Health > 0 then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bd then bd = d; best = hrp end
            end
        end
        if not best then return nil end
        if reqName == "GetMousePosition" then
            local vel = getHRPVelocity(best)
            return best.Position + vel * jd.prediction + Vector3.new(0, jd.aimOffset, 0)
        end
        return nil
    end)
    jd.patched = true
end
local function jd_removePatch()
    if not jd.patched then return end
    rfDispatch:unregister("jd"); jd.patched = false
end

local dusekkar = { enabled = false, prediction = 0.12, aimOffset = 0.0 }
if NetworkRF then
    rfDispatch:register("plasma", function(reqName, ...)
        if reqName ~= "GetMousePosition" or not dusekkar.enabled then return nil end
        local t = GetNearestKillerHrp(); if not t then return nil end
        local vel = getHRPVelocity(t)
        return t.Position + vel * dusekkar.prediction + Vector3.new(0, dusekkar.aimOffset, 0)
    end)
end

