local HDT = { running=false, debounce=false, animConn=nil, watcher=nil, charConn=nil, bind="Cupcake_HDT_", dashId=0, Speed=Settings.HDT_Speed, Duration=Settings.HDT_Duration, Delay=Settings.HDT_Delay }
local function HDT_Nearest()
    local kf = GetKillersFolder(); if not kf or not LocalRoot then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        if kr then
            local d = (kr.Position - LocalRoot.Position).Magnitude
            if d < bd then best, bd = k, d end
        end
    end
    return best
end
local function HDT_Dash(killer)
    if HDT.debounce then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if not killer or not killer.Parent then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true; HDT.dashId = HDT.dashId + 1
    local thisBind = HDT.bind .. tostring(HDT.dashId)
    local startT = tick(); local active = true
    local bv = Instance.new("BodyVelocity")
    bv.Name = "Cupcake_HDT_BV"; bv.MaxForce = Vector3.new(1e6, 0, 1e6); bv.Velocity = Vector3.zero; bv.Parent = hrp
    local bg = Instance.new("BodyGyro")
    bg.Name = "Cupcake_HDT_BG"; bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); bg.P = 100000; bg.D = 1000; bg.Parent = hrp
    local oldWS = hum.WalkSpeed; local oldAR = hum.AutoRotate
    hum.WalkSpeed = 0; hum.AutoRotate = false
    local function stop()
        if not active then return end
        active = false; HDT.debounce = false
        pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        if bv and bv.Parent then bv:Destroy() end
        if bg and bg.Parent then bg:Destroy() end
        if hum and hum.Parent then pcall(function() hum.WalkSpeed = oldWS end); pcall(function() hum.AutoRotate = oldAR end) end
    end
    pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
    RunService:BindToRenderStep(thisBind, Enum.RenderPriority.Camera.Value, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health <= 0 then stop(); return end
        if not kr.Parent then stop(); return end
        if tick() - startT > HDT.Duration then stop(); return end
        local toK = kr.Position - hrp.Position
        local flat = Vector3.new(toK.X, 0, toK.Z)
        if flat.Magnitude < 1 then stop(); return end
        if bv and bv.Parent then bv.Velocity = flat.Unit * HDT.Speed end
        if bg and bg.Parent then bg.CFrame = CFrame.new(hrp.Position, hrp.Position + flat.Unit) end
        if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
        if hum.AutoRotate then hum.AutoRotate = false end
    end)
    task.delay(HDT.Duration + 0.2, stop)
end
