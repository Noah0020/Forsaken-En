        if k:IsA("Model") then pcall(checkKiller, k) end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not AutoBlockEnabled or not kf then
        for _, state in pairs(ConeState) do hideCone(state) end
        return
    end
    local char = LP.Character
    local playerHRP = char and char:FindFirstChild("HumanoidRootPart")
    local now = os.clock()

    local expired = {}
    for killer, data in pairs(activeBlocks) do
        if now > data.expiresAt or not killer.Parent then table.insert(expired, killer) end
    end
    for _, killer in ipairs(expired) do activeBlocks[killer] = nil end

    local deadKillers = {}
    for killer in pairs(ConeState) do
        if not killer.Parent then table.insert(deadKillers, killer) end
    end
    for _, killer in ipairs(deadKillers) do destroyCone(killer) end

    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") then
            local killerRoot = killer:FindFirstChild("HumanoidRootPart")
            local killerHum = killer:FindFirstChildOfClass("Humanoid")
            if killerRoot and killerHum and killerHum.Health > 0 then
                local state = getOrCreateCone(killer)
                local activeBlock = activeBlocks[killer]
                local cf = killerRoot.CFrame
                local look = cf.LookVector
                local currentYaw = math.atan2(-look.X, -look.Z)
                local half = ConeConfig.NormalAngle / 2
                local leftA, rightA = half, half
                if state.turnDir == 1 then leftA = state.currentAngle - half
                elseif state.turnDir == -1 then rightA = state.currentAngle - half end
                local inCone = false
                if playerHRP then
                    inCone = isPlayerInCone(killerRoot, playerHRP.Position, currentYaw, leftA, rightA)
                end
                if ConeConfig.ShowBox then
                    local color = inCone and ConeConfig.ColorHit or ConeConfig.Color
                    updateCone(state, killerRoot, dt, color)
                elseif not inCone and state.currentAngle == ConeConfig.NormalAngle then
                    hideCone(state)
                end
                if activeBlock and inCone and not activeBlock.fired then
                    activeBlock.fired = true
                    fireBlock()
                    HDT_Fire(killer)
                end
            else
                destroyCone(killer)
            end
        end
    end
end)

