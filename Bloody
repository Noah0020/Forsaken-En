-- ============================================================
-- STAB AIM + STAB TELEPORT (separate Two Time module)
-- Reintegrates the supplied behind-killer teleport and brief follow routine
-- into Bloodsaken's own Stab tab, without the source file's extra standalone GUI.
-- ============================================================
local StabAim = {
    enabled = false,
    aimMode = "Character + Camera",
    velocityLead = 0.12,
    maxRange = 60,
    cooldown = 0.5,
    lastTrigger = 0,
    activeUntil = 0,
    activeTarget = nil,
    animatorConnection = nil,
    teleportEnabled = false,
    behindOffset = 1.7,
    teleportRange = 60,
    teleportCooldown = 0.5,
    teleportDelay = 0.02,
    followDuration = 0.5,
    lastTeleport = 0,
    teleportActive = false,
    teleportConnection = nil,
    originalAutoRotate = true,
    savedHumanoid = nil,
}
local STAB_ANIMATION_IDS = {
    ["100725497418533"] = true,
    ["89448354637442"] = true,
}

local function stopStabTeleport()
    if StabAim.teleportConnection then
        pcall(function() StabAim.teleportConnection:Disconnect() end)
        StabAim.teleportConnection = nil
    end
    StabAim.teleportActive = false
    local humanoid = StabAim.savedHumanoid
    if humanoid and humanoid.Parent then humanoid.AutoRotate = StabAim.originalAutoRotate end
    StabAim.savedHumanoid = nil
end
StabAim.stopTeleport = stopStabTeleport

local function runStabTeleport(killer, manual)
    if not StabAim.teleportEnabled and not manual then return false end
    if StabAim.teleportActive then return false end
    local now = os.clock()
    if now - StabAim.lastTeleport < StabAim.teleportCooldown then return false end

    local character = lp.Character
    if not hunterIsSurvivor(character) then return false end
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    local myHumanoid = character and character:FindFirstChildOfClass("Humanoid")
    killer = (killer and killer.Parent == KillersFolder) and killer or getNearestKiller()
    local killerRoot = killer and killer:FindFirstChild("HumanoidRootPart")
    local killerHumanoid = killer and killer:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHumanoid or not killerRoot then return false end
    if killerHumanoid and killerHumanoid.Health <= 0 then return false end
    if (killerRoot.Position - myRoot.Position).Magnitude > StabAim.teleportRange then return false end

    StabAim.lastTeleport = now
    StabAim.teleportActive = true
    task.spawn(function()
        task.wait(math.clamp(StabAim.teleportDelay, 0, 0.5))
        if not StabAim.teleportActive or lp.Character ~= character or not killer.Parent then
            stopStabTeleport()
            return
        end

        local currentRoot = character:FindFirstChild("HumanoidRootPart")
        local currentKillerRoot = killer:FindFirstChild("HumanoidRootPart")
        if not currentRoot or not currentKillerRoot then
            stopStabTeleport()
            return
        end

        StabAim.originalAutoRotate = myHumanoid.AutoRotate
        StabAim.savedHumanoid = myHumanoid
        myHumanoid.AutoRotate = false

        local function getBehindCFrame()
            local kcf = currentKillerRoot.CFrame
            local behindPosition = kcf.Position - kcf.LookVector * math.clamp(StabAim.behindOffset, 0.5, 6)
            return CFrame.lookAt(
                Vector3.new(behindPosition.X, currentRoot.Position.Y, behindPosition.Z),
                Vector3.new(kcf.Position.X, currentRoot.Position.Y, kcf.Position.Z)
            )
        end

        currentRoot.CFrame = getBehindCFrame()
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        local endTime = os.clock() + math.clamp(StabAim.followDuration, 0.1, 2)

        StabAim.teleportConnection = RunService.RenderStepped:Connect(function()
            if not StabAim.teleportActive or os.clock() >= endTime
                or lp.Character ~= character or not killer.Parent then
                stopStabTeleport()
                return
            end
            currentRoot = character:FindFirstChild("HumanoidRootPart")
            currentKillerRoot = killer:FindFirstChild("HumanoidRootPart")
            if not currentRoot or not currentKillerRoot then
                stopStabTeleport()
                return
            end
            local kcf = currentKillerRoot.CFrame
            local behindPosition = kcf.Position - kcf.LookVector * math.clamp(StabAim.behindOffset, 0.5, 6)
            local targetCFrame = CFrame.lookAt(
                Vector3.new(behindPosition.X, currentRoot.Position.Y, behindPosition.Z),
                Vector3.new(kcf.Position.X, currentRoot.Position.Y, kcf.Position.Z)
            )
            currentRoot.CFrame = currentRoot.CFrame:Lerp(targetCFrame, 0.5)
            currentRoot.AssemblyLinearVelocity = Vector3.zero
        end)
    end)
    return true
end

StabAim.teleportNow = function()
    return runStabTeleport(getNearestKiller(), true)
end

local function stabBindCharacter(character)
    if StabAim.animatorConnection then pcall(function() StabAim.animatorConnection:Disconnect() end) end
    StabAim.animatorConnection = nil
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5))
    if not animator then return end
    StabAim.animatorConnection = animator.AnimationPlayed:Connect(function(track)
        if (not StabAim.enabled and not StabAim.teleportEnabled) or not hunterIsSurvivor(character) then return end
        local animation = track and track.Animation
        local id = animation and tostring_ref(animation.AnimationId):match("%d+")
        if not id or not STAB_ANIMATION_IDS[id] then return end
        local now = os.clock()
        local killer = getNearestKiller()
        local targetRoot = killer and killer:FindFirstChild("HumanoidRootPart")
        local myRoot = character:FindFirstChild("HumanoidRootPart")
        if not targetRoot or not myRoot then return end

        if StabAim.enabled and (targetRoot.Position - myRoot.Position).Magnitude <= StabAim.maxRange
            and now - StabAim.lastTrigger >= StabAim.cooldown then
            StabAim.lastTrigger = now
            StabAim.activeTarget = killer
            local duration = track.Length
            if not duration or duration <= 0 then duration = 0.45 end
            StabAim.activeUntil = now + math.clamp(duration + 0.1, 0.2, 2.5)
            local expectedEnd = StabAim.activeUntil
            local stopped = false
            local stopConnection
            local function finishStabAim()
                if stopped then return end
                stopped = true
                if stopConnection then pcall(function() stopConnection:Disconnect() end) end
                if StabAim.activeUntil == expectedEnd then StabAim.activeUntil = 0 end
            end
            stopConnection = track.Stopped:Connect(finishStabAim)
            task.delay(math.clamp(duration + 0.15, 0.25, 2.6), finishStabAim)
        end

        if StabAim.teleportEnabled then runStabTeleport(killer, false) end
        if HunterAim.debug then print("[Bloodsaken Stab] detected", id) end
    end)
end

if lp.Character then task.spawn(stabBindCharacter, lp.Character) end
