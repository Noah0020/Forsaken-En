local STAB = { running=false, connections={}, hookedAnimators=setmetatable({}, {__mode="k"}), lastStab=0, stabbing=false, lerpConn=nil, originalAutoRotate=true, teleportDelay=0.02 }
local STAB_ANIM_IDS = { ["100725497418533"]=true, ["89448354637442"]=true }
local function stabGetKHRP(m) return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)) end
local function stabGetKiller() local f = getFolder("Killers"); if not f then return nil end for _, k in ipairs(f:GetChildren()) do if k:IsA("Model") then local h = stabGetKHRP(k); local hum = getHum(k); if h and hum and hum.Health > 0 then return k, h end end end return nil end
local function stabIsDagger(t) local a = t and t.Animation; if not a then return false end local n = tostring(a.AnimationId):match("%d+") return n and STAB_ANIM_IDS[n] == true end
local function stabStopLerp() if STAB.lerpConn then pcall(function() STAB.lerpConn:Disconnect() end); STAB.lerpConn = nil end local hum = LocalPlayer.Character and getHum(LocalPlayer.Character); if hum then hum.AutoRotate = STAB.originalAutoRotate end STAB.stabbing = false end
local function stabFollow(killerModel)
    if STAB.lerpConn then pcall(function() STAB.lerpConn:Disconnect() end); STAB.lerpConn = nil end
    local hum = LocalPlayer.Character and getHum(LocalPlayer.Character)
    STAB.originalAutoRotate = hum and hum.AutoRotate or true
    if hum then hum.AutoRotate = false end
    local endTime = os.clock() + Settings.StabFollowDuration
    STAB.lerpConn = RunService.RenderStepped:Connect(function()
        if os.clock() >= endTime or not STAB.stabbing then stabStopLerp(); return end
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"); if not h then stabStopLerp(); return end
        local kr = stabGetKHRP(killerModel); if not kr or not kr.Parent then stabStopLerp(); return end
        local kCF = kr.CFrame; local behind = kCF.Position - kCF.LookVector * Settings.StabBehindOffset
        h.CFrame = h.CFrame:Lerp(CFrame.lookAt(Vector3.new(behind.X, h.Position.Y, behind.Z), Vector3.new(kCF.Position.X, h.Position.Y, kCF.Position.Z)), 0.5)
        h.AssemblyLinearVelocity = Vector3.zero
    end)
end
local function doStab()
    if not STAB.running or STAB.stabbing then return end
    if os.clock() - STAB.lastStab < Settings.StabCooldown then return end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local killer, kr = stabGetKiller(); if not killer or not kr then return end
    if (kr.Position - myHRP.Position).Magnitude > Settings.StabMaxRange then return end
    STAB.stabbing = true; STAB.lastStab = os.clock()
    local kCF = kr.CFrame; local behind = kCF.Position - kCF.LookVector * Settings.StabBehindOffset
    local target = CFrame.lookAt(Vector3.new(behind.X, myHRP.Position.Y, behind.Z), Vector3.new(kCF.Position.X, myHRP.Position.Y, kCF.Position.Z))
    task.wait(STAB.teleportDelay)
    local now = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not now then STAB.stabbing = false; return end
    now.CFrame = target; now.AssemblyLinearVelocity = Vector3.zero; stabFollow(killer)
end
_G.IvyStab = doStab
local function stabHookAnim(anim)
    if not anim or not anim:IsA("Animator") or STAB.hookedAnimators[anim] then return end
    STAB.hookedAnimators[anim] = true
    table.insert(STAB.connections, anim.AnimationPlayed:Connect(function(t) if stabIsDagger(t) and Settings.AutoStab then doStab() end end))
end
local function stabBindChar(char)
    if not char then return end
    local h = char:FindFirstChildOfClass("Humanoid"); if not h then return end
    local a = h:FindFirstChildOfClass("Animator") or h:WaitForChild("Animator", 3)
    if a then stabHookAnim(a) end
    table.insert(STAB.connections, char.DescendantAdded:Connect(function(d) if d:IsA("Animator") then stabHookAnim(d) end end))
end
local function StartStab() if STAB.running then return end STAB.running = true; STAB.hookedAnimators = setmetatable({}, {__mode="k"}); STAB.connections = {}
    if LocalPlayer.Character then stabBindChar(LocalPlayer.Character) end
