-- ================================================================
local AutoBlockGroup = addGroup(Tabs.AutoBlock, "Left", "Auto block", "Single box-based block check", "shield")
local AutoPunchGroup = addGroup(Tabs.AutoBlock, "Left", "Auto punch", "Punch only after a confirmed block", "zap")
