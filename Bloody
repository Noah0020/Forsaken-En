local function GetNearestKillerHrp()
    local char = LP.Character; if not char then return nil end
    local kf = GetKillersFolder(); if not kf then return nil end
    local myHRP = char:FindFirstChild("HumanoidRootPart"); if not myHRP then return nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") then
            local mHRP = m:FindFirstChild("HumanoidRootPart")
            local mHum = m:FindFirstChildOfClass("Humanoid")
            if mHRP and mHum and mHum.Health > 0 then
                local d = (mHRP.Position - myHRP.Position).Magnitude
                if d < bd then bd = d; best = mHRP end
            end
        end
    end
    return best
end
local function HardLockFacing(duration, wantCam)
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local savedWS = hum.WalkSpeed
    hum.WalkSpeed = 0; hum.AutoRotate = false
    pcall(function() hum:Move(Vector3.zero, false) end)
    local start = tick(); local conn; local released = false
    local function release()
        if released then return end; released = true
        if conn then pcall(function() conn:Disconnect() end); conn = nil end
        if hum and hum.Parent then
            pcall(function() hum.WalkSpeed = savedWS; hum.AutoRotate = true; hum:Move(Vector3.zero, false) end)
        end
    end
    conn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent or not hum.Parent then release(); return end
        if tick() - start > (duration or 0.5) then release(); return end
        local tgt = GetNearestKillerHrp(); if not tgt or not tgt.Parent then return end
        local aimPos = predictHRP(tgt, (Settings.AIM_Prediction or 4) * 0.05) or tgt.Position
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(aimPos.X, hrp.Position.Y, aimPos.Z))
    end)
    if wantCam then
        local cam = Workspace.CurrentCamera
        local cStart = tick(); local cConn
        cConn = RunService.RenderStepped:Connect(function()
            if not cam or tick() - cStart > (duration or 0.5) then
                pcall(function() cConn:Disconnect() end); return
            end
            local tgt = GetNearestKillerHrp()
            if tgt and tgt.Parent then
                local aimPos = predictHRP(tgt, (Settings.AIM_Prediction or 4) * 0.05) or tgt.Position
                pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPos) end)
            end
        end)
    end
end
