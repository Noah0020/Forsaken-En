-- PREDICTIVE BOX FACING (Box.txt) — small boxes inside giant boundary
-- When small box contains local player → block
--═══════════════════════════════════════════════════════════════════
local BoxFacing = {}
do
    local Settings = {
        Enabled = false,
        BoxCount = 2,
        BoxWidth = 5,
        BoxHeight = 6,
        BoxLength = 8,
        GiantWidth = 15,
        GiantHeight = 10,
        GiantLength = 20,
        GiantForwardOffset = 10,
        SpawnForwardOffset = 4,
        VerticalOffset = 0,
        PredictionSpeed = 65,
        PredictionDistance = 30,
        PredictionEnabled = true,
        LaneSpacing = 0.8,
        BoxLifetime = 0.5,
        ShowSmallBoxes = true,
        ShowGiantBoundary = false,
        FillTransparency = 0.78,
        OutlineThickness = 0.055,
        Colors = {
            OutOfRange = Color3.fromRGB(255, 40, 40),
            Invalid = Color3.fromRGB(255, 205, 25),
            Valid = Color3.fromRGB(30, 255, 100),
            Boundary = Color3.fromRGB(80, 160, 255),
        },
    }
    BoxFacing.Settings = Settings

    local KillerCharacter = nil
    local ActiveBoxes = {}
    local Folder = Instance.new("Folder")
    Folder.Name = "NosPredictiveBoxes"
    Folder.Parent = Workspace

    local function GetRoot(character)
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    local function CreateVisual(name)
        local part = Instance.new("Part")
        part.Name = name
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Transparency = Settings.FillTransparency
        part.Size = Vector3.one
        part.Parent = Folder
        local outer = Instance.new("SelectionBox")
        outer.Name = "OuterNeonOutline"
        outer.Adornee = part
        outer.Color3 = Color3.new(1, 1, 1)
        outer.LineThickness = Settings.OutlineThickness
        outer.SurfaceTransparency = 1
        outer.Parent = part
        local inner = Instance.new("SelectionBox")
        inner.Name = "InnerNeonOutline"
        inner.Adornee = part
        inner.Color3 = Color3.new(1, 1, 1)
        inner.LineThickness = Settings.OutlineThickness * 0.45
        inner.SurfaceTransparency = 1
        inner.Parent = part
        return part
    end

    local function SetVisual(part, size, cframe, color)
        part.Size = size
        part.CFrame = cframe
        part.Color = color
        part.Transparency = Settings.ShowSmallBoxes and Settings.FillTransparency or 1
        local outer = part:FindFirstChild("OuterNeonOutline")
        local inner = part:FindFirstChild("InnerNeonOutline")
        if outer then outer.Color3 = color; outer.LineThickness = Settings.OutlineThickness end
        if inner then inner.Color3 = color; inner.LineThickness = Settings.OutlineThickness * 0.45 end
    end

    local Boundary = CreateVisual("GiantDetectionBoundary")
    Boundary.Material = Enum.Material.ForceField
    Boundary.Transparency = 1
    local BoundaryOutline = Instance.new("SelectionBox")
    BoundaryOutline.Name = "BoundaryOutline"
    BoundaryOutline.Adornee = Boundary
    BoundaryOutline.Color3 = Settings.Colors.Boundary
    BoundaryOutline.LineThickness = 0.035
    BoundaryOutline.SurfaceTransparency = 1
    BoundaryOutline.Parent = Boundary

    local function CreateAttackBox(index)
        local object = { Part = CreateVisual("PredictiveBox_" .. index), Position = Vector3.zero, Active = false, Age = 0, Index = index }
        table.insert(ActiveBoxes, object)
        return object
    end

    local function HideBox(object)
        object.Active = false
        object.Part.Transparency = 1
    end

    local function SynchronizeBoxCount()
        local wanted = math.clamp(math.floor(Settings.BoxCount), 1, 20)
        while #ActiveBoxes < wanted do CreateAttackBox(#ActiveBoxes + 1) end
        while #ActiveBoxes > wanted do
            local object = table.remove(ActiveBoxes)
            object.Part:Destroy()
        end
    end
    SynchronizeBoxCount()

    local function GetBoundaryCFrame(root)
        return root.CFrame * CFrame.new(0, Settings.VerticalOffset, -Settings.GiantForwardOffset)
    end

    local function ClampInsideBoundary(worldPosition, boundaryCFrame, boundarySize, boxSize)
        local localPosition = boundaryCFrame:PointToObjectSpace(worldPosition)
        local halfX = math.max(0, boundarySize.X / 2 - boxSize.X / 2)
        local halfY = math.max(0, boundarySize.Y / 2 - boxSize.Y / 2)
        local halfZ = math.max(0, boundarySize.Z / 2 - boxSize.Z / 2)
        localPosition = Vector3.new(
            math.clamp(localPosition.X, -halfX, halfX),
            math.clamp(localPosition.Y, -halfY, halfY),
            math.clamp(localPosition.Z, -halfZ, halfZ)
        )
        return boundaryCFrame:PointToWorldSpace(localPosition)
    end

    local function IsInsideBoundary(worldPosition, boundaryCFrame, boundarySize)
        local position = boundaryCFrame:PointToObjectSpace(worldPosition)
        return math.abs(position.X) <= boundarySize.X / 2
            and math.abs(position.Y) <= boundarySize.Y / 2
            and math.abs(position.Z) <= boundarySize.Z / 2
    end

    local function IsInsideBox(worldPosition, boxCFrame, boxSize)
        local localPosition = boxCFrame:PointToObjectSpace(worldPosition)
        return math.abs(localPosition.X) <= boxSize.X / 2
            and math.abs(localPosition.Y) <= boxSize.Y / 2
            and math.abs(localPosition.Z) <= boxSize.Z / 2
    end

    local function GetBoxColor(targetPosition, boundaryCFrame, boundarySize, boxCFrame, boxSize)
        if not IsInsideBoundary(targetPosition, boundaryCFrame, boundarySize) then
            return Settings.Colors.OutOfRange
        end
        if IsInsideBox(targetPosition, boxCFrame, boxSize) then
            return Settings.Colors.Valid
        end
        return Settings.Colors.Invalid
    end

    local function GetBoxCFrame(position, boundaryCFrame)
        local rotation = boundaryCFrame - boundaryCFrame.Position
        return CFrame.new(position) * rotation
    end

    local function SpawnBoxes()
        if not Settings.Enabled then return end
        if not KillerCharacter then return end
        local killerRoot = GetRoot(KillerCharacter)
        local playerRoot = GetRoot(LP.Character)
        if not killerRoot or not playerRoot then return end
        SynchronizeBoxCount()
        local boundaryCFrame = GetBoundaryCFrame(killerRoot)
        local boundarySize = Vector3.new(Settings.GiantWidth, Settings.GiantHeight, Settings.GiantLength)
        local smallSize = Vector3.new(Settings.BoxWidth, Settings.BoxHeight, Settings.BoxLength)
        local spawnPosition = killerRoot.Position + killerRoot.CFrame.LookVector * Settings.SpawnForwardOffset
        for index, object in ipairs(ActiveBoxes) do
            local laneOffset = (index - (#ActiveBoxes + 1) / 2) * Settings.LaneSpacing
            local lanePosition = spawnPosition + boundaryCFrame.RightVector * laneOffset
            object.Position = ClampInsideBoundary(lanePosition, boundaryCFrame, boundarySize, smallSize)
            object.Age = 0
            object.Active = true
        end
    end

    function BoxFacing.SetKiller(character)
        if character and not character:IsA("Model") then return end
        KillerCharacter = character
    end

    function BoxFacing.TriggerAttack()
        SpawnBoxes()
    end

    function BoxFacing.Clear()
        for _, object in ipairs(ActiveBoxes) do HideBox(object) end
    end

    local onTouchBlock = nil -- set by Auto Block
    function BoxFacing.SetTouchCallback(cb)
        onTouchBlock = cb
    end

    local lastTouchFire = 0
    local function MoveTowards(current, target, distance)
        local difference = target - current
        local magnitude = difference.Magnitude
        if magnitude <= 0.001 then return target end
        return current + difference.Unit * math.min(magnitude, distance)
    end

    RunService.Heartbeat:Connect(function(deltaTime)
        if not Settings.Enabled or _ShuttingDown then
            BoxFacing.Clear()
            return
        end
        local killerRoot = GetRoot(KillerCharacter)
        local playerRoot = GetRoot(LP.Character)
        if not killerRoot or not playerRoot then
            BoxFacing.Clear()
            return
        end
        local boundaryCFrame = GetBoundaryCFrame(killerRoot)
        local boundarySize = Vector3.new(Settings.GiantWidth, Settings.GiantHeight, Settings.GiantLength)
        local smallSize = Vector3.new(Settings.BoxWidth, Settings.BoxHeight, Settings.BoxLength)
        Boundary.Size = boundarySize
        Boundary.CFrame = boundaryCFrame
        BoundaryOutline.Color3 = Settings.Colors.Boundary
        Boundary.Transparency = Settings.ShowGiantBoundary and 0.85 or 1
        BoundaryOutline.Transparency = Settings.ShowGiantBoundary and 0 or 1
        SynchronizeBoxCount()
        local targetPosition = playerRoot.Position
        local destination = ClampInsideBoundary(targetPosition, boundaryCFrame, boundarySize, smallSize)
        local anyValid = false
        for _, object in ipairs(ActiveBoxes) do
            if object.Active then
                object.Age = object.Age + deltaTime
                if object.Age >= Settings.BoxLifetime then
                    HideBox(object)
                else
                    if Settings.PredictionEnabled then
                        local step = math.min(Settings.PredictionSpeed * deltaTime, Settings.PredictionDistance)
                        object.Position = MoveTowards(object.Position, destination, step)
                    else
                        object.Position = destination
                    end
                    object.Position = ClampInsideBoundary(object.Position, boundaryCFrame, boundarySize, smallSize)
                    local boxCFrame = GetBoxCFrame(object.Position, boundaryCFrame)
                    local color = GetBoxColor(targetPosition, boundaryCFrame, boundarySize, boxCFrame, smallSize)
                    SetVisual(object.Part, smallSize, boxCFrame, color)
                    if color == Settings.Colors.Valid then
                        anyValid = true
                    end
                end
            end
        end
        if anyValid and onTouchBlock then
            local now = tick()
            if now - lastTouchFire > 0.12 then
                lastTouchFire = now
                pcall(onTouchBlock, KillerCharacter)
            end
        end
    end)
end

