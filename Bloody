local ESPSettings = { Killer=false, Survivor=false, Generator=false, Medkit=false, Bloxy=false, MaxDist=150 }
local ESP_HL, ESP_Folder = {}, nil
local function ES_Ensure()
    if ESP_Folder and ESP_Folder.Parent then return ESP_Folder end
    ESP_Folder = Instance.new("Folder"); ESP_Folder.Name="Perfect_ESP"; ESP_Folder.Parent=CoreGui
    return ESP_Folder
end
local function ES_Clear(m) local h=ESP_HL[m]; if h then pcall(function() h:Destroy() end); ESP_HL[m]=nil end end
local function ES_Apply(m, col)
    if not m or not m.Parent then return end
    local hl=ESP_HL[m]
    if hl and hl.Parent and hl.Adornee==m then hl.FillColor=col; hl.OutlineColor=col; return end
    if hl then pcall(function() hl:Destroy() end) end
    hl=Instance.new("Highlight"); hl.Adornee=m; hl.FillColor=col; hl.OutlineColor=col
    hl.FillTransparency=0.5; hl.OutlineTransparency=0; hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent=ES_Ensure(); ESP_HL[m]=hl
end
