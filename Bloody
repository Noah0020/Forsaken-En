                        seen[k] = true; ES_Apply(k, Color3.fromRGB(255,0,0))
                    end
                end
            end
            local sf = pf:FindFirstChild("Survivors")
            if sf and Settings.ESP_Survivor then
                for _, s in ipairs(sf:GetChildren()) do
                    if s ~= LocalCharacter then
                        local hrp = s:FindFirstChild("HumanoidRootPart")
                        if hrp and LocalRoot and (hrp.Position - LocalRoot.Position).Magnitude <= Settings.ESP_MaxDist and ES_Visible(hrp) then
                            seen[s] = true; ES_Apply(s, Color3.fromRGB(0,255,0))
                        end
                    end
                end
            end
        end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local n = obj.Name
                local color
                if Settings.ESP_Generator and n == "Generator" then color = Color3.fromRGB(255,255,0)
                elseif Settings.ESP_Medkit and n == "Medkit" then color = Color3.fromRGB(255,105,180)
                elseif Settings.ESP_Bloxy and n == "BloxyCola" then color = Color3.fromRGB(0,150,255) end
                if color and not ESP_HL[obj] then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part and LocalRoot and (part.Position - LocalRoot.Position).Magnitude <= Settings.ESP_MaxDist and ES_Visible(part) then
                        seen[obj] = true; ES_Apply(obj, color)
                    end
                elseif color and ESP_HL[obj] then
