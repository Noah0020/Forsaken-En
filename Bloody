end
local function hideCone(s) for _, p in ipairs(s.parts) do if p and p.Parent then p.Transparency = 1 end end end
local function destroyCone(k) local s = ConeState[k] if s and s.folder then pcall(function() s.folder:Destroy() end) end ConeState[k]=nil end
local function updateCone(s, root, dt, colorOverride)
    local cf = root.CFrame; local look = cf.LookVector; local yaw = math.atan2(-look.X, -look.Z)
    if s.prevYaw then
        local diff = math.atan2(math.sin(yaw - s.prevYaw), math.cos(yaw - s.prevYaw))
        if math.abs(diff) > 0.0005 then
            s.turnDir = diff > 0 and 1 or -1
            s.currentAngle = math.min(ConeCfg.MaxAngle, s.currentAngle + math.abs(diff) * ConeCfg.ExpansionSpeed)
        else
            s.currentAngle = math.max(ConeCfg.NormalAngle, s.currentAngle - ConeCfg.RecoverySpeed * dt)
        end
    end
    s.prevYaw = yaw
    local half = ConeCfg.NormalAngle / 2
    local lA, rA = half, half
    if s.turnDir == 1 then lA = s.currentAngle - half elseif s.turnDir == -1 then rA = s.currentAngle - half end
    local total = lA + rA; local segs = ConeCfg.Segments; local range = ConeCfg.Range
    local center = root.Position; local pLen = (range / segs) * 1.6
    for i, p in ipairs(s.parts) do
        local alpha = (i - 0.5) / segs
        local offset = math.rad(-lA + total * alpha)
        local dir = CFrame.Angles(0, yaw + offset, 0).LookVector
        local wp = center + dir * range
        p.Size = Vector3.new(ConeCfg.Thickness, 0.06, pLen)
        p.CFrame = CFrame.lookAt(Vector3.new(wp.X, center.Y + 0.15, wp.Z), Vector3.new(wp.X + dir.X, center.Y + 0.15, wp.Z + dir.Z))
        p.Color = colorOverride or ConeCfg.Color; p.Transparency = ConeCfg.Transparency
    end
