local dragging, dragStart, startPos
Topbar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                     or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

Minimize.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    Sidebar.Visible = not isMinimized
    Content.Visible = not isMinimized
    Tween(Main, {
        Size = isMinimized
            and UDim2.fromOffset(190, 50)
            or UDim2.fromScale(currentScale, currentHeight)
    }, 0.25)
    Minimize.Text = isMinimized and "+" or "−"
end)

Close.MouseButton1Click:Connect(function()
    pcall(function() AB_Disable() end)
    pcall(function() ABT_Disable() end)
    pcall(function() AP_Disable() end)
    pcall(function() PA_Disable() end)
    pcall(function() HDT_Disable() end)
    pcall(function() Settings.AIM_Enabled = false end)
    pcall(function() AM1_Disable() end)
    pcall(function() GS_Disable() end)
    pcall(function() Stam_StopLoop(); Stam_Restore() end)
    pcall(function() Vee.AutoTrick = false; VeerATStop() end)
    pcall(function() HitboxExpander.Enabled = false; HitboxExpander._running = false end)
    pcall(function() SilentAim.Enabled = false end)
    Tween(Main, { Size = UDim2.fromScale(0, 0) }, 0.2)
    task.wait(0.22)
    Screen:Destroy()
end)

