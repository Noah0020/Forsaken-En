    local lower = btnName:lower():gsub("[%s_]", "")
    local cfg = SurvivorButtonMap[lower]
    if cfg then return cfg[1], cfg[2], cfg[3] end
    for pattern, c in pairs(SurvivorButtonMap) do
        if lower:find(pattern, 1, true) then return c[1], c[2], c[3] end
    end
    return nil
end

local boundButtons = setmetatable({}, { __mode = "k" })
local lastFirePer = setmetatable({}, { __mode = "k" })

local function bindAbilityButton(btn)
    if boundButtons[btn] or not btn:IsA("GuiObject") then return end
    local key, target, camera = getAimConfig(btn.Name)
    if not key then return end
    boundButtons[btn] = true
    local function tryFire()
        local mod = modules[key]
        if not mod or not mod.enabled then return end
        local now = tick()
        local last = lastFirePer[btn] or 0
        if now - last < 0.15 then return end
        lastFirePer[btn] = now
        task.spawn(performSnap, target, camera)
    end
    local cd = btn:FindFirstChild("CooldownTime", true)
    if cd and cd:IsA("TextLabel") then
        local init = cd.Text
        local wasOnCd = init and init ~= "" and init ~= " " and init ~= "0"
        cd:GetPropertyChangedSignal("Text"):Connect(function()
            local txt = cd.Text
            local onCd = txt and txt ~= "" and txt ~= " " and txt ~= "0"
            if onCd and not wasOnCd then tryFire() end
            wasOnCd = onCd
        end)
    end
