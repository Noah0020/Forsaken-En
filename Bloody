local HDT = {
    enabled = false,
    duration = 0.3,
}
local function HDT_NearestKiller()
    return GAim_nearestKiller and GAim_nearestKiller(math.huge) or nil
end
function HDT_Trigger()
    if not HDT.enabled or IsPlayerKiller() then return end
    task.spawn(function()
        local character = LP.Character
        local killer = HDT_NearestKiller()
        if not character or not killer then return end
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        local primaryPart = character.PrimaryPart or humanoidRootPart
        if not humanoidRootPart then return end
        local kHRP = killer:FindFirstChild("HumanoidRootPart")
        if not kHRP then return end

        local part2 = Instance.new("Part")
        part2.Size = Vector3.new(2,2,2)
        part2.Transparency = 1
        part2.CanCollide = false
        part2.Anchored = true
        part2.CFrame = humanoidRootPart.CFrame
        part2.Parent = character
        character.PrimaryPart = part2

        local start = os.clock()
        local dur = HDT.duration or 0.3
        while os.clock() - start < dur and HDT.enabled do
            local k = HDT_NearestKiller()
            local kr = k and k:FindFirstChild("HumanoidRootPart")
            if kr then
                local rotation = humanoidRootPart.CFrame.Rotation
                part2.CFrame = CFrame.new((kr.CFrame * CFrame.new(0, 0, -3)).Position) * rotation
                humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            end
            RunService.PreRender:Wait()
        end
        if part2 and part2.Parent then part2:Destroy() end
        if character and character.Parent then character.PrimaryPart = primaryPart end
    end)
end
