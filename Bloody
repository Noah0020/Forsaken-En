local function makeESP(model, color, text)
    if not model or not model.Parent then return end
    if model:FindFirstChild("_CkESP") then
        model._CkESP.FillColor=color; model._CkESP.OutlineColor=color; return
    end
    local h=Instance.new("Highlight")
    h.Name="_CkESP"; h.FillColor=color; h.OutlineColor=color
    h.FillTransparency=0.7; h.OutlineTransparency=0.3; h.Parent=model
    if text then
        local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        if root then
            local bb=Instance.new("BillboardGui")
            bb.Name="_CkBB"; bb.Adornee=root; bb.Size=UDim2.fromOffset(140,40)
            bb.StudsOffset=Vector3.new(0,3.5,0); bb.AlwaysOnTop=true; bb.Parent=model
            local tl=Instance.new("TextLabel")
            tl.Size=UDim2.fromScale(1,1); tl.BackgroundTransparency=1; tl.Text=text
            tl.TextColor3=color; tl.TextScaled=true; tl.TextStrokeTransparency=0.5; tl.Parent=bb
        end
    end
end
local function clearESP(m)
    if m then
        if m:FindFirstChild("_CkESP") then m._CkESP:Destroy() end
        if m:FindFirstChild("_CkBB")  then m._CkBB:Destroy()  end
    end
end

