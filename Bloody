-- STAB
local STAB_SPEED_MAX = 100
local stabState = { enabled=false, behindStuds=4, lerpDuration=0.15, cooldown=0.6, lastStab=0 }
local STAB_ANIM_IDS = {} -- filled from scan if available

local function runStabLerp()
    if not stabState.enabled or IsPlayerKiller() then return end
    local now=tick()
    if now-stabState.lastStab < stabState.cooldown then return end
    stabState.lastStab=now
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart; if not hrp then return end
    local killer=GetNearestKillerModel(); if not killer then return end
    local kr=killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local behind=math.max(1, stabState.behindStuds)
    local dur=math.max(0.05, stabState.lerpDuration)
    local function getBackCF()
        if not kr or not kr.Parent then return nil end
        local backPos = kr.Position - (kr.CFrame.LookVector * behind)
        return CFrame.lookAt(backPos, kr.Position)
    end
    local startCF=hrp.CFrame
    local startT=tick()
    while tick()-startT < dur do
        if IsPlayerKiller() then return end
        local targetCF=getBackCF(); if not targetCF then return end
        local alpha=math.clamp((tick()-startT)/dur,0,1)
        local smooth=1-(1-alpha)*(1-alpha)
        hrp.CFrame=startCF:Lerp(targetCF, smooth)
        RunService.Heartbeat:Wait()
    end
    local finalCF=getBackCF()
    if finalCF then hrp.CFrame=finalCF end
end

-- Trigger stab on survivor ability anims (shared with SA ids when available)
