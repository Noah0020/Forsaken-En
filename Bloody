local function GetNearestKillerHrp()
    local char = LP.Character
    if not char then return nil end
    local kf = GetKillersFolder(); if not kf then return nil end
    local myHrp = char:FindFirstChild("HumanoidRootPart"); if not myHrp then return nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") then
            local mHrp = m:FindFirstChild("HumanoidRootPart")
            local mHum = m:FindFirstChildOfClass("Humanoid")
            if mHrp and mHum and mHum.Health > 0 then
                local d = (mHrp.Position - myHrp.Position).Magnitude
                if d < bestD then bestD = d; best = mHrp end
            end
        end
    end
    return best
end

--═══════════════════════════════════════════════════════════════════
-- HARD LOCK — survivor aim unstick fix
--═══════════════════════════════════════════════════════════════════
local function HardLockFacing(duration, prediction, wantCamera)
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local savedWS = hum.WalkSpeed
    hum.WalkSpeed = 0
    hum.AutoRotate = false
    pcall(function() hum:Move(Vector3.zero, false) end)

    local startT = tick()
    local conn
    local released = false

    local function release()
        if released then return end
        released = true
        if conn then pcall(function() conn:Disconnect() end); conn = nil end
        if DebugMarker and DebugMarker.Parent then pcall(function() DebugMarker:Destroy() end) end
        DebugMarker = nil
        if not (hum and hum.Parent) then return end

        pcall(function()
            hum.WalkSpeed = savedWS
            hum.AutoRotate = true
            hum:Move(Vector3.zero, false)
        end)

        task.spawn(function()
            task.wait(0.05)
            if not (hum and hum.Parent) then return end
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end)
            task.wait(0.05)
            if not (hum and hum.Parent) then return end
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            task.wait(0.15)
            if not (hum and hum.Parent) then return end

            if hum.WalkSpeed <= 0.1 then
                pcall(function()
                    hum.WalkSpeed = savedWS
                    hum.AutoRotate = true
                end)
            end
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Physics
               or st == Enum.HumanoidStateType.PlatformStanding
               or st == Enum.HumanoidStateType.FallingDown then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            end
        end)
    end

    conn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent or not hum.Parent then
            release(); return
        end
        if tick() - startT > (duration or 0.5) then
            release(); return
        end
        local targetHrp = GetNearestKillerHrp()
        if not targetHrp or not targetHrp.Parent then return end
        local aimPos = PredictPosition(targetHrp, prediction) or targetHrp.Position
        ShowDebugPrediction(targetHrp)
        local myPos = hrp.Position
        hrp.CFrame = CFrame.lookAt(myPos, Vector3.new(aimPos.X, myPos.Y, aimPos.Z))
    end)

    if wantCamera then
        local cam = Workspace.CurrentCamera
        local camStart = tick()
        local camConn
        camConn = RunService.RenderStepped:Connect(function()
            if not cam then pcall(function() camConn:Disconnect() end); return end
            if tick() - camStart > (duration or 0.5) then
                pcall(function() camConn:Disconnect() end); return
            end
            local tgt = GetNearestKillerHrp()
            if tgt and tgt.Parent then
                local aimPos = PredictPosition(tgt, prediction) or tgt.Position
                pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPos) end)
            end
        end)
    end
end

