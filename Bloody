local function startFacingBlockWindow(killer)
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not killer or not killer.Parent then return end

    local window = math.clamp(tonumber(Settings.GodsakenHitboxWindow) or 0.7, 0.1, 2)
    local existing = AB.pendingChecks[killer]
    if existing then
        existing.expiresAt = math.max(existing.expiresAt, tick() + window)
        return
    end

    local pending = { expiresAt = tick() + window }
    AB.pendingChecks[killer] = pending
    local generation = AB.generation
    task.spawn(function()
        while AB.running and AB.generation == generation and killer.Parent
            and tick() <= pending.expiresAt do
            if IsPlayerInFacingZone(killer) then
                local now = tick()
                local last = AB.m1LastAt[killer] or 0
                if now - last >= 0.12 then
                    AB.m1LastAt[killer] = now
                    AB.blueDebounce = now
                    FireAbilityByMode()
                end
                break
            end
            RunService.Heartbeat:Wait()
        end
        if AB.pendingChecks[killer] == pending then
            AB.pendingChecks[killer] = nil
        end
    end)
end

local function tryBlockFromSoundSignal(killer)
    if Settings.AutoBlockDetection ~= "Regular (Sound IDs)" then return end
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    -- Recheck during a short attack window. A single instant check could miss
    -- because the animation/sound event can arrive just before box overlap.
    startFacingBlockWindow(killer)
end

local function isKnownRegularM1Sound(sound)
    if not sound or not sound:IsA("Sound") then return false end
    local sid = sound.SoundId
    if not sid or sid == "" then return false end
    local id = string_match(sid, "%d+")
    return M1_Sounds[sid] == true or (id and (M1_Sounds[id] == true or M1_Sounds["rbxassetid://" .. id] == true)) or false
end

local monitoredM1Sounds = setmetatable({}, { __mode = "k" })
local function monitorRegularM1Sound(killer, sound)
    if not sound or not sound:IsA("Sound") or monitoredM1Sounds[sound] then return end
    monitoredM1Sounds[sound] = true
    local connection = sound.Played:Connect(function()
        if isKnownRegularM1Sound(sound) then tryBlockFromSoundSignal(killer) end
    end)
    table.insert(AB.connections, connection)
end

local function MonitorKillerSound(killer)
    if not killer then return end
    for _, descendant in ipairs(killer:GetDescendants()) do
        if descendant:IsA("Sound") then monitorRegularM1Sound(killer, descendant) end
    end
    table.insert(AB.connections, killer.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Sound") then monitorRegularM1Sound(killer, descendant) end
    end))
end

-- Optional Godsaken/Nightsaken detector. It watches every active killer model,
-- keeps state per killer, and opens the same configurable facing-zone window.
-- This preserves the useful AbilityLastUsed signal without creating a new Part
-- every Heartbeat or only monitoring GetChildren()[1].
local GODSAKEN_BAIT_WINDOW = 0.25
local function AttrHeartbeat()
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom)
        or Settings.AutoBlockDetection ~= "Godsaken (Ability Attributes)" then return end
    local folder = AB.KillersFolder
    if not folder or not folder.Parent then return end

    local now = tick()
    for _, killer in ipairs(folder:GetChildren()) do
        if killer:IsA("Model") then
            local abilityLastUsed = tonumber(killer:GetAttribute("AbilityLastUsed")) or 0
            local abilitiesUsed = tonumber(killer:GetAttribute("AbilitiesUsed")) or 0
            local state = AB.attrStates[killer]
            if not state then
                AB.attrStates[killer] = {
                    lastAbilityUsed = abilityLastUsed,
                    lastAbilitiesUsed = abilitiesUsed,
                    baitAt = nil,
                }
            else
                if abilitiesUsed > (state.lastAbilitiesUsed or 0) then
                    state.baitAt = now
                end

                local abilityIncreased = abilityLastUsed > (state.lastAbilityUsed or 0)
                if abilityIncreased then
                    local isBait = state.baitAt ~= nil and (now - state.baitAt) <= GODSAKEN_BAIT_WINDOW
                    state.baitAt = nil
                    if not isBait then
                        startFacingBlockWindow(killer)
                    end
                elseif state.baitAt and (now - state.baitAt) > GODSAKEN_BAIT_WINDOW then
                    state.baitAt = nil
                end

                state.lastAbilityUsed = abilityLastUsed
                state.lastAbilitiesUsed = abilitiesUsed
            end
        end
    end
end

local function ab_applyState(state)
    if not state then return end
    if state.mode == "default" then
        Settings.AutoBlock = state.value
        if state.value then Settings.AutoBlockCustom = false end
    else
        Settings.AutoBlockCustom = state.value
        if state.value then Settings.AutoBlock = false end
    end

    if Toggles.AutoBlock then
        _suppressToggleCallback = true
        pcall(function() Toggles.AutoBlock:SetValue(Settings.AutoBlock) end)
        _suppressToggleCallback = false
    end
    if Toggles.AutoBlockCustom then
        _suppressToggleCallback = true
        pcall(function() Toggles.AutoBlockCustom:SetValue(Settings.AutoBlockCustom) end)
        _suppressToggleCallback = false
    end

    -- Keep visuals in sync without changing their enabled states.
    UpdateCustomZoneVisibility()

    if Settings.AutoBlock or Settings.AutoBlockCustom then
        if not AB.running then pcall(StartAutoBlock) end
    else
        if AB.running then pcall(StopAutoBlock) end
    end
    if FourthBlock.applyTint then pcall(FourthBlock.applyTint) end
end

local function ab_scheduleApply()
    if abPendingTask then pcall(task.cancel, abPendingTask); abPendingTask = nil end
    abPendingTask = task.delay(abDebounce, function()
        abPendingTask = nil
        local t = abPendingState
        abPendingState = nil
        if t ~= nil then abLastToggle = tick(); ab_applyState(t) end
    end)
end

local function ab_requestState(value, mode)
    if value == nil then return end
    mode = mode or (Settings.AutoBlockCustom and "custom" or "default")
    abPendingState = { value = value, mode = mode }
    local now = tick()
    if abLastToggle > 0 and now - abLastToggle < abDebounce then ab_scheduleApply(); return end
    if abPendingTask then pcall(task.cancel, abPendingTask); abPendingTask = nil end
    abLastToggle = now
    local t = abPendingState
    abPendingState = nil
    ab_applyState(t)
end

