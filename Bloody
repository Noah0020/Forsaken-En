local HitboxExpander = { Enabled=false, TargetMode="Distance", Distance=10, _running=false, _thread=nil }
local function HBE_GetNearestTarget(root)
    local hb = HitboxExpander
    local kf = GetKillersFolder()
    if not kf then return nil end
    local huge = hb.TargetMode == "Lowest HP" and math.huge or hb.Distance
    local best = nil
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= LocalPlayer.Character then
            local hrp = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= hb.Distance then
                    if hb.TargetMode == "Distance" then
                        if dist < huge then huge = dist; best = m end
                    elseif hum.Health < huge then
                        huge = hum.Health; best = m
                    end
                end
            end
        end
    end
    return best
end
local function HBE_ApplyVelocity()
    if HitboxExpander._running then return end
    HitboxExpander._running = true
    HitboxExpander._thread = task.spawn(function()
        local hb = HitboxExpander
        while hb.Enabled do
            task.wait()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                local target = HBE_GetNearestTarget(root)
                local thrp = target and target:FindFirstChild("HumanoidRootPart")
                if thrp then
                    local ping = 0.05
                    pcall(function() ping = math.max(LocalPlayer:GetNetworkPing()/2, 0.05) end)
                    local desired = (thrp.Position + thrp.AssemblyLinearVelocity * (ping * 1.25) - root.Position) / (ping * 2)
                    local horizontal = Vector3.new(desired.X, 0, desired.Z)
                    if horizontal.Magnitude > 65 then horizontal = horizontal.Unit * 65 end
                    local old = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(horizontal.X, old.Y, horizontal.Z)
                    RunService.Heartbeat:Wait()
                    if root and root.Parent then root.AssemblyLinearVelocity = old end
                end
            end
        end
        hb._running = false
    end)
end
