local _remote
local function getRemote()
    if _remote and _remote.Parent then return _remote end
    pcall(function()
        _remote = ReplicatedStorage:WaitForChild("Modules", 8)
            :WaitForChild("Network", 5)
            :WaitForChild("Network", 5)
            :WaitForChild("RemoteEvent", 5)
    end)
    return _remote
end

local function FireAbility(name)
    local r = getRemote()
    if not r then return end
    pcall(function()
        r:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0" .. name) })
    end)
end

local function fireBlock()
    local r = getRemote()
    if not r then return false end
    pcall(function()
        r:FireServer(unpack({"UseActorAbility", {buffer.fromstring("\3\5\0\0\0Block")}}))
    end)
    return true
end

