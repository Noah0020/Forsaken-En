-- Compatibility adapter: translates the old UI declarations to Obsidian's
-- AddGroupbox/AddToggle/AddInput/AddSlider/AddDropdown/AddButton API.
local function wrapGroupbox(realGroupbox)
    local proxy = {}

    function proxy:CreateToggle(config, index)
        return realGroupbox:AddToggle(index or ("Toggle_" .. tostring(config.Name)), {
            Text = config.Name,
            Default = config.CurrentValue == true,
            Tooltip = config.Tooltip,
            Callback = config.Callback,
        })
    end

    function proxy:CreateInput(config, index)
        return realGroupbox:AddInput(index or ("Input_" .. tostring(config.Name)), {
            Text = config.Name,
            Default = tostring(config.CurrentValue or ""),
            Placeholder = config.PlaceholderText or "",
            Numeric = config.Numeric == true,
            Finished = true,
            ClearTextOnFocus = false,
            Callback = config.Callback,
        })
    end

    function proxy:CreateSlider(config, index)
        local range = config.Range or { 0, 100 }
        local increment = tonumber(config.Increment) or 1
        local rounding = 0
        if increment < 1 then
            local asText = string.format("%.6f", increment):gsub("0+$", ""):gsub("%.$", "")
            local decimals = asText:match("%.(%d+)")
            rounding = decimals and #decimals or 0
        end
        return realGroupbox:AddSlider(index or ("Slider_" .. tostring(config.Name)), {
            Text = config.Name,
            Default = tonumber(config.CurrentValue) or range[1],
            Min = range[1],
            Max = range[2],
            Rounding = rounding,
            Callback = config.Callback,
        })
    end

    function proxy:CreateDropdown(config, index)
        return realGroupbox:AddDropdown(index or ("Dropdown_" .. tostring(config.Name)), {
            Text = config.Name,
            Values = config.Options or {},
            Default = config.CurrentOption or (config.Options and config.Options[1]),
            Multi = false,
            Searchable = false,
            Tooltip = config.Tooltip,
            Callback = config.Callback,
        })
    end

    function proxy:CreateButton(config, index)
        return realGroupbox:AddButton({
            Text = config.Name,
            Func = config.Callback,
            Tooltip = config.Tooltip,
            Risky = config.Risky == true,
        })
    end

    return proxy
end

local function wrapTab(realTab)
    local proxy = {}
    function proxy:CreateGroupbox(config)
        local side = (config.Column == 2) and "Right" or "Left"
        local realGroupbox = realTab:AddGroupbox({
            Name = config.Name,
            Side = side,
        })
        return wrapGroupbox(realGroupbox)
    end
    return proxy
end

