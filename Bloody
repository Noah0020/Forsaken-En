}
local function getAimCfg(name)
    local l = name:lower():gsub("[%s_]", "")
    local c = buttonMap[l]; if c then return c[1], c[2], c[3] end
    for p, cc in pairs(buttonMap) do if l:find(p, 1, true) then return cc[1], cc[2], cc[3] end end
end
local boundButtons = setmetatable({}, { __mode = "k" })
local lastFire = setmetatable({}, { __mode = "k" })
local function bindBtn(btn)
    if boundButtons[btn] or not btn:IsA("GuiObject") then return end
    local key, target, cam = getAimCfg(btn.Name)
    if not key then return end
    boundButtons[btn] = true
    local function tryFire()
        local m = aimModules[key]; if not m or not m.enabled then return end
        local n = tick(); local last = lastFire[btn] or 0
        if n - last < 0.15 then return end
        lastFire[btn] = n
        task.spawn(performSnap, target, cam)
    end
    local cd = btn:FindFirstChild("CooldownTime", true)
    if cd and cd:IsA("TextLabel") then
        local init = cd.Text
        local wasOn = init and init ~= "" and init ~= " " and init ~= "0"
        cd:GetPropertyChangedSignal("Text"):Connect(function()
            local t = cd.Text
            local on = t and t ~= "" and t ~= " " and t ~= "0"
            if on and not wasOn then tryFire() end
            wasOn = on
        end)
    end
    local click = btn:IsA("GuiButton") and btn or btn:FindFirstChildWhichIsA("GuiButton", true) or btn
    if click and click.MouseButton1Down then click.MouseButton1Down:Connect(tryFire) end
end
