local function shouldBlockAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local upper = string.upper(name)
    for _, bn in ipairs(_G.BlockAbilityNames) do
        if string.find(upper, string.upper(bn), 1, true) then return true end
    end
    return false
end

local function getAbilityName(killer)
