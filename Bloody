-- MIST
do
    local Mist = {
        fullbright=false, noFog=false, cameraNoclip=false, antiSlow=false, disableTrails=false,
        fbToken=0, savedLighting=nil, defaultOcclusion=LP.DevCameraOcclusionMode,
    }
    local function setFullbright(on)
        Mist.fbToken += 1
        local token = Mist.fbToken
        if on then
            if not Mist.savedLighting then
                Mist.savedLighting = {
                    Brightness=Lighting.Brightness, Ambient=Lighting.Ambient,
                    OutdoorAmbient=Lighting.OutdoorAmbient, FogEnd=Lighting.FogEnd,
                    GlobalShadows=Lighting.GlobalShadows,
                }
            end
            task.spawn(function()
                while token == Mist.fbToken and Mist.fullbright do
                    Lighting.Brightness=2
                    Lighting.Ambient=Color3.new(1,1,1)
                    Lighting.OutdoorAmbient=Color3.new(1,1,1)
                    Lighting.FogEnd=100000
                    Lighting.GlobalShadows=false
                    task.wait(0.5)
                end
            end)
        elseif Mist.savedLighting then
            for k,v in pairs(Mist.savedLighting) do pcall(function() Lighting[k]=v end) end
        end
    end
    local function setNoFog(on)
        if on then
            Lighting.FogEnd = 100000
            pcall(function()
                local atm = Lighting:FindFirstChildOfClass("Atmosphere")
                if atm then atm.Density = 0 end
            end)
        end
    end
    local function setCameraNoclip(on)
        LP.DevCameraOcclusionMode = on and Enum.DevCameraOcclusionMode.Invisicam or Mist.defaultOcclusion
    end
    local function applyAntiSlow()
        if not Mist.antiSlow then return end
        local sm = Workspace:FindFirstChild("SpeedMultipliers", true)
        if not sm then return end
        for _, child in ipairs(sm:GetChildren()) do
            if child:IsA("NumberValue") and child.Name ~= "Base" and child.Value < 1 then
                child.Value = 1
            end
        end
    end
    RunService.Heartbeat:Connect(function()
        if Mist.antiSlow then applyAntiSlow() end
        if Mist.disableTrails and LP.Character then
            for _, d in ipairs(LP.Character:GetDescendants()) do
                if d:IsA("Trail") or d:IsA("ParticleEmitter") then d.Enabled = false end
            end
        end
    end)

    Tabs.Mist:AddSection("Visual")
    Tabs.Mist:AddToggle("Mist_FB", {
        Title = "Fullbright", Default = false,
        Callback = function(v) Mist.fullbright=v; setFullbright(v) end,
    })
    Tabs.Mist:AddToggle("Mist_Fog", {
        Title = "No Fog", Default = false,
        Callback = function(v) Mist.noFog=v; setNoFog(v) end,
    })
    Tabs.Mist:AddToggle("Mist_Cam", {
        Title = "Camera Noclip", Default = false,
        Callback = function(v) Mist.cameraNoclip=v; setCameraNoclip(v) end,
    })
    Tabs.Mist:AddSection("Movement / FX")
    Tabs.Mist:AddToggle("Mist_AntiSlow", {
        Title = "Anti Slowness", Default = false,
        Callback = function(v) Mist.antiSlow=v; if v then applyAntiSlow() end end,
    })
    Tabs.Mist:AddToggle("Mist_Trails", {
        Title = "Disable Trails / Particles", Default = false,
        Callback = function(v) Mist.disableTrails=v end,
    })
end

-- GEN
do
    local Gen = { enabled=false, gen=0, installed=false, startDelay=1.2, connectDelay=0.8 }
    local function still(token, object)
        return Gen.enabled and token == Gen.gen and object and not object.Ended
    end
    local function waitSolve(object)
        while object and not object.Ended and not Gen.enabled do task.wait(0.05) end
        if not (object and not object.Ended and Gen.enabled) then return false end
        local t0 = os.clock()
        while object and not object.Ended and Gen.enabled and os.clock()-t0 < Gen.startDelay do task.wait(0.05) end
        return object and not object.Ended and Gen.enabled
    end
    local function install()
        if Gen.installed then return end
        Gen.installed = true
        local okInstall, errInstall = pcall(function()
            local folder = ReplicatedStorage.Systems.Player.Game.Minigames
            local Connect = require(folder.ConnectClientMinigame.ConnectInput)
            local old = Connect.new
            Connect.new = function(board, renderer, callbacks)
                local object = old(board, renderer, callbacks)
                local token = Gen.gen
                task.spawn(function()
                    if not waitSolve(object) then return end
                    task.wait(Gen.connectDelay)
                    if not board.Blobs then return end
                    for blob in pairs(board.Blobs) do
                        if not still(token, object) then return end
                        if not board:GetLink(blob) then
                            local mate = board:GetMate(blob)
                            if mate then
                                board:Connect(blob, mate)
                                renderer:Render()
                                task.wait(Gen.connectDelay)
                            end
                        end
                    end
                    if still(token, object) and board.IsSolved and board:IsSolved() then
                        object:__finish()
                        if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                    end
                end)
                return object
            end
        end)
        if not okInstall then
            warn("[Nos Hub] Auto Gen install failed:", errInstall)
            Gen.installed = false
        end
    end
    Tabs.Gen:AddSection("Auto Generator")
    Tabs.Gen:AddToggle("Gen_Enable", {
        Title = "Enable Auto Gen", Default = false,
        Callback = function(v)
            Gen.enabled = v
            Gen.gen += 1
            if v then install() end
        end,
    })
    Tabs.Gen:AddSlider("Gen_Start", {
        Title = "Start Delay", Default = 1.2, Min = 0, Max = 4, Rounding = 2,
        Callback = function(v) Gen.startDelay = v end,
    })
end

