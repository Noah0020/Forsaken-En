local VeeAutoTrickState = { running=false, thread=nil, lastTrigger=0, activeHighlights={} }

local function veeGetSprintingButton()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local mainUI = pg:FindFirstChild("MainUI")
    if not mainUI then return nil end
    return mainUI:FindFirstChild("SprintingButton")
end

local function veeFireSprinting()
    local btn = veeGetSprintingButton()
    if not btn then return false end
    if type(getconnections) ~= "function" then return false end
    local ok, conns = pcall(getconnections, btn.MouseButton1Down)
    if not ok or not conns then return false end
    for _, c in ipairs(conns) do
        pcall(function() if c.Fire then c:Fire() elseif c.Function then c.Function() end end)
    end
    return true
end

local function veeMonitorHighlight(h)
    if not h or VeeAutoTrickState.activeHighlights[h] then return end
    local connections = {}
    local prevState = false
    local function cleanup()
        for _, conn in ipairs(connections) do
            if conn and conn.Connected then conn:Disconnect() end
        end
        VeeAutoTrickState.activeHighlights[h] = nil
    end
    local function adorneeIsPlayer(hh)
        if not hh then return false end
        local adornee = hh.Adornee
        local char = LP.Character
        if not adornee or not char then return false end
        return adornee == char or adornee:IsDescendantOf(char)
    end
    local function onChanged()
        if not VeeAutoTrickState.running then return end
        if not h or not h.Parent then cleanup(); return end
        local currState = adorneeIsPlayer(h)
        if prevState ~= currState then
            if currState then
                local now = tick()
                if now - VeeAutoTrickState.lastTrigger >= 0.15 then
                    VeeAutoTrickState.lastTrigger = now
                    task.spawn(veeFireSprinting)
                end
            end
            prevState = currState
        end
    end
    table.insert(connections, h:GetPropertyChangedSignal("Adornee"):Connect(onChanged))
    table.insert(connections, h.AncestryChanged:Connect(function(_, parent)
        if not parent then cleanup() else onChanged() end
    end))
    VeeAutoTrickState.activeHighlights[h] = cleanup
    task.spawn(onChanged)
end

local function veeGetBehaviorFolder()
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return nil end
    local survivors = assets:FindFirstChild("Survivors")
    if not survivors then return nil end
    local veeronica = survivors:FindFirstChild("Veeronica")
    if not veeronica then return nil end
    return veeronica:FindFirstChild("Behavior")
end

local veeDescendantConn = nil
local function veeATStart()
    if VeeAutoTrickState.running then return end
    VeeAutoTrickState.running = true
    local folder = veeGetBehaviorFolder()
    if folder then
        for _, desc in ipairs(folder:GetDescendants()) do
            if desc:IsA("Highlight") then veeMonitorHighlight(desc) end
        end
        veeDescendantConn = folder.DescendantAdded:Connect(function(child)
            if child:IsA("Highlight") then veeMonitorHighlight(child) end
        end)
    end
end
local function veeATStop()
    VeeAutoTrickState.running = false
    if veeDescendantConn then veeDescendantConn:Disconnect(); veeDescendantConn = nil end
    for _, cleanup in pairs(VeeAutoTrickState.activeHighlights) do
        if type(cleanup) == "function" then pcall(cleanup) end
    end
    VeeAutoTrickState.activeHighlights = {}
end

