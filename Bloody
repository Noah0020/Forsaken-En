-- CUSTOM ZONE
-- ═══════════════════════════════════════════════════════════════
local CustomZone = { running=false, connections={}, folder=nil, killerZones={} }
local PLAYER_RADIUS = 1.5

local function flatBasis(killerCF)
    local forward = Vector3.new(killerCF.LookVector.X, 0, killerCF.LookVector.Z)
    if forward.Magnitude < 0.01 then return nil end
    forward = forward.Unit
    return forward, Vector3.new(-forward.Z, 0, forward.X)
end

local function IsPlayerInCircleCheck(myPos, killerCF, killerPos)
    local forward = flatBasis(killerCF)
    if not forward then return false end
    local centerDistance = (Settings.CustomCircleOffset or 0) + (Settings.CustomCircleRadius or 5)
    local fromCenter = Vector3.new(myPos.X - killerPos.X, 0, myPos.Z - killerPos.Z) - forward * centerDistance
    local radius = (Settings.CustomCircleRadius or 5) + PLAYER_RADIUS
    return fromCenter:Dot(fromCenter) <= radius * radius
end

local function IsPlayerInDiamond(myPos, killerCF, killerPos)
    local forward, right = flatBasis(killerCF)
    if not forward then return false end
    local delta = Vector3.new(myPos.X - killerPos.X, 0, myPos.Z - killerPos.Z)
    local forwardDistance = delta:Dot(forward)
    local sideDistance = math.abs(delta:Dot(right))
    local offset = Settings.CustomDiamondOffset or 0
    local length = math.max(1, Settings.CustomDiamondLength or 12)
    local halfWidth = math.max(1, Settings.CustomDiamondWidth or 8) / 2
    local depth = forwardDistance - offset
    if depth < -PLAYER_RADIUS or depth > length + PLAYER_RADIUS then return false end
    local normalizedDepth = math.clamp(depth / length, 0, 1)
    local allowedSide = halfWidth * (1 - math.abs(2 * normalizedDepth - 1)) + PLAYER_RADIUS
    return sideDistance <= allowedSide
end

local function IsPlayerInBox(myPos, killerCF, killerPos)
    local forward, right = flatBasis(killerCF)
    if not forward then return false end
    local delta = Vector3.new(myPos.X - killerPos.X, 0, myPos.Z - killerPos.Z)
    local forwardDistance = delta:Dot(forward)
    local sideDistance = math.abs(delta:Dot(right))
    local offset = Settings.CustomBoxOffset or 0
    local length = math.max(1, Settings.CustomBoxLength or 12)
    local width = math.max(1, Settings.CustomBoxWidth or 6)
    return forwardDistance >= offset - PLAYER_RADIUS
        and forwardDistance <= offset + length + PLAYER_RADIUS
        and sideDistance <= width / 2 + PLAYER_RADIUS
end

local function IsPlayerInFacingZone(killer)
    if not killer or not killer.Parent then return false end
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    local character = LocalPlayer.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not killerRoot or not myRoot then return false end

    local verticalDifference = math.abs(myRoot.Position.Y - killerRoot.Position.Y)
    if verticalDifference > math.max(0.5, Settings.FacingHeight or 5) then return false end

    local mode = Settings.FacingMode or "Circle"
    if mode == "Circle" then
        return IsPlayerInCircleCheck(myRoot.Position, killerRoot.CFrame, killerRoot.Position)
    elseif mode == "Diamond" then
        return IsPlayerInDiamond(myRoot.Position, killerRoot.CFrame, killerRoot.Position)
    elseif mode == "Box" then
        local boxHalfHeight = math.max(1, Settings.CustomBoxHeight or 8) / 2
        if verticalDifference > boxHalfHeight + PLAYER_RADIUS then return false end
        return IsPlayerInBox(myRoot.Position, killerRoot.CFrame, killerRoot.Position)
    end
    return false
end

local function GetKillerGroundCF(kr)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {kr.Parent, LocalPlayer.Character}
    params.IgnoreWater = true
    local ray = Workspace:Raycast(kr.Position, Vector3.new(0, -30, 0), params)
    local groundY = ray and (kr.Position.Y - ray.Distance) or (kr.Position.Y - 3)
    return CFrame.new(kr.Position.X, groundY + (Settings.ZoneVisualOffset or 0.5), kr.Position.Z) * kr.CFrame.Rotation
end

local function BuildZone(killer)
    local model = Instance.new("Model")
    model.Name = "ABCustomZone_" .. killer.Name
    model.Parent = CustomZone.folder
    local edges = {}
    for i = 1, 12 do
        local p = Instance.new("Part")
        p.Name = "Edge" .. i
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255, 0, 0)
        p.Transparency = 1
        p.Size = Vector3.new(0.12, 0.12, 1)
        p.CFrame = CFrame.new(0, -5000, 0)
        p.Parent = model
        edges[i] = p
    end
    local circle = Instance.new("Part")
    circle.Shape = Enum.PartType.Cylinder
    circle.Name = "Circle"
    circle.Anchored = true
    circle.CanCollide = false
    circle.CanQuery = false
    circle.CanTouch = false
    circle.CastShadow = false
    circle.Material = Enum.Material.Neon
    circle.Color = Color3.fromRGB(255, 0, 0)
    circle.Transparency = 1
    circle.Size = Vector3.new(0.08, 10, 10)
    circle.CFrame = CFrame.new(0, -5000, 0)
    circle.Parent = model

    local boxVolume = Instance.new("Part")
    boxVolume.Name = "BoxVolume"
    boxVolume.Anchored = true
    boxVolume.CanCollide = false
    boxVolume.CanQuery = false
    boxVolume.CanTouch = false
    boxVolume.CastShadow = false
    boxVolume.Material = Enum.Material.ForceField
    boxVolume.Color = Color3.fromRGB(255, 0, 0)
    boxVolume.Transparency = 1
    boxVolume.Size = Vector3.new(6, 8, 12)
    boxVolume.CFrame = CFrame.new(0, -5000, 0)
    boxVolume.Parent = model
    return { model = model, edges = edges, circle = circle, boxVolume = boxVolume, killer = killer }
end

local function setZoneEdge(edge, a, b, color)
    local diff = b - a
    if diff.Magnitude < 0.01 then edge.Transparency = 1; return end
    edge.Size = Vector3.new(0.12, 0.12, diff.Magnitude)
    edge.CFrame = CFrame.lookAt((a + b) / 2, (a + b) / 2 + diff.Unit)
    edge.Color = color
    edge.Transparency = 0.15
end

local function UpdateZone(zone, kr, myRoot)
    if not zone or not zone.model or not zone.model.Parent or not kr or not kr.Parent then return end
    local mode = Settings.FacingMode or "Circle"
    local baseCF = GetKillerGroundCF(kr)
    local show = Settings.ShowFacingVisual == true
    local inZone = myRoot and IsPlayerInFacingZone(zone.killer) or false
    local zoneColor = inZone and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

    for _, edge in ipairs(zone.edges) do edge.Transparency = 1 end
    if zone.boxVolume then zone.boxVolume.Transparency = 1 end

    if mode == "Box" then
        local offset = Settings.CustomBoxOffset or 0
        local length = math.max(1, Settings.CustomBoxLength or 12)
        local width = math.max(1, Settings.CustomBoxWidth or 6)
        local height = math.max(1, Settings.CustomBoxHeight or 8)
        zone.boxVolume.Size = Vector3.new(width, height, length)
        zone.boxVolume.CFrame = CFrame.new(kr.Position) * kr.CFrame.Rotation * CFrame.new(0, 0, -(offset + length / 2))
        zone.boxVolume.Color = zoneColor
        zone.boxVolume.Transparency = show and 0.78 or 1
    elseif mode == "Diamond" then
        local offset = Settings.CustomDiamondOffset or 0
        local length = math.max(1, Settings.CustomDiamondLength or 12)
        local halfWidth = math.max(1, Settings.CustomDiamondWidth or 8) / 2
        local halfHeight = math.max(0.5, Settings.FacingHeight or 5)
        local shapeCF = CFrame.new(kr.Position) * kr.CFrame.Rotation
        local localBase = {
            Vector3.new(0, -halfHeight, -offset),
            Vector3.new(-halfWidth, -halfHeight, -(offset + length / 2)),
            Vector3.new(0, -halfHeight, -(offset + length)),
            Vector3.new(halfWidth, -halfHeight, -(offset + length / 2)),
        }
        local points = {}
        for i = 1, 4 do
            points[i] = shapeCF:PointToWorldSpace(localBase[i])
            points[i + 4] = shapeCF:PointToWorldSpace(localBase[i] + Vector3.new(0, halfHeight * 2, 0))
        end
        local pairs3D = {
            {1,2},{2,3},{3,4},{4,1},
            {5,6},{6,7},{7,8},{8,5},
            {1,5},{2,6},{3,7},{4,8},
        }
        if show then
            for i, pair in ipairs(pairs3D) do
                setZoneEdge(zone.edges[i], points[pair[1]], points[pair[2]], zoneColor)
            end
        end
    end

    local circle = zone.circle
    if circle and circle.Parent then
        local isCircle = mode == "Circle"
        local radius = Settings.CustomCircleRadius + PLAYER_RADIUS
        local center = baseCF:PointToWorldSpace(Vector3.new(0, 0, -(Settings.CustomCircleOffset + Settings.CustomCircleRadius)))
        circle.Size = Vector3.new(0.08, radius * 2, radius * 2)
        circle.CFrame = CFrame.new(center + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, 0, math.rad(90))
        circle.Transparency = (show and isCircle) and 0.55 or 1
        circle.Color = zoneColor
    end
end

local function StartCustomZoneVisuals()
    if CustomZone.running then return end
    CustomZone.running = true
    CustomZone.connections = {}
    CustomZone.killerZones = {}
    CustomZone.folder = Instance.new("Folder"); CustomZone.folder.Name = "ABCustomZoneVisuals"; CustomZone.folder.Parent = Workspace
    table.insert(CustomZone.connections, RunService.RenderStepped:Connect(function()
        if not CustomZone.running then return end
        local killersFolder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
        if not killersFolder then return end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        for _, killer in ipairs(killersFolder:GetChildren()) do
            if killer:IsA("Model") then
                local kr = killer:FindFirstChild("HumanoidRootPart")
                if kr then
                    local zone = CustomZone.killerZones[killer]
                    if not zone or not zone.model or not zone.model.Parent then
                        if zone and zone.model then pcall(function() zone.model:Destroy() end) end
                        zone = BuildZone(killer)
                        CustomZone.killerZones[killer] = zone
                    end
                    UpdateZone(zone, kr, myRoot)
                end
            end
        end
        for killer, zone in pairs(CustomZone.killerZones) do
            if not killer.Parent or not killer:IsDescendantOf(Workspace) then
                if zone.model then pcall(function() zone.model:Destroy() end) end
                CustomZone.killerZones[killer] = nil
            end
        end
    end))
    print("[shitsaken] Custom Zone ON")
end

local function StopCustomZoneVisuals()
    if not CustomZone.running then return end
    CustomZone.running = false
    for _, c in ipairs(CustomZone.connections) do pcall(function() c:Disconnect() end) end
    CustomZone.connections = {}
    for killer, zone in pairs(CustomZone.killerZones) do
        if zone.model then pcall(function() zone.model:Destroy() end) end
    end
    CustomZone.killerZones = {}
    if CustomZone.folder then pcall(function() CustomZone.folder:Destroy() end); CustomZone.folder = nil end
    print("[shitsaken] Custom Zone OFF")
end

local function UpdateCustomZoneVisibility()
    local shouldShow = Settings.ShowFacingVisual == true
    if shouldShow and not CustomZone.running then
        StartCustomZoneVisuals()
    elseif not shouldShow and CustomZone.running then
        StopCustomZoneVisuals()
    end
end

