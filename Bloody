                   and (p.Position - myRoot.Position).Magnitude <= HDT_DETECT_RADIUS then
                    found = p; break
                end
            end
        end
        if found and not _hdtDebounce then
            local nearest = getNearestKillerModel()
            if nearest then
                task.wait(HDT.Delay)
                task.spawn(beginDragIntoKiller, nearest)
            end
        end
        task.wait(0.12)
    end
end)

