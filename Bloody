local function doFlip(dir)
    local cooldown = false
    if cooldown then return end
    cooldown = true
    local hum = Character and Character:FindFirstChildOfClass("Humanoid")
    local root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not hum or not root then cooldown = false; return end
    local animator = hum:FindFirstChildOfClass("Animator")
    local saved = {}
    if animator then
        for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
            saved[#saved + 1] = { track = tr, time = tr.TimePosition }
            tr:Stop(0)
        end
    end
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    for _, st in ipairs({ Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Climbing }) do
        hum:SetStateEnabled(st, false)
    end
    local orig = root.CFrame
    local look = (dir == "front") and orig.LookVector or -orig.LookVector
    task.spawn(function()
        local start = os.clock()
        for i = 1, 120 do
            local t = i / 120
            local pos = orig.Position + look * (35 * t) + Vector3.new(0, 1, 0) * (4 * (t - t * t) * 10)
            root.CFrame = CFrame.new(pos) * (orig.Rotation * CFrame.Angles(math.rad(-i * 3), 0, 0))
            local target = 0.00375 * i - (os.clock() - start)
            if target > 0 then task.wait(target) end
        end
        root.CFrame = CFrame.new(orig.Position + look * 35) * orig.Rotation
        for _, st in ipairs({ Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Climbing }) do
            hum:SetStateEnabled(st, true)
        end
        hum:ChangeState(Enum.HumanoidStateType.Running)
        if animator then
            for _, s in ipairs(saved) do
                s.track:Play(); s.track.TimePosition = s.time
                if s.track.Animation.AnimationId == "rbxassetid://75804462760596" then s.track:AdjustSpeed(0) end
            end
        end
        task.wait(0.25); cooldown = false
    end)
end
UtilsTab:Button({ Title = "Backflip", Callback = function() doFlip("back") end })
UtilsTab:Button({ Title = "Frontflip", Callback = function() doFlip("front") end })

