local Aim = {
    Enabled  = false,
    Distance = 45,
    Duration = 1.15,
    Prediction = 0,
    CamLock  = false,
    Active   = false,
    Target   = nil,
    T0       = 0,
}

-- punch / attack anims that trigger aim
local AIM_ANIMS = {
    ["87259391926321"]=true,["140703210927645"]=true,["136007065400978"]=true,
    ["100725497418533"]=true,["114155003741146"]=true,
    ["72722244508749"]=true,["96959123077498"]=true,
}

local function nearestKiller(maxD)
    if not LocalRoot or not KillersFolder then return nil end
    local best, bd = nil, maxD or 45
    for _, m in ipairs(KillersFolder:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart")
        local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - LocalRoot.Position).Magnitude
            if d < bd then bd = d; best = m end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not Aim.Active or not LocalRoot then return end
    local elapsed = tick() - Aim.T0
    local tr = Aim.Target and Aim.Target:FindFirstChild("HumanoidRootPart")
    local th = Aim.Target and Aim.Target:FindFirstChildOfClass("Humanoid")
    if elapsed > Aim.Duration or not tr or (th and th.Health <= 0) then
        Aim.Active = false
        if LocalHum then LocalHum.AutoRotate = true end
        return
    end
    local pos = tr.Position
    if Aim.Prediction > 0 and th and th.MoveDirection.Magnitude > 0 then
        pos = pos + th.MoveDirection.Unit * Aim.Prediction
    end
    local goal = CFrame.lookAt(LocalRoot.Position, Vector3.new(pos.X, LocalRoot.Position.Y, pos.Z))
    if (pos - LocalRoot.Position).Magnitude < 6 then
        LocalRoot.CFrame = goal
    else
        LocalRoot.CFrame = LocalRoot.CFrame:Lerp(goal, 0.7)
    end
    if Aim.CamLock then
        local cam = workspace.CurrentCamera
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pos), 0.75)
    end
end)

local function hookAimChar(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
    if not anim then return end
    anim.AnimationPlayed:Connect(function(track)
        if not Aim.Enabled or Aim.Active then return end
        local id = track.Animation and extractId(track.Animation.AnimationId)
        if not id or not AIM_ANIMS[id] then return end
        local k = nearestKiller(Aim.Distance)
        if k then
            Aim.Active = true
            Aim.Target = k
            Aim.T0 = tick()
            hum.AutoRotate = false
        end
    end)
end
if LocalPlayer.Character then task.spawn(hookAimChar, LocalPlayer.Character) end
