safe("Aimbot", function()
    local GAim = {
        enabled=false, mode="Character Lock",
        values={
            Guest1337={Enabled=false,Distance=50,LockDuration=1.3,Prediction=0},
            Shedlekey={Enabled=false,Distance=29,LockDuration=1.2,Prediction=0},
            TwoTime={Enabled=false,Distance=29,LockDuration=0.9,Prediction=0},
            Chance={Enabled=false,LockDuration=1.5,Prediction=3},
            Pizza={Enabled=false,Distance=50,LockDuration=1.2,Prediction=0.5},
            JaneDoe={Enabled=false,Distance=50,LockDuration=1.1,Prediction=0},
        },
        animData={
            Guest1337={},Shedlekey={},
            TwoTime={["100725497418533"]=true,["89448354637442"]=true},
            Chance={},Pizza={["114155003741146"]=true},JaneDoe={},
        },
        active={IsActive=false,Target=nil,StartTime=0,Mode="",Track=nil},
        lastFinished=nil,
    }
    local function scan()
        local assets=ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
        local roots={assets:FindFirstChild("Survivors")}
        local skins=assets:FindFirstChild("Skins")
        if skins then table.insert(roots,skins:FindFirstChild("Survivors")) end
        for _,root in ipairs(roots) do
            if root then
                for _,d in ipairs(root:GetDescendants()) do
                    if d:IsA("ModuleScript") and d.Name=="Config" then
                        local ok,data=pcall(require,d)
                        if ok and type(data)=="table" and type(data.Animations)=="table" then
                            local a=data.Animations
                            local function add(key,val)
                                if not val then return end
                                local id=tostring(val):match("%d+")
                                if id and GAim.animData[key] then GAim.animData[key][id]=true end
                            end
                            add("Guest1337",a.Punch); add("Guest1337",a.ParryPunch)
                            add("Shedlekey",a.Slash); add("JaneDoe",a.Axe); add("Chance",a.AimGun)
                        end
                    end
                end
            end
        end
    end
    pcall(scan)
    local function target(modeKey,cfg)
        if modeKey=="Pizza" then return GetNearestSurvivorModel(cfg.Distance or 50)
        elseif modeKey=="Chance" then return GetNearestKillerModel(9999)
        else
            local dist=(modeKey=="Guest1337" or modeKey=="JaneDoe") and 9999 or (cfg.Distance or 50)
            return GetNearestKillerModel(dist)
        end
    end
    RunService.RenderStepped:Connect(function()
        if not GAim.enabled or IsPlayerKiller() then
            if GAim.active.IsActive then
                GAim.active.IsActive=false; GAim.active.Target=nil
                local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate=true end
            end
            return
        end
        local char=LP.Character; if not char then return end
        local hrp=char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if not GAim.active.IsActive then
            local animator=hum:FindFirstChildOfClass("Animator"); if not animator then return end
            for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track~=GAim.lastFinished and track.IsPlaying and track.Animation then
                    local id=tostring(track.Animation.AnimationId):match("%d+")
                    if id then
                        for modeKey,idMap in pairs(GAim.animData) do
                            local cfg=GAim.values[modeKey]
                            if cfg and cfg.Enabled and idMap[id] then
                                local t=target(modeKey,cfg)
                                if t then
                                    GAim.active.IsActive=true; GAim.active.Target=t
                                    GAim.active.StartTime=tick(); GAim.active.Mode=modeKey
                                    GAim.active.Track=track; hum.AutoRotate=false
                                end
                                break
                            end
                        end
                        if GAim.active.IsActive then break end
                    end
                end
            end
            return
        end
        local mode=GAim.active.Mode; local cfg=GAim.values[mode]
        if not cfg then GAim.active.IsActive=false; return end
        local elapsed=tick()-GAim.active.StartTime
        local tHRP=GAim.active.Target and GAim.active.Target:FindFirstChild("HumanoidRootPart")
        local tHum=GAim.active.Target and GAim.active.Target:FindFirstChildOfClass("Humanoid")
        if elapsed>(cfg.LockDuration or 1) or not tHRP or (tHum and tHum.Health<=0) then
            GAim.lastFinished=GAim.active.Track
            GAim.active.IsActive=false; GAim.active.Target=nil; GAim.active.Track=nil
            hum.AutoRotate=true; return
        end
        local position=tHRP.Position
        local pred=cfg.Prediction or 0
        if pred>0 and tHum and tHum.MoveDirection.Magnitude>0 then
            position=position+tHum.MoveDirection.Unit*pred
        end
        local look=CFrame.lookAt(hrp.Position,Vector3.new(position.X,hrp.Position.Y,position.Z))
        if mode=="Chance" or (tHRP.Position-hrp.Position).Magnitude<6 then hrp.CFrame=look
        else hrp.CFrame=hrp.CFrame:Lerp(look,0.65) end
        if GAim.mode=="Char + Cam Lock" then
            local cam=Workspace.CurrentCamera
            if cam then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,position),0.75) end
        end
    end)
    local left=Tabs.Aimbot:AddLeftGroupbox("Aimbot","crosshair")
