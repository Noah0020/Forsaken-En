-- HITBOX EXPANDER
--═══════════════════════════════════════════════════════════════════
local HitboxExpander = { Enabled=false, TargetMode="Distance", Distance=10, _running=false, _thread=nil }

local function HBE_GetNearestTarget(root)
    local hb = HitboxExpander
    local huge = hb.TargetMode == "Lowest HP" and math.huge or hb.Distance
    local best = nil
    local folders = {}
    local pf = Workspace:FindFirstChild("Players")
    if pf then
        local kf = pf:FindFirstChild("Killers")
        local sf = pf:FindFirstChild("Survivors")
        if kf then table.insert(folders, kf) end
        if sf then table.insert(folders, sf) end
    end
    for _, folder in ipairs(folders) do
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") and m ~= LocalPlayer.Character then
                local hrp = m:FindFirstChild("HumanoidRootPart")
                local hum = m:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - root.Position).Magnitude
                    if dist <= hb.Distance then
                        if hb.TargetMode == "Distance" then
                            if dist < huge then huge = dist; best = m end
                        else
                            if hum.Health < huge then huge = hum.Health; best = m
                            elseif hum.Health == huge and best then
                                if dist < (best.HumanoidRootPart.Position - root.Position).Magnitude then best = m end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function HBE_ApplyVelocity()
    if HitboxExpander._running then return end
    HitboxExpander._running = true
    HitboxExpander._thread = task.spawn(function()
        while HitboxExpander.Enabled do
            task.wait()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then
                task.wait(0.1)
                continue
            end
            local target = HBE_GetNearestTarget(root)
            if target then
                local thrp = target:FindFirstChild("HumanoidRootPart")
                if thrp then
                    local ping = 0.05
                    pcall(function() ping = math.max(LocalPlayer:GetNetworkPing()/2, 0.05) end)
                    local desired = (thrp.Position + thrp.AssemblyLinearVelocity * (ping * 1.25) - root.Position) / (ping * 2)
                    local old = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = desired
                    RunService.RenderStepped:Wait()
                    if root and root.Parent then root.AssemblyLinearVelocity = old end
                end
            end
        end
        HitboxExpander._running = false
    end)
end

