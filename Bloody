-- TWO TIME
--═══════════════════════════════════════════════════════════════════
local NORMAL_STAB_ID = "100725497418533"
local CROUCH_STAB_ID = "89448354637442"
local DAGGER_ANIM_IDS = { [NORMAL_STAB_ID]=true, [CROUCH_STAB_ID]=true }
local TwoTime = { stabbing=false, lastStab=0, conn=nil, originalAutoRotate=true, animConn=nil, charAddedConn=nil }
local function TTGetNearestKiller()
    local f = GetKillersFolder(); local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not f or not myHRP then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(f:GetChildren()) do
        if k:IsA("Model") then
            local h = k:FindFirstChild("HumanoidRootPart") or k.PrimaryPart
            local hum = k:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local d = (h.Position - myHRP.Position).Magnitude
                if d < bd then bd = d; best = k end
            end
        end
    end
    return best
end
local function TTCleanup()
    if TwoTime.conn then pcall(function() TwoTime.conn:Disconnect() end); TwoTime.conn = nil end
    local char = LP.Character; local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.AutoRotate = TwoTime.originalAutoRotate; hum:Move(Vector3.zero, false) end) end
    TwoTime.stabbing = false
end
local function TTRunLunge(killer)
    if not Settings.TT_Enabled or TwoTime.stabbing or IsPlayerKiller() then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local now = os.clock()
    if now - TwoTime.lastStab < (Settings.TT_Cooldown or 0.5) then return end
    TwoTime.lastStab = now
    if not killer or not killer.Parent then return end
    local khrp = killer:FindFirstChild("HumanoidRootPart"); if not khrp then return end
    if (khrp.Position - hrp.Position).Magnitude > (Settings.TT_MaxRange or 60) then return end
    TwoTime.originalAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    TwoTime.stabbing = true
    local duration = Settings.TT_FollowDuration or 0.5
    local endTime = tick() + duration
    local lerpSpeed = Settings.TT_LerpSpeed or 45
    if TwoTime.conn then pcall(function() TwoTime.conn:Disconnect() end) end
    TwoTime.conn = RunService.RenderStepped:Connect(function(dt)
        if not TwoTime.stabbing then return end
        if tick() >= endTime then TTCleanup(); return end
        local c2 = LP.Character; if not c2 then TTCleanup(); return end
        local hrp2 = c2:FindFirstChild("HumanoidRootPart")
        local hum2 = c2:FindFirstChildOfClass("Humanoid")
        if not hrp2 or not hum2 or hum2.Health <= 0 then TTCleanup(); return end
        local khrp2 = killer and killer.Parent and killer:FindFirstChild("HumanoidRootPart")
        if not khrp2 then TTCleanup(); return end
        local kCF = khrp2.CFrame
        local behind = kCF.Position - kCF.LookVector * (Settings.TT_BehindOffset or 1.7)
        local target = Vector3.new(behind.X, hrp2.Position.Y, behind.Z)
        local dist = (target - hrp2.Position).Magnitude
        if dist > 0.15 then
            local step = math.min(lerpSpeed * dt, dist)
            local dir = (target - hrp2.Position).Unit
            local newPos = hrp2.Position + dir * step
            pcall(function()
                hrp2.CFrame = CFrame.lookAt(newPos, Vector3.new(kCF.Position.X, newPos.Y, kCF.Position.Z))
                hrp2.AssemblyLinearVelocity = Vector3.zero
                hrp2.AssemblyAngularVelocity = Vector3.zero
            end)
        else
            pcall(function()
                hrp2.CFrame = CFrame.lookAt(hrp2.Position, Vector3.new(kCF.Position.X, hrp2.Position.Y, kCF.Position.Z))
                hrp2.AssemblyLinearVelocity = Vector3.zero
                hrp2.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
    task.delay(duration + 0.1, function() if TwoTime.stabbing then TTCleanup() end end)
end
local function TTAttachWatcher(char)
    local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
    local anim = hum:WaitForChild("Animator", 5); if not anim then return end
    if TwoTime.animConn then pcall(function() TwoTime.animConn:Disconnect() end); TwoTime.animConn = nil end
    TwoTime.animConn = anim.AnimationPlayed:Connect(function(track)
        if not Settings.TT_Enabled then return end
        local anim2 = track.Animation; if not anim2 then return end
        local id = tostring(anim2.AnimationId):match("%d+"); if not id then return end
        if DAGGER_ANIM_IDS[id] then
            local k = TTGetNearestKiller()
            if k then TTRunLunge(k) end
        end
    end)
end
local function TTStart()
    if LP.Character then TTAttachWatcher(LP.Character) end
    TwoTime.charAddedConn = LP.CharacterAdded:Connect(function(c)
        task.wait(0.5); if Settings.TT_Enabled then TTAttachWatcher(c) end
    end)
end
local function TTStop()
    TTCleanup()
    if TwoTime.animConn then pcall(function() TwoTime.animConn:Disconnect() end); TwoTime.animConn = nil end
    if TwoTime.charAddedConn then pcall(function() TwoTime.charAddedConn:Disconnect() end); TwoTime.charAddedConn = nil end
end

