-- FIX #1: Range + facing visuals — MOVED HERE so that
-- attachKillerFolder and StopAutoBlock (defined below) can
-- capture these as proper Lua upvalues instead of nil globals.
--   • Range ring  = CylinderHandleAdornment (flat disk on killer HRP)
--   • Facing zone = Part with Shape=Cylinder (flat circle in front of killer)
-- ═══════════════════════════════════════════════════════════════
local ABVisuals = { ranges = {}, facings = {} }

local function removeRangeVisual(killer)
    local v = ABVisuals.ranges[killer]
    if v then pcall(function() v:Destroy() end); ABVisuals.ranges[killer] = nil end
end

local function removeFacingDisk(killer)
    local v = ABVisuals.facings[killer]
    if v then pcall(function() v:Destroy() end); ABVisuals.facings[killer] = nil end
end

local function clearAllABVisuals()
    for k in pairs(ABVisuals.ranges) do removeRangeVisual(k) end
    for k in pairs(ABVisuals.facings) do removeFacingDisk(k) end
end

local function updateKillerVisuals(killer)
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not kr then
        removeRangeVisual(killer)
        removeFacingDisk(killer)
        return
    end

    local yOffset = -(math.min(kr.Size.Y, 3) / 2) + 0.05
    local feetY = kr.Position.Y + yOffset

    -- Range ring (CylinderHandleAdornment, CFrame is relative to Adornee)
    if Settings.ShowBlockRangeVisual then
        local c = ABVisuals.ranges[killer]
        if not c then
            c = Instance.new("CylinderHandleAdornment")
            c.Name = "IvyBlockRange"
            c.Adornee = kr
            c.AlwaysOnTop = true
            c.ZIndex = 1
            c.Transparency = 0.65
            c.Height = 0.1
            c.Parent = kr
            ABVisuals.ranges[killer] = c
        end
        c.Color3 = Settings.BlockRangeColor
        c.Radius = Settings.BlockRange
        c.CFrame = CFrame.new(0, yOffset, 0) * CFrame.Angles(0, 0, math.rad(90))
    else
        removeRangeVisual(killer)
    end

    -- Facing disk (Part, world-space, flat on ground in front of killer)
    if Settings.ShowFacingVisual then
        local disk = ABVisuals.facings[killer]
        if not disk then
            disk = Instance.new("Part")
            disk.Name = "IvyFacingDisk"
            disk.Shape = Enum.PartType.Cylinder
            disk.Anchored = true
            disk.CanCollide = false
            disk.CanTouch = false
            disk.CanQuery = false
            disk.CastShadow = false
            disk.Material = Enum.Material.Neon
            disk.Parent = Workspace
            ABVisuals.facings[killer] = disk
        end

        local dot = math.clamp(Settings.BlockFacingDot, -1, 1)
        local frac = math.acos(dot) / math.pi
        local radius = Settings.BlockRange * (0.35 + 0.45 * frac)
        local forwardDist = Settings.BlockRange * 0.5

        disk.Size = Vector3.new(0.2, radius * 2, radius * 2)
        disk.Color = Settings.BlockFacingColor
        disk.Transparency = 0.55

        local look = kr.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(0, 0, -1) end
        flatLook = flatLook.Unit

        local center = Vector3.new(
            kr.Position.X + flatLook.X * forwardDist,
            feetY,
            kr.Position.Z + flatLook.Z * forwardDist
        )
        disk.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
    else
        removeFacingDisk(killer)
    end
end

-- Visual refresh heartbeat (stays near the functions it drives)
local abVizAccum = 0
RunService.Heartbeat:Connect(function(dt)
    if not (Settings.ShowBlockRangeVisual or Settings.ShowFacingVisual) then
        if next(ABVisuals.ranges) or next(ABVisuals.facings) then clearAllABVisuals() end
        return
    end
    abVizAccum = abVizAccum + dt
    if abVizAccum < 0.033 then return end
    abVizAccum = 0
    for _, k in ipairs(getKillers()) do pcall(updateKillerVisuals, k) end
    for k in pairs(ABVisuals.ranges) do
        if not k or not k.Parent or not k:FindFirstChild("HumanoidRootPart") then removeRangeVisual(k) end
    end
    for k in pairs(ABVisuals.facings) do
        if not k or not k.Parent or not k:FindFirstChild("HumanoidRootPart") then removeFacingDisk(k) end
    end
end)

-- ─── attachKillerFolder now resolves all visual upvalues correctly ───
local function attachKillerFolder(folder, myGen)
    if not folder then return false end

    for _, d in ipairs(folder:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d) end
    end
    table.insert(AB.connections, folder.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") and AB.running and AB.generation == myGen then hookSound(d) end
    end))

    for _, k in ipairs(folder:GetChildren()) do
        if k:IsA("Model") then
            hookKillerAnims(k)
            if Settings.ShowBlockRangeVisual or Settings.ShowFacingVisual then
                task.spawn(updateKillerVisuals, k)
            end
        end
    end
    table.insert(AB.connections, folder.ChildAdded:Connect(function(k)
        if not k:IsA("Model") then return end
        if not AB.running or AB.generation ~= myGen then return end
        task.wait(0.1)
        hookKillerAnims(k)
    end))
    table.insert(AB.connections, folder.ChildRemoved:Connect(function(k)
        removeRangeVisual(k)
        removeFacingDisk(k)
    end))
    return true
end

