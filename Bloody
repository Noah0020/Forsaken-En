local function soundHasDuckId(sound)
    if not sound then return false end
    local id = string.match(tostring(sound.SoundId or ""), "%d+")
    return id ~= nil and DUCK_SOUND_IDS[id] == true and DUCK_IGNORED_IDS[id] ~= true
end

local function getCueNameContext(instance, killer)
    local names = {}
    local cursor = instance
    while cursor and cursor ~= killer do
        table.insert(names, cursor.Name)
        cursor = cursor.Parent
    end
    return table.concat(names, " ")
end

--// One shared fire path prevents all three layers from firing repeatedly at
--// the same instant. The first call is immediate; the retry is confirmation-gated.
local function getKillerState(killer)
    local state = SimpleAB.killerStates[killer]
    if not state then
        state = {
            firstFire = 0,
            lastFire = 0,
            attempts = 0,
            confirmed = false,
            windowEnd = 0,
            token = 0,
            lastCoreStamp = 0,
            lastBoxScan = 0,
        }
        SimpleAB.killerStates[killer] = state
    end
    return state
end

local function fireAtKiller(killer)
    local settings = getSettings()
    local fire = G("FireAbilityByMode")
    if type(settings) ~= "table" or type(fire) ~= "function" then return false end
    if settings.PermanentABLock or localPlayerIsKiller() then return false end

    -- Keep the hitbox ability mode selected even when the SkidSaken layer is
    -- switched off and only the Duck/cue backup layers are being used.
    local oldAuto = settings.AutoBlock
    local oldCustom = settings.AutoBlockCustom
    local oldRectangle = settings.AutoBlockRectangle
    settings.AutoBlock = false
    settings.AutoBlockCustom = false
    settings.AutoBlockRectangle = true
    local ok, err = pcall(fire, nil, killer)
    settings.AutoBlock = oldAuto
    settings.AutoBlockCustom = oldCustom
    settings.AutoBlockRectangle = oldRectangle
    if not ok then
        warn("[Simple Hub] FireAbilityByMode failed: " .. tostring(err))
        return false
    end
    return true
end

local function scheduleFailover(killer, state, token)
    if not Config.retryEnabled then return end
    task.delay(Config.fallbackDelay, function()
        if not SimpleAB.running or not killer or not killer.Parent then return end
        if SimpleAB.killerStates[killer] ~= state or state.token ~= token then return end
        if state.confirmed or state.attempts >= 2 then return end
        if tick() > state.windowEnd then return end
        local _, _, localRoot = getLocalParts()
        local killerRoot = getRoot(killer)
        if not localRoot or not killerRoot then return end
        if (localRoot.Position - killerRoot.Position).Magnitude > Config.cueRange then return end

        state.attempts = 2
        state.lastFire = tick()
        fireAtKiller(killer)
    end)
end

local function requestBlock(killer, source)
    if not SimpleAB.running or not killer or not killer.Parent then return false end
    if not isWatchedKiller(killer) or localPlayerIsKiller() then return false end
    local settings = getSettings()
    if type(settings) ~= "table" or settings.PermanentABLock then return false end

    local _, _, localRoot = getLocalParts()
    local killerRoot = getRoot(killer)
    if not localRoot or not killerRoot then return false end
    if (localRoot.Position - killerRoot.Position).Magnitude > Config.cueRange then return false end

    local now = tick()
    local state = getKillerState(killer)
    if now > state.windowEnd then
        state.firstFire = 0
        state.lastFire = 0
        state.attempts = 0
        state.confirmed = false
        state.token = state.token + 1
    end
    if state.confirmed or state.attempts >= 2 then return false end
    if state.attempts > 0 and now - state.lastFire < 0.10 then return false end

    -- If SkidSaken's native hitbox just fired for this same moment, let its
    -- confirmation arrive before using the addon fallback.
    local coreStamp = tonumber(G("_lastABSuccessTime")) or 0
    local coreKillerRoot = G("_lastABKillerRoot")
    if state.attempts == 0 and coreKillerRoot == killerRoot and coreStamp > state.lastCoreStamp and now - coreStamp >= 0 and now - coreStamp < 0.10 then
        state.lastCoreStamp = coreStamp
        state.firstFire = coreStamp
        state.lastFire = now
        state.attempts = 1
        state.confirmed = false
        state.windowEnd = now + 0.70
        state.token = state.token + 1
        scheduleFailover(killer, state, state.token)
        return false
    end

    if state.attempts == 0 then
        state.firstFire = now
        state.windowEnd = now + 0.70
        state.token = state.token + 1
    end
    state.attempts = state.attempts + 1
    state.lastFire = now
    local token = state.token
    local fired = fireAtKiller(killer)
    if state.attempts == 1 then scheduleFailover(killer, state, token) end
    return fired
end

