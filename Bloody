local function Create(class, properties, parent)
    local object = Instance.new(class)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end
local function Corner(parent, radius)
    return Create("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, parent)
end
local function Stroke(parent, color, transparency)
    return Create("UIStroke", { Color = color or Theme.Stroke, Transparency = transparency or 0, Thickness = 1 }, parent)
end
local function Tween(object, properties, duration, style)
    local animation = TweenService:Create(object, TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
    animation:Play()
    return animation
end
