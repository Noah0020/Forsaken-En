local AimCore = { prediction = 0.1, easing = 0.35, aimPingComp = true }

local function PredictPos(part)
    if not part then return Vector3.zero end
    local pred = AimCore.prediction
    if AimCore.aimPingComp then
        local ok, ping = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        end)
        if ok and type(ping) == "number" then pred = pred + ping * 0.5 end
    end
    return part.Position + part.AssemblyLinearVelocity * pred
end

