local Aim = { active=false, startT=0, lastTrig=0, hookDone=false, endT=0, targetRoot=nil, targetModel=nil, humanoid=nil, oldAutoRotate=nil }

local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, result = pcall(function()
            local len = buffer.len(arg)
            if len <= 0 or len > 256 then return nil end
            local out = ""
            for i = 5, len - 1 do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out = out .. string.char(b)
                elseif #out > 0 then break end
            end
            return out ~= "" and out or nil
        end)
        return ok and result or nil
    end
    if t == "table" then
        for _, value in pairs(arg) do
            local extracted = ExtractAbility(value)
            if extracted then return extracted end
        end
    end
    return nil
end

local function IsOffensiveAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower():gsub("[%s_%-]", "")
    if Settings.AIM_OnSlash and l == "slash" then return true end
    if Settings.AIM_OnBlock and (l == "block" or l == "parry" or l == "punch") then return true end
    if Settings.AIM_OnDagger and l:find("dagger", 1, true) then return true end
    if Settings.AIM_OnAxe and (l == "axe" or l == "hatchet") then return true end
    if Settings.AIM_OnShoot then
        if l == "shoot" then return true end
        if l:find("oneshot", 1, true) or l:find("flintlock",1,true) then return true end
        if l:find("sixshot",1,true) or l:find("sixshooter",1,true) then return true end
        if l:find("gun",1,true) or l:find("shot",1,true) then return true end
    end
    return false
end

local function GetLockTime(name)
    local base = tonumber(Settings.AIM_LockTime) or 0.7
    if type(name) ~= "string" then return base end
    local l = name:lower()
    if l == "shoot" then return math.max(base, 1.15) end
    if l == "slash" then return math.max(base, 0.65) end
    if l:find("dagger", 1, true) then return math.max(base, 0.85) end
    if l == "axe" or l == "hatchet" then return math.max(base, 0.70) end
    return base
end

local function Aim_FindTarget()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local kf = GetKillersFolder(); if not kf then return nil, nil end
    local killer, kr, dist = nil, nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then dist = d; killer = k; kr = krp end
        end
    end
    if not killer or dist > (tonumber(Settings.AIM_Range) or 55) or dist < (tonumber(Settings.AIM_MinDist) or 3) then return nil, nil end
    return killer, kr
end

local function Aim_GetPredictedPosition(targetRoot)
    if not targetRoot or not targetRoot.Parent then return nil end
    local vel = targetRoot.AssemblyLinearVelocity or Vector3.zero
    if vel.Magnitude > 50 then vel = vel.Unit * 50 end
    local prediction = math.clamp(tonumber(Settings.AIM_Prediction) or 4, 0, 10) * 0.05
    return targetRoot.Position + vel * prediction
end

local function Aim_Restore()
    if Aim.humanoid and Aim.humanoid.Parent and Aim.oldAutoRotate ~= nil then
        pcall(function() Aim.humanoid.AutoRotate = Aim.oldAutoRotate end)
    end
    Aim.active = false
    Aim.targetRoot = nil
    Aim.targetModel = nil
    Aim.humanoid = nil
    Aim.oldAutoRotate = nil
end

local function Aim_InstantRotate(abilityName)
    local killer, targetRoot = Aim_FindTarget()
    if not targetRoot then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return false end
    if not Aim.active then
        Aim.humanoid = hum
        Aim.oldAutoRotate = hum.AutoRotate
    elseif Aim.humanoid ~= hum then
        Aim_Restore()
        Aim.humanoid = hum
        Aim.oldAutoRotate = hum.AutoRotate
    end
    Aim.targetModel = killer
    Aim.targetRoot = targetRoot
    if Settings.AIM_Mode == "Character" or Settings.AIM_Mode == "Both" then
        hum.AutoRotate = false
    end
    local target = Aim_GetPredictedPosition(targetRoot)
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and target and (Settings.AIM_Mode == "Character" or Settings.AIM_Mode == "Both") then
        pcall(function() root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.X, root.Position.Y, target.Z)) end)
    end
    local now = tick()
    Aim.active = true
    Aim.startT = now
    Aim.endT = now + GetLockTime(abilityName)
    return true
end

local function Aim_SetupHook()
    if Aim.hookDone or not NetworkEvent or not hookmetamethod then return false end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if Settings.AIM_Enabled and getnamecallmethod() == "FireServer" and self == NetworkEvent then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsOffensiveAbility(n) then Aim_InstantRotate(n) end
                end
            end
            return old(self, ...)
        end)
    end)
    if ok then Aim.hookDone = true end
    return ok
end

RunService.RenderStepped:Connect(function()
    if not Settings.AIM_Enabled then
        if Aim.active then Aim_Restore() end
        return
    end
    if not Aim.active then return end
    if tick() > Aim.endT then Aim_Restore(); return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local targetRoot = Aim.targetRoot
    if not root or not hum or hum.Health <= 0 or hum ~= Aim.humanoid then Aim_Restore(); return end
    if not targetRoot or not targetRoot.Parent or not Aim.targetModel or not Aim.targetModel.Parent then
        Aim_Restore(); return
    end
    local target = Aim_GetPredictedPosition(targetRoot)
    if not target then Aim_Restore(); return end
    if Settings.AIM_Mode == "Character" or Settings.AIM_Mode == "Both" then
        hum.AutoRotate = false
        pcall(function()
            root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.X, root.Position.Y, target.Z))
        end)
    end
    if Settings.AIM_Mode == "Camera" or Settings.AIM_Mode == "Both" then
        local cam = Workspace.CurrentCamera
        if cam then pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target) end) end
    end
end)

task.spawn(function()
    for _ = 1, 30 do
        if Aim.hookDone then break end
        Aim_SetupHook()
        task.wait(1)
    end
end)

