local Config_Gen = { StartDelay=1.5, ActionDelay=0.05, ConnectDelay=1.0, GearDelay=0.03 }
local MinigameSolver = { Enabled=false, ManualEnabled=false, Generation=0,
    LockBoard=nil, Installed=false, Available=false, Originals={} }
