    VeeAutoTrickState.running = false
    if VeeAutoTrickState.thread then pcall(task.cancel, VeeAutoTrickState.thread); VeeAutoTrickState.thread = nil end
    if VeeAutoTrickState.descConn then pcall(function() VeeAutoTrickState.descConn:Disconnect() end); VeeAutoTrickState.descConn = nil end
    if VeeAutoTrickState.pgConn then pcall(function() VeeAutoTrickState.pgConn:Disconnect() end); VeeAutoTrickState.pgConn = nil end
