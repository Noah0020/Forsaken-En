do
    MusicTab:Section({ Title = "Last Survivor Music" })
    MusicTab:Toggle({ Title = "Enable LMS Override", Value = false,
        Callback = function(v) onLMSToggle(v) end })
    local trackList = {}
    for k in pairs(musicTracks) do table.insert(trackList, k) end
    table.sort(trackList)
    MusicTab:Dropdown({ Title = "Track", Values = trackList, Value = v1.lmsTrack,
        Callback = function(v)
            v1.lmsTrack = v
            if musicState.on then task.spawn(function() applyLMS(v) end) end
        end })
    MusicTab:Space()
    MusicTab:Button({ Title = "Preload All Tracks", Icon = "download", Justify = "Center",
        Callback = function()
            if not CanUseFS then notify("Music", "Filesystem not supported on this executor", 3); return end
            notify("Music", "Preloading all tracks...", 3)
            _G.Cupcake.PreloadLMS()
        end })
    if not CanUseFS then
        MusicTab:Space()
        MusicTab:Paragraph({ Title = "Note", Desc = "Music caching requires filesystem support. Some executors may not support this." })
    end
end

--─── EMOTES ───────────────────────────────────────────────────────────────────
do
    EmotesTab:Section({ Title = "Emotes" })
    local selectedEmote = #emoteMods > 0 and emoteMods[1].Name or nil
    local function getEmoteNames()
        local t = {}
        for _, m in ipairs(emoteMods) do table.insert(t, m.Name) end
        return t
    end
    local emDropdown
    emDropdown = EmotesTab:Dropdown({
        Title    = "Select Emote",
        Values   = getEmoteNames(),
        Value    = selectedEmote,
        AllowNone = true,
        Callback = function(v) selectedEmote = v end,
    })
    if #emoteMods == 0 then
        EmotesTab:Paragraph({ Title = "No emotes found", Desc = "Emotes load from game assets. Click Refresh after the map loads." })
    end
    EmotesTab:Space()
    local emGrp = EmotesTab:Group({})
    emGrp:Button({ Title = "Play",  Icon = "", Justify = "Center",
        Callback = function()
            if selectedEmote then _G.Cupcake.PlayEmote(selectedEmote)
            else notify("Emotes", "Select an emote first", 2) end
        end })
    emGrp:Space()
    emGrp:Button({ Title = "Stop", Icon = "", Justify = "Center",
        Callback = function() _G.Cupcake.StopEmote() end })
    EmotesTab:Space()
    EmotesTab:Button({ Title = "Refresh Emote List", Icon = "refresh-cw", Justify = "Center",
        Callback = function()
            local names = getEmoteNames()
            if emDropdown then pcall(function() emDropdown:Refresh(names) end) end
            notify("Emotes", #names .. " emote(s) found", 2)
        end })
end

