-- BOX FACING CHECK  (fully editable visual + detection)
--═══════════════════════════════════════════════════════════════════
local FacingCheck = {
    Width  = 8,
    Height = 6,
    Length = 15,

    Color        = Color3.fromRGB(255, 40, 40),
    Transparency = 0,
    Thickness    = 0.045,

    FollowPlayer     = true,  -- box tracks your character
    OffsetY          = 0,     -- raise/lower box center
    VisualEnabled    = true,  -- draw the 12 neon edges
    DetectionEnabled = true,  -- gate auto block detection
}

local FacingFolder = Instance.new("Folder")
FacingFolder.Name = "Cupcake_FacingCheck"
FacingFolder.Parent = Workspace

local FacingEdges = {}
for i = 1, 12 do
    local p = Instance.new("Part")
    p.Name = "FacingEdge"
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = FacingCheck.Color
    p.Transparency = 1
    p.Size = Vector3.new(1, 1, 1)
    p.Parent = FacingFolder
    FacingEdges[i] = p
end

local FacingConnections = {
    {1,2}, {3,4}, {5,6}, {7,8},
    {1,3}, {2,4}, {5,7}, {6,8},
    {1,5}, {2,6}, {3,7}, {4,8},
}

local function FacingUpdateVisual()
    if not FacingCheck.VisualEnabled then
        for _, e in ipairs(FacingEdges) do
            if e.Transparency ~= 1 then e.Transparency = 1 end
        end
        return
    end

    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local W, H, L = FacingCheck.Width, FacingCheck.Height, FacingCheck.Length
    local center  = root.Position + Vector3.new(0, FacingCheck.OffsetY, 0)

    local lv = root.CFrame.LookVector
    local flat = Vector3.new(lv.X, 0, lv.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
    flat = flat.Unit

    local cf = CFrame.lookAt(center, center + flat)

    local X, Y, Z = W / 2, H / 2, L / 2
    local corners = {
        Vector3.new(-X,-Y,-Z), Vector3.new(X,-Y,-Z), Vector3.new(-X,Y,-Z), Vector3.new(X,Y,-Z),
        Vector3.new(-X,-Y, Z), Vector3.new(X,-Y, Z), Vector3.new(-X,Y, Z), Vector3.new(X,Y, Z),
    }
    local P = {}
    for i, c in ipairs(corners) do P[i] = cf:PointToWorldSpace(c) end

    for i, c in ipairs(FacingConnections) do
        local A, B = P[c[1]], P[c[2]]
        local mid  = (A + B) * 0.5
        local dist = (B - A).Magnitude
        local e = FacingEdges[i]
        e.Size     = Vector3.new(FacingCheck.Thickness, FacingCheck.Thickness, dist)
        e.CFrame   = CFrame.lookAt(mid, B)
        e.Color    = FacingCheck.Color
        e.Transparency = FacingCheck.Transparency
    end
end

RunService.RenderStepped:Connect(function()
    if FacingCheck.FollowPlayer then FacingUpdateVisual() end
end)

LP.CharacterRemoving:Connect(function()
    for _, e in ipairs(FacingEdges) do e.Transparency = 1 end
end)

LP.CharacterAdded:Connect(function()
    task.wait(0.2)
    FacingUpdateVisual()
end)

-- Point-in-oriented-box test in the player's facing frame
local function IsInsideFacingBox(worldPos)
    if not FacingCheck.DetectionEnabled then return false end
    local char = LP.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local lv = root.CFrame.LookVector
    local flat = Vector3.new(lv.X, 0, lv.Z)
    if flat.Magnitude < 0.01 then return false end
    flat = flat.Unit

    local right = Vector3.new(-flat.Z, 0, flat.X)
    local up    = Vector3.new(0, 1, 0)
    local center = root.Position + Vector3.new(0, FacingCheck.OffsetY, 0)
    local d = worldPos - center

    return math.abs(d:Dot(right)) <= FacingCheck.Width  / 2
       and math.abs(d:Dot(up))    <= FacingCheck.Height / 2
       and math.abs(d:Dot(flat))  <= FacingCheck.Length / 2
end

