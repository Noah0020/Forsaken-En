-- Identify the actual local killer model first, independently of toggle state.
-- IsDescendantOf is more tolerant than checking Parent == KillersFolder only.
function KillerParry.getKillerIdentity()
    local character = lp.Character
    if not character or not character:IsA("Model") then return nil end
    if not character:IsDescendantOf(KillersFolder) then return nil end

    -- A new killer character means a new round/character instance. Clear the
    -- previous instance's local cooldown so it cannot suppress the new round.
    if KillerParry.lastCharacter ~= character then
        KillerParry.lastCharacter = character
        KillerParry.lastUse.JohnDoe = nil
        KillerParry.lastUse.Slasher = nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return nil end

    local name = string.lower(tostring_ref(character.Name)):gsub("[^%w]", "")
    if name == "johndoe" then
        return character, "JohnDoe", "404Error", 20
    elseif name == "slasher" then
        return character, "Slasher", "RagingPace", 30
    end
    return nil
end

-- Return a killer only when its matching user toggle is enabled.
function KillerParry.getLocalKiller()
    local character, killerKey, abilityName, abilityCooldown = KillerParry.getKillerIdentity()
    if not character then return nil end

    if killerKey == "JohnDoe" and KillerParry.enabled404 then
        return character, killerKey, abilityName, abilityCooldown
    elseif killerKey == "Slasher" and KillerParry.enabledRaging then
        return character, killerKey, abilityName, abilityCooldown
    end
    return nil
end

-- This intentionally matches Auto Block's working call format. Do not send
-- the raw buffer used by the old Killer Parry implementation.
function KillerParry.fireAbility(abilityName)
    if type(abilityName) ~= "string" or abilityName == "" then return false end
    local remote = testRemote
    if not remote or not remote:IsA("RemoteEvent") then return false end

    local ok, err = pcall(function()
        remote:FireServer("UseActorAbility", { abilityName })
    end)
    if not ok then
        warn("[Bloodsaken] Killer Parry ability request failed: " .. tostring_ref(err))
    end
    return ok
end

function KillerParry.onTrack(survivorModel, track)
    if not track or KillerParry.seenTracks[track] then return end
    if not survivorModel or not survivorModel:IsA("Model")
        or not survivorModel:IsDescendantOf(SurvivorsFolder) then
        return
    end

    local animation = track.Animation
    local animationId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")
    if not animationId or not KillerParry.animsToDetect[animationId] then return end

    -- A survivor attack must be detected while the local player is actually
    -- John Doe or Slasher, with that character's own toggle enabled.
    local killerCharacter, killerKey, abilityName, abilityCooldown = KillerParry.getLocalKiller()
    if not killerCharacter then return end

    local killerRoot = killerCharacter:FindFirstChild("HumanoidRootPart")
        or killerCharacter:FindFirstChild("RootPart")
    local survivorRoot = survivorModel:FindFirstChild("HumanoidRootPart")
        or survivorModel:FindFirstChild("RootPart")
    if not killerRoot or not survivorRoot then return end

    local distance = (survivorRoot.Position - killerRoot.Position).Magnitude
    if distance > KillerParry.range then return end

    local now = os.clock()
    local lastUse = KillerParry.lastUse[killerKey]
    if lastUse and (now - lastUse) < abilityCooldown then return end

    -- Only consume the local cooldown after the RemoteEvent call succeeds.
    if KillerParry.fireAbility(abilityName) then
        KillerParry.seenTracks[track] = true
        KillerParry.lastUse[killerKey] = now
    end
end

function KillerParry.attachAnimator(animator, survivorModel)
    if not animator or not animator:IsA("Animator") then return end
    if KillerParry.animatorConnections[animator] then return end

    KillerParry.animatorConnections[animator] = animator.AnimationPlayed:Connect(function(track)
        KillerParry.onTrack(survivorModel, track)
    end)
end

function KillerParry.attachSurvivor(model)
    if not model or not model:IsA("Model") then return end
    if not model:IsDescendantOf(SurvivorsFolder) then return end
    if KillerParry.modelConnections[model] then return end

    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("Animator") then
            KillerParry.attachAnimator(descendant, model)
        end
    end

    KillerParry.modelConnections[model] = model.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Animator") then
            KillerParry.attachAnimator(descendant, model)
        end
    end)
end

function KillerParry.detachSurvivor(model)
    local modelConnection = KillerParry.modelConnections[model]
    if modelConnection then
        modelConnection:Disconnect()
        KillerParry.modelConnections[model] = nil
    end

    -- Disconnect animators belonging to a survivor model after it leaves the
    -- survivor folder so stale listeners do not build up between rounds.
    for _, descendant in ipairs(model:GetDescendants()) do
        local connection = KillerParry.animatorConnections[descendant]
        if connection then
            connection:Disconnect()
            KillerParry.animatorConnections[descendant] = nil
        end
    end
end

for _, survivor in ipairs(SurvivorsFolder:GetChildren()) do
    KillerParry.attachSurvivor(survivor)
end
SurvivorsFolder.ChildAdded:Connect(KillerParry.attachSurvivor)
SurvivorsFolder.ChildRemoved:Connect(KillerParry.detachSurvivor)

function KillerParry.updateVisual()
    if not KillerParry.showRange then
        if KillerParry.visual then
            pcall(function() KillerParry.visual:Destroy() end)
            KillerParry.visual = nil
        end
        return
    end

    local killerCharacter = KillerParry.getKillerIdentity()
    local killerRoot = killerCharacter and (killerCharacter:FindFirstChild("HumanoidRootPart")
        or killerCharacter:FindFirstChild("RootPart")) or nil
    if not killerRoot then
        if KillerParry.visual then
            pcall(function() KillerParry.visual:Destroy() end)
            KillerParry.visual = nil
        end
        return
    end

    if not KillerParry.visual or KillerParry.visual.Parent ~= killerRoot then
        if KillerParry.visual then
            pcall(function() KillerParry.visual:Destroy() end)
        end
        local ok, adornment = pcall(function()
            return Instance.new("CylinderHandleAdornment")
        end)
        if not ok or not adornment then
            KillerParry.visual = nil
            return
        end

        KillerParry.visual = adornment
        adornment.Name = "BloodsakenKillerParryRadius"
        adornment.Adornee = killerRoot
        adornment.Color3 = Color3.fromRGB(255, 65, 80)
        adornment.Transparency = 0.55
        adornment.AlwaysOnTop = true
        adornment.Height = 0.08
        adornment.Parent = killerRoot
    end

    pcall(function()
        KillerParry.visual.Radius = KillerParry.range
        KillerParry.visual.CFrame = CFrame.new(0, -(killerRoot.Size.Y * 0.5 + 0.08), 0)
    end)
end

KillerParry.visualConnection = RunService.Heartbeat:Connect(KillerParry.updateVisual)
