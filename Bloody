-- Killer-specific M1 tracker. This listens for the killer's replicated animation start,
-- which normally arrives before the associated attack sound. It cannot observe
-- the remote player's physical input before the server replicates the attack.
local M1_COOLDOWNS = {
    slasher = 1.9,
    c00lkidd = 2.0,
    johndoe = 2.0,
    ["1x1x1x1"] = 2.0,
    nosferatu = 2.0,
    noli = 1.875, -- midpoint of the supplied 1.75-2.0s range
    azure = 1.8,
    guest666 = 2.0,
    guest666_eviscerate = 8.0, -- 8s if used; landed-hit reduction needs hit confirmation
}

local M1_TYPES_BY_KILLER = {
    -- Only Slasher, John Doe and 1x1x1x1 use Slash as their ordinary M1.
    slasher = { slash = true, enragedslash = true },
    c00lkidd = { tag = true },
    johndoe = { slash = true },
    ["1x1x1x1"] = { slash = true },
    nosferatu = { lacerate = true, laceration = true },
    noli = { stab = true },
    azure = { perforating = true },
    -- Guest 666's Carving Slash is the M1. Eviscerate is also explicitly
    -- blockable, but is tracked as a separate attack with its own cooldown.
    guest666 = { carvingslash = true, g666slash = true, guestm1 = true, eviscerate = true },
}

local function normalizeM1Token(value)
    return string.lower(tostring_ref(value or "")):gsub("[^%w]", "")
end

local function getKillerM1Key(killer)
    if not killer then return nil end
    local names = {
        killer.Name,
        killer:GetAttribute("KillerName"),
        killer:GetAttribute("CharacterName"),
    }
    for _, name in ipairs(names) do
        local key = normalizeM1Token(name)
        if key == "slasher" or key == "c00lkidd" or key == "johndoe"
            or key == "1x1x1x1" or key == "nosferatu" or key == "noli"
            or key == "azure" or key == "guest666" then
            return key
        end
    end
    return nil
end

local function isSlasherEnraged(killer)
    if not killer then return false end
    for name, value in pairs(killer:GetAttributes()) do
        local key = normalizeM1Token(name)
        if (key == "enraged" or key == "ragingpace" or key == "isenraged") then
            if value == true or (type(value) == "number" and value > 0) then return true end
            if type(value) == "string" and value ~= "" and value ~= "false" then return true end
        end
    end
    -- Some builds expose the state as a BoolValue rather than an attribute.
    for _, child in ipairs(killer:GetChildren()) do
        local key = normalizeM1Token(child.Name)
        if key == "enraged" or key == "ragingpace" or key == "isenraged" then
            if child:IsA("BoolValue") and child.Value then return true end
            if child:IsA("NumberValue") and child.Value > 0 then return true end
        end
    end
    return false
end

local function getM1Cooldown(killer, killerKey, attackType)
    if killerKey == "slasher" and attackType == "enragedslash" then
        return 0.9 -- supplied Raging Pace range: 0.8-1.0s
    end
    if killerKey == "guest666" and attackType == "eviscerate" then
        return M1_COOLDOWNS.guest666_eviscerate
    end
    return M1_COOLDOWNS[killerKey] or 2.0
end

local function getM1AnimationType(killer, track)
    if not track then return nil end
    local killerKey = getKillerM1Key(killer)
    local allowed = killerKey and M1_TYPES_BY_KILLER[killerKey]
    if not allowed then return nil end

    local animation = track.Animation
    local candidates = {
        track.Name,
        animation and animation.Name,
        track:GetAttribute("AbilityName"),
        animation and animation:GetAttribute("AbilityName"),
        track:GetAttribute("AnimationType"),
        animation and animation:GetAttribute("AnimationType"),
    }
    for _, candidate in ipairs(candidates) do
        local token = normalizeM1Token(candidate)
        if token ~= "" then
            -- Exact killer-specific names prevent unrelated abilities from
            -- triggering another killer's M1 classification.
            if killerKey == "c00lkidd" and (token == "tag" or token == "coolkidm1nm") then
                return "tag", killerKey
            elseif killerKey == "nosferatu" and (token == "lacerate" or token == "laceration") then
                return "lacerate", killerKey
            elseif killerKey == "noli" and token == "stab" then
                return "stab", killerKey
            elseif killerKey == "azure" and token == "perforating" then
                return "perforating", killerKey
            elseif killerKey == "guest666" then
                if token == "eviscerate" then return "eviscerate", killerKey end
                if token == "carvingslash" or token == "g666slash" or token == "guestm1" then
                    return "carvingslash", killerKey
                end
            elseif killerKey == "slasher" and token == "enragedslash" then
                return "enragedslash", killerKey
            elseif allowed[token] then
                return token, killerKey
            end
        end
    end

    -- Resolve generic Roblox track names through the game's Config animation
    -- index. This is essential when Animation.Name is only "Animation".
    local animId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")
    local mappedM1 = animId and m1AnimationTypeById[animId]
    if mappedM1 then
        if allowed[mappedM1] then return mappedM1, killerKey end
        -- A config can expose CoolkidM1NM as the ID key even if the display
        -- name says Tag, and vice versa.
        if killerKey == "c00lkidd" and mappedM1 == "coolkidm1nm" then return "tag", killerKey end
        if killerKey == "guest666" and (mappedM1 == "g666slash" or mappedM1 == "guestm1") then
            return "carvingslash", killerKey
        end
    end
    return nil
end

local function tryBlockFromM1Animation(killer, track)
    if Settings.AutoBlockDetection ~= "Killer M1 Tracker" then return end
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not killer or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    local m1Type, killerKey = getM1AnimationType(killer, track)
    if not m1Type or not killerKey then return end

    local now = tick()
    local cooldown = getM1Cooldown(killer, killerKey, m1Type)
    local perKiller = AB.m1LastAt[killer]
    if not perKiller then
        perKiller = {}
        AB.m1LastAt[killer] = perKiller
    end
    local previous = perKiller[m1Type] or 0
    if now - previous < cooldown then return end
    -- Track each attack type independently so Guest 666's Eviscerate does not
    -- suppress their ordinary Carving Slash M1 (or vice versa).
    perKiller[m1Type] = now

    if not IsPlayerInFacingZone(killer) then return end
    if now - AB.blueDebounce < 0.08 then return end
    AB.blueDebounce = now
    FireAbilityByMode()
end

local function tryBlockFromRegularSignal(killer)
    if Settings.AutoBlockDetection ~= "Regular (Sound + Animation IDs)" then return end
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not killer or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    if not IsPlayerInFacingZone(killer) then return end
    local now = tick()
    if now - AB.blueDebounce < 0.12 then return end
    AB.blueDebounce = now
    FireAbilityByMode()
end

local function isKnownRegularM1Sound(sound)
    if not sound or not sound:IsA("Sound") then return false end
    local sid = sound.SoundId
    if not sid or sid == "" then return false end
    local id = string_match(sid, "%d+")
    return M1_Sounds[sid] == true or (id and (M1_Sounds[id] == true or M1_Sounds["rbxassetid://" .. id] == true)) or false
end

local monitoredM1Sounds = setmetatable({}, { __mode = "k" })
local function monitorRegularM1Sound(killer, sound)
    if not sound or not sound:IsA("Sound") or monitoredM1Sounds[sound] then return end
    monitoredM1Sounds[sound] = true
    local connection = sound.Played:Connect(function()
        if isKnownRegularM1Sound(sound) then tryBlockFromRegularSignal(killer) end
    end)
    table.insert(AB.connections, connection)
end

local function MonitorKillerSound(killer)
    if not killer then return end
    for _, descendant in ipairs(killer:GetDescendants()) do
        if descendant:IsA("Sound") then monitorRegularM1Sound(killer, descendant) end
    end
    table.insert(AB.connections, killer.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Sound") then monitorRegularM1Sound(killer, descendant) end
    end))
end

local function MonitorKillerM1(killer)
    if not killer then return end
    local function connectAnimator(animator)
        if not animator or not animator:IsA("Animator") then return end
        local connection = animator.AnimationPlayed:Connect(function(track)
            if Settings.AutoBlockDetection == "Killer M1 Tracker" then
                tryBlockFromM1Animation(killer, track)
            elseif Settings.AutoBlockDetection == "Regular (Sound + Animation IDs)" then
                local animation = track and track.Animation
                local animId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")
                if animId and m1AnimationTypeById[animId] then
                    tryBlockFromRegularSignal(killer)
                end
            end
        end)
        table.insert(AB.connections, connection)
    end
    for _, descendant in ipairs(killer:GetDescendants()) do
        if descendant:IsA("Animator") then connectAnimator(descendant) end
    end
    table.insert(AB.connections, killer.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Animator") then connectAnimator(descendant) end
    end))
end

