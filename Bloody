    f.Name = "GS_FacingRadar"
    f.Parent = Workspace
    FCState.folder = f
    return f
end

local function FC_NormalizeName(name)
    return tostring(name or ""):lower():gsub("[%s_%-]", "")
end

local function FC_GetReach(killer, speed)
    local key = FC_NormalizeName(killer and killer.Name)
    local profileKey = FC_ReachProfiles[key]
    local reach = profileKey and (tonumber(Settings[profileKey]) or Settings.FC_DefaultReach) or Settings.FC_DefaultReach
    if key == "slasher" and killer then
        local enraged = killer:GetAttribute("Enraged") or killer:GetAttribute("IsEnraged") or killer:GetAttribute("RageActive")
        if enraged == true then reach = tonumber(Settings.FC_Reach_SlasherEnraged) or 19 end
    elseif key == "azure" and killer then
        local golem = killer:GetAttribute("Golem") or killer:GetAttribute("IsGolem") or killer:GetAttribute("GolemForm")
        if golem == true then reach = tonumber(Settings.FC_Reach_AzureGolem) or 10 end
    end
    if speed >= Settings.FC_RunThreshold then
        reach = reach * Settings.FC_RunMultiplier
    end
    return math.min(reach, Settings.FC_Range)
end

