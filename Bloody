-- TWO TIME BACKSTAB
--═══════════════════════════════════════════════════════════════════
do
    local BS = {
        enabled = false,
        duration = 0.35,
        behind = 3,
        method = "Lerp",
    }
    local IDS = {
        ["100725497418533"] = true,
        ["89448354637442"] = true,
        ["106086955212611"] = true,
        ["107640065977686"] = true,
    }

    local function doStab()
        if not BS.enabled or IsPlayerKiller() then return end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local k = GetNearestKiller(40)
        local kr = k and k:FindFirstChild("HumanoidRootPart")
        if not hrp or not kr then return end
        local start = tick()
        while tick() - start < BS.duration do
            if not hrp.Parent or not kr.Parent then break end
            local goal = kr.CFrame * CFrame.new(0, 0, BS.behind)
            if BS.method == "Teleport" then
                hrp.CFrame = goal
            else
                hrp.CFrame = hrp.CFrame:Lerp(goal, 0.35)
            end
            RunService.RenderStepped:Wait()
        end
    end

    local function hookChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 6)
            if not hum then return end
            local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
            if not anim then return end
            anim.AnimationPlayed:Connect(function(track)
                if not BS.enabled then return end
                local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                if id and IDS[id] then
                    task.spawn(doStab)
                end
            end)
        end)
    end
    if LP.Character then hookChar(LP.Character) end
    LP.CharacterAdded:Connect(hookChar)

    local left = Tabs.Stab:AddLeftGroupbox("Auto Backstab")
    left:AddToggle("BS_Enable", {
        Text = "Enable Auto Backstab",
        Default = false,
        Callback = function(v) BS.enabled = v end,
    })
    left:AddDropdown("BS_Method", {
        Values = { "Lerp", "Teleport" },
        Default = 1,
        Text = "Method",
        Callback = function(v) BS.method = v end,
    })
    left:AddSlider("BS_Dur", {
        Text = "Duration", Default = 0.35, Min = 0.1, Max = 1.5, Rounding = 2,
        Callback = function(v) BS.duration = v end,
    })
    left:AddSlider("BS_Behind", {
        Text = "Behind Studs", Default = 3, Min = 1, Max = 10, Rounding = 1,
        Callback = function(v) BS.behind = v end,
    })
end

