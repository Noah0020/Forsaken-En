local function ResolveNetwork()
    if NetworkEvent and NetworkEvent.Parent then return NetworkEvent end
    local ok, res = pcall(function()
        local m = ReplicatedStorage:FindFirstChild("Modules")
        if m then
            local n = m:FindFirstChild("Network", true)
            if n then
                local re = n:FindFirstChild("RemoteEvent") or n:FindFirstChildWhichIsA("RemoteEvent", true)
                if re then return re end
            end
        end
        return ReplicatedStorage:FindFirstChild("RemoteEvent", true)
            or ReplicatedStorage:FindFirstChildWhichIsA("RemoteEvent", true)
    end)
    if ok and res then NetworkEvent = res end
    return NetworkEvent
end
