		local hum = inst:FindFirstChildOfClass("Humanoid")
		if hum then
			TL.Text = inst.Name .. " | " .. math.floor(hum.Health) .. "HP"
			local c; c = hum.HealthChanged:Connect(function(h)
				if not BG or not TL then c:Disconnect(); return end
				TL.Text = inst.Name .. " | " .. math.floor(h) .. "HP"
			end)
		end
		local c2; c2 = BG.AncestryChanged:Connect(function(_, parent)
			if parent == Ragdolls then BG:Destroy(); c2:Disconnect() end
		end)
	elseif espType == "generator" then
		BG.Parent = inst
		local nv = inst:FindFirstChildOfClass("NumberValue")
		TL.Text = inst.Name .. " | " .. math.floor(nv.Value) .. "%"
		local c; c = nv.Changed:Connect(function(val)
			if nv and BG and TL then TL.Text = inst.Name .. " | " .. math.floor(val) .. "%" else c:Disconnect() end
		end)
	elseif espType == "item" then
		BG.Parent = inst
		TL.Text   = inst.Name
	else
		BG.Parent = espType ~= "spray" and inst or inst:FindFirstChildOfClass("BasePart")
