local netHook = {Tasks={},originals={}}
if caps.requiring then
    netHook.AddTask = function(self,n,f) self.Tasks[n]=f end
    netHook.RemoveTask = function(self,n) self.Tasks[n]=nil end
    netHook.ExecuteTasks = function(self,args)
        local exit = false
        for _,fn in pairs(self.Tasks) do
            local _,r = xpcall(fn, function(e) task.spawn(logError,e,1803) end, args)
            if r=="exit" then exit=true end end
        return exit
    end
    for k,v in pairs(Network) do netHook.originals[k]=v end
    for k in pairs(Network) do
        Network[k] = function(...)
            local a = {...}
            if netHook:ExecuteTasks(a) then return end
            return netHook.originals[k](table.unpack(a)) end
    end
end

local nameHook = {Tasks={}}
if caps.hooking then
    nameHook.AddTask = function(self,n,f) self.Tasks[n]=f end
    nameHook.RemoveTask = function(self,n) self.Tasks[n]=nil end
    nameHook.ExecuteTasks = function(...)
        for _,fn in pairs(self.Tasks) do
            local _,r = xpcall(fn, function(e) task.spawn(logError,e,1858) end, select(2,...))
            if r=="exit" then return true end end
    end
    local mt = getrawmetatable(game); local old = mt.__namecall
    setreadonly(mt,false)
    mt.__namecall = newcclosure(function(self,...)
        if nameHook:ExecuteTasks(self,...) then return end
        return old(self,...) end)
    setreadonly(mt,true)
end

