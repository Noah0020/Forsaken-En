local function GetTargetFolder()
    local char = LocalPlayer.Character
    if not char then return nil end
    local players = Workspace:FindFirstChild("Players")
    if not players then return nil end
    local kf = players:FindFirstChild("Killers")
    local sf = players:FindFirstChild("Survivors")
    if kf and (char:IsDescendantOf(kf) or char.Parent == kf) then return sf end
    if sf and (char:IsDescendantOf(sf) or char.Parent == sf) then return kf end
    if kf and #kf:GetChildren() > 0 then return kf end
    if sf and #sf:GetChildren() > 0 then return sf end
    return nil
end

local targetVelCache = {}
local function GetTargetVelocity(hrp)
    local now = os.clock()
    local cached = targetVelCache[hrp]
    local v = hrp.AssemblyLinearVelocity
    if v and v.Magnitude > 5 then
        targetVelCache[hrp] = { pos = hrp.Position, time = now }
        return v
    end
    if cached and (now - cached.time) > 0.01 then
        local computed = (hrp.Position - cached.pos) / (now - cached.time)
        targetVelCache[hrp] = { pos = hrp.Position, time = now }
        return computed
    end
    targetVelCache[hrp] = { pos = hrp.Position, time = now }
    return Vector3.zero
end

local function GetPredictedTarget(maxRange, minDist, prediction)
    local char = LocalPlayer.Character
    if not char then return nil end
    local folder = GetTargetFolder()
    if not folder then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local bestHrp, bestDist = nil, maxRange
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= char then
            local mHrp = model:FindFirstChild("HumanoidRootPart")
            local mHum = model:FindFirstChildOfClass("Humanoid")
            if mHrp and mHum and mHum.Health > 0 then
                local d = (mHrp.Position - hrp.Position).Magnitude
                if d < bestDist and d >= minDist then bestHrp, bestDist = mHrp, d end
            end
        end
    end
    if not bestHrp then return nil end
    local vel = GetTargetVelocity(bestHrp)
    if vel.Magnitude > 60 then vel = vel.Unit * 60 end
    local lead = math.clamp(prediction or 4, 1, 10) * 0.1
    return bestHrp.Position + vel * lead
end

