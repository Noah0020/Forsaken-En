-- TWO TIMES (FlexSaken-style TP + Auto Backstab)
--══════════════════════════════════════════════════════════════
local ABTP = {
    enabled = false,
    daggerEnabled = true,
    aimingEnabled = true,
    directBehind = false,
    rangeMode = "Behind", -- Around | Behind
    backstabType = "teleport", -- lerp | teleport | face
    lerpSpeed = 0.4,
    behindDist = 1.8,
    range = 10,
    duration = 0.65,
    delayBeforeStab = 0.08,
    cooldown = 4,
    lastTrigger = 0,
    killerTrack = {},
}

local function isTwoTime(char)
    return char and string.find(char.Name or "", "TwoTime") ~= nil
end

RunService.Heartbeat:Connect(function()
    if not KillersFolder then return end
    local now = os.clock()
    for _, killer in pairs(KillersFolder:GetChildren()) do
        local khrp = killer:FindFirstChild("HumanoidRootPart")
        if khrp then
            local st = ABTP.killerTrack[khrp]
            local pos, look = khrp.Position, khrp.CFrame.LookVector
            if st and st.t and st.pos then
                local dtS = now - st.t
                if dtS > 0 then
                    local vel = (pos - st.pos) / dtS
                    local sv = st.vel and st.vel:Lerp(vel, math.clamp(dtS * 10, 0, 1)) or vel
                    ABTP.killerTrack[khrp] = {pos = pos, look = look, vel = sv, t = now}
                end
            else
                ABTP.killerTrack[khrp] = {pos = pos, look = look, vel = Vector3.zero, t = now}
            end
        end
    end
end)

local function ABTP_activate(killer, duration)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local khrp = killer and killer:FindFirstChild("HumanoidRootPart")
    if not hrp or not khrp then return end

    local function computeCF()
        local look = khrp.CFrame.LookVector
        local behindPos = khrp.Position - look * ABTP.behindDist
        return CFrame.new(behindPos, khrp.Position)
    end

    if ABTP.backstabType == "teleport" then
        pcall(function() hrp.CFrame = computeCF() end)
        if ABTP.daggerEnabled then
            task.delay(ABTP.delayBeforeStab, function()
                FireAbility("Stab"); FireAbility("Backstab"); FireAbility("Dagger")
            end)
        end
    elseif ABTP.backstabType == "lerp" then
        local t0 = os.clock()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if os.clock() - t0 >= (duration or ABTP.duration) then
                if conn then conn:Disconnect() end
                if ABTP.daggerEnabled then
                    FireAbility("Stab"); FireAbility("Backstab"); FireAbility("Dagger")
                end
                return
            end
            if not khrp or not hrp then return end
            pcall(function()
                hrp.CFrame = hrp.CFrame:Lerp(computeCF(), ABTP.lerpSpeed)
            end)
        end)
    else -- face
        local t0 = os.clock()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if os.clock() - t0 >= (duration or ABTP.duration) then
                if conn then conn:Disconnect() end
                return
            end
            if not khrp or not hrp then return end
            local lv = khrp.CFrame.LookVector
            pcall(function() hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + lv) end)
        end)
        if ABTP.daggerEnabled then
            task.delay(ABTP.delayBeforeStab, function()
                FireAbility("Stab"); FireAbility("Backstab")
            end)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.12)
        if not ABTP.enabled then continue end
        if not isTwoTime(LocalPlayer.Character) then continue end
        if not KillersFolder then continue end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        for _, killer in pairs(KillersFolder:GetChildren()) do
            if not killer:IsA("Model") then continue end
            local khrp = killer:FindFirstChild("HumanoidRootPart")
            if not khrp then continue end
            local dist = (khrp.Position - hrp.Position).Magnitude
            local should = false
            if ABTP.rangeMode == "Around" then
                should = dist <= ABTP.range
            else
                local rel = hrp.Position - khrp.Position
                local fwdDot = rel:Dot(khrp.CFrame.LookVector)
                local behindDist = -fwdDot
                local angleDot = rel.Magnitude > 0 and rel.Unit:Dot(khrp.CFrame.LookVector) or 0
                local passed = ABTP.directBehind and angleDot <= -0.85 or fwdDot < 0.3
                should = passed and behindDist <= ABTP.range and dist <= ABTP.range
            end
            if should and os.clock() - ABTP.lastTrigger >= ABTP.cooldown then
                ABTP.lastTrigger = os.clock()
                task.spawn(ABTP_activate, killer, ABTP.duration)
                break
            end
        end
    end
end)

local function setTwoTimeBackstab(on)
    ABTP.enabled = on
    Notify(on and "Two Time TP Backstab ON" or "Two Time TP Backstab OFF")
end

