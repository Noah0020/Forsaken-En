        sCol = Color3.fromRGB(80, 255, 120),
        gCol = Color3.fromRGB(255, 220, 60),
        iCol = Color3.fromRGB(120, 180, 255),
    }
    local function setHL(model, name, col, enabled)
        local h = model:FindFirstChild(name)
        if not enabled then
            if h then h:Destroy() end
            return
        end
        if not h then
            h = Instance.new("Highlight")
            h.Name = name
            h.Adornee = model
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.FillTransparency = 0.55
            h.OutlineTransparency = 0.15
            h.Parent = model
        end
        h.FillColor = col
        h.OutlineColor = col
    end
    local function refresh()
        local pf = Workspace:FindFirstChild("Players")
        local killers = pf and pf:FindFirstChild("Killers")
        local survivors = pf and pf:FindFirstChild("Survivors")
        if killers then
            for _, k in ipairs(killers:GetChildren()) do
                if k:IsA("Model") then setHL(k, "Nos_ESP_Killer", E.kCol, E.killer) end
            end
        end
        if survivors then
            for _, s in ipairs(survivors:GetChildren()) do
                if s:IsA("Model") and s ~= LP.Character then
                    setHL(s, "Nos_ESP_Survivor", E.sCol, E.survivor)
                end
            end
        end
        if E.generator or E.item then
            local map = Workspace:FindFirstChild("Map")
            local root = map and (map:FindFirstChild("Ingame") or map) or Workspace
            for _, obj in ipairs(root:GetDescendants()) do
