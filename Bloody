local function NS_UpdateHitboxVisuals()
    if not Settings.AutoBlockRectangle or not Settings.ShowHitboxVisual or KillerState.isKiller then
        NS_ClearHitboxVisuals()
        return
    end

    local playersFolder = Workspace:FindFirstChild("Players")
    local killersFolder = playersFolder and playersFolder:FindFirstChild("Killers")
    if not killersFolder then
        NS_ClearHitboxVisuals()
        return
    end

    local active = {}
    local multiplier = math.clamp(tonumber(Settings.HitboxMultiplier or Settings.RectangleMultiplier) or 1, 0.1, 5)
    local fillTransparency = math.clamp(tonumber(Settings.HitboxTransparency) or 0.64, 0, 0.95)
    local outlineTransparency = math.clamp(tonumber(Settings.OutlineTransparency) or 0.12, 0, 1)
    local boxColor = ParseColor(Settings.HitboxColor, 255, 170, 55)

    for _, killer in ipairs(killersFolder:GetChildren()) do
        if killer:IsA("Model") then
            local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart")
            if root and root:IsA("BasePart") then
                local config = NS_getKillerHitbox(killer.Name)
                local width = (config.width or 6) * multiplier
                local height = (config.height or 6) * multiplier
                local length = (config.length or 9) * multiplier
                local distance = tonumber(config.distance or Settings.HitboxDistance or Settings.RectangleDistance) or 3
                local part = NS_GetOrCreateHitboxVisual(killer)
                part.Size = Vector3.new(width, height, length)
                part.CFrame = root.CFrame * CFrame.new(0, 0, -distance)
                part.Color = boxColor
                part.Transparency = fillTransparency

                local outline = part:FindFirstChild("Doggysaken_HitboxOutline")
                if outline then
                    outline.Color3 = boxColor
                    outline.Transparency = outlineTransparency
                    outline.Visible = Settings.ShowOutline == true
                end
                active[killer] = true
            end
        end
    end

    for killer, part in pairs(NS_visualParts) do
        if not active[killer] then
            if part then pcall(function() part:Destroy() end) end
            NS_visualParts[killer] = nil
        end
    end
end

