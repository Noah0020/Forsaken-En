--═══════════════════════════════════════════════════════════════════
-- FIXED VELOCITY TRACKING
--═══════════════════════════════════════════════════════════════════
local _velHistoryByHrp = setmetatable({}, {__mode = "k"})
local _VEL_SMOOTH = 6

local function getHRPVelocity(hrp)
    if not hrp or not hrp.Parent then return Vector3.zero end
    local now = tick()
    local data = _velHistoryByHrp[hrp]
    if not data then
        _velHistoryByHrp[hrp] = {
            lastPos = hrp.Position, lastTime = now,
            velocity = Vector3.zero, samples = {}
        }
        return Vector3.zero
    end
    local dt = now - data.lastTime
    if dt > 0.001 then
        local instVel = (hrp.Position - data.lastPos) / dt
        table.insert(data.samples, instVel)
        if #data.samples > _VEL_SMOOTH then table.remove(data.samples, 1) end
        local sum = Vector3.zero
        for _, v in ipairs(data.samples) do sum = sum + v end
        data.velocity = sum / #data.samples
        data.lastPos = hrp.Position
        data.lastTime = now
    end
    return data.velocity
end

local function predictHRP(hrp, lead)
    if not hrp then return nil end
    local pos = hrp.Position
    local vel = getHRPVelocity(hrp)
    if vel.Magnitude < 0.5 then return pos end
    return pos + vel * (lead or 0.2)
end

