        Callback = function(v) E.survivor = v; refresh() end,
    })
    left:AddToggle("ESP_G", {
        Text = "ESP Generators", Default = false,
        Callback = function(v) E.generator = v; refresh() end,
    })
    left:AddToggle("ESP_I", {
