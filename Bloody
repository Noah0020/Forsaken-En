    color = Color3.fromRGB(220, 40, 50),
    transparency = 0.35,
    last = 0,
    useAudio = true,
    useAnim = true,
}

-- Guesting-style sound/anim detection maps (subset)
local SOUND_IDS = {
    ["74809026448465"]=true,["85853080745515"]=true,["95079963655241"]=true,
    ["98111231282218"]=true,["101199185291628"]=true,["115026634746636"]=true,
    ["133709029886490"]=true,["86174610237192"]=true,["98675142200448"]=true,
    ["89004992452376"]=true,["96117920303138"]=true,["104910828105172"]=true,
    ["71805956520207"]=true,["74842815979546"]=true,["75330693422988"]=true,
    ["79391273191671"]=true,["80516583309685"]=true,
}
local SLASHER_ANIMS = {
    ["94958041603347"]=true,["106860049270347"]=true,["108196996477620"]=true,
    ["109667959938617"]=true,["118298475669935"]=true,["125403313786645"]=true,
}

local pending = {} -- [killerModel] = expiry

local function spawnBlockBox(killer)
    if IsPlayerKiller() or not killer then return end
    local root = killer:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local now = tick()
    if now - AB.last < 0.05 then return end
    AB.last = now

    task.spawn(function()
        local elapsed = 0
        local duration = math.clamp(AB.duration, 0.1, 1)
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        op.FilterDescendantsInstances = { killer }

        while killer.Parent and root.Parent and elapsed < duration do
            if not AB.enabled or IsPlayerKiller() then return end
            local part = Instance.new("Part")
            part.Name = "Nos_BlockBox"
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = true
            part.CastShadow = false
            part.Material = Enum.Material.ForceField
            part.Color = AB.color
            part.Transparency = AB.showVisual and AB.transparency or 1
            part.Size = Vector3.new(AB.width, AB.height, AB.length)
            part.CFrame = root.CFrame * CFrame.new(0, 0, AB.offset)
            part.Parent = Workspace
            if AB.showVisual then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = part
                sb.Color3 = AB.color
                sb.LineThickness = 0.05
                sb.Parent = part
            end
            Debris:AddItem(part, 0.06)

            for _, hit in ipairs(Workspace:GetPartsInPart(part, op)) do
                local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    if AB.delay > 0 then task.wait(AB.delay) end
                    FireBlock()
                    if HDT.enabled then RunHDT() end
                    return
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

local function markKiller(killer, timer)
    if not killer or killer == LP.Character then return end
    pending[killer] = os.clock() + (timer or 0.32)
end

-- Attribute-based detection
local monitored = {}
local function monitorKiller(k)
    if not k or monitored[k] or not k:IsA("Model") then return end
    monitored[k] = true
    local lastAbility = k:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = k:GetAttribute("AbilitiesUsed") or 0
    k:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not AB.enabled or IsPlayerKiller() then return end
        local cur = k:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local curU = k:GetAttribute("AbilitiesUsed") or 0
        if curU > lastUsed then lastUsed = curU; return end
        spawnBlockBox(k)
    end)
end

-- Sound detection
local function hookSound(snd, model)
    if not snd or not snd:IsA("Sound") then return end
    local id = tostring(snd.SoundId):match("%d+")
    if not id or not SOUND_IDS[id] then return end
    local function fire()
        if not AB.enabled or not AB.useAudio or IsPlayerKiller() then return end
        local k = model
        if not k then
            k = snd:FindFirstAncestorOfClass("Model")
        end
        if k then markKiller(k, 0.32); spawnBlockBox(k) end
    end
    pcall(function() snd.Played:Connect(fire) end)
    if snd.IsPlaying then task.defer(fire) end
end

-- Animation detection for slashers
local function hookKillerAnim(model)
    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
        if not anim then return end
        anim.AnimationPlayed:Connect(function(track)
            if not AB.enabled or not AB.useAnim or IsPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if id and SLASHER_ANIMS[id] then
                markKiller(model, 0.32)
                spawnBlockBox(model)
            end
        end)
    end)
end

task.spawn(function()
    while true do
        task.wait(1)
        if AB.enabled and not IsPlayerKiller() then
            for _, k in ipairs(GetKillersList()) do
                monitorKiller(k)
                if not monitored[k .. "_anim"] then
                    monitored[k .. "_anim"] = true
                    hookKillerAnim(k)
                end
                for _, d in ipairs(k:GetDescendants()) do
                    if d:IsA("Sound") then hookSound(d, k) end
                end
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(obj)
    if not AB.enabled then return end
    if obj:IsA("Sound") then
        local m = obj:FindFirstAncestorOfClass("Model")
        task.defer(function() hookSound(obj, m) end)
    end
end)

