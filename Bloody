            end
            SyncAimbot(tRoot, cfg.LockDuration or 1)
        end
    end

    local function tryTrack(track)
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId):match("%d+")
        if not id then return end
        for modeKey, idMap in pairs(getgenv().AnimationData) do
            local cfg = getgenv().AimbotValues[modeKey]
