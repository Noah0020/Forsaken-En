local VeerState = { atRunning=false, atMonitors={}, atConn=nil, atRetry=nil }
local function VeerGetSprintBtn()
    local ui = LocalPlayer:FindFirstChild("PlayerGui"); if not ui then return nil end
    local m = ui:FindFirstChild("MainUI"); if not m then return nil end
    return m:FindFirstChild("SprintingButton", true)
end
local function VeerTriggerSprint()
    local fired = false
    pcall(function()
        local btn = VeerGetSprintBtn(); if not btn then return end
        if getconnections and btn.MouseButton1Down then
            local cok, conns = pcall(getconnections, btn.MouseButton1Down)
            if cok and conns then
                for _, c in pairs(conns) do
                    local fok = pcall(function() c.Function() end)
                    if not fok then fok = pcall(function() c:Fire() end) end
                    if fok then fired = true; break end
                end
            end
        end
        if fired then return end
        if pcall(function() btn:Activate() end) then fired = true; return end
        pcall(function()
            local V = VirtualInputManager
            if V and V.SendMouseButtonEvent then
                local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
                V:SendMouseButtonEvent(x, y, 0, true, game, 1)
                task.wait(0.03)
                V:SendMouseButtonEvent(x, y, 0, false, game, 1)
            end
        end)
    end)
    return fired
end
local function VeerATGetFolder()
    local a = ReplicatedStorage:FindFirstChild("Assets"); if not a then return nil end
    local s = a:FindFirstChild("Survivors"); if not s then return nil end
    local v = s:FindFirstChild("Veeronica"); if not v then return nil end
    return v:FindFirstChild("Behavior")
end
local function VeerATMonitor(h)
    if not h or VeerState.atMonitors[h] then return end
    local conns, prev = {}, false
    local function check()
        if not VeerState.atRunning then return end
        if not h.Parent then
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            VeerState.atMonitors[h] = nil
            return
        end
        local ad = h.Adornee
        local ch = LocalPlayer.Character
        local cur = (ad and ch and (ad == ch or ad:IsDescendantOf(ch))) and true or false
        if cur and not prev then pcall(VeerTriggerSprint) end
        prev = cur
    end
    pcall(function() table.insert(conns, h:GetPropertyChangedSignal("Adornee"):Connect(check)) end)
    pcall(function() table.insert(conns, h.AncestryChanged:Connect(check)) end)
    VeerState.atMonitors[h] = conns
    task.spawn(check)
end
local function VeerATAttach(f)
    if not f then return false end
    for _, o in ipairs(f:GetDescendants()) do
        if o:IsA("Highlight") then pcall(VeerATMonitor, o) end
    end
    if not VeerState.atConn then
        local ok, conn = pcall(function()
            return f.DescendantAdded:Connect(function(c) if c:IsA("Highlight") then pcall(VeerATMonitor, c) end end)
        end)
        if ok and conn then VeerState.atConn = conn end
    end
    return true
end
local function VeerATStart()
    if VeerState.atRunning then return end
    VeerState.atRunning = true
    VeerATAttach(VeerATGetFolder())
    VeerState.atRetry = task.spawn(function()
        while VeerState.atRunning do
            task.wait(3)
            if not VeerState.atRunning then break end
            VeerATAttach(VeerATGetFolder())
        end
    end)
end
local function VeerATStop()
    if not VeerState.atRunning then return end
    VeerState.atRunning = false
    if VeerState.atConn then pcall(function() VeerState.atConn:Disconnect() end); VeerState.atConn = nil end
    if VeerState.atRetry then pcall(task.cancel, VeerState.atRetry); VeerState.atRetry = nil end
    for _, conns in pairs(VeerState.atMonitors) do
        if type(conns) == "table" then
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        end
    end
    VeerState.atMonitors = {}
end

