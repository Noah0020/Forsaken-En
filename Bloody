--═══════════════════════════════════════════════════════════════════
local AutoPunch = { enabled = false, delay = 0.45 }

local function FirePunch()
    local re = getRE()
    if not re then return end
    pcall(function() re:FireServer("UseActorAbility", { "Punch" }) end)
end

local function FireBlock()
    if IsPlayerKiller() then return end
    local re = getRE()
    if not re then return end
    pcall(function()
        re:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0Block") })
    end)
    pcall(function()
        re:FireServer("UseActorAbility", { "Block" })
    end)
    if HDT.enabled then RunHDT() end
    if AutoPunch.enabled then
        task.delay(AutoPunch.delay, function()
            if not IsPlayerKiller() then FirePunch() end
        end)
    end
end

