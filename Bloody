-- WATCHDOG
task.spawn(function()
    local wasKiller, snap = false, nil
    while not _ShuttingDown do
        task.wait(0.4)
        local now=IsPlayerKiller()
        if now and not wasKiller then
            snap={block=_G.AutoBlockEnabled,hdt=HDT.enabled,aim=GAim.enabled,crystal=SilentGH.crystal,dusk=SilentGH.dusk,stab=stabState.enabled}
            _G.AutoBlockEnabled=false; HDT.enabled=false; GAim.enabled=false
            SilentGH.crystal=false; SilentGH.dusk=false; stabState.enabled=false
            pcall(function() Toggles.AutoBlockToggle:SetValue(false) end)
            pcall(function() Toggles.HDT_Enable:SetValue(false) end)
            pcall(function() Toggles.Aim_Enable:SetValue(false) end)
            Library:Notify({Title="Perfect", Description="Survivor tools paused (Killer)", Time=4})
        elseif not now and wasKiller and snap then
            task.wait(0.5)
            if snap.block then _G.AutoBlockEnabled=true; EnableAutoBlock(); pcall(function() Toggles.AutoBlockToggle:SetValue(true) end) end
            if snap.hdt then HDT.enabled=true; pcall(function() Toggles.HDT_Enable:SetValue(true) end) end
            if snap.aim then GAim.enabled=true; pcall(function() Toggles.Aim_Enable:SetValue(true) end) end
            if snap.crystal then SilentGH.crystal=true end
            if snap.dusk then SilentGH.dusk=true end
            if snap.stab then stabState.enabled=true end
            Library:Notify({Title="Perfect", Description="Survivor tools restored", Time=4})
            snap=nil
        end
        wasKiller=now
    end
end)

