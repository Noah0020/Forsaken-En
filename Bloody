local Vee = {
    autoTrick = false,
    skateControl = false,
    unlimitedSk8 = false,
    autoFarm = false,
    antiRebound = false,
    customStats = false,
    sk8Speed = 1.15,
    sk8TrickAir = 1.42,
    sk8Bump = 11.9,
    sk8TrickStam = 4,
    sk8Cooldown = 1,
    _module = nil,
    _behavior = nil,
    _trickThread = nil,
    _farmThread = nil,
    _namecallOff = nil,
}

local function Vee_GetModule()
    if Vee._module then return Vee._module end
    pcall(function()
        local behavior = ReplicatedStorage.Assets.Survivors.Veeronica.Behavior
        Vee._behavior = behavior
        Vee._module = require(behavior)
    end)
    return Vee._module
end

local function Vee_SetStat(key, val)
    local mod = Vee_GetModule()
    if mod then pcall(function() mod[key] = val end) end
    if getgc then
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "DisplayName") == "Veeronica" then
                    pcall(function() t[key] = val end)
                end
            end
        end)
    end
end

local function Vee_ApplyStats()
    if Vee.customStats then
        Vee_SetStat("Sk8Speed", Vee.sk8Speed)
        Vee_SetStat("Sk8SpeedExhaust", Vee.sk8Speed)
        Vee_SetStat("Sk8TrickAirborneSpeed", Vee.sk8TrickAir)
        Vee_SetStat("Sk8BumpPower", Vee.sk8Bump)
        Vee_SetStat("Sk8BumpChargedPower", Vee.sk8Bump)
        Vee_SetStat("Sk8TrickStamina", Vee.sk8TrickStam)
        Vee_SetStat("Sk8TrickStaminaNerfed", Vee.sk8TrickStam)
        Vee_SetStat("Sk8TrickCooldown", Vee.sk8Cooldown)
    else
        Vee_SetStat("Sk8Speed", 1.15)
        Vee_SetStat("Sk8SpeedExhaust", 1.15)
        Vee_SetStat("Sk8TrickAirborneSpeed", 1.42)
        Vee_SetStat("Sk8BumpPower", 11.9)
        Vee_SetStat("Sk8BumpChargedPower", 15)
        Vee_SetStat("Sk8TrickStamina", 4)
        Vee_SetStat("Sk8TrickStaminaNerfed", 4)
        Vee_SetStat("Sk8TrickCooldown", 1)
    end
end

local function Vee_SkateControl(on)
    local val = on and 6.5 or 0.65
    local mod = Vee_GetModule()
    if mod then pcall(function() mod.Sk8TurnControl = val end) end
    if getgc then
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "Sk8TurnControl") ~= nil then
                    pcall(function() t.Sk8TurnControl = val end)
                end
            end
        end)
    end
end

-- Bypass Sk8 "BAD" cancel on ability callback
local function Vee_PatchSk8Callback()
    local mod = Vee_GetModule()
    if not mod or type(mod.Abilities) ~= "table" then return end
    local sk8 = mod.Abilities.Sk8
    if type(sk8) ~= "table" or sk8.__vortexBypass then return end
    local cb = sk8.Callback
    if type(cb) ~= "function" then return end
    sk8.__origCallback = cb
    sk8.__vortexBypass = true
    sk8.Callback = function(a, b, ...)
        if b == "BAD" then b = nil end
        return cb(a, b, ...)
    end
end

local function Vee_UnpatchSk8Callback()
    local mod = Vee_GetModule()
    if not mod or type(mod.Abilities) ~= "table" then return end
    local sk8 = mod.Abilities.Sk8
    if type(sk8) ~= "table" or not sk8.__vortexBypass then return end
    if sk8.__origCallback then sk8.Callback = sk8.__origCallback end
    sk8.__origCallback = nil
    sk8.__vortexBypass = nil
end

-- Auto Trick: press space / fire sprint button when skating highlight appears
local function Vee_DoTrickInput()
    if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
        local ui = LP:FindFirstChild("PlayerGui")
        local main = ui and ui:FindFirstChild("MainUI")
        local btn = main and main:FindFirstChild("SprintingButton", true)
        if btn and getconnections then
            for _, sig in ipairs({btn.MouseButton1Down, btn.MouseButton1Up, btn.Activated}) do
                pcall(function()
                    for _, conn in pairs(getconnections(sig)) do
                        pcall(function() conn:Fire() end)
                        pcall(function() if conn.Function then conn.Function() end end)
                    end
                end)
            end
        end
    else
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end
end

local function Vee_StartAutoTrick()
    if Vee._trickThread then return end
    Vee._trickThread = task.spawn(function()
        local last = 0
        while Vee.autoTrick and not _ShuttingDown do
            if not IsPlayerKiller() then
                local char = LP.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local anim = hum and hum:FindFirstChildOfClass("Animator")
                local skating = false
                if anim then
                    for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
                        local n = tostring(tr.Name or ""):lower()
                        local id = tostring(tr.Animation and tr.Animation.AnimationId or "")
                        if n:find("sk8") or n:find("skat") or n:find("trick") then skating = true; break end
                    end
                end
                -- also check attribute
                if char and (char:GetAttribute("IsSkating") or char:GetAttribute("Skating")) then skating = true end
                if skating and tick() - last > 0.35 then
                    last = tick()
                    pcall(Vee_DoTrickInput)
                end
            end
            task.wait(0.12)
        end
        Vee._trickThread = nil
    end)
end

local function Vee_StartAutoFarm()
    if Vee._farmThread then return end
    Vee._farmThread = task.spawn(function()
        while Vee.autoFarm and not _ShuttingDown do
            if not IsPlayerKiller() and NetworkEvent then
                pcall(function()
                    NetworkEvent:FireServer(LP.Name .. "SkateTrick", {})
                end)
            end
            task.wait(0.5)
        end
        Vee._farmThread = nil
    end)
end

-- Unlimited Sk8: keep re-applying high stamina / low cost + patch BAD
local function Vee_UnlimitedLoop()
    task.spawn(function()
        while Vee.unlimitedSk8 and not _ShuttingDown do
            pcall(Vee_PatchSk8Callback)
            Vee_SetStat("Sk8TrickStamina", 0)
            Vee_SetStat("Sk8TrickStaminaNerfed", 0)
            Vee_SetStat("Sk8TrickCooldown", 0)
            Vee_SetStat("Sk8StaminaCost", 0)
            task.wait(0.4)
        end
        if not Vee.customStats then
            Vee_SetStat("Sk8TrickStamina", 4)
            Vee_SetStat("Sk8TrickStaminaNerfed", 4)
            Vee_SetStat("Sk8TrickCooldown", 1)
        else
            Vee_ApplyStats()
        end
    end)
end

