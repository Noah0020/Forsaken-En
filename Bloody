local _pingCache = { value = 100, at = 0 }
local function getPingMs()
    if os.clock() - _pingCache.at < 0.25 then return _pingCache.value end
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
    end)
    if ok and v then
        local n = tonumber((string.split(tostring(v), "("))[1])
        if n then _pingCache.value = n; _pingCache.at = os.clock(); return n end
    end
    local ok2, v2 = pcall(function() return LP:GetNetworkPing() * 1000 end)
    local n2 = (ok2 and v2) or 100
    _pingCache.value = n2; _pingCache.at = os.clock()
    return n2
end

local function pingPrediction()
    local p = getPingMs()
    if p >= 225 then return 1.4
    elseif p >= 215 then return 1.2
    elseif p >= 205 then return 1.0
    elseif p >= 190 then return 0.10
    elseif p >= 180 then return 0.12
    elseif p >= 170 then return 0.15
    elseif p >= 160 then return 0.18
    elseif p >= 150 then return 0.11
    elseif p >= 140 then return 0.113
    elseif p >= 130 then return 0.116
    elseif p >= 120 then return 0.120
    elseif p >= 110 then return 0.124
    elseif p >= 105 then return 0.127
    elseif p >= 90 then return 0.130
    elseif p >= 80 then return 0.133
    elseif p >= 70 then return 0.136
    elseif p >= 60 then return 0.15038
    elseif p >= 50 then return 0.15038
    elseif p >= 40 then return 0.145
    elseif p >= 30 then return 0.155
    elseif p >= 20 then return 0.157
    else return 0.16
    end
end

local PRED_MIN, PRED_MAX = 2, 3
local _velHistory, _posHistory = {}, {}
local function getVelocity(hrp)
    if not hrp then return Vector3.zero end
    local now = os.clock()
    local v = hrp.AssemblyLinearVelocity
    if (not v or v.Magnitude < 0.5) then v = hrp.Velocity end
    if not v then v = Vector3.zero end
    local prev = _posHistory[hrp]
    if prev and (now - prev.time) > 0.01 then
        local dv = (hrp.Position - prev.pos) / (now - prev.time)
        if dv.Magnitude > v.Magnitude then v = dv end
    end
    _posHistory[hrp] = { pos = hrp.Position, time = now }
    return v
end
local function smoothedVelocity(hrp)
    if not hrp then return Vector3.zero end
    local v = getVelocity(hrp)
    local h = _velHistory[hrp]
    if not h then h = {}; _velHistory[hrp] = h end
    table.insert(h, v)
    if #h > 10 then table.remove(h, 1) end
    local sum = Vector3.zero
    for i = 1, #h do sum = sum + h[i] end
    return sum / math.max(#h, 1)
end

local function PredictPosition(hrp, sliderPred)
    if not hrp then return nil end
    local pos = hrp.Position
    if Settings.AutoPrediction then
        local vel = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.zero
        return pos + vel * pingPrediction()
    end
    local vel = smoothedVelocity(hrp)
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local speed = horiz.Magnitude
    local slider = math.clamp(sliderPred or 4, 1, 10)
    local mul = slider / 4
    if speed < 1.2 then return pos end
    local lead = (PRED_MIN + (PRED_MAX - PRED_MIN) * math.clamp(speed / 28, 0, 1)) * mul
    local h = _velHistory[hrp]
    if h and #h >= 3 then
        local a, b = h[#h - 2], h[#h]
        local ah = Vector3.new(a.X, 0, a.Z)
        local bh = Vector3.new(b.X, 0, b.Z)
        if ah.Magnitude > 2 and bh.Magnitude > 2 and ah.Unit:Dot(bh.Unit) < 0.45 then
            lead = lead + 0.9 * mul
        end
    end
    return pos + horiz.Unit * lead
end

