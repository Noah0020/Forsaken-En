local function killerFacingMe(kr)
    if not LocalRoot or not kr then return false end
    local off = LocalRoot.Position - kr.Position
    local look = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
    local toMe = Vector3.new(off.X, 0, off.Z)
    if look.Magnitude < 0.01 or toMe.Magnitude < 0.01 then return false end
    return look.Unit:Dot(toMe.Unit) >= (AB.FlexDot or 0.6)
end

local function canTrigger(kr)
    if AB.Mode == "flex" then
        return killerFacingMe(kr)
    end
    return true
end

local function DragToward(kr)
    if not AB.HitboxDrag or not LocalRoot or not kr then return end
    local dist = (kr.Position - LocalRoot.Position).Magnitude
    if dist > (AB.DragRange or 30) then return end
    local speed = AB.DragSpeed or 14
    local t0 = os.clock()
    task.spawn(function()
        while os.clock() - t0 < 0.35 and AB.Enabled and LocalRoot and kr.Parent do
            local dt = RunService.Heartbeat:Wait()
            local dir = kr.Position - LocalRoot.Position
            dir = Vector3.new(dir.X, 0, dir.Z)
            if dir.Magnitude <= 3 then break end
            local ramp = math.sin(math.pi * (os.clock() - t0) / 0.35)
            LocalRoot.CFrame = LocalRoot.CFrame + dir.Unit * speed * ramp * dt
            LocalRoot.CFrame = CFrame.lookAt(LocalRoot.Position, LocalRoot.Position + dir.Unit)
        end
    end)
end

local function DoBlock(kr)
    local now = os.clock()
    if now - lastBlock < 0.02 then return end
    if kr and not canTrigger(kr) then return end
    lastBlock = now
    if AB.HitboxDrag and kr then DragToward(kr) end
    local function fire()
        FireBlock(); FireBlock(); FireBlock(); FireBlock()
        if AB.AutoPunch then
            task.delay(AB.PunchDelay or 0.45, FirePunch)
        end
    end
    local ms = tonumber(AB.BlockDelayMs) or 0
    if ms > 0 then task.delay(ms / 1000, fire) else fire() end
end

local function armKiller(model, dur)
    if not model or model == LocalChar then return end
    pending[model] = { expiry = os.clock() + (dur or AB.SoundTimer), blocked = false }
end

local function hookSound(sound, model)
    if not sound or not sound:IsA("Sound") then return end
    table.insert(abConns, sound.Played:Connect(function()
        if not AB.Enabled then return end
        local id = extractId(sound.SoundId)
        if id and AttackSounds[id] then
            armKiller(model or sound:FindFirstAncestorOfClass("Model"), AB.SoundTimer)
        end
    end))
end

local function trackKiller(model)
    if not model or not model:IsA("Model") then return end
    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Sound") then hookSound(d, model) end
        end
    end)
    table.insert(abConns, model.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d, model) end
    end))
    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
        if not anim then return end
        table.insert(abConns, anim.AnimationPlayed:Connect(function(track)
            if not AB.Enabled or not track.Animation then return end
            local id = extractId(track.Animation.AnimationId)
            if not id or not AttackAnims[id] then return end
            armKiller(model, AB.SoundTimer)
            -- QueryHitbox path (Flex TriggerBlockWithHitbox)
            task.spawn(function()
                local q = model:FindFirstChild("QueryHitbox")
                if not q then return end
                local lq = LocalChar and LocalChar:FindFirstChild("QueryHitbox")
                local params = OverlapParams.new()
                params.MaxParts = 2
                if lq then
                    params.FilterType = Enum.RaycastFilterType.Include
                    params.FilterDescendantsInstances = { lq }
                else
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = { model }
                end
                for _ = 1, 14 do
                    if not AB.Enabled then break end
                    local kr = model:FindFirstChild("HumanoidRootPart")
                    if AB.Mode == "flex" and kr and not killerFacingMe(kr) then
                        task.wait(0.01)
                    else
                        local hits = workspace:GetPartBoundsInBox(
                            q.CFrame * CFrame.new(0, 0, -3.5),
                            Vector3.new(5.2, 6, 5.65) * 2.2 * (AB.HitboxMult or 1),
                            params
                        )
                        if #hits > 0 then
                            DoBlock(kr)
                            break
                        end
                        task.wait(0.01)
                    end
                end
            end)
        end))
    end)
end

local function makeALUBox(killer)
    if not AB.Enabled or not killer or not LocalRoot then return end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    if not kr then return end
    if not canTrigger(kr) then return end
    local m = AB.HitboxMult or 1
    local size = Vector3.new(6 * m, 6 * m, 9 * m)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killer }
    task.spawn(function()
        local t0, blocked = tick(), false
        while tick() - t0 < 0.28 and AB.Enabled and not blocked do
            local krr = killer:FindFirstChild("HumanoidRootPart")
            if not krr then break end
            local hb = Instance.new("Part")
            hb.Name = "SH_ALU"
            hb.Size = size
            hb.CFrame = krr.CFrame * CFrame.new(0, 0, -(AB.HitboxDist or 3))
            hb.Anchored = true
            hb.CanCollide = false
            hb.CanTouch = false
            hb.CanQuery = false
            hb.CastShadow = false
            hb.Material = Enum.Material.ForceField
            hb.Color = Color3.fromRGB(40, 40, 40)
            hb.Transparency = AB.HitboxVis and 0.7 or 1
            hb.Parent = workspace
            Debris:AddItem(hb, 0.28)
            for _, p in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = p.Parent and p.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                    blocked = true
                    hb.Color = Color3.fromRGB(0, 200, 0)
                    DoBlock(krr)
                    break
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function abHeartbeat()
    if not AB.Enabled then
        VisualBeam.Enabled = false
        return
    end
    if not LocalRoot then return end
    local now = os.clock()

    -- Flex strict visual beam
    if AB.StrictVisual or AB.Mode == "flex" then
        local best, bd = nil, 150
        if KillersFolder then
            for _, m in ipairs(KillersFolder:GetChildren()) do
                local kr = m:FindFirstChild("HumanoidRootPart")
                if kr then
                    local d = (kr.Position - LocalRoot.Position).Magnitude
                    if d < bd then bd = d; best = m end
                end
            end
        end
        if best then
            local krp = best:FindFirstChild("HumanoidRootPart")
            if krp then
                beamAtt0.Parent = LocalRoot
                beamAtt1.Parent = krp
                local seeing = killerFacingMe(krp)
                VisualBeam.Color = ColorSequence.new(seeing and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 40, 40))
                VisualBeam.Enabled = true
            else
                VisualBeam.Enabled = false
            end
        else
            VisualBeam.Enabled = false
        end
    else
        VisualBeam.Enabled = false
    end

    -- pending sound/anim arms
    for model, st in pairs(pending) do
        if not model.Parent or now > st.expiry then
            pending[model] = nil
        elseif not st.blocked then
            local kr = model:FindFirstChild("HumanoidRootPart")
            if kr and (LocalRoot.Position - kr.Position).Magnitude <= (AB.Range or 15) then
                if canTrigger(kr) then
                    st.blocked = true
                    DoBlock(kr)
                end
            end
        end
    end

    -- AbilityLastUsed (always when AB on)
    if KillersFolder then
        local killer = KillersFolder:GetChildren()[1]
        if killer and killer:IsA("Model") then
            local alu = killer:GetAttribute("AbilityLastUsed") or 0
            local au  = killer:GetAttribute("AbilitiesUsed") or 0
            if aluLast == nil then
                aluLast, aluUsed = alu, au
            else
                if au > aluUsed then aluLock = true end
                if alu > aluLast then
                    if aluLock then aluLock = false else makeALUBox(killer) end
                end
                aluLast, aluUsed = alu, au
            end
        end
    end
end

local function SetAutoBlock(on)
    AB.Enabled = on
    for _, c in ipairs(abConns) do pcall(function() c:Disconnect() end) end
    table.clear(abConns)
    table.clear(pending)
    aluLast, aluUsed, aluLock = nil, nil, false
    VisualBeam.Enabled = false

    if not on then
        for _, o in ipairs(workspace:GetChildren()) do
            if o.Name == "SH_ALU" then o:Destroy() end
        end
        Notify("Auto Block", "OFF")
        return
    end

    refreshFolders()
    if KillersFolder then
        for _, m in ipairs(KillersFolder:GetChildren()) do
            if m:IsA("Model") then trackKiller(m) end
        end
        table.insert(abConns, KillersFolder.ChildAdded:Connect(function(c)
            if c:IsA("Model") then trackKiller(c) end
        end))
    end
    table.insert(abConns, RunService.Heartbeat:Connect(abHeartbeat))
    Notify("Auto Block", "ON · anim + sound + AbilityLastUsed")
end

