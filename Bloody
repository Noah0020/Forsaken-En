local function UpdateScale()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local scale = math.min(
        1,
        (viewport.X - 24) / 340,
        (viewport.Y - 35) / 440
    )
    UIScale.Scale = math.max(0.65, scale)
end

