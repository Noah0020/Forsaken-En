local function fetchSession(retry)
    if os.time() - loadedLastSessionRequest < 43200 and loadedLastSession ~= "" then return loadedLastSession end
    retry = retry or 0
    local r = request({Url="https://socialite-auth.roblocks.workers.dev/",Method="GET",
        Headers={["X-AyeshaErotica"]="loves it!"}})
    if r.StatusCode == 429 then
        if retry>=3 then return loadedLastSession end
        task.wait(4); return fetchSession(retry+1) end
    local body = r.Body
    if typeof(body)~="string" or #body>64 or not string.match(body,"^[%da-fA-F]+$") then
        return loadedLastSession end
    loadedLastSession = body; loadedLastSessionRequest = os.time()
    if caps.filesystem then
        writefile("dgk_ln.log",tostring(loadedLastSession))
        writefile("dgk_lr.log",tostring(loadedLastSessionRequest)) end
    return body
end

local function verifyKey(key, session, ident, retry)
    if not key or not session or not ident or key=="" or session=="" then
        return {valid=false,reason="Invalid!",status=400} end
    retry = retry or 0
    local nonce = genNonce()
    local r = request({Url="https://socialite-auth.roblocks.workers.dev/",Method="POST",
        Headers={["X-Syncsaken"]="drop it drop it"},
        Body=HttpService:JSONEncode({auth=key,session=session,identifier=tostring(ident),nonce=nonce})})
    if r.StatusCode == 406 then
        loadedLastSessionRequest = 0
        if retry>=3 then return {valid=false,reason=RESP[406],status=406} end
        task.wait(1); return verifyKey(key,fetchSession(),ident,retry+1) end
    if r.StatusCode == 429 then
        if retry>=3 then return {valid=false,reason=RESP[429],status=429} end
        task.wait(4); return verifyKey(key,session,ident,retry+1) end
    if r.StatusCode == 212 then
        local data = HttpService:JSONDecode(r.Body)
        if not data or not data.valid or not data.session
            or sha256("true-"..session..nonce.."34c52300d5b526808f6daa2d4a9eb80f7152c2ecbfadd5bd37c42e9c9e5500e4") ~= data.session then
            return {valid=false,reason="Idk",status=400} end
        if caps.filesystem then writefile("dgk_k.log",key) end
        return {valid=true,expires=tonumber(data.expires)} end
    return {valid=false,reason=tostring(RESP[r.StatusCode] or "Unknown ["..r.StatusCode.."]"),status=r.StatusCode}
end

