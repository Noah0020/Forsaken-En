-- IVY FACING CHECK (standalone visual / direction utility)
-- Kept separate from GoodSAKEN's Auto Block detection engine.
-- ============================================================
local facingCheckEnabled = true
local customFacingDot = 0.3
local facingDetectionRange = 18
local facingVisualOn = false
local facingVisuals = {}
local detectionCircles = {}
local killerCirclesVisible = false

local function isFacing(localRoot, targetRoot)
    if not facingCheckEnabled then return true end
    if not (localRoot and targetRoot) then return false end
    local offset = localRoot.Position - targetRoot.Position
    if offset.Magnitude == 0 then return true end
    return targetRoot.CFrame.LookVector:Dot(offset.Unit) > customFacingDot
end

local function updateFacingVisual(killer, visual)
    if not (killer and visual and visual.Parent) then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dot = math.clamp(customFacingDot, -1, 1)
    local frac = math.acos(dot) / math.pi
    visual.Radius = math.max(1, facingDetectionRange * (0.20 + 0.80 * frac))
    visual.Height = 0.12
    visual.CFrame = CFrame.new(0, -(hrp.Size.Y/2 + 0.05), -facingDetectionRange * (0.35 + 0.15 * frac))
        * CFrame.Angles(math.rad(90), 0, 0)
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then
        local dist = (hrp.Position - myRoot.Position).Magnitude
        if dist <= facingDetectionRange then
            visual.Color3 = Color3.fromRGB(255, 0, 0)
            visual.Transparency = 0.40
        else
            visual.Color3 = Color3.fromRGB(255, 255, 0)
            visual.Transparency = 0.85
        end
    end
end

local function addFacingVisual(killer)
    if not killer or not killer:IsA("Model") or facingVisuals[killer] then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local visual = Instance.new("CylinderHandleAdornment")
    visual.Name = "FacingCheckVisual"
    visual.Adornee = hrp
    visual.AlwaysOnTop = true
    visual.ZIndex = 2
    visual.Transparency = 0.55
    visual.Color3 = Color3.fromRGB(255, 255, 0)
    visual.Parent = hrp
    facingVisuals[killer] = visual
    updateFacingVisual(killer, visual)
end

local function removeFacingVisual(killer)
    local visual = facingVisuals[killer]
    if visual then visual:Destroy(); facingVisuals[killer] = nil end
end

local function addKillerCircle(killer)
    if detectionCircles[killer] then return end
    local hrp = killer and killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local circle = Instance.new("CylinderHandleAdornment")
    circle.Name = "KillerDetectionCircle"
    circle.Adornee = hrp
    circle.Color3 = Color3.fromRGB(255, 255, 0)
    circle.AlwaysOnTop = true
    circle.ZIndex = 1
    circle.Transparency = 0.6
    circle.Radius = facingDetectionRange
    circle.Height = 0.12
    circle.CFrame = CFrame.new(0, -(hrp.Size.Y/2 + 0.05), 0) * CFrame.Angles(math.rad(90), 0, 0)
    circle.Parent = hrp
    detectionCircles[killer] = circle
end

local function removeKillerCircle(killer)
    local circle = detectionCircles[killer]
    if circle then circle:Destroy(); detectionCircles[killer] = nil end
end

RunService.RenderStepped:Connect(function()
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if facingVisualOn then
        for killer, visual in pairs(facingVisuals) do
            if not killer.Parent or not killer:FindFirstChild("HumanoidRootPart") then
                removeFacingVisual(killer)
            else
                updateFacingVisual(killer, visual)
            end
        end
    end
    if killerCirclesVisible then
        for killer, circle in pairs(detectionCircles) do
            local hrp = killer and killer:FindFirstChild("HumanoidRootPart")
            if not killer.Parent or not (circle and circle.Parent and hrp) then
                removeKillerCircle(killer)
            else
                circle.Radius = facingDetectionRange
                if myRoot then
                    local dist = (hrp.Position - myRoot.Position).Magnitude
                    circle.Color3 = (dist <= facingDetectionRange) and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 255, 0)
                end
            end
        end
    end
end)

KillersFolder.ChildAdded:Connect(function(killer)
    task.spawn(function()
        if not killer:WaitForChild("HumanoidRootPart", 5) then return end
        if facingVisualOn then addFacingVisual(killer) end
        if killerCirclesVisible then addKillerCircle(killer) end
    end)
end)
KillersFolder.ChildRemoved:Connect(function(killer)
    removeFacingVisual(killer)
    removeKillerCircle(killer)
end)

