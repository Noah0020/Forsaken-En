local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

local function extractId(s) return s and string.match(tostring(s), "%d+") end
local function getRoot(m) return m and m:FindFirstChild("HumanoidRootPart") end
local function isLocalModel(m)
    if not m then return false end
    if Players:GetPlayerFromCharacter(m) == LocalPlayer then return true end
    return m.Name == LocalPlayer.Name
end
local function getQueryHitbox(model)
    if not model then return nil end
    local q = model:FindFirstChild("QueryHitbox")
    if q and q:IsA("BasePart") then return q end
    for _, c in ipairs(model:GetChildren()) do
        local q2 = c:FindFirstChild("QueryHitbox")
        if q2 and q2:IsA("BasePart") then return q2 end
    end
    return model:FindFirstChild("HumanoidRootPart")
end
local function pointInBox(box, worldPos)
    if not box or not worldPos then return false end
    local lp = box.CFrame:PointToObjectSpace(worldPos)
    local h = box.Size * 0.5
    return math.abs(lp.X) <= h.X+0.001 and math.abs(lp.Y) <= h.Y+0.001 and math.abs(lp.Z) <= h.Z+0.001
end
local function facingOk(localRoot, killerRoot)
    if AB.facingMode ~= "default" then return true end
    if not AB.defaultRangeRequireFacing or not localRoot or not killerRoot then return true end
    local n = localRoot.Position - killerRoot.Position
    if n.Magnitude < 0.1 then return true end
    local unit = Vector3.new(n.X, 0, n.Z).Unit
    local look = killerRoot.CFrame.LookVector
    return Vector3.new(look.X, 0, look.Z).Unit:Dot(unit) > (AB.customFacingDot or -0.1)
end
local function wallBlocked(localRoot, killerRoot, char)
    if not AB.wallCheckEnabled then return false end
    local from = localRoot.Position + Vector3.new(0,1.5,0)
    local to = killerRoot.Position + Vector3.new(0,1.5,0) - from
    raycastParams.FilterDescendantsInstances = {char, killerRoot.Parent}
    local hit = workspace:Raycast(from, to, raycastParams)
    return hit and hit.Instance and hit.Instance.CanCollide
end
local function doBlockAbility()
    if AB.autoBlockMode == "007n7" then FireAbility("Clone") else fireBlock() end
end
local function scheduleBlock()
    if not abRunning or not AB.autoBlock then return end
    if tonumber(AB.autoBlockDelay) and AB.autoBlockDelay > 0 then
        task.delay(AB.autoBlockDelay, doBlockAbility)
    else doBlockAbility() end
    if AB.autoPunch then task.delay(AB.PunchDelay or 0.5, FirePunch) end
end
local function armKiller(model, duration)
    if not model or isLocalModel(model) then return end
    pendingBlocks[model] = { expiry = os.clock() + (duration or AB.soundTimerValue or 0.32), blocked = false }
end
local function hitboxDrag()
    if not AB.hitboxDraggingEnabled or not abRunning or not AB.autoBlock then return end
    task.spawn(function()
        local char = LocalPlayer.Character
        local killer
        for _, m in ipairs(killersList) do
            local h = m:FindFirstChildOfClass("Humanoid")
            local r = getRoot(m)
            if h and r and h.Health > 0 then killer = m; break end
        end
        if not char or not killer then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local primary = char.PrimaryPart or hrp
        if not hrp then return end
        local part = Instance.new("Part")
        part.Size = Vector3.new(2,2,2); part.Transparency = 1; part.CanCollide = false
        part.Anchored = true; part.CFrame = hrp.CFrame; part.Parent = char
        char.PrimaryPart = part
        local t0 = os.clock()
        while os.clock()-t0 < (AB.hitboxDraggingDuration or 0.3) and AB.hitboxDraggingEnabled and abRunning and AB.autoBlock do
            local kr = getRoot(killer)
            if kr then
                part.CFrame = CFrame.new((kr.CFrame * CFrame.new(0,0,-3)).Position) * hrp.CFrame.Rotation
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            RunService.PreRender:Wait()
        end
        if part.Parent then part:Destroy() end
        if char.Parent then char.PrimaryPart = primary end
    end)
end
local function clearVis(model, key)
    if visuals[model] and visuals[model][key] then visuals[model][key]:Destroy(); visuals[model][key]=nil end
end
local function updateVisuals()
    if not abRunning or not AB.autoBlock then return end
    local customOn = AB.facingMode == "custom"
    local now = os.clock()
    for _, m in ipairs(killersList) do
        local root = getRoot(m)
        if root then
            visuals[m] = visuals[m] or {}
            if not customOn and AB.defaultVisualizerVisible then
                if not visuals[m].Default then
                    local cyl = Instance.new("CylinderHandleAdornment")
                    cyl.Name="DefaultRangeVisualizer"; cyl.Adornee=root
                    cyl.Color3=Color3.fromRGB(255,100,100); cyl.AlwaysOnTop=true
                    cyl.ZIndex=1; cyl.Transparency=0.5; cyl.Height=0.12; cyl.Parent=root
                    visuals[m].Default = cyl
                end
                visuals[m].Default.Radius = tonumber(AB.detectionRange) or 15
                visuals[m].Default.CFrame = CFrame.new(0, -(root.Size.Y/2+0.05), 0) * CFrame.Angles(math.pi/2, 0, 0)
            else clearVis(m, "Default") end
            if customOn and AB.customVisualizerVisible and pendingBlocks[m] and now <= pendingBlocks[m].expiry then
                if not visuals[m].Custom then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Name="CustomRangeVisualizer"; box.Adornee=root
                    box.Color3=Color3.fromRGB(255,255,102); box.AlwaysOnTop=true
                    box.ZIndex=1; box.Transparency=0.7; box.Parent=root
                    visuals[m].Custom = box
                end
                local q = getQueryHitbox(m) or root
                local fr = tonumber(AB.customRangeSettings.frontRange) or 12
                local sr = tonumber(AB.customRangeSettings.sideRange) or 12
                local ht = tonumber(AB.customRangeSettings.height) or 8
                visuals[m].Custom.Adornee=q
                visuals[m].Custom.Size=Vector3.new(sr,ht,fr)
                visuals[m].Custom.CFrame=CFrame.new(0,0,-(fr/2))
            else clearVis(m, "Custom") end
        end
    end
end
local function abTick()
    if not abRunning or not AB.autoBlock then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local now = os.clock()
    local customOn = AB.facingMode == "custom"
    for model, st in pairs(pendingBlocks) do
        if not model or not model.Parent or now > st.expiry then
            pendingBlocks[model] = nil
        else
            local kr = getRoot(model)
            if kr then
                local inRange = false
                if customOn then
                    local q = getQueryHitbox(model) or kr
                    local fr = tonumber(AB.customRangeSettings.frontRange) or 12
                    local sr = tonumber(AB.customRangeSettings.sideRange) or 12
                    local ht = tonumber(AB.customRangeSettings.height) or 8
                    inRange = pointInBox({CFrame=q.CFrame*CFrame.new(0,0,-(fr/2)), Size=Vector3.new(sr,ht,fr)}, hrp.Position)
                else
                    inRange = (hrp.Position - kr.Position).Magnitude <= (tonumber(AB.detectionRange) or 15)
                end
                inRange = inRange and not st.blocked
                if inRange and facingOk(hrp, kr) and not wallBlocked(hrp, kr, char) then
                    st.blocked = true
                    scheduleBlock()
                    hitboxDrag()
                end
            end
        end
    end
    updateVisuals()
end
local function onSoundPlayed(sound, ownerModel)
    if not abRunning or not AB.autoBlock then return end
    local id = extractId(sound.SoundId)
    if not id or not SOUND_KILLER[id] then return end
    ownerModel = ownerModel or sound:FindFirstAncestorOfClass("Model")
    if not ownerModel or isLocalModel(ownerModel) then return end
    armKiller(ownerModel, tonumber(AB.soundTimerValue) or 0.32)
end
local function hookSound(sound, owner)
    if not sound or not sound:IsA("Sound") or AB.soundHooks[sound] then return end
    local model = owner or sound:FindFirstAncestorOfClass("Model")
    if model and isLocalModel(model) then return end
    local played = sound.Played:Connect(function() onSoundPlayed(sound, model) end)
    AB.soundHooks[sound] = {
        playedConn = played,
        destroyConn = sound.Destroying:Connect(function()
            if played then played:Disconnect() end
            AB.soundHooks[sound] = nil
        end),
    }
    if sound.IsPlaying then task.defer(function() onSoundPlayed(sound, model) end) end
end
local function onAnimPlayed(track, model)
    if not abRunning or not AB.autoBlock then return end
    local anim = track.Animation
    if not anim then return end
    local id = extractId(anim.AnimationId)
    if not id then return end
    if SLASHER_ANIMS[id] or AttackAnimations["rbxassetid://"..id] then
        armKiller(model, tonumber(AB.soundTimerValue) or 0.32)
        task.spawn(function()
            local q = model:FindFirstChild("QueryHitbox")
            if not q then return end
            local localQ = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("QueryHitbox")
            if not localQ then return end
            local params = OverlapParams.new()
            params.MaxParts = 1
            params.FilterType = Enum.RaycastFilterType.Include
            params.FilterDescendantsInstances = { localQ }
            for _ = 1, 10 do
                if not AB.autoBlock then break end
                local hits = workspace:GetPartBoundsInBox(q.CFrame * CFrame.new(0,0,-3.5), Vector3.new(5.2,6,5.65)*2.2, params)
                if #hits > 0 then scheduleBlock(); hitboxDrag(); break end
                task.wait(0.02)
            end
        end)
    end
end
local function trackKiller(model)
    if not model or not model:IsA("Model") or trackedModels[model] then return end
    trackedModels[model] = true
    table.insert(killersList, model)
    if not isLocalModel(model) then
        pcall(function()
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("Sound") then hookSound(d, model) end
            end
        end)
        table.insert(abConns, model.DescendantAdded:Connect(function(d)
            if d:IsA("Sound") and not isLocalModel(model) then hookSound(d, model) end
        end))
        task.spawn(function()
            local hum = model:WaitForChild("Humanoid", 5)
            if hum then
                local anim = hum:WaitForChild("Animator", 5) or hum
                table.insert(abConns, anim.AnimationPlayed:Connect(function(tr) onAnimPlayed(tr, model) end))
            end
        end)
    end
end
local function untrackKiller(model)
    if not model or not trackedModels[model] then return end
    trackedModels[model] = nil
    for i = #killersList, 1, -1 do
        if killersList[i] == model then table.remove(killersList, i); break end
    end
    pendingBlocks[model] = nil
    clearVis(model, "Default"); clearVis(model, "Custom")
end

-- Last-used box (runs with AB)
local lastALU, lastAU, blockLocked = nil, nil, false
local KILLER_HB = {
    CoolKid={dura=0.05,life=0.05,w=5,l=7,h=6}, Slasher={dura=0.35,life=0.35},
    ["1x1x1x1"]={dura=0.45,life=0.45}, JohnDoe={dura=0.45,life=0.45}, ["John Doe"]={dura=0.45,life=0.45},
    Nosferatu={dura=0.42,life=0.42}, Sixer={dura=0.42,life=0.42,dist=6},
    Noli={dura=0.37,life=0.37}, Azure={dura=0.35,life=0.35},
}
local DEF_HB = {dura=0.26, life=0.26}
local function getHB(name)
    if not name then return DEF_HB end
    for k,v in pairs(KILLER_HB) do if string.find(name, k, 1, true) then return v end end
    return DEF_HB
end
local function makeLastUsedHitbox(killer)
    if not AB.autoBlock or not killer then return end
    local root = getRoot(killer); if not root then return end
    local cfg = getHB(killer.Name)
    local m = AB.HitboxMult or 1
    local size = Vector3.new((cfg.w or 6)*m, (cfg.h or 6)*m, (cfg.l or 9)*m)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killer}
    task.spawn(function()
        local t0, blocked = tick(), false
        while tick()-t0 < (cfg.dura or 0.26) do
            if blocked or not AB.autoBlock then break end
            local kr = getRoot(killer); if not kr then break end
            local cf = kr.CFrame * CFrame.new(0,0,-(cfg.dist or AB.HitboxDist or 3))
            local hb = Instance.new("Part")
            hb.Name="AB_LastUsedHB"; hb.Size=size; hb.CFrame=cf; hb.Anchored=true
            hb.CanCollide=false; hb.CanTouch=false; hb.CanQuery=false; hb.CastShadow=false
            hb.Material=Enum.Material.ForceField; hb.Color=Color3.fromRGB(255,255,255)
            hb.Transparency = AB.HitboxVis and 0.75 or 1; hb.Parent=workspace
            Debris:AddItem(hb, cfg.life or 0.26)
            for _, p in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = p.Parent and p.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                    blocked = true; hb.Color = Color3.fromRGB(0,255,0)
                    fireBlock(); fireBlock(); fireBlock(); fireBlock()
                    if AB.autoPunch then task.delay(AB.PunchDelay, FirePunch) end
                    hitboxDrag(); break
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end
RunService.Heartbeat:Connect(function()
    if not AB.autoBlock then return end
    RefreshFolders()
    if not KillersFolder then return end
    local killer = KillersFolder:GetChildren()[1]
    if not killer or not killer:IsA("Model") then return end
    local alu = killer:GetAttribute("AbilityLastUsed") or 0
    local au = killer:GetAttribute("AbilitiesUsed") or 0
    if lastALU == nil then lastALU, lastAU = alu, au; return end
    if au > lastAU then blockLocked = true end
    if alu > lastALU then
        if blockLocked then blockLocked = false else makeLastUsedHitbox(killer) end
    end
    lastALU, lastAU = alu, au
end)

local function startAB()
    if abRunning then return end
    abRunning = true
    lastALU, lastAU, blockLocked = nil, nil, false
    RefreshFolders()
    if KillersFolder then
        for _, m in ipairs(KillersFolder:GetChildren()) do if m:IsA("Model") then trackKiller(m) end end
        table.insert(abConns, KillersFolder.ChildAdded:Connect(function(c) if c:IsA("Model") then trackKiller(c) end end))
        table.insert(abConns, KillersFolder.ChildRemoved:Connect(function(c) untrackKiller(c) end))
    end
    table.insert(abConns, RunService.Heartbeat:Connect(abTick))
    Notify("Auto Block ON (sound + anim + last-used)")
end
local function stopAB()
    abRunning = false
    for _, c in ipairs(abConns) do pcall(function() c:Disconnect() end) end
    table.clear(abConns); table.clear(pendingBlocks); table.clear(killersList); table.clear(trackedModels)
    for m in pairs(visuals) do clearVis(m, "Default"); clearVis(m, "Custom") end
    for _, o in ipairs(workspace:GetChildren()) do if o.Name == "AB_LastUsedHB" then o:Destroy() end end
    Notify("Auto Block OFF")
end
local function setFacingMode(mode)
    AB.facingMode = mode
    AB.customRangeSettings.enabled = (mode == "custom")
    Notify("Facing: " .. mode)
end

-- ========== STAMINA (Guesting) ==========
local stamOn, stamConn = false, nil
local Stam = { Min=0, Max=100, Loss=10, Gain=20, SettingsOn=false }
local function applyStamina()
    pcall(function()
        local S = require(ReplicatedStorage.Systems.Character.Game.Sprinting)
        if not S then return end
        if stamOn then S.StaminaLossDisabled = true; S.Stamina = 9999999 end
        if Stam.SettingsOn then
            S.MinStamina = math.clamp(Stam.Min, 0, Stam.Max)
            S.MaxStamina = math.max(Stam.Max, S.MinStamina or 0)
            S.StaminaLoss = math.max(Stam.Loss, 0)
            S.StaminaGain = math.max(Stam.Gain, 0)
        end
    end)
end
local function setInfStam(on)
    stamOn = on
    if stamConn then stamConn:Disconnect(); stamConn = nil end
    if on then
        applyStamina()
        stamConn = RunService.Heartbeat:Connect(applyStamina)
        Notify("Infinite Stamina ON")
    else
        pcall(function()
            local S = require(ReplicatedStorage.Systems.Character.Game.Sprinting)
            S.StaminaLossDisabled = false; S.Stamina = S.MaxStamina or 100
        end)
        Notify("Infinite Stamina OFF")
