-- VELOCITY
--═══════════════════════════════════════════════════════════════════
local _velHistory = setmetatable({}, {__mode = "k"})
local function getHRPVelocity(hrp)
    if not hrp or not hrp.Parent then return Vector3.zero end
    local now = tick()
    local d = _velHistory[hrp]
    if not d then _velHistory[hrp] = {p=hrp.Position, t=now, v=Vector3.zero, s={}}; return Vector3.zero end
    local dt = now - d.t
    if dt > 0.001 then
        local iv = (hrp.Position - d.p) / dt
        table.insert(d.s, iv); if #d.s > 6 then table.remove(d.s, 1) end
        local sum = Vector3.zero
        for _, v in ipairs(d.s) do sum = sum + v end
        d.v = sum / #d.s; d.p = hrp.Position; d.t = now
    end
    return d.v
end
local function predictHRP(hrp, lead)
    if not hrp then return nil end
    local vel = getHRPVelocity(hrp)
    if vel.Magnitude < 0.5 then return hrp.Position end
    return hrp.Position + vel * (lead or 0.2)
end

