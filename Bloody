-- Obsidian UI dependency loader (explicit branch path + readable errors)
local ObsidianRepo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/"
local function LoadObsidianModule(relativePath, moduleName)
    local url = ObsidianRepo .. relativePath
    local okFetch, source = pcall(function()
        return game:HttpGet(url)
    end)
    if not okFetch or type(source) ~= "string" or source == "" then
        error(("Bloodsaken: failed to download %s from %s. Check your connection or try again."):format(moduleName, url), 0)
    end

    local compiler = loadstring or load
    local chunk, compileError = compiler(source)
    if not chunk then
        error(("Bloodsaken: %s could not be compiled: %s"):format(moduleName, tostring(compileError)), 0)
    end

    local okRun, result = pcall(chunk)
    if not okRun or result == nil then
        error(("Bloodsaken: %s failed to initialize: %s"):format(moduleName, tostring(result)), 0)
    end
    return result
end

