local blockSpamThread = nil
local function spamBlock(duration)
    if blockSpamThread then task.cancel(blockSpamThread) end
    blockSpamThread = task.spawn(function()
        local endTime = tick() + duration
        while tick() < endTime do
            fireBlock()
            task.wait(0.001)
        end
        blockSpamThread = nil
    end)
end

local function ClearHitboxes()
    for _, o in ipairs(workspace:GetChildren()) do
        if o:IsA("Part") and (o.Name == "AutoBlockHitbox_Frame" or o.Name == "HDT_Dot") then
            o:Destroy()
        end
    end
end

-- Flex-style hitbox drag (pull local root toward killer briefly)
local function doHitboxDrag(killerRoot)
    if not C.HitboxDrag or not killerRoot then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if (hrp.Position - killerRoot.Position).Magnitude > (C.HitboxDragRange or 30) then return end
    task.spawn(function()
        local part = Instance.new("Part")
        part.Size = Vector3.new(2,2,2)
        part.Transparency = 1
        part.CanCollide = false
        part.Anchored = true
        part.CFrame = hrp.CFrame
        part.Parent = char
        local primary = char.PrimaryPart or hrp
        char.PrimaryPart = part
        local t0 = os.clock()
        while os.clock() - t0 < (C.HitboxDragDuration or 0.3) and C.HitboxDrag and C.AutoBlock do
            if not killerRoot.Parent then break end
            part.CFrame = CFrame.new((killerRoot.CFrame * CFrame.new(0,0,-3)).Position) * hrp.CFrame.Rotation
            hrp.AssemblyLinearVelocity = Vector3.zero
            RunService.PreRender:Wait()
        end
        if part.Parent then part:Destroy() end
        if char.Parent then char.PrimaryPart = primary end
    end)
end

local function makeHitboxAndCheck(killerModel, onDetected)
    if not killerModel or not killerModel.Parent then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
    if not killerRoot then return end
    local hbCfg = getKillerHitbox(killerModel.Name)
    local m = C.HitboxMultiplier or 1
    local size = Vector3.new(
        (hbCfg.width  or C.HitboxWidth)  * m,
        (hbCfg.height or C.HitboxHeight) * m,
        (hbCfg.length or C.HitboxLength) * m
    )
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killerModel}

    task.spawn(function()
        local startTime = tick()
        local blockedOnce = false
        while tick() - startTime < hbCfg.dura do
            if blockedOnce or not C.AutoBlock then break end
            local ckr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not ckr then break end
            local frozenCFrame = ckr.CFrame * CFrame.new(0, 0, -(hbCfg.distance or C.HitboxDistance or 3))

            local hb = Instance.new("Part")
            hb.Name = "AutoBlockHitbox_Frame"
            hb.Transparency = C.ShowHitboxVisual and C.HitboxTransparency or 1
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Anchored = true
            hb.Size = size; hb.Color = C.HitboxColor
            hb.Material = Enum.Material.ForceField
            hb.CFrame = frozenCFrame; hb.Parent = workspace

            local sb
            if C.ShowOutline and C.ShowHitboxVisual then
                sb = Instance.new("SelectionBox")
                sb.Adornee = hb; sb.Color3 = C.HitboxColor
                sb.LineThickness = C.OutlineThickness
                sb.Transparency = C.OutlineTransparency
                sb.Visible = true; sb.Parent = hb
            end
            Debris:AddItem(hb, hbCfg.life)

            local found = false
            for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                    found = true; break
                end
            end
            if found and not blockedOnce then
                blockedOnce = true
                pcall(function()
                    hb.Color = C.HitboxHitColor
                    if sb then sb.Color3 = C.HitboxHitColor end
                end)
                -- Nightsaken balanced: 4 fires + 0.05s spam
                fireBlock(); fireBlock(); fireBlock(); fireBlock()
                spamBlock(0.05)
                if C.HitboxDrag then doHitboxDrag(ckr) end
                if C.AutoPunch then
                    task.delay(0.45, function() FireAbility("Punch") end)
                end
                if onDetected then onDetected() end
                break
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local lastAbilityLastUsed, lastAbilitiesUsed, blockLocked = nil, nil, false
local function checkKillerAttack()
    RefreshFolders()
    if not KillersFolder then return end
    local killer = KillersFolder:GetChildren()[1]
    if not killer or not killer:IsA("Model") then return end
    local curALU = killer:GetAttribute("AbilityLastUsed") or 0
    local curAU  = killer:GetAttribute("AbilitiesUsed") or 0
    if lastAbilityLastUsed == nil then
        lastAbilityLastUsed, lastAbilitiesUsed = curALU, curAU
        return
    end
    if curAU > lastAbilitiesUsed then blockLocked = true end
    if curALU > lastAbilityLastUsed then
        if blockLocked then
            blockLocked = false
        else
            makeHitboxAndCheck(killer, function() end)
        end
    end
    lastAbilityLastUsed, lastAbilitiesUsed = curALU, curAU
end

RunService.Heartbeat:Connect(function()
    if C.AutoBlock then pcall(checkKillerAttack) end
end)

local function setAutoBlock(on)
    C.AutoBlock = on
    if on then
        lastAbilityLastUsed, lastAbilitiesUsed, blockLocked = nil, nil, false
        Notify("Auto Block ON")
    else
        ClearHitboxes()
        Notify("Auto Block OFF")
    end
end

