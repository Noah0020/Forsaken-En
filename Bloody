local AutoBlockState = {
    Enabled = false,
    AutoPunch = false,
    Cooldown = 0.25,
    PunchDelay = 0.1,
    BoxVisible = true,
    BoxDistance = 3,
    BoxWidth = 6,
    BoxHeight = 6,
    BoxLength = 9,
    BoxScale = 1,
    BoxTransparency = 0.35,
    BoxColor = Color3.fromRGB(255, 190, 60),
    LastBlock = 0,
    LastPunch = 0,
}

local AUTO_BLOCK_PROFILES = {
    ["CoolKid"] = { duration = 0.05, width = 5, length = 7, height = 6 },
    ["Slasher"] = { duration = 0.35 },
    ["1x1x1x1"] = { duration = 0.45 },
    ["JohnDoe"] = { duration = 0.45 },
    ["John Doe"] = { duration = 0.45 },
    ["Nosferatu"] = { duration = 0.42 },
    ["Sixer"] = { duration = 0.42, distance = 6 },
    ["Noli"] = { duration = 0.37 },
    ["Azure"] = { duration = 0.35 },
}
local DEFAULT_AUTO_BLOCK_PROFILE = { duration = 0.26 }
local monitoredKillers = setmetatable({}, { __mode = "k" })
local killerConnections = setmetatable({}, { __mode = "k" })
local activeCheckBoxes = setmetatable({}, { __mode = "k" })
local BOX_ADORNMENT_PARENT = CoreGui
pcall(function() if type(gethui) == "function" then BOX_ADORNMENT_PARENT = gethui() end end)

local function getAutoBlockProfile(killerName)
    for name, profile in pairs(AUTO_BLOCK_PROFILES) do
        if string.find(killerName or "", name, 1, true) then return profile end
    end
    return DEFAULT_AUTO_BLOCK_PROFILE
end

local function destroyCheckBox(killer)
    local record = activeCheckBoxes[killer]
    if not record then return end
    activeCheckBoxes[killer] = nil
    pcall(function() if record.Adornment then record.Adornment:Destroy() end end)
    pcall(function() if record.Part then record.Part:Destroy() end end)
end

local function setCheckBoxVisible(record)
    if not record then return end
    local adornment = record.Adornment
    if adornment and adornment.Parent then
        adornment.Visible = AutoBlockState.BoxVisible
        adornment.Transparency = AutoBlockState.BoxTransparency
        adornment.Color3 = AutoBlockState.BoxColor
        adornment.Size = record.Part.Size
    end
end

local function createCheckBox(killer, killerRoot, profile)
    local partSize = Vector3.new(
        AutoBlockState.BoxWidth * ((profile.width or 6) / 6) * AutoBlockState.BoxScale,
        AutoBlockState.BoxHeight * ((profile.height or 6) / 6) * AutoBlockState.BoxScale,
        AutoBlockState.BoxLength * ((profile.length or 9) / 9) * AutoBlockState.BoxScale
    )
    local partCFrame = killerRoot.CFrame * CFrame.new(0, 0, -(profile.distance or AutoBlockState.BoxDistance))
    local existing = activeCheckBoxes[killer]
    if existing and existing.Part and existing.Part.Parent and existing.Adornment and existing.Adornment.Parent then
        existing.Part.Size = partSize
        existing.Part.CFrame = partCFrame
        existing.Adornment.Size = partSize
        setCheckBoxVisible(existing)
        return existing
    end

    local part = Instance.new("Part")
    part.Name = "Doggysaken_BlockCheck_Query"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = true
    part.CastShadow = false
    part.Transparency = 1
    part.Size = partSize
    part.CFrame = partCFrame
    part.Parent = Workspace

    local adornment = Instance.new("BoxHandleAdornment")
    adornment.Name = "Doggysaken_BlockCheck_Visible"
    adornment.Adornee = part
    adornment.AlwaysOnTop = true
    adornment.ZIndex = 10
    adornment.Size = part.Size
    adornment.CFrame = CFrame.new()
    adornment.Color3 = AutoBlockState.BoxColor
    adornment.Transparency = AutoBlockState.BoxTransparency
    adornment.Visible = AutoBlockState.BoxVisible
    adornment.Parent = BOX_ADORNMENT_PARENT

    local record = { Part = part, Adornment = adornment }
    activeCheckBoxes[killer] = record
    return record
end

local function updateAllCheckBoxes()
    local seen = {}
    if AutoBlockState.Enabled then
        for _, killer in ipairs(Killers:GetChildren()) do
            if killer:IsA("Model") then
                local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart") or killer.PrimaryPart
                if root and root:IsA("BasePart") then
                    seen[killer] = true
                    createCheckBox(killer, root, getAutoBlockProfile(killer.Name))
                end
            end
        end
    end
    for killer in pairs(activeCheckBoxes) do
        if not AutoBlockState.Enabled or not seen[killer] or not killer.Parent then
            destroyCheckBox(killer)
        end
    end
end

local function localCharacterInsideBox(queryPart, killerModel)
    local character = LocalPlayer.Character or Character
    if not character or not character.Parent then return false end
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = { killerModel }
    overlap.MaxParts = 100
    local ok, parts = pcall(function() return Workspace:GetPartsInPart(queryPart, overlap) end)
    if not ok or type(parts) ~= "table" then return false end
    for _, part in ipairs(parts) do
        if part and part:IsDescendantOf(character) then return true end
    end
    return false
end

local function attemptAutoPunch(targetRoot)
    if not AutoBlockState.AutoPunch or not targetRoot then return end
    local now = os.clock()
    if now - AutoBlockState.LastPunch < 0.15 then return end
    AutoBlockState.LastPunch = now
    task.spawn(function()
        local confirmed = false
        local ok = pcall(function() confirmed = t6:blocked() == true end)
        if not ok or not confirmed then return end
        task.wait(AutoBlockState.PunchDelay)
        if not AutoBlockState.AutoPunch or not targetRoot or not targetRoot.Parent then return end
        if targetRoot:FindFirstChild("InvincibleFX") or targetRoot:FindFirstChild("StunProtection") then return end
        v65("Punch")
        pcall(function() t11:Aimbot(targetRoot, 1) end)
    end)
end

local function runBoxCheck(killer)
    if not AutoBlockState.Enabled or not killer or not killer.Parent then return end
    local localCharacter = LocalPlayer.Character or Character
    if not localCharacter or localCharacter.Parent ~= Survivors then return end

    local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart") or killer.PrimaryPart
    if not root or not root:IsA("BasePart") then return end
    local now = os.clock()
    if now - AutoBlockState.LastBlock < AutoBlockState.Cooldown then return end

    local profile = getAutoBlockProfile(killer.Name)
    local record = createCheckBox(killer, root, profile)
    local started = os.clock()
    local didBlock = false
    local duration = profile.duration or DEFAULT_AUTO_BLOCK_PROFILE.duration

    task.spawn(function()
        while os.clock() - started < duration do
            if not AutoBlockState.Enabled or not killer.Parent or not root.Parent then break end
            local part = record.Part
            if not part or not part.Parent then break end
            part.Size = Vector3.new(
                AutoBlockState.BoxWidth * ((profile.width or 6) / 6) * AutoBlockState.BoxScale,
                AutoBlockState.BoxHeight * ((profile.height or 6) / 6) * AutoBlockState.BoxScale,
                AutoBlockState.BoxLength * ((profile.length or 9) / 9) * AutoBlockState.BoxScale
            )
            part.CFrame = root.CFrame * CFrame.new(0, 0, -(profile.distance or AutoBlockState.BoxDistance))
            setCheckBoxVisible(record)

            if not didBlock and localCharacterInsideBox(part, killer) then
                local blockTime = os.clock()
                if blockTime - AutoBlockState.LastBlock >= AutoBlockState.Cooldown then
                    didBlock = true
                    AutoBlockState.LastBlock = blockTime
                    v65("Block")
                    task.wait(0.025)
                    v65("Block")
                    attemptAutoPunch(root)
                    break
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function monitorKiller(killer)
    if not killer or not killer:IsA("Model") or killerConnections[killer] then return end
    monitoredKillers[killer] = tonumber(killer:GetAttribute("AbilityLastUsed")) or 0
    local connection = killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        local current = tonumber(killer:GetAttribute("AbilityLastUsed")) or 0
        local previous = monitoredKillers[killer] or 0
        monitoredKillers[killer] = current
        if current > previous then
            local ok, err = pcall(runBoxCheck, killer)
            if not ok then warn("[Doggysaken/AutoBlock] " .. tostring(err)) end
        end
    end)
    killerConnections[killer] = connection
    killer.Destroying:Connect(function()
        if killerConnections[killer] then pcall(function() killerConnections[killer]:Disconnect() end) end
        killerConnections[killer] = nil
        monitoredKillers[killer] = nil
        destroyCheckBox(killer)
    end)
end

for _, killer in ipairs(Killers:GetChildren()) do monitorKiller(killer) end
Killers.ChildAdded:Connect(monitorKiller)
Killers.ChildRemoved:Connect(function(killer)
    if killerConnections[killer] then pcall(function() killerConnections[killer]:Disconnect() end) end
    killerConnections[killer] = nil
    monitoredKillers[killer] = nil
    destroyCheckBox(killer)
end)

