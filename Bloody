local function IsPlayerKiller()
    local c = LP.Character
    if not c then return false end
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if kf and c:IsDescendantOf(kf) then return true end
    return KILLER_NAMES[c:GetAttribute("CharacterName") or c.Name] == true
end

local function extractAnimIds(v, depth)
    depth = depth or 0
    if depth > 6 then return {} end
    local o = {}
    local t = type(v)
    if t == "string" or t == "number" then
        local id = tostring(v):match("%d+")
        if id then table.insert(o, id) end
    elseif t == "table" then
        for _, x in pairs(v) do
            for _, id in ipairs(extractAnimIds(x, depth + 1)) do table.insert(o, id) end
        end
    end
    return o
end

