local function AnySilentOn() for _, c in pairs(SilentAimCfg) do if c.Enabled then return true end end end
local function IdentifyAbility(v)
    if type(v) == "string" then
        local l = v:lower()
        if l:find("corrupt") then return "CorruptNature" end
        if l:find("plasma") then return "PlasmaBeam" end
        if l:find("crystal") then return "CrystalPitch" end
    elseif typeof(v) == "buffer" then
        local size = buffer.len(v); if size > 256 then size = 256 end
        local s = ""
        for i = 0, size - 1 do
            local ok, b = pcall(function() return buffer.readu8(v, i) end)
            if ok and b and b >= 32 and b <= 126 then s = s .. string.char(b) end
        end
        return IdentifyAbility(s)
    elseif type(v) == "table" then
        for _, item in ipairs(v) do local f = IdentifyAbility(item) if f then return f end end
    end
end
local function GetTargetForAbility(name)
    local char = LP.Character; if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
    local kind = name == "CrystalPitch" and "Killers" or "Survivors"
    local folder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild(kind)
    if not folder then return nil end
    local best, bd = nil, 600
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local trg = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if trg and h and h.Health > 0 then
                local d = (trg.Position - hrp.Position).Magnitude
                if d < bd then bd = d; best = trg end
            end
        end
    end
    return best
end
local function GetAimPos(ability, target)
    local cfg = SilentAimCfg[ability]
    if not cfg or not target then return target and target.Position end
    if ability == "CrystalPitch" then
        local look = target.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then flat = Vector3.new(target.Position.X - hrp.Position.X, 0, target.Position.Z - hrp.Position.Z) end
        end
        if flat.Magnitude < 0.01 then flat = Vector3.new(1, 0, 0) else flat = flat.Unit end
        return target.Position + flat * (cfg.ThrowDistance or 4) - Vector3.new(0, cfg.ThrowDown or 2.5, 0)
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return target.Position end
    local tp = target.Position
    local tv = target.AssemblyLinearVelocity or Vector3.zero
    if tv.Magnitude > 150 then tv = tv.Unit * 150 end
    local lead = tp
    for _ = 1, 3 do
        local dist = (lead - hrp.Position).Magnitude
        lead = tp + tv * (dist / math.max(cfg.Speed, 1))
    end
    return lead
end
local function RewriteValue(v, origin, target)
    local t = typeof(v)
    if t == "CFrame" then
        local o = v.Position; local d = target - o
        if d.Magnitude > 0.1 then return CFrame.lookAt(o, o + d.Unit), true end
        return v, false
    elseif t == "Vector3" then
        if v.Magnitude < 5 then
            local d = target - origin
            if d.Magnitude > 0.1 then return d.Unit, true end
        else return target, true end
        return v, false
    elseif type(v) == "table" then
        local sub, mod = table.clone(v), false
        for k, item in pairs(sub) do
            local nv, ch = RewriteValue(item, origin, target)
            if ch then sub[k] = nv mod = true end
        end
        return sub, mod
    end
    return v, false
end
if hasHook then
    local old
    pcall(function()
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if checkcaller() or getnamecallmethod() ~= "FireServer" then return old(self, ...) end
            if typeof(self) ~= "Instance" or not self:IsA("RemoteEvent") then return old(self, ...) end
            if not AnySilentOn() then return old(self, ...) end
            local ok, newArgs = pcall(function()
                local args = { ... }
                local ability
                for _, a in ipairs(args) do ability = IdentifyAbility(a) if ability then break end end
                if not ability or not SilentAimCfg[ability] or not SilentAimCfg[ability].Enabled then return nil end
                local trg = GetTargetForAbility(ability); if not trg then return nil end
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return nil end
                local aimPos = GetAimPos(ability, trg)
                local out, anyMod = {}, false
                for i, a in ipairs(args) do
                    local nv, ch = RewriteValue(a, hrp.Position, aimPos)
                    out[i] = ch and nv or a; anyMod = anyMod or ch
                end
                if anyMod then return out end
                return nil
            end)
            if ok and newArgs then return old(self, table.unpack(newArgs)) end
            return old(self, ...)
        end)
    end)
end

