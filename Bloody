local ESP_HL, ESP_Folder = {}, nil

local function ES_Ensure()
    if ESP_Folder and ESP_Folder.Parent then return ESP_Folder end
    ESP_Folder = Instance.new("Folder")
    ESP_Folder.Name = "FMO_ESP"
    ESP_Folder.Parent = CoreGui
    return ESP_Folder
end

local function ES_Visible(part)
    if not Settings.ESP_WallCheck then return true end
    local cam = Workspace.CurrentCamera
    if not cam or not part then return true end
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = { LocalPlayer.Character }
    local res = Workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, p)
    if not res then return true end
    return res.Instance:IsDescendantOf(part.Parent)
end

local function ES_Apply(model, color)
    local hl = ESP_HL[model]
    if hl and hl.Parent and hl.Adornee == model then
        if hl.FillColor ~= color then
            hl.FillColor = color
            hl.OutlineColor = color
        end
        return
    end
    if hl then pcall(function() hl:Destroy() end); ESP_HL[model] = nil end
    hl = Instance.new("Highlight")
    hl.Adornee = model
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.48
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = ES_Ensure()
    ESP_HL[model] = hl
end

local function ES_Clear(model)
    local h = ESP_HL[model]
    if h then pcall(function() h:Destroy() end); ESP_HL[model] = nil end
end

task.spawn(function()
    local lastItemScan = 0
    local ITEM_SCAN_INTERVAL = 2.1
    while true do
        task.wait(0.32)
        local anyPlayerESP = Settings.ESP_Killer or Settings.ESP_Survivor
        local anyItemESP   = Settings.ESP_Generator or Settings.ESP_Medkit or Settings.ESP_Bloxy
        if not anyPlayerESP and not anyItemESP then
            if next(ESP_HL) then for m in pairs(ESP_HL) do ES_Clear(m) end end
            continue
        end

        local seen = {}
        local pf = Workspace:FindFirstChild("Players")
        if anyPlayerESP and pf then
            if Settings.ESP_Killer then
                local kf = pf:FindFirstChild("Killers")
                if kf then
                    for _, k in ipairs(kf:GetChildren()) do
                        local hrp = k:FindFirstChild("HumanoidRootPart")
                        if hrp and LocalRoot and (hrp.Position - LocalRoot.Position).Magnitude <= Settings.ESP_MaxDist and ES_Visible(hrp) then
                            seen[k] = true
                            ES_Apply(k, Color3.fromRGB(255, 45, 45))
                        end
                    end
                end
            end
            if Settings.ESP_Survivor then
                local sf = pf:FindFirstChild("Survivors")
                if sf then
                    for _, s in ipairs(sf:GetChildren()) do
                        if s ~= LocalCharacter then
                            local hrp = s:FindFirstChild("HumanoidRootPart")
                            if hrp and LocalRoot and (hrp.Position - LocalRoot.Position).Magnitude <= Settings.ESP_MaxDist and ES_Visible(hrp) then
                                seen[s] = true
                                ES_Apply(s, Color3.fromRGB(60, 255, 120))
                            end
                        end
                    end
                end
            end
        end

        local now = os.clock()
        if anyItemESP and (now - lastItemScan) >= ITEM_SCAN_INTERVAL then
            lastItemScan = now
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local n = obj.Name
                    local color
                    if Settings.ESP_Generator and n == "Generator" then color = Color3.fromRGB(255, 230, 40)
                    elseif Settings.ESP_Medkit and n == "Medkit" then color = Color3.fromRGB(255, 110, 180)
                    elseif Settings.ESP_Bloxy and n == "BloxyCola" then color = Color3.fromRGB(40, 160, 255) end
                    if color then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part and LocalRoot and (part.Position - LocalRoot.Position).Magnitude <= Settings.ESP_MaxDist and ES_Visible(part) then
                            seen[obj] = true
                            ES_Apply(obj, color)
                        end
                    end
                end
            end
        else
            for m in pairs(ESP_HL) do
                if m and m.Parent then seen[m] = true end
            end
        end

        for m in pairs(ESP_HL) do
            if not seen[m] or not m.Parent then ES_Clear(m) end
        end
    end
end)

local function ES_Refresh()
    for m in pairs(ESP_HL) do ES_Clear(m) end
end

