local _lastAimTrigger = {}
local AIM_COOLDOWN = 0.8

local function startAimLock(targetPlayer)
    if _aimActive then return end
    local targetChar = targetPlayer and targetPlayer.Character
    if not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    _aimActive = true
    _aimTarget = targetRoot
    _aimStart = tick()

    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum    = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = false end

    if _aimConn then _aimConn:Disconnect() end
    _aimConn = RunService.RenderStepped:Connect(function()
        if not _aimActive or tick() - _aimStart > AUTO_AIM.Duration then
            _aimActive = false
            if _aimConn then _aimConn:Disconnect(); _aimConn = nil end
            if hum then hum.AutoRotate = true end
            return
        end
        if not _aimTarget or not _aimTarget.Parent then
            _aimActive = false
            if _aimConn then _aimConn:Disconnect(); _aimConn = nil end
            if hum then hum.AutoRotate = true end
            return
        end
        local predicted = _aimTarget.Position + _aimTarget.CFrame.LookVector * AUTO_AIM.Prediction
        if AUTO_AIM.Mode == "Camera" then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predicted)
        elseif myRoot then
            myRoot.CFrame = CFrame.lookAt(myRoot.Position, predicted)
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if not AUTO_AIM.Enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    if isAnimMatching(track) then
                        local last = _lastAimTrigger[player]
                        if not last or tick() - last > AIM_COOLDOWN then
                            _lastAimTrigger[player] = tick()
                            startAimLock(player)
                            break
                        end
                    end
                end
            end
        end
    end
end)

