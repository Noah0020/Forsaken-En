local function spawnBlockBox(killer)
    if not AB.enabled or IsPlayerKiller() or not killer then return end
    local root = killer:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local now = tick()
    if now - AB.last < 0.06 then return end
    AB.last = now
    task.spawn(function()
        local elapsed = 0
        local duration = math.clamp(AB.duration, 0.1, 1)
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        op.FilterDescendantsInstances = { killer }
        local fired = false
        while killer.Parent and root.Parent and elapsed < duration and not fired do
            if not AB.enabled or IsPlayerKiller() then return end
            local w, h, l, off = AB.width, AB.height, AB.length, AB.offset
            local part = Instance.new("Part")
            part.Name = "Nos_BlockBox"
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = true
            part.CastShadow = false
            part.Material = Enum.Material.ForceField
            part.Color = AB.color
            part.Transparency = AB.showVisual and AB.transparency or 1
            part.Size = Vector3.new(w, h, l)
            part.CFrame = root.CFrame * CFrame.new(0, 0, off)
            part.Parent = Workspace
            if AB.showVisual then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = part
                sb.Color3 = AB.color
                sb.LineThickness = 0.05
                sb.Parent = part
            end
            Debris:AddItem(part, 0.06)
            for _, hit in ipairs(Workspace:GetPartsInPart(part, op)) do
                local model = hit:FindFirstAncestorOfClass("Model")
                local hum = model and model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(model) == LP then
                    doBlock(killer)
                    fired = true
                    break
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

local function onDetect(killer)
    if not AB.enabled or IsPlayerKiller() or not killer then return end
    spawnBlockBox(killer)
end

local monitored = {}
local function monitorKiller(k)
    if not k or monitored[k] or not k:IsA("Model") then return end
    monitored[k] = true
    local lastAbility = k:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = k:GetAttribute("AbilitiesUsed") or 0
    k:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not AB.enabled or not AB.useAttr or IsPlayerKiller() then return end
        local cur = k:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local curU = k:GetAttribute("AbilitiesUsed") or 0
        if curU > lastUsed then lastUsed = curU; return end
        onDetect(k)
    end)
end

local function hookSound(snd, model)
    if not snd or not snd:IsA("Sound") then return end
    local id = tostring(snd.SoundId):match("%d+")
    if not id or not SOUND_IDS[id] then return end
    local function fire()
        if not AB.enabled or not AB.useAudio or IsPlayerKiller() then return end
        local k = model or snd:FindFirstAncestorOfClass("Model")
        if k then onDetect(k) end
    end
    pcall(function() snd.Played:Connect(fire) end)
    if snd.IsPlaying then task.defer(fire) end
end

local function hookKillerAnim(model)
    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
        if not anim then return end
        anim.AnimationPlayed:Connect(function(track)
            if not AB.enabled or not AB.useAnim or IsPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if id and SLASHER_ANIMS[id] then onDetect(model) end
        end)
    end)
end

task.spawn(function()
