local function onLocalAnimationPlayed(track)
    if not track then return end
    local animation = track.Animation
    local animId = animation and string_match(tostring_ref(animation.AnimationId), "%d+")

    -- Auto Aim listens to the local survivor Animator. Resolve the animation
    -- type by name, then by the game's own animation-ID index.
    local abilityName, abilityKeyword = getAnimationAbilityName(track)
    local mappedM1Type = animId and m1AnimationTypeById[animId]
    local namedM1Type = getM1TypeFromConfigPath(
        tostring_ref(track.Name) .. " " .. tostring_ref(animation and animation.Name or "")
    )
    local isNamedAttack = abilityKeyword ~= nil or namedM1Type ~= nil
    -- The dedicated Two Time stab handler is controlled by the same master
    -- Auto Aim toggle. Keep generic Auto Aim from rotating a second time for
    -- that same stab track.
    local isDedicatedStab = abilityKeyword == "stab" or mappedM1Type == "stab" or namedM1Type == "stab"
    if punchAimEnabled then
        -- One animation-driven Auto Aim path handles regular survivors and Guest.
        -- Two Time stab tracks are handled by the dedicated handler under this
        -- same toggle, not by a second aim pass.
        local shouldAim = not isDedicatedStab and (abilityKeyword ~= nil or mappedM1Type ~= nil or isNamedAttack)
        if shouldAim then
            local now = tick_ref()
            local debounceKey = animId or string.lower(tostring_ref(abilityName or track.Name))
            local previous = lastPunchAimByAnimationId[debounceKey]
            if not previous or now - previous >= punchAimCooldown then
                lastPunchAimByAnimationId[debounceKey] = now
                local killer = getNearestKiller()
                if killer then snapPunchAim(killer) end
            end
        elseif aimDebugUnknownAnimations and animId and not loggedUnknownAimAnimations[animId] then
            loggedUnknownAimAnimations[animId] = true
            warn("[Bloodsaken Aim Tracker] Unmatched local animation ID: " .. animId
                .. " | track=" .. tostring_ref(track.Name)
                .. " | animation=" .. tostring_ref(animation and animation.Name or "?"))
        end
    end

end

local function bindAimAnimator(character)
    if aimAnimatorConnection then
        pcall(function() aimAnimatorConnection:Disconnect() end)
        aimAnimatorConnection = nil
    end
    character = character or lp.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5))
    if animator then aimAnimatorConnection = animator.AnimationPlayed:Connect(onLocalAnimationPlayed) end
end

-- Build the animation-ID index once, then listen to the local survivor Animator.
