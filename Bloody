    crystalY = 1.5,
    mobilePitch = -0.32175055439664219,
    instantCrystal = false,
    dusk = false,
    duskPred = 0.5,
    _crystalHook = nil,
    _duskHook = nil,
}

local function silent_nearestKiller()
    return GetNearestKillerModel()
end

local function installCrystalHook()
    if Silent._crystalHook or not NetworkRF then return end
    if typeof(getcallbackvalue) ~= "function" or typeof(hookfunction) ~= "function" then
        -- fallback: OnClientInvoke overwrite
        local old = NetworkRF.OnClientInvoke
        Silent._crystalHook = old
        NetworkRF.OnClientInvoke = function(...)
            local args = {...}
            if args[1] == "GetCameraCF" and Silent.crystal and not IsPlayerKiller() then
                local killer = silent_nearestKiller()
                local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local cam = Workspace.CurrentCamera
                if killer and my and cam then
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    local hrp = killer:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local position = hrp.Position
                        if hum and hum.MoveDirection.Magnitude > 0.15 then
                            position = position + hum.MoveDirection * Silent.crystalPred
                        end
                        local cframe = CFrame.lookAt(Vector3.zero, (position - my.Position + Vector3.new(0, Silent.crystalY, 0)).Unit)
                        if LP:GetAttribute("Device") == "Mobile" or UserInputService.TouchEnabled then
                            cframe = cframe * CFrame.Angles(Silent.mobilePitch, 0, 0)
                        end
                        return CFrame.new(cam.CFrame.Position) * cframe.Rotation
                    end
                end
            end
            if old then return old(...) end
        end
        return
    end

    Silent._crystalHook = hookfunction(getcallbackvalue(NetworkRF, "OnClientInvoke"), function(...)
        local packed = table.pack(...)
        if ({...})[1] ~= "GetCameraCF" or not Silent.crystal then
            return Silent._crystalHook(table.unpack(packed, 1, packed.n))
        end
        if IsPlayerKiller() then
            return Silent._crystalHook(table.unpack(packed, 1, packed.n))
        end
        local players = Workspace:FindFirstChild("Players")
        players = players and players:FindFirstChild("Killers")
        local humanoidRootPart = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local currentCamera2 = Workspace.CurrentCamera
        if humanoidRootPart and players then
            local huge = math.huge
            local v42 = nil
            for _, child in ipairs(players:GetChildren()) do
                local humanoidRootPart2 = child:FindFirstChild("HumanoidRootPart")
                local humanoid = child:FindFirstChildOfClass("Humanoid")
                if humanoidRootPart2 and humanoid and humanoid.Health > 0 then
                    local magnitude = (humanoidRootPart2.Position - humanoidRootPart.Position).Magnitude
                    if magnitude <= huge then huge = magnitude; v42 = child end
                end
            end
            if v42 then
                local humanoid = v42:FindFirstChildOfClass("Humanoid")
                local position = v42.HumanoidRootPart.Position
                if humanoid and humanoid.MoveDirection.Magnitude > 0.15 then
                    position = position + humanoid.MoveDirection * Silent.crystalPred
                end
                local cframe = CFrame.lookAt(Vector3.zero, (position - humanoidRootPart.Position + Vector3.new(0, Silent.crystalY, 0)).Unit)
                if LP:GetAttribute("Device") == "Mobile" or UserInputService.TouchEnabled then
                    cframe = cframe * CFrame.Angles(Silent.mobilePitch, 0, 0)
                end
                local rotation = cframe.Rotation
                return CFrame.new(currentCamera2.CFrame.Position) * rotation
            end
        end
        return Silent._crystalHook(table.unpack(packed, 1, packed.n))
    end)
end

local function installDuskHook()
    if Silent._duskHook or not NetworkRF then return end
    if typeof(getcallbackvalue) ~= "function" or typeof(hookfunction) ~= "function" then return end
    Silent._duskHook = hookfunction(getcallbackvalue(NetworkRF, "OnClientInvoke"), function(...)
        local packed = table.pack(...)
        if ({...})[1] == "GetMousePosition" and Silent.dusk and not IsPlayerKiller() then
            local killer = silent_nearestKiller()
            if killer then
                local hum = killer:FindFirstChildOfClass("Humanoid")
