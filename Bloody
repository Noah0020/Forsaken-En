local function IsPlayerKiller()
    local c = LP.Character
    if not c then return false end
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if kf and c:IsDescendantOf(kf) then return true end
    return KILLER_NAMES[c:GetAttribute("CharacterName") or c.Name] == true
end

local RemoteEvent, RemoteFunction
pcall(function()
    local m = ReplicatedStorage:FindFirstChild("Modules")
    local n = m and m:FindFirstChild("Network")
    n = n and (n:FindFirstChild("Network") or n)
    if n then
        RemoteEvent = n:FindFirstChild("RemoteEvent")
        RemoteFunction = n:FindFirstChild("RemoteFunction")
    end
end)

local function getRE()
    if RemoteEvent and RemoteEvent.Parent then return RemoteEvent end
    pcall(function() RemoteEvent = ReplicatedStorage.Modules.Network.Network.RemoteEvent end)
    return RemoteEvent
end

local function getRF()
    if RemoteFunction and RemoteFunction.Parent then return RemoteFunction end
    pcall(function() RemoteFunction = ReplicatedStorage.Modules.Network.Network.RemoteFunction end)
    return RemoteFunction
end

local function GetNearestKiller(maxDist)
    local char = LP.Character
    local my = char and char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

local function GetKillersList()
    local out = {}
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return out end
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") then
            local h = m:FindFirstChildOfClass("Humanoid")
            local r = m:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then table.insert(out, m) end
        end
    end
    return out
end

-- HDT Flex
local HDT = { enabled = false, duration = 0.35, speed = 14, range = 30, token = 0 }

local function DragToward(killerRoot)
    if not HDT.enabled or not killerRoot then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if (killerRoot.Position - hrp.Position).Magnitude > (HDT.range or 30) then return end
    HDT.token += 1
    local myToken = HDT.token
    local speed, duration = HDT.speed or 14, HDT.duration or 0.35
    local start = os.clock()
    task.spawn(function()
        while myToken == HDT.token and os.clock() - start < duration do
            local delta = RunService.Heartbeat:Wait()
            if not hrp.Parent or not killerRoot.Parent or not hum.Parent then break end
            local direction = killerRoot.Position - hrp.Position
            direction = Vector3.new(direction.X, 0, direction.Z)
            if direction.Magnitude <= 3 then break end
            local ramp = math.sin(math.pi * (os.clock() - start) / duration)
            pcall(function()
                hum:Move(direction.Unit, false)
                hrp.CFrame = hrp.CFrame + direction.Unit * speed * ramp * delta
                hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + direction.Unit)
            end)
        end
        if hum and hum.Parent then pcall(function() hum:Move(Vector3.zero, false) end) end
    end)
end

local AutoPunch = { enabled = false, delay = 0.45 }

local function FirePunch()
    local re = getRE()
    if not re then return end
    pcall(function() re:FireServer("UseActorAbility", { "Punch" }) end)
end

local function FireBlock(killerRoot)
    if IsPlayerKiller() then return end
    local re = getRE()
    if not re then return end
    if HDT.enabled then
        if killerRoot then
            DragToward(killerRoot)
        else
            local k = GetNearestKiller(HDT.range or 30)
            local kr = k and k:FindFirstChild("HumanoidRootPart")
            if kr then DragToward(kr) end
        end
    end
    pcall(function()
        re:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0Block") })
    end)
    pcall(function()
        re:FireServer("UseActorAbility", { "Block" })
    end)
    if AutoPunch.enabled then
        task.delay(AutoPunch.delay, function()
            if not IsPlayerKiller() then FirePunch() end
        end)
    end
end

