--═══════════════════════════════════════════════════════════════════
-- NORMAL SPATIAL HITBOX (only when FacingMode == "Normal")
--═══════════════════════════════════════════════════════════════════
local function normalSpatialBox(killer, onHit)
    if FacingMode ~= "Normal" then return end
    if IsPlayerKiller() or not killer or killer == LP.Character then return end
    local root = killer:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killer }
    task.spawn(function()
        local elapsed = 0
        while killer.Parent and root.Parent and elapsed < NormalBox.duration do
            if IsPlayerKiller() or not AB.enabled or FacingMode ~= "Normal" then return end
            local part = Instance.new("Part")
            part.Name = "Nos_NormalHitbox"
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.CastShadow = false
            part.Material = Enum.Material.ForceField
            part.Color = NormalBox.color
            part.Transparency = NormalBox.showVisual and NormalBox.transparency or 1
            part.Size = Vector3.new(NormalBox.width, NormalBox.height, NormalBox.length)
            part.CFrame = root.CFrame * CFrame.new(0, 0, NormalBox.offset)
            part.Parent = Workspace
            if NormalBox.showVisual then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = part
                sb.Color3 = NormalBox.color
                sb.LineThickness = 0.03
                sb.Parent = part
            end
            Debris:AddItem(part, 0.05)
            for _, v in ipairs(Workspace:GetPartsInPart(part, op)) do
                local hum = v.Parent and v.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    if AB.delay > 0 then task.wait(AB.delay) end
                    if onHit then onHit() end
                    return
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

--═══════════════════════════════════════════════════════════════════
-- ADVANCED STACK BOXES
-- spawn in front of killer → chain/stack toward player
-- touch player = block
-- fail to reach in extendTime OR killer body overlaps stack = disappear
-- hard maxLife
--═══════════════════════════════════════════════════════════════════
local Stack = {
    active = false,
    parts = {},
    started = 0,
    reached = false,
    killer = nil,
    folder = Instance.new("Folder"),
}
Stack.folder.Name = "Nos_StackBoxes"
Stack.folder.Parent = Workspace

local function clearStack()
    Stack.active = false
    Stack.reached = false
    Stack.killer = nil
    for _, p in ipairs(Stack.parts) do
        pcall(function() p:Destroy() end)
    end
    Stack.parts = {}
end

local function makeStackPart()
    local p = Instance.new("Part")
    p.Name = "StackBox"
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.ForceField
    p.Color = StackBox.color
    p.Transparency = StackBox.showVisual and StackBox.fillT or 1
    p.Size = StackBox.size
    p.Parent = Stack.folder
    local sb = Instance.new("SelectionBox")
    sb.Adornee = p
    sb.Color3 = StackBox.color
    sb.LineThickness = 0.05
    sb.Parent = p
    return p
end

local function startStack(killer)
    if FacingMode ~= "Advanced" or not AB.enabled then return end
    if IsPlayerKiller() or not killer then return end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    local pr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not kr or not pr then return end

    -- only start if player is within reach
    local front = kr.Position + kr.CFrame.LookVector * 3
    if (pr.Position - front).Magnitude > StackBox.maxReach then return end

    clearStack()
    Stack.active = true
    Stack.started = os.clock()
    Stack.reached = false
    Stack.killer = killer

    local n = math.clamp(math.floor(StackBox.count), 1, 12)
    for i = 1, n do
        local p = makeStackPart()
        -- start stacked tight in front of killer
        local t = (i - 0.5) / n
        p.CFrame = CFrame.new(front + kr.CFrame.LookVector * (t * 1.5))
        table.insert(Stack.parts, p)
    end
end

RunService.Heartbeat:Connect(function(dt)
    if not Stack.active or FacingMode ~= "Advanced" then
        if #Stack.parts > 0 and not Stack.active then
            -- nothing
        end
        if FacingMode ~= "Advanced" then
            clearStack()
        end
        return
    end

    local killer = Stack.killer
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    local pr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local age = os.clock() - Stack.started

    if not kr or not pr or not killer.Parent then
        clearStack()
        return
    end

    -- hard lifetime
    if age >= StackBox.maxLife then
        clearStack()
        return
    end

    -- failed to reach player in time
    if not Stack.reached and age >= StackBox.extendTime then
        clearStack()
        return
    end

    local origin = kr.Position + kr.CFrame.LookVector * 2.5
    local goal = pr.Position
    local toPlayer = goal - origin
    local dist = toPlayer.Magnitude
    if dist < 0.05 then dist = 0.05 end
    local dir = toPlayer / dist

    -- keep chain relatively in front of killer (prefer look direction blend)
    local look = kr.CFrame.LookVector
    local blend = (look + dir).Unit
    if blend.Magnitude < 0.01 then blend = dir end

    local n = #Stack.parts
    local step = math.min(dist, StackBox.maxReach) / math.max(n, 1)
    local extend = math.clamp(age / math.max(StackBox.extendTime, 0.05), 0, 1)
    local travel = math.min(dist, StackBox.maxReach) * extend

    local killerTouched = false
    local playerTouched = false

    for i, p in ipairs(Stack.parts) do
        if p.Parent then
            local along = math.min((i - 0.5) / n * travel, travel)
            local pos = origin + blend * along
            pos = pos + Vector3.new(0, (i - 1) * 0.05, 0)
            p.Size = StackBox.size
            p.CFrame = CFrame.lookAt(pos, pos + blend)
            p.Transparency = StackBox.showVisual and StackBox.fillT or 1
            local sb = p:FindFirstChildOfClass("SelectionBox")
            if sb then sb.Visible = StackBox.showVisual end

            local op = OverlapParams.new()
            op.FilterType = Enum.RaycastFilterType.Exclude
            op.FilterDescendantsInstances = { LP.Character }
            for _, hit in ipairs(Workspace:GetPartsInPart(p, op)) do
                local model = hit:FindFirstAncestorOfClass("Model")
                if model == killer then
                    killerTouched = true
                end
            end

            local op2 = OverlapParams.new()
            op2.FilterType = Enum.RaycastFilterType.Exclude
            op2.FilterDescendantsInstances = { killer }
            for _, hit in ipairs(Workspace:GetPartsInPart(p, op2)) do
                local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
                if hum and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    playerTouched = true
                end
            end
        end
    end

    if playerTouched then
        Stack.reached = true
        for _, p in ipairs(Stack.parts) do
            p.Color = StackBox.validColor
            local sb = p:FindFirstChildOfClass("SelectionBox")
            if sb then sb.Color3 = StackBox.validColor end
        end
        if AB.enabled then
            local now = tick()
            if now - AB.last > 0.1 then
                AB.last = now
                if AB.delay > 0 then task.wait(AB.delay) end
                FireBlock()
            end
        end
        clearStack()
        return
    end

    -- killer body ate the stack → dissolve
    if killerTouched then
        clearStack()
        return
    end
end)

--═══════════════════════════════════════════════════════════════════
-- AUTO BLOCK TRIGGERS
--═══════════════════════════════════════════════════════════════════
local function triggerBlock(killer)
    if not AB.enabled or IsPlayerKiller() then return end
    local now = tick()
    if now - AB.last < 0.08 then return end
    if FacingMode == "Advanced" then
        startStack(killer)
        return
    end
    if FacingMode == "Normal" then
        AB.last = now
        normalSpatialBox(killer, FireBlock)
        return
    end
    -- None: still fire block on ability without facing gate
    AB.last = now
    if AB.delay > 0 then
        task.delay(AB.delay, FireBlock)
    else
        FireBlock()
    end
end

local monitored = {}
local function monitorKiller(k)
    if not k or monitored[k] or not k:IsA("Model") or k == LP.Character then return end
    monitored[k] = true
    local lastAbility = k:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = k:GetAttribute("AbilitiesUsed") or 0
    k:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not AB.enabled or IsPlayerKiller() then return end
        local cur = k:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local curU = k:GetAttribute("AbilitiesUsed") or 0
        if curU > lastUsed then lastUsed = curU; return end
        triggerBlock(k)
    end)
end

task.spawn(function()
    while true do
        task.wait(1)
        if AB.enabled and not IsPlayerKiller() then
            local kf = Workspace:FindFirstChild("Players")
            kf = kf and kf:FindFirstChild("Killers")
            if kf then
                for _, k in ipairs(kf:GetChildren()) do
                    if k:IsA("Model") then monitorKiller(k) end
                end
            end
        end
    end
end)

