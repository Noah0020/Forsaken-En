-- SK8
--═══════════════════════════════════════════════════════════
do
    local SP=LP local SW=Workspace local SR=RunService local SRS=ReplicatedStorage local SUI=UserInputService
    local atEnabled=false local atMonitors={} local atConn=nil
    local function atFolder() return SRS:WaitForChild("Assets"):WaitForChild("Survivors"):WaitForChild("Veeronica"):WaitForChild("Behavior") end
    local function atSprintBtn() return SP.PlayerGui:WaitForChild("MainUI"):WaitForChild("SprintingButton") end
    local atB=nil task.spawn(function() local ok,f=pcall(atFolder) if ok and f then atB=f end end)
    local function atMon(h)
        if not h or atMonitors[h] then return end
        local cs={} local prev=false
        local function cl() for _,c in ipairs(cs) do if c and c.Connected then c:Disconnect() end end atMonitors[h]=nil end
        local function chk()
            if not atEnabled then return end
            if not h or not h.Parent then cl(); return end
            local ad=h.Adornee local c=SP.Character local cur=ad and c and (ad==c or ad:IsDescendantOf(c)) and true or false
            if prev~=cur and cur then local ok,btn=pcall(atSprintBtn) if ok and btn then for _,v in pairs(getconnections(btn.MouseButton1Down)) do pcall(function() v:Fire() end) end end end
            prev=cur
        end
        local c1=h:GetPropertyChangedSignal("Adornee"):Connect(chk) if c1 then table.insert(cs,c1) end
        table.insert(cs,h.AncestryChanged:Connect(function(_,p) if not p then cl() else chk() end end))
        atMonitors[h]=cl task.spawn(chk)
    end
    local function atStart()
        if atConn or not atB then return end
        for _,d in ipairs(atB:GetDescendants()) do if d:IsA("Highlight") then atMon(d) end end
        atConn=atB.DescendantAdded:Connect(function(c) if c:IsA("Highlight") then atMon(c) end end)
    end
    local function atStop()
        if atConn and atConn.Connected then atConn:Disconnect() end atConn=nil
        for _,cl in pairs(atMonitors) do if type(cl)=="function" then pcall(cl) end end atMonitors={}
    end
    local sk8CtrlEnabled=false local sk8CtrlActive=false local sk8CtrlConn=nil local sk8Saved={}
    local function sk8GetHum() return SP.Character and SP.Character:FindFirstChildOfClass("Humanoid") end
    local SK8_SPEED=60
    local function sk8Start()
        if sk8CtrlActive then return end
        local h=sk8GetHum(); if not h then return end
        sk8CtrlActive=true sk8Saved[h]={WalkSpeed=h.WalkSpeed,AutoRotate=h.AutoRotate}
        pcall(function() h.WalkSpeed=SK8_SPEED; h.AutoRotate=false end)
        SUI.MouseBehavior=Enum.MouseBehavior.LockCenter
        sk8CtrlConn=SR.RenderStepped:Connect(function()
            local hum=sk8GetHum() local root=hum and hum.Parent and hum.Parent:FindFirstChild("HumanoidRootPart")
            if not hum or not root then return end
            pcall(function() hum.WalkSpeed=SK8_SPEED; hum.AutoRotate=false end)
            local dir=root.CFrame.LookVector local flat=Vector3.new(dir.X,0,dir.Z)
            if flat.Magnitude>0 then hum:Move(flat.Unit) end
            root.CFrame=CFrame.new(root.Position,root.Position+workspace.CurrentCamera.CFrame.LookVector)
        end)
    end
    local function sk8Stop()
        if not sk8CtrlActive then return end
        sk8CtrlActive=false
        if sk8CtrlConn then pcall(function() sk8CtrlConn:Disconnect() end) sk8CtrlConn=nil end
        SUI.MouseBehavior=Enum.MouseBehavior.Default
        local h=sk8GetHum()
        if h then local s=sk8Saved[h] if s then pcall(function() h.WalkSpeed=s.WalkSpeed; h.AutoRotate=s.AutoRotate; h:Move(Vector3.new()) end) end sk8Saved[h]=nil end
    end
    local charge={["117058860640843"]=true}
    local function isCharging()
        local h=sk8GetHum(); if not h then return false end
        for _,t in ipairs(h:GetPlayingAnimationTracks()) do local ok,id=pcall(function() return tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+") end) if ok and id and charge[id] then return true end end
        return false
    end
    SR.RenderStepped:Connect(function()
        if not sk8CtrlEnabled then if sk8CtrlActive then sk8Stop() end return end
        if not sk8GetHum() then if sk8CtrlActive then sk8Stop() end return end
        if isCharging() then if not sk8CtrlActive then sk8Start() end else if sk8CtrlActive then sk8Stop() end end
    end)
    local sprayAnim="96618767275101" local sprayOn=false local sprayPhase=0 local sprayBase=nil local spraySpeed=4.5
    local function isSpraying()
        local h=sk8GetHum(); if not h then return false end
        for _,t in ipairs(h:GetPlayingAnimationTracks()) do local ok,id=pcall(function() return tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+") end) if ok and id==sprayAnim then return true end end
        return false
    end
    SR.RenderStepped:Connect(function(dt)
        if not sprayOn or not isSpraying() then sprayPhase=0 sprayBase=nil return end
        local hrp=SP.Character and SP.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        if not sprayBase or math.abs(math.sin(sprayPhase))<0.05 then sprayBase=hrp.CFrame end
        sprayPhase=sprayPhase+dt*(math.pi*spraySpeed)
        local off=math.sin(sprayPhase)*2
        hrp.CFrame=sprayBase+(sprayBase.LookVector*(-off))
    end)
    local sk8Sec=Tabs.Sk8:Section({Title="Tricks"})
    sk8Sec:Toggle({Title="Auto Trick", Value=false, Callback=function(s) atEnabled=s if s then if not atB then local ok,f=pcall(atFolder) if ok and f then atB=f end end atStart() else atStop() end end})
    sk8Sec:Toggle({Title="Enable SK8 Control", Value=false, Callback=function(s) sk8CtrlEnabled=s if not s and sk8CtrlActive then sk8Stop() end end})
    sk8Sec:Toggle({Title="Enable Fast Spray", Value=false, Callback=function(s) sprayOn=s if not s then sprayPhase=0 sprayBase=nil end end})
    sk8Sec:Slider({Title="Spray Speed", Value={Min=0.5,Max=10,Default=4.5,Rounding=1}, Callback=function(v) spraySpeed=v end})
end

