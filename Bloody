local ConeCfg = {
    NormalAngle = 35, MaxAngle = 100, ExpansionSpeed = 180, RecoverySpeed = 90,
    Range = 18, Segments = 36,
    Color = Color3.fromRGB(255, 55, 55), ColorHit = Color3.fromRGB(80, 255, 80),
    Transparency = 0.65, Thickness = 0.12, YTolerance = 8,
    WindowDuration = 0.5, ShowBox = true,
}
local ConeState, blockPerKiller, activeBlocks = {}, {}, {}

local function hasHelpless()
    if LP:GetAttribute("Helpless") then return true end
    local c = LP.Character; if not c then return false end
    if c:GetAttribute("Helpless") or c:FindFirstChild("Helpless") then return true end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h and (h:GetAttribute("Helpless") or h:FindFirstChild("Helpless")) then return true end
    for _, name in ipairs({ "StatusEffects", "Effects", "Statuses", "Debuffs" }) do
        local cont = c:FindFirstChild(name)
        if cont and cont:FindFirstChild("Helpless") then return true end
    end
    local ing = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Ingame")
    if ing then
        local sf = ing:FindFirstChild("StatusEffects") or ing:FindFirstChild("Status")
        if sf then
            local me = sf:FindFirstChild(LP.Name) or sf:FindFirstChild(tostring(LP.UserId))
            if me and me:FindFirstChild("Helpless") then return true end
        end
        local mi = ing:FindFirstChild(LP.Name) or ing:FindFirstChild(tostring(LP.UserId))
        if mi and mi:FindFirstChild("Helpless") then return true end
    end
    local pd = LP:FindFirstChild("PlayerData")
    if pd then
        local st = pd:FindFirstChild("Status", true)
        if st and st:FindFirstChild("Helpless") then return true end
    end
    return false
end

local function getCone(killer)
    local s = ConeState[killer]
    if s and s.folder and s.folder.Parent and #s.parts == ConeCfg.Segments then return s end
    if s and s.folder then pcall(function() s.folder:Destroy() end) end
    local f = Instance.new("Folder"); f.Name = "Ck_FacingCone"; f.Parent = Workspace
    local parts = {}
    for i = 1, ConeCfg.Segments do
        local p = Instance.new("Part")
        p.Name = "ConeSegment"; p.Anchored = true
        p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
        p.Material = Enum.Material.Neon; p.Color = ConeCfg.Color
        p.Transparency = 1; p.Size = Vector3.new(ConeCfg.Thickness, 0.06, 0.5)
        p.Parent = f; parts[i] = p
    end
    s = { folder = f, parts = parts, currentAngle = ConeCfg.NormalAngle, prevYaw = nil, turnDir = 0 }
    ConeState[killer] = s
    return s
end
local function hideCone(s) for _, p in ipairs(s.parts) do if p and p.Parent then p.Transparency = 1 end end end
local function destroyCone(k) local s = ConeState[k] if s and s.folder then pcall(function() s.folder:Destroy() end) end ConeState[k] = nil end
local function updateCone(s, root, dt, colorOverride)
    local cf = root.CFrame; local look = cf.LookVector; local yaw = math.atan2(-look.X, -look.Z)
    if s.prevYaw then
        local diff = math.atan2(math.sin(yaw - s.prevYaw), math.cos(yaw - s.prevYaw))
        if math.abs(diff) > 0.0005 then
            s.turnDir = diff > 0 and 1 or -1
            s.currentAngle = math.min(ConeCfg.MaxAngle, s.currentAngle + math.abs(diff) * ConeCfg.ExpansionSpeed)
        else
            s.currentAngle = math.max(ConeCfg.NormalAngle, s.currentAngle - ConeCfg.RecoverySpeed * dt)
        end
    end
    s.prevYaw = yaw
    local half = ConeCfg.NormalAngle / 2
    local lA, rA = half, half
    if s.turnDir == 1 then lA = s.currentAngle - half elseif s.turnDir == -1 then rA = s.currentAngle - half end
    local total = lA + rA; local segs = ConeCfg.Segments; local range = ConeCfg.Range
    local center = root.Position; local pLen = (range / segs) * 1.6
    for i, p in ipairs(s.parts) do
        local alpha = (i - 0.5) / segs
        local offset = math.rad(-lA + total * alpha)
        local dir = CFrame.Angles(0, yaw + offset, 0).LookVector
        local wp = center + dir * range
        p.Size = Vector3.new(ConeCfg.Thickness, 0.06, pLen)
        p.CFrame = CFrame.lookAt(Vector3.new(wp.X, center.Y + 0.15, wp.Z), Vector3.new(wp.X + dir.X, center.Y + 0.15, wp.Z + dir.Z))
        p.Color = colorOverride or ConeCfg.Color; p.Transparency = ConeCfg.Transparency
    end
    return yaw, lA, rA
end
local function inCone(root, pos, yaw, lA, rA)
    local kp = root.Position
    if math.abs(pos.Y - kp.Y) > ConeCfg.YTolerance then return false end
    local to = pos - kp; local flat = Vector3.new(to.X, 0, to.Z)
    local dist = flat.Magnitude
    if dist < 0.5 or dist > ConeCfg.Range then return false end
    local pYaw = math.atan2(-flat.X, -flat.Z)
    local diff = math.atan2(math.sin(pYaw - yaw), math.cos(pYaw - yaw))
    return diff >= -math.rad(lA) and diff <= math.rad(rA)
end

local BlockRemote = nil
local function getBlockRemote()
