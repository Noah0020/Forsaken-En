--======= STAMINA =======
local Stam = { Inf = false, Edit = false, Min = 0, Max = 100, Loss = 0, Gain = 50, Conn = nil }

local function applyStamina()
    pcall(function()
        local S = require(Rep.Systems.Character.Game.Sprinting)
        if not S then return end
        if Stam.Inf then
            S.StaminaLossDisabled = true
            S.Stamina = 999999
        end
        if Stam.Edit then
            S.MinStamina = math.clamp(Stam.Min, 0, Stam.Max)
            S.MaxStamina = math.max(Stam.Max, S.MinStamina or 0)
            S.StaminaLoss = math.max(Stam.Loss, 0)
            S.StaminaGain = math.max(Stam.Gain, 0)
        end
    end)
end

local function setInfStamina(on)
    Stam.Inf = on
    if Stam.Conn then Stam.Conn:Disconnect() Stam.Conn = nil end
    if on or Stam.Edit then
        Stam.Conn = RS.Heartbeat:Connect(applyStamina)
        applyStamina()
    end
    if not on then
        pcall(function()
            local S = require(Rep.Systems.Character.Game.Sprinting)
            if S then
                S.StaminaLossDisabled = false
                S.Stamina = S.MaxStamina or 100
            end
        end)
    end
end

local function setStaminaEdit(on)
    Stam.Edit = on
    if Stam.Conn then Stam.Conn:Disconnect() Stam.Conn = nil end
    if on or Stam.Inf then
        Stam.Conn = RS.Heartbeat:Connect(applyStamina)
        applyStamina()
    end
end



