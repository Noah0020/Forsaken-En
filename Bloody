-- KILLER WATCHDOG
--═══════════════════════════════════════════════════════════════════
task.spawn(function()
    local wasKiller = false
    local snapshot = nil

    while not _ShuttingDown do
        task.wait(0.3)
        local nowKiller = IsPlayerKiller()

        if nowKiller and not wasKiller then
            snapshot = {
                autoBlock = _G.AutoBlockEnabled,
                hdt       = HDT.enabled,
                stab      = stabState.enabled,
                aim       = GAim.enabled,
                crystal   = SilentGH.crystal,
                dusk      = SilentGH.dusk,
                veeAT     = VeerState.atRunning,
                veeSkate  = Vee.SkateControl,
            }

            if _G.AutoBlockEnabled then _G.AutoBlockEnabled = false; pcall(function() Options.AutoBlockToggle:Set(false) end) end
            if HDT.enabled then HDT_Stop(); pcall(function() Options.HDT_En_T:Set(false) end) end
            if stabState.enabled then stabState.enabled = false; pcall(function() Options.EnableStabLerp:Set(false) end) end
            if GAim.enabled then GAim.enabled = false; pcall(function() Options.SA_En_T:Set(false) end) end
            SilentGH.crystal = false; SilentGH.dusk = false
            pcall(function() Options.Jane_Aim_T:Set(false) end)
            pcall(function() Options.Dusk_En_T:Set(false) end)
            if VeerState.atRunning then VeerATStop(); pcall(function() Options.Vee_AT_T:Set(false) end) end

            Library:Notify({Title = "Perfect", Description = "Survivor features suspended (Killer). Will restore on Survivor respawn.", Time = 5})

        elseif not nowKiller and wasKiller and snapshot then
            task.wait(0.5)
            if snapshot.autoBlock then
                _G.AutoBlockEnabled = true
                pcall(function() Options.AutoBlockToggle:Set(true) end)
                pcall(EnableAutoBlock)
            end
            if snapshot.hdt then HDT.enabled = true; pcall(function() Options.HDT_En_T:Set(true) end) end
            if snapshot.stab then stabState.enabled = true; pcall(function() Options.EnableStabLerp:Set(true) end) end
            if snapshot.aim then GAim.enabled = true; pcall(function() Options.SA_En_T:Set(true) end) end
            if snapshot.crystal then SilentGH.crystal = true; pcall(function() Options.Jane_Aim_T:Set(true) end) end
            if snapshot.dusk then SilentGH.dusk = true; pcall(function() Options.Dusk_En_T:Set(true) end) end
            if snapshot.veeAT then Vee.AutoTrick = true; pcall(VeerATStart); pcall(function() Options.Vee_AT_T:Set(true) end) end
            if snapshot.veeSkate then Vee.SkateControl = true; pcall(Vee_SkateControl, true); pcall(function() Options.Vee_SkateControl_T:Set(true) end) end

            local restored = {}
            if snapshot.autoBlock then table.insert(restored, "AutoBlock") end
            if snapshot.hdt then table.insert(restored, "HDT") end
            if snapshot.stab then table.insert(restored, "Stab") end
            if snapshot.aim then table.insert(restored, "Aimbot") end
            if snapshot.crystal then table.insert(restored, "Crystal") end
            if snapshot.dusk then table.insert(restored, "Plasma") end
            if snapshot.veeAT then table.insert(restored, "Vee-AutoTrick") end
            if snapshot.veeSkate then table.insert(restored, "Vee-SkateControl") end

            Library:Notify({
                Title = "Perfect",
                Description = #restored > 0 and ("Restored: " .. table.concat(restored, ", ")) or "Back as Survivor (nothing to restore)",
                Time = 5,
            })
            snapshot = nil
        end

        wasKiller = nowKiller
    end
end)

