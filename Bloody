local elliot = { enabled=false, conn=nil, autoRotBak=nil, aimType="Camera + Character", targetMode="Low HP",
    throwDur=0.6, isThrowing=false, throwTS=0, requireAnim=true, hum=nil, hrp=nil, lastAimTime=0,
    smoothness=0.15, predDist=5, throwForce=80, throwAnimId="114155003741146" }
local function elliot_setupChar(char)
    elliot.hum = char:WaitForChild("Humanoid", 3); elliot.hrp = char:WaitForChild("HumanoidRootPart", 3)
    if elliot.hum then
        local an = elliot.hum:FindFirstChildOfClass("Animator")
        if an then
            an.AnimationPlayed:Connect(function(track)
                if not track or not track.Animation then return end
                local aid = ""; pcall(function() aid = tostring(track.Animation.AnimationId) end)
