local silentFace, faceConn = false, nil
local function faceNearest()
    local killer, myRoot = getNearestKillerRoot()
    if not killer or not myRoot then return end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    if not kr then return end
    local dir = Vector3.new(kr.Position.X - myRoot.Position.X, 0, kr.Position.Z - myRoot.Position.Z)
    if dir.Magnitude < 0.1 then return end
    myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + dir.Unit)
end
local function setSilentFace(on)
    silentFace = on
    if faceConn then faceConn:Disconnect(); faceConn = nil end
    if on then
        faceConn = RunService.RenderStepped:Connect(function()
            if silentFace then faceNearest() end
        end)
        Notify("Soft Face Aim ON")
    end
end

local shed = {on=false, dist=10, cd=1.1, last={}, conn=nil}
local function setShed(on)
    shed.on = on
    if shed.conn then shed.conn:Disconnect(); shed.conn = nil end
    if on then
        shed.conn = RunService.Heartbeat:Connect(function()
            if not shed.on then return end
            local char = LocalPlayer.Character
            if not char or char.Name ~= "Shedletsky" then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            RefreshFolders()
            if not KillersFolder then return end
            local now = os.clock()
            for _, v in pairs(KillersFolder:GetChildren()) do
                if v:IsA("Model") then
                    local kr = v:FindFirstChild("HumanoidRootPart")
                    if kr and (hrp.Position - kr.Position).Magnitude <= shed.dist then
                        if now - (shed.last[v] or 0) >= shed.cd then
                            shed.last[v] = now
                            faceNearest(); FireAbility("Slash")
                        end
                    end
                end
            end
        end)
        Notify("Shedletsky Auto Slash ON")
    end
end

