    if Stam.thread then pcall(task.cancel, Stam.thread); Stam.thread = nil end
end
local function Stam_Restore()
    if Stam.mod and Stam.saved then
        pcall(function()
            local m, s = Stam.mod, Stam.saved
            if s.MaxStamina ~= nil then m.MaxStamina = s.MaxStamina end
            if s.SprintSpeed ~= nil then m.SprintSpeed = s.SprintSpeed end
            if s.StaminaGain ~= nil then m.StaminaGain = s.StaminaGain end
