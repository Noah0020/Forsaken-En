        local a = pool[math.random(#pool)]; local b = pool[math.random(#pool)]
        if a==b then return randName() end
        return a..b.."_"..math.random(101) end
    local function swapLabel(o)
        if (o:IsA("TextLabel") or o:IsA("TextBox") or o:IsA("TextButton")) and o.Text then
            if string.find(o.Text, LP.Name) then
                o.Text = string.gsub(o.Text, LP.Name, suffixNew)
            elseif string.find(o.Text, suffixOld) then
                o.Text = string.gsub(o.Text, suffixOld, suffixNew) end end end
    local function applyName(t)
        if not t or t=="" or t==" " then return end
        for _,c in ipairs(nameConns) do c:Disconnect() end
        nameConns = {}
        suffixOld = suffixNew; suffixNew = t
        for _,d in pairs(PlayerGui:GetDescendants()) do tick_(); swapLabel(d) end
        for _,d in pairs(CoreGui:GetDescendants()) do tick_(); swapLabel(d) end
        table.insert(nameConns, PlayerGui.DescendantAdded:Connect(swapLabel))
        table.insert(nameConns, CoreGui.DescendantAdded:Connect(swapLabel)) end

