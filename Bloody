local function AttachAnimWatcher(char)
    if NA.animConn then pcall(function() NA.animConn:Disconnect() end); NA.animConn = nil end
    local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
    local animator = hum:WaitForChild("Animator", 5); if not animator then return end
    NA.animConn = animator.AnimationPlayed:Connect(function(track)
        local anim = track.Animation
        if not anim then return end
        local aid = tostring(anim.AnimationId):match("%d+")
        if not aid then return end
        if Settings.PredictionDebug then
            print(("[Cupcake Anim] id=%s name=%q len=%.2f"):format(aid, tostring(anim.Name or ""), track.Length or 0))
        end
        if STUN_ANIM_IDS[aid] then
            if Settings.PredictionDebug then
                print(("[Cupcake AIM] STUN → id=%s ability=%s"):format(aid, STUN_ANIM_IDS[aid]))
            end
            fireStunAim(track)
        elseif PunchAnims["rbxassetid://"..aid] then
            if Settings.PredictionDebug then
                print(("[Cupcake AIM] PUNCH → id=%s"):format(aid))
            end
            firePunchAim(track)
        end
    end)
end

local function AttachSoundWatcher(char)
    for _, c in ipairs(NA.soundConns) do pcall(function() c:Disconnect() end) end
    NA.soundConns = {}
    local function hook(s)
        if not s:IsA("Sound") then return end
        local conn = s.Playing:Connect(function()
            if not NA.active then return end
            local sid = tostring(s.SoundId):match("%d+")
            if not sid then return end
            if Settings.PredictionDebug then
                print(("[Cupcake Sound] id=%s name=%q len=%.2f"):format(sid, tostring(s.Name or ""), s.TimeLength or 0))
            end
            if STUN_SOUND_IDS[sid] then
                if Settings.PredictionDebug then
                    print(("[Cupcake AIM] STUN (sound) → id=%s ability=%s"):format(sid, STUN_SOUND_IDS[sid]))
                end
                local dur = math.max(0.5, (s.TimeLength or 0.5) + 0.15)
                local wantCam = (Settings.AIM_Mode == "Camera" or Settings.AIM_Mode == "Both")
                task.spawn(function() HardLockFacing(dur, Settings.AIM_Prediction, wantCam) end)
            end
        end)
        table.insert(NA.soundConns, conn)
    end
    for _, d in ipairs(char:GetDescendants()) do hook(d) end
    table.insert(NA.soundConns, char.DescendantAdded:Connect(function(d) hook(d) end))
end

