                    if not d:IsDescendantOf(PlayersContainer) or not d:IsDescendantOf(Players) then
                        fireproximityprompt(prompt) end
                    notify("Dogsaken","Grabbed "..d.Name,2) end
                task.wait() end end
        Character:PivotTo(pivot) end
    local T = TabUtil:Section({Title="Tools", Box=true, Opened=true})
    T:Button({Title="Grab all tools",Callback=function() task.wait(); grabTools() end})
    T:Keybind({Title="Keybind",Value=Enum.KeyCode.B,Callback=function()
