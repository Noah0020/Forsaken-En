local jd = { enabled=false, aimbotOn=false, patched=false, aimOffset=1.5, prediction=2.5 }
local function jd_predictPos(killerModel, predStuds, yOffset)
    if not killerModel then return nil end
    local hrp=killerModel:FindFirstChild("HumanoidRootPart")
    local hum=killerModel:FindFirstChildOfClass("Humanoid")
    if not hrp then return nil end
    local pos=hrp.Position
    if hum and hum.MoveDirection.Magnitude>0.15 then pos=pos+hum.MoveDirection.Unit*(predStuds or 0) end
    return pos+Vector3.new(0, yOffset or 0, 0)
end
local function jd_applyPatch()
    if jd.patched or not NetworkRF then return end
    if not rfDispatch.installed then pcall(function() rfDispatch:install(NetworkRF) end) end
    rfDispatch:register("jd", function(reqName,...)
        if IsPlayerKiller() or not (jd.enabled and jd.aimbotOn) then return nil end
        local killer=GetNearestKillerModel(); if not killer then return nil end
        local my=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if not my then return nil end
        if reqName=="GetCameraCF" then
            local pos=jd_predictPos(killer, jd.prediction, jd.aimOffset); if not pos then return nil end
            local dir=pos-my.Position; if dir.Magnitude<0.01 then return nil end
            local look=CFrame.lookAt(Vector3.zero, dir.Unit)
            local cam=Workspace.CurrentCamera
            if cam then return CFrame.new(cam.CFrame.Position)*look.Rotation end
        elseif reqName=="GetMousePosition" then
            return jd_predictPos(killer, jd.prediction, jd.aimOffset)
        end
        return nil
    end)
    jd.patched=true
end
local function jd_removePatch()
    if not jd.patched then return end
    pcall(function() rfDispatch:unregister("jd") end); jd.patched=false
end

local dusekkar = { enabled=false, prediction=0.5, aimOffset=0 }
if NetworkRF then
    rfDispatch:register("plasma", function(reqName,...)
        if IsPlayerKiller() or not dusekkar.enabled or reqName~="GetMousePosition" then return nil end
        local killer=GetNearestKillerModel(); if not killer then return nil end
        return jd_predictPos(killer, dusekkar.prediction, dusekkar.aimOffset)
    end)
end

