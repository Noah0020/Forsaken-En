local function noopStatusEffect(name)
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local schem = modules and modules:FindFirstChild("Schematics")
    local effects = schem and schem:FindFirstChild("StatusEffects")
    if not effects then return false end
    local target = effects:FindFirstChild(name)
    if not target then
        for _, sub in ipairs({"KillerExclusive","SurvivorExclusive"}) do
            local s = effects:FindFirstChild(sub)
            local f = s and s:FindFirstChild(name)
            if f then target = f; break end
        end
    end
    if not target then return false end
    local ok, m = pcall(require, target)
    if ok and type(m) == "table" then
        for k, v in pairs(m) do
            if type(v) == "function" then m[k] = function() end end
        end
        return true
    end
    return false
end
local _antiPullConn = nil
local function setAntiPull(v)
    if _antiPullConn then _antiPullConn:Disconnect(); _antiPullConn = nil end
    if not v then return end
    local function watch(hrp)
        if not hrp then return end
        local function kill(c)
            if c.Name=="CatchVelocity" or c:IsA("AlignPosition") or c:IsA("LinearVelocity")
               or c:IsA("BodyVelocity") or c:IsA("BodyPosition") then
                pcall(function() c:Destroy() end)
            end
        end
        for _, c in ipairs(hrp:GetChildren()) do kill(c) end
        _antiPullConn = hrp.ChildAdded:Connect(function(c)
            task.wait(0.1)
            if v then kill(c) end
        end)
    end
    if LP.Character then watch(LP.Character:WaitForChild("HumanoidRootPart", 5)) end
end
local function setAntiFallSlowness(v)
    if not v then
        if LP.Character then LP.Character:SetAttribute("NoFallSlow", false) end
        return
    end
    local function apply(c) if c then c:SetAttribute("NoFallSlow", true) end end
    if LP.Character then apply(LP.Character) end
    task.spawn(function()
        LP.CharacterAdded:Connect(function(c) task.wait(0.5); if v then apply(c) end end)
        while v and not _ShuttingDown do
            if LP.Character then apply(LP.Character) end
            task.wait(2)
        end
    end)
end

