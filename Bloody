-- HDT (Guesting PrimaryPart drag)
--═══════════════════════════════════════════════════════════════════
local HDT = {
    enabled = false,
    duration = 0.3,
    active = false,
}

local function RunHDT()
    if not HDT.enabled or IsPlayerKiller() then return end
    task.spawn(function()
        local character = LP.Character
        local killer = GetNearestKiller(math.huge)
        if not character or not killer then return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local primaryPart = character.PrimaryPart or hrp
        if not hrp then return end
        local part2 = Instance.new("Part")
        part2.Size = Vector3.new(2, 2, 2)
        part2.Transparency = 1
        part2.CanCollide = false
        part2.Anchored = true
        part2.CFrame = hrp.CFrame
        part2.Parent = character
        character.PrimaryPart = part2
        HDT.active = true
        local now = os.clock()
        local dur = HDT.duration or 0.3
        while os.clock() - now < dur and HDT.enabled and HDT.active do
            local k = GetNearestKiller(math.huge)
            local kr = k and k:FindFirstChild("HumanoidRootPart")
            if kr then
                local rotation = hrp.CFrame.Rotation
                part2.CFrame = CFrame.new((kr.CFrame * CFrame.new(0, 0, -3)).Position) * rotation
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            RunService.PreRender:Wait()
        end
        HDT.active = false
        if part2 and part2.Parent then part2:Destroy() end
        if character and character.Parent then
            character.PrimaryPart = primaryPart
        end
    end)
end

