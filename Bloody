    Watchers.animator[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        if not AB.running or not Settings.AB_AnimDetect then return end
        if not killer or not killer.Parent then return end
        local aid = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
        if aid and AutoBlockTriggerAnims[aid] then OnKillerM1(killer) end
    end)
end

