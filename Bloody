if type(IsInCustomZone) ~= "function" then
    function IsInCustomZone(killer)
        if not killer or not killer.Parent then return false end
        local killerRoot = killer:FindFirstChild("HumanoidRootPart")
        local character = LocalPlayer and LocalPlayer.Character
        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
        if not killerRoot or not playerRoot then return false end

        local forward = killerRoot.CFrame.LookVector
        local right = killerRoot.CFrame.RightVector
        local flatForward = Vector3.new(forward.X, 0, forward.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatForward.Magnitude < 0.01 or flatRight.Magnitude < 0.01 then return false end

        flatForward = flatForward.Unit
        flatRight = flatRight.Unit
        local offset = tonumber(Settings.CustomDiamondOffset) or 0
        local length = math.max(1, tonumber(Settings.CustomDiamondLength) or 8)
        local width = math.max(1, tonumber(Settings.CustomDiamondWidth) or 4)
        local playerRadius = 2.75
        local relative = Vector3.new(
            playerRoot.Position.X - killerRoot.Position.X,
            0,
            playerRoot.Position.Z - killerRoot.Position.Z
        )
        local forwardDistance = relative:Dot(flatForward)
        local sideDistance = relative:Dot(flatRight)
        local centerDistance = offset + length / 2
        local halfWidth = width / 2 + playerRadius
        local halfLength = length / 2 + playerRadius
        return math.abs(sideDistance) / halfWidth
            + math.abs(forwardDistance - centerDistance) / halfLength <= 1
    end
end
