    }

    local ActiveLock = { IsActive = false, Target = nil, StartTime = 0 }

    local function GetSurvivorName()
        local char = LP.Character
        if not char then return nil end
        local attr = char:GetAttribute("CharacterName")
        if attr and SURVIVOR_ABILITIES[attr] then return attr end
        if SURVIVOR_ABILITIES[char.Name] then return char.Name end
        return nil
    end

    -- Robust decode: handles "SLASH", "\3\5\0\0\0SLASH", buffer equivalents, etc.
    local function decodeAbilityName(payload)
        if not payload or type(payload) ~= "table" then return nil end
        local first = payload[1]
        if not first then return nil end

        local raw
        if type(first) == "string" then
            raw = first
        elseif typeof(first) == "buffer" then
            local ok, s = pcall(buffer.tostring, first)
            if ok then raw = s end
        end
        if not raw then return nil end

        local best = ""
        for word in raw:gmatch("[%a][%a%s]*") do
            word = word:gsub("%s+$", "")
            if #word > #best then best = word end
        end
        if best == "" then return nil end
        return best
    end

    local function StartLock(abilityName)
        if not Aim.Enabled then return end
        if IsPlayerKiller() then return end

        local survivor = GetSurvivorName()
        if not survivor then return end

        local allowed = SURVIVOR_ABILITIES[survivor]
        if not allowed or not allowed[abilityName] then return end

        local target = GetNearestKiller(Aim.Distance)
        if not target then return end

        ActiveLock.IsActive = true
        ActiveLock.Target = target
        ActiveLock.StartTime = tick()

        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = false end

        if Aim.Debug then
            print(string.format("[Aim] %s fired '%s' → locking %s", survivor, abilityName, target.Name))
        end
    end

    -- Weak table: if a remote is GC'd and a new one is created, we can re-hook it
    local HookedRemotes = setmetatable({}, { __mode = "k" })

    local function hookUseActorAbility()
        local re = getRE()
        if not re then return false end
        if HookedRemotes[re] then return true end
        HookedRemotes[re] = true

        local oldFire = re.FireServer
        re.FireServer = function(self, action, payload)
            if action == "UseActorAbility" and type(payload) == "table" then
                local name = decodeAbilityName(payload)
                if name then StartLock(name) end
            end
            return oldFire(self, action, payload)
        end
        return true
    end

    local function findChanceGunRemote()
        local r = ReplicatedStorage:FindFirstChild("ChanceFireGun")
        if r then return r end
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        return remotes and remotes:FindFirstChild("ChanceFireGun")
    end

    local function hookChanceGun()
        local r = findChanceGunRemote()
        if not r then return false end
        if HookedRemotes[r] then return true end
        HookedRemotes[r] = true

        local oldFire = r.FireServer
        r.FireServer = function(self, ...)
            StartLock("ONE SHOT")
            return oldFire(self, ...)
        end
        return true
    end

    -- Retry hooks in the background (remotes may not exist yet at load)
    task.spawn(function()
        while true do
            if not hookUseActorAbility() then
                task.wait(1)
            else
                break
            end
        end
    end)
    task.spawn(function()
        while true do
            if hookChanceGun() then break end
            task.wait(2)
        end
    end)

    -- Aim loop
    RunService.RenderStepped:Connect(function()
        if not ActiveLock.IsActive then return end

        if not Aim.Enabled or IsPlayerKiller() then
            ActiveLock.IsActive = false
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
            return
        end

        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            ActiveLock.IsActive = false
            return
        end

        local elapsed = tick() - ActiveLock.StartTime
        if elapsed > Aim.LockDuration then
            ActiveLock.IsActive = false
            ActiveLock.Target = nil
            hum.AutoRotate = true
            return
        end

        local target = ActiveLock.Target
        local tHRP = target and target:FindFirstChild("HumanoidRootPart")
        local tHum = target and target:FindFirstChildOfClass("Humanoid")

        if not tHRP or (tHum and tHum.Health <= 0) then
            target = GetNearestKiller(Aim.Distance)
            ActiveLock.Target = target
            tHRP = target and target:FindFirstChild("HumanoidRootPart")
            tHum = target and target:FindFirstChildOfClass("Humanoid")
        end

        if not tHRP then
            ActiveLock.IsActive = false
            hum.AutoRotate = true
            return
        end

        local aimPos = tHRP.Position
        if Aim.AimHead then
            local head = target:FindFirstChild("Head")
            if head then aimPos = head.Position end
        end
        if Aim.Prediction > 0 and tHum and tHum.MoveDirection.Magnitude > 0.05 then
            aimPos = aimPos + tHum.MoveDirection.Unit * Aim.Prediction
        end

        local lookAt = Vector3.new(aimPos.X, hrp.Position.Y, aimPos.Z)
        if (lookAt - hrp.Position).Magnitude < 0.1 then return end
        local goalCF = CFrame.lookAt(hrp.Position, lookAt)
        hrp.CFrame = hrp.CFrame:Lerp(goalCF, Aim.Smoothness)
    end)

    -- UI
    local left = Tabs.Aimbot:AddLeftGroupbox("Survivor Aimbot")
    left:AddToggle("Aim_Enable", {
        Text = "Enable Aimbot",
        Default = false,
        Callback = function(v)
            if v and IsPlayerKiller() then
                pcall(function() Toggles.Aim_Enable:SetValue(false) end)
                return
            end
            Aim.Enabled = v
            if not v then
                ActiveLock.IsActive = false
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = true end
            end
        end,
    })
    left:AddSlider("Aim_Dist", {
        Text = "Search Distance", Default = 60, Min = 5, Max = 200, Rounding = 0,
        Callback = function(v) Aim.Distance = v end,
    })
    left:AddSlider("Aim_Lock", {
        Text = "Lock Duration", Default = 0.6, Min = 0.1, Max = 3, Rounding = 2,
        Callback = function(v) Aim.LockDuration = v end,
    })
    left:AddSlider("Aim_Smooth", {
        Text = "Smoothness", Default = 0.85, Min = 0.1, Max = 1, Rounding = 2,
        Callback = function(v) Aim.Smoothness = v end,
    })
    left:AddSlider("Aim_Pred", {
        Text = "Prediction (studs)", Default = 0, Min = 0, Max = 15, Rounding = 1,
        Callback = function(v) Aim.Prediction = v end,
    })
    left:AddToggle("Aim_Head", {
        Text = "Aim at Head",
        Default = false,
        Callback = function(v) Aim.AimHead = v end,
    })
    left:AddToggle("Aim_Debug", {
        Text = "Debug prints",
        Default = false,
        Callback = function(v) Aim.Debug = v end,
    })

    local right = Tabs.Aimbot:AddRightGroupbox("Triggers")
    right:AddLabel("Auto-detects your survivor.")
    right:AddLabel("Shedletsky → SLASH")
    right:AddLabel("Guest 1337 → PUNCH / PARRY")
    right:AddLabel("Chance → ONE SHOT / SHOT / FLINTLOCK / GUN")
    right:AddLabel("Jane / Jane Doe → HATCHET")
    right:AddLabel("If nothing triggers, enable Debug and check Console.", true)
    right:AddButton({
        Text = "Test Lock (nearest killer)",
        Func = function()
            local t = GetNearestKiller(Aim.Distance)
            if t then
                ActiveLock.IsActive = true
                ActiveLock.Target = t
                ActiveLock.StartTime = tick()
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = false end
                Library:Notify({ Title = "Aim", Description = "Test lock on " .. t.Name, Time = 2 })
            else
                Library:Notify({ Title = "Aim", Description = "No killer in range", Time = 2 })
            end
        end,
    })
end

