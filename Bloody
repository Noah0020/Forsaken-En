--═══════════════════════════════════════════════════════════
-- AIM CORE (BodyGyro-based, no desync)
--═══════════════════════════════════════════════════════════
local aimSettings = { distance = 100, prediction = 4 }
local aimModules = {}
local function registerAim(name, on, off) aimModules[name] = { enabled = false, on = on, off = off } end
local function toggleAim(name, state)
    local m = aimModules[name]; if not m then return end
    if state and not m.enabled then if m.on then pcall(m.on) end m.enabled = true
    elseif not state and m.enabled then if m.off then pcall(m.off) end m.enabled = false end
end

local snapConn, snapHum, snapWasAuto, snapGyro = nil, nil, true, nil
local function findClosestTarget(kind, excludeChar, fromPos, maxDist)
    local folder = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(kind)
    if not folder then return nil end
    local best, bd = nil, maxDist
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m ~= excludeChar then
            local trg = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if trg and h and h.Health > 0 then
                local d = (trg.Position - fromPos).Magnitude
                if d < bd then bd = d; best = trg end
            end
        end
    end
    return best
end
local function stopSnap()
    if snapConn then pcall(function() snapConn:Disconnect() end); snapConn = nil end
    if snapGyro and snapGyro.Parent then pcall(function() snapGyro:Destroy() end); snapGyro = nil end
    if snapHum and snapHum.Parent then pcall(function() snapHum.AutoRotate = snapWasAuto end) end
    snapHum = nil
end
local function performSnap(kind, useCam)
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not hum or hum.Health <= 0 then return end
    local target = findClosestTarget(kind, char, hrp.Position, aimSettings.distance)
    if not target then return end
    stopSnap()
    if useCam then
        local cam = workspace.CurrentCamera
        local vel = target.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target.Position + vel * (aimSettings.prediction * 0.03)) end
        return
    end
    snapHum = hum; snapWasAuto = hum.AutoRotate; hum.AutoRotate = false
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(0, 1e6, 0); bg.P = 10000; bg.D = 1000
    bg.Parent = hrp; snapGyro = bg
    local startT = tick()
    snapConn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent or not bg.Parent then stopSnap(); return end
        if tick() - startT > 0.4 then stopSnap(); return end
        local t = findClosestTarget(kind, char, hrp.Position, aimSettings.distance)
        if not t then return end
        local vel = t.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude > 60 then vel = vel.Unit * 60 end
        local pred = t.Position + vel * (aimSettings.prediction * 0.03)
        local dir = Vector3.new(pred.X - hrp.Position.X, 0, pred.Z - hrp.Position.Z)
        if dir.Magnitude > 0.01 then
            dir = dir.Unit
            bg.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
        end
    end)
end
LP.CharacterAdded:Connect(stopSnap)
LP.CharacterRemoving:Connect(stopSnap)

