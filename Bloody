local function FireBlockBuffer()
    if IsPlayerKiller() then return end
    local re = getNetworkEvent()
    if not re then return end
    pcall(function()
        re:FireServer("UseActorAbility", { buffer.fromstring(string.char(3, 5, 0, 0, 0) .. "Block") })
    end)
    if HDT.enabled then
        task.spawn(function()
            if HDT.delay > 0 then task.wait(HDT.delay) end
            local character = LP.Character
            if not character or IsPlayerKiller() then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local killer = GetNearestKillerModel(math.huge)
            local kr = killer and killer:FindFirstChild("HumanoidRootPart")
            if not kr then return end
            local primaryPart = character.PrimaryPart or hrp
            local part2 = Instance.new("Part")
            part2.Size = Vector3.new(2, 2, 2)
            part2.Transparency = 1
            part2.CanCollide = false
            part2.Anchored = true
            part2.CFrame = hrp.CFrame
            part2.Parent = character
            character.PrimaryPart = part2
            local now2 = os.clock()
            local dur = HDT.duration or 0.35
            while os.clock() - now2 < dur and HDT.enabled and not IsPlayerKiller() do
                killer = GetNearestKillerModel(math.huge)
                kr = killer and killer:FindFirstChild("HumanoidRootPart")
