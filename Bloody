local function VeeSetStat(name, value)
    local m = VeeGetBehavior()
    if m then
        pcall(function() m[name] = value end)
        pcall(function() rawset(m, name, value) end)
    end
    if getgc then
        pcall(function()
            for _, obj in pairs(getgc(true)) do
