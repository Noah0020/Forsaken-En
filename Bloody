--═══ TURN RATE TRACKING ═══
local TurnState = {}
local function AB_Alpha(dt) return 1 - math.exp(-dt / math.max(Settings.BoxFollowDelay, 0.001)) end

local function AB_UpdateTurnRates(dt)
    local kf = GetKillersFolder()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not kf or not myRoot then return end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local st = TurnState[k]
                if not st then
                    st = { pos = kr.Position, look = kr.CFrame.LookVector, dot = 0, lastDot = 0, rate = 0 }
                    TurnState[k] = st
                    local toPlayer = myRoot.Position - st.pos
                    local fl = Vector3.new(st.look.X, 0, st.look.Z)
                    local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                    if fl.Magnitude > 0.01 and ft.Magnitude > 0.01 then
                        st.dot = fl.Unit:Dot(ft.Unit); st.lastDot = st.dot
                    end
                else
                    local a = AB_Alpha(dt)
                    st.pos = st.pos:Lerp(kr.Position, a)
                    local nl = kr.CFrame.LookVector
                    st.look = st.look:Lerp(nl, a)
                    if st.look.Magnitude > 0.01 then st.look = st.look.Unit else st.look = nl.Unit end
                    local toPlayer = myRoot.Position - st.pos
                    local fl = Vector3.new(st.look.X, 0, st.look.Z)
                    local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                    if fl.Magnitude > 0.01 and ft.Magnitude > 0.01 then
                        st.lastDot = st.dot
                        st.dot = fl.Unit:Dot(ft.Unit)
                        st.rate = (st.dot - st.lastDot) / math.max(dt, 0.001)
                    end
                end
            else TurnState[k] = nil end
        end
    end
    for k in pairs(TurnState) do if not k.Parent then TurnState[k] = nil end end
end

--═══ CONE DETECTION ═══
local function AB_IsPlayerInCone(killerRoot, playerRoot)
    if not killerRoot or not playerRoot then return false end
    local offset = playerRoot.Position - killerRoot.Position
    local horiz = Vector3.new(offset.X, 0, offset.Z)
    local dist = horiz.Magnitude
    if dist > Settings.ConeRadius or dist < 0.5 then return false end
    local forward = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z)
    if forward.Magnitude < 0.001 then return false end
    forward = forward.Unit
    local dot = forward:Dot(horiz.Unit)
    local angleDeg = math.deg(math.acos(math.clamp(dot, -1, 1)))
    return angleDeg <= (Settings.ConeAngle / 2)
end

--═══ AUTO BLOCK ═══
local AB = { running=false, frameConn=nil, perKiller={}, lastBlock=0, BLOCK_COOLDOWN=27 }

local function AB_ShouldBlock(killer)
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    local char = LocalPlayer.Character
    local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not killerRoot or not playerRoot then return false end
    local offset = playerRoot.Position - killerRoot.Position
    local dist = offset.Magnitude
    if dist > Settings.ConeRadius or dist < 0.5 then return false end
    local kv = killerRoot.AssemblyLinearVelocity
    if kv.Magnitude > Settings.BoxFastThreshold then
        local fv = Vector3.new(kv.X, 0, kv.Z)
        local ft = Vector3.new(offset.X, 0, offset.Z)
        if fv.Magnitude > 0.5 and ft.Magnitude > 0.1 and fv.Unit:Dot(ft.Unit) < Settings.BoxFastDot then return false end
    end
    if AB_IsPlayerInCone(killerRoot, playerRoot) then return true end
    if Settings.BoxAntiBait then
        local st = TurnState[killer]
        if st and st.rate > Settings.BoxTurnRate and st.dot >= 0.15 then return true end
    end
    return false
end

local function AB_IsBlockReady()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(Settings.AB_Mode == "007n7" and "Clone" or "Block")
    if btn then
        local cd = btn:FindFirstChild("CooldownTime")
        if cd then
            local t = cd.Text
            if t == nil or t == "" or t == " " then return true end
            return false
        end
    end
    return (tick() - (AB.lastBlock or 0)) >= (AB.BLOCK_COOLDOWN - 1)
end

local function AB_FireBlock()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    if buffer and buffer.fromstring then
        pcall(function() NetworkEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0"..name) }) end)
    end
    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
end

local function AB_FireSpam()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local count = math.max(1, tonumber(Settings.AB_SpamCount) or 4)
    if buffer and buffer.fromstring then
        local buf = buffer.fromstring("\3\5\0\0\0"..name)
        for _ = 1, count do task.spawn(function() pcall(function() NetworkEvent:FireServer("UseActorAbility", {buf}) end) end) end
    end
    local dur = tonumber(Settings.AB_SpamDuration) or 0.05
    if dur > 0 then
        task.spawn(function()
            local endT = tick() + dur
            while tick() < endT do
                pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
                task.wait(0.001)
            end
        end)
    end
end

local function AB_Fire() if Settings.AB_SpamEnabled then AB_FireSpam() else AB_FireBlock() end end

local function AB_TryFire(killer)
    local st = AB.perKiller[killer]
    if not st or st.pendingUntil <= 0 or tick() > st.pendingUntil then return end
    if not AB_IsBlockReady() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp or not hrp.Parent then return end
    if not AB_ShouldBlock(killer) then return end
    st.pendingUntil = 0; st.lastFireAt = tick(); AB.lastBlock = tick()
    AB_Fire()
end

local function AB_OnAttributeChanged(killer)
    if not AB.running then return end
    local st = AB.perKiller[killer]; if not st then return end
    local aU = killer:GetAttribute("AbilitiesUsed") or 0
    if aU > st.lastUsed then st.lastUsed = aU; st.baitFlag = true end
    local aLU = killer:GetAttribute("AbilityLastUsed") or 0
    if aLU <= st.lastAbility then return end
    st.lastAbility = aLU
    if st.baitFlag then st.baitFlag = false; return end
    st.pendingUntil = tick() + Settings.AB_PendingWindow
    AB_TryFire(killer)
end

local function AB_HookKiller(killer)
    if not killer:IsA("Model") or AB.perKiller[killer] then return end
    local st = {
        lastAbility = killer:GetAttribute("AbilityLastUsed") or 0,
        lastUsed = killer:GetAttribute("AbilitiesUsed") or 0,
        baitFlag = false, pendingUntil = 0, lastFireAt = 0,
    }
    local ok, conn = pcall(function()
        return killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function() AB_OnAttributeChanged(killer) end)
    end)
    if ok and conn then st.signalConn = conn end
    AB.perKiller[killer] = st
end

local function AB_UnhookKiller(killer)
    local st = AB.perKiller[killer]
    if st and st.signalConn then pcall(function() st.signalConn:Disconnect() end) end
    AB.perKiller[killer] = nil
end

local function AB_FrameLoop(dt)
    if not AB.running then return end
    AB_UpdateTurnRates(dt or 0.016)
    local kf = GetKillersFolder(); if not kf then return end
    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            if not AB.perKiller[killer] then AB_HookKiller(killer) end
            local st = AB.perKiller[killer]
            if st then
                local aU = killer:GetAttribute("AbilitiesUsed") or 0
                if aU > st.lastUsed then st.lastUsed = aU; st.baitFlag = true end
                if st.pendingUntil > 0 then AB_TryFire(killer) end
            end
        end
    end
    for k in pairs(AB.perKiller) do if not k.Parent then AB_UnhookKiller(k) end end
end

local function AB_Enable()
    if AB.running then return end
    AB.running = true; AB.perKiller = {}; AB.lastBlock = 0
    local kf = GetKillersFolder()
    if kf then for _, k in ipairs(kf:GetChildren()) do AB_HookKiller(k) end end
    AB.frameConn = RunService.RenderStepped:Connect(AB_FrameLoop)
end

local function AB_Disable()
    AB.running = false
    if AB.frameConn then pcall(function() AB.frameConn:Disconnect() end); AB.frameConn = nil end
    for k in pairs(AB.perKiller) do AB_UnhookKiller(k) end
    AB.perKiller = {}
end

--═══ ANTI BAIT ═══
local ABT = { running=false, animConn=nil, cleanup=nil, charConn=nil }
local function ABT_Stop()
    if ABT.cleanup then ABT.cleanup() end
    if ABT.animConn then pcall(function() ABT.animConn:Disconnect() end); ABT.animConn=nil end
    if ABT.charConn then pcall(function() ABT.charConn:Disconnect() end); ABT.charConn=nil end
    ABT.running = false
end
local function ABT_RunSequence(character)
    if not ABT.running or ABT.cleanup then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    local kf = GetKillersFolder(); if not hrp or not kf or not hum then return end
    local killer = kf:FindFirstChildOfClass("Model")
    local khrp = killer and killer:FindFirstChild("HumanoidRootPart"); if not khrp then return end
    local oldPart = character.PrimaryPart
    local part = Instance.new("Part")
    part.Name="GS_ABT"; part.Size=Vector3.new(2,2,2); part.Transparency=1
    part.CanCollide=false; part.Massless=true; part.CFrame=hrp.CFrame; part.Parent=character
    character.PrimaryPart = part
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero; bv.Parent = part
    local speed, elapsed, reachedTime = 100, 0, 0
    local reached, finished = false, false
    local conn
    local function cleanup()
        if finished then return end; finished = true
        if conn then conn:Disconnect() end
        if character and character.Parent and oldPart then character.PrimaryPart = oldPart end
        if bv and bv.Parent then bv:Destroy() end
        if part and part.Parent then part:Destroy() end
        ABT.cleanup = nil
    end
    ABT.cleanup = cleanup
    conn = RunService.RenderStepped:Connect(function(dt)
        if not ABT.running or not character.Parent or not part.Parent
           or not khrp.Parent or not hum.Parent or hum.Health <= 0 then cleanup(); return end
        character.PrimaryPart = part
        local target = khrp.Position + khrp.CFrame.LookVector * 2
        local diff = target - part.Position
        local dist = diff.Magnitude
        if reached then
            reachedTime = reachedTime + dt
            bv.Velocity = dist > 0.1 and diff.Unit * speed or Vector3.zero
            if reachedTime >= Settings.ABT_Duration then cleanup() end
            return
        end
        elapsed = elapsed + dt
        if dist <= speed*dt or dist < 0.1 then
            bv.Velocity = Vector3.zero; reached = true; reachedTime = 0; return
        end
        bv.Velocity = diff.Unit * speed
        if elapsed >= 1 then cleanup() end
    end)
end
local function ABT_Attach(char)
    local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
    local anim = hum:WaitForChild("Animator", 5); if not anim then return end
    if ABT.animConn then pcall(function() ABT.animConn:Disconnect() end) end
    ABT.animConn = anim.AnimationPlayed:Connect(function(track)
        if not ABT.running then return end
        local aid = track.Animation and track.Animation.AnimationId
        if aid and AntiBaitAnims[aid] then task.spawn(ABT_RunSequence, char) end
    end)
end
local function ABT_Enable()
    if ABT.running then return end
    ABT.running = true
    if LocalPlayer.Character then task.spawn(ABT_Attach, LocalPlayer.Character) end
    ABT.charConn = LocalPlayer.CharacterAdded:Connect(function(c)
        if ABT.running then task.spawn(ABT_Attach, c) end
    end)
end
local function ABT_Disable() ABT_Stop() end

