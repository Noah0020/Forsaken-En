-- Shedletsky Auto Slash (from Flex)
local _Shed = { enabled = false, dist = 10, cd = 1.1, last = {}, conn = nil }
local function shedFire(killer)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local khrp = killer and killer:FindFirstChild("HumanoidRootPart")
    if hrp and khrp then
        local dir = Vector3.new(khrp.Position.X - hrp.Position.X, 0, khrp.Position.Z - hrp.Position.Z)
        if dir.Magnitude > 0.1 then
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + dir.Unit)
        end
    end
    FireAbility("Slash")
end
local function setShedSlash(on)
    _Shed.enabled = on
    if _Shed.conn then _Shed.conn:Disconnect(); _Shed.conn = nil end
    if on then
        _Shed.conn = RunService.Heartbeat:Connect(function()
            if not _Shed.enabled then return end
            local char = LocalPlayer.Character
            if not char or char.Name ~= "Shedletsky" then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp or not KillersFolder then return end
            local now = os.clock()
            for _, v in pairs(KillersFolder:GetChildren()) do
                if v:IsA("Model") then
                    local khrp = v:FindFirstChild("HumanoidRootPart")
                    if khrp and (hrp.Position - khrp.Position).Magnitude <= _Shed.dist then
                        if now - (_Shed.last[v] or 0) >= _Shed.cd then
                            _Shed.last[v] = now
                            task.spawn(shedFire, v)
                        end
                    end
                end
            end
        end)
        Notify("Shedletsky Auto Slash ON")
    end
end

