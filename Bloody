            if S.Stamina ~= nil then S.Stamina = math.max(S.Stamina, S.MaxStamina or 100) end
        else
            if S.StaminaLossDisabled ~= nil then S.StaminaLossDisabled = false end
            S.MinStamina = StamS.minS
            S.MaxStamina = StamS.maxS
            S.StaminaLoss = StamS.loss
            S.StaminaGain = StamS.gain
            if StamS.lockMax and S.Stamina ~= nil then
