    Stam.thread = task.spawn(function()
        while Stam.running do
            task.wait(0.01)
            local m = Stam.mod
            if m then
                pcall(function()
                    if Stam.MaxStamina ~= nil then m.MaxStamina = Stam.MaxStamina end
                    if Stam.SprintSpeed ~= nil then m.SprintSpeed = Stam.SprintSpeed end
                    if Stam.StaminaGain ~= nil then m.StaminaGain = Stam.StaminaGain end
