            anim.AnimationId = "rbxassetid://" .. animationId
            local loaded = humanoid:LoadAnimation(anim)
            currentAnim = loaded
            loaded.Looped = false
            loaded:Play()
            loaded:AdjustSpeed(animationSpeed)
            task.wait(0.00001)
        end
    end)
end

local function StopInvisibility()
    loopRunning = false
    if loopThread then task.cancel(loopThread); loopThread = nil end
    if currentAnim then currentAnim:Stop(); currentAnim = nil end
    local humanoid = lp.Character and (lp.Character:FindFirstChildOfClass("Humanoid") or lp.Character:FindFirstChildOfClass("AnimationController"))
    if humanoid then
        for _, v in pairs(humanoid:GetPlayingAnimationTracks()) do v:AdjustSpeed(100000) end
    end
    local animate = lp.Character and lp.Character:FindFirstChild("Animate")
    if animate then animate.Disabled = true; animate.Disabled = false end
end

