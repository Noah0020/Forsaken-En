local function refreshBoxSliders(name)
    local cfg = Settings.KillerHitbox[name] or Settings.KillerHitbox["Default"]
    if BoxSliders.Width then pcall(function() BoxSliders.Width:Set(cfg.width) end) end
    if BoxSliders.Height then pcall(function() BoxSliders.Height:Set(cfg.height) end) end
    if BoxSliders.Length then pcall(function() BoxSliders.Length:Set(cfg.length) end) end
    if BoxSliders.Distance then pcall(function() BoxSliders.Distance:Set(cfg.distance) end) end
end
