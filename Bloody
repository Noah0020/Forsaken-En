local AP = { running = false, conn = nil, soundConns = {}, debounce = {}, delay = 0.5 }
local function AP_Hook(s)
    if not s:IsA("Sound") or s:GetAttribute("VORTEX_AP") then return end
    s:SetAttribute("VORTEX_AP", true)
    table.insert(AP.soundConns, s.Played:Connect(function()
        if not AP.running or not ParrySounds[s.SoundId] then return end
        local now = tick()
        if now - (AP.debounce[s] or 0) < 0.3 then return end
        AP.debounce[s] = now
        task.wait(AP.delay)
        if not AP.running then return end
        FireBlockBuffer()
    end))
end
local function AP_Enable()
    if AP.running then return end
    AP.running = true
    local c = LP.Character
    if c then
        for _, d in ipairs(c:GetDescendants()) do AP_Hook(d) end
        table.insert(AP.soundConns, c.DescendantAdded:Connect(AP_Hook))
    end
    AP.conn = LP.CharacterAdded:Connect(function(cc)
        if not AP.running then return end
        for _, d in ipairs(cc:GetDescendants()) do AP_Hook(d) end
        table.insert(AP.soundConns, cc.DescendantAdded:Connect(AP_Hook))
    end)
end
local function AP_Disable()
    AP.running = false
    for _, c in ipairs(AP.soundConns) do pcall(function() c:Disconnect() end) end
    AP.soundConns = {}; AP.debounce = {}
    if AP.conn then pcall(function() AP.conn:Disconnect() end); AP.conn = nil end
end

-- Elliot
local elliot = {
    enabled = false, conn = nil, autoRotBak = nil,
    aimType = "Camera + Character", targetMode = "Low HP",
    throwDur = 0.6, isThrowing = false, throwTS = 0, requireAnim = true,
    hum = nil, hrp = nil, lastAimTime = 0, smoothness = 0.15, predDist = 5,
    throwForce = 80, throwAnimId = "114155003741146",
}
local function elliot_setupChar(char)
    elliot.hum = char:WaitForChild("Humanoid", 3)
    elliot.hrp = char:WaitForChild("HumanoidRootPart", 3)
    if elliot.hum then
        local an = elliot.hum:FindFirstChildOfClass("Animator")
        if an then
            an.AnimationPlayed:Connect(function(track)
                if not track or not track.Animation then return end
                local aid = ""; pcall(function() aid = tostring(track.Animation.AnimationId) end)
                if aid:find(elliot.throwAnimId) then elliot.isThrowing = true; elliot.throwTS = tick() end
            end)
        end
    end
end
if LP.Character then elliot_setupChar(LP.Character) end
LP.CharacterAdded:Connect(elliot_setupChar)

local function elliot_findTarget()
    local sf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not sf or not elliot.hrp then return nil end
    local best, bv = nil, math.huge
    for _, s in ipairs(sf:GetChildren()) do
        if s ~= LP.Character then
            local h = s:FindFirstChildOfClass("Humanoid"); local r = s:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local v = elliot.targetMode == "Closest" and (r.Position - elliot.hrp.Position).Magnitude or h.Health
                if v < bv then bv = v; best = r end
            end
        end
    end
    return best
end
local function elliot_aimAt(tgt)
    if not tgt or not tgt.Parent then return end
    local now = tick(); if now - elliot.lastAimTime < 0.016 then return end; elliot.lastAimTime = now
    local vel = getHRPVelocity(tgt); local pred = tgt.Position
    if vel.Magnitude > 2 then
        local dist = (tgt.Position - elliot.hrp.Position).Magnitude
        pred = tgt.Position + vel * math.min(dist / elliot.throwForce, 1.0) * (elliot.predDist / 5)
    end
    if elliot.hrp and elliot.hum then
        if elliot.autoRotBak == nil then elliot.autoRotBak = elliot.hum.AutoRotate; elliot.hum.AutoRotate = false end
        elliot.hrp.AssemblyAngularVelocity = Vector3.zero
        local flat = Vector3.new(pred.X - elliot.hrp.Position.X, 0, pred.Z - elliot.hrp.Position.Z)
        if flat.Magnitude > 0.1 then
            local look = CFrame.lookAt(elliot.hrp.Position, elliot.hrp.Position + flat.Unit)
            elliot.hrp.CFrame = elliot.hrp.CFrame:Lerp(CFrame.new(elliot.hrp.Position) * look.Rotation, elliot.smoothness)
        end
    end
    if elliot.aimType ~= "HRP Aimbot" then
        local cam = Workspace.CurrentCamera
        if cam then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pred), elliot.smoothness * 1.5) end
    end
end
local function elliot_start()
    if elliot.conn then elliot.conn:Disconnect() end
    elliot.conn = RunService.RenderStepped:Connect(function()
        if not elliot.enabled or not elliot.hum or not elliot.hrp then
            if elliot.autoRotBak ~= nil and elliot.hum then elliot.hum.AutoRotate = elliot.autoRotBak; elliot.autoRotBak = nil end
            return
        end
        local should = (not elliot.requireAnim) or (elliot.isThrowing and (tick() - elliot.throwTS) <= elliot.throwDur)
        if elliot.isThrowing and (tick() - elliot.throwTS) > elliot.throwDur then elliot.isThrowing = false end
        if not should then
            if elliot.autoRotBak ~= nil and elliot.hum then elliot.hum.AutoRotate = elliot.autoRotBak; elliot.autoRotBak = nil end
            return
        end
        local t = elliot_findTarget(); if t then elliot_aimAt(t) end
    end)
end
local function elliot_stop()
    elliot.enabled = false
    if elliot.conn then pcall(function() elliot.conn:Disconnect() end); elliot.conn = nil end
    if elliot.hum then pcall(function() elliot.hum.AutoRotate = true end) end
end

-- Chance
local chance = {
    enabled = false, predMode = "Velocity", predValue = 0.5, aimBehavior = "Normal",
    holdToAim = true, aimKey = Enum.KeyCode.Q, holdingKey = false, aiming = false,
    startTime = 0, aimDuration = 1.7, bodyGyro = nil,
}
local function chance_getNearest()
    local char = LP.Character; if not char then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local my = char:FindFirstChild("HumanoidRootPart"); if not my then return nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(kf:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart"); local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - my.Position).Magnitude
            if d < bd then bd = d; best = r end
        end
    end
    return best
end
local function chance_predict(hrp)
    local char = LP.Character; local my = char and char:FindFirstChild("HumanoidRootPart")
    if not my then return hrp.Position end
    local vel = getHRPVelocity(hrp)
    if chance.predMode == "Look" then return hrp.Position + hrp.CFrame.LookVector * (vel.Magnitude * chance.predValue) end
    if vel.Magnitude < 0.5 then return hrp.Position end
    return hrp.Position + vel * (chance.predValue + ((hrp.Position - my.Position).Magnitude * 0.003))
end
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if chance.holdToAim and i.KeyCode == chance.aimKey then
        chance.holdingKey = true; chance.aiming = true; chance.startTime = tick()
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if chance.holdToAim and i.KeyCode == chance.aimKey then chance.holdingKey = false; chance.aiming = false end
end)
RunService.RenderStepped:Connect(function(dt)
    if not chance.enabled then return end
    local char = LP.Character; local my = char and char:FindFirstChild("HumanoidRootPart"); if not my then return end
    if chance.holdToAim then
        if not chance.holdingKey then return end
    else
        if not chance.aiming then return end
        if tick() - chance.startTime > chance.aimDuration then chance.aiming = false; return end
    end
    local target = chance_getNearest(); if not target then return end
    local pos = chance_predict(target); if not pos then return end
    if chance.aimBehavior == "360" then
        local prog = (tick() - chance.startTime) / 0.5
        if prog < 1 then my.CFrame = CFrame.new(my.Position) * CFrame.Angles(0, math.rad(360 * prog), 0); return end
    end
    if not chance.bodyGyro or not chance.bodyGyro.Parent then
        chance.bodyGyro = Instance.new("BodyGyro")
        chance.bodyGyro.MaxTorque = Vector3.new(0, math.huge, 0)
        chance.bodyGyro.P = 10000; chance.bodyGyro.D = 500
        chance.bodyGyro.Parent = my
    end
    chance.bodyGyro.CFrame = CFrame.lookAt(my.Position, pos)
end)

