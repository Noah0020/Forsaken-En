local ConeConfig = {NormalAngle=35,MaxAngle=100,ExpansionSpeed=180,RecoverySpeed=90,Range=18,Segments=36,Color=Color3.fromRGB(255,55,55),ColorHit=Color3.fromRGB(80,255,80),Transparency=0.65,Thickness=0.12,YTolerance=8,WindowDuration=0.5,ShowBox=true}
local ConeState, blockPerKiller, activeBlocks = {}, {}, {}

local function hasHelplessEffect()
    if LP:GetAttribute("Helpless") then return true end
    local char=LP.Character; if not char then return false end
    if char:GetAttribute("Helpless") or char:FindFirstChild("Helpless") then return true end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then if hum:GetAttribute("Helpless") or hum:FindFirstChild("Helpless") then return true end end
    for _,name in ipairs({"StatusEffects","Effects","Statuses","Debuffs"}) do local c=char:FindFirstChild(name) if c and c:FindFirstChild("Helpless") then return true end end
    local ing=Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Ingame")
    if ing then
        local sf=ing:FindFirstChild("StatusEffects") or ing:FindFirstChild("Status")
        if sf then local me=sf:FindFirstChild(LP.Name) or sf:FindFirstChild(tostring(LP.UserId)) if me and me:FindFirstChild("Helpless") then return true end end
        local mi=ing:FindFirstChild(LP.Name) or ing:FindFirstChild(tostring(LP.UserId)) if mi and mi:FindFirstChild("Helpless") then return true end
    end
    local pd=LP:FindFirstChild("PlayerData") if pd then local st=pd:FindFirstChild("Status",true) if st and st:FindFirstChild("Helpless") then return true end end
    return false
end

local function getOrCreateCone(killer)
    local st=ConeState[killer]
    if st and st.folder and st.folder.Parent and #st.parts==ConeConfig.Segments then return st end
    if st and st.folder then pcall(function() st.folder:Destroy() end) end
    local f=Instance.new("Folder") f.Name="Ck_FacingCone" f.Parent=Workspace
    local parts={}
    for i=1,ConeConfig.Segments do local p=Instance.new("Part") p.Name="ConeSegment" p.Anchored=true p.CanCollide=false p.CanQuery=false p.CanTouch=false p.CastShadow=false p.Material=Enum.Material.Neon p.Color=ConeConfig.Color p.Transparency=1 p.Size=Vector3.new(ConeConfig.Thickness,0.06,0.5) p.Parent=f parts[i]=p end
    st={folder=f,parts=parts,currentAngle=ConeConfig.NormalAngle,prevYaw=nil,turnDir=0,fired=false,expiresAt=0}
    ConeState[killer]=st
    return st
end
local function hideCone(st) for _,p in ipairs(st.parts) do if p and p.Parent then p.Transparency=1 end end end
local function destroyCone(killer) local st=ConeState[killer] if st and st.folder then pcall(function() st.folder:Destroy() end) end ConeState[killer]=nil end
local function updateCone(st,kRoot,dt,colorOverride)
    local cf=kRoot.CFrame local look=cf.LookVector local yaw=math.atan2(-look.X,-look.Z)
    if st.prevYaw then
        local diff=math.atan2(math.sin(yaw-st.prevYaw),math.cos(yaw-st.prevYaw))
        if math.abs(diff)>0.0005 then st.turnDir=diff>0 and 1 or -1 st.currentAngle=math.min(ConeConfig.MaxAngle,st.currentAngle+math.abs(diff)*ConeConfig.ExpansionSpeed)
        else st.currentAngle=math.max(ConeConfig.NormalAngle,st.currentAngle-ConeConfig.RecoverySpeed*dt) end
    end
    st.prevYaw=yaw
    local half=ConeConfig.NormalAngle/2 local lA,rA=half,half
    if st.turnDir==1 then lA=st.currentAngle-half elseif st.turnDir==-1 then rA=st.currentAngle-half end
    local total=lA+rA local segs=ConeConfig.Segments local range=ConeConfig.Range local center=kRoot.Position local pLen=(range/segs)*1.6
    for i,p in ipairs(st.parts) do
        local alpha=(i-0.5)/segs local offset=math.rad(-lA+total*alpha)
        local dir=CFrame.Angles(0,yaw+offset,0).LookVector local wp=center+dir*range
        p.Size=Vector3.new(ConeConfig.Thickness,0.06,pLen)
        p.CFrame=CFrame.lookAt(Vector3.new(wp.X,center.Y+0.15,wp.Z),Vector3.new(wp.X+dir.X,center.Y+0.15,wp.Z+dir.Z))
        p.Color=colorOverride or ConeConfig.Color p.Transparency=ConeConfig.Transparency
    end
    return yaw,lA,rA
end
local function isPlayerInCone(kRoot,pPos,yaw,lA,rA)
    local kPos=kRoot.Position
    if math.abs(pPos.Y-kPos.Y)>ConeConfig.YTolerance then return false end
    local toP=pPos-kPos local flat=Vector3.new(toP.X,0,toP.Z) local dist=flat.Magnitude
    if dist<0.5 or dist>ConeConfig.Range then return false end
    local pYaw=math.atan2(-flat.X,-flat.Z)
    local diff=math.atan2(math.sin(pYaw-yaw),math.cos(pYaw-yaw))
    return diff>=-math.rad(lA) and diff<=math.rad(rA)
end

