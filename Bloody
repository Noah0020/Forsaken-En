-- TWO TIME (lerp lunge)
--═══════════════════════════════════════════════════════════════════
local NORMAL_STAB_ID = "100725497418533"; local CROUCH_STAB_ID = "89448354637442"
local DAGGER_ANIMS = { [NORMAL_STAB_ID]=true, [CROUCH_STAB_ID]=true }
local TwoTime = { stabbing=false, lastStab=0, conn=nil, savedAR=true, animConn=nil, charConn=nil }
local function TTGetNearest()
    local kf = GetKillersFolder(); local c = LP.Character; local my = c and c:FindFirstChild("HumanoidRootPart")
    if not kf or not my then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            local h = k:FindFirstChild("HumanoidRootPart") or k.PrimaryPart
            local hum = k:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local d = (h.Position - my.Position).Magnitude
                if d < bd then bd = d; best = k end
            end
        end
    end
    return best
end
local function TTCleanup()
    if TwoTime.conn then pcall(function() TwoTime.conn:Disconnect() end); TwoTime.conn = nil end
    local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h.AutoRotate = TwoTime.savedAR; h:Move(Vector3.zero, false) end) end
    TwoTime.stabbing = false
end
local function TTRunLunge(killer)
    if not Settings.TT_Enabled or TwoTime.stabbing or IsPlayerKiller() then return end
    local c = LP.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local now = os.clock()
    if now - TwoTime.lastStab < (Settings.TT_Cooldown or 0.5) then return end
    TwoTime.lastStab = now
    if not killer or not killer.Parent then return end
    local khrp = killer:FindFirstChild("HumanoidRootPart"); if not khrp then return end
    if (khrp.Position - hrp.Position).Magnitude > (Settings.TT_MaxRange or 60) then return end
    TwoTime.savedAR = hum.AutoRotate; hum.AutoRotate = false
    TwoTime.stabbing = true
    local dur = Settings.TT_FollowDuration or 0.5; local endT = tick() + dur
    local lerp = Settings.TT_LerpSpeed or 45
    if TwoTime.conn then pcall(function() TwoTime.conn:Disconnect() end) end
    TwoTime.conn = RunService.RenderStepped:Connect(function(dt)
        if not TwoTime.stabbing then return end
        if tick() >= endT then TTCleanup(); return end
        local c2 = LP.Character; if not c2 then TTCleanup(); return end
        local h2 = c2:FindFirstChild("HumanoidRootPart"); local hu2 = c2:FindFirstChildOfClass("Humanoid")
        if not h2 or not hu2 or hu2.Health <= 0 then TTCleanup(); return end
        local kh = killer and killer.Parent and killer:FindFirstChild("HumanoidRootPart")
        if not kh or not kh.Parent then TTCleanup(); return end
        local kcf = kh.CFrame
        local behind = kcf.Position - kcf.LookVector * (Settings.TT_BehindOffset or 1.7)
        local tgt = Vector3.new(behind.X, h2.Position.Y, behind.Z)
        local d = (tgt - h2.Position).Magnitude
        if d > 0.15 then
            local step = math.min(lerp * dt, d)
            local np = h2.Position + (tgt - h2.Position).Unit * step
            pcall(function()
                h2.CFrame = CFrame.lookAt(np, Vector3.new(kcf.Position.X, np.Y, kcf.Position.Z))
                h2.AssemblyLinearVelocity = Vector3.zero; h2.AssemblyAngularVelocity = Vector3.zero
            end)
        else
            pcall(function()
                h2.CFrame = CFrame.lookAt(h2.Position, Vector3.new(kcf.Position.X, h2.Position.Y, kcf.Position.Z))
                h2.AssemblyLinearVelocity = Vector3.zero; h2.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
    task.delay(dur + 0.1, function() if TwoTime.stabbing then TTCleanup() end end)
end
local function TTAttach(char)
    local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
    local an = hum:WaitForChild("Animator", 5); if not an then return end
    if TwoTime.animConn then pcall(function() TwoTime.animConn:Disconnect() end); TwoTime.animConn = nil end
    TwoTime.animConn = an.AnimationPlayed:Connect(function(track)
        if not Settings.TT_Enabled then return end
        local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
        if id and DAGGER_ANIMS[id] then local k = TTGetNearest(); if k then TTRunLunge(k) end end
    end)
end
local function TTStart()
    if LP.Character then TTAttach(LP.Character) end
    TwoTime.charConn = LP.CharacterAdded:Connect(function(c) task.wait(0.5); if Settings.TT_Enabled then TTAttach(c) end end)
end
local function TTStop()
    TTCleanup()
    if TwoTime.animConn then pcall(function() TwoTime.animConn:Disconnect() end); TwoTime.animConn = nil end
    if TwoTime.charConn then pcall(function() TwoTime.charConn:Disconnect() end); TwoTime.charConn = nil end
end

