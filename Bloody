    getgenv().LastFinishedTrack = nil
    getgenv().AimEnabled = false
    getgenv().AimMode = "Character Lock"
    getgenv().AimValues = {
        Guest1337 = { Enabled = false, Distance = 50, LockDuration = 1.3, Prediction = 0 },
        Shedlekey = { Enabled = false, Distance = 29, LockDuration = 1.2, Prediction = 0 },
        TwoTime = { Enabled = false, Distance = 29, LockDuration = 0.9, Prediction = 0 },
        Chance = { Enabled = false, LockDuration = 1.5, Prediction = 3 },
        Pizza = { Enabled = false, Distance = 50, LockDuration = 1.2, Prediction = 0.5 },
        JaneDoe = { Enabled = false, Distance = 50, LockDuration = 1.1, Prediction = 0 },
    }

    local function scanAnims()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        if not assets then return end
        local function harvest(cfg)
            if not cfg or not cfg:IsA("ModuleScript") then return end
            local ok, data = pcall(require, cfg)
            if not (ok and type(data) == "table" and type(data.Animations) == "table") then return end
            local a = data.Animations
            local function add(key, val)
                if not val then return end
                local id = tostring(val):match("%d+")
                if id and getgenv().AnimationData[key] then
                    getgenv().AnimationData[key][id] = true
                end
            end
            add("Guest1337", a.Punch)
            add("Guest1337", a.ParryPunch)
            add("Shedlekey", a.Slash)
            add("JaneDoe", a.Axe)
            add("Chance", a.AimGun)
        end
        local surv = assets:FindFirstChild("Survivors")
        if surv then
            for _, folder in ipairs(surv:GetChildren()) do
                if folder:FindFirstChild("Config") then harvest(folder.Config) end
            end
        end
        local skins = assets:FindFirstChild("Skins")
        local ss = skins and skins:FindFirstChild("Survivors")
        if ss then
            for _, base in ipairs(ss:GetChildren()) do
                if base:IsA("Folder") then
                    for _, skin in ipairs(base:GetChildren()) do
                        if skin:FindFirstChild("Config") then harvest(skin.Config) end
                    end
                end
            end
        end
    end
    pcall(scanAnims)
    task.delay(2, function() pcall(scanAnims) end)

    local function pickTarget(modeKey, cfg)
        if modeKey == "Pizza" then return GetNearestSurvivorModel(cfg.Distance or 50) end
        if modeKey == "Chance" then return GetNearestKillerModel(9999) end
        local dist = (modeKey == "Guest1337" or modeKey == "JaneDoe") and 9999 or (cfg.Distance or 50)
        return GetNearestKillerModel(dist)
    end

    RunService.RenderStepped:Connect(function()
        if not getgenv().AimEnabled or IsPlayerKiller() then
            if getgenv().ActiveLock.IsActive then
                getgenv().ActiveLock.IsActive = false
                getgenv().ActiveLock.Target = nil
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = true end
            end
            return
        end
        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local AL = getgenv().ActiveLock

        if not AL.IsActive then
            local animator = hum:FindFirstChildOfClass("Animator")
            if not animator then return end
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track ~= getgenv().LastFinishedTrack and track.IsPlaying and track.Animation then
                    local id = tostring(track.Animation.AnimationId):match("%d+")
                    if id then
                        for modeKey, idMap in pairs(getgenv().AnimationData) do
                            local cfg = getgenv().AimValues[modeKey]
                            if cfg and cfg.Enabled and idMap[id] then
                                local target = pickTarget(modeKey, cfg)
                                if target then
                                    AL.IsActive = true
                                    AL.Target = target
                                    AL.StartTime = tick()
                                    AL.Mode = modeKey
                                    AL.Track = track
                                    hum.AutoRotate = false
                                end
                                break
                            end
                        end
                        if AL.IsActive then break end
                    end
                end
            end
            return
        end

        local mode = AL.Mode
        local cfg = getgenv().AimValues[mode]
        if not cfg then AL.IsActive = false; return end
        local elapsed = tick() - AL.StartTime
        local tHRP = AL.Target and AL.Target:FindFirstChild("HumanoidRootPart")
        local tHum = AL.Target and AL.Target:FindFirstChildOfClass("Humanoid")
        if elapsed > (cfg.LockDuration or 1) or not tHRP or (tHum and tHum.Health <= 0) then
            getgenv().LastFinishedTrack = AL.Track
            AL.IsActive = false
            AL.Target = nil
            AL.Track = nil
            hum.AutoRotate = true
            return
        end
        local position = tHRP.Position
        local pred = cfg.Prediction or 0
        if pred > 0 and tHum and tHum.MoveDirection.Magnitude > 0 then
            position = position + tHum.MoveDirection.Unit * pred
        end
        local look = CFrame.lookAt(hrp.Position, Vector3.new(position.X, hrp.Position.Y, position.Z))
        if mode == "Chance" or (tHRP.Position - hrp.Position).Magnitude < 6 then
            hrp.CFrame = look
