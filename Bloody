    if Stam.thread then pcall(task.cancel, Stam.thread); Stam.thread = nil end
end
local function Stam_SetInfinite(v)
    if v and not Stam.mod then Stam_GetMod() end
    if v and not Stam.mod then
        Library:Notify({ Title="Stamina", Description="Sprinting module not found", Time=3 }); return
    end
