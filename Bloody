local function isFacingKiller(kr)
    if not LocalRoot or not kr then return false end
    local toMe = LocalRoot.Position - kr.Position
    local flat = Vector3.new(toMe.X, 0, toMe.Z)
    local look = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
    if flat.Magnitude < 0.05 or look.Magnitude < 0.05 then return false end
    return look.Unit:Dot(flat.Unit) >= (SettingsAB.FacingDot or 0.35)
end

local function makeFrameHitbox(kr)
    local m = SettingsAB.HitboxMultiplier or 1
    local dist = SettingsAB.HitboxDistance or 3
    local size = Vector3.new(6 * m, 6 * m, 9 * m)
    local hb = Instance.new("Part")
    hb.Name = "AutoBlockHitbox_Frame"
    hb.Anchored = true
    hb.CanCollide = false
    hb.CanTouch = false
    hb.CanQuery = true
    hb.CastShadow = false
    hb.Material = Enum.Material.ForceField
    hb.Color = Color3.fromRGB(255, 40, 40)
    hb.Transparency = SettingsAB.ShowHitboxVisual and (SettingsAB.HitboxTransparency or 0.75) or 1
    hb.Size = size
    hb.CFrame = kr.CFrame * CFrame.new(0, 0, -dist)
    hb.Parent = HitboxFolder
    if SettingsAB.ShowOutline and SettingsAB.ShowHitboxVisual then
        local sb = Instance.new("SelectionBox")
        sb.Adornee = hb
        sb.Color3 = Color3.fromRGB(255, 60, 60)
        sb.LineThickness = 0.04
        sb.Transparency = 0.3
        sb.Parent = hb
    end
    Debris:AddItem(hb, 0.2)
    return hb
end

local function playerInsideHitbox(hb)
    if not LocalRoot or not hb then return false end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    local parts = {}
    if LocalChar then
        for _, p in ipairs(LocalChar:GetChildren()) do
            if p:IsA("BasePart") then parts[#parts + 1] = p end
        end
    end
    if #parts == 0 then parts = { LocalRoot } end
    params.FilterDescendantsInstances = parts
    local hits = workspace:GetPartsInPart(hb, params)
    if hits and #hits > 0 then return true end
    -- fallback: point in box
    local localPt = hb.CFrame:PointToObjectSpace(LocalRoot.Position)
    local hs = hb.Size * 0.5
    return math.abs(localPt.X) <= hs.X and math.abs(localPt.Y) <= hs.Y and math.abs(localPt.Z) <= hs.Z
end

local function fireBlockBurst()
    local n = SettingsAB.SpamEnabled and (SettingsAB.SpamCount or 6) or 3
    -- same-frame multi-fire for instant server hit
    for i = 1, n do
        FireBlock()
    end
end

local function DoBlock(kr)
    local now = os.clock()
    if now - ABState.lastBlock < 0.001 then return end
    ABState.lastBlock = now
    fireBlockBurst()
    if SettingsAB.AutoPunch and kr then
        task.spawn(function()
            aimAt(kr, 0.16)
            task.wait(SettingsAB.PunchDelay or 0.12)
            if LocalRoot and kr.Parent then aimAt(kr, 0.08) end
            FirePunch()
        end)
    end
end

local function HDT_Dash(killer)
    if not SettingsAB.HDTEnabled or HDTState.debounce or not LocalRoot or not LocalHum then return end
    if os.clock() - HDTState.lastUse < 27 then return end
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not kr then return end
    if (kr.Position - LocalRoot.Position).Magnitude > 45 then return end
    HDTState.debounce = true
    HDTState.lastUse = os.clock()
    local speed = SettingsAB.HDTSpeed or 40
    local dur = SettingsAB.HDTDuration or 0.6
    local oWS = LocalHum.WalkSpeed
    local oAR = LocalHum.AutoRotate
    local st = tick()
    local bind = "GH_HDT_" .. tostring(math.random(1, 1e9))
    pcall(function()
        RS:BindToRenderStep(bind, Enum.RenderPriority.Last.Value + 1, function()
            if not HDTState.debounce then
                pcall(function() RS:UnbindFromRenderStep(bind) end)
                return
            end
            if not LocalRoot or not LocalHum or not kr.Parent then
                HDTState.debounce = false
                return
            end
            local flat = Vector3.new(kr.Position.X - LocalRoot.Position.X, 0, kr.Position.Z - LocalRoot.Position.Z)
            if flat.Magnitude <= 2 then
                HDTState.debounce = false
                return
            end
            LocalHum.WalkSpeed = speed
            LocalHum.AutoRotate = false
            LocalHum:Move(flat.Unit, false)
            LocalRoot.CFrame = CFrame.lookAt(LocalRoot.Position, LocalRoot.Position + flat.Unit)
            if tick() - st > dur then
                HDTState.debounce = false
            end
        end)
    end)
    task.delay(dur + 0.15, function()
        HDTState.debounce = false
        pcall(function() RS:UnbindFromRenderStep(bind) end)
        if LocalHum and LocalHum.Parent then
            pcall(function()
                LocalHum:Move(Vector3.zero, false)
                LocalHum.WalkSpeed = oWS
                LocalHum.AutoRotate = oAR
            end)
        end
    end)
end

local function tryHitboxBlock(killer)
    if not SettingsAB.Enabled or not LocalRoot then return end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    if not kr then return end
    local dist = (kr.Position - LocalRoot.Position).Magnitude
    if dist > (SettingsAB.Range or 20) then return end
    -- Instant path: close + facing (or anti-bait) => block NOW, no wait
    local facing = isFacingKiller(kr)
    if facing or SettingsAB.AntiBait then
        if dist <= math.max((SettingsAB.HitboxDistance or 3) + 6 * (SettingsAB.HitboxMultiplier or 1), 8) then
            DoBlock(kr)
            if SettingsAB.HDTEnabled and (SettingsAB.HDTDelay or 0) <= 0 then
                HDT_Dash(killer)
            elseif SettingsAB.HDTEnabled then
                task.delay(SettingsAB.HDTDelay, function() HDT_Dash(killer) end)
            end
        end
    end
    local hb = makeFrameHitbox(kr)
    if playerInsideHitbox(hb) then
        hb.Color = Color3.fromRGB(60, 255, 100)
        DoBlock(kr)
        if SettingsAB.HDTEnabled and (SettingsAB.HDTDelay or 0) <= 0 then
            HDT_Dash(killer)
        elseif SettingsAB.HDTEnabled then
            task.delay(SettingsAB.HDTDelay or 0.05, function() HDT_Dash(killer) end)
        end
    end
end

local function armKiller(killer, window)
    ABState.pending[killer] = os.clock() + (window or SettingsAB.PendingWindow or 0.28)
end

local function trackKillerAB(killer)
    if not killer or not killer:IsA("Model") then return end
    local hum = killer:FindFirstChildOfClass("Humanoid") or killer:WaitForChild("Humanoid", 4)
    if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator")
    if anim then
        table.insert(ABState.connections, anim.AnimationPlayed:Connect(function(track)
            if not SettingsAB.Enabled or not track.Animation then return end
            local id = extractId(track.Animation.AnimationId)
            if id and (AttackAnims["rbxassetid://" .. id] or AttackAnims[id]) then
                local kr = killer:FindFirstChild("HumanoidRootPart")
                if kr and LocalRoot and (kr.Position - LocalRoot.Position).Magnitude <= (SettingsAB.Range or 20) then
                    DoBlock(kr) -- instant
                end
                armKiller(killer, 0.15)
                tryHitboxBlock(killer)
            end
        end))
    end
    local function hookSound(s)
        if not s:IsA("Sound") then return end
        local sid = s.SoundId
        local num = extractId(sid)
        if AttackSounds[sid] or (num and AttackSounds[num]) or (num and AttackSounds["rbxassetid://" .. num]) then
            table.insert(ABState.connections, s.Played:Connect(function()
                if not SettingsAB.Enabled then return end
                local kr = killer:FindFirstChild("HumanoidRootPart")
                if kr and LocalRoot and (kr.Position - LocalRoot.Position).Magnitude <= (SettingsAB.Range or 20) then
                    DoBlock(kr) -- instant
                end
                armKiller(killer, 0.15)
                tryHitboxBlock(killer)
            end))
        end
    end
    for _, d in ipairs(killer:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d) end
    end
    table.insert(ABState.connections, killer.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d) end
    end))
    -- ability last used
    local last = killer:GetAttribute("AbilityLastUsed") or 0
    table.insert(ABState.connections, killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not SettingsAB.Enabled then return end
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == last then return end
        last = cur
        local kr = killer:FindFirstChild("HumanoidRootPart")
        if kr and LocalRoot and (kr.Position - LocalRoot.Position).Magnitude <= (SettingsAB.Range or 20) then
            DoBlock(kr) -- instant
        end
        armKiller(killer, 0.15)
        tryHitboxBlock(killer)
    end))
end

local function abHeartbeat()
    if not SettingsAB.Enabled or not LocalRoot then return end
    local now = os.clock()
    for killer, untilT in pairs(ABState.pending) do
        if not killer.Parent or now > untilT then
            ABState.pending[killer] = nil
        else
            tryHitboxBlock(killer)
        end
    end
end

