local function makeHitboxAndCheck(killerModel)
    if not killerModel or not killerModel.Parent or not CONFIG.AutoBlock then return end
    if not KillersFolder or not killerModel:IsDescendantOf(KillersFolder) then return end

    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
    if not killerRoot then return end

    local hbCfg = getKillerHitbox(killerModel.Name)
    local m = CONFIG.HitboxMultiplier or 1
    local size = Vector3.new(
        (hbCfg.width or CONFIG.HitboxWidth) * m,
        (hbCfg.height or CONFIG.HitboxHeight) * m,
        (hbCfg.length or CONFIG.HitboxLength) * m
    )

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killerModel}

    task.spawn(function()
        local startTime = tick()
        local blockedOnce = false
        while tick() - startTime < (hbCfg.dura or 0.28) do
            if blockedOnce or not CONFIG.AutoBlock then break end
            local ckr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not ckr then break end

            local dist = hbCfg.distance or CONFIG.HitboxDistance or 3
            local frozenCFrame = ckr.CFrame * CFrame.new(0, 0, -dist)

            local hb = Instance.new("Part")
            hb.Name = "AutoBlockHitbox_Frame"
            hb.Transparency = CONFIG.ShowHitboxVisual and CONFIG.HitboxTransparency or 1
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Anchored = true
            hb.Size = size; hb.Color = CONFIG.HitboxColor
            hb.Material = Enum.Material.ForceField
            hb.CFrame = frozenCFrame; hb.Parent = workspace

            local sb
            if CONFIG.ShowOutline and CONFIG.ShowHitboxVisual then
                sb = Instance.new("SelectionBox")
                sb.Adornee = hb; sb.Color3 = CONFIG.HitboxColor
                sb.LineThickness = CONFIG.OutlineThickness
                sb.Transparency = CONFIG.OutlineTransparencyValue or 0.55
                sb.Visible = true; sb.Parent = hb
            end
            Debris:AddItem(hb, hbCfg.life or 0.28)

            if CONFIG.HDT then
                local hdt = Instance.new("Part")
                hdt.Name = "HDT_Visual"
                hdt.Size = Vector3.new(0.4, 0.4, 0.4)
                hdt.Shape = Enum.PartType.Ball
                hdt.Color = Color3.fromRGB(255, 200, 40)
                hdt.Material = Enum.Material.Neon
                hdt.Anchored = true; hdt.CanCollide = false
                hdt.CFrame = frozenCFrame
                hdt.Parent = workspace
                Debris:AddItem(hdt, hbCfg.life or 0.28)
            end

            local found = false
            for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                    found = true; break
                end
            end

            if found and not blockedOnce then
                blockedOnce = true
                pcall(function()
                    hb.Color = CONFIG.HitboxHitColor
                    if sb then sb.Color3 = CONFIG.HitboxHitColor end
                end)
                fireBlock(); fireBlock(); fireBlock(); fireBlock()
                spamBlock(0.05)
                if CONFIG.AutoPunch then
                    task.delay(CONFIG.PunchDelay or 0.45, FirePunch)
                end
                break
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local lastAbilityLastUsed, lastAbilitiesUsed, blockLocked = nil, nil, false

local function checkKillerAttack()
    if not CONFIG.AutoBlock or not KillersFolder then return end
    local killer = KillersFolder:GetChildren()[1]
    if not killer or not killer:IsA("Model") then return end

    local currentALU = killer:GetAttribute("AbilityLastUsed") or 0
    local currentAU  = killer:GetAttribute("AbilitiesUsed") or 0

    if lastAbilityLastUsed == nil then
        lastAbilityLastUsed = currentALU
        lastAbilitiesUsed = currentAU
        return
    end

    if currentAU > lastAbilitiesUsed then blockLocked = true end
    if currentALU > lastAbilityLastUsed then
        if blockLocked then
            blockLocked = false
        else
            local lastName = killer:GetAttribute("LastAbility") or killer:GetAttribute("AbilityName")
            if not lastName or isAttackAbility(tostring(lastName)) then
                makeHitboxAndCheck(killer)
            end
        end
    end
    lastAbilityLastUsed = currentALU
    lastAbilitiesUsed = currentAU
end

RunService.Heartbeat:Connect(function()
    if CONFIG.AutoBlock then pcall(checkKillerAttack) end
end)

