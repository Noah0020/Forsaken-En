local espFolder = workspace:FindFirstChild("ESP_Folder") or Instance.new("Folder")
espFolder.Name = "ESP_Folder"; espFolder.Parent = workspace
local espConns = {}

local function clearESPByPrefix(prefix)
    for _, o in ipairs(espFolder:GetChildren()) do
        if o.Name:sub(1, #prefix) == prefix then o:Destroy() end
    end
end

local function applyHL(hl, fillColor)
    if not hl then return end
    hl.FillColor = fillColor
    hl.OutlineColor = Color3.fromRGB(0, 0, 0)
    hl.FillTransparency = CONFIG.ESPFillTransparency
    hl.OutlineTransparency = CONFIG.ESPOutlineTransparency
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

local function makePlayerESP(player, isKiller)
    if player == LocalPlayer then return end
    local prefix = isKiller and "KillGlow_" or "SurvGlow_"
    local bbPrefix = isKiller and "Kill_BB_" or "Surv_BB_"
    local fillColor = isKiller and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(60, 255, 80)

    local function setup(character)
        if not character then return end
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local hum = character:FindFirstChildOfClass("Humanoid")
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local active = (isKiller and CONFIG.ESPKiller) or (not isKiller and CONFIG.ESPSurvivor)
            if not character:IsDescendantOf(workspace) or not active or (hum and hum.Health <= 0) then
                local g = espFolder:FindFirstChild(prefix .. player.Name); if g then g:Destroy() end
                if hrp and hrp:FindFirstChild(bbPrefix .. player.Name) then hrp[bbPrefix .. player.Name]:Destroy() end
                if conn then conn:Disconnect() end
                return
            end
            local inCorrect = isKiller and character.Parent == KillersFolder or (not isKiller and character.Parent == SurvivorsFolder)
            if inCorrect then
                local hl = espFolder:FindFirstChild(prefix .. player.Name)
                if not hl then
                    hl = Instance.new("Highlight"); hl.Name = prefix .. player.Name
                    hl.Adornee = character; hl.Parent = espFolder
                end
                applyHL(hl, fillColor)
                if hrp then
                    local bb = hrp:FindFirstChild(bbPrefix .. player.Name)
                    if not bb then
                        bb = Instance.new("BillboardGui")
                        bb.Name = bbPrefix .. player.Name
                        bb.AlwaysOnTop = true; bb.Size = UDim2.new(0, 110, 0, 36)
                        bb.StudsOffset = Vector3.new(0, CONFIG.ESPStudsOffsetY, 0)
                        bb.Adornee = hrp; bb.Parent = hrp
                        local nameLbl = Instance.new("TextLabel")
                        nameLbl.Name = "NameLabel"; nameLbl.Size = UDim2.new(1,0,0.55,0)
                        nameLbl.BackgroundTransparency = 1; nameLbl.Font = Enum.Font.GothamBold
                        nameLbl.TextStrokeTransparency = 0.3; nameLbl.TextColor3 = fillColor
                        nameLbl.TextSize = CONFIG.ESPNameSize; nameLbl.Parent = bb
                        local hpLbl = Instance.new("TextLabel")
                        hpLbl.Name = "HPLabel"; hpLbl.Size = UDim2.new(1,0,0.45,0)
                        hpLbl.Position = UDim2.new(0,0,0.55,0); hpLbl.BackgroundTransparency = 1
                        hpLbl.Font = Enum.Font.Gotham; hpLbl.TextStrokeTransparency = 0.3
                        hpLbl.TextColor3 = fillColor; hpLbl.TextSize = CONFIG.ESPInfoSize; hpLbl.Parent = bb
                    end
                    local nameLbl = bb:FindFirstChild("NameLabel")
                    local hpLbl = bb:FindFirstChild("HPLabel")
                    if nameLbl then nameLbl.Text = CONFIG.ShowName and character.Name or ""; nameLbl.TextSize = CONFIG.ESPNameSize end
                    if hpLbl and hum then hpLbl.Text = CONFIG.ShowHP and (math.floor(hum.Health) .. " HP") or ""; hpLbl.TextSize = CONFIG.ESPInfoSize end
                end
            else
                local g = espFolder:FindFirstChild(prefix .. player.Name); if g then g:Destroy() end
            end
        end)
        table.insert(espConns, conn)
    end
    if player.Character then setup(player.Character) end
    player.CharacterAdded:Connect(setup)
end

local function makeGeneratorESP(gen)
    if not gen:IsA("Model") or gen.Name ~= "Generator" or not CONFIG.ESPGenerators then return end
    local main = gen:FindFirstChild("Main") or gen:FindFirstChildWhichIsA("BasePart")
    if not main then return end
    local prog = gen:FindFirstChild("Progress")
    if prog and prog.Value >= 100 then return end
    local id = tostring(gen:GetDebugId())
    local color = Color3.fromRGB(0, 220, 255)
    local hl = espFolder:FindFirstChild("GenGlow_" .. id)
    if not hl then
        hl = Instance.new("Highlight"); hl.Name = "GenGlow_" .. id
        hl.Adornee = gen; hl.Parent = espFolder
    end
    applyHL(hl, color)
    if not main:FindFirstChild("Gen_BB_" .. id) then
        local bb = Instance.new("BillboardGui")
        bb.Name = "Gen_BB_" .. id; bb.Size = UDim2.new(0,90,0,20)
        bb.AlwaysOnTop = true; bb.Adornee = main; bb.StudsOffset = Vector3.new(0,2.2,0); bb.Parent = main
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold; lbl.TextStrokeTransparency = 0.3
        lbl.TextColor3 = color; lbl.TextSize = CONFIG.ESPInfoSize; lbl.Text = "Generator"; lbl.Parent = bb
    end
end

local function makeItemESP(tool)
    if not tool:IsA("Tool") or not CONFIG.ESPItems then return end
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if not handle then return end
    local isHeld = tool.Parent and (tool.Parent:FindFirstChildOfClass("Humanoid") or tool.Parent:IsA("Backpack"))
    if isHeld then return end
    local ok, id = pcall(function() return tool:GetDebugId() end)
    if not ok then return end
    local color = Color3.fromRGB(255, 200, 40)
    local hl = espFolder:FindFirstChild("ItemGlow_" .. id)
    if not hl then
        hl = Instance.new("Highlight"); hl.Name = "ItemGlow_" .. id
        hl.Adornee = tool; hl.Parent = espFolder
    end
    applyHL(hl, color)
    if not handle:FindFirstChild("Item_BB_" .. id) then
        local bb = Instance.new("BillboardGui")
        bb.Name = "Item_BB_" .. id; bb.Size = UDim2.new(0,90,0,18)
        bb.AlwaysOnTop = true; bb.Adornee = handle; bb.StudsOffset = Vector3.new(0,1.6,0); bb.Parent = handle
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold; lbl.TextStrokeTransparency = 0.3
        lbl.TextColor3 = color; lbl.TextSize = CONFIG.ESPInfoSize; lbl.Text = tool.Name; lbl.Parent = bb
    end
end

