local function onBlockConfirmed()
    local now = tick()
    SimpleAB.lastConfirmedBlock = now
    for _, state in pairs(SimpleAB.killerStates) do
        if state.attempts > 0 and now >= state.firstFire and now - state.firstFire <= 0.75 then
            state.confirmed = true
        end
    end
end

local function attachLocalConfirmation(character)
    if not character then return end
    local function monitor(sound)
        if not sound or not sound:IsA("Sound") then return end
        local function check()
            if BLOCK_CONFIRM_SOUNDS[sound.SoundId] then onBlockConfirmed() end
        end
        local okPlayed, playedConnection = pcall(function() return sound.Played:Connect(check) end)
        if okPlayed and playedConnection then table.insert(SimpleAB.connections, playedConnection) end
        local okResumed, resumedConnection = pcall(function() return sound.Resumed:Connect(check) end)
        if okResumed and resumedConnection then table.insert(SimpleAB.connections, resumedConnection) end
        if sound.IsPlaying then check() end
    end
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Sound") then monitor(descendant) end
    end
    table.insert(SimpleAB.connections, character.DescendantAdded:Connect(monitor))
end

--// Layer 2: Duck Hub's oriented box dimensions and overlap approach.
local function getDuckBoxCFrame(killerRoot)
    return killerRoot.CFrame * CFrame.new(0, 0, -(Config.boxDepth / 2) - Config.boxDistance)
end

local function drawDuckBox(killerRoot)
    if not Config.showDuckBox or not killerRoot or not killerRoot.Parent then return end
    local box = Instance.new("Part")
    box.Name = "SimpleHub_DuckBox"
    box.Size = Vector3.new(Config.boxWidth, Config.boxHeight, Config.boxDepth)
    box.Color = Config.boxColor
    box.Transparency = Config.boxTransparency
    box.Material = Enum.Material.Neon
    box.Anchored = true
    box.CanCollide = false
    box.CanTouch = false
    box.CanQuery = false
    box.CastShadow = false
    box.Massless = true
    box.CFrame = getDuckBoxCFrame(killerRoot)
    box.Parent = Workspace
    Debris:AddItem(box, Config.visibleTime)
end

local function duckBoxContainsPlayer(killer)
    local character, _, localRoot = getLocalParts()
    local killerRoot = getRoot(killer)
    if not character or not localRoot or not killerRoot then return false end

    local pingLead = getPingSeconds() * 22
    local broadRange = Config.boxDepth + Config.boxDistance + 3 + pingLead
    if (localRoot.Position - killerRoot.Position).Magnitude > broadRange then return false end

    SimpleAB.overlapParams.FilterDescendantsInstances = { character }
    local boxCFrame = getDuckBoxCFrame(killerRoot)
    local ok, parts = pcall(function()
        return Workspace:GetPartBoundsInBox(
            boxCFrame,
            Vector3.new(Config.boxWidth, Config.boxHeight, Config.boxDepth),
            SimpleAB.overlapParams
        )
    end)
    if not ok or type(parts) ~= "table" then return false end
    for _, part in ipairs(parts) do
        if part and part:IsDescendantOf(character) then return true end
    end
    return false
end

--// Layer 3: attack-cue watcher on the requested killers.
local function attachSound(sound)
    if not sound or not sound:IsA("Sound") or SimpleAB.seenSounds[sound] then return end
    SimpleAB.seenSounds[sound] = true

    local function onPlayed()
        if not SimpleAB.running or not Config.cueLayer or not Config.soundWatcher then return end
        local now = tick()
        local last = SimpleAB.soundDebounce[sound] or 0
        if now - last < 0.10 then return end
        SimpleAB.soundDebounce[sound] = now

        local killer = getKillerFromInstance(sound)
        if not killer then return end
        local cueMatch = matchesAttackCue(getCueNameContext(sound, killer))
        local duckIdMatch = soundHasDuckId(sound)
        if not cueMatch and not duckIdMatch then return end

        local didFire = requestBlock(killer, cueMatch and "sound-name" or "duck-sound-id")
        if didFire then
            local root = getRoot(killer)
            if root then drawDuckBox(root) end
        end
    end

    local okPlayed, playedConnection = pcall(function() return sound.Played:Connect(onPlayed) end)
    if okPlayed and playedConnection then table.insert(SimpleAB.connections, playedConnection) end
    local okResumed, resumedConnection = pcall(function() return sound.Resumed:Connect(onPlayed) end)
    if okResumed and resumedConnection then table.insert(SimpleAB.connections, resumedConnection) end
    if sound.IsPlaying then onPlayed() end
end

local function attachAnimator(killer)
    local state = getKillerState(killer)
    local humanoid = killer:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator or state.animator == animator then return end
    state.animator = animator
    local ok, connection = pcall(function()
        return animator.AnimationPlayed:Connect(function(track)
            if not SimpleAB.running or not Config.cueLayer or not Config.animationWatcher then return end
            local animation = track and track.Animation
            local text = tostring(track and track.Name or "") .. " " .. tostring(animation and animation.Name or "")
            if not matchesAttackCue(text) then return end
            local didFire = requestBlock(killer, "animation-name")
            if didFire then
                local root = getRoot(killer)
                if root then drawDuckBox(root) end
            end
        end)
    end)
    if ok and connection then table.insert(SimpleAB.connections, connection) end
end

local function trackKiller(killer)
    if not killer or not killer:IsA("Model") or not isWatchedKiller(killer) then return end
    local state = getKillerState(killer)
    if state.tracked then
        attachAnimator(killer)
        return
    end
    state.tracked = true
    attachAnimator(killer)
    for _, descendant in ipairs(killer:GetDescendants()) do
        if descendant:IsA("Sound") then attachSound(descendant) end
    end
    table.insert(SimpleAB.connections, killer.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Animator") or descendant:IsA("Humanoid") then
            task.defer(function()
                if SimpleAB.running and killer.Parent then attachAnimator(killer) end
            end)
        elseif descendant:IsA("Sound") then
            attachSound(descendant)
        end
    end))
end

local function scanWorkspaceSounds()
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Sound") then attachSound(descendant) end
    end
end

local function updateKillersFolder()
    local folder = getKillersFolder()
    if folder == SimpleAB.lastFolder then return end
    if SimpleAB.folderChildConnection then
        pcall(function() SimpleAB.folderChildConnection:Disconnect() end)
        SimpleAB.folderChildConnection = nil
    end
    SimpleAB.lastFolder = folder
    if folder then
        SimpleAB.folderChildConnection = folder.ChildAdded:Connect(function(child)
            task.defer(function() if SimpleAB.running then trackKiller(child) end end)
        end)
        table.insert(SimpleAB.connections, SimpleAB.folderChildConnection)
        for _, killer in ipairs(folder:GetChildren()) do trackKiller(killer) end
    end
end

local function startWatcherLayers()
    if SimpleAB.running then return end
    SimpleAB.running = true
    SimpleAB.killerStates = setmetatable({}, { __mode = "k" })
    SimpleAB.seenSounds = setmetatable({}, { __mode = "k" })
    SimpleAB.soundDebounce = setmetatable({}, { __mode = "k" })
    SimpleAB.connections = {}
    SimpleAB.lastFolder = nil
    SimpleAB.lastConfirmedBlock = 0
    SimpleAB.lastFolderScan = 0

    attachLocalConfirmation(LocalPlayer.Character)
    table.insert(SimpleAB.connections, LocalPlayer.CharacterAdded:Connect(function(character)
        if SimpleAB.running then task.wait(0.25); attachLocalConfirmation(character) end
    end))

    table.insert(SimpleAB.connections, Workspace.DescendantAdded:Connect(function(descendant)
        if not SimpleAB.running then return end
        if descendant:IsA("Sound") then
            attachSound(descendant)
        elseif descendant:IsA("Model") then
            local killer = getKillerFromInstance(descendant)
            if killer then trackKiller(killer) end
        end
    end))

    scanWorkspaceSounds()
    updateKillersFolder()
    SimpleAB.heartbeat = RunService.Heartbeat:Connect(function()
        if not SimpleAB.running then return end
        local now = tick()
        if now - SimpleAB.lastFolderScan >= 0.25 then
            SimpleAB.lastFolderScan = now
            updateKillersFolder()
        end

        if Config.duckLayer and not localPlayerIsKiller() then
            local folder = getKillersFolder()
            if folder then
                for _, killer in ipairs(folder:GetChildren()) do
                    if killer:IsA("Model") and isWatchedKiller(killer) then
                        trackKiller(killer)
                        local state = getKillerState(killer)
                        if now - (state.lastBoxScan or 0) >= 0.035 then
                            state.lastBoxScan = now
                            local containsPlayer = duckBoxContainsPlayer(killer)
                            if containsPlayer then
                                local didFire = requestBlock(killer, "duck-box")
                                if didFire then
                                    local root = getRoot(killer)
                                    if root then drawDuckBox(root) end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function stopWatcherLayers()
    SimpleAB.running = false
    if SimpleAB.heartbeat then
        pcall(function() SimpleAB.heartbeat:Disconnect() end)
        SimpleAB.heartbeat = nil
    end
    if SimpleAB.folderChildConnection then
        pcall(function() SimpleAB.folderChildConnection:Disconnect() end)
        SimpleAB.folderChildConnection = nil
    end
    for _, connection in ipairs(SimpleAB.connections) do
        pcall(function() connection:Disconnect() end)
    end
    SimpleAB.connections = {}
    SimpleAB.killerStates = setmetatable({}, { __mode = "k" })
    SimpleAB.seenSounds = setmetatable({}, { __mode = "k" })
    SimpleAB.soundDebounce = setmetatable({}, { __mode = "k" })
    SimpleAB.lastFolder = nil
    pcall(function()
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("BasePart") and child.Name == "SimpleHub_DuckBox" then child:Destroy() end
        end
    end)
end

--// Core layer management. Existing core settings are restored when Simple Hub stops.
local function startSkidLayer()
    local settings = getSettings()
    if type(settings) ~= "table" then return false end
    if settings.PermanentABLock then
        notify("Auto Block locked", "SkidSaken's safety lock is active.", "alert-triangle")
        return false
    end
    settings.AutoBlock = false
    settings.AutoBlockCustom = false
    settings.AutoBlockRectangle = true
    local start = G("StartAutoBlock")
    local startHitbox = G("NS_StartHitboxLoop")
    local ok, err = pcall(start)
    if not ok then notify("SkidSaken start failed", tostring(err), "alert-triangle"); return false end
    local ok2, err2 = pcall(startHitbox)
    if not ok2 then
        pcall(G("StopAutoBlock"))
        notify("Hitbox start failed", tostring(err2), "alert-triangle")
        return false
    end
    return true
end

local function stopSkidLayer()
    local settings = getSettings()
    if type(settings) == "table" then settings.AutoBlockRectangle = false end
    pcall(G("StopAutoBlock"))
    pcall(G("NS_StopHitboxLoop"))
end

local function restoreCoreSettings()
    local saved = SimpleAB.savedCore
    if not saved then return end
    stopSkidLayer()
    local settings = getSettings()
    if type(settings) == "table" then
        settings.AutoBlock = saved.AutoBlock
        settings.AutoBlockCustom = saved.AutoBlockCustom
        settings.AutoBlockRectangle = saved.AutoBlockRectangle
    end
    if saved.wasRunning then
        pcall(G("StartAutoBlock"))
        if type(settings) == "table" and settings.AutoBlockRectangle then
            pcall(G("NS_StartHitboxLoop"))
        end
    end
    SimpleAB.savedCore = nil
end

local function setSimpleHub(enabled)
    if enabled then
        if not coreReady() then
            notify("SkidSaken core missing", "Load the complete SkidSaken v1.7 core before enabling Simple Hub.", "alert-triangle")
            return false
        end
        local settings = getSettings()
        if settings.PermanentABLock then
            notify("Auto Block locked", "SkidSaken's safety lock is active.", "alert-triangle")
            return false
        end
        if not SimpleAB.savedCore then
            local ab = G("AB")
            SimpleAB.savedCore = {
                AutoBlock = settings.AutoBlock,
                AutoBlockCustom = settings.AutoBlockCustom,
                AutoBlockRectangle = settings.AutoBlockRectangle,
                wasRunning = type(ab) == "table" and ab.running == true,
            }
        end
        Config.enabled = true
        if Config.skidLayer and not startSkidLayer() then
            Config.enabled = false
            restoreCoreSettings()
            return false
        end
        local watcherOK, watcherError = pcall(startWatcherLayers)
        if not watcherOK then
            Config.enabled = false
            restoreCoreSettings()
            notify("Watcher startup failed", tostring(watcherError), "alert-triangle")
            return false
        end
        notify("Simple Hub active", "SkidSaken + Duck box + killer sound/animation watcher are running.", "shield-check")
        return true
    end

    Config.enabled = false
    stopWatcherLayers()
    restoreCoreSettings()
    notify("Simple Hub stopped", "All three detection layers have been stopped.", "shield-off")
    return true
end

local function setSkidLayer(enabled)
    Config.skidLayer = enabled
    if not Config.enabled then return end
    if enabled then
        if not startSkidLayer() then Config.skidLayer = false end
    else
        stopSkidLayer()
    end
end

