safe("HDT", function()
    local hdtConn, hdtBv, hdtHum = nil, nil, nil
    local function stopHDT()
        HDT.busy = false
        if hdtConn then pcall(function() hdtConn:Disconnect() end); hdtConn = nil end
        if hdtBv then pcall(function() if hdtBv.Parent then hdtBv:Destroy() end end); hdtBv = nil end
        if hdtHum then
            pcall(function() hdtHum.AutoRotate = true; hdtHum:Move(Vector3.zero, false) end)
            hdtHum = nil
        end
    end

    HDT_Trigger = function(killerModel)
        if not HDT.enabled or IsPlayerKiller() or HDT.busy then return end
        task.spawn(function()
            if HDT.delay and HDT.delay > 0 then task.wait(HDT.delay) end
            if not HDT.enabled or IsPlayerKiller() then return end
            local c = LP.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local k = killerModel or GetNearestKillerModel(math.huge)
            local tr = k and k:FindFirstChild("HumanoidRootPart")
            if not (hrp and hum and tr) or hum.Health <= 0 then return end
            stopHDT()
            HDT.busy = true
            hdtHum = hum
            hum.AutoRotate = false
            local flat = Vector3.new(tr.Position.X, hrp.Position.Y, tr.Position.Z)
            hrp.CFrame = CFrame.lookAt(hrp.Position, flat)
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e5, 0, 1e5)
            bv.P = 1e4
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
            Debris:AddItem(bv, (HDT.duration or 0.8) + 0.4)
            hdtBv = bv
            local startT = os.clock()
            local dur = math.max(0.05, HDT.duration or 0.8)
            local spd = HDT.speed or 12
            hdtConn = RunService.Heartbeat:Connect(function()
                if not HDT.enabled or IsPlayerKiller() or os.clock() - startT >= dur then
                    stopHDT()
                    return
                end
                local kk = GetNearestKillerModel(math.huge)
                local kr = kk and kk:FindFirstChild("HumanoidRootPart")
                if not (hrp.Parent and kr and bv.Parent) then
                    stopHDT()
                    return
                end
                local to = Vector3.new(kr.Position.X - hrp.Position.X, 0, kr.Position.Z - hrp.Position.Z)
                if to.Magnitude > 0.5 then
                    bv.Velocity = to.Unit * spd
                    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(kr.Position.X, hrp.Position.Y, kr.Position.Z))
                else
                    bv.Velocity = Vector3.zero
                end
            end)
        end)
    end

    -- ONLY when local Block animation plays
    local BLOCK_ANIM_NAME_HINTS = { "block", "Block", "parry", "Parry" }
    local LOCAL_BLOCK_IDS = {} -- filled from Guest configs
    pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local surv = assets and assets:FindFirstChild("Survivors")
        local guest = surv and surv:FindFirstChild("Guest1337")
        local cfg = guest and guest:FindFirstChild("Config")
        if cfg then
            local ok, mod = pcall(require, cfg)
            if ok and type(mod) == "table" and type(mod.Animations) == "table" then
                for k, v in pairs(mod.Animations) do
                    local kl = tostring(k):lower()
                    if kl:find("block") or kl:find("parry") then
                        for _, id in ipairs(extractAnimIds(v)) do LOCAL_BLOCK_IDS[id] = true end
                    end
                end
            end
        end
    end)

    local function onLocalAnim(track)
        if not HDT.enabled or IsPlayerKiller() then return end
        local anim = track.Animation
        if not anim then return end
        local id = tostring(anim.AnimationId):match("%d+")
        local name = tostring(anim.Name or ""):lower()
        local isBlock = (id and LOCAL_BLOCK_IDS[id]) or false
        if not isBlock then
            for _, h in ipairs(BLOCK_ANIM_NAME_HINTS) do
                if name:find(h:lower(), 1, true) then isBlock = true; break end
            end
        end
        if isBlock then
            local k = GetNearestKillerModel(math.huge)
            HDT_Trigger(k)
        end
    end

    local function hookLocalChar(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
        if not animator then return end
        animator.AnimationPlayed:Connect(onLocalAnim)
    end
    if LP.Character then task.spawn(hookLocalChar, LP.Character) end
    LP.CharacterAdded:Connect(function(c) task.spawn(hookLocalChar, c) end)

    local left = Tabs.HDT:AddLeftGroupbox("Hitbox Dragging Tech", "activity")
    left:AddToggle("HDT_Enable", {
        Text = "Enable HDT", Default = false,
        Callback = function(v)
            if v and IsPlayerKiller() then
                pcall(function() Toggles.HDT_Enable:SetValue(false) end)
                return
            end
            HDT.enabled = v
            if not v then stopHDT() end
        end,
    })
    left:AddSlider("HDT_DurS", {
        Text = "Drag Duration", Default = 0.8, Min = 0.1, Max = 2, Rounding = 2,
        Callback = function(v) HDT.duration = v end,
    })
    left:AddSlider("HDT_DelayS", {
        Text = "Start Delay", Default = 0, Min = 0, Max = 1, Rounding = 2,
        Callback = function(v) HDT.delay = v end,
    })
    left:AddSlider("HDT_SpeedS", {
        Text = "Pull Speed", Default = 12, Min = 4, Max = 40, Rounding = 0,
        Callback = function(v) HDT.speed = v end,
    })
    left:AddButton({
        Text = "Test HDT",
        Func = function() HDT_Trigger(GetNearestKillerModel(math.huge)) end,
    })
    left:AddLabel({
        Text = "Only fires when YOUR Block animation plays (not on detect alone).",
        DoesWrap = true,
