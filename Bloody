local ConeConfig = {
    NormalAngle    = 35,
    MaxAngle       = 100,
    ExpansionSpeed = 180,
    RecoverySpeed  = 90,
    Range          = 18,
    Segments       = 36,
    Color          = Color3.fromRGB(255, 55, 55),
    ColorHit       = Color3.fromRGB(80, 255, 80),
    Transparency   = 0.65,
    Thickness      = 0.12,
    YTolerance     = 8,
    WindowDuration = 0.5,
    ShowBox        = true,
}

local ConeState = {}
local blockPerKiller = {}
local activeBlocks = {}

local function hasHelplessEffect()
    if LP:GetAttribute("Helpless") then return true end
