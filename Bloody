local settings = {distance=100, smoothness=20, duration=50, targetPath="auto", globalSound=false, aimPrediction=4}
local triggerConnections = {}
local modules = {}

local function registerTriggerModule(name,enableFunc,disableFunc) modules[name]={enabled=false, enable=enableFunc, disable=disableFunc} end

local function toggleModule(name,state)
    local mod=modules[name]; if not mod then return end
    if state and not mod.enabled then if mod.enable then pcall(mod.enable) end mod.enabled=true
    elseif not state and mod.enabled then if mod.disable then pcall(mod.disable) end mod.enabled=false end
end

local function getNearestTarget()
    local p=game.Players.LocalPlayer
    if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myHRP=p.Character.HumanoidRootPart
    local nearest,nd=nil,math.huge
    local tc=nil
    local path=settings.targetPath
    if path=="auto" then
        local cands={workspace:FindFirstChild("Players"),workspace:FindFirstChild("Characters"),workspace:FindFirstChild("Living")}
        for _,c in ipairs(cands) do
            if c and (c:IsA("Folder") or c:IsA("Model")) then
                local hp=false
                for _,child in ipairs(c:GetChildren()) do if child:IsA("Model") and child:FindFirstChild("HumanoidRootPart") then hp=true break end end
                if hp then tc=c break end
            end
        end
        if not tc then tc=workspace end
    else
        local parts={} for pp in string.gmatch(path,"[^%.]+") do table.insert(parts,pp) end
        local cur=_G for _,pp in ipairs(parts) do cur=cur[pp]; if not cur then break end end
        tc=cur or workspace
    end
    local function pm(model) if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then if model==p.Character then return end local hrp=model.HumanoidRootPart local d=(hrp.Position-myHRP.Position).Magnitude if d<nd and d<=settings.distance then nd=d nearest=model end end end
    if tc==workspace then for _,c in ipairs(workspace:GetChildren()) do pm(c) end
    else for _,c in ipairs(tc:GetChildren()) do pm(c) end end
    return nearest
end

local function SmoothCameraLookAt(camCF, targetPos, progress)
    local tl=(targetPos-camCF.Position).Unit
    local cl=camCF.LookVector
    local nl=cl:Lerp(tl,progress)
    return CFrame.lookAt(camCF.Position,camCF.Position+nl*100)
end

local activeAimConn
local function executeAim()
    if activeAimConn then activeAimConn:Disconnect(); activeAimConn=nil end
    local t=getNearestTarget(); if not t or not t:FindFirstChild("HumanoidRootPart") then return end
    local tf=settings.duration local sp=settings.smoothness/100 local cf=0
    local conn; conn=RunService.RenderStepped:Connect(function()
        cf=cf+1 local progress=math.clamp(cf/tf,0,1) progress=progress^(1-sp)
        if cf<=tf then
            local camCF=workspace.CurrentCamera.CFrame
            workspace.CurrentCamera.CFrame=SmoothCameraLookAt(camCF,t.HumanoidRootPart.Position,progress)
        else conn:Disconnect(); if activeAimConn==conn then activeAimConn=nil end end
    end)
    activeAimConn=conn
end

