-- SILENT AIM (Guesting Hub — Crystal + Dusekkar only)
--══════════════════════════════════════════════════════════════
local SA = {
    Crystal = false, Dusekkar = false,
    CrystalPred = 2.5, DusekkarPred = 0.5,
    crystalHook = nil, dusekkarHook = nil,
}

local function getNearestKillerRoot()
    RefreshFolders()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot or not KillersFolder then return nil, nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(KillersFolder:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart")
        local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - myRoot.Position).Magnitude
            if d < bestD then bestD = d; best = m end
        end
    end
    return best, myRoot
end

local function setCrystalSA(on)
    SA.Crystal = on
    if on then
        if SA.crystalHook then Notify("Crystal SA already hooked"); return end
        local ok, rf = pcall(function()
            return ReplicatedStorage.Modules.Network.Network.RemoteFunction
        end)
        if not ok or not rf then Notify("RemoteFunction missing"); return end
        if typeof(getcallbackvalue) ~= "function" or typeof(hookfunction) ~= "function" then
            Notify("Need hookfunction + getcallbackvalue"); return
        end
        local mobileAngle = -0.32175
        SA.crystalHook = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] ~= "GetCameraCF" or not SA.Crystal then
                return SA.crystalHook(table.unpack(args, 1, args.n))
            end
            local killer, myRoot = getNearestKillerRoot()
            if killer and myRoot then
                local hum = killer:FindFirstChildOfClass("Humanoid")
                local pos = killer.HumanoidRootPart.Position
                if hum and hum.MoveDirection.Magnitude > 0.15 then
                    pos = pos + hum.MoveDirection * SA.CrystalPred
                end
                local cf = CFrame.lookAt(Vector3.zero, (pos - myRoot.Position + Vector3.new(0, 1.5, 0)).Unit)
                if LocalPlayer:GetAttribute("Device") == "Mobile" or UserInputService.TouchEnabled then
                    cf = cf * CFrame.Angles(mobileAngle, 0, 0)
                end
                return CFrame.new(Camera.CFrame.Position) * cf.Rotation
            end
            return SA.crystalHook(table.unpack(args, 1, args.n))
        end)
        Notify("Crystal Pinch Silent Aim ON")
    else
        Notify("Crystal Pinch Silent Aim OFF")
    end
end

local function setDusekkarSA(on)
    SA.Dusekkar = on
    if on then
        if SA.dusekkarHook then Notify("Dusekkar SA already hooked"); return end
        local ok, rf = pcall(function()
            return ReplicatedStorage.Modules.Network.Network.RemoteFunction
        end)
        if not ok or not rf then Notify("RemoteFunction missing"); return end
        if typeof(getcallbackvalue) ~= "function" or typeof(hookfunction) ~= "function" then
            Notify("Need hookfunction + getcallbackvalue"); return
        end
        SA.dusekkarHook = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] == "GetMousePosition" and SA.Dusekkar then
                local killer = select(1, getNearestKillerRoot())
                if killer then
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    local pos = killer.HumanoidRootPart.Position
                    if hum and hum.MoveDirection.Magnitude > 0.05 then
                        pos = pos + hum.MoveDirection * SA.DusekkarPred
                    end
                    return pos
                end
            end
            return SA.dusekkarHook(table.unpack(args, 1, args.n))
        end)
        Notify("Dusekkar Silent Aim ON")
    else
        Notify("Dusekkar Silent Aim OFF")
    end
end

