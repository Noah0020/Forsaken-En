                    part2.CFrame = CFrame.new((kr.CFrame * CFrame.new(0, 0, -3)).Position) * rotation
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
                RunService.PreRender:Wait()
            end
            if part2 and part2.Parent then part2:Destroy() end
            if character and character.Parent then character.PrimaryPart = primaryPart end
        end)
