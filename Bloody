safe("Hitbox Expander", function()
    local HE={enabled=false,range=60}
    local HINTS={"Slash","Stab","Punch","Tag","M1","Swing","Attack","Carving","Eviscerate"}
    local function isAttacking(hum)
        if not hum then return false end
        local animator=hum:FindFirstChildOfClass("Animator"); if not animator then return false end
        for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying and track.Animation and track.Length>0 then
                if (track.TimePosition/track.Length)<0.75 then
                    local name=tostring(track.Animation.Name or "")
                    for _,h in ipairs(HINTS) do
                        if name:lower():find(h:lower(),1,true) then return true end
                    end
                    if IsPlayerKiller() then return true end
                end
            end
        end
        return false
    end
    local function nearest(myHRP,maxDist)
        local best,bd=nil,maxDist
        local function scan(list)
            for _,obj in ipairs(list) do
                if obj:IsA("Model") and obj~=LP.Character then
                    local r=obj:FindFirstChild("HumanoidRootPart")
                    local h=obj:FindFirstChildOfClass("Humanoid")
                    if r and h and h.Health>0 then
                        local d=(r.Position-myHRP.Position).Magnitude
                        if d<bd then bd=d; best=obj end
                    end
                end
            end
        end
        local pf=Workspace:FindFirstChild("Players")
        if pf then
            if IsPlayerKiller() then
                local sf=pf:FindFirstChild("Survivors"); if sf then scan(sf:GetChildren()) end
            else
                local kf=pf:FindFirstChild("Killers"); if kf then scan(kf:GetChildren()) end
            end
        end
        return best
    end
    task.spawn(function()
        local rng=Random.new()
        while not _ShuttingDown do
            RunService.RenderStepped:Wait()
            if not HE.enabled then task.wait(0.1)
            else
                local char=LP.Character
                local hrp=char and char:FindFirstChild("HumanoidRootPart")
                local hum=char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum or not isAttacking(hum) then task.wait(0.05)
                else
                    local target=nearest(hrp,HE.range)
                    if target then
                        local thrp=target:FindFirstChild("HumanoidRootPart")
                        if thrp then
                            local ping=0.08
                            pcall(function() ping=tonumber(Stats.PerformanceStats.Ping:GetValue())/1000 end)
                            if ping<0.03 then ping=0.05 end
                            local offset=Vector3.new(rng:NextNumber(-1.5,1.5),0,rng:NextNumber(-1.5,1.5))
                            local predicted=thrp.Position+offset+(thrp.AssemblyLinearVelocity*(ping*1.25))
                            local needed=(predicted-hrp.Position)/math.max(ping*2,0.05)
                            local old=hrp.AssemblyLinearVelocity
                            hrp.AssemblyLinearVelocity=needed
                            RunService.RenderStepped:Wait()
                            if hrp.Parent then hrp.AssemblyLinearVelocity=old end
                        end
                    end
                end
            end
        end
    end)
    local left=Tabs.Killer:AddLeftGroupbox("Hitbox Expander","expand")
    left:AddToggle("HitboxExp_T",{Text="Enable Hitbox Expander",Default=false,Callback=function(v)
        HE.enabled=v
        if v then Library:Notify({Title="Perfect",Description="Rage — very blatant",Time=4}) end
    end})
    left:AddSlider("HitboxExpRange_S",{Text="Range",Default=60,Min=30,Max=200,Rounding=0,Callback=function(v) HE.range=v end})
end)

