local function abUpdateVision()
    if not AB.showVisionCone then
        if AB.centerPart then abCleanupVision() end; return
    end
    if AB.centerPart and not AB.centerPart.Parent then abCleanupVision() end
    local root = getHRP(); if not root then return end
    local kf = GetKillersFolder(); if not kf then return end
    local origin = nil
    for _, k in ipairs(kf:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        if hrp then origin = hrp; break end
    end
    if not origin then return end
    local range, angle = AB.visionRange, AB.visionAngle
    local fwd = origin.CFrame.LookVector
    local half = math.rad(angle/2)
    local right = Vector3.new(-fwd.Z,0,fwd.X).Unit
    local lDir = (fwd*math.cos(half) + right*math.sin(half)).Unit
    local rDir = (fwd*math.cos(half) - right*math.sin(half)).Unit
    local cPos = origin.Position + fwd*range
    local lPos = origin.Position + lDir*range
    local rPos = origin.Position + rDir*range
    if not AB.centerPart or not AB.centerPart.Parent then AB.centerPart = abCreateBall() end
    if not AB.leftPart or not AB.leftPart.Parent then AB.leftPart = abCreateBall() end
    if not AB.rightPart or not AB.rightPart.Parent then AB.rightPart = abCreateBall() end
    if not AB.leftToKillerPart or not AB.leftToKillerPart.Parent then AB.leftToKillerPart = abCreateConn() end
    if not AB.rightToKillerPart or not AB.rightToKillerPart.Parent then AB.rightToKillerPart = abCreateConn() end
    if not AB.leftToCenterPart or not AB.leftToCenterPart.Parent then AB.leftToCenterPart = abCreateConn() end
    if not AB.centerToRightPart or not AB.centerToRightPart.Parent then AB.centerToRightPart = abCreateConn() end
    AB.centerPart.Position = cPos
    AB.leftPart.Position = lPos
    AB.rightPart.Position = rPos
    local function upd(p, a, b)
        if not p or not p.Parent then return end
        local mid = (a+b)/2; local d = (b-a).Magnitude
        p.Size = Vector3.new(0.1,0.1,d); p.CFrame = CFrame.new(mid, b)
    end
    upd(AB.leftToKillerPart, origin.Position, lPos)
    upd(AB.rightToKillerPart, origin.Position, rPos)
    upd(AB.leftToCenterPart, lPos, cPos)
    upd(AB.centerToRightPart, cPos, rPos)
end
local function abStart()
    if AB.running then return end
    AB.running = true; AB.generation += 1; AB.attrStates = {}
    table.insert(AB.connections, RunService.Heartbeat:Connect(function()
        abAttributeHeartbeat(); pcall(abUpdateVision)
    end))
    if AB.soundBlockOn then abSetupSoundHooks() end
    if AB.animBlockOn then abSetupAnimBlock() end
    if AB.hitboxBlockOn then abSetupHitboxBlock() end
    table.insert(AB.connections, LP.CharacterAdded:Connect(function()
        task.wait(1)
        if AB.running and AB.soundBlockOn then abSetupSoundHooks() end
    end))
end
local function abStop()
    AB.running = false; AB.generation += 1; AB.attrStates = {}
    for _, c in ipairs(AB.connections) do pcall(function() c:Disconnect() end) end
    AB.connections = {}
    if AB.animConn then AB.animConn:Disconnect(); AB.animConn = nil end
    if AB.hitboxHeartbeat then AB.hitboxHeartbeat:Disconnect(); AB.hitboxHeartbeat = nil end
    for s in pairs(AB.soundHooks) do
        pcall(function()
            if AB.soundHooks[s] then
                for _, c in ipairs(AB.soundHooks[s]) do
                    if c and c.Disconnect then pcall(function() c:Disconnect() end) end
                end
            end
        end)
        AB.soundHooks[s] = nil; AB.soundBlockedUntil[s] = nil
    end
    abCleanupVision()
end

