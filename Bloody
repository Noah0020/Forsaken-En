TabMist:Toggle({ Title="Flight", Value=false, Callback=function(v)
    flyOn=v
    local char=LP.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    local head=char and char:FindFirstChild("Head")
    if v and hum and head then
        hum.PlatformStand=true; head.Anchored=true
        if flyConn then flyConn:Disconnect() end
        flyConn=RunService.Heartbeat:Connect(function(dt)
            if not flyOn or not char or not char.Parent then return end
            local md=hum.MoveDirection*(flySpeed*dt)
            local cam=Workspace.CurrentCamera
            local headCF=head.CFrame; local camCF=cam.CFrame
            local off=headCF:ToObjectSpace(camCF).Position
            camCF=camCF*CFrame.new(-off.X,-off.Y,-off.Z+1)
            local cp,hp=camCF.Position,headCF.Position
            local ov=CFrame.new(cp,Vector3.new(hp.X,cp.Y,hp.Z)):VectorToObjectSpace(md)
            head.CFrame=CFrame.new(hp)*(camCF-cp)*CFrame.new(ov)
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn=nil end
        if hum then hum.PlatformStand=false end
        if head then head.Anchored=false end
    end
end })
TabMist:Slider({ Title="Flight Speed", Step=1, Value={Min=1,Max=200,Default=50}, Callback=function(v) flySpeed=v end })

