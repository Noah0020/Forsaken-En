-- WIRED TO BOX - creates spatial overlap box
local function createSpatialOverlapBox(killerChar, size, onHit)
    if IsPlayerKiller() then return end
    if not killerChar or killerChar == LP.Character then return end
    local root = killerChar:FindFirstChild("HumanoidRootPart") or killerChar:FindFirstChild("RootPart")
    if not root then return end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killerChar }
    task.spawn(function()
        local elapsed = 0
        local duration = _G.HitboxDuration or AB.duration
        while killerChar.Parent and root.Parent and elapsed < duration do
            if IsPlayerKiller() then return end
            if not AB.enabled and not _G.AutoBlockEnabled then return end
            local Part = Instance.new("Part")
            Part.Name = "Vortex_BlockBox"
            Part.Transparency = _G.HitboxTransparency or AB.transparency
            Part.CanCollide = false; Part.CanTouch = false; Part.CanQuery = false
            Part.CastShadow = false; Part.Anchored = true
            Part.Size = size or Vector3.new(_G.HitboxWidth, _G.HitboxHeight, _G.HitboxLength)
            Part.Color = _G.HitboxColor or AB.color
            Part.Material = Enum.Material.ForceField
            Part.CFrame = root.CFrame * CFrame.new(0, 0, _G.HitboxOffset or AB.offset)
            Part.Parent = Workspace
            if (_G.ShowOutline and _G.ShowHitboxVisual) or (AB.showOutline and AB.showVisual) then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = Part; sb.Color3 = _G.HitboxColor or AB.color
                sb.LineThickness = _G.OutlineThickness or AB.outlineThickness
                sb.Transparency = 0.1; sb.Visible = true
                sb.Parent = Part
            end
            Debris:AddItem(Part, 0.06)
            for _, v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                local hum = v.Parent and v.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    if (_G.BlockDelay or AB.delay) > 0 then task.wait(_G.BlockDelay or AB.delay) end
                    if onHit then onHit() end
                    return
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

local lastTrigger = 0
local function triggerBoxCheck(killer)
    if IsPlayerKiller() then return end
    if not killer or killer == LP.Character or not killer.Parent then return end
    local now = tick()
    if now - lastTrigger < 0.05 then return end
    lastTrigger = now
    createSpatialOverlapBox(killer, Vector3.new(_G.HitboxWidth, _G.HitboxHeight, _G.HitboxLength), function()
        FireBlock(killer:FindFirstChild("HumanoidRootPart"))
    end)
end

local monitoredKillers = {}
local function monitorKiller(killer)
    if not killer or monitoredKillers[killer] or not killer:IsA("Model") then return end
    if killer == LP.Character then return end
    monitoredKillers[killer] = true
    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = killer:GetAttribute("AbilitiesUsed") or 0
    local function onNewAbility()
        if not _G.AutoBlockEnabled and not AB.enabled then return end
        if IsPlayerKiller() then return end
        local name = getAbilityName(killer)
        if name == nil or shouldBlockAbility(name) then triggerBoxCheck(killer) end
    end
    local conn1 = killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local curUsed = killer:GetAttribute("AbilitiesUsed") or 0
        if curUsed > lastUsed then lastUsed = curUsed; return end
        onNewAbility()
    end)
    TrackConnection(conn1)
    for _, attr in ipairs({"AbilityName", "LastAbility", "CurrentAbility", "LastAbilityName"}) do
        pcall(function()
            local c = killer:GetAttributeChangedSignal(attr):Connect(onNewAbility)
            TrackConnection(c)
        end)
    end
end

local remoteHooked = false
local function hookAbilityRemote()
    if remoteHooked then return end
    remoteHooked = true
    local remote = getNetworkEvent()
    if not remote then return end
    local function argMatches(arg)
        if type(arg) == "string" then return shouldBlockAbility(arg) end
        if typeof(arg) == "buffer" then
            local ok, str = pcall(buffer.tostring, arg)
            if ok and str then return shouldBlockAbility(str) end
        end
        return false
    end
    local conn = remote.OnClientEvent:Connect(function(...)
        if not _G.AutoBlockEnabled and not AB.enabled then return end
        if IsPlayerKiller() then return end
        for _, arg in ipairs({...}) do
            if argMatches(arg) then
                local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
                if kf then
                    for _, k in ipairs(kf:GetChildren()) do
                        if k:IsA("Model") and k ~= LP.Character then triggerBoxCheck(k); break end
                    end
                end
                break
            end
        end
    end)
    TrackConnection(conn)
end

local function EnableAutoBlock()
    if IsPlayerKiller() then return end
    hookAbilityRemote()
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if kf then
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") and k ~= LP.Character then monitorKiller(k) end
        end
    end
end

