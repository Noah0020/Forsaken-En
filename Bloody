--═══════════════════════════════════════════════════════════════
-- PUNCH AIM
--═══════════════════════════════════════════════════════════════
local PA = { running=false, looking=false, lookStarted=nil, loop=nil }

local function PA_AimOnce(humanoid, root, hrp)
    if not humanoid or not humanoid.Parent or not root or not root.Parent or not hrp or not hrp.Parent then return end
    local oldAuto = humanoid.AutoRotate
    pcall(function() humanoid.AutoRotate = false end)
    local endT = tick() + 0.55
    while tick() < endT and PA.running do
        if not humanoid.Parent or not root.Parent or not hrp.Parent then break end
        local km = hrp.Parent
        local kh = km and km:FindFirstChildOfClass("Humanoid")
        local target = hrp.Position
        if kh then
            local md = kh.MoveDirection
            if md and md.Magnitude > 0.01 then
                target = target + md * Settings.PA_Prediction
            end
            local vel = hrp.AssemblyLinearVelocity
            if vel.Magnitude > 1 then
                target = target + Vector3.new(vel.X, 0, vel.Z) * 0.12
            end
        end
        pcall(function()
            root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.X, root.Position.Y, target.Z))
        end)
        RunService.Heartbeat:Wait()
    end
    if humanoid.Parent then pcall(function() humanoid.AutoRotate = oldAuto end) end
end

local function PA_Loop()
    while PA.running do
        RunService.Heartbeat:Wait()
        if PA.looking and PA.lookStarted and (tick() - PA.lookStarted) > 2.2 then
            PA.looking = false
            PA.lookStarted = nil
        end
        if not PA.looking then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root and root.Parent and hum.Health > 0 then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    local aid = track.Animation and track.Animation.AnimationId
                    if aid and PunchAnims[aid] then
                        local kf = GetKillersFolder()
                        if kf then
                            local closest, cd = nil, math.huge
                            for _, k in ipairs(kf:GetChildren()) do
                                local kr = k:FindFirstChild("HumanoidRootPart")
                                if kr and kr.Parent then
                                    local d = (root.Position - kr.Position).Magnitude
                                    if d < cd then cd = d; closest = kr end
                                end
                            end
                            if closest then
                                PA.looking = true
                                PA.lookStarted = tick()
                                task.spawn(function()
                                    pcall(PA_AimOnce, hum, root, closest)
                                    PA.looking = false
                                    PA.lookStarted = nil
                                end)
                            end
                        end
                        break
                    end
                end
            end
        end
    end
end

local function PA_Enable()
    if PA.running then return end
    PA.running = true
    PA.loop = task.spawn(PA_Loop)
end

local function PA_Disable()
    PA.running = false
    if PA.loop then pcall(task.cancel, PA.loop); PA.loop=nil end
    PA.looking = false
    PA.lookStarted = nil
end

--═══════════════════════════════════════════════════════════════
-- HDT
--═══════════════════════════════════════════════════════════════
local HDT = {
    running = false, debounce = false, animConn = nil, watcher = nil,
    charConn = nil, bind = "FMO_HDT_", dashId = 0,
    Speed = Settings.HDT_Speed, Duration = Settings.HDT_Duration, Delay = Settings.HDT_Delay,
}

local function HDT_Nearest()
    local kf = GetKillersFolder()
    if not kf or not LocalRoot then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        if kr then
            local d = (kr.Position - LocalRoot.Position).Magnitude
            if d < bd then best, bd = k, d end
        end
    end
    return best
end

local function HDT_Dash(killer)
    if HDT.debounce then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if not killer or not killer.Parent then return end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.4 then return end

    HDT.debounce = true
    HDT.dashId = HDT.dashId + 1
    local thisBind = HDT.bind .. tostring(HDT.dashId)
    local startT = tick()
    local active = true

    local bv = Instance.new("BodyVelocity")
    bv.Name = "FMO_HDT_BV"
    bv.MaxForce = Vector3.new(1e6, 0, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local oldWS = hum.WalkSpeed
    local oldAR = hum.AutoRotate
    hum.WalkSpeed = HDT.Speed
    hum.AutoRotate = false

    local function stop()
        if not active then return end
        active = false
        HDT.debounce = false
        pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        if bv and bv.Parent then bv:Destroy() end
        if hum and hum.Parent then
            pcall(function() hum.WalkSpeed = oldWS end)
            pcall(function() hum.AutoRotate = oldAR end)
        end
    end

    pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
    RunService:BindToRenderStep(thisBind, Enum.RenderPriority.Camera.Value, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health <= 0 then stop(); return end
        if not kr.Parent then stop(); return end
        if tick() - startT > HDT.Duration then stop(); return end

        local toK = kr.Position - hrp.Position
        local flat = Vector3.new(toK.X, 0, toK.Z)
        if flat.Magnitude < 1 then stop(); return end

        if bv and bv.Parent then
            bv.Velocity = flat.Unit * HDT.Speed
        end
        if hum.WalkSpeed ~= HDT.Speed then hum.WalkSpeed = HDT.Speed end
        if hum.AutoRotate then hum.AutoRotate = false end
        pcall(function()
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(kr.Position.X, hrp.Position.Y, kr.Position.Z))
        end)
    end)

    task.delay(HDT.Duration + 0.25, stop)
end

local function HDT_OnAnim(track)
    if not HDT.running or HDT.debounce then return end
    local aid = track.Animation and track.Animation.AnimationId
    if not aid or not HDT_Anims[aid] then return end
    local k = HDT_Nearest()
    if not k then return end
    task.delay(HDT.Delay, function()
        if HDT.running and not HDT.debounce then HDT_Dash(k) end
    end)
end

local function HDT_Attach()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator")
    if not anim then return end
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end) end
    HDT.animConn = anim.AnimationPlayed:Connect(HDT_OnAnim)
end

local function HDT_Enable()
    if HDT.running then return end
    HDT.running = true
    HDT_Attach()
    HDT.charConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if HDT.running then HDT_Attach() end
    end)
    HDT.watcher = task.spawn(function()
        while HDT.running do
            if not HDT.animConn then HDT_Attach() end
            task.wait(1)
        end
    end)
end

local function HDT_Disable()
    HDT.running = false
    HDT.debounce = false
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end); HDT.animConn=nil end
    if HDT.charConn then pcall(function() HDT.charConn:Disconnect() end); HDT.charConn=nil end
    if HDT.watcher then pcall(task.cancel, HDT.watcher); HDT.watcher=nil end
    for i = 1, HDT.dashId do
        pcall(function() RunService:UnbindFromRenderStep(HDT.bind .. tostring(i)) end)
    end
end

local function HDT_SetSpeed(v) HDT.Speed = math.clamp(tonumber(v) or 42, 5, 500); Settings.HDT_Speed = HDT.Speed end
local function HDT_SetDuration(v) HDT.Duration = math.clamp(tonumber(v) or 0.65, 0.05, 3); Settings.HDT_Duration = HDT.Duration end
local function HDT_SetDelay(v) HDT.Delay = math.clamp(tonumber(v) or 0.04, 0, 2); Settings.HDT_Delay = HDT.Delay end
local function HDT_ForceNow() local k = HDT_Nearest(); if k then HDT_Dash(k) end end

--═══════════════════════════════════════════════════════════════
-- SURVIVOR AIM (FIXED PREDICTION — aims in front of killer)
--═══════════════════════════════════════════════════════════════
local Aim = { active=false, startT=0, lastTrig=0, hookDone=false, endT=0 }

local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, s = pcall(function()
            local len = buffer.readu8(arg, 1)
            if len < 1 or len > 64 then return nil end
            local out = ""
            for i=5, 5+len-1 do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out = out .. string.char(b) end
            end
            return out
        end)
        return ok and s or nil
    end
    if t == "table" then return ExtractAbility(arg[1]) end
    return nil
end

local function IsOffensiveAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower()
    if Settings.AIM_OnSlash and l == "slash" then return true end
    if Settings.AIM_OnBlock and (l == "block" or l == "parry" or l == "punch") then return true end
    if Settings.AIM_OnDagger and l:find("dagger", 1, true) then return true end
    if Settings.AIM_OnAxe and (l == "axe" or l == "hatchet") then return true end
    if Settings.AIM_OnShoot then
        if l == "shoot" then return true end
        if l:find("oneshot", 1, true) or l:find("flintlock",1,true) then return true end
        if l:find("sixshot",1,true) or l:find("sixshooter",1,true) then return true end
        if l:find("gun",1,true) or l:find("shot",1,true) then return true end
    end
    return false
end

local function GetLockTime(name)
    local base = Settings.AIM_LockTime
    if type(name) ~= "string" then return base end
    local l = name:lower()
    if l == "shoot" then return math.max(base, 1.2) end
    if l == "slash" then return math.max(base, 0.7) end
    if l:find("dagger", 1, true) then return math.max(base, 0.9) end
    if l == "axe" or l == "hatchet" then return math.max(base, 0.75) end
    return base
end

-- FIXED: properly lead the killer using velocity + move direction + tunable multiplier
local function Aim_GetTarget()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local kf = GetKillersFolder()
    if not kf then return nil, nil end

    local killer, kr, dist = nil, nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then
                dist = d
                killer = k
                kr = krp
            end
        end
    end

    if not killer or dist > Settings.AIM_Range or dist < Settings.AIM_MinDist then
        return nil, nil
    end

    local vel = kr.AssemblyLinearVelocity or Vector3.zero
    -- clamp extreme velocity spikes
    if vel.Magnitude > 55 then
        vel = vel.Unit * 55
    end

    local predN = math.clamp(Settings.AIM_Prediction, 1, 12)
    local lead = Settings.AIM_LeadMultiplier or 1.3

    -- base prediction from linear velocity
    local predicted = kr.Position + vel * (predN * 0.055 * lead)

    -- extra lead from MoveDirection if available
    local kh = killer:FindFirstChildOfClass("Humanoid")
    if kh and kh.MoveDirection and kh.MoveDirection.Magnitude > 0.08 then
        predicted = predicted + kh.MoveDirection * (predN * 0.35 * lead)
    end

    -- slight forward bias so we aim *in front*
    local look = kr.CFrame.LookVector
    predicted = predicted + Vector3.new(look.X, 0, look.Z).Unit * (1.1 + predN * 0.08)

    return hrp, predicted
end

local function Aim_InstantRotate(abilityName)
    local hrp, target = Aim_GetTarget()
    if not hrp or not target then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = false end
    pcall(function()
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z))
    end)
    local now = tick()
    Aim.active = true
    Aim.startT = now
    Aim.endT = now + GetLockTime(abilityName)
    return true
end

local function Aim_SetupHook()
    if Aim.hookDone or not NetworkEvent or not hookmetamethod then return false end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if Settings.AIM_Enabled and getnamecallmethod() == "FireServer" and self == NetworkEvent then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsOffensiveAbility(n) then
                        Aim_InstantRotate(n)
                    end
                end
            end
            return old(self, ...)
        end)
    end)
    if ok then Aim.hookDone = true end
    return ok
end

