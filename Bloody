local function HardLockFacing(duration, prediction, wantCamera)
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local savedWS = hum.WalkSpeed
    hum.WalkSpeed = 0; hum.AutoRotate = false
    pcall(function() hum:Move(Vector3.zero, false) end)
    local startT = tick(); local conn; local released = false
    local function release()
        if released then return end; released = true
        if conn then pcall(function() conn:Disconnect() end); conn = nil end
        if DebugMarker and DebugMarker.Parent then pcall(function() DebugMarker:Destroy() end) end
        DebugMarker = nil
        if not (hum and hum.Parent) then return end
        pcall(function()
            hum.WalkSpeed = savedWS; hum.AutoRotate = true; hum:Move(Vector3.zero, false)
        end)
        task.spawn(function()
            task.wait(0.05)
            if not (hum and hum.Parent) then return end
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end)
            task.wait(0.05)
            if not (hum and hum.Parent) then return end
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
        end)
    end
    conn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent or not hum.Parent then release(); return end
        if tick() - startT > (duration or 0.5) then release(); return end
        local targetHrp = GetNearestKillerHrp()
        if not targetHrp or not targetHrp.Parent then return end
        local aimPos = PredictPosition(targetHrp, prediction) or targetHrp.Position
        ShowDebugPrediction(targetHrp)
        local myPos = hrp.Position
        hrp.CFrame = CFrame.lookAt(myPos, Vector3.new(aimPos.X, myPos.Y, aimPos.Z))
    end)
    if wantCamera then
        local cam = Workspace.CurrentCamera
        local camStart = tick(); local camConn
        camConn = RunService.RenderStepped:Connect(function()
            if not cam or tick() - camStart > (duration or 0.5) then
                pcall(function() camConn:Disconnect() end); return
            end
            local tgt = GetNearestKillerHrp()
            if tgt and tgt.Parent then
                local aimPos = PredictPosition(tgt, prediction) or tgt.Position
                pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPos) end)
            end
        end)
    end
end

