-- HDT (from original, no self-cooldown — driven by block)
local HDT = {debounce=false, bind="Ck_HDT_", dashId=0}
local function hdtNearest()
    if not KillersFolder or not LocalRoot then return nil end
    local best, bd = nil, math.huge
    for _,k in ipairs(KillersFolder:GetChildren()) do
        local kr=k:FindFirstChild("HumanoidRootPart")
        local kh=k:FindFirstChildOfClass("Humanoid")
        if kr and (not kh or kh.Health>0) then
            local d=(kr.Position-LocalRoot.Position).Magnitude
            if d<bd then best, bd = k, d end
        end
    end
    return best
end
local function hdtDash(killer)
    if HDT.debounce then return end
    local char=LocalPlayer.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health<=0 then return end
    if not killer or not killer.Parent then return end
    local kr=killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position-hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce=true; lastHdtUse=os.clock(); HDT.dashId+=1
    local thisBind=HDT.bind..tostring(HDT.dashId)
    local startT=os.clock(); local active=true
    local oldWS, oldAR = hum.WalkSpeed, hum.AutoRotate
    local bv=Instance.new("BodyVelocity")
    bv.Name="Ck_HDT_BV"; bv.MaxForce=Vector3.new(1e6,0,1e6); bv.Velocity=Vector3.zero; bv.Parent=hrp
    hum.WalkSpeed=C.hdtSpeed; hum.AutoRotate=false
    local function stop()
        if not active then return end
        active=false; HDT.debounce=false
        pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        if bv and bv.Parent then bv:Destroy() end
        if hum and hum.Parent then
            pcall(function() hum.WalkSpeed=oldWS; hum.AutoRotate=oldAR end)
        end
    end
    RunService:BindToRenderStep(thisBind, Enum.RenderPriority.Camera.Value, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health<=0 then stop(); return end
        if not kr.Parent or os.clock()-startT > C.hdtDuration then stop(); return end
        local toK = kr.Position - hrp.Position
        local flat = Vector3.new(toK.X, 0, toK.Z)
        if flat.Magnitude < 1 then stop(); return end
        if bv and bv.Parent then bv.Velocity=flat.Unit*C.hdtSpeed end
        if hum.WalkSpeed~=C.hdtSpeed then hum.WalkSpeed=C.hdtSpeed end
        if hum.AutoRotate then hum.AutoRotate=false end
        local face=Vector3.new(kr.Position.X, hrp.Position.Y, kr.Position.Z)
        pcall(function() hrp.CFrame=CFrame.lookAt(hrp.Position, face) end)
    end)
    task.delay(C.hdtDuration+0.2, stop)
end

-- Fire block + HDT together
local function fireBlock(killer)
    if os.clock() - lastBlockTime < BLOCK_COOLDOWN then return end
    lastBlockTime = os.clock()
    if BlockRemote then
        pcall(function() BlockRemote:FireServer("UseActorAbility", {buffer.fromstring("\003\005\000\000\000Block")}) end)
    end
    local btn = MainUI and MainUI:FindFirstChild("AbilityContainer") and MainUI.AbilityContainer:FindFirstChild("Block")
    if btn and firesignal then
        pcall(function() firesignal(btn.MouseButton1Down); firesignal(btn.MouseButton1Click) end)
    end
    if C.hdtEnabled and killer then
        task.delay(C.hdtDelay, function()
            if C.hdtEnabled then hdtDash(killer) end
        end)
    end
end

-- AutoBlock watcher (attribute-based, per-killer state)
local killerState = {}
local function checkKiller(killer)
    if not C.autoBlockEnabled or not LocalCharacter then return end
    if os.clock() - lastBlockTime < BLOCK_COOLDOWN then return end
    local curLastUsed = killer:GetAttribute("AbilityLastUsed") or 0
    local curUsed = killer:GetAttribute("AbilitiesUsed") or 0
    local st = killerState[killer]
    if not st then
        killerState[killer] = {lastUsed=curLastUsed, used=curUsed, locked=false}
        return
    end
    local lastUsedInc = curLastUsed > st.lastUsed
    local usedInc = curUsed > st.used
    if usedInc then st.locked = true end
    if lastUsedInc then
        if st.locked then
            st.locked = false
        else
            local qh = killer:FindFirstChild("QueryHitbox")
            if qh then
                local size = Vector3.new(C.autoBlockWidth, C.autoBlockHeight, C.autoBlockLength)
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Include
                params.FilterDescendantsInstances = {LocalCharacter}
                local hits = workspace:GetPartBoundsInBox(qh.CFrame * CFrame.new(0,0,C.autoBlockOffset), size, params)
                if C.showBlockBox then
                    local box = Instance.new("Part")
                    box.Size=size; box.CFrame=qh.CFrame*CFrame.new(0,0,C.autoBlockOffset)
                    box.Transparency=C.autoBlockTransparency; box.Color=C.autoBlockColor
                    box.Anchored=true; box.CanCollide=false; box.CanQuery=false; box.CanTouch=false
                    box.Material=Enum.Material.ForceField; box.Parent=workspace
                    Debris:AddItem(box, 0.15)
                end
                if #hits > 0 then fireBlock(killer) end
            end
        end
    end
    st.lastUsed = curLastUsed
    st.used = curUsed
end
