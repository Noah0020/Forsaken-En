local ABTP={enabled=false,dagger=true,directBehind=false,pred=false,rangeMode="Around",backstabType="lerp",
    proximity=8,behindDist=1.7,lerpSpeed=0.37,delayStab=0.08,cooldown=5,predStr=0.6,predTime=0.12,duration=0.35,lastTrigger=0}
task.spawn(function()
    while getgenv().SimpleHubLoaded do
        task.wait(0.12)
        if not ABTP.enabled then continue end
        if not LocalChar or not string.find(LocalChar.Name or "","TwoTime") then continue end
        if not LocalRoot or not KillersFolder then continue end
        for _,killer in pairs(KillersFolder:GetChildren()) do
            local khrp=killer:FindFirstChild("HumanoidRootPart"); if not khrp then continue end
            local dist=(khrp.Position-LocalRoot.Position).Magnitude
            local should=false
            if ABTP.rangeMode=="Around" then should=dist<=ABTP.proximity
            else
                local rel=LocalRoot.Position-khrp.Position
                local fwdDot=rel:Dot(khrp.CFrame.LookVector)
                local angleDot=rel.Magnitude>0 and rel.Unit:Dot(khrp.CFrame.LookVector) or 0
                local passed=ABTP.directBehind and angleDot<=-0.85 or fwdDot<0.3
                should=passed and (-fwdDot)<=ABTP.proximity and dist<=ABTP.proximity
            end
            if should and os.clock()-ABTP.lastTrigger>=ABTP.cooldown then
                ABTP.lastTrigger=os.clock()
                task.spawn(function()
                    local targetPos=khrp.Position-khrp.CFrame.LookVector*ABTP.behindDist
                    if ABTP.pred then
                        local hum=killer:FindFirstChildOfClass("Humanoid")
                        if hum and hum.MoveDirection.Magnitude>0 then targetPos=targetPos+hum.MoveDirection*ABTP.predStr*10*ABTP.predTime end
                    end
                    local t0=os.clock(); local conn
                    conn=RunService.Heartbeat:Connect(function()
                        if os.clock()-t0>=ABTP.duration then conn:Disconnect(); return end
                        if not khrp.Parent or not LocalRoot then return end
                        if ABTP.backstabType=="teleport" then LocalRoot.CFrame=CFrame.new(targetPos,khrp.Position)
                        elseif ABTP.backstabType=="lerp" then LocalRoot.CFrame=LocalRoot.CFrame:Lerp(CFrame.new(targetPos,khrp.Position),ABTP.lerpSpeed)
                        else LocalRoot.CFrame=CFrame.new(LocalRoot.Position,LocalRoot.Position+khrp.CFrame.LookVector) end
                    end)
                    if ABTP.dagger then task.wait(ABTP.delayStab); FireAbility("Stab"); FireAbility("Backstab"); FireAbility("Dagger") end
                end)
                break
            end
        end
    end
end)

