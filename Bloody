espFolder.Parent = workspace

local function clearESP(pre)
    for _, o in ipairs(espFolder:GetChildren()) do
        if o.Name:sub(1, #pre) == pre then o:Destroy() end
    end
end

local function addHL(obj, id, col)
    if not obj or espFolder:FindFirstChild(id) then return end
    local h = Instance.new("Highlight")
    h.Name = id
    h.Adornee = obj
    h.FillColor = col
    h.OutlineColor = Color3.fromRGB(0, 0, 0)
    h.FillTransparency = ESP.FillT
    h.OutlineTransparency = 0.15
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = espFolder
end

local function addName(obj, id, text)
    if not ESP.Names then return end
    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart"))
    if not part then return end
    local old = part:FindFirstChild("__SH_BB")
    if old then old:Destroy() end
    local bb = Instance.new("BillboardGui")
    bb.Name = "__SH_BB"
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 120, 0, 16)
    bb.StudsOffset = Vector3.new(0, 2.8, 0)
    bb.MaxDistance = 1500
    bb.Parent = part
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.Font = Enum.Font.GothamBold
    tl.TextScaled = true
    tl.TextColor3 = Color3.new(1, 1, 1)
    tl.Text = text or obj.Name
    tl.Parent = bb
    local s = Instance.new("UIStroke")
    s.Thickness = 1
    s.Parent = tl
end

