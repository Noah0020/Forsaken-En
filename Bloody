local NS_KILLER_TIMING = {
    ["CoolKid"]={dura=0.05,life=0.05},["Slasher"]={dura=0.35,life=0.35},
    ["1x1x1x1"]={dura=0.45,life=0.45},["JohnDoe"]={dura=0.45,life=0.45},
