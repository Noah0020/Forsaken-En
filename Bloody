safe("ESP", function()
    local S = { Killer=false, Survivor=false, Generator=false, Medkit=false, Bloxy=false, MaxDist=150 }
    local HL, Folder = {}, nil
    local function ensure()
        if Folder and Folder.Parent then return Folder end
        Folder = Instance.new("Folder"); Folder.Name="Perfect_ESP"; Folder.Parent=CoreGui
        return Folder
    end
    local function clear(m) local h=HL[m]; if h then pcall(function() h:Destroy() end); HL[m]=nil end end
    local function apply(m, col)
        if not m or not m.Parent then return end
        local hl=HL[m]
        if hl and hl.Parent and hl.Adornee==m then hl.FillColor=col; hl.OutlineColor=col; return end
        if hl then pcall(function() hl:Destroy() end) end
        hl=Instance.new("Highlight"); hl.Adornee=m; hl.FillColor=col; hl.OutlineColor=col
        hl.FillTransparency=0.5; hl.OutlineTransparency=0; hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent=ensure(); HL[m]=hl
    end
    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.4)
            local any = S.Killer or S.Survivor or S.Generator or S.Medkit or S.Bloxy
            if not any then for m in pairs(HL) do clear(m) end
            else
                local seen, my = {}, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local pf = Workspace:FindFirstChild("Players")
                if my and pf then
                    if S.Killer then
                        local kf=pf:FindFirstChild("Killers")
                        if kf then for _,k in ipairs(kf:GetChildren()) do
                            local r=k:FindFirstChild("HumanoidRootPart")
                            if r and (r.Position-my.Position).Magnitude<=S.MaxDist then seen[k]=true; apply(k,Color3.fromRGB(255,60,60)) end
                        end end
                    end
                    if S.Survivor then
                        local sf=pf:FindFirstChild("Survivors")
                        if sf then for _,s in ipairs(sf:GetChildren()) do
                            if s~=LP.Character then
                                local r=s:FindFirstChild("HumanoidRootPart")
                                if r and (r.Position-my.Position).Magnitude<=S.MaxDist then seen[s]=true; apply(s,Color3.fromRGB(80,255,120)) end
                            end
                        end end
                    end
                end
                if my and (S.Generator or S.Medkit or S.Bloxy) then
                    for _,obj in ipairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") or obj:IsA("BasePart") then
                            local n,col=obj.Name,nil
                            if S.Generator and n=="Generator" then col=Color3.fromRGB(255,220,40)
                            elseif S.Medkit and n=="Medkit" then col=Color3.fromRGB(255,105,180)
                            elseif S.Bloxy and n=="BloxyCola" then col=Color3.fromRGB(80,180,255) end
