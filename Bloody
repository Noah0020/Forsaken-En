local function MonitorKillerSound(killer)
    if not killer then return end
    local function tryBlockFromSound(snd)
        if not AB.running then return end
        if not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
        if not snd or not snd:IsA("Sound") then return end
        local sid = snd.SoundId
        if sid == "" then return end
        local n = sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
        local isM1 = M1_Sounds[sid] or (n and (M1_Sounds["rbxassetid://"..n] or M1_Sounds[n]))
        if not isM1 then return end
        if not AB.LocalRoot then return end
        local kr = killer:FindFirstChild("HumanoidRootPart")
        if not kr or not kr.Parent then return end
        if not IsPlayerInFacingZone(killer) then return end
        local now = tick()
        if now - AB.blueDebounce < 0.15 then return end
        AB.blueDebounce = now
        FireAbilityByMode()
    end
    for _, d in ipairs(killer:GetDescendants()) do
        if d:IsA("Sound") then tryBlockFromSound(d) end
    end
    table.insert(AB.connections, killer.DescendantAdded:Connect(tryBlockFromSound))
end

local function AttrHeartbeat()
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not AB.KillersFolder or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    for _, k in ipairs(AB.KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local alu = k:GetAttribute("AbilityLastUsed") or 0
                local au = k:GetAttribute("AbilitiesUsed") or 0
                local st = AB.attrStates[k]
                if st then
                    local inc = alu > st.lastAbility
                    if au > st.lastUsed then st.isBait = true end
                    if inc then
                        if st.isBait then st.isBait = false
                        else
                            local shouldBlock = false
                            if IsPlayerInFacingZone(k) then shouldBlock = true end
                            if shouldBlock then
                                local now = tick()
                                if now - AB.attrDebounce >= 0.15 then
                                    AB.attrDebounce = now
                                    FireAbilityByMode()
                                end
                            end
                        end
                    end
                    st.lastAbility = alu; st.lastUsed = au
                else
                    AB.attrStates[k] = {lastAbility=alu, lastUsed=au, isBait=false}
                end
            end
        end
    end
end

local function ab_applyState(state)
    if not state then return end
    if state.mode == "default" then
        Settings.AutoBlock = state.value
        if state.value then Settings.AutoBlockCustom = false end
    else
        Settings.AutoBlockCustom = state.value
        if state.value then Settings.AutoBlock = false end
    end

    if Toggles.AutoBlock then
        _suppressToggleCallback = true
        pcall(function() Toggles.AutoBlock:SetValue(Settings.AutoBlock) end)
        _suppressToggleCallback = false
    end
    if Toggles.AutoBlockCustom then
        _suppressToggleCallback = true
        pcall(function() Toggles.AutoBlockCustom:SetValue(Settings.AutoBlockCustom) end)
        _suppressToggleCallback = false
    end

    -- Keep visuals in sync without changing their enabled states.
    UpdateCustomZoneVisibility()

    if Settings.AutoBlock or Settings.AutoBlockCustom then
        if not AB.running then pcall(StartAutoBlock) end
    else
        if AB.running then pcall(StopAutoBlock) end
    end
    if FourthBlock.applyTint then pcall(FourthBlock.applyTint) end
end

local function ab_scheduleApply()
    if abPendingTask then pcall(task.cancel, abPendingTask); abPendingTask = nil end
    abPendingTask = task.delay(abDebounce, function()
        abPendingTask = nil
        local t = abPendingState
        abPendingState = nil
        if t ~= nil then abLastToggle = tick(); ab_applyState(t) end
    end)
end

local function ab_requestState(value, mode)
    if value == nil then return end
    mode = mode or (Settings.AutoBlockCustom and "custom" or "default")
    abPendingState = { value = value, mode = mode }
    local now = tick()
    if abLastToggle > 0 and now - abLastToggle < abDebounce then ab_scheduleApply(); return end
    if abPendingTask then pcall(task.cancel, abPendingTask); abPendingTask = nil end
    abLastToggle = now
    local t = abPendingState
    abPendingState = nil
    ab_applyState(t)
end

