        if fgm then local ok,FG=pcall(require,fgm) if ok and FG and FG.new then local orig=FG.new FG.new=function(...) local p=orig(...) if flow.on then task.spawn(function() task.wait(0.3); flowSolve(p) end) end return p end end end
    end)
end
