-- ESP (Highlight only)
-- ══════════════════════════════════════════
local ESP = {
    Killers   = false,
    Survivors = false,
    Gens      = false,
    FillT     = 0.55,
}
local espFolder = Instance.new("Folder")
espFolder.Name = "DS_ESP"
espFolder.Parent = workspace

local function clearESP(prefix)
    for _, o in ipairs(espFolder:GetChildren()) do
        if o.Name:sub(1, #prefix) == prefix then o:Destroy() end
    end
end

local function addHL(obj, id, color)
    if not obj or espFolder:FindFirstChild(id) then return end
    local h = Instance.new("Highlight")
    h.Name = id
    h.Adornee = obj
    h.FillColor = color
    h.OutlineColor = Color3.new(0, 0, 0)
    h.FillTransparency = ESP.FillT
    h.OutlineTransparency = 0.15
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = espFolder
end

-- ESP loop ~1.2s (not every frame)
task.spawn(function()
    while getgenv().Doggysaken do
        if ESP.Killers then
            clearESP("K_")
            if KillersFolder then
                for _, m in ipairs(KillersFolder:GetChildren()) do
                    if m:IsA("Model") then
                        addHL(m, "K_" .. m.Name, Color3.fromRGB(255, 50, 50))
                    end
                end
            end
        else
            clearESP("K_")
        end

        if ESP.Survivors then
            clearESP("S_")
            if SurvivorsFolder then
                for _, m in ipairs(SurvivorsFolder:GetChildren()) do
                    if m:IsA("Model") and m ~= LocalChar then
                        addHL(m, "S_" .. m.Name, Color3.fromRGB(50, 255, 80))
                    end
                end
            end
        else
            clearESP("S_")
        end

        if ESP.Gens then
            clearESP("G_")
            local map = workspace:FindFirstChild("Map")
            local ingame = map and map:FindFirstChild("Ingame")
            local root = ingame or workspace
            for _, o in ipairs(root:GetDescendants()) do
                if o:IsA("Model") and o.Name == "Generator" then
                    local p = o:FindFirstChild("Progress")
                    if not p or p.Value < 100 then
                        addHL(o, "G_" .. tostring(o:GetDebugId()), Color3.fromRGB(50, 180, 255))
                    end
                end
            end
        else
            clearESP("G_")
        end

        task.wait(1.2)
    end
end)

