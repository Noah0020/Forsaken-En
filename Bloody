local STAB_ANIM = "100725497418533"
local DASH_ANIM = "89448354637442"
local stabBack, stabDash = false, false
local behindStuds, backDelay, backDur, dashDelay = 4, 0.05, 0.5, 0.25
local function getFVK()
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    for _, m in ipairs(kf:GetDescendants()) do
        if m:IsA("Model") then
            local h = m:FindFirstChildOfClass("Humanoid")
            local r = m:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then return m end
        end
    end
end
local function runStab(delay)
    local char = LP.Character; if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart")
    task.wait(delay)
    local k = getFVK(); if not k or not char.Parent then return end
    local kr = k:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local anchor = Instance.new("Part")
    anchor.Size = Vector3.new(1, 1, 1); anchor.Transparency = 1
    anchor.Anchored = true; anchor.CanCollide = false; anchor.Parent = Workspace
    local st = tick()
    while tick() - st < backDur do
        if not char.Parent then break end
        anchor.CFrame = kr.CFrame * CFrame.new(0, 0, behindStuds)
        hrp.CFrame = anchor.CFrame
        RunService.PreRender:Wait()
    end
    anchor:Destroy()
end
local function hookStab(c)
    local h = c:WaitForChild("Humanoid")
    local a = h:WaitForChild("Animator")
    a.AnimationPlayed:Connect(function(t)
        if not t or not t.Animation then return end
        local id = tostring(t.Animation.AnimationId or ""):gsub("%D", "")
        if id == STAB_ANIM and stabBack then task.spawn(runStab, backDelay)
        elseif id == DASH_ANIM and stabDash then task.spawn(runStab, dashDelay) end
    end)
end
if LP.Character then hookStab(LP.Character) end
LP.CharacterAdded:Connect(hookStab)

