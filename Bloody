_G.DogsakenBlockNames = {"PERFORATING","LACERATE","EVISCERATE","CARVING SLASH","STAB","TAG","SLASH","ENRAGED SLASH"}
_G.AutoBlockEnabled  = false
_G.AutoBlockPunch    = false
_G.AutoBlockDistance = 28
local _BLOCK_NAMES_LOWER = {}
for _,n in ipairs(_G.DogsakenBlockNames) do _BLOCK_NAMES_LOWER[n:lower()] = true end

local function nameMatchesBlock(raw)
    if type(raw)~="string" or raw=="" then return false end
    local l = raw:lower()
    for bn in pairs(_BLOCK_NAMES_LOWER) do
        if string.find(l,bn,1,true) then return true end end
    return false
end

local function extractAnimIds(v)
    local ids = {}
    local function walk(x)
        if type(x)=="string" then local id=x:match("%d+"); if id then ids[#ids+1]=id end
        elseif type(x)=="table" then
            if x.AnimationId then local id=tostring(x.AnimationId):match("%d+"); if id then ids[#ids+1]=id end end
            if x.SoundId then local id=tostring(x.SoundId):match("%d+"); if id then ids[#ids+1]=id end end
            for _,sub in pairs(x) do walk(sub) end end
    end
    walk(v); return ids
end

local BLOCK_ANIM_IDS, BLOCK_SOUND_IDS = {}, {}
local BLOCK_SOUND_FIELDS = {"Sounds","Sound","SFX","Sfx","SoundEffects","SoundIds"}

local function collectBlockAssets(cfg)
    if type(cfg)~="table" then return end
    if type(cfg.Animations)=="table" then
        for name,v in pairs(cfg.Animations) do
            if nameMatchesBlock(name) then
                for _,id in ipairs(extractAnimIds(v)) do BLOCK_ANIM_IDS[id]=true end end end end
    for _,field in ipairs(BLOCK_SOUND_FIELDS) do
        if type(cfg[field])=="table" then
            for name,v in pairs(cfg[field]) do
                if nameMatchesBlock(name) then
                    for _,id in ipairs(extractAnimIds(v)) do BLOCK_SOUND_IDS[id]=true end end end end end
end

local function scanKillerFolder(folder)
    if not folder then return end
    for _,sub in ipairs(folder:GetChildren()) do
        if sub:IsA("Folder") then
            for _,cn in ipairs({"Config","Behavior"}) do
                local mod = sub:FindFirstChild(cn)
                if mod and mod:IsA("ModuleScript") then
                    local ok,data = pcall(require,mod)
                    if ok then collectBlockAssets(data) end end end end end
end

local function scanAllKillerAssets()
    BLOCK_ANIM_IDS, BLOCK_SOUND_IDS = {}, {}
    local assets = ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
    scanKillerFolder(assets:FindFirstChild("Killers"))
    local sk = assets:FindFirstChild("Skins")
    local kf = sk and sk:FindFirstChild("Killers")
    if kf then for _,b in ipairs(kf:GetChildren()) do
        if b:IsA("Folder") then scanKillerFolder(b) end end end
    local ac,sc=0,0
    for _ in pairs(BLOCK_ANIM_IDS) do ac+=1 end
    for _ in pairs(BLOCK_SOUND_IDS) do sc+=1 end
    print(string.format("[Dogsaken Block] %d anims + %d sounds loaded",ac,sc))
end
scanAllKillerAssets()

local function getBlockAbilityName(killer)
    if not killer then return nil end
    for _,attr in ipairs({"AbilityName","LastAbility","CurrentAbility","LastAbilityName","AbilityUsed","Ability","CurrentAttack"}) do
        local ok,val = pcall(function() return killer:GetAttribute(attr) end)
        if ok and type(val)=="string" and val~="" then return val end end
    return nil
end

local function blockDistanceOK(killer)
    local my = Character and Character:FindFirstChild("HumanoidRootPart")
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not my or not kr then return false end
    return (kr.Position - my.Position).Magnitude < _G.AutoBlockDistance
end
local function isPlayerKiller() return Character and Character.Parent == Killers end

local function createBlockBox(killer)
    sendAbility("Block")
    if _G.AutoBlockPunch then
        task.spawn(function()
            if combat.blocked() then
                sendAbility("Punch")
                if killer and killer.PrimaryPart then aim:Aimbot(killer.PrimaryPart, 0.5) end end end)
    end
end

local blockHookedKillers = {}
local function hookKillerFiltered(killer)
    if not killer or blockHookedKillers[killer] or not killer:IsA("Model") then return end
    if killer == Character then return end
    blockHookedKillers[killer] = true

    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not _G.AutoBlockEnabled or isPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if not id or not BLOCK_ANIM_IDS[id] then return end
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer) end)
    end
    local function hookSound(s)
        if not s:IsA("Sound") then return end
        s.Played:Connect(function()
            if not _G.AutoBlockEnabled or isPlayerKiller() then return end
            local sid = tostring(s.SoundId):match("%d+")
            if not sid or not BLOCK_SOUND_IDS[sid] then return end
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer) end)
    end
    for _,d in ipairs(killer:GetDescendants()) do hookSound(d) end
    killer.DescendantAdded:Connect(hookSound)

    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local function onAbilityChange()
        if not _G.AutoBlockEnabled or isPlayerKiller() then return end
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local name = getBlockAbilityName(killer)
        if name and nameMatchesBlock(name) and blockDistanceOK(killer) then createBlockBox(killer) end
    end
    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(onAbilityChange)
    for _,attr in ipairs({"AbilityName","LastAbility","CurrentAbility","LastAbilityName"}) do
        pcall(function() killer:GetAttributeChangedSignal(attr):Connect(onAbilityChange) end)
    end
end

local _shutdown = false
task.spawn(function()
    while not _shutdown do
        task.wait(0.5)
        if _G.AutoBlockEnabled and not isPlayerKiller() then
            local kf = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Killers")
            if kf then
                for _,k in ipairs(kf:GetChildren()) do
                    if k:IsA("Model") and k ~= Character then hookKillerFiltered(k) end end end
        end
    end
end)

