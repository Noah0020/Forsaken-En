safe("ESP", function()
    local S = { Killer=false, Survivor=false, Generator=false, Names=false, Distance=false, Health=false, MaxDist=200 }
    local HL, tags, Folder = {}, {}, nil
    local function ensure()
        if Folder and Folder.Parent then return Folder end
        Folder = Instance.new("Folder"); Folder.Name = "Nos_ESP"; Folder.Parent = CoreGui
        return Folder
    end
    local function clear(m)
        if HL[m] then pcall(function() HL[m]:Destroy() end); HL[m]=nil end
        if tags[m] then pcall(function() tags[m]:Destroy() end); tags[m]=nil end
    end
    local function applyHL(m, col)
        local hl = HL[m]
        if hl and hl.Parent and hl.Adornee == m then hl.FillColor=col; hl.OutlineColor=col; return end
        if hl then pcall(function() hl:Destroy() end) end
        hl = Instance.new("Highlight")
        hl.Adornee=m; hl.FillColor=col; hl.OutlineColor=col
        hl.FillTransparency=0.55; hl.OutlineTransparency=0
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent=ensure(); HL[m]=hl
    end
    local function applyTag(m, text, col)
        local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
        if not part then return end
        local bb = tags[m]
        if not bb or not bb.Parent then
            bb = Instance.new("BillboardGui")
            bb.AlwaysOnTop=true; bb.Size=UDim2.fromOffset(160,36); bb.StudsOffset=Vector3.new(0,3,0)
            bb.Adornee=part; bb.Parent=ensure()
            local lab = Instance.new("TextLabel")
            lab.BackgroundTransparency=1; lab.Size=UDim2.fromScale(1,1)
            lab.Font=Enum.Font.GothamBold; lab.TextSize=13; lab.TextStrokeTransparency=0.4
            lab.Parent=bb; tags[m]=bb
        end
        local lab = bb:FindFirstChildOfClass("TextLabel")
        if lab then lab.Text=text; lab.TextColor3=col end
        bb.Adornee=part
    end
    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.4)
            local seen = {}
            local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local pf = Workspace:FindFirstChild("Players")
            local function handle(m, col, show)
                if not m or m == LP.Character then return end
                local r = m:FindFirstChild("HumanoidRootPart")
                local h = m:FindFirstChildOfClass("Humanoid")
                if not r or not h or h.Health <= 0 then return end
                if my and (r.Position - my.Position).Magnitude > S.MaxDist then return end
                seen[m]=true
                if show then applyHL(m, col) end
                if S.Names or S.Distance or S.Health then
                    local parts = {}
                    if S.Names then table.insert(parts, m.Name) end
                    if S.Health then table.insert(parts, math.floor(h.Health).." HP") end
                    if S.Distance and my then table.insert(parts, math.floor((r.Position-my.Position).Magnitude).."m") end
                    applyTag(m, table.concat(parts, " | "), col)
                end
            end
            if pf then
                local kf = pf:FindFirstChild("Killers")
                if kf then for _,k in ipairs(kf:GetChildren()) do handle(k, Color3.fromRGB(255,60,60), S.Killer) end end
                local sf = pf:FindFirstChild("Survivors")
                if sf then for _,s in ipairs(sf:GetChildren()) do handle(s, Color3.fromRGB(80,255,120), S.Survivor) end end
            end
            if my and S.Generator then
                for _,obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "Generator" and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part and (part.Position-my.Position).Magnitude <= S.MaxDist then
                            seen[obj]=true; applyHL(obj, Color3.fromRGB(255,220,40))
                        end
                    end
                end
            end
            for m in pairs(HL) do if not seen[m] then clear(m) end end
            for m in pairs(tags) do if not seen[m] then clear(m) end end
        end
    end)
    local left = Tabs.ESP:AddLeftGroupbox("ESP", "eye")
    left:AddToggle("ESP_Killer",{Text="Killer ESP",Default=false,Callback=function(v) S.Killer=v end})
    left:AddToggle("ESP_Survivor",{Text="Survivor ESP",Default=false,Callback=function(v) S.Survivor=v end})
    left:AddToggle("ESP_Generator",{Text="Generator ESP",Default=false,Callback=function(v) S.Generator=v end})
    local right = Tabs.ESP:AddRightGroupbox("Tags", "settings")
    right:AddToggle("ESP_Names",{Text="Names",Default=false,Callback=function(v) S.Names=v end})
    right:AddToggle("ESP_Distance",{Text="Distance",Default=false,Callback=function(v) S.Distance=v end})
    right:AddToggle("ESP_Health",{Text="Health",Default=false,Callback=function(v) S.Health=v end})
    right:AddSlider("ESP_MaxDist",{Text="Max Distance",Default=200,Min=50,Max=500,Rounding=0,Callback=function(v) S.MaxDist=v end})
end)

safe("Generator", function()
    local MS={Enabled=false,Generation=0,Installed=false,Delay=1}
    local function install()
        if MS.Installed then return true end
        local ok = pcall(function()
            local folder = ReplicatedStorage.Systems.Player.Game.Minigames
            local mod = require(folder.ConnectClientMinigame.ConnectInput)
            local old = mod.new
            mod.new = function(board, renderer, callbacks)
                local object = old(board, renderer, callbacks)
                local token = MS.Generation
                task.spawn(function()
                    while object and not object.Ended and not MS.Enabled do task.wait(0.05) end
                    if not (object and not object.Ended and MS.Enabled and token == MS.Generation) then return end
                    task.wait(MS.Delay)
                    if board.Blobs then
                        for blob in pairs(board.Blobs) do
                            if not MS.Enabled then return end
                            if not board:GetLink(blob) then
                                local mate = board:GetMate(blob)
                                if mate then board:Connect(blob, mate); renderer:Render(); task.wait(MS.Delay) end
                            end
                        end
                    end
                    if MS.Enabled and board.IsSolved and board:IsSolved() then
                        object:__finish()
                        if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                    end
                end)
                return object
            end
            MS.Installed = true
        end)
        return MS.Installed
    end
