                end
                if StamSettings.ModMaxStamina then StamModule.MaxStamina = StamSettings.MaxStamina end
                if StamSettings.ModSprintSpeed then StamModule.SprintSpeed = StamSettings.SprintSpeed end
                if StamSettings.Infinite then StamModule.StaminaGain = StamSettings.InfiniteGain
                elseif StamSettings.ModStaminaGain then StamModule.StaminaGain = StamSettings.StaminaGain
                elseif StamOrig.StaminaGain ~= nil then StamModule.StaminaGain = StamOrig.StaminaGain end
                if StamSettings.Infinite then StamModule.StaminaLoss = 0
                elseif StamSettings.ModStaminaLoss then StamModule.StaminaLoss = StamSettings.StaminaLoss
                elseif StamOrig.StaminaLoss ~= nil then StamModule.StaminaLoss = StamOrig.StaminaLoss end
            end)
        end
        task.wait(0.25)
    end
end)

