    }

    -- Survivor name -> set of abilities that should trigger aim
    local SURVIVOR_ABILITIES = {
        ["Shedletsky"]   = { ["SLASH"] = true },
        ["Guest 1337"]   = { ["PUNCH"] = true, ["PARRY"] = true, ["PARRY PUNCH"] = true },
        ["Chance"]       = { ["ONE SHOT"] = true, ["SHOT"] = true, ["FLINTLOCK"] = true, ["GUN"] = true },
