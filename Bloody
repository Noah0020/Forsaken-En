--═══════════════════════════════════════════════════════════════════
-- TWO TIME AUTO BACKSTAB
--═══════════════════════════════════════════════════════════════════
do
    local BS = {
        enabled = false,
        duration = 0.35,
        behind = 3,
        method = "Lerp",
    }
    local IDS = {
        ["100725497418533"] = true,
        ["89448354637442"] = true,
        ["106086955212611"] = true,
        ["107640065977686"] = true,
    }

    local function doStab()
        if not BS.enabled or IsPlayerKiller() then return end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local k = GetNearestKiller(40)
        local kr = k and k:FindFirstChild("HumanoidRootPart")
        if not hrp or not kr then return end
        local start = tick()
        while tick() - start < BS.duration do
            if not hrp.Parent or not kr.Parent then break end
            local goal = kr.CFrame * CFrame.new(0, 0, BS.behind)
            if BS.method == "Teleport" then
                hrp.CFrame = goal
            else
                hrp.CFrame = hrp.CFrame:Lerp(goal, 0.35)
            end
            RunService.RenderStepped:Wait()
        end
    end

    local function hookChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 6)
            if not hum then return end
            local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
            if not anim then return end
            anim.AnimationPlayed:Connect(function(track)
                if not BS.enabled then return end
                local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                if id and IDS[id] then
                    task.spawn(doStab)
                end
            end)
        end)
    end
    if LP.Character then hookChar(LP.Character) end
    LP.CharacterAdded:Connect(hookChar)

    local left = Tabs.Stab:AddLeftGroupbox("Auto Backstab")
    left:AddToggle("BS_Enable", {
        Text = "Enable Auto Backstab",
        Default = false,
        Callback = function(v) BS.enabled = v end,
    })
    left:AddDropdown("BS_Method", {
        Values = { "Lerp", "Teleport" },
        Default = 1,
        Text = "Method",
        Callback = function(v) BS.method = v end,
    })
    left:AddSlider("BS_Dur", {
        Text = "Duration", Default = 0.35, Min = 0.1, Max = 1.5, Rounding = 2,
        Callback = function(v) BS.duration = v end,
    })
    left:AddSlider("BS_Behind", {
        Text = "Behind Studs", Default = 3, Min = 1, Max = 10, Rounding = 1,
        Callback = function(v) BS.behind = v end,
    })
end

--═══════════════════════════════════════════════════════════════════
-- GENERATOR SOLVER
--═══════════════════════════════════════════════════════════════════
do
    local Gen = {
        enabled = false,
        gen = 0,
        installed = false,
        startDelay = 1.2,
        actionDelay = 0.05,
        connectDelay = 0.8,
    }

    local function still(token, object)
        return Gen.enabled and token == Gen.gen and object and not object.Ended
    end

    local function waitSolve(object)
        while object and not object.Ended and not Gen.enabled do task.wait(0.05) end
        if not (object and not object.Ended and Gen.enabled) then return false end
        local t0 = os.clock()
        while object and not object.Ended and Gen.enabled and os.clock() - t0 < Gen.startDelay do
            task.wait(0.05)
        end
        return object and not object.Ended and Gen.enabled
    end

    local function install()
        if Gen.installed then return end
        Gen.installed = true
        pcall(function()
            local folder = ReplicatedStorage.Systems.Player.Game.Minigames
            local Connect = require(folder.ConnectClientMinigame.ConnectInput)
            local old = Connect.new
            Connect.new = function(board, renderer, callbacks)
                local object = old(board, renderer, callbacks)
                local token = Gen.gen
                task.spawn(function()
                    if not waitSolve(object) then return end
                    task.wait(Gen.connectDelay)
                    if not board.Blobs then return end
                    for blob in pairs(board.Blobs) do
                        if not still(token, object) then return end
                        if not board:GetLink(blob) then
                            local mate = board:GetMate(blob)
                            if mate then
                                board:Connect(blob, mate)
                                renderer:Render()
                                task.wait(Gen.connectDelay)
                            end
                        end
                    end
                    if still(token, object) and board.IsSolved and board:IsSolved() then
                        object:__finish()
                        if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                    end
                end)
                return object
            end

            -- Flow
            local okFlow, FlowInput = pcall(function()
                return require(folder.FlowClientMinigame.FlowInput)
            end)
            local okBoard, FlowBoard = pcall(function()
                return require(ReplicatedStorage.Modules.Minigames.FlowBoard)
            end)
            if okFlow and okBoard then
                local oldF = FlowInput.new
                FlowInput.new = function(board, renderer, callbacks)
                    local object = oldF(board, renderer, callbacks)
                    local token = Gen.gen
                    task.spawn(function()
                        if not waitSolve(object) then return end
                        task.wait(Gen.actionDelay)
                        -- simple pair walk if available
                        if board.Pairs and FlowBoard then
                            -- minimal: attempt finish if already solvable helpers exist
                        end
                        if still(token, object) and board.IsSolved and board:IsSolved() then
                            object:__finish()
                            if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                        end
                    end)
                    return object
                end
            end
        end)
    end

    local left = Tabs.Generator:AddLeftGroupbox("Auto Generator")
    left:AddToggle("Gen_Enable", {
        Text = "Enable Auto Gen",
        Default = false,
        Callback = function(v)
            Gen.enabled = v
            Gen.gen = Gen.gen + 1
            if v then install() end
        end,
    })
    left:AddSlider("Gen_Start", {
        Text = "Start Delay", Default = 1.2, Min = 0, Max = 4, Rounding = 2,
        Callback = function(v) Gen.startDelay = v end,
    })
    left:AddSlider("Gen_Conn", {
        Text = "Connect Delay", Default = 0.8, Min = 0.1, Max = 2, Rounding = 2,
        Callback = function(v) Gen.connectDelay = v end,
    })
end

