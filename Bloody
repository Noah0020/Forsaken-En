local function hookLocalHDT(char)
    if HDTState.conn then pcall(function() HDTState.conn:Disconnect() end) HDTState.conn = nil end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
        if not anim then return end
        HDTState.conn = anim.AnimationPlayed:Connect(function(track)
            if not SettingsAB.HDTEnabled then return end
            local id = track.Animation and extractId(track.Animation.AnimationId)
            if id and HDT_ANIMS[id] then
                local k = nearestKiller(40)
                if k then
                    local d = SettingsAB.HDTDelay or 0.05
                    if d > 0 then
                        task.delay(d, function() HDT_Dash(k) end)
                    else
                        HDT_Dash(k)
                    end
                end
            end
        end)
    end)
end
if LP.Character then hookLocalHDT(LP.Character) end
LP.CharacterAdded:Connect(hookLocalHDT)

local function SetAutoBlock(on)
    SettingsAB.Enabled = on
    for i = 1, #ABState.connections do
        pcall(function() ABState.connections[i]:Disconnect() end)
    end
    ABState.connections = {}
    ABState.pending = {}
    clearHitboxes()
    if not on then
        Notify("Auto Block", "OFF")
        return
    end
    refreshFolders()
    if KillersFolder then
        for _, k in ipairs(KillersFolder:GetChildren()) do
            if k:IsA("Model") then trackKillerAB(k) end
        end
        table.insert(ABState.connections, KillersFolder.ChildAdded:Connect(function(c)
            if c:IsA("Model") then trackKillerAB(c) end
        end))
    end
    table.insert(ABState.connections, RS.Heartbeat:Connect(abHeartbeat))
    Notify("Auto Block", "ON · Skidsaken hitbox")
end

