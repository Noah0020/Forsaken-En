local ConeState = { folder = nil, lines = {} }

local function Cone_EnsureFolder()
    if ConeState.folder and ConeState.folder.Parent then return ConeState.folder end
    local f = Instance.new("Folder")
    f.Name = "GS_ConeVisuals"
    f.Parent = Workspace
    ConeState.folder = f
    return f
end

local function Cone_CreateLine()
    local part = Instance.new("Part")
    part.Name = "ConeLine"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = Settings.ConeColor
    part.Transparency = 1
    part.Size = Vector3.new(Settings.ConeThickness, Settings.ConeThickness, 1)
    part.Parent = Cone_EnsureFolder()
    return part
end

local function Cone_GetLine(index)
    if not ConeState.lines[index] then
        ConeState.lines[index] = Cone_CreateLine()
    end
    return ConeState.lines[index]
end

local function Cone_HideUnused(count)
    for i = count + 1, #ConeState.lines do
        local ln = ConeState.lines[i]
        if ln and ln.Parent then ln.Transparency = 1 end
    end
end

local function Cone_DrawLine(index, a, b)
    local line = Cone_GetLine(index)
    local mid = (a + b) / 2
    local diff = b - a
    local mag = math.max(diff.Magnitude, 0.01)
    line.Size = Vector3.new(Settings.ConeThickness, Settings.ConeThickness, mag)
    line.CFrame = CFrame.lookAt(mid, b)
    line.Color = Settings.ConeColor
    line.Transparency = Settings.ConeTransparency
end

local function Cone_DrawForKiller(killerRoot, startIndex)
    if not killerRoot then return 0 end
    local position = killerRoot.Position
    local forward = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z)
    if forward.Magnitude < 0.001 then return 0 end
    forward = forward.Unit

    local right = Vector3.new(-forward.Z, 0, forward.X)
    local groundY = position.Y - 2.5 + Settings.ConeGroundOffset
    local origin = Vector3.new(position.X, groundY, position.Z)

    local halfAngle = math.rad(Settings.ConeAngle / 2)
    local segments = math.max(4, math.floor(Settings.ConeSegments))
    local rings = math.max(1, math.floor(Settings.ConeRings))
    local radius = math.max(1, Settings.ConeRadius)

    local points = {}
    for i = 0, segments do
        local angle = -halfAngle + (i / segments) * halfAngle * 2
        local direction = forward * math.cos(angle) + right * math.sin(angle)
        points[i + 1] = origin + direction * radius
    end

    local lineIndex = startIndex
    for i = 1, segments do
        lineIndex += 1
        Cone_DrawLine(lineIndex, points[i], points[i + 1])
    end
    for i = 1, segments + 1 do
        if i % 2 == 1 then
            lineIndex += 1
            Cone_DrawLine(lineIndex, origin, points[i])
        end
    end
    for ring = 1, rings do
        local distance = radius * ring / (rings + 1)
        for i = 1, segments do
            lineIndex += 1
            local a = origin:Lerp(points[i], distance / radius)
            local b = origin:Lerp(points[i + 1], distance / radius)
            Cone_DrawLine(lineIndex, a, b)
        end
    end

    return lineIndex - startIndex
end

