local function NS_makeHitboxAndCheck(killerModel, onDetected)
    if KillerState.isKiller then return end
    if not killerModel or not killerModel.Parent then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
    if not killerRoot then return end
    if Settings.FacingCheckEnabled then
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        if not myRoot or not PassesFacingCheck(myRoot, killerRoot) then return end
    end
    local hbCfg = NS_getKillerHitbox(killerModel.Name)
    -- [v1.6 FIX] đọc HitboxMultiplier alias
    local m = Settings.HitboxMultiplier or Settings.RectangleMultiplier or 1
    local hbWidth = hbCfg.width or 6
    local hbLength = hbCfg.length or 9
    local hbHeight = hbCfg.height or 6
    local size = Vector3.new(hbWidth*m, hbHeight*m, hbLength*m)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killerModel}
    task.spawn(function()
        local startTime = tick()
        local blockedOnce = false
        _ns_stopHitboxVisual = false
        while tick() - startTime < hbCfg.dura do
            if _ns_stopHitboxVisual then break end
            if KillerState.isKiller then break end
            local ckr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not ckr then break end
            -- [v1.6 FIX] đọc HitboxDistance alias trước
            local distVal = hbCfg.distance or Settings.HitboxDistance or Settings.RectangleDistance or 3
            local frozenCFrame = ckr.CFrame * CFrame.new(0,0,-distVal)
            -- This is the invisible overlap-query volume. The visible box is
            -- drawn independently by NS_UpdateHitboxVisuals so it stays on screen
            -- instead of flashing for only a fraction of an attack window.
            local hb = Instance.new("Part")
            hb.Name = "AutoBlockHitbox_Query"
            hb.Transparency = 1
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Anchored = true
            hb.Size = size
            hb.CFrame = frozenCFrame; hb.Parent = Workspace
            Debris:AddItem(hb, hbCfg.life)
            local found = false
            for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then found = true; break end
            end
            if found and not blockedOnce then
                blockedOnce = true
                -- Chỉ fire block, KHÔNG hiện xanh ở đây (xanh chỉ khi sound block start = thành công thật)
                _lastABSuccessTime = tick()
                _lastABKillerRoot = ckr
                NS_fireAB(); NS_fireAB(); NS_fireAB(); NS_fireAB()
                NS_spamBlock(0.05)
                if onDetected then onDetected() end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

