local t2
t2 = {
	currentGenerator     = nil,
	currentGenerators    = {},
	lastGenerator        = nil,
	lastLastGenerator    = nil,
	delay                = 2,
	busy                 = false,
	resetAfterCompletion = false,
	autogen              = false,
	autogenToggle        = nil,
	fixPuzzleCooldown    = false,
	puzzleLoopCooldown   = 4,
	disableAfterCompletion = false,

	getOthersRootPos = function()
		local pos = {}
		local all = Players:GetPlayers()
		table.remove(all, table.find(all, LocalPlayer))
		for _, p in pairs(all) do
			local pp = p.Character and p.Character.PrimaryPart
			if pp then table.insert(pos, pp.Position) end
		end
		return pos
	end,

	isAnyoneAt = function(self, pos)
		for _, v in ipairs(self:getOthersRootPos()) do
			if vector.magnitude(v - pos) <= 1.5 then return true end
		end
	end,

	isGeneratorViable = function(self, gen)
		local nv = gen:FindFirstChildOfClass("NumberValue")
		if not nv or nv.Name ~= "Progress" or nv.Value >= 100 then return false end
		local n   = 0
		local gpos = gen.PrimaryPart and gen.PrimaryPart.Position or gen:GetPivot().Position
		for _, v in ipairs(self:getOthersRootPos()) do
			if vector.magnitude(v - gpos) <= 8 then n += 1 end
		end
		return n < 3
	end,

	getAllGenerators = function(self)
		table.clear(self.currentGenerators)
		if not Character then return self.currentGenerators end
		local map = getIngameMap()
		if not map then return self.currentGenerators end
		for _, child in pairs(map:GetChildren()) do
			if child.Name == "Generator" and self:isGeneratorViable(child) then
				table.insert(self.currentGenerators, child)
			end
		end
		local cpos = Character:GetPivot().Position
		table.sort(self.currentGenerators, function(a, b)
			local av = a == self.lastGenerator or a == self.lastLastGenerator or a == self.currentGenerator
			if av == (b == self.lastGenerator or b == self.lastLastGenerator or b == self.currentGenerator) then
				return vector.magnitude(a:GetPivot().Position - cpos) < vector.magnitude(b:GetPivot().Position - cpos)
			end
			return not av
		end)
		return self.currentGenerators
	end
}

local function completePuzzle()
	if t2.currentGenerator or t2.autogen or t2.fixPuzzleCooldown then return end
	if not PlayerGui or not PlayerGui:FindFirstChild("PuzzleUI") then return end
	xpcall(function()
		if not getIngameMap() or not Character then return end
		local best, bestDist = nil, math.huge
		for _, gen in pairs(t2:getAllGenerators()) do
			local d = vector.magnitude(gen:GetPivot().Position - Character:GetPivot().Position)
			if d < bestDist then best = gen; bestDist = d end
		end
		if not best or bestDist > 8 then Notify("You're not in a generator.", 2); return end
		t2.fixPuzzleCooldown = true
		fireRemote(best:WaitForChild("Remotes", 3).RE)
	end, v13)
	task.delay(1.5, function() t2.fixPuzzleCooldown = false end)
end

local function doGenerator(gen)
	if isInLobby() then return end
	task.wait(math.random() / 100)
	local pp = Character and Character.PrimaryPart
	local ch = Character and Character:FindFirstChild("CollisionHitbox")
	if not pp or not ch then return end
	if pp.Anchored then repeat task.wait() until not pp.Anchored end
	local Positions = gen:WaitForChild("Positions", 3)
	local Progress  = gen:WaitForChild("Progress",  3)
	local Remotes   = gen:WaitForChild("Remotes",   3)
	local RF = Remotes and Remotes:FindFirstChild("RF")
	local RE = Remotes and Remotes:FindFirstChild("RE")
	if not Progress or not Remotes or not RF or not RE or not Positions then return end
	local slots = {
		Positions:FindFirstChild("Left").Position,
		Positions:FindFirstChild("Right").Position,
		Positions:FindFirstChild("Center").Position
	}
	local slot
	for _, v in ipairs(slots) do
		if not t2:isAnyoneAt(v) then slot = v; break end
	end
	if not slot then return end
	local oldCC   = ch.CanCollide
	pp.CanCollide = false
	ch.CanCollide = false
	pp.CFrame     = CFrame.new(slot + vector.create(math.random()/10, 0, math.random()/10))
	task.wait(0.2)
	if Progress.Value >= 80 then return end
	if not fireRemote(RF, "Enter") then return false end
	if gen == t2.lastGenerator or gen == t2.lastLastGenerator then task.wait(0.9) end
	task.wait(0.02)
	pp.CanCollide = oldCC
	ch.CanCollide = oldCC
	fireRemote(RE)
	task.wait(0.02)
	fireRemote(RF, "Leave")
	task.wait(0.02)
end

local function startAutogen()
	task.wait()
	if t2.autogen then
		if t2.busy then return end
		t2.busy = true
		while t2.autogen do
			if Character then
				if isInLobby() or Character.Parent == Killers then
					Notify(isInLobby() and "In lobby, waiting..." or "You're a killer! Waiting...", 3)
				elseif #t2:getAllGenerators() < 1 then
					Notify("No generators left. Waiting...")
				else
					while true do
						task.wait()
						xpcall(function()
							for _, gen in ipairs(t2:getAllGenerators()) do
								if not Killers:GetChildren()[1] then break end
								if not t2.autogen or isInLobby() then
									t2.currentGenerator  = nil
									t2.lastGenerator     = nil
									t2.lastLastGenerator = nil
									break
								end
								if not Character or Character.Parent ~= Killers then
									if t2:isGeneratorViable(gen) then
										Notify("Doing a generator")
										t2.lastLastGenerator = t2.lastGenerator
										t2.lastGenerator     = t2.currentGenerator
										t2.currentGenerator  = gen
										doGenerator(gen)
									end
								else
									Character:FindFirstChildOfClass("Humanoid").Health = 0
									break
								end
							end
							if tonumber(t2.delay) then task.wait(t2.delay) end
						end, v13)
						if not t2.autogen then break end
						if #t2:getAllGenerators() < 1 then break end
					end
					t2.lastLastGenerator = nil
					t2.currentGenerator  = nil
					t2.lastGenerator     = nil
				end
				t2.busy = false
				while true do
					task.wait()
					if not Character then continue end
					if Character.Parent ~= Killers and not isInLobby() and t2:getAllGenerators()[1] then break end
				end
			else
				task.wait()
			end
		end
	else
		t2.currentGenerator  = nil
		t2.currentGenerators = {}
		t2.lastGenerator     = nil
		t2.lastLastGenerator = nil
	end
end

-- Puzzle loop
local t19 = { running = false, ended = false, threads = 0 }
local function loopPuzzle(state)
	state.threads += 1
	while not state.ended do
		task.wait()
		if state.running and not state.ended then
			task.wait(math.random() + tonumber(t2.puzzleLoopCooldown or 3))
			if state.running and not state.ended then completePuzzle() end
		end
	end
	state.threads -= 1
end
