RunService.RenderStepped:Connect(function()
    if not StabAim.enabled or os.clock() > StabAim.activeUntil then return end
    if not isLocalSurvivor(lp.Character) then return end
    local killer = StabAim.activeTarget
    if not killer or killer.Parent ~= KillersFolder then killer = getNearestKiller() end
    local targetRoot = killer and killer:FindFirstChild("HumanoidRootPart")
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot or not myRoot then return end
    if (targetRoot.Position - myRoot.Position).Magnitude > StabAim.maxRange then return end
    local velocity = targetRoot.AssemblyLinearVelocity
    if velocity.Magnitude > 200 then velocity = Vector3.zero end
    local predicted = targetRoot.Position + velocity * math.clamp(StabAim.velocityLead, 0, 0.75)
    local flat = Vector3.new(predicted.X, myRoot.Position.Y, predicted.Z)
