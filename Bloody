        if ObjectESPData[i].model == model then table.remove(ObjectESPData, i) end
    end
    pcall(function()
        if model:FindFirstChild("Vortex_ObjectHighlight") then model.Vortex_ObjectHighlight:Destroy() end
        if model:FindFirstChild("Vortex_ObjectBillboard") then model.Vortex_ObjectBillboard:Destroy() end
    end)
