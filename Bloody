-- ── Ability name getter ─────────────────────────────────────────
local function getBlockAbilityName(killer)
    if not killer then return nil end
    for _, attr in ipairs({
        "AbilityName", "LastAbility", "CurrentAbility", "LastAbilityName",
        "AbilityUsed", "Ability", "CurrentAttack",
    }) do
        local ok, val = pcall(function() return killer:GetAttribute(attr) end)
        if ok and type(val) == "string" and val ~= "" then return val end
    end
    return nil
end

local function blockDistanceOK(killer)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not my or not kr then return false end
    return (kr.Position - my.Position).Magnitude < (Facing.maxDist or 28)
end

-- ── Hardened facing check (dot + local Z) ───────────────────────
local function isFacingPlayer(killerRoot, myPos)
    if not Facing.enabled then return true end
    local look = killerRoot.CFrame.LookVector
    local toMe = Vector3.new(myPos.X - killerRoot.Position.X, 0, myPos.Z - killerRoot.Position.Z)
    if toMe.Magnitude < 0.01 then return true end
    if look:Dot(toMe.Unit) < (Facing.dot or 0.25) then return false end
    return killerRoot.CFrame:PointToObjectSpace(myPos).Z > 0
end

-- ── On hit: block, punch, HDT ───────────────────────────────────
local function OnRealBlock(killer)
    if IsPlayerKiller() then return end
    FireAbility("Block")
    if AutoPunch.enabled then
        task.delay(AutoPunch.delay or 0.2, function() FireAbility("Punch") end)
    end
    if HDT.enabled then
        local now = tick()
        if now - (HDT.lastTrigger or 0) >= (HDT.cooldown or 27) then
            local root = killer and killer:FindFirstChild("HumanoidRootPart")
            if not root then
                local k = GetNearestKiller(HDT.range or 30)
                root = k and k:FindFirstChild("HumanoidRootPart")
            end
            if root then HDT.lastTrigger = now; DragToward(root) end
        end
    end
end

-- ── Box: detection ALWAYS on; visual toggle only changes transparency
local function createBlockBox(killer)
    if IsPlayerKiller() or not killer or killer == LP.Character or not killer.Parent then return end
    if activeBoxes[killer] then return end

    local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart")
    if not root then return end
    local myChar = LP.Character
    local my = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not my then return end
    if not blockDistanceOK(killer) then return end
    if Facing.required and not isFacingPlayer(root, my.Position) then return end

    activeBoxes[killer] = true

    local size = Vector3.new(
        tonumber(_G.HitboxWidth)  or 5,
        tonumber(_G.HitboxHeight) or 6,
        tonumber(_G.HitboxLength) or 8
    )

    local box = Instance.new("Part")
    box.Name         = "DS_BlockBox"
    box.Anchored     = true
    box.CanCollide   = false
    box.CanTouch     = false
    box.CanQuery     = false
    box.CastShadow   = false
    box.Material     = Enum.Material.ForceField
    box.Color        = _G.HitboxColor or Orange
    box.Size         = size
    box.Transparency = _G.ShowHitboxVisual and (tonumber(_G.HitboxTransparency) or 0.45) or 1
    box.Parent       = Workspace

    local outline
    if _G.ShowOutline and _G.ShowHitboxVisual then
        outline = Instance.new("SelectionBox")
        outline.Adornee       = box
        outline.Color3        = box.Color
        outline.LineThickness = tonumber(_G.OutlineThickness) or 0.05
        outline.Parent        = box
    end

    local duration = tonumber(_G.HitboxDuration) or 0.5
    local start    = os.clock()
    local blocked  = false

    local function cleanup()
        if outline then pcall(function() outline:Destroy() end) end
        pcall(function() box:Destroy() end)
        activeBoxes[killer] = nil
    end

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if blocked or not killer.Parent or not root.Parent or os.clock() - start >= duration then
            if conn then conn:Disconnect() end
            cleanup()
            return
        end
        if IsPlayerKiller() then
            if conn then conn:Disconnect() end
            cleanup()
            return
        end

        size = Vector3.new(
            tonumber(_G.HitboxWidth)  or 5,
            tonumber(_G.HitboxHeight) or 6,
            tonumber(_G.HitboxLength) or 8
        )
        box.Size         = size
        box.Color        = _G.HitboxColor or Orange
        box.Transparency = _G.ShowHitboxVisual and (tonumber(_G.HitboxTransparency) or 0.45) or 1
        if outline then outline.Color3 = box.Color end

        local look   = root.CFrame.LookVector
        local center = root.Position + look * (size.Z * 0.5)
        box.CFrame   = CFrame.lookAt(center, center + look)

        local char = LP.Character
        if not char then return end

        local hit = false

        -- Primary: engine AABB query
        local params = OverlapParams.new()
        params.FilterType              = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { char }
        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(box.CFrame, box.Size, params)
        end)
        if ok and parts and #parts > 0 then hit = true end

        -- Fallback: manual HRP point-in-box with +1.5 stud tolerance
        if not hit then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local lp = box.CFrame:PointToObjectSpace(hrp.Position)
                local tx, ty, tz = size.X/2 + 1.5, size.Y/2 + 1.5, size.Z/2 + 1.5
                if math.abs(lp.X) <= tx and math.abs(lp.Y) <= ty and math.abs(lp.Z) <= tz then
                    hit = true
                end
            end
        end

        if hit then
            blocked = true
            if conn then conn:Disconnect() end
            cleanup()
            local delay = tonumber(_G.BlockDelay) or 0
            if delay > 0 then task.wait(delay) end
            OnRealBlock(killer)
        end
    end)
end

-- ── Combined hook: animation → sound → attribute-name ───────────
local blockHookedKillers = {}
local function hookKillerFiltered(killer)
    if not killer or blockHookedKillers[killer] or not killer:IsA("Model") then return end
    if killer == LP.Character then return end
    blockHookedKillers[killer] = true

    -- ① Fast path: animation played
    local hum      = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if not id or not BLOCK_ANIM_IDS[id] then return end
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer)
        end)
    end

    -- ② Fast path: sound played
    local function hookSound(s)
        if not s:IsA("Sound") then return end
        s.Played:Connect(function()
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local sid = tostring(s.SoundId):match("%d+")
            if not sid or not BLOCK_SOUND_IDS[sid] then return end
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer)
        end)
    end
    for _, d in ipairs(killer:GetDescendants()) do hookSound(d) end
    killer.DescendantAdded:Connect(hookSound)

    -- ③ Backup path: attribute-name filter (catches anim/sound misses)
    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local function onAbilityChange()
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local name = getBlockAbilityName(killer)
        if name and nameMatchesBlock(name) and blockDistanceOK(killer) then
            createBlockBox(killer)
        end
    end
    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(onAbilityChange)
    for _, attr in ipairs({ "AbilityName", "LastAbility", "CurrentAbility", "LastAbilityName" }) do
        pcall(function()
            killer:GetAttributeChangedSignal(attr):Connect(onAbilityChange)
        end)
    end
end

