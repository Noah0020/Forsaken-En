local function fireRagingPace()
    testRemote:FireServer("UseActorAbility", (function(bytes)
        local b = buffer.create(#bytes)
        for i = 1, #bytes do buffer.writeu8(b, i-1, bytes[i]) end
        return b
    end)({3,10,0,0,0,82,97,103,105,110,103,80,97,99,101}))
end

local function isAnimationMatching(anim)
    local id = tostring_ref(anim.Animation and anim.Animation.AnimationId or "")
    local numId = string_match(id, "%d+")
    return animsToDetect[numId] or false
end

RunService.Heartbeat:Connect(function()
    if not ragingPaceEnabled then return end
    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local now = tick_ref()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp then
            local char = player.Character
            local targetHRP = char and char:FindFirstChild("HumanoidRootPart")
            if targetHRP and (targetHRP.Position - myRoot.Position).Magnitude <= RAGING_RANGE
               and (not activeCooldowns[player] or now - activeCooldowns[player] >= COOLDOWN_TIME) then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                        if isAnimationMatching(track) then
                            activeCooldowns[player] = now
                            spawn_ref(function()
                                local start = tick_ref()
                                while tick_ref() - start < SPAM_DURATION do
                                    fireRagingPace()
                                    wait_ref(0.05)
                                end
                            end)
                            break
                        end
                    end
                end
            end
        end
    end
end)

