    local function watch(hrp)
        if not hrp then return end
        local function kill(c)
            if c.Name=="CatchVelocity" or c:IsA("AlignPosition") or c:IsA("LinearVelocity")
               or c:IsA("BodyVelocity") or c:IsA("BodyPosition") then
                pcall(function() c:Destroy() end)
            end
        end
        for _, c in ipairs(hrp:GetChildren()) do kill(c) end
        _antiPullConn = hrp.ChildAdded:Connect(function(c)
            task.wait(0.1)
            if v then kill(c) end
        end)
    end
    if LP.Character then watch(LP.Character:WaitForChild("HumanoidRootPart", 5)) end
end
