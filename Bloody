local HDT = { enabled = false, duration = 0.35, speed = 14, range = 30, token = 0, lastTrigger = 0, cooldown = 27 }
local function DragToward(killerRoot)
    if not HDT.enabled or not killerRoot then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if (killerRoot.Position - hrp.Position).Magnitude > (HDT.range or 30) then return end
    HDT.token += 1
    local myToken, speed, duration = HDT.token, HDT.speed or 14, HDT.duration or 0.35
    local start = os.clock()
    task.spawn(function()
        while myToken == HDT.token and os.clock() - start < duration do
            local delta = RunService.Heartbeat:Wait()
            if not hrp.Parent or not killerRoot.Parent then break end
            local direction = Vector3.new(killerRoot.Position.X - hrp.Position.X, 0, killerRoot.Position.Z - hrp.Position.Z)
            if direction.Magnitude <= 3 then break end
            local ramp = math.sin(math.pi * (os.clock() - start) / duration)
            pcall(function()
                hum:Move(direction.Unit, false)
                hrp.CFrame = hrp.CFrame + direction.Unit * speed * ramp * delta
                hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + direction.Unit)
            end)
        end
        if hum and hum.Parent then pcall(function() hum:Move(Vector3.zero, false) end) end
    end)
end

