-- STAM
do
    local Stam = {
        unlimited = false, minS = 0, maxS = 100, loss = 10, gain = 20,
        autoUnsprint = false, unsprintAt = 10,
    }
    local function getSprint()
        if getgenv()._SharedSprintMod then return getgenv()._SharedSprintMod end
        local ok, S = pcall(function()
            return require(ReplicatedStorage.Systems.Character.Game.Sprinting)
        end)
        if ok and S then getgenv()._SharedSprintMod = S; return S end
        return nil
    end
    local function apply()
        local S = getSprint()
        if not S then return end
        pcall(function()
            if Stam.unlimited then
                S.StaminaLoss = 0
                if S.StaminaLossDisabled ~= nil then S.StaminaLossDisabled = true end
                if S.Stamina ~= nil then S.Stamina = math.max(S.Stamina, S.MaxStamina or 100) end
            else
                if S.StaminaLossDisabled ~= nil then S.StaminaLossDisabled = false end
                S.MinStamina = Stam.minS
                S.MaxStamina = Stam.maxS
                S.StaminaLoss = Stam.loss
                S.StaminaGain = Stam.gain
            end
        end)
    end
    local function readBar()
        local pg = LP:FindFirstChild("PlayerGui")
        local amount = pg and pg:FindFirstChild("TemporaryUI")
        amount = amount and amount:FindFirstChild("PlayerInfo")
        amount = amount and amount:FindFirstChild("Bars")
        amount = amount and amount:FindFirstChild("Stamina")
        amount = amount and amount:FindFirstChild("Amount")
        if not amount then return nil end
        local a = tostring(amount.Text):match("(%d+)%s*/")
        return tonumber(a)
    end
    RunService.Heartbeat:Connect(function()
        if Stam.unlimited then apply() end
        if Stam.autoUnsprint then
            local cur = readBar()
            if cur and cur <= Stam.unsprintAt then
                local S = getSprint()
                if S and S.IsSprinting then
                    pcall(function()
                        S.IsSprinting = false
                        if S.__sprintedEvent then S.__sprintedEvent:Fire(false) end
                    end)
                end
            end
        end
    end)
    task.defer(function()
        for _ = 1, 30 do if getSprint() then apply(); break end; task.wait(0.3) end
    end)

    local s = TabStam:Section("Stamina")
    s:Toggle({
        Name = "Unlimited Stamina",
        Default = false,
        Callback = function(v) Stam.unlimited = v; apply() end,
    })
    s:Toggle({
        Name = "Auto Unsprint",
        Default = false,
        Callback = function(v) Stam.autoUnsprint = v end,
    })
    s:Slider({
        Name = "Unsprint At", Min = 0, Max = 50, Default = 10,
        Callback = function(v) Stam.unsprintAt = math.floor(v + 0.5) end,
    })
    s:Slider({
        Name = "Min Stamina", Min = 0, Max = 100, Default = 0,
        Callback = function(v) Stam.minS = math.floor(v + 0.5); if not Stam.unlimited then apply() end end,
    })
    s:Slider({
        Name = "Max Stamina", Min = 10, Max = 200, Default = 100,
        Callback = function(v) Stam.maxS = math.floor(v + 0.5); if not Stam.unlimited then apply() end end,
    })
    s:Slider({
        Name = "Drain Rate", Min = 0, Max = 50, Default = 10,
        Callback = function(v) Stam.loss = v; if not Stam.unlimited then apply() end end,
    })
    s:Slider({
        Name = "Gain Rate", Min = 0, Max = 100, Default = 20,
        Callback = function(v) Stam.gain = v; if not Stam.unlimited then apply() end end,
    })
end

-- ESP (SyncSaken-style categories)
do
    local E = {
        survivor = false, killer = false, generator = false, item = false,
        minion = false, trap = false, spray = false,
        names = true, health = true,
        colors = {
            killer = Color3.fromRGB(255, 0, 0),
            survivor = Color3.fromRGB(0, 255, 0),
            generator = Color3.fromRGB(0, 0, 255),
            item = Color3.fromRGB(255, 234, 0),
            minion = Color3.fromRGB(255, 122, 33),
            trap = Color3.fromRGB(225, 0, 255),
            spray = Color3.fromRGB(0, 255, 255),
        },
        tracked = {}, -- [instance] = { hl = Highlight, bb = Billboard }
    }

    local function clearOne(inst)
        local t = E.tracked[inst]
        if not t then return end
        pcall(function() if t.hl then t.hl:Destroy() end end)
        pcall(function() if t.bb then t.bb:Destroy() end end)
        E.tracked[inst] = nil
    end

    local function ensure(inst, kind, label)
        if not inst or not inst.Parent then return end
        local col = E.colors[kind] or Color3.new(1, 1, 1)
        local t = E.tracked[inst]
        if not t then
            t = {}
            E.tracked[inst] = t
            local hl = Instance.new("Highlight")
            hl.Name = "__SESP"
            hl.Adornee = inst
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.7
            hl.OutlineTransparency = 0.2
            hl.Parent = inst
            t.hl = hl
            local root = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
            if root and (kind == "killer" or kind == "survivor") then
                local bb = Instance.new("BillboardGui")
                bb.Name = "__SBB"
                bb.AlwaysOnTop = true
                bb.Size = UDim2.new(0, 140, 0, 16)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.MaxDistance = 2000
                bb.Adornee = root
                bb.Parent = inst
                local lbl = Instance.new("TextLabel")
                lbl.Name = "Text"
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.fromScale(1, 1)
                lbl.Font = Enum.Font.Code
                lbl.TextScaled = true
                lbl.TextStrokeTransparency = 0.3
                lbl.Parent = bb
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.25
                stroke.Parent = lbl
                t.bb = bb
                t.lbl = lbl
            end
        end
        if t.hl then
            t.hl.FillColor = col
            t.hl.OutlineColor = col
            t.hl.Enabled = true
        end
        if t.lbl then
            local hum = inst:FindFirstChildOfClass("Humanoid")
            local parts = {}
            if E.names then table.insert(parts, label or inst.Name) end
            if E.health and hum then
                table.insert(parts, math.floor(hum.Health) .. "HP")
            end
            t.lbl.Text = #parts > 0 and table.concat(parts, " | ") or ""
            t.lbl.TextColor3 = Color3.new(1, 1, 1)
            t.lbl.Visible = #parts > 0
        end
    end

    local function refresh()
        local seen = {}
        local pf = Workspace:FindFirstChild("Players")
        local killers = pf and pf:FindFirstChild("Killers")
        local survivors = pf and pf:FindFirstChild("Survivors")

        if E.killer and killers then
            for _, k in ipairs(killers:GetChildren()) do
                if k:IsA("Model") then
                    seen[k] = true
                    ensure(k, "killer", k.Name)
                end
            end
        end
        if E.survivor and survivors then
            for _, s in ipairs(survivors:GetChildren()) do
                if s:IsA("Model") and s ~= LP.Character then
                    seen[s] = true
                    ensure(s, "survivor", s.Name)
                end
            end
        end

        -- world objects
        local map = Workspace:FindFirstChild("Map")
        local root = map and (map:FindFirstChild("Ingame") or map) or Workspace
        if E.generator or E.item or E.minion or E.trap or E.spray then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("Model") then
                    if E.generator and obj.Name == "Generator" then
                        seen[obj] = true; ensure(obj, "generator")
                    elseif E.item and (obj.Name == "Item" or obj:GetAttribute("Item") or obj.Name == "BloxyCola" or obj.Name == "Medkit") then
                        seen[obj] = true; ensure(obj, "item")
                    elseif E.minion and (obj.Name == "PizzaDeliveryRig" or obj.Name == "1x1x1x1Zombie") then
                        seen[obj] = true; ensure(obj, "minion")
                    elseif E.trap and (obj.Name == "SubspaceTripmine" or string.find(obj.Name, "TaphTripwire")) then
                        seen[obj] = true; ensure(obj, "trap")
                    elseif E.spray and string.find(obj.Name, "Spray") then
                        seen[obj] = true; ensure(obj, "spray")
                    end
                end
            end
            -- also scan workspace for minions/traps outside map
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and not seen[obj] then
                    if E.minion and (obj.Name == "PizzaDeliveryRig" or obj.Name == "1x1x1x1Zombie") then
                        seen[obj] = true; ensure(obj, "minion")
                    elseif E.trap and (obj.Name == "SubspaceTripmine" or string.find(obj.Name, "TaphTripwire")) then
                        seen[obj] = true; ensure(obj, "trap")
                    end
                end
            end
        end

        for inst in pairs(E.tracked) do
            if not seen[inst] or not inst.Parent then
                clearOne(inst)
            end
        end
    end

    task.spawn(function()
        while true do pcall(refresh); task.wait(0.35) end
    end)

    local cat = TabESP:Section("Categories")
    cat:Toggle({ Name = "Survivors", Default = false, Callback = function(v) E.survivor = v; refresh() end })
    cat:Toggle({ Name = "Killers", Default = false, Callback = function(v) E.killer = v; refresh() end })
    cat:Toggle({ Name = "Generators", Default = false, Callback = function(v) E.generator = v; refresh() end })
    cat:Toggle({ Name = "Items", Default = false, Callback = function(v) E.item = v; refresh() end })
    cat:Toggle({ Name = "Minions", Default = false, Callback = function(v) E.minion = v; refresh() end })
    cat:Toggle({ Name = "Traps", Default = false, Callback = function(v) E.trap = v; refresh() end })
    cat:Toggle({ Name = "Sprays", Default = false, Callback = function(v) E.spray = v; refresh() end })

    local det = TabESP:Section("Details")
    det:Toggle({ Name = "Show Names", Default = true, Callback = function(v) E.names = v end })
    det:Toggle({ Name = "Show Health", Default = true, Callback = function(v) E.health = v end })
    det:Colorpicker({ Name = "Killer Color", Default = E.colors.killer, Callback = function(c) E.colors.killer = c end })
    det:Colorpicker({ Name = "Survivor Color", Default = E.colors.survivor, Callback = function(c) E.colors.survivor = c end })
    det:Colorpicker({ Name = "Generator Color", Default = E.colors.generator, Callback = function(c) E.colors.generator = c end })
    det:Colorpicker({ Name = "Item Color", Default = E.colors.item, Callback = function(c) E.colors.item = c end })
    det:Colorpicker({ Name = "Minion Color", Default = E.colors.minion, Callback = function(c) E.colors.minion = c end })
    det:Colorpicker({ Name = "Trap Color", Default = E.colors.trap, Callback = function(c) E.colors.trap = c end })
end

