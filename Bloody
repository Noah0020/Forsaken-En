local function GetMapFolder()
    local m = Workspace:FindFirstChild("Map")
    return m and m:FindFirstChild("Ingame")
end

local DummyNames = {
    "PizzaDeliveryRig","Mafiaso1","Mafiaso2","Builderman","Elliot","ShedletskyCORRUPT","ChancecORRUPT","ChanceCORRUPT",
    "Mafia1","Mafia2","Mafia3","Mafia4","Mafia5","Mafia6","Mafia7","Mafia8","Mafia9",
    "GreenGuy","RedGuy","BlueGuy","PurpleGuy","PinkGuy","YellowGuy","OrangeGuy","GreyGuy"
}
local PlayerESPData, ObjectESPData = {}, {}

local function IsRagdoll(m)
    local r = Workspace:FindFirstChild("Ragdolls")
    return r and (m:IsDescendantOf(r) or m.Parent == r)
end
local function IsSpectating(p)
    if not p then return false end
    local pf = Workspace:FindFirstChild("Players")
    if not pf then return false end
    local sp = pf:FindFirstChild("Spectating")
    return sp and sp:FindFirstChild(p.Name) ~= nil
end
local function GetGenPart(model)
    if not model then return nil end
    local inst = model:FindFirstChild("Instances")
    if inst then
        local gen = inst:FindFirstChild("Generator")
        if gen then
            local cube = gen:FindFirstChild("Cube.003")
            if cube and cube:IsA("BasePart") then return cube end
            for _, v in ipairs(gen:GetDescendants()) do if v:IsA("BasePart") then return v end end
        end
    end
    for _, v in ipairs(model:GetDescendants()) do if v:IsA("BasePart") then return v end end
end
local function ApplyText(data)
    if not data.model or not data.model.Parent then return end
    local isK = data.isKiller
    local showName = isK and ESP.killerName or (not isK and ESP.survivorName)
    local showHP = isK and ESP.killerHealth or (not isK and ESP.survivorHealth)
    local showSkin = isK and ESP.killerSkin or (not isK and ESP.survivorSkin)
    if data.nameLabel and data.nameLabel.Parent then
        if showName then
            local dn = data.model:GetAttribute("ActorDisplayName") or (isK and "KILLER" or "SURVIVOR")
            if showSkin then
                local sn = data.model:GetAttribute("SkinNameDisplay")
                if sn and sn ~= "" then dn = dn .. " | " .. sn end
            end
            data.nameLabel.Text = dn; data.nameLabel.Visible = true
        else data.nameLabel.Visible = false end
    end
    if data.hpLabel and data.hpLabel.Parent then
        if showHP then
            local h = data.model:FindFirstChild("Humanoid")
            if h then data.hpLabel.Text = string.format("HP: %d/%d", math.floor(h.Health), math.floor(h.MaxHealth)) end
            data.hpLabel.Visible = true
        else data.hpLabel.Visible = false end
    end
    if data.highlight and data.highlight.Parent then
        if isK then
            data.highlight.FillColor = ESP.killerColor; data.highlight.OutlineColor = ESP.killerColor
            data.highlight.FillTransparency = ESP.killerFill; data.highlight.OutlineTransparency = ESP.killerOutline
        else
            data.highlight.FillColor = ESP.survivorColor; data.highlight.OutlineColor = ESP.survivorColor
            data.highlight.FillTransparency = ESP.survivorFill; data.highlight.OutlineTransparency = ESP.survivorOutline
        end
    end
end
local function CreatePlayerESP(model, color, isKiller)
    if model:FindFirstChild("Ck_Highlight") or IsRagdoll(model) then return end
    local hrp = model:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local hl = Instance.new("Highlight")
    hl.Name = "Ck_Highlight"; hl.Adornee = model
    hl.FillColor = color; hl.OutlineColor = color
    hl.FillTransparency = isKiller and ESP.killerFill or ESP.survivorFill
    hl.OutlineTransparency = isKiller and ESP.killerOutline or ESP.survivorOutline
    hl.Parent = model
    local bb = Instance.new("BillboardGui")
    bb.Name = "Ck_Billboard"; bb.Adornee = hrp
    bb.Size = UDim2.new(0, 120, 0, 50); bb.StudsOffset = Vector3.new(0, 4, 0); bb.AlwaysOnTop = true; bb.Parent = model
    local nl = Instance.new("TextLabel")
    nl.Size = UDim2.new(1, 0, 0.4, 0); nl.BackgroundTransparency = 1
    nl.Font = Enum.Font.GothamMedium; nl.TextColor3 = color; nl.TextSize = 8; nl.TextStrokeTransparency = 0.6; nl.Parent = bb
    local hp = Instance.new("TextLabel")
    hp.Size = UDim2.new(1, 0, 0.4, 0); hp.Position = UDim2.new(0, 0, 0.4, 0)
    hp.BackgroundTransparency = 1; hp.Font = Enum.Font.GothamMedium
    hp.TextColor3 = color; hp.TextSize = 8; hp.TextStrokeTransparency = 0.6; hp.Parent = bb
    local data = { model = model, nameLabel = nl, hpLabel = hp, isKiller = isKiller, highlight = hl }
    table.insert(PlayerESPData, data); ApplyText(data)
    model:GetAttributeChangedSignal("ActorDisplayName"):Connect(function() ApplyText(data) end)
    model:GetAttributeChangedSignal("SkinNameDisplay"):Connect(function() ApplyText(data) end)
    local h = model:FindFirstChild("Humanoid")
    if h then
        h:GetPropertyChangedSignal("Health"):Connect(function() ApplyText(data) end)
        h:GetPropertyChangedSignal("MaxHealth"):Connect(function() ApplyText(data) end)
    end
end
local function RemovePlayerESP(model)
    for i = #PlayerESPData, 1, -1 do if PlayerESPData[i].model == model then table.remove(PlayerESPData, i) end end
    pcall(function()
        if model:FindFirstChild("Ck_Highlight") then model.Ck_Highlight:Destroy() end
        if model:FindFirstChild("Ck_Billboard") then model.Ck_Billboard:Destroy() end
    end)
end
local function CreateObjESP(model, color, text)
    if not model or model:FindFirstChild("Ck_ObjESP") or IsRagdoll(model) then return end
    local tp = model:IsA("Model") and (GetGenPart(model) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)) or model
    if not tp then return end
    local hl = Instance.new("Highlight")
    hl.Name = "Ck_ObjESP"; hl.Adornee = model
    hl.FillColor = color; hl.OutlineColor = color
    hl.FillTransparency = 0.7; hl.OutlineTransparency = 0.3; hl.Parent = model
    local bb = Instance.new("BillboardGui")
    bb.Name = "Ck_ObjBB"; bb.Adornee = tp
    bb.Size = UDim2.new(0, 120, 0, 50); bb.StudsOffset = Vector3.new(0, 4, 0); bb.AlwaysOnTop = true; bb.Parent = model
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1
    tl.Text = text or model.Name
    tl.Font = Enum.Font.GothamMedium; tl.TextColor3 = color; tl.TextSize = 8; tl.TextStrokeTransparency = 0.6; tl.Parent = bb
    table.insert(ObjectESPData, model)
end
local function RemoveObjESP(model)
    for i = #ObjectESPData, 1, -1 do if ObjectESPData[i] == model then table.remove(ObjectESPData, i) end end
    pcall(function()
        if model:FindFirstChild("Ck_ObjESP") then model.Ck_ObjESP:Destroy() end
        if model:FindFirstChild("Ck_ObjBB") then model.Ck_ObjBB:Destroy() end
    end)
end
local function UpdateESP()
    local pf = Workspace:FindFirstChild("Players")
    if pf then
        local kf, sf = pf:FindFirstChild("Killers"), pf:FindFirstChild("Survivors")
        if kf then for _, k in ipairs(kf:GetChildren()) do
            if k == LP.Character then continue end
            if IsRagdoll(k) then RemovePlayerESP(k); continue end
            local p = Players:GetPlayerFromCharacter(k)
            if not p or IsSpectating(p) then RemovePlayerESP(k); continue end
            if ESP.killerESP then
                if not k:FindFirstChild("Ck_Highlight") then CreatePlayerESP(k, ESP.killerColor, true) end
            else RemovePlayerESP(k) end
        end end
        if sf then for _, s in ipairs(sf:GetChildren()) do
            if s == LP.Character then continue end
            if IsRagdoll(s) then RemovePlayerESP(s); continue end
            local p = Players:GetPlayerFromCharacter(s)
            if not p or IsSpectating(p) then RemovePlayerESP(s); continue end
            if ESP.survivorESP then
                if not s:FindFirstChild("Ck_Highlight") then CreatePlayerESP(s, ESP.survivorColor, false) end
            else RemovePlayerESP(s) end
        end end
    end
    local MapFolder = GetMapFolder()
    if not MapFolder then return end
    if MapFolder:FindFirstChild("Map") then
        for _, g in ipairs(MapFolder.Map:GetChildren()) do
            if g:IsA("Model") and g.Name:lower():find("generator") and g.Name ~= "FakeGenerator" then
                local pr = g:FindFirstChild("Progress")
                if ESP.genESP and pr and pr.Value < 100 and not g:FindFirstChild("Ck_ObjESP") then
                    CreateObjESP(g, ESP.genColor, g.Name)
                elseif not ESP.genESP or (pr and pr.Value >= 100) then RemoveObjESP(g) end
            end
        end
        for _, it in ipairs(MapFolder.Map:GetDescendants()) do
            if it.Name == "ItemRoot" and it.Parent and it.Parent:IsA("Model") then
                if ESP.itemESP and not it.Parent:FindFirstChild("Ck_ObjESP") then
                    CreateObjESP(it.Parent, ESP.itemColor, it.Parent.Name)
                elseif not ESP.itemESP then RemoveObjESP(it.Parent) end
            end
        end
    end
    for _, o in ipairs(MapFolder:GetChildren()) do
        if o.Name == "Pizza" and o:IsA("BasePart") then
            if ESP.pizzaESP and not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.pizzaColor, "Pizza")
            elseif not ESP.pizzaESP then RemoveObjESP(o) end
        end
        if o:IsA("Model") and table.find(DummyNames, o.Name) then
            if ESP.deliveryESP and not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.deliveryColor, o.Name)
            elseif not ESP.deliveryESP then RemoveObjESP(o) end
        end
        if o.Name == "1x1x1x1Zombie" and o:IsA("Model") then
            if ESP.zombieESP and not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.zombieColor, "Zombie")
            elseif not ESP.zombieESP then RemoveObjESP(o) end
        end
        if o.Name:match("TaphTripwire$") and o:IsA("Model") then
            if ESP.tripwireESP and not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.tripwireColor, "Tripwire")
            elseif not ESP.tripwireESP then RemoveObjESP(o) end
        end
        if o.Name == "SubspaceTripmine" and o:IsA("Model") then
            if ESP.mineESP and not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.mineColor, "Mine")
            elseif not ESP.mineESP then RemoveObjESP(o) end
        end
        if o.Name == "GraffitiCL" and o:IsA("BasePart") then
            if ESP.graffitiESP and not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.graffitiColor, "Graffiti")
            elseif not ESP.graffitiESP then RemoveObjESP(o) end
        end
    end
    for _, o in ipairs(MapFolder:GetDescendants()) do
        if o and o.Name and tostring(o.Name):lower():find("respawnlocation") then
            local t = o:IsA("Model") and o or o:IsA("BasePart") and o or (o:FindFirstAncestorOfClass("Model") or o)
            if not t or IsRagdoll(t) then continue end
            if ESP.respawnESP and not t:FindFirstChild("Ck_ObjESP") then CreateObjESP(t, ESP.respawnColor, "Respawn")
            elseif not ESP.respawnESP then RemoveObjESP(t) end
        end
        if o:IsA("Model") then
            local n = o.Name:lower()
            if n == "groundbulbmodel" then
                if ESP.bulbESP then if not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.bulbColor, "GroundBulb") end
                else RemoveObjESP(o) end
            elseif n == "vinemodel" then
                if ESP.vineESP then if not o:FindFirstChild("Ck_ObjESP") then CreateObjESP(o, ESP.vineColor, "Vine") end
                else RemoveObjESP(o) end
            end
        end
    end
end
