local function FC_IsTruthyBlockValue(v)
    if v == true or v == 1 then return true end
    if type(v) == "string" then
        local l = v:lower()
        return l == "true" or l == "active" or l == "blocking" or l == "1"
    end
    return false
end

local function FC_IsGuestBlocking()
    if Settings.AB_Mode ~= "Guest1337" then return false end
    if Settings.FC_GuestBlockManual then return true end
    if not Settings.FC_GuestBlockAuto then return false end
    local now = os.clock()
    if now <= (FCState.guestBlockUntil or 0) then return true end
    if now - FCState.guestBlockCheckedAt < 0.08 then return FCState.guestBlockCache end
    FCState.guestBlockCheckedAt = now
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char then FCState.guestBlockCache = false; return false end
    for _, inst in ipairs({char, hum, LocalPlayer}) do
        if inst then
            for key, value in pairs(inst:GetAttributes()) do
                local lowerKey = tostring(key):lower()
                if lowerKey:find("block", 1, true) and FC_IsTruthyBlockValue(value) then
                    FCState.guestBlockCache = true
                    return true
                end
                if (lowerKey:find("ability", 1, true) or lowerKey:find("action", 1, true))
                    and type(value) == "string" and value:lower():find("block", 1, true) then
                    FCState.guestBlockCache = true
                    return true
                end
            end
        end
    end
    for _, obj in ipairs(char:GetDescendants()) do
        local key = obj.Name:lower()
        if key:find("block", 1, true) then
            if obj:IsA("BoolValue") and obj.Value then
                FCState.guestBlockCache = true
                return true
            elseif obj:IsA("StringValue") and FC_IsTruthyBlockValue(obj.Value) then
                FCState.guestBlockCache = true
                return true
            end
        end
    end
    if hum then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            local anim = track.Animation
            local n = ((track.Name or "") .. " " .. (anim and anim.Name or "")):lower()
            if n:find("block", 1, true) and track.IsPlaying then
                FCState.guestBlockCache = true
                return true
            end
        end
    end
    FCState.guestBlockCache = false
    return false
end

local function FC_UpdateTracking(dt)
    local char = LocalPlayer.Character
    local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
    if playerRoot then FCState.player = playerRoot.Position end
    local kf = GetKillersFolder()
    if not kf then return end
    local alpha = 1 - math.exp(-math.max(dt, 0.001) / math.max(Settings.FC_FollowSmoothing, 0.001))
    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") then
            local root = killer:FindFirstChild("HumanoidRootPart")
            if root then
                local st = FCState.killers[killer]
                local look = root.CFrame.LookVector
                if not st then
                    st = { pos=root.Position, look=look, turnRate=0, facingDot=-1, lastFacingDot=-1 }
                    FCState.killers[killer] = st
                else
                    st.pos = st.pos:Lerp(root.Position, alpha)
                    local oldLook = st.look
                    st.look = oldLook:Lerp(look, alpha)
                    if st.look.Magnitude > 0.001 then st.look = st.look.Unit else st.look = look end
                    local a = Vector3.new(oldLook.X, 0, oldLook.Z)
                    local b = Vector3.new(st.look.X, 0, st.look.Z)
                    if a.Magnitude > 0.001 and b.Magnitude > 0.001 then
                        local angle = math.acos(math.clamp(a.Unit:Dot(b.Unit), -1, 1))
                        st.turnRate = angle / math.max(dt, 0.001)
                    end
                end
                if FCState.player then
                    local toPlayer = FCState.player - st.pos
                    local f = Vector3.new(st.look.X, 0, st.look.Z)
                    local t = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                    if f.Magnitude > 0.001 and t.Magnitude > 0.001 then
                        st.lastFacingDot = st.facingDot
                        st.facingDot = f.Unit:Dot(t.Unit)
                    end
                end
            else
                FCState.killers[killer] = nil
            end
        end
    end
    for killer in pairs(FCState.killers) do
        if not killer.Parent then FCState.killers[killer] = nil end
    end
end

local function FC_GetPlayerWidthBonus()
    return FC_IsGuestBlocking() and Settings.FC_GuestBlockBonus or 0
end

local function FC_ShouldBlock(killer)
    if not Settings.FC_Enabled then return false end
    local st = FCState.killers[killer]
    local playerPos = FCState.player
    if not st or not playerPos then return false end
    local delta = playerPos - st.pos
    local horizontal = Vector3.new(delta.X, 0, delta.Z)
    local distance = horizontal.Magnitude
    if distance < 0.5 then return false end
    local forward = Vector3.new(st.look.X, 0, st.look.Z)
    if forward.Magnitude < 0.001 then return false end
    forward = forward.Unit
    local direction = horizontal.Unit
    local facingDot = forward:Dot(direction)
    local root = killer:FindFirstChild("HumanoidRootPart")
    local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
    local reach = FC_GetReach(killer, speed) + Settings.FC_LatencyBuffer
    local along = horizontal:Dot(forward)
    local side = (horizontal - forward * along).Magnitude
    local halfWidth = Settings.FC_Width * 0.5 + FC_GetPlayerWidthBonus()

    if distance > Settings.FC_Range or along < -1 or along > reach then return false end
    if side > halfWidth then return false end
    if facingDot < Settings.FC_FacingDot then
        if not (Settings.FC_AntiBait and st.turnRate > Settings.FC_TurnRate and facingDot >= 0.15 and along > 0 and along <= reach) then
            return false
        end
    end
    if root and speed >= Settings.FC_FastThreshold then
        local velocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
        if velocity.Magnitude > 0.5 and velocity.Unit:Dot(direction) < Settings.FC_FastDot then
            return false
        end
    end
    return true
end

local function FC_CreateVisual(killer)
    local existing = FCState.visuals[killer]
    if existing and existing[1] and existing[1].Parent then return existing end
    local parts = {}
    local folder = FC_GetFolder()
    for i = 1, 3 do
        local part = Instance.new("Part")
        part.Name = "FacingRadarZone" .. i
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Transparency = 0.58
        part.Size = Vector3.new(Settings.FC_Width, 0.08, 1)
        part.Parent = folder
        parts[i] = part
    end
    FCState.visuals[killer] = parts
    return parts
end

local function FC_HideVisual(parts)
    for _, part in ipairs(parts or {}) do
        if part and part.Parent then part.Transparency = 1 end
    end
end

local function FC_Render()
    if not Settings.FC_Visualize then
        for _, parts in pairs(FCState.visuals) do FC_HideVisual(parts) end
        return
    end
    for killer, st in pairs(FCState.killers) do
        if not killer.Parent then
            local parts = FCState.visuals[killer]
            if parts then for _, p in ipairs(parts) do if p then p:Destroy() end end end
            FCState.visuals[killer] = nil
        else
            local root = killer:FindFirstChild("HumanoidRootPart")
            if root then
                local parts = FC_CreateVisual(killer)
                local speed = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
                local reach = FC_GetReach(killer, speed)
                local width = Settings.FC_Width + FC_GetPlayerWidthBonus() * 2
                local segment = reach / 3
                local colors = {GREEN, YELLOW, RED}
                for i, part in ipairs(parts) do
                    local startDist = (i - 1) * segment
                    local center = st.pos + st.look * (startDist + segment / 2)
                    center = Vector3.new(center.X, root.Position.Y - 2.5, center.Z)
                    part.Size = Vector3.new(width, 0.08, math.max(segment, 0.1))
                    part.CFrame = CFrame.lookAt(center, center + st.look)
                    part.Color = colors[i]
                    part.Transparency = 0.58
                end
            end
        end
    end
end

local function FC_RenderStep(dt)
    FC_UpdateTracking(dt or 0.016)
    FC_Render()
end

