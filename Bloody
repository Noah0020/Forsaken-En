                        if S.Generator and n=="Generator" then col=Color3.fromRGB(255,220,40)
                        elseif S.Medkit and n=="Medkit" then col=Color3.fromRGB(255,105,180)
                        elseif S.Bloxy and n=="BloxyCola" then col=Color3.fromRGB(80,180,255) end
                        if col then
                            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                            if part and (part.Position-my.Position).Magnitude <= S.MaxDist then
                                seen[obj]=true; applyHL(obj, col)
                            end
                        end
                    end
                end
            end
            for m in pairs(HL) do if not seen[m] then clearAll(m) end end
            for m in pairs(tags) do if not seen[m] then clearAll(m) end end
            for m in pairs(BB) do if not seen[m] then clearAll(m) end end
        end
    end)

    local left = Tabs.ESP:AddLeftGroupbox("Highlights", "eye")
