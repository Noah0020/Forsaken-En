local function createBlockBox(killerChar)
    if IsPlayerKiller() or not killerChar or killerChar==LP.Character then return end
    local root = killerChar:FindFirstChild("HumanoidRootPart"); if not root then return end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killerChar}
    task.spawn(function()
        local elapsed = 0
        while killerChar.Parent and root.Parent and elapsed < BlockCfg.duration do
            if IsPlayerKiller() then return end
            local Part = Instance.new("Part")
            Part.Transparency = BlockCfg.show and BlockCfg.transparency or 1
            Part.CanCollide=false; Part.Anchored=true; Part.Size=Vector3.new(BlockCfg.width,BlockCfg.height,BlockCfg.length)
            Part.Color=BlockCfg.color; Part.Material=Enum.Material.ForceField
            Part.CFrame = root.CFrame * CFrame.new(0,0,BlockCfg.offset)
            Part.Parent = Workspace
            Debris:AddItem(Part, 0.05)
            for _,v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                local hum = v.Parent and v.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health>0 and Players:GetPlayerFromCharacter(hum.Parent)==LP then
