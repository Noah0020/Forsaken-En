        table.insert(PlayerESPData, data)
        local function refresh()
            if not model.Parent then return end
            local actor = model:GetAttribute("ActorDisplayName") or model.Name
            local skin = model:GetAttribute("SkinNameDisplay")
            local showName = data.isKiller and S.killerName or S.survivorName
            local showSkin = data.isKiller and S.killerSkin or S.survivorSkin
            local txt = actor
            if showSkin and skin and tostring(skin) ~= "" then txt = txt .. " | " .. skin end
            nameLabel.Text = showName and txt or ""
            nameLabel.Visible = showName
            local showHp = data.isKiller and S.killerHealth or S.survivorHealth
            if hum then
                hpLabel.Text = string.format("%d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
            end
            hpLabel.Visible = showHp
            hl.Enabled = data.isKiller and S.killerESP or S.survivorESP
        end
        refresh()
        pcall(function()
            model:GetAttributeChangedSignal("ActorDisplayName"):Connect(refresh)
            model:GetAttributeChangedSignal("SkinNameDisplay"):Connect(refresh)
            hum:GetPropertyChangedSignal("Health"):Connect(refresh)
        end)
    end

    local function createGenESP(model)
        if not model or model:FindFirstChild("Nos_HL") then return end
        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end
        local hl = Instance.new("Highlight")
        hl.Name = "Nos_HL"
        hl.Adornee = model
        hl.FillColor = S.generatorColor
        hl.OutlineColor = S.generatorColor
        hl.FillTransparency = 0.7
        hl.Parent = model
        local bb = Instance.new("BillboardGui")
