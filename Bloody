-- These are SPECIAL ABILITIES, not M1s. Skip the box for these.
local SKIP_ABILITY_PATTERNS = {
    -- Silent Aim abilities (killer specials)
    "corrupt", "nature", "nova", "void", "demonic", "infernal", "pursuit",
    "ascension", "cataclysm", "plasma", "crystal", "pitch",
    -- Normal Aim abilities (special attacks)
    "dagger", "axe", "hatchet",
    "shoot", "oneshot", "gun", "flintlock", "sixshot", "sixshooter",
    -- Defensive / utility
    "block", "parry", "dodge",
}

local function GetKillerAbilityName(killer)
    for _, attr in ipairs({"AbilityName", "LastAbility", "CurrentAbility", "AbilityUsed", "Ability", "LastAbilityName"}) do
        local ok, v = pcall(function() return killer:GetAttribute(attr) end)
        if ok and type(v) == "string" and v ~= "" then return v end
    end
    return nil
end

local function NameMatchesSkipList(name)
    local l = name:lower()
    for _, p in ipairs(SKIP_ABILITY_PATTERNS) do
        if l:find(p, 1, true) then return p end
    end
    return nil
end

local function KillerIsM1(killer)
    if not Settings.FacingM1Only then return true end
    local name = GetKillerAbilityName(killer)
    if name then
        local matched = NameMatchesSkipList(name)
        if matched then
            if Settings.FacingDebugLog then
                print(("[Cr4zy Box] SKIP ability '%s' (matched '%s')"):format(name, matched))
            end
            return false
        end
        if Settings.FacingDebugLog then
            print(("[Cr4zy Box] SHOW — M1 '%s'"):format(name))
        end
        return true
    end
    -- No name found → check animations for known ability animations
    local hum = killer:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if anim then
        for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
            local aid = track.Animation and track.Animation.AnimationId
            if aid and (AntiBaitAnims[aid] or HDT_Anims[aid]) then
                if Settings.FacingDebugLog then
                    print("[Cr4zy Box] SKIP — ability animation detected")
                end
                return false
            end
        end
    end
    if Settings.FacingDebugLog then
        print("[Cr4zy Box] SHOW — no name, no ability animation (assume M1)")
    end
    return true
end

--═══ FACING BOX SYSTEM ═══
local FacingBox = {
    folder = nil, killerParts = {}, playerParts = {},
    activeKiller = nil, activeUntil = 0, generation = 0,
    lastLook = nil, expansion = 0,
}

local function FB_EnsureFolder()
    if FacingBox.folder and FacingBox.folder.Parent then return FacingBox.folder end
    local f = Instance.new("Folder")
    f.Name = "FacingCheckVisuals"
    f.Parent = Workspace
    FacingBox.folder = f
    return f
end

local function FB_ClearParts(parts)
    for _, p in ipairs(parts) do
        if p and p.Parent then pcall(function() p:Destroy() end) end
    end
    table.clear(parts)
end

local function FB_AddLine(parts, color, a, b)
    local delta = b - a
    local distance = delta.Magnitude
    if distance < 0.001 then return end
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = Settings.FacingTransparency
    part.Size = Vector3.new(Settings.FacingLineThickness, Settings.FacingLineThickness, distance)
    part.CFrame = CFrame.lookAt((a + b) / 2, b)
    part.Parent = FB_EnsureFolder()
    table.insert(parts, part)
end

-- OUTLINE ONLY: 8 corners, 12 edges. No internal grid.
local function FB_DrawBox(parts, cf, size, color)
    FB_ClearParts(parts)
    local hx, hy, hz = size.X/2, size.Y/2, size.Z/2
    local function point(x, y, z) return cf:PointToWorldSpace(Vector3.new(x, y, z)) end

    local c1 = point(-hx, -hy, -hz)
    local c2 = point( hx, -hy, -hz)
    local c3 = point( hx, -hy,  hz)
    local c4 = point(-hx, -hy,  hz)
    local c5 = point(-hx,  hy, -hz)
    local c6 = point( hx,  hy, -hz)
    local c7 = point( hx,  hy,  hz)
    local c8 = point(-hx,  hy,  hz)

    -- Bottom face (4 edges)
    FB_AddLine(parts, color, c1, c2)
    FB_AddLine(parts, color, c2, c3)
    FB_AddLine(parts, color, c3, c4)
    FB_AddLine(parts, color, c4, c1)
    -- Top face (4 edges)
    FB_AddLine(parts, color, c5, c6)
    FB_AddLine(parts, color, c6, c7)
    FB_AddLine(parts, color, c7, c8)
    FB_AddLine(parts, color, c8, c5)
    -- Verticals (4 edges)
    FB_AddLine(parts, color, c1, c5)
    FB_AddLine(parts, color, c2, c6)
    FB_AddLine(parts, color, c3, c7)
    FB_AddLine(parts, color, c4, c8)
end

local function FB_IsPlayerInBox(killerRoot, playerRoot)
    if not killerRoot or not playerRoot then return false end
    local localPos = killerRoot.CFrame:PointToObjectSpace(playerRoot.Position)
    local halfWidth = Settings.FacingWidth / 2
    local length = Settings.FacingLength
    return math.abs(localPos.X) <= halfWidth + 0.5
       and localPos.Z <= 0.5
       and localPos.Z >= -length - 0.5
end

local function FB_Show(killer)
    if not Settings.FacingEnabled then return end
    if not killer or not killer.Parent then return end
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return end

    FacingBox.activeKiller = killer
    FacingBox.activeUntil = os.clock() + Settings.FacingDuration
    FacingBox.generation = FacingBox.generation + 1
    FacingBox.lastLook = killerRoot.CFrame.LookVector
    local myGen = FacingBox.generation

    task.spawn(function()
        local lastDraw = 0
        while FacingBox.generation == myGen and os.clock() < FacingBox.activeUntil do
            if not killerRoot.Parent then break end
            local now = os.clock()
            if now - lastDraw >= 0.05 then
                lastDraw = now
                local expansion = 0
                if Settings.FacingTurnExpansion then
                    local curLook = killerRoot.CFrame.LookVector
                    if FacingBox.lastLook then
                        local dot = math.clamp(FacingBox.lastLook:Dot(curLook), -1, 1)
                        local angle = math.deg(math.acos(dot))
                        if angle >= Settings.FacingTurnThreshold then
                            FacingBox.expansion = Settings.FacingTurnExpansionValue
                        else
                            FacingBox.expansion = math.max(0, FacingBox.expansion - Settings.FacingTurnSensitivity)
                        end
                    end
                    FacingBox.lastLook = curLook
                    expansion = FacingBox.expansion
                end
                local size = Vector3.new(
                    Settings.FacingWidth + expansion,
                    Settings.FacingHeight,
                    Settings.FacingLength
                )
                local cf = killerRoot.CFrame * CFrame.new(0, 0, -Settings.FacingLength / 2)
                FB_DrawBox(FacingBox.killerParts, cf, size, Settings.FacingColor)

                if Settings.FacingShowPlayer then
                    local char = LocalPlayer.Character
                    if char then
                        local pcf, psize = char:GetBoundingBox()
                        FB_DrawBox(FacingBox.playerParts, pcf, psize, Settings.FacingPlayerColor)
                    end
                end
            end
            RunService.Heartbeat:Wait()
        end
        if FacingBox.generation == myGen then
            FB_ClearParts(FacingBox.killerParts)
            FB_ClearParts(FacingBox.playerParts)
        end
    end)
end

local function FB_Stop()
    FacingBox.generation = FacingBox.generation + 1
    FacingBox.activeKiller = nil
    FacingBox.activeUntil = 0
    FB_ClearParts(FacingBox.killerParts)
    FB_ClearParts(FacingBox.playerParts)
end

--═══ AUTO BLOCK ═══
local AB = { running=false, frameConn=nil, perKiller={}, lastBlock=0, BLOCK_COOLDOWN=27, turnRate={} }

local function AB_UpdateTurnRates(dt)
    local kf = GetKillersFolder()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not kf or not myRoot then return end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local st = AB.turnRate[k]
                local toPlayer = myRoot.Position - kr.Position
                local fl = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
                local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
                local dot = 0
                if fl.Magnitude > 0.01 and ft.Magnitude > 0.01 then dot = fl.Unit:Dot(ft.Unit) end
                if not st then
                    AB.turnRate[k] = { dot = dot, lastDot = dot, rate = 0 }
                else
                    st.lastDot = st.dot; st.dot = dot
                    st.rate = (st.dot - st.lastDot) / math.max(dt, 0.001)
                end
            else AB.turnRate[k] = nil end
        end
    end
    for k in pairs(AB.turnRate) do if not k.Parent then AB.turnRate[k] = nil end end
end

function AB_ShouldBlock(killer)
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    local char = LocalPlayer.Character
    local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not killerRoot or not playerRoot then return false end
    local dist = (playerRoot.Position - killerRoot.Position).Magnitude
    if dist > Settings.BoxRange or dist < 0.5 then return false end
    local kv = killerRoot.AssemblyLinearVelocity
    if kv.Magnitude > Settings.BoxFastThreshold then
        local toPlayer = playerRoot.Position - killerRoot.Position
        local fv = Vector3.new(kv.X, 0, kv.Z); local ft = Vector3.new(toPlayer.X, 0, toPlayer.Z)
        if fv.Magnitude > 0.5 and ft.Magnitude > 0.1 and fv.Unit:Dot(ft.Unit) < Settings.BoxFastDot then
            return false
        end
    end
    if FB_IsPlayerInBox(killerRoot, playerRoot) then return true end
    if Settings.BoxAntiBait then
        local st = AB.turnRate[killer]
        if st and st.rate > Settings.BoxTurnRate and st.dot >= 0.15 then return true end
    end
    return false
end

local function AB_IsBlockReady()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(Settings.AB_Mode == "007n7" and "Clone" or "Block")
    if btn then
        local cd = btn:FindFirstChild("CooldownTime")
        if cd then
            local t = cd.Text
            if t == nil or t == "" or t == " " then return true end
            return false
        end
    end
    return (tick() - (AB.lastBlock or 0)) >= (AB.BLOCK_COOLDOWN - 1)
end

local function AB_FireBlock()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    if buffer and buffer.fromstring then
        pcall(function() NetworkEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0"..name) }) end)
    end
    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(name)
    if btn and firesignal then
        local sig = btn:FindFirstChildOfClass("MouseButton1Click")
        if sig then pcall(firesignal, sig) end
    end
end

local function AB_FireSpam()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local count = math.max(1, tonumber(Settings.AB_SpamCount) or 4)
    if buffer and buffer.fromstring then
        local buf = buffer.fromstring("\3\5\0\0\0"..name)
        for _ = 1, count do
            task.spawn(function() pcall(function() NetworkEvent:FireServer("UseActorAbility", {buf}) end) end)
        end
    end
    local dur = tonumber(Settings.AB_SpamDuration) or 0.05
    if dur > 0 then
        task.spawn(function()
            local endT = tick() + dur
            while tick() < endT do
                pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
                task.wait(0.001)
            end
        end)
    end
end

local function AB_Fire() if Settings.AB_SpamEnabled then AB_FireSpam() else AB_FireBlock() end end

function AB_TryFire(killer)
    local st = AB.perKiller[killer]
    if not st or st.pendingUntil <= 0 or tick() > st.pendingUntil then return end
    if not AB_IsBlockReady() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if not AB_ShouldBlock(killer) then return end
    st.pendingUntil = 0; st.lastFireAt = tick(); AB.lastBlock = tick()
    AB_Fire()
end

local function AB_HookKiller(killer)
    if not killer:IsA("Model") or AB.perKiller[killer] then return end
    AB.perKiller[killer] = {
        lastAbility = killer:GetAttribute("AbilityLastUsed") or 0,
        lastUsed = killer:GetAttribute("AbilitiesUsed") or 0,
        baitFlag = false, pendingUntil = 0, lastFireAt = 0,
    }
end
local function AB_UnhookKiller(killer) AB.perKiller[killer] = nil end

local function AB_FrameLoop(dt)
    if not AB.running then return end
    AB_UpdateTurnRates(dt or 0.016)
    local kf = GetKillersFolder(); if not kf then return end
    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            if not AB.perKiller[killer] then AB_HookKiller(killer) end
            local st = AB.perKiller[killer]
            if st and st.pendingUntil > 0 then AB_TryFire(killer) end
        end
    end
    for k in pairs(AB.perKiller) do if not k.Parent then AB_UnhookKiller(k) end end
end

local function AB_Enable()
    if AB.running then return end
    AB.running = true; AB.perKiller = {}; AB.lastBlock = 0; AB.turnRate = {}
    local kf = GetKillersFolder()
    if kf then for _, k in ipairs(kf:GetChildren()) do AB_HookKiller(k) end end
    AB.frameConn = RunService.RenderStepped:Connect(AB_FrameLoop)
end

local function AB_Disable()
    AB.running = false
    if AB.frameConn then pcall(function() AB.frameConn:Disconnect() end); AB.frameConn = nil end
    for k in pairs(AB.perKiller) do AB_UnhookKiller(k) end
    AB.perKiller = {}; AB.turnRate = {}
    FB_Stop()
end

--═══ FACING WATCHER (M1-FILTERED) ═══
local FacingWatchers = {}

local function Facing_Fire(killer)
    if Settings.FacingEnabled then FB_Show(killer) end
    if AB.running then
        if not AB.perKiller[killer] then AB_HookKiller(killer) end
        local st = AB.perKiller[killer]
        if st then
            st.pendingUntil = tick() + Settings.AB_PendingWindow
            AB_TryFire(killer)
        end
    end
end

local function Facing_OnAbilityUsed(killer)
    if not KillerIsM1(killer) then return end
    Facing_Fire(killer)
end

local function Facing_Hook(killer)
    if not killer:IsA("Model") or FacingWatchers[killer] then return end
    local st = { lastAbility = killer:GetAttribute("AbilityLastUsed") or 0 }
    local ok, conn = pcall(function()
        return killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            local aLU = killer:GetAttribute("AbilityLastUsed") or 0
            if aLU <= st.lastAbility then return end
            st.lastAbility = aLU
            Facing_OnAbilityUsed(killer)
        end)
    end)
    if ok and conn then st.conn = conn end
    FacingWatchers[killer] = st
end

local function Facing_Unhook(killer)
    local st = FacingWatchers[killer]
    if st and st.conn then pcall(function() st.conn:Disconnect() end) end
    FacingWatchers[killer] = nil
end

task.spawn(function()
    while true do
        task.wait(1)
        local kf = GetKillersFolder()
        if kf then
            for _, k in ipairs(kf:GetChildren()) do
                if k:IsA("Model") then Facing_Hook(k) end
            end
            for k in pairs(FacingWatchers) do
                if not k.Parent then Facing_Unhook(k) end
            end
        end
    end
end)

