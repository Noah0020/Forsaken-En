local function AddGroupbox(page, title)
    local holder = Create("Frame", {
        Size = UDim2.new(1, -5, 0, 0),
        BackgroundColor3 = Config.Panel, BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, page)
    Corner(holder, 9); Stroke(holder, Color3.fromRGB(60, 40, 48), 0.65)
    Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 11),
        PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11),
    }, holder)
    Create("TextLabel", {
        BackgroundTransparency = 1, Text = title, TextSize = 11,
        TextColor3 = Config.BrightRed, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0,
    }, holder)

    local api = {}
    local order = 0
    local function nextOrd() order = order + 1; return order end

    function api:AddToggle(id, opts)
        opts = opts or {}
        local row = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = Config.Element, BorderSizePixel = 0,
            LayoutOrder = nextOrd(),
        }, holder)
        Corner(row, 7)
        Create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -70, 1, 0),
            Position = UDim2.new(0, 10, 0, 0), Text = opts.Text or id,
            TextColor3 = Config.Text, TextSize = 11,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        local sw = Create("TextButton", {
            Size = UDim2.fromOffset(38, 21), Position = UDim2.new(1, -49, 0.5, -10),
            BackgroundColor3 = Color3.fromRGB(55, 55, 65), Text = "", AutoButtonColor = false,
        }, row)
        Corner(sw, 20)
        local knob = Create("Frame", {
            Size = UDim2.fromOffset(15, 15), Position = UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = Color3.fromRGB(235, 235, 240), BorderSizePixel = 0,
        }, sw)
        Corner(knob, 20)
        local on = opts.Default and true or false
        local function apply(v, fire)
            on = v
            Tween(sw, { BackgroundColor3 = on and Config.Red or Color3.fromRGB(55, 55, 65) }, 0.15)
            Tween(knob, { Position = on and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }, 0.15)
            if fire and opts.Callback then pcall(opts.Callback, on) end
        end
        apply(on, false)
        sw.MouseButton1Click:Connect(function() apply(not on, true) end)
        local widget = {}
        function widget:Set(v) apply(v, false) end
        return widget
    end

    function api:AddButton(id, opts)
        opts = opts or {}
        local b = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Color3.fromRGB(105, 25, 42),
            Text = opts.Text or id, TextColor3 = Config.Text, TextSize = 11,
            Font = Enum.Font.GothamBold, AutoButtonColor = false,
            LayoutOrder = nextOrd(),
        }, holder)
        Corner(b, 7)
        b.MouseEnter:Connect(function() Tween(b, { BackgroundColor3 = Config.Red }, 0.12) end)
        b.MouseLeave:Connect(function() Tween(b, { BackgroundColor3 = Color3.fromRGB(105, 25, 42) }, 0.12) end)
        b.MouseButton1Click:Connect(function()
            if opts.Func then pcall(opts.Func) end
        end)
        return b
    end

    function api:AddSlider(id, opts)
        opts = opts or {}
        local minV, maxV = opts.Min or 0, opts.Max or 100
        local rN = opts.Rounding or 0
        local value = opts.Default or minV
        local function snap(v)
            v = math.clamp(v, minV, maxV)
            if rN > 0 then
                local m = 10 ^ rN
                return math.floor(v * m + 0.5) / m
            end
            return math.floor(v + 0.5)
        end
        value = snap(value)
        local row = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = Config.Element, BorderSizePixel = 0,
            LayoutOrder = nextOrd(),
        }, holder)
        Corner(row, 7)
        local lbl = Create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 18),
            Position = UDim2.new(0, 10, 0, 4),
            Text = (opts.Text or id) .. "  •  " .. tostring(value),
            TextColor3 = Config.Text, TextSize = 11,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        local track = Create("Frame", {
            Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 30),
            BackgroundColor3 = Color3.fromRGB(45, 45, 55), BorderSizePixel = 0,
        }, row)
        Corner(track, 4)
        local fill = Create("Frame", {
            Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0),
            BackgroundColor3 = Config.Red, BorderSizePixel = 0,
        }, track)
        Corner(fill, 4)
        local dragging = false
        local function setFromX(x)
            local w = track.AbsoluteSize.X
            local t = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
            local v = snap(minV + t * (maxV - minV))
            value = v
            fill.Size = UDim2.new((v - minV) / (maxV - minV), 0, 1, 0)
            lbl.Text = (opts.Text or id) .. "  •  " .. tostring(v)
            if opts.Callback then pcall(opts.Callback, v) end
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
               or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true; setFromX(i.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                             or i.UserInputType == Enum.UserInputType.Touch) then
                setFromX(i.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
               or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        local widget = {}
        function widget:Set(v)
            v = snap(v); value = v
            fill.Size = UDim2.new((v - minV) / (maxV - minV), 0, 1, 0)
            lbl.Text = (opts.Text or id) .. "  •  " .. tostring(v)
        end
        return widget
    end

    function api:AddDropdown(id, opts)
        opts = opts or {}
        local values = opts.Values or {}
        local multi = opts.Multi and true or false
        local selected = multi and {} or (opts.Default or values[1])
        if multi and type(opts.Default) == "table" then
            for _, v in ipairs(opts.Default) do selected[v] = true end
        end
        local function selText()
            if multi then
                local t = {}
                for v, on in pairs(selected) do if on then table.insert(t, v) end end
                return #t > 0 and table.concat(t, ", ") or "Select..."
            end
            return selected or "Select..."
        end
        local row = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Config.Element, BorderSizePixel = 0,
            LayoutOrder = nextOrd(),
        }, holder)
        Corner(row, 7)
        local btn = Create("TextButton", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false,
        }, row)
        local lbl = Create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -30, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            Text = (opts.Text or id) .. ": " .. selText(),
            TextColor3 = Config.Text, TextSize = 11,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
        Create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 34),
            Position = UDim2.new(1, -22, 0, 0), Text = "▾",
            TextColor3 = Config.Muted, TextSize = 14,
            Font = Enum.Font.GothamBold,
        }, row)
        local listFrame, outsideConn
        local function close()
            if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
            if listFrame then listFrame:Destroy(); listFrame = nil end
        end
        btn.MouseButton1Click:Connect(function()
            if listFrame then close(); return end
            local absPos, absSz = row.AbsolutePosition, row.AbsoluteSize
            listFrame = Create("Frame", {
                Size = UDim2.fromOffset(absSz.X, #values * 26 + 12),
                Position = UDim2.fromOffset(absPos.X, absPos.Y + absSz.Y + 2),
                BackgroundColor3 = Config.Sidebar, BorderSizePixel = 0, ZIndex = 50,
            }, Screen)
            Corner(listFrame, 8); Stroke(listFrame, Config.Red, 0.4)
            local inner = Create("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            }, listFrame)
            Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, inner)
            Create("UIPadding", {
                PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
            }, inner)
            for i, v in ipairs(values) do
                local isSel = multi and selected[v] or (not multi and selected == v)
                local opt = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundColor3 = isSel and Color3.fromRGB(65, 22, 35) or Config.Sidebar,
                    Text = "  " .. tostring(v),
                    TextColor3 = isSel and Config.BrightRed or Config.Text,
                    TextSize = 11, Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false, LayoutOrder = i, ZIndex = 51,
                }, inner)
                Corner(opt, 5)
                opt.MouseEnter:Connect(function()
                    Tween(opt, { BackgroundColor3 = Color3.fromRGB(45, 25, 35) }, 0.1)
                end)
                opt.MouseLeave:Connect(function()
                    local s = (multi and selected[v]) or (not multi and selected == v)
                    Tween(opt, { BackgroundColor3 = s and Color3.fromRGB(65, 22, 35) or Config.Sidebar }, 0.1)
                end)
                opt.MouseButton1Click:Connect(function()
                    if multi then
                        selected[v] = not selected[v]
                        if opts.Callback then
                            local t = {}
                            for k, on in pairs(selected) do if on then table.insert(t, k) end end
                            pcall(opts.Callback, t)
                        end
                    else
                        selected = v
                        if opts.Callback then pcall(opts.Callback, v) end
                    end
                    lbl.Text = (opts.Text or id) .. ": " .. selText()
                    close()
                end)
            end
            task.delay(0.05, function()
                if not listFrame then return end
                outsideConn = UserInputService.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                       or inp.UserInputType == Enum.UserInputType.Touch then
                        local mp = UserInputService:GetMouseLocation()
                        local lp, ls = listFrame.AbsolutePosition, listFrame.AbsoluteSize
                        if not (mp.X >= lp.X and mp.X <= lp.X + ls.X
                                and mp.Y >= lp.Y and mp.Y <= lp.Y + ls.Y) then
                            close()
                        end
                    end
                end)
            end)
        end)
        local widget = {}
        function widget:Set(v)
            if multi and type(v) == "table" then
                selected = {}
                for _, x in ipairs(v) do selected[x] = true end
            else selected = v end
            lbl.Text = (opts.Text or id) .. ": " .. selText()
        end
        return widget
    end

    function api:AddLabel(opts)
        opts = opts or {}
        return Create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Text = opts.Text or "", TextColor3 = Config.Muted, TextSize = 10,
            Font = Enum.Font.Gotham, TextWrapped = opts.DoesWrap ~= false,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = nextOrd(),
        }, holder)
    end

    function api:AddDivider()
        return Create("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = Color3.fromRGB(50, 35, 45), BorderSizePixel = 0,
            LayoutOrder = nextOrd(),
        }, holder)
    end

    return api
end

