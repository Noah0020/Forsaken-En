local E = {
    survivor=false, killer=false, generator=false, item=false,
    minion=false, trap=false, spray=false, quest=false,
    colors = {
        survivor=Color3.fromRGB(0,255,0), killer=Color3.fromRGB(255,0,0),
        generator=Color3.fromRGB(0,0,255), item=Color3.fromRGB(255,234,0),
        minion=Color3.fromRGB(255,122,33), trap=Color3.fromRGB(225,0,255),
        spray=Color3.fromRGB(0,255,255), quest=Color3.fromRGB(255,0,123),
    },
    tracked = {},
}

local function clearOne(inst)
    local t = E.tracked[inst]
    if not t then return end
    pcall(function() if t.hl then t.hl:Destroy() end end)
    pcall(function() if t.bb then t.bb:Destroy() end end)
    E.tracked[inst] = nil
end

local function ensure(inst, kind)
    if not inst or not inst.Parent then return end
    local col = E.colors[kind] or Color3.new(1,1,1)
    local t = E.tracked[inst]
    if not t then
        t = {}
        E.tracked[inst] = t
        local hl = Instance.new("Highlight")
        hl.Name = "__SESP"
        hl.Adornee = inst
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.7
        hl.Parent = inst
        t.hl = hl
        if kind == "killer" or kind == "survivor" then
            local root = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
            if root then
                local bb = Instance.new("BillboardGui")
                bb.Name = "__SBB"
                bb.AlwaysOnTop = true
                bb.Size = UDim2.new(0, 133, 0, 15)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.MaxDistance = 2000
                bb.Adornee = root
                bb.Parent = inst
                local lbl = Instance.new("TextLabel")
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.fromScale(1, 1)
                lbl.Font = Enum.Font.Code
                lbl.TextScaled = true
                lbl.Text = inst.Name
                lbl.TextColor3 = Color3.new(1,1,1)
                lbl.Parent = bb
                Instance.new("UIStroke", lbl).Thickness = 1.25
                t.bb = bb
            end
        end
    end
    if t.hl then t.hl.FillColor = col; t.hl.OutlineColor = col end
end

local function refreshESP()
    local seen = {}
    local pf = Workspace:FindFirstChild("Players")
    local killers = pf and pf:FindFirstChild("Killers")
    local survivors = pf and pf:FindFirstChild("Survivors")
    if E.killer and killers then
        for _, k in ipairs(killers:GetChildren()) do
            if k:IsA("Model") then seen[k]=true; ensure(k,"killer") end
        end
    end
    if E.survivor and survivors then
        for _, s in ipairs(survivors:GetChildren()) do
            if s:IsA("Model") and s ~= LP.Character then seen[s]=true; ensure(s,"survivor") end
        end
    end
    local map = Workspace:FindFirstChild("Map")
    local root = map and (map:FindFirstChild("Ingame") or map) or Workspace
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            if E.generator and obj.Name == "Generator" then seen[obj]=true; ensure(obj,"generator")
            elseif E.item and (obj.Name == "BloxyCola" or obj.Name == "Medkit") then seen[obj]=true; ensure(obj,"item")
            elseif E.minion and (obj.Name == "PizzaDeliveryRig" or obj.Name == "1x1x1x1Zombie") then seen[obj]=true; ensure(obj,"minion")
            elseif E.trap and (obj.Name == "SubspaceTripmine" or string.find(obj.Name,"Tripwire")) then seen[obj]=true; ensure(obj,"trap")
            elseif E.spray and (obj.Name == "GraffitiCL" or string.find(string.lower(obj.Name),"spray")) then seen[obj]=true; ensure(obj,"spray")
            elseif E.quest and string.find(string.lower(obj.Name),"quest") then seen[obj]=true; ensure(obj,"quest")
            end
        end
    end
    for inst in pairs(E.tracked) do
        if not seen[inst] or not inst.Parent then clearOne(inst) end
    end
end

task.spawn(function()
    while true do pcall(refreshESP); task.wait(0.35) end
end)

