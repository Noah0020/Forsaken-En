UtilsTab:Section({ Title = "Generators" })
local t2 = {
    currentGenerator = nil, currentGenerators = {},
    lastGenerator = nil, lastLastGenerator = nil,
    delay = 0, busy = false, resetAfterCompletion = false, disableAfterCompletion = false,
    autogen = false, fixPuzzleCooldown = false,
    getOthersRootPos = function(self)
        local l = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character.PrimaryPart then
                table.insert(l, p.Character.PrimaryPart.Position)
            end
        end
        return l
    end,
    isAnyoneAt = function(self, pos)
        for _, p in ipairs(self:getOthersRootPos()) do if (p - pos).Magnitude <= 1.5 then return true end end
        return false
    end,
    isGeneratorViable = function(self, model)
        local nv = model:FindFirstChildOfClass("NumberValue")
        if not nv or nv.Name ~= "Progress" or nv.Value >= 100 then return false end
        local near = 0
        local pos = model.PrimaryPart and model.PrimaryPart.Position or model:GetPivot().Position
        for _, p in ipairs(self:getOthersRootPos()) do if (p - pos).Magnitude <= 8 then near += 1 end end
        return near < 3
    end,
    getAllGenerators = function(self)
        table.clear(self.currentGenerators)
        if not Character then return self.currentGenerators end
        local m = Ingame:FindFirstChild("Map"); if not m then return self.currentGenerators end
        for _, c in pairs(m:GetChildren()) do
            if c.Name == "Generator" and self:isGeneratorViable(c) then table.insert(self.currentGenerators, c) end
        end
        local pos = Character:GetPivot().Position
        table.sort(self.currentGenerators, function(a, b)
            local ax = a == self.lastGenerator or a == self.lastLastGenerator or a == self.currentGenerator
            local bx = b == self.lastGenerator or b == self.lastLastGenerator or b == self.currentGenerator
            if ax == bx then return (a:GetPivot().Position - pos).Magnitude < (b:GetPivot().Position - pos).Magnitude end
            return not ax
        end)
        return self.currentGenerators
    end
}

local function fixPuzzle()
    if t2.currentGenerator or t2.autogen or t2.fixPuzzleCooldown then return end
    if not PlayerGui or not PlayerGui:FindFirstChild("PuzzleUI") then return end
    xpcall(function()
        if not Ingame:FindFirstChild("Map") or not Character then return end
        local best, dist = nil, math.huge
        for _, g in ipairs(t2:getAllGenerators()) do
            local d = (g:GetPivot().Position - Character:GetPivot().Position).Magnitude
            if d < dist then best, dist = g, d end
        end
        if not best or dist > 8 then Notify(BRAND, "You're not in a generator.", 2); return end
        t2.fixPuzzleCooldown = true
        v66(best:WaitForChild("Remotes", 3).RE)
    end, v13)
    task.delay(1.5, function() t2.fixPuzzleCooldown = false end)
end

local function autoGenLoop()
    task.wait()
    if not t2.autogen then return end
    if t2.busy then return end
    t2.busy = true
    while t2.autogen do
        if not Character then task.wait(); continue end
        if v71() or Character.Parent == Killers then
            Notify(BRAND, "Not a survivor. Waiting...", 3); task.wait(2)
        elseif #t2:getAllGenerators() < 1 then
            Notify(BRAND, "No generators left. Waiting...", 3)
            if t2.resetAfterCompletion and Character and not v71() then
                if Character.PrimaryPart then Character.PrimaryPart.CFrame -= Vector3.new(0, 100, 0); task.wait(0.1) end
                if Character:FindFirstChildOfClass("Humanoid") then Character.Humanoid.Health = 0 end
            end
            if t2.disableAfterCompletion and getgenv().__DoggysakenAutoGenToggle then getgenv().__DoggysakenAutoGenToggle:Set(false) end
            task.wait(2)
        else
            for _, g in ipairs(t2:getAllGenerators()) do
                if not t2.autogen then break end
                if Character and Character.Parent == Killers then
                    if Character:FindFirstChildOfClass("Humanoid") then Character.Humanoid.Health = 0 end
                    break
                end
                if t2:isGeneratorViable(g) then
                    t2.lastLastGenerator = t2.lastGenerator
                    t2.lastGenerator = t2.currentGenerator
                    t2.currentGenerator = g
                    pcall(function()
                        local PrimaryPart = Character.PrimaryPart
                        local CollisionHitbox = Character:FindFirstChild("CollisionHitbox")
                        if not PrimaryPart or not CollisionHitbox then return end
                        local Positions = g:WaitForChild("Positions", 3)
                        local Progress  = g:WaitForChild("Progress", 3)
                        local Remotes   = g:WaitForChild("Remotes", 3)
                        local RF = Remotes:FindFirstChild("RF"); local RE = Remotes:FindFirstChild("RE")
                        if not (Positions and RF and RE) then return end
                        local spots = { Positions:FindFirstChild("Left").Position, Positions:FindFirstChild("Right").Position, Positions:FindFirstChild("Center").Position }
                        local target
                        for _, s in ipairs(spots) do if not t2:isAnyoneAt(s) then target = s; break end end
                        if not target then return end
                        PrimaryPart.CanCollide = false; CollisionHitbox.CanCollide = false
                        PrimaryPart.CFrame = CFrame.new(target); task.wait(0.2)
                        v66(RF, "Enter"); task.wait(0.02); v66(RE); task.wait(0.02); v66(RF, "Leave")
                    end)
                    t2.currentGenerator = nil
                end
            end
            if tonumber(t2.delay) then task.wait(t2.delay) end
            if #t2:getAllGenerators() < 1 then t2.autogen = false end
        end
    end
    t2.busy = false
    t2.lastGenerator, t2.lastLastGenerator, t2.currentGenerator = nil, nil, nil
end

