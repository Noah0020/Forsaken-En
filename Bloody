-- CONE VISUALIZER
--═══════════════════════════════════════════════════════════════════
local ConeState = { folder = nil, lines = {} }
local function Cone_EnsureFolder()
    if ConeState.folder and ConeState.folder.Parent then return ConeState.folder end
    local f = Instance.new("Folder"); f.Name = "Cupcake_ConeVisuals"; f.Parent = Workspace
    ConeState.folder = f; return f
end
local function Cone_CreateLine()
    local p = Instance.new("Part")
    p.Name = "ConeLine"; p.Anchored = true; p.CanCollide = false
    p.CanTouch = false; p.CanQuery = false; p.CastShadow = false
    p.Material = Enum.Material.Neon; p.Color = Settings.ConeColor
    p.Transparency = 1; p.Size = Vector3.new(Settings.ConeThickness, Settings.ConeThickness, 1)
    p.Parent = Cone_EnsureFolder(); return p
end
local function Cone_GetLine(i)
    if not ConeState.lines[i] then ConeState.lines[i] = Cone_CreateLine() end
    return ConeState.lines[i]
end
local function Cone_HideUnused(c)
    for i = c + 1, #ConeState.lines do
        local ln = ConeState.lines[i]
        if ln and ln.Parent then ln.Transparency = 1 end
    end
end
local function Cone_DrawLine(i, a, b)
    local ln = Cone_GetLine(i)
    local mid = (a + b) / 2; local diff = b - a
    local mag = math.max(diff.Magnitude, 0.01)
    ln.Size = Vector3.new(Settings.ConeThickness, Settings.ConeThickness, mag)
    ln.CFrame = CFrame.lookAt(mid, b)
    ln.Color = Settings.ConeColor; ln.Transparency = Settings.ConeTransparency
end
local function Cone_DrawForKiller(kr, startIdx)
    if not kr then return 0 end
    local pos = kr.Position
    local fwd = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
    if fwd.Magnitude < 0.001 then return 0 end
    fwd = fwd.Unit
    local right = Vector3.new(-fwd.Z, 0, fwd.X)
    local groundY = pos.Y - 2.5 + Settings.ConeGroundOffset
    local origin = Vector3.new(pos.X, groundY, pos.Z)
    local halfAngle = math.rad(Settings.ConeAngle / 2)
    local segs = math.max(4, math.floor(Settings.ConeSegments))
    local rings = math.max(1, math.floor(Settings.ConeRings))
    local rad = math.max(1, Settings.ConeRadius)
    local pts = {}
    for i = 0, segs do
        local angle = -halfAngle + (i / segs) * halfAngle * 2
        local dir = fwd * math.cos(angle) + right * math.sin(angle)
        pts[i + 1] = origin + dir * rad
    end
    local idx = startIdx
    for i = 1, segs do idx += 1; Cone_DrawLine(idx, pts[i], pts[i + 1]) end
    for i = 1, segs + 1 do if i % 2 == 1 then idx += 1; Cone_DrawLine(idx, origin, pts[i]) end end
    for ring = 1, rings do
        local dist = rad * ring / (rings + 1)
        for i = 1, segs do
            idx += 1
            Cone_DrawLine(idx, origin:Lerp(pts[i], dist / rad), origin:Lerp(pts[i + 1], dist / rad))
        end
    end
    return idx - startIdx
end
RunService.RenderStepped:Connect(function()
