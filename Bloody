function AttrHeartbeat()
    if not AB.running or KillerState.isKiller then return end
    if not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not AB.KillersFolder or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    local nowW = tick()
    for k, exp in pairs(_killerWindow) do
        if not k or not k.Parent or nowW > exp then _killerWindow[k] = nil
        else
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local shouldFire = false
                if Settings.AutoBlockCustom then
                    local inZone = false; if IsInCustomZone then pcall(function() inZone = IsInCustomZone(k) end) end
                    if inZone then shouldFire = true end
                elseif Settings.AutoBlock then
                    -- Box check drives default mode firing
                    if TriggerRect(k) then shouldFire = true end
                end
                if shouldFire then
                    if FireAbilityByMode(Settings.AutoBlockCustom and true, k) then _killerWindow[k] = nil end
                end
            end
        end
    end
    for _, k in ipairs(AB.KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local alu = k:GetAttribute("AbilityLastUsed") or 0
                local au = k:GetAttribute("AbilitiesUsed") or 0
                local st = AB.attrStates[k]
                if st then
                    local inc = alu > st.lastAbility
                    if au > st.lastUsed then st.isBait = true end
                    if inc then
                        local n = tick()
                        if st.castLockUntil and n < st.castLockUntil then
                            st.lastAbility = alu; st.lastUsed = au
                        else
                            if st.isBait then st.isBait = false
                            else
                                st.castLockUntil = n + 0.1
                                if Settings.AutoBlockCustom then
                                    local inZone = false; if IsInCustomZone then pcall(function() inZone = IsInCustomZone(k) end) end
                                    if inZone then
                                        if n - AB.attrDebounce >= 0.08 then AB.attrDebounce = n; FireAbilityByMode(true, k) end
                                    else _killerWindow[k] = n + (Settings.Duration_Custom or 0.25) end
                                else
                                    -- Box check is the sole facing gate
                                    if TriggerRect(k) then
                                        if n - AB.attrDebounce >= 0.08 then AB.attrDebounce = n; FireAbilityByMode(nil, k) end
                                    else _killerWindow[k] = n + (Settings.Duration_AntiBait or 0.25) end
                                    st.castLockUntil = 0
                                end
                            end
                            st.lastAbility = alu; st.lastUsed = au
                        end
                    else
                        st.lastAbility = alu; st.lastUsed = au
                    end
                else
                    AB.attrStates[k] = { lastAbility=alu, lastUsed=au, isBait=false, castLockUntil=0 }
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not (Settings.AntiSpinBaitEnabled or Settings.FallingDetectionEnabled) then return end
    local kf = GetKillersFolder(); if not kf then return end
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
