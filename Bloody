local function GetNearestKillerModel(maxDist)
    local char = LP.Character
    if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

local function GetNearestSurvivorModel(maxDist)
    local char = LP.Character
    if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local sf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not sf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(sf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

local HDT = { enabled = false, duration = 0.35, speed = 12, delay = 0 }
local function DragToward(killerRoot)
    if not HDT.enabled or not killerRoot then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    task.spawn(function()
        if HDT.delay > 0 then task.wait(HDT.delay) end
        local start = os.clock()
        local dur = HDT.duration
        while os.clock() - start < dur and HDT.enabled and not IsPlayerKiller() do
            local dt = RunService.Heartbeat:Wait()
            if not hrp.Parent or not killerRoot.Parent then break end
            local dir = Vector3.new(killerRoot.Position.X - hrp.Position.X, 0, killerRoot.Position.Z - hrp.Position.Z)
            if dir.Magnitude <= 3 then break end
            local ramp = math.sin(math.pi * (os.clock() - start) / dur)
            hum:Move(dir.Unit, false)
            hrp.CFrame = hrp.CFrame + dir.Unit * HDT.speed * ramp * dt
            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir.Unit)
        end
        if hum then hum:Move(Vector3.zero, false) end
    end)
end

