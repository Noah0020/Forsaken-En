-- AIM (SyncSaken-style Aimbot + per-survivor)
do
    -- SyncSaken t11 aim core
    local AimCore = {
        prediction = 1,
        easing = 0.8,
        lookAngle = 0.5,
        cooldown = false,
    }

    local function PredictNext(part)
        if not part then return Vector3.zero end
        return part.Position + part.AssemblyLinearVelocity * AimCore.prediction
    end

    local function SyncAimbot(targetPart, duration)
        if not targetPart or AimCore.cooldown then return end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        AimCore.cooldown = true
        local t0 = os.clock()
        local conn
        conn = RunService.PostSimulation:Connect(function()
            if os.clock() - t0 >= (duration or 1) or not targetPart or not targetPart.Parent then
                AimCore.cooldown = false
                if conn then conn:Disconnect() end
                return
            end
            if not hrp.Parent then return end
            local pred = PredictNext(targetPart)
            local flat = Vector3.new(pred.X, hrp.Position.Y, pred.Z)
            if (flat - hrp.Position).Magnitude < 0.01 then return end
            local goal = CFrame.lookAt(hrp.Position, flat)
            hrp.CFrame = hrp.CFrame:Lerp(goal, AimCore.easing)
        end)
    end

    getgenv().AimbotValues = {
        Guest1337 = { Enabled = true, Distance = 55, LockDuration = 1.3, Prediction = 0 },
        Shedlekey = { Enabled = true, Distance = 35, LockDuration = 1.2, Prediction = 0 },
        TwoTime = { Enabled = true, Distance = 35, LockDuration = 0.9, Prediction = 0 },
        Chance = { Enabled = true, Distance = 80, LockDuration = 1.5, Prediction = 3 },
        JaneDoe = { Enabled = false, Distance = 50, LockDuration = 1.1, Prediction = 0 },
        Pizza = { Enabled = false, Distance = 50, LockDuration = 1.2, Prediction = 0 },
    }
    getgenv().AnimationData = {
        Guest1337 = {},
        Shedlekey = {},
        TwoTime = {
            ["100725497418533"] = true, ["89448354637442"] = true,
            ["106086955212611"] = true, ["107640065977686"] = true,
        },
        Chance = {}, JaneDoe = {}, Pizza = { ["114155003741146"] = true },
    }

    -- Chance shoot detection (Sync style via ability)
    local ChanceAim = { enabled = true }

    task.spawn(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets") or ReplicatedStorage:WaitForChild("Assets", 10)
        if not assets then return end
        local folders = { assets:FindFirstChild("Survivors") }
        local skins = assets:FindFirstChild("Skins")
        if skins then table.insert(folders, skins:FindFirstChild("Survivors")) end
        for _, folder in ipairs(folders) do
            if folder then
                for _, d in ipairs(folder:GetDescendants()) do
                    if d:IsA("ModuleScript") and d.Name == "Config" then
                        local ok, result = pcall(require, d)
                        if ok and type(result) == "table" and type(result.Animations) == "table" then
                            local a = result.Animations
                            local function add(key, val)
                                if not val then return end
                                local id = tostring(val):match("%d+")
                                if id and getgenv().AnimationData[key] then
                                    getgenv().AnimationData[key][id] = true
                                end
                            end
                            add("Guest1337", a.Punch); add("Guest1337", a.ParryPunch)
                            add("Shedlekey", a.Slash); add("JaneDoe", a.Axe)
                            add("Chance", a.AimGun); add("Chance", a.Shoot)
                        end
                    end
                end
            end
        end
    end)

    getgenv().ActiveLock = { IsActive = false, Target = nil, StartTime = 0, Mode = "", Track = nil }
    getgenv().LastFinishedTrack = nil
    getgenv().GlobalAimbotToggle = false
    getgenv().GlobalAimlockMode = "Character Lock"

    local function startLock(modeKey, track)
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then return end
        local cfg = getgenv().AimbotValues[modeKey]
        if not cfg or not cfg.Enabled then return end
        if getgenv().ActiveLock.IsActive then return end
        if track and track == getgenv().LastFinishedTrack then return end
        local target = GetNearestKiller(cfg.Distance or 50)
        if not target then return end
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
