local function removeESPType(espType)
	local container = ({
		killer    = Killers,
		survivor  = Survivors,
		generator = getIngameMap(),
		item      = workspace,
	})[espType]
	if not container then return end
	for _, desc in pairs(container:GetDescendants()) do
		if espType == "item" then
			if not desc:IsA("Tool") or desc:IsDescendantOf(Players2) then continue end
		elseif desc:IsA("Tool") then
			continue
		end
		local s = desc:FindFirstChild("__SESP", true); if s then s:Destroy() end
		local b = desc:FindFirstChild("__SBB",  true); if b then b:Destroy() end
	end
end

local function setupESP(cfg)
	assert(cfg.container and cfg.addedSignal and cfg.valid and cfg.highlightType)
	local state = { Instances = {}, Connections = {} }

	local function tryAdd(inst)
		if not cfg.valid(inst) then return end
		if not state.Instances[inst] then
			state.Instances[inst] = true
			addESP(inst, cfg.highlightType)
		end
		local conn
		if not cfg.removalSignal then
			conn = inst.Destroying:Connect(function() state.Instances[inst] = nil; conn:Disconnect() end)
		elseif not cfg.removalCheck then
			conn = inst.Destroying:Connect(function() state.Instances[inst] = nil; conn:Disconnect() end)
		elseif cfg.removalSignal == "Changed" then
			conn = inst:FindFirstChildOfClass("NumberValue").Changed:Connect(function(val)
				if cfg.removalCheck(val) then
					local s = inst:FindFirstChild("__SESP", true); if s then s:Destroy() end
					local b = inst:FindFirstChild("__SBB",  true); if b then b:Destroy() end
					state.Instances[inst] = nil; conn:Disconnect()
				end
			end)
		else
			conn = inst[cfg.removalSignal]:Connect(function(...)
				if cfg.removalCheck(...) then
					local s = inst:FindFirstChild("__SESP", true); if s then s:Destroy() end
					local b = inst:FindFirstChild("__SBB",  true); if b then b:Destroy() end
					state.Instances[inst] = nil; conn:Disconnect()
				end
			end)
		end
		state.Connections[inst] = conn
	end

	for _, desc in pairs(cfg.container:GetDescendants()) do
		v6(); task.spawn(tryAdd, desc)
	end
	state.Connections.Added = cfg.container[cfg.addedSignal]:Connect(function(inst)
		v6(); task.spawn(tryAdd, inst)
	end)

	state.Cleanup = function(self)
		if self.Connections.Added then self.Connections.Added:Disconnect(); self.Connections.Added = nil end
		for _, conn in pairs(self.Connections) do
			if typeof(conn) == "RBXScriptConnection" and conn.Connected then conn:Disconnect() end
		end
		for inst in pairs(self.Instances) do
			local s = inst:FindFirstChild("__SESP", true); if s then s:Destroy() end
			local b = inst:FindFirstChild("__SBB",  true); if b then b:Destroy() end
			self.Instances[inst] = nil
		end
		for _, desc in pairs(Ragdolls:GetDescendants()) do
			v6()
			if desc.Name == "__SESP" or desc.Name == "__SBB" then desc:Destroy() end
		end
		table.clear(self.Connections); table.clear(self.Instances)
	end
	return state
end

-- ════════════════════════════════════════════
-- AIMBOT SYSTEM (t11)
-- ════════════════════════════════════════════
local t11
t11 = {
	aimPrediction = 1,
	aimEasing     = 0.8,
	lookAngle     = 0.5,
	aimCooldown   = false,

	GetDistanceFrom = function(self, part)
		if Character and Character.PrimaryPart then
			return (Character.PrimaryPart.Position - part.Position).Magnitude
		end
		return math.huge
	end,

	GetDirectionFrom = function(self, part, fromTarget)
		if Character and Character.PrimaryPart then
			local a = fromTarget and part.Position or Character.PrimaryPart.Position
			local b = fromTarget and Character.PrimaryPart.Position or part.Position
			return (a - b).Unit
		end
		return -1
	end,

	PredictNextPosition = function(self, part)
		return part.Position + part.AssemblyLinearVelocity * self.aimPrediction
	end,

	PartLookingAtUser = function(self, part, fromUser)
		if not Character or not Character.PrimaryPart then return false end
		local dir = self:GetDirectionFrom(part, fromUser)
		return (fromUser and Character.PrimaryPart.CFrame.LookVector or part.CFrame.LookVector):Dot(dir) >= self.lookAngle
	end,

	Aimbot = function(self, part, duration)
		if not Character or not Character.PrimaryPart then return end
		if not part or not duration then return end
		if self.aimCooldown then return end
		self.aimCooldown = true
		local t0 = os.clock()
		local pp = Character.PrimaryPart
		local conn; conn = RunService.PostSimulation:Connect(function()
			if os.clock() - t0 >= duration or not part or not part.Parent then
				self.aimCooldown = false; conn:Disconnect(); return
			end
			local predicted = self:PredictNextPosition(part)
			local flat = vector.create(predicted.X, pp.Position.Y, predicted.Z)
			if pp.Position == flat then return end
			pp.CFrame = pp.CFrame:Lerp(CFrame.lookAt(pp.Position, flat), self.aimEasing)
		end)
	end,
}

