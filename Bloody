if type(StartAutoBlock) ~= "function" then
    function StartAutoBlock()
        if not AB or AB.running then return end
        AB.running = true
        AB.generation = (AB.generation or 0) + 1
        AB.connections = AB.connections or {}
        AB.attrStates = {}
        AB.RemoteEvent = AB.RemoteEvent or AB_RemoteEvent
        local myGeneration = AB.generation

        local function attachCharacter(character)
            if not AB.running or AB.generation ~= myGeneration or not character then return end
            AB.LocalRoot = character:FindFirstChild("HumanoidRootPart")
                or character:WaitForChild("HumanoidRootPart", 5)
            if type(MonitorBlockSuccess) == "function" then
                pcall(MonitorBlockSuccess, character)
            end
        end

        if LocalPlayer.Character then attachCharacter(LocalPlayer.Character) end
        table.insert(AB.connections, LocalPlayer.CharacterAdded:Connect(function(character)
            task.defer(function() attachCharacter(character) end)
        end))

        local playersFolder = Workspace:FindFirstChild("Players")
        AB.KillersFolder = playersFolder and playersFolder:FindFirstChild("Killers")
        if AB.KillersFolder then
            table.insert(AB.connections, AB.KillersFolder.ChildAdded:Connect(function()
                AB.attrStates = AB.attrStates or {}
            end))
        end

        table.insert(AB.connections, RunService.Heartbeat:Connect(function()
            if not AB.running or AB.generation ~= myGeneration then return end
            local currentPlayers = Workspace:FindFirstChild("Players")
            local currentKillers = currentPlayers and currentPlayers:FindFirstChild("Killers")
            if currentKillers ~= AB.KillersFolder then
                AB.KillersFolder = currentKillers
                AB.attrStates = {}
            end
            local character = LocalPlayer.Character
            AB.LocalRoot = character and character:FindFirstChild("HumanoidRootPart") or nil
            if type(AttrHeartbeat) == "function" then pcall(AttrHeartbeat) end
        end))

        if Settings.AutoBlockRectangle then pcall(NS_StartHitboxLoop) end
        if not AB.RemoteEvent then
            warn("[Doggysaken] Block remote was not found. Auto Block cannot send ability requests.")
        end
    end
end

