local ESP = {
    killers=false, survivors=false, generators=false, items=false, janeDoc=false, traps=false, graffiti=false,
    wallCheck=false, maxDist=200, fillT=0.5,
}
local ESP_HL = {}
local ESP_Folder = nil
local function esFolder()
    if ESP_Folder and ESP_Folder.Parent then return ESP_Folder end
    ESP_Folder = Instance.new("Folder"); ESP_Folder.Name="VortexESP"; ESP_Folder.Parent=CoreGui
    return ESP_Folder
end
local function esClear(m)
    local h=ESP_HL[m]; if h then pcall(function() h:Destroy() end); ESP_HL[m]=nil end
end
local function esApply(m, col)
    if not m or not m.Parent then return end
    local h=ESP_HL[m]
    if h and h.Parent and h.Adornee==m then h.FillColor=col; h.OutlineColor=col; return end
    if h then pcall(function() h:Destroy() end) end
    h=Instance.new("Highlight"); h.Adornee=m; h.FillColor=col; h.OutlineColor=col
    h.FillTransparency=ESP.fillT; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent=esFolder(); ESP_HL[m]=h
end
local function esRefresh() for m in pairs(ESP_HL) do esClear(m) end end

task.spawn(function()
    while not _ShuttingDown do
        task.wait(0.4)
        local any = ESP.killers or ESP.survivors or ESP.generators or ESP.items or ESP.janeDoc or ESP.traps or ESP.graffiti
        if not any then if next(ESP_HL) then esRefresh() end
        else
            local seen={}
            local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local pf = Workspace:FindFirstChild("Players")
            if my and pf then
                if ESP.killers then
                    local kf=pf:FindFirstChild("Killers")
                    if kf then for _,k in ipairs(kf:GetChildren()) do
                        local r=k:FindFirstChild("HumanoidRootPart")
                        if r and (r.Position-my.Position).Magnitude<=ESP.maxDist then seen[k]=true; esApply(k, Color3.fromRGB(255,60,60)) end
                    end end
                end
                if ESP.survivors then
                    local sf=pf:FindFirstChild("Survivors")
                    if sf then for _,s in ipairs(sf:GetChildren()) do
                        if s~=LP.Character then
                            local r=s:FindFirstChild("HumanoidRootPart")
                            if r and (r.Position-my.Position).Magnitude<=ESP.maxDist then seen[s]=true; esApply(s, Color3.fromRGB(80,255,120)) end
                        end
                    end end
                end
            end
            if my and (ESP.generators or ESP.items or ESP.janeDoc or ESP.traps or ESP.graffiti) then
                for _,obj in ipairs(Workspace:GetDescendants()) do
                    if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                    local n=obj.Name; local col=nil
                    if ESP.generators and n=="Generator" then col=Color3.fromRGB(255,220,40)
                    elseif ESP.items and (n=="Medkit" or n=="BloxyCola" or n=="Bloxy") then col=Color3.fromRGB(255,120,200)
                    elseif ESP.janeDoc and (n:lower():find("document") or n:lower():find("jane")) then col=Color3.fromRGB(200,150,255)
                    elseif ESP.traps and (n:lower():find("trap") or n:lower():find("minion") or n:lower():find("skeleton")) then col=Color3.fromRGB(255,140,40)
                    elseif ESP.graffiti and (n=="GraffitiCL" or n:lower():find("graffiti")) then col=Color3.fromRGB(255,192,203)
                    end
                    if col then
                        local part=obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part and (part.Position-my.Position).Magnitude<=ESP.maxDist then seen[obj]=true; esApply(obj,col) end
                    end
                end
            end
            for m in pairs(ESP_HL) do if not seen[m] or not m.Parent then esClear(m) end end
        end
    end
end)

