    rangeRingParts={}, facingBox=nil, facingConn=nil,
}
local AM1_Abilities = {"Slash", "Stab", "Tag", "CarvingSlash", "Lacerate", "Perforating"}
local function AM1_Buf(bytes)
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i-1, bytes[i]) end
    return b
end
local AM1_Buffers = {
    Slash        = AM1_Buf({3, 5, 0, 0, 0, 83, 108, 97, 115, 104}),
    Stab         = AM1_Buf({3, 4, 0, 0, 0, 83, 116, 97, 98}),
    Tag          = AM1_Buf({3, 3, 0, 0, 0, 84, 97, 103}),
    CarvingSlash = AM1_Buf({3, 13, 0, 0, 0, 67, 97, 114, 118, 105, 110, 103, 32, 83, 108, 97, 115, 104}),
}
local function AM1_IsGuest(survivor)
    return survivor.Name:gsub("%s+", ""):lower() == "guest1337"
end
local function AM1_InZone(survivor, myRoot)
    local theirRoot = survivor:FindFirstChild("HumanoidRootPart")
    if not theirRoot then return false end
    if Settings.AM1_UseFacing then
        local boxCF = myRoot.CFrame * CFrame.new(0, 0, -Settings.AM1_FacingZ/2)
        local rel = boxCF:PointToObjectSpace(theirRoot.Position)
        return math.abs(rel.X) <= Settings.AM1_FacingX/2
           and math.abs(rel.Y) <= Settings.AM1_FacingY/2
           and math.abs(rel.Z) <= Settings.AM1_FacingZ/2
    end
    local dx = theirRoot.Position.X - myRoot.Position.X
    local dz = theirRoot.Position.Z - myRoot.Position.Z
    return math.sqrt(dx*dx + dz*dz) <= Settings.AM1_Range
end
local function AM1_Trigger(useAll)
    if not NetworkEvent then return end
    local clickCount = Settings.AM1_ExtremeClick and 5 or 1
    if useAll then
        for _, name in ipairs(AM1_Abilities) do
            local ok = false
            if AM1_Buffers[name] then
                pcall(function() NetworkEvent:FireServer("UseActorAbility", { AM1_Buffers[name] }); ok = true end)
            else
                pcall(function() NetworkEvent:FireServer("UseActorAbility", name); ok = true end)
            end
            if not ok or Settings.AM1_ExtremeClick then
                local mainUI = PlayerGui:FindFirstChild("MainUI")
                local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
                local btn = ac and ac:FindFirstChild(name)
                if btn then
                    local target = btn:IsA("GuiButton") and btn or btn:FindFirstChildWhichIsA("GuiButton", true)
                    if target and target.Visible then
                        pcall(function()
                            local pos = target.AbsolutePosition + target.AbsoluteSize/2
                            for i = 1, clickCount do
                                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                                task.wait(0.01)
                                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
                                if clickCount > 1 then task.wait(0.01) end
                            end
                        end)
                    end
                end
            end
        end
    else
        if NetworkEvent then
            for _, name in ipairs(AM1_Abilities) do
                if AM1_Buffers[name] then
                    pcall(function() NetworkEvent:FireServer("UseActorAbility", { AM1_Buffers[name] }) end)
                else
                    pcall(function() NetworkEvent:FireServer("UseActorAbility", name) end)
                end
            end
        end
    end
end
local function AM1_Heartbeat()
    if not AM1.running or AM1.attacking then return end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local sf = GetSurvivorsFolder(); if not sf then return end
    local targetFound, isGuestTarget = false, false
    for _, survivor in ipairs(sf:GetChildren()) do
        if survivor:IsA("Model") and AM1_InZone(survivor, myRoot) then
            targetFound = true
            if AM1_IsGuest(survivor) then isGuestTarget = true end
            break
        end
    end
    if not targetFound then return end
    AM1.attacking = true
    task.spawn(function()
        local totalDelay = (tonumber(Settings.AM1_M1Delay) or 0)
        if isGuestTarget and (tonumber(Settings.AM1_GuestDelay) or 0) > 0 then
            totalDelay = totalDelay + Settings.AM1_GuestDelay
        end
        if totalDelay > 0 then task.wait(totalDelay) end
        if AM1.running then AM1_Trigger(isGuestTarget) end
        task.wait(0.5)
        AM1.attacking = false
    end)
end
local function AM1_DestroyRangeRing()
    for _, obj in ipairs(AM1.rangeRingParts) do if obj and obj.Parent then obj:Destroy() end end
    AM1.rangeRingParts = {}
end
local function AM1_CreateRangeRing()
    AM1_DestroyRangeRing()
    local char = LocalPlayer.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local SEG = 40
    local attachments = {}
    for i = 1, SEG do
        local angle = (i / SEG) * math.pi * 2
        local a = Instance.new("Attachment")
        a.Name = "AM1RingPt"
        a.Position = Vector3.new(math.cos(angle)*Settings.AM1_Range, -(hrp.Size.Y/2)+0.2, math.sin(angle)*Settings.AM1_Range)
        a.Parent = hrp
        table.insert(attachments, a); table.insert(AM1.rangeRingParts, a)
    end
    for i = 1, SEG do
        local nextI = (i % SEG) + 1
        local beam = Instance.new("Beam")
        beam.Attachment0 = attachments[i]; beam.Attachment1 = attachments[nextI]
        beam.Width0, beam.Width1 = 0.3, 0.3
        beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
        beam.Transparency = NumberSequence.new(1 - (Settings.AM1_RangeOpacity or 1))
        beam.FaceCamera = false
        beam.Parent = hrp
        table.insert(AM1.rangeRingParts, beam)
    end
end
