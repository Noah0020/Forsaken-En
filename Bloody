local aim = {aimPrediction=1,aimEasing=0.8,lookAngle=0.5,aimCooldown=false}
function aim:PredictNextPosition(part) return part.Position + part.AssemblyLinearVelocity * aim.aimPrediction end
function aim:GetDistanceFrom(part)
    if Character and Character.PrimaryPart then return (Character.PrimaryPart.Position - part.Position).Magnitude end
    return math.huge end
function aim:GetDirectionFrom(part, inverse)
    if Character and Character.PrimaryPart then return ((inverse and part.Position or Character.PrimaryPart.Position) -
        (inverse and Character.PrimaryPart.Position or part.Position)).Unit end return -1 end
function aim:PartLookingAtUser(part, inverse)
    if not Character or not Character.PrimaryPart then return false end
    local d = ((inverse and part.Position or Character.PrimaryPart.Position) -
        (inverse and Character.PrimaryPart.Position or part.Position)).Unit
    return (inverse and Character.PrimaryPart.CFrame.LookVector or part.CFrame.LookVector):Dot(d) >= aim.lookAngle end
function aim:Aimbot(target, duration)
    if not Character or not Character.PrimaryPart or not target or not duration then return end
    if aim.aimCooldown then return end
    aim.aimCooldown = true
    local t0 = os.clock(); local pp = Character.PrimaryPart
    local conn; conn = RunService.PostSimulation:Connect(function()
        if os.clock()-t0 >= duration or not target or not target.Parent then
            aim.aimCooldown=false; conn:Disconnect(); return end
        local n = aim:PredictNextPosition(target)
        local b = vector.create(n.X, pp.Position.Y, n.Z)
        local c = CFrame.lookAt(pp.Position, b)
        if pp.Position == b then return end
        pp.CFrame = pp.CFrame:Lerp(c, aim.aimEasing) end)
end

