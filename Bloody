local function AttachAnimWatcher(char)
    if NA.animConn then pcall(function() NA.animConn:Disconnect() end); NA.animConn = nil end
    local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
    local an = hum:WaitForChild("Animator", 5); if not an then return end
    NA.animConn = an.AnimationPlayed:Connect(function(track)
        local anim = track.Animation; if not anim then return end
        local aid = tostring(anim.AnimationId):match("%d+"); if not aid then return end
        if STUN_ANIM_IDS[aid] then fireStunAim(track)
        elseif PunchAnims["rbxassetid://"..aid] then firePunchAim(track) end
    end)
end

local function AttachSoundWatcher(char)
    for _, c in ipairs(NA.soundConns) do pcall(function() c:Disconnect() end) end
    NA.soundConns = {}
    local function hook(s)
        if not s:IsA("Sound") then return end
        local c = s.Played:Connect(function()
            if not NA.active then return end
            local sid = tostring(s.SoundId):match("%d+"); if not sid then return end
            if STUN_SOUND_IDS[sid] then
                task.spawn(function()
                    HardLockFacing(NA.lockTime or math.max(0.5, (s.TimeLength or 0.5) + 0.15),
                        NA.mode == "Camera" or NA.mode == "Both", (NA.prediction or 4) * 0.05)
                end)
            end
        end)
        table.insert(NA.soundConns, c)
    end
    for _, d in ipairs(char:GetDescendants()) do hook(d) end
    table.insert(NA.soundConns, char.DescendantAdded:Connect(function(d) hook(d) end))
end

