local Aim = { active=false, startT=0, lastTrig=0, hookDone=false, endT=0 }

local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, s = pcall(function()
            local len = buffer.readu8(arg, 1)
            if len < 1 or len > 64 then return nil end
            local out = ""
            for i=5, 5+len-1 do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out = out .. string.char(b) end
            end
            return out
        end)
        return ok and s or nil
    end
    if t == "table" then return ExtractAbility(arg[1]) end
    return nil
end

local function IsOffensiveAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower()
    if Settings.AIM_OnSlash and l == "slash" then return true end
    if Settings.AIM_OnBlock and (l == "block" or l == "parry" or l == "punch") then return true end
    if Settings.AIM_OnDagger and l:find("dagger", 1, true) then return true end
    if Settings.AIM_OnAxe and (l == "axe" or l == "hatchet") then return true end
    if Settings.AIM_OnShoot then
        if l == "shoot" then return true end
        if l:find("oneshot", 1, true) or l:find("flintlock",1,true) then return true end
        if l:find("sixshot",1,true) or l:find("sixshooter",1,true) then return true end
        if l:find("gun",1,true) or l:find("shot",1,true) then return true end
    end
    return false
end

local function GetLockTime(name)
    local base = Settings.AIM_LockTime
    if type(name) ~= "string" then return base end
    local l = name:lower()
    if l == "shoot" then return math.max(base, 1.15) end
    if l == "slash" then return math.max(base, 0.65) end
    if l:find("dagger", 1, true) then return math.max(base, 0.85) end
    if l == "axe" or l == "hatchet" then return math.max(base, 0.70) end
    return base
end

local function Aim_Trigger(name)
    if not Settings.AIM_Enabled then return end
    local now = tick()
    if now - Aim.lastTrig < 0.1 then return end
    Aim.lastTrig = now
    Aim.active = true; Aim.startT = now; Aim.endT = now + GetLockTime(name)
end

local function Aim_SetupHook()
    if Aim.hookDone or not NetworkEvent or not hookmetamethod then return end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if getnamecallmethod() == "FireServer" and self == NetworkEvent then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsOffensiveAbility(n) then task.spawn(Aim_Trigger, n) end
                end
            end
            return old(self, ...)
        end)
    end)
    if ok then Aim.hookDone = true end
end

RunService.RenderStepped:Connect(function()
    if not Settings.AIM_Enabled then
        if Aim.active then
            Aim.active = false
            local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = true end
        end
        return
    end
    if not Aim.active or tick() > Aim.endT then
        if Aim.active then
            Aim.active = false
            local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = true end
        end
        return
    end
    local kf = GetKillersFolder(); if not kf or not LocalRoot then return end
    local killer, dist = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        if kr then
            local d = (kr.Position - LocalRoot.Position).Magnitude
            if d < dist then dist = d; killer = kr end
        end
    end
    if not killer or dist > Settings.AIM_Range or dist < Settings.AIM_MinDist then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local h = char:FindFirstChildOfClass("Humanoid"); if h then h.AutoRotate = false end

    local predN = math.clamp(Settings.AIM_Prediction, 1, 10)
    local vel = killer.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 50 then vel = vel.Unit * 50 end
    local leadTime = predN * 0.05
    local target = killer.Position + vel * leadTime

    if Settings.AIM_Mode == "Character" or Settings.AIM_Mode == "Both" then
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z))
    end
    if Settings.AIM_Mode == "Camera" or Settings.AIM_Mode == "Both" then
        local cam = Workspace.CurrentCamera
        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target) end
    end
end)

