local function abAttemptSoundBlock(sound, preId)
    if not AB.soundBlockOn then return end
    local id = preId or abExtractSoundId(sound)
    if not id or not AB_TRIGGER_SOUNDS[id] then return end
    local now = tick()
    if now - AB.lastBlockTime < AB.blockCooldown then return end
    if AB.soundBlockedUntil[sound] and now < AB.soundBlockedUntil[sound] then return end
    local root = getHRP(); if not root then return end
    local _, sp = abGetSoundPos(sound); if not sp then return end
    local killer = abGetCharFromDesc(sp); if not killer then return end
    local kPos = abGetKillerPos(killer); if not kPos then return end
    local dSq = (kPos - root.Position).Magnitude ^ 2
    local eff = AB.detectionRange + 0.2 * AB.detectionRange
    if dSq > eff * eff then return end
    local kHRP = killer:FindFirstChild("HumanoidRootPart")
    if not abIsFacing(root, kHRP) then return end
    abDoBlock()
    AB.soundBlockedUntil[sound] = now + 0.5
end
local function abHookSound(sound)
    if not sound or not sound:IsA("Sound") or AB.soundHooks[sound] then return end
    local preId = abExtractSoundId(sound); if not preId then return end
    local pc = sound.Played:Connect(function()
        if not AB.soundBlockOn then return end
        local now = tick()
        if not AB.lastSoundCheck[preId] or (now - AB.lastSoundCheck[preId]) > 0.05 then
            AB.lastSoundCheck[preId] = now
            task.spawn(abAttemptSoundBlock, sound, preId)
        end
    end)
    local pp = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if not AB.soundBlockOn or not sound.IsPlaying then return end
        local now = tick()
        if not AB.lastSoundCheck[preId] or (now - AB.lastSoundCheck[preId]) > 0.05 then
            AB.lastSoundCheck[preId] = now
            task.spawn(abAttemptSoundBlock, sound, preId)
        end
    end)
    local dc; dc = sound.Destroying:Connect(function()
        pcall(function() pc:Disconnect(); pp:Disconnect(); dc:Disconnect() end)
        AB.soundHooks[sound] = nil; AB.soundBlockedUntil[sound] = nil
    end)
    AB.soundHooks[sound] = {pc, pp, dc}
end
