-- FIX C1 + H1: OnKillerM1 with source gate + alive check
--═══════════════════════════════════════════════════════════════════
local function OnKillerM1(killer, source)
    if not killer or not killer.Parent then return end

    -- Box visual always fires regardless of AB/source state
    if Settings.BoxVisualEnabled then
        Box_ShowOnM1(killer)
    end

    if not AB.running then return end

    -- Per-source gate
    if source == "anim"  and not Settings.AB_AnimDetect  then return end
    if source == "sound" and not Settings.AB_SoundDetect then return end
    if source == "attr"  and not Settings.AB_AttrDetect  then return end

    -- Player alive gate
    local myHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return end

    local deadline = tick() + (Settings.AB_PendingWindow or 0.35)

    local function attempt()
        if not AB.running or not killer or not killer.Parent then return end

        if not AB_IsBlockReady() then
            AB_Log("retry", "cooldown")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end

        if not AB_ShouldBlock(killer) then
            AB_Log("retry", "facing/range/velocity")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end

        if not AB.perKiller[killer] then AB.perKiller[killer] = { lastFireAt = 0 } end
        local st = AB.perKiller[killer]
        if tick() - (st.lastFireAt or 0) < 0.05 then
            AB_Log("retry", "fire-debounce")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end

        st.lastFireAt = tick()
        AB_Fire()
        AB_Log("fire", "ok")
    end
    attempt()
end

