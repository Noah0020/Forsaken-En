local gen = { currentGenerator=nil, currentGenerators={}, lastGenerator=nil, lastLastGenerator=nil,
    delay=2, busy=false, resetAfterCompletion=false, autogen=false, autogenToggle=nil,
    getOthersRootPos=function() local t={}; local ps=Players:GetPlayers()
        table.remove(ps,table.find(ps,LP))
        for _,p in pairs(ps) do local pp=p.Character and p.Character.PrimaryPart
            if pp then table.insert(t,pp.Position) end end return t end,
    isAnyoneAt=function(_,pos)
        for _,v in ipairs(gen:getOthersRootPos()) do
            if vector.magnitude(v-pos)<=1.5 then return true end end return false end,
    isGeneratorViable=function(_,g)
        local nv=g:FindFirstChildOfClass("NumberValue")
        if not nv or nv.Name~="Progress" or nv.Value>=100 then return false end
        local pos=g.PrimaryPart and g.PrimaryPart.Position or g:GetPivot().Position
        local n=0; for _,v in ipairs(gen:getOthersRootPos()) do
            if vector.magnitude(v-pos)<=8 then n+=1 end end return n<3 end,
    getAllGenerators=function()
        table.clear(gen.currentGenerators)
        if not Character then return gen.currentGenerators end
        local root = mapRoot(); if not root then return gen.currentGenerators end
        for _,ch in pairs(root:GetChildren()) do
            if ch.Name=="Generator" and gen:isGeneratorViable(ch) then
                table.insert(gen.currentGenerators,ch) end end
        local pos = Character:GetPivot().Position
        table.sort(gen.currentGenerators,function(a,b)
            local pa = a==gen.lastGenerator or a==gen.lastLastGenerator or a==gen.currentGenerator
            local pb = b==gen.lastGenerator or b==gen.lastLastGenerator or b==gen.currentGenerator
            if pa==pb then return vector.magnitude(a:GetPivot().Position-pos)<vector.magnitude(b:GetPivot().Position-pos) end
            return not pa end)
        return gen.currentGenerators end }

local function solvePuzzle()
    if gen.currentGenerator or gen.autogen or gen.fixPuzzleCooldown then return end
    if not PlayerGui or not PlayerGui:FindFirstChild("PuzzleUI") then return end
    xpcall(function()
        if not mapRoot() or not Character then return end
        local target,best = nil,math.huge
        for _,g in pairs(gen:getAllGenerators()) do
            local d = vector.magnitude(g:GetPivot().Position-Character:GetPivot().Position)
            if d<best then best=d; target=g end end
        if not target or best>8 then notify("Dogsaken","Not in a generator.",2); return end
        gen.fixPuzzleCooldown = true
        invoke(target:WaitForChild("Remotes",3).RE)
    end, logError)
    task.delay(1.5,function() gen.fixPuzzleCooldown = false end)
end

local function runGenerator(g)
    if inLobby() then notify("Dogsaken","In lobby — waiting.",2); return end
    task.wait(math.random()/100)
    local pp,col = Character and Character.PrimaryPart, Character and Character:FindFirstChild("CollisionHitbox")
    if not pp or not col then return end
    if pp.Anchored then repeat task.wait() until not pp.Anchored end
    local positions=g:WaitForChild("Positions",3); local progress=g:WaitForChild("Progress",3)
    local remotes=g:WaitForChild("Remotes",3)
    local RF,RE = remotes and remotes:FindFirstChild("RF"), remotes and remotes:FindFirstChild("RE")
    if not (progress and remotes and RF and RE and positions) then return end
    local spots = {positions:FindFirstChild("Left").Position,positions:FindFirstChild("Right").Position,
        positions:FindFirstChild("Center").Position}
    local chosen
    for _,p in ipairs(spots) do if not gen:isAnyoneAt(p) then chosen=p; break end end
    if not chosen then return end
    local c = col.CanCollide
    pp.CanCollide=false; col.CanCollide=false
    pp.CFrame = CFrame.new(chosen+vector.create(math.random()/10,0,math.random()/10))
    task.wait(0.2)
    if progress.Value>=80 then return end
    if not invoke(RF,"Enter") then return false end
    if g==gen.lastGenerator or g==gen.lastLastGenerator then task.wait(0.9) end
    task.wait(0.02); pp.CanCollide=c; col.CanCollide=c
    invoke(RE); task.wait(0.02); invoke(RF,"Leave"); task.wait(0.02)
end

local function autogenWorker()
    task.wait()
    if not gen.autogen then
        if gen.currentGenerator and gen.currentGenerator:FindFirstChild("Remotes") then
            if gen.currentGenerator.Remotes:FindFirstChild("RF") then invoke(gen.currentGenerator.Remotes.RF,"leave") end end
        gen.currentGenerator=nil; gen.currentGenerators={}; gen.lastGenerator=nil; gen.lastLastGenerator=nil
        return
    end
    if gen.busy then return end
    gen.busy = true
    while gen.autogen do
        if not Character then task.wait(); continue end
        if inLobby() or Character.Parent==Killers then
            notify("Dogsaken", inLobby() and "In lobby..." or "You're a killer — waiting...",3)
        elseif #gen:getAllGenerators()<1 then
            notify("Dogsaken","No generators left — waiting...",3)
        else
            while true do
                task.wait()
                xpcall(function()
                    for _,v in ipairs(gen:getAllGenerators()) do
                        if not Killers:GetChildren()[1] then break end
                        if not gen.autogen or inLobby() then
                            gen.currentGenerator=nil; gen.lastGenerator=nil; gen.lastLastGenerator=nil; break end
                        if not Character or Character.Parent~=Killers then
                            if gen:isGeneratorViable(v) then
                                gen.lastLastGenerator=gen.lastGenerator
                                gen.lastGenerator=gen.currentGenerator
                                gen.currentGenerator=v; runGenerator(v) end
                            continue end
                        Character:FindFirstChildOfClass("Humanoid").Health=0
                        break
                    end
                    if tonumber(gen.delay) then task.wait(gen.delay) end
                end, logError)
                if not gen.autogen then break elseif #gen:getAllGenerators()<1 then break end
            end
            gen.lastLastGenerator=nil; gen.currentGenerator=nil; gen.lastGenerator=nil
        end
        gen.busy = false
        if gen:getAllGenerators()[1] then
            while true do task.wait()
                if Character and Character.Parent~=Killers and not inLobby() and gen:getAllGenerators()[1] then break end end
        else
            if gen.resetAfterCompletion and Character and not inLobby() then
                Character.PrimaryPart.CFrame -= vector.create(0,100,0); task.wait(0.1)
                Character.Humanoid.Health=0 end
            if gen.disableAfterCompletion and gen.autogenToggle then gen.autogenToggle:Set(false); break
            else while true do task.wait()
                if Character and Character.Parent~=Killers and not inLobby() and gen:getAllGenerators()[1] then break end end end
        end
    end
end

local loopCtx = { running=false, ended=false, threads=0 }
local function loopPuzzleWorker()
    loopCtx.threads += 1
    while not loopCtx.ended do
        task.wait()
        if loopCtx.running and not loopCtx.ended then
            task.wait(math.random() + tonumber(gen.puzzleLoopCooldown or 3))
            if loopCtx.running and not loopCtx.ended then solvePuzzle() end end
    end
    loopCtx.threads -= 1
end

