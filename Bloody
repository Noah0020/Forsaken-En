local function ParseColor(s, dr, dg, db)
    local r, g, b = string.match(tostring(s or ""), "(%d+),(%d+),(%d+)")
    return Color3.fromRGB(tonumber(r) or dr, tonumber(g) or dg, tonumber(b) or db)
end
local function GetRectColor() return ParseColor(Settings.RectColor, 175, 150, 220) end
local function GetRectSuccessColor()
    if Settings.RectColorSync then return GetRectColor() end
    return ParseColor(Settings.RectSuccessColor, 120, 255, 120)
end

