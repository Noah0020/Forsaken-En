local function encodeAbility(name)
    local b = buffer.create(5 + #name)
    buffer.writeu8(b,0,3); buffer.writeu32(b,1,#name); buffer.writestring(b,5,name); return b
end
local function sendAbility(name) RemoteEvent:FireServer("UseActorAbility",{encodeAbility(name)}) end
local function invoke(remote, ...)
    if not remote then return end
    if remote:IsA("RemoteFunction") then
        local ok,r = pcall(function(...) return remote:InvokeServer(...) end, ...); return ok or r end
    if not remote:IsA("RemoteEvent") then return end
    local ok,r = pcall(function(...) remote:FireServer(...) end, ...); return ok or r
end
local function inLobby() return Character:IsDescendantOf(Spectating) or Character.Parent == workspace end

