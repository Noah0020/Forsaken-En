local function IsVeeronica(char)
    if not char then return false end
    local cname = char:GetAttribute("CharacterName") or char.Name
    return cname == "Veeronica"
end

local function HighlightTargetsChar(h, char)
    if not h or not h.Parent then return false end
    if not h:IsA("Highlight") then return false end
    if not h.Enabled then return false end
    local ad = h.Adornee
    if not ad or not ad.Parent then return false end
    if ad == char then return true end
    if ad:IsDescendantOf(char) then return true end
    return false
end

