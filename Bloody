-- 001 RECTANGLE VISUAL + BOX CHECK (this IS the facing check)
--═══════════════════════════════════════════════════════════════════
local PLAYER_R = 1.5
local Rectangle = { folder=nil, boxes={}, m1FlashUntil={}, loop=nil }

local function GetSuccessColor() return ParseColor(Settings.Rect_SuccessColor, 120, 255, 120) end
local function GetIdleColor() return Color3.fromRGB(255, 0, 0) end

local function EnsureRectFolder()
    if not Rectangle.folder or not Rectangle.folder.Parent then
        local f = Instance.new("Folder"); f.Name = "Cupcake_RectVisuals"; f.Parent = Workspace
        Rectangle.folder = f
    end
    return Rectangle.folder
end
local function GetRectSize()
    return Vector3.new(Settings.Rect_Width, Settings.Rect_Height, Settings.Rect_Length)
end
local function CalcRectCF(kr)
    local p = kr.Position
    local lv = kr.CFrame.LookVector
    local f = Vector3.new(lv.X, 0, lv.Z)
    if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    local d = (Settings.Rect_Distance or 3) + (Settings.Rect_Offset or 0)
    return CFrame.lookAt(p + f*d, p + f*d + f)
end
local function IsInRect(myPos, cf, size)
    local hw = size.X/2 + PLAYER_R
    local hl = size.Z/2 + PLAYER_R
    local hh = size.Y/2 + PLAYER_R
    local lp = cf:PointToObjectSpace(myPos)
    return math.abs(lp.X) <= hw and math.abs(lp.Z) <= hl and math.abs(lp.Y) <= hh
end
local function GetOrCreateBox(k)
    EnsureRectFolder()
    local ex = Rectangle.boxes[k]
    if ex and ex.model and ex.model.Parent then return ex end
    local m = Instance.new("Model"); m.Name = "Cupcake_Rect_"..k.Name; m.Parent = Rectangle.folder
    local T = Settings.Rect_EdgeThickness or 0.05
    local edges = {}
    for i = 1, 12 do
        local e = Instance.new("Part")
        e.Name = "Edge"..i
        e.Anchored = true; e.CanCollide = false; e.CanQuery = false; e.CanTouch = false; e.CastShadow = false
        e.Material = Enum.Material.Neon; e.Color = GetIdleColor(); e.Transparency = 1
        e.Size = Vector3.new(T, T, 1); e.CFrame = CFrame.new(0, -5000, 0)
        e.Parent = m; edges[i] = e
    end
    local box = { model=m, edges=edges, killer=k }
    Rectangle.boxes[k] = box
    return box
end
local function UpdateBoxVisual(k, box)
    local kr = k:FindFirstChild("HumanoidRootPart"); if not kr or not kr.Parent then return end
    local cf = CalcRectCF(kr); local size = GetRectSize()
    local T = Settings.Rect_EdgeThickness or 0.05
    local now = tick()
    local flashUntil = Rectangle.m1FlashUntil[k] or 0
    local color = (now < flashUntil) and GetSuccessColor() or GetIdleColor()
    local L, W, H = size.Z, size.X, size.Y
    local corners = {
        Vector3.new(-W/2,-H/2,-L/2), Vector3.new(W/2,-H/2,-L/2),
        Vector3.new(W/2,-H/2,L/2), Vector3.new(-W/2,-H/2,L/2),
        Vector3.new(-W/2,H/2,-L/2), Vector3.new(W/2,H/2,-L/2),
        Vector3.new(W/2,H/2,L/2), Vector3.new(-W/2,H/2,L/2),
    }
    local pairs_ = { {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8} }
    for i, pr in ipairs(pairs_) do
        local e = box.edges[i]
        if e and e.Parent then
            local p1 = cf:PointToWorldSpace(corners[pr[1]])
            local p2 = cf:PointToWorldSpace(corners[pr[2]])
            local mid = (p1+p2)/2; local diff = p2-p1; local len = diff.Magnitude
            if len > 0.01 then
                local dir = diff.Unit; local up = Vector3.new(0,1,0)
                if math.abs(dir.Y) > 0.95 then up = Vector3.new(0,0,1) end
                local rgt = dir:Cross(up); if rgt.Magnitude < 0.01 then rgt = Vector3.new(1,0,0) end; rgt = rgt.Unit
                local uf = rgt:Cross(dir).Unit
                e.Size = Vector3.new(T, T, len)
                e.CFrame = CFrame.fromMatrix(mid, rgt, uf, dir)
                e.Color = color
                e.Transparency = Settings.Rect_EdgeTransparency or 0.2
            end
        end
    end
end
local function DestroyAllBoxes()
    for k, box in pairs(Rectangle.boxes) do
        if box.model then pcall(function() box.model:Destroy() end) end
    end
    Rectangle.boxes = {}; Rectangle.m1FlashUntil = {}
end
local function EnsureRectLoop()
    if Rectangle.loop then return end
    Rectangle.loop = RunService.RenderStepped:Connect(function()
        if IsPlayerKiller() then
            if next(Rectangle.boxes) then DestroyAllBoxes() end
            return
        end
        if not Settings.AB_ShowBox then
            for _, box in pairs(Rectangle.boxes) do
                for _, e in ipairs(box.edges) do if e and e.Parent then e.Transparency = 1 end end
            end
            return
        end
        local kf = GetKillersFolder()
        if not kf then if next(Rectangle.boxes) then DestroyAllBoxes() end; return end
        local seen = {}
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") and k.Parent then
                local kr = k:FindFirstChild("HumanoidRootPart")
                if kr then
                    seen[k] = true
                    local box = GetOrCreateBox(k)
                    UpdateBoxVisual(k, box)
                end
            end
        end
        for k, box in pairs(Rectangle.boxes) do
            if not seen[k] then
                if box.model then pcall(function() box.model:Destroy() end) end
                Rectangle.boxes[k] = nil
            end
        end
        local now = tick()
        for k, u in pairs(Rectangle.m1FlashUntil) do if now > u or not k.Parent then Rectangle.m1FlashUntil[k] = nil end end
    end)
end
local function StopRectLoop()
    if Rectangle.loop then pcall(function() Rectangle.loop:Disconnect() end); Rectangle.loop = nil end
end
local function IsInRectCheck(k)
    if not k or not k.Parent then return false end
    local kr = k:FindFirstChild("HumanoidRootPart"); if not kr then return false end
    local c = LP.Character; local mr = c and c:FindFirstChild("HumanoidRootPart"); if not mr then return false end
    local cf = CalcRectCF(kr); local size = GetRectSize()
    return IsInRect(mr.Position, cf, size)
end
-- The box IS the facing check. Being inside the killer's projected rectangle
-- means they're facing you and in range. No dot-product fallback.
local function TriggerRect(k)
    if not k or not k.Parent then return false end
    if not k:FindFirstChild("HumanoidRootPart") then return false end
    local c = LP.Character; local mr = c and c:FindFirstChild("HumanoidRootPart"); if not mr then return false end
    if IsInRectCheck(k) then
        Rectangle.m1FlashUntil[k] = tick() + (Settings.Rect_Duration or 0.3)
        return true
    end
    return false
end

