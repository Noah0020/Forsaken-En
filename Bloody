        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return end
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying then
                tryTrack(track)
                if getgenv().ActiveLock.IsActive then break end
            end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not getgenv().ActiveLock.IsActive then return end
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then
            getgenv().ActiveLock.IsActive = false
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
            return
        end
        local character = LP.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then
            getgenv().ActiveLock.IsActive = false
            return
        end
        local mode = getgenv().ActiveLock.Mode
        local cfg = getgenv().AimbotValues[mode]
        if not cfg then
            getgenv().ActiveLock.IsActive = false
            humanoid.AutoRotate = true
            return
        end
        local elapsed = tick() - getgenv().ActiveLock.StartTime
        local target = getgenv().ActiveLock.Target
        local tHRP = target and target:FindFirstChild("HumanoidRootPart")
        local tHum = target and target:FindFirstChildOfClass("Humanoid")
        if not tHRP or (tHum and tHum.Health <= 0) then
            target = GetNearestKiller(cfg.Distance or 50)
            getgenv().ActiveLock.Target = target
            tHRP = target and target:FindFirstChild("HumanoidRootPart")
            tHum = target and target:FindFirstChildOfClass("Humanoid")
        end
        if elapsed > (cfg.LockDuration or 1) or not tHRP then
            getgenv().LastFinishedTrack = getgenv().ActiveLock.Track
            getgenv().ActiveLock.IsActive = false
            getgenv().ActiveLock.Target = nil
            getgenv().ActiveLock.Track = nil
            humanoid.AutoRotate = true
            return
        end
        local position = tHRP.Position
        local pred = cfg.Prediction or 0
        if pred > 0 and tHum and tHum.MoveDirection.Magnitude > 0.05 then
            position = position + tHum.MoveDirection.Unit * pred
        end
        local lookAt = Vector3.new(position.X, hrp.Position.Y, position.Z)
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, lookAt), 0.9)
        if getgenv().GlobalAimlockMode == "Char + Cam Lock" then
            local cam = Workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, position), 0.85)
            end
        end
    end)

