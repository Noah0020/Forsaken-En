local flipCD = {cooldown=false}
local function flip(direction)
    if flipCD.cooldown then return end
    flipCD.cooldown = true
    local root = Character and Character:FindFirstChild("HumanoidRootPart")
    local hum  = Character and Character:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if not root or not hum then flipCD.cooldown=false; return end
    if caps.filesystem then
        local s = Instance.new("Sound", Character)
        if pcall(function() s.SoundId = getcustomasset("Dogsaken/assets/audio/gravity_coil.ogg") end) then
            s.PlaybackSpeed = math.random()+0.6; s:Play(); Debris:AddItem(s,5) end end
    local tracks = {}
    if anim then for _,t in ipairs(anim:GetPlayingAnimationTracks()) do
        tracks[#tracks+1]={track=t,time=t.TimePosition}; t:Stop(0) end end
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    for _,st in ipairs({Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Running,Enum.HumanoidStateType.Seated,Enum.HumanoidStateType.Climbing}) do
        hum:SetStateEnabled(st,false) end
    local base = root.CFrame
    local dir = direction=="front" and base.LookVector or -base.LookVector
    local up = Vector3.new(0,1,0)
    task.spawn(function()
        local t0 = os.clock()
        for i=1,120 do
            local k = i/120
            local p = base.Position + dir*(35*k) + up*(4*(k-k*k)*10)
            local rot = base.Rotation * CFrame.Angles(math.rad(-i*3),0,0)
            root.CFrame = CFrame.new(p)*rot
            local s = 0.00375*i-(os.clock()-t0); if s>0 then task.wait(s) end end
        root.CFrame = CFrame.new(base.Position + dir*35)*base.Rotation
        for _,st in ipairs({Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.Freefall,
            Enum.HumanoidStateType.Running,Enum.HumanoidStateType.Seated,Enum.HumanoidStateType.Climbing}) do
            hum:SetStateEnabled(st,true) end
        hum:ChangeState(Enum.HumanoidStateType.Running)
        if anim then for _,v in ipairs(tracks) do
            v.track:Play(); v.track.TimePosition = v.time
            if v.track.Animation.AnimationId=="rbxassetid://75804462760596" then v.track:AdjustSpeed(0) end end end
        task.wait(0.25); flipCD.cooldown=false
    end)
end

