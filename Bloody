if LP.Character then elliot_setupChar(LP.Character) end
LP.CharacterAdded:Connect(elliot_setupChar)
local function elliot_findTarget()
    local sf = GetSurvivorsFolder(); if not sf or not elliot.hrp then return nil end
    local best, bv = nil, math.huge
    for _, s in ipairs(sf:GetChildren()) do
        if s ~= LP.Character then
            local h = s:FindFirstChildOfClass("Humanoid"); local r = s:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local v = elliot.targetMode == "Closest" and (r.Position - elliot.hrp.Position).Magnitude or h.Health
                if v < bv then bv = v; best = r end
            end
        end
    end
