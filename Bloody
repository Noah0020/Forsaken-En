-- 3. LIBRARY LOADERS (with strict verification)
--═══════════════════════════════════════════════════════════
local Starlight, NebulaIcons
do
    local url = "https://raw.nebulasoftworks.xyz/starlight"
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or not res or res == "" then
        error("[CupcakeHub] Starlight download failed from " .. url .. " (" .. tostring(res) .. ")")
    end
    local compiled = loadstring(res)
    if not compiled then
        error("[CupcakeHub] Starlight source is not valid Lua (URL: " .. url .. ")")
    end
    local runOk, lib = pcall(compiled)
    if not runOk or not lib or type(lib) ~= "table" or not lib.CreateWindow then
        error("[CupcakeHub] Starlight loaded but missing expected API (CreateWindow)")
    end
    Starlight = lib
end

do
    local url = "https://raw.nebulasoftworks.xyz/nebula-icon-library-loader"
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res and res ~= "" then
        local compiled = loadstring(res)
        if compiled then
            local runOk, lib = pcall(compiled)
            if runOk and lib then NebulaIcons = lib end
        end
    end
    if not NebulaIcons then
        warn("[CupcakeHub] NebulaIcons unavailable — falling back to Cupcake icon")
    end
end

local HubName = "CupcakeHub"
local CupcakeIcon = 72996766218088
getgenv().InterfaceName = HubName

local function Ico(name)
    if NebulaIcons and NebulaIcons.GetIcon then
        local ok, icon = pcall(function() return NebulaIcons:GetIcon(name, "Material") end)
        if ok and icon then return icon end
    end
    return CupcakeIcon
end

