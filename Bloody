local espFolder = workspace:FindFirstChild("DS_ESP") or Instance.new("Folder")
espFolder.Name = "DS_ESP"; espFolder.Parent = workspace

local ESPColors = {
    killer    = Color3.fromRGB(255, 0, 0),
    survivor  = Color3.fromRGB(0, 255, 0),
    generator = Color3.fromRGB(0, 180, 255),
    item      = Color3.fromRGB(255, 234, 0),
    minion    = Color3.fromRGB(255, 122, 33),
    trap      = Color3.fromRGB(225, 0, 255),
    spray     = Color3.fromRGB(0, 255, 255),
}

local function clearPrefix(pre)
    for _, o in ipairs(espFolder:GetChildren()) do
        if o.Name:sub(1, #pre) == pre then o:Destroy() end
    end
    -- also clear billboards on world objects with matching prefix tags
    for _, o in ipairs(workspace:GetDescendants()) do
        if o.Name == "__SBB" or o.Name == "__SESP" then
            local tag = o:GetAttribute("DSPrefix")
            if tag and tag:sub(1,#pre) == pre then o:Destroy() end
        end
    end
end

local function makeHL(obj, id, color)
    if not obj or espFolder:FindFirstChild(id) then return end
    local hl = Instance.new("Highlight")
    hl.Name = id
    hl.Adornee = obj
    hl.FillColor = color
    hl.OutlineColor = Color3.new(0,0,0)
    hl.FillTransparency = C.ESPFillTransparency
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espFolder
    return hl
end

local function makeBB(obj, id, text, color)
    if not obj then return end
    local existing = obj:FindFirstChild("__SBB")
    if existing then existing:Destroy() end
    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart"))
    if not part and obj:IsA("BasePart") then part = obj end
    if not part then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = "__SBB"
    bb:SetAttribute("DSPrefix", id)
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 140, 0, 18)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.MaxDistance = 2000
    bb.Parent = part
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.Size = UDim2.new(1,0,1,0)
    tl.Font = Enum.Font.Code
    tl.TextScaled = true
    tl.TextColor3 = Color3.new(1,1,1)
    tl.Text = text or obj.Name
    tl.Parent = bb
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.new(0,0,0)
    stroke.Thickness = 1.2
    stroke.Parent = tl
    return bb
end

local function applyPlayerESP(model, kind)
    if not model or model == LocalPlayer.Character then return end
    local id = (kind == "killer" and "K_" or "S_") .. model.Name
    makeHL(model, id, ESPColors[kind])
    if C.ShowName or C.ShowHP then
        local hum = model:FindFirstChildOfClass("Humanoid")
        local label = model.Name
        if C.ShowHP and hum then
            label = label .. " | " .. math.floor(hum.Health) .. "HP"
        end
        makeBB(model, id, label, ESPColors[kind])
        if hum and C.ShowHP then
            hum.HealthChanged:Connect(function(hp)
                local bb = model:FindFirstChild("__SBB", true)
                if bb and bb:FindFirstChildOfClass("TextLabel") then
                    bb.TextLabel.Text = model.Name .. " | " .. math.floor(hp) .. "HP"
                end
            end)
        end
    end
end

local function refreshESP()
    RefreshFolders()
    if C.ESPKiller then
        clearPrefix("K_")
        if KillersFolder then
            for _, m in ipairs(KillersFolder:GetChildren()) do
                if m:IsA("Model") then applyPlayerESP(m, "killer") end
            end
        end
    end
    if C.ESPSurvivor then
        clearPrefix("S_")
        if SurvivorsFolder then
            for _, m in ipairs(SurvivorsFolder:GetChildren()) do
                if m:IsA("Model") and m ~= LocalPlayer.Character then
                    applyPlayerESP(m, "survivor")
                end
            end
        end
    end
    if C.ESPGen then
        clearPrefix("G_")
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Model") and o.Name == "Generator" then
                local prog = o:FindFirstChild("Progress")
                if not prog or prog.Value < 100 then
                    local id = "G_" .. tostring(o:GetDebugId())
                    makeHL(o, id, ESPColors.generator)
                    makeBB(o, id, "Generator", ESPColors.generator)
                end
            end
        end
    end
    if C.ESPItem then
        clearPrefix("I_")
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Tool") and (o.Name == "BloxyCola" or o.Name == "Medkit") then
                if not (o.Parent and o.Parent:FindFirstChildOfClass("Humanoid")) then
                    local id = "I_" .. tostring(o:GetDebugId())
                    makeHL(o, id, ESPColors.item)
                    makeBB(o, id, o.Name, ESPColors.item)
                end
            end
        end
    end
    if C.ESPMinion then
        clearPrefix("M_")
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Model") and (o.Name == "PizzaDeliveryRig" or o.Name == "1x1x1x1Zombie" or string.find(string.lower(o.Name), "minion")) then
                local id = "M_" .. o.Name .. tostring(o:GetDebugId())
                makeHL(o, id, ESPColors.minion)
            end
        end
    end
    if C.ESPTrap then
        clearPrefix("T_")
        for _, o in ipairs(workspace:GetDescendants()) do
            local n = string.lower(o.Name or "")
            if (o:IsA("Model") or o:IsA("BasePart")) and (n:find("trap") or n:find("tripwire") or n:find("subspace") or n:find("mine") or n:find("spike")) then
                local id = "T_" .. tostring(o:GetDebugId())
                makeHL(o, id, ESPColors.trap)
            end
        end
    end
    if C.ESPSpray then
        clearPrefix("SP_")
        local root = MapIngame or workspace
        for _, o in ipairs(root:GetDescendants()) do
            if o:IsA("Model") and string.find(o.Name, "Spray") then
                local id = "SP_" .. tostring(o:GetDebugId())
                makeHL(o, id, ESPColors.spray)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(1.4)
        if C.ESPKiller or C.ESPSurvivor or C.ESPGen or C.ESPItem or C.ESPMinion or C.ESPTrap or C.ESPSpray then
            pcall(refreshESP)
        end
    end
end)

