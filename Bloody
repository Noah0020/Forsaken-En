					and v.ping <= bestPing and bestPlay < v.playing then
					bestId   = v.id
					bestPing = v.ping
					bestPlay = v.playing
				end
			end
		end
		if not bestId then Notify("Couldn't find a server.", 3); return end
		queueonteleport([[loadstring(game:HttpGet("https://github.com/YOUR_REPO/doggysaken/raw/main/Doggysaken.lua"))()]])
		TeleportService:TeleportToPlaceInstance(game.PlaceId, bestId, LocalPlayer)
	end,
})

