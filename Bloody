local MAimbot = { running = false, conn = nil, currentTarget = nil, targetChar = nil }

local function MAimbot_Nearest()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local folder = (Settings.MA_Target == "Survivors" or Settings.MA_Target == "Auto" and LocalPlayer.Character.Parent.Name == "Killers")
        and GetSurvivorsFolder() or GetKillersFolder()
    if not folder then return nil end
    local best, bd = nil, Settings.MA_Distance
    for _, m in ipairs(folder:GetChildren()) do
        if m ~= LocalPlayer.Character and m:IsA("Model") then
            local hrp = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if hrp and h and h.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bd then best, bd = hrp, d end
            end
        end
    end
    return best
end

local function MAimbot_Loop()
    while MAimbot.running do
        RunService.Heartbeat:Wait()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not myRoot or hum.Health <= 0 then continue end
        local target = MAimbot_Nearest()
        if not target then continue end

        local ping = 0.05
        if Settings.MA_PingComp then
            pcall(function() ping = math.max(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000, 0.05) end)
        end
        local tVel = target.AssemblyLinearVelocity or Vector3.new()
        local predPos = target.Position + tVel * (Settings.MA_Prediction + ping * 0.5)

        local lerp = math.clamp(Settings.MA_Smoothness / 100, 0.02, 1) * 0.6
        if Settings.MA_Method == "Camera" or Settings.MA_Method == "Both" then
            local cam = Workspace.CurrentCamera
            if cam then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, predPos), lerp) end
        end
        if Settings.MA_Method == "HRP" or Settings.MA_Method == "Both" then
            myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, Vector3.new(predPos.X, myRoot.Position.Y, predPos.Z)), lerp)
        end
    end
end

local function MAimbot_Enable()
    if MAimbot.running then return end
    MAimbot.running = true
    MAimbot.conn = task.spawn(MAimbot_Loop)
end
local function MAimbot_Disable()
    MAimbot.running = false
    if MAimbot.conn then pcall(task.cancel, MAimbot.conn); MAimbot.conn = nil end
end

