local function safeCall(fn, ...)
    if type(fn) ~= "function" then return false end
    local ok, result = pcall(fn, ...)
    if not ok then warn("[Doggysaken] " .. tostring(result)) end
    return ok, result
end

local function addGroup(tab, side, name, description, icon)
    -- Rayfield uses ordered sections inside each tab rather than Obsidian-style
    -- left/right groupboxes. The feature controls are still placed in their
    -- correct tab and under explicit section headers.
    if name and name ~= "" then tab:CreateSection(name) end
    local group = { Tab = tab }
    function group:AddLabel(text, icon)
        return self.Tab:CreateLabel(tostring(text or ""), icon)
    end
    function group:AddDivider()
        return self.Tab:CreateDivider()
    end
    return group
end

local function addToggle(group, id, title, default, callback, tooltip)
    local control = group.Tab:CreateToggle({
        Name = title,
        CurrentValue = default == true,
        Flag = id,
        Callback = function(value)
            if callback then safeCall(callback, value) end
        end,
    })
    Toggles[id] = {
        SetValue = function(_, value)
            if control and type(control.Set) == "function" then
                pcall(function() control:Set(value == true) end)
            end
        end,
    }
    return control
end

local function addSlider(group, id, title, default, minimum, maximum, rounding, callback, suffix)
    local increment = 1
    if type(rounding) == "number" and rounding > 0 then
        increment = 10 ^ (-rounding)
    end
    return group.Tab:CreateSlider({
        Name = title,
        Range = { minimum, maximum },
        Increment = increment,
        Suffix = suffix or "",
        CurrentValue = default,
        Flag = id,
        Callback = function(value)
            if callback then safeCall(callback, value) end
        end,
    })
end

local function addButton(group, title, callback)
    return group.Tab:CreateButton({
        Name = title,
        Callback = function() if callback then safeCall(callback) end end,
    })
end

local function addDropdown(group, id, title, values, default, callback, multi)
    local current = default
    if multi then
        if type(current) ~= "table" then current = { current } end
    else
        if type(current) ~= "table" then current = { current } end
    end
    return group.Tab:CreateDropdown({
        Name = title,
        Options = values,
        CurrentOption = current,
        MultipleOptions = multi == true,
        Flag = id,
        Callback = function(value)
            if callback then safeCall(callback, value) end
        end,
    })
end

