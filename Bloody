-- AIM
local Aim = { active = false, endT = 0, hookDone = false }
local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, s = pcall(function()
            local len = buffer.readu8(arg, 1)
            if len < 1 or len > 64 then return nil end
            local out = ""
            for i = 5, 4 + len do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out ..= string.char(b) end
            end
            return out
        end)
        return ok and s or nil
    end
    if t == "table" then return ExtractAbility(arg[1]) end
    return nil
end
local function IsOffensive(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower()
    if Settings.AIM_OnSlash and l == "slash" then return true end
    if Settings.AIM_OnBlock and (l == "block" or l == "parry" or l == "punch") then return true end
    if Settings.AIM_OnDagger and l:find("dagger", 1, true) then return true end
    if Settings.AIM_OnAxe and (l == "axe" or l == "hatchet") then return true end
    if Settings.AIM_OnShoot and (l:find("shoot") or l:find("gun") or l:find("shot") or l:find("flint") or l:find("oneshot")) then return true end
    return false
end
local function GetLockTime(name)
    local base = Settings.AIM_LockTime
    if type(name) ~= "string" then return base end
    local l = name:lower()
    if l:find("shoot") or l:find("gun") then return math.max(base, 1.25) end
    if l == "slash" then return math.max(base, 0.7) end
    if l:find("dagger") then return math.max(base, 0.95) end
    return base
end
local function Aim_GetTarget()
    local hrp = LocalRoot; if not hrp then return nil, nil end
    local kf = GetKillersFolder(); if not kf then return nil, nil end
    local best, kr, dist = nil, nil, 1e9
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then dist = d; best = k; kr = krp end
        end
    end
    if not best or dist > Settings.AIM_Range or dist < Settings.AIM_MinDist then return nil, nil end
    local vel = kr.AssemblyLinearVelocity or Vector3.zero
    if vel.Magnitude > 60 then vel = vel.Unit * 60 end
    local pred, lead = Settings.AIM_Prediction, Settings.AIM_LeadMultiplier
    local predicted = kr.Position + vel * (pred * 0.06 * lead)
    local kh = best:FindFirstChildOfClass("Humanoid")
    if kh and kh.MoveDirection.Magnitude > 0.06 then predicted = predicted + kh.MoveDirection * (pred * 0.42 * lead) end
    local look = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
    if look.Magnitude > 0.1 then predicted = predicted + look.Unit * (1.5 + pred * 0.12) end
    return hrp, predicted
end
local function Aim_Rotate(name)
    local hrp, target = Aim_GetTarget()
    if not hrp or not target then return end
    if LocalHumanoid then LocalHumanoid.AutoRotate = false end
    pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z)) end)
    Aim.active = true; Aim.endT = tick() + GetLockTime(name)
end
local function Aim_SetupHook()
    if Aim.hookDone or not ResolveNetwork() or not hookmetamethod then return false end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if Settings.AIM_Enabled and getnamecallmethod() == "FireServer" and self == NetworkEvent then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsOffensive(n) then Aim_Rotate(n) end
                end
            end
            return old(self, ...)
        end)
    end)
    if ok then Aim.hookDone = true end
    return ok
end
RunService.RenderStepped:Connect(function()
    if not Settings.AIM_Enabled then
        if Aim.active then Aim.active = false; if LocalHumanoid then LocalHumanoid.AutoRotate = true end end
        return
    end
    if not Aim.active or tick() > Aim.endT then
        if Aim.active then Aim.active = false; if LocalHumanoid then LocalHumanoid.AutoRotate = true end end
        return
    end
    local hrp = LocalRoot; if not hrp then return end
    if LocalHumanoid then LocalHumanoid.AutoRotate = false end
    local _, target = Aim_GetTarget(); if not target then return end
    if Settings.AIM_Mode == "Character" or Settings.AIM_Mode == "Both" then
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z)) end)
    end
    if Settings.AIM_Mode == "Camera" or Settings.AIM_Mode == "Both" then
        local cam = Workspace.CurrentCamera
        if cam then pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target) end) end
    end
end)
