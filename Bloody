local HDT={debounce=false,Speed=40,Duration=0.6,bindId=0} local HDT_Enabled=false
local function HDT_Fire(killer)
    if not HDT_Enabled or HDT.debounce then return end
    if hasHelplessEffect() then return end
    if not killer or not killer.Parent then return end
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart") local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health<=0 then return end
    local kr=killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position-hrp.Position).Magnitude<2.5 then return end
    HDT.debounce=true HDT.bindId=HDT.bindId+1
    local bind="GS_HDT_"..tostring(HDT.bindId) local startT=tick() local sp=HDT.Speed local dur=HDT.Duration local active=true
    local bv=Instance.new("BodyVelocity") bv.Name="GS_HDT_BV" bv.MaxForce=Vector3.new(1e6,0,1e6) bv.Velocity=Vector3.zero bv.Parent=hrp
    local bg=Instance.new("BodyGyro") bg.Name="GS_HDT_BG" bg.MaxTorque=Vector3.new(1e6,1e6,1e6) bg.P=3000 bg.D=500 bg.CFrame=hrp.CFrame bg.Parent=hrp
    local function stop() if not active then return end active=false HDT.debounce=false pcall(function() RunService:UnbindFromRenderStep(bind) end) if bv and bv.Parent then bv:Destroy() end if bg and bg.Parent then bg:Destroy() end end
    RunService:BindToRenderStep(bind,Enum.RenderPriority.Camera.Value+1,function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health<=0 then stop(); return end
        if hasHelplessEffect() then stop(); return end
        if not kr.Parent then stop(); return end
        if tick()-startT>dur then stop(); return end
        local toK=kr.Position-hrp.Position local flat=Vector3.new(toK.X,0,toK.Z)
        if flat.Magnitude<1 then stop(); return end
        if bv and bv.Parent then bv.Velocity=flat.Unit*sp end
        if bg and bg.Parent then bg.CFrame=CFrame.new(hrp.Position,Vector3.new(kr.Position.X,hrp.Position.Y,kr.Position.Z)) end
    end)
    task.delay(dur+0.3,stop)
end
local function hdtNearest()
    local kf=Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers") local char=LP.Character local hrp=char and char:FindFirstChild("HumanoidRootPart")
    if not kf or not hrp then return nil end
    local best,bd=nil,math.huge
    for _,k in ipairs(kf:GetChildren()) do local kr=k:FindFirstChild("HumanoidRootPart") local kh=k:FindFirstChildOfClass("Humanoid") if kr and (not kh or kh.Health>0) then local d=(kr.Position-hrp.Position).Magnitude if d<bd then bd=d best=k end end end
    return best
end

local AutoBlockEnabled=false
local function checkKiller(killer)
    if not AutoBlockEnabled or not LP.Character then return end
    local clu=killer:GetAttribute("AbilityLastUsed") or 0
    local cu=killer:GetAttribute("AbilitiesUsed") or 0
    local st=blockPerKiller[killer]
    if not st then blockPerKiller[killer]={lastUsed=clu,used=cu,locked=false} return end
    local lUI=clu>st.lastUsed local uI=cu>st.used
    if uI then st.locked=true end
    if lUI and not st.locked then
        local ex=activeBlocks[killer]
        if ex then ex.expiresAt=os.clock()+ConeConfig.WindowDuration
        else activeBlocks[killer]={expiresAt=os.clock()+ConeConfig.WindowDuration,fired=false} end
    end
    if lUI and st.locked then st.locked=false end
    st.lastUsed=clu st.used=cu
end
