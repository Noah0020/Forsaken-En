local function InstallBloodsakenAutoDots()
-- ============ BLOODSAKEN AUTO DOTS PUZZLE ============
-- The supplied source pack contains a FlowGame solution-path solver. This
-- ports that approach into Bloodsaken and adds a dots-only pacing control.
-- Speed 1 targets ~4 seconds for the entire dots board; larger values are slower.
local AutoDots = {
    Enabled = false,
    Speed = 1,
    Generation = 0,
    Hooked = false,
    LastPuzzle = nil,
    LastUI = nil,
    FlowModule = nil,
}

local function autoDotsKey(point)
    return tostring(point.row) .. "-" .. tostring(point.col)
end

local function autoDotsOrderPath(path, endpoints)
    if type(path) ~= "table" or #path < 2 then return path or {} end

    local pointsByKey = {}
    for _, point in ipairs(path) do
        if type(point) == "table" and type(point.row) == "number" and type(point.col) == "number" then
            pointsByKey[autoDotsKey(point)] = { row = point.row, col = point.col }
        end
    end

    local startPoint
    if type(endpoints) == "table" then
        for _, endpoint in ipairs(endpoints) do
            if type(endpoint) == "table" then
                local key = autoDotsKey(endpoint)
                if pointsByKey[key] then
                    startPoint = pointsByKey[key]
                    break
                end
            end
        end
    end

    local directions = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }
    if not startPoint then
        for _, point in pairs(pointsByKey) do
            local neighbours = 0
            for _, direction in ipairs(directions) do
                local key = tostring(point.row + direction[1]) .. "-" .. tostring(point.col + direction[2])
                if pointsByKey[key] then neighbours = neighbours + 1 end
            end
            if neighbours == 1 then
                startPoint = point
                break
            end
        end
    end
    if not startPoint then return path end

    local ordered, visited = {}, {}
    local current = startPoint
    while current do
        local currentKey = autoDotsKey(current)
        if visited[currentKey] then break end
        visited[currentKey] = true
        table.insert(ordered, { row = current.row, col = current.col })

        local nextPoint
        for _, direction in ipairs(directions) do
            local nextKey = tostring(current.row + direction[1]) .. "-" .. tostring(current.col + direction[2])
            if pointsByKey[nextKey] and not visited[nextKey] then
                nextPoint = pointsByKey[nextKey]
                break
            end
        end
        current = nextPoint
    end

    if #ordered ~= #path then
        -- Preserve the source path if it is not a single unbranched chain.
        return path
    end
    return ordered
end

local function autoDotsDirection(fromPoint, toPoint)
    if not fromPoint or not toPoint then return nil end
    if toPoint.row < fromPoint.row then return "up" end
    if toPoint.row > fromPoint.row then return "down" end
    if toPoint.col < fromPoint.col then return "left" end
    if toPoint.col > fromPoint.col then return "right" end
    return nil
end

local function autoDotsConnections(previous, current, following)
    local connections = {}
    if previous then
        local direction = autoDotsDirection(current, previous)
        if direction == "up" then direction = "down"
        elseif direction == "down" then direction = "up"
        elseif direction == "left" then direction = "right"
        elseif direction == "right" then direction = "left" end
        if direction then connections[direction] = true end
    end
    if following then
        local direction = autoDotsDirection(current, following)
        if direction then connections[direction] = true end
    end
    return connections
end

local function autoDotsStillValid(generation, ui)
    return AutoDots.Enabled
        and AutoDots.Generation == generation
        and ui ~= nil
        and ui.Parent ~= nil
        and PlayerGui:FindFirstChild("PuzzleUI") ~= nil
end

local function autoDotsSolve(puzzle, ui)
    if not AutoDots.Enabled or not puzzle or type(puzzle.Solution) ~= "table" then return end
    if not ui or not ui.Parent or not PlayerGui:FindFirstChild("PuzzleUI") then return end

    AutoDots.Generation = AutoDots.Generation + 1
    local generation = AutoDots.Generation
    AutoDots.LastPuzzle = puzzle
    AutoDots.LastUI = ui

    local pathsByColour = {}
    local totalSteps = 0
    for colour, path in pairs(puzzle.Solution) do
        local ordered = autoDotsOrderPath(path, puzzle.targetPairs and puzzle.targetPairs[colour])
        if type(ordered) == "table" and #ordered > 0 then
            pathsByColour[colour] = ordered
            totalSteps = totalSteps + #ordered
        end
    end
    if totalSteps <= 0 then return end

    -- Speed 1 = approximately 4 seconds for all dot paths combined.
    -- Speed 2 = 8s, Speed 3 = 12s, etc. This pacing is used only here.
    local targetDuration = 4 * math.max(1, tonumber(AutoDots.Speed) or 1)
    local stepDelay = targetDuration / totalSteps
    local colourOrder = {}
    for colour in pairs(pathsByColour) do table.insert(colourOrder, colour) end
    table.sort(colourOrder, function(a, b) return tostring(a) < tostring(b) end)

    task.spawn(function()
        puzzle.paths = puzzle.paths or {}
        puzzle.gridConnections = puzzle.gridConnections or {}

        for _, colour in ipairs(colourOrder) do
            if not autoDotsStillValid(generation, ui) then return end
            local path = pathsByColour[colour]
            puzzle.paths[colour] = {}

            for index, point in ipairs(path) do
                if not autoDotsStillValid(generation, ui) then return end
                table.insert(puzzle.paths[colour], { row = point.row, col = point.col })
                puzzle.gridConnections[autoDotsKey(point)] = autoDotsConnections(path[index - 1], point, path[index + 1])

                local ok, err = pcall(function() puzzle:updateGui() end)
                if not ok then
                    warn("[Bloodsaken Auto Dots] updateGui failed: " .. tostring(err))
                    return
                end
                task.wait(stepDelay)
            end

            if not autoDotsStillValid(generation, ui) then return end
            local ok, err = pcall(function() puzzle:checkForWin() end)
            if not ok then
                warn("[Bloodsaken Auto Dots] checkForWin failed: " .. tostring(err))
                return
            end
        end
    end)
end

local function autoDotsSetEnabled(state)
    AutoDots.Enabled = state == true
    AutoDots.Generation = AutoDots.Generation + 1
    if AutoDots.Enabled and AutoDots.LastPuzzle and AutoDots.LastUI then
        autoDotsSolve(AutoDots.LastPuzzle, AutoDots.LastUI)
    end
end

