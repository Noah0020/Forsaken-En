local function strToBuffer(s)
    local bytes = {3, #s, 0, 0, 0}
    for i = 1, #s do table.insert(bytes, string.byte(s, i)) end
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i - 1, bytes[i]) end
    return b
end

local function fireAbility(name)
    pcall(function()
        testRemote:FireServer("UseActorAbility", { strToBuffer(name) })
    end)
end

