local blockSettingKeys = {
    Default = "AutoBlock",
    Custom = "AutoBlockCustom",
    Rectangle = "AutoBlockRectangle",
}
local blockToggleKeys = {
    Default = "Doggysaken_AutoBlock",
    Custom = "Doggysaken_CustomZoneBlock",
    Rectangle = "Doggysaken_RectangleBlock",
}
local updatingBlockToggles = false

local function syncBlockToggles()
    if updatingBlockToggles then return end
    updatingBlockToggles = true
    for mode, toggleKey in pairs(blockToggleKeys) do
        local control = Toggles[toggleKey]
        local desired = Settings[blockSettingKeys[mode]] == true
        if control and control.Value ~= desired then
            control:SetValue(desired)
        end
    end
    updatingBlockToggles = false
end

local function setBlockMode(mode, enabled)
    if updatingBlockToggles then return end
    local settingKey = blockSettingKeys[mode]
    if not settingKey then return end

    if enabled then
        for otherMode, otherKey in pairs(blockSettingKeys) do
            Settings[otherKey] = otherMode == mode
        end
    else
        Settings[settingKey] = false
    end

    if type(ab_requestState) == "function" then
        safeCall(ab_requestState, enabled, mode)
    elseif Settings.AutoBlock or Settings.AutoBlockCustom or Settings.AutoBlockRectangle then
        safeCall(StartAutoBlock)
    else
        safeCall(StopAutoBlock)
    end
    syncBlockToggles()
end

