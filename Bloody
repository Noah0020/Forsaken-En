}
local NS_DEFAULT_TIMING = { dura=0.26, life=0.26 }
local function NS_getTiming(n)
    if not n then return NS_DEFAULT_TIMING end
    for k, v in pairs(NS_KILLER_TIMING) do if string.find(n, k, 1, true) then return v end end
    return NS_DEFAULT_TIMING
end
local function NS_getHitboxSize()
    return Vector3.new(Settings.HitboxWidth or 6, Settings.HitboxHeight or 6, Settings.HitboxLength or 9)
end
local _ns_spamThread = nil
local function NS_spamBlock(dur)
    if _ns_spamThread then task.cancel(_ns_spamThread) end
    _ns_spamThread = task.spawn(function()
        local t = tick() + dur
        while tick() < t do FireABByMode(); task.wait(0.001) end
        _ns_spamThread = nil
    end)
end
local function NS_makeHitboxAndCheck(killerModel)
    if IsPlayerKiller() then return end
    if not killerModel or not killerModel.Parent then return end
    local kr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
    if not kr then return end
    local timing = NS_getTiming(killerModel.Name)
    local size = NS_getHitboxSize()
    local dist = Settings.HitboxDistance or 3
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killerModel}
    task.spawn(function()
        local st = tick(); local blocked = false
        while tick() - st < timing.dura do
            if blocked or IsPlayerKiller() then break end
            local ckr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not ckr then break end
            local cf = ckr.CFrame * CFrame.new(0, 0, -dist)
            local hb = Instance.new("Part")
            hb.Name = "AutoBlockHitbox_Frame"
            hb.Transparency = Settings.ShowHitboxVisual and Settings.HitboxTransparency or 1
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Anchored = true
            hb.Size = size
            hb.Color = ParseColor(Settings.HitboxColor, 255, 255, 255)
            hb.Material = Enum.Material.ForceField
            hb.CFrame = cf; hb.Parent = Workspace
            local sb
            if Settings.ShowOutline and Settings.ShowHitboxVisual then
                sb = Instance.new("SelectionBox")
                sb.Adornee = hb; sb.Color3 = ParseColor(Settings.HitboxColor, 255, 255, 255)
                sb.LineThickness = 0.04; sb.Transparency = Settings.OutlineTransparency or 0.6
                sb.Visible = true; sb.Parent = hb
            end
            Debris:AddItem(hb, timing.life)
            local found = false
            for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    found = true; break
                end
            end
            if found and not blocked then
                blocked = true
                pcall(function() hb.Color = Color3.fromRGB(0, 255, 0); if sb then sb.Color3 = Color3.fromRGB(0, 255, 0) end end)
                FireABByMode(); FireABByMode(); FireABByMode(); FireABByMode()
                NS_spamBlock(0.05)
                break
            end
            RunService.Heartbeat:Wait()
        end
    end)
end
local function CanBlockKiller(killer)
    if not Settings.AntiWrongBlockEnabled then return true end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    local kh = killer:FindFirstChildOfClass("Humanoid")
    if not kr or not kh then return true end
    local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return true end
    local tp = kh.TargetPoint
    if not tp or tp.Magnitude < 0.1 then return true end
    if (tp - mr.Position).Magnitude > (Settings.AntiWrongBlockRange or 15) then return true end
    local dP = (tp - mr.Position).Magnitude
    local dK = (tp - kr.Position).Magnitude
    return dP <= dK * (1 + (Settings.AntiWrongBlockTolerance or 0.15))
end

