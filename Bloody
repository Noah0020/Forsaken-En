--═══════════════════════════════════════════════════════════════════
-- BASIC ESP
--═══════════════════════════════════════════════════════════════════
do
    local S = { killer = false, survivor = false, generator = false }
    local folder = Instance.new("Folder")
    folder.Name = "Nos_ESP"
    folder.Parent = CoreGui
    local highlights = {}

    local function clear(m)
        if highlights[m] then
            pcall(function() highlights[m]:Destroy() end)
            highlights[m] = nil
        end
    end

    local function hl(m, col)
        if highlights[m] and highlights[m].Parent then
            highlights[m].FillColor = col
            highlights[m].OutlineColor = col
            return
        end
        local h = Instance.new("Highlight")
        h.Adornee = m
        h.FillColor = col
        h.OutlineColor = col
        h.FillTransparency = 0.55
        h.OutlineTransparency = 0.2
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = folder
        highlights[m] = h
    end

    task.spawn(function()
        while true do
            task.wait(0.5)
            local seen = {}
            local pf = Workspace:FindFirstChild("Players")
            if pf then
                if S.killer then
                    local kf = pf:FindFirstChild("Killers")
                    if kf then
                        for _, k in ipairs(kf:GetChildren()) do
                            if k:IsA("Model") then
                                seen[k] = true
                                hl(k, Color3.fromRGB(255, 80, 80))
                            end
                        end
                    end
                end
                if S.survivor then
                    local sf = pf:FindFirstChild("Survivors")
                    if sf then
                        for _, s in ipairs(sf:GetChildren()) do
                            if s:IsA("Model") and s ~= LP.Character then
                                seen[s] = true
                                hl(s, Color3.fromRGB(80, 255, 120))
                            end
                        end
                    end
                end
            end
            if S.generator then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "Generator" and obj:IsA("Model") then
                        seen[obj] = true
                        hl(obj, Color3.fromRGB(255, 220, 60))
                    end
                end
            end
            for m in pairs(highlights) do
                if not seen[m] then clear(m) end
            end
        end
    end)

    local left = Tabs.ESP:AddLeftGroupbox("ESP")
    left:AddToggle("ESP_K", {
        Text = "Killer ESP", Default = false,
        Callback = function(v) S.killer = v end,
    })
    left:AddToggle("ESP_S", {
        Text = "Survivor ESP", Default = false,
        Callback = function(v) S.survivor = v end,
    })
    left:AddToggle("ESP_G", {
        Text = "Generator ESP", Default = false,
        Callback = function(v) S.generator = v end,
    })
end

