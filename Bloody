                    FireBlockBuffer()
                    -- trigger HDT drag if enabled
                    if HDT and HDT.enabled then pcall(HDT.trigger) end
                    return
                end
            end
            elapsed += 0.05
            task.wait(0.05)
        end
    end)
end

