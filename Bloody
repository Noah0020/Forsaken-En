HDT = { enabled=false, speed=40, delay=0.05, duration=0.6, debounce=false, lastDamage=0 }
HDT_BIND = "HDT_MoveBind"
HDT_ANIMS = { ["72722244508749"]=true,["96959123077498"]=true,["95802026624883"]=true,["140671644163156"]=true,["100926346851492"]=true }
HDT_WC, HDT_CH, HDT_RT, HDT_CA = nil, nil, nil, nil
function HDT_NearestKiller()
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers"); if not kf then return nil end
    local c = LocalPlayer.Character; local mr = c and c:FindFirstChild("HumanoidRootPart"); if not mr then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do if k:IsA("Model") then local kr = k:FindFirstChild("HumanoidRootPart"); if kr then local d = (kr.Position - mr.Position).Magnitude; if d < bd then best, bd = k, d end end end end
    return best
end
function HDT_Dash(km)
    if HDT.debounce or not km or not km.Parent then return end
    local c = LocalPlayer.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); local h = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    local kr = km:FindFirstChild("HumanoidRootPart") or km.PrimaryPart; if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true
    local oWS, oAR = h.WalkSpeed, h.AutoRotate
    h.WalkSpeed = 40; h.AutoRotate = true
    local st = tick()
    pcall(function() RunService:UnbindFromRenderStep(HDT_BIND) end)
    RunService:BindToRenderStep(HDT_BIND, Enum.RenderPriority.Last.Value + 1, function()
        if not HDT.debounce then pcall(function() RunService:UnbindFromRenderStep(HDT_BIND) end); return end
        if not c.Parent or not km.Parent or not h.Parent then HDT.debounce = false; return end
        local t = km:FindFirstChild("HumanoidRootPart"); if not t then HDT.debounce = false; return end
        local flat = Vector3.new(t.Position.X - hrp.Position.X, 0, t.Position.Z - hrp.Position.Z)
        if flat.Magnitude <= 2 then HDT.debounce = false; return end
        h.WalkSpeed = 40; h:Move(flat.Unit, false)
        if tick() - st > HDT.duration then HDT.debounce = false end
    end)
    local hb
    hb = RunService.Heartbeat:Connect(function() if not HDT.debounce then if hb then hb:Disconnect() end; return end; if h and h.Parent then h.WalkSpeed = 40 end end)
    task.delay(HDT.duration + 0.2, function() if HDT.debounce then HDT.debounce = false end end)
    task.spawn(function()
        while HDT.debounce do task.wait() end
        pcall(function() RunService:UnbindFromRenderStep(HDT_BIND) end)
        if hb and hb.Connected then hb:Disconnect() end
        if h and h.Parent then pcall(function() h:Move(Vector3.new(0,0,0), false); h.WalkSpeed = oWS; h.AutoRotate = oAR end) end
    end)
end
function HDT_OnAnim(track)
    if not HDT.enabled or HDT.debounce or KillerState.isKiller or tick() - HDT.lastDamage < 0.2 then return end
    local id; pcall(function() id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+") end)
    if not id or not HDT_ANIMS[id] then return end
    local k = HDT_NearestKiller(); if not k then return end
    if HDT.delay > 0 then task.delay(HDT.delay, function() if HDT.enabled and not HDT.debounce then HDT_Dash(k) end end)
    else HDT_Dash(k) end
end
function HDT_TryAttach()
    local c = LocalPlayer.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    local an = h:FindFirstChildOfClass("Animator"); if not an then return end
    if HDT_CA == an and HDT_WC and HDT_WC.Connected then return end
    if HDT_WC then pcall(function() HDT_WC:Disconnect() end); HDT_WC = nil end
    HDT_CA = an
    HDT_WC = an.AnimationPlayed:Connect(function(track) pcall(HDT_OnAnim, track) end)
end
function HDT_StartWatcher()
    if not HDT.enabled then return end
    HDT_TryAttach()
    if not HDT_CH then
        HDT_CH = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.3); if HDT.enabled then HDT_TryAttach() end
            task.wait(1); if HDT.enabled then HDT_TryAttach() end
        end)
    end
    if not HDT_RT then
        HDT_RT = task.spawn(function()
            while HDT.enabled do
                if not HDT_WC or not HDT_WC.Connected then HDT_TryAttach() end
                task.wait(0.5)
            end
            HDT_RT = nil
        end)
    end
end
function HDT_StopWatcher()
    HDT.enabled = false
    if HDT_WC then pcall(function() HDT_WC:Disconnect() end); HDT_WC = nil end
    if HDT_CH then pcall(function() HDT_CH:Disconnect() end); HDT_CH = nil end
    if HDT_RT then pcall(task.cancel, HDT_RT); HDT_RT = nil end
    HDT_CA = nil; HDT.debounce = false
    pcall(function() RunService:UnbindFromRenderStep(HDT_BIND) end)
end
HDT_DMG_TRACKED = {}
function HDT_TrackDMG(c)
    if not c or HDT_DMG_TRACKED[c] then return end
    HDT_DMG_TRACKED[c] = true
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then
        task.spawn(function()
            local hh = c:WaitForChild("Humanoid", 5)
            if hh and not HDT_DMG_TRACKED[hh] then
