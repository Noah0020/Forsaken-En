    seenTracks = setmetatable({}, { __mode = "k" }),
    animatorConnections = setmetatable({}, { __mode = "k" }),
    modelConnections = setmetatable({}, { __mode = "k" }),
    visual = nil,
    animsToDetect = {
        ["87259391926321"]=true,["99100240941590"]=true,["72685103823181"]=true,
        ["81905101227053"]=true,["113936304594883"]=true,["140703210927645"]=true,
        ["136007065400978"]=true,["129843313690921"]=true,["86709774283672"]=true,
