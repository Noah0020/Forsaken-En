local function setFullbright(on)
    if on then
        origLight.Brightness = Lighting.Brightness
        origLight.ClockTime = Lighting.ClockTime
        origLight.Ambient = Lighting.Ambient
        origLight.OutdoorAmbient = Lighting.OutdoorAmbient
        origLight.FogEnd = Lighting.FogEnd
        origLight.GlobalShadows = Lighting.GlobalShadows
        Lighting.Brightness = 2.5
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.FogEnd = 1e9
        Lighting.GlobalShadows = false
    else
        pcall(function()
            if origLight.Brightness then Lighting.Brightness = origLight.Brightness end
            if origLight.ClockTime then Lighting.ClockTime = origLight.ClockTime end
            if origLight.Ambient then Lighting.Ambient = origLight.Ambient end
            if origLight.OutdoorAmbient then Lighting.OutdoorAmbient = origLight.OutdoorAmbient end
            if origLight.FogEnd then Lighting.FogEnd = origLight.FogEnd end
            if origLight.GlobalShadows ~= nil then Lighting.GlobalShadows = origLight.GlobalShadows end
        end)
    end
end

local function setNoSlow(on)
    for i = 1, #utilConns do
        pcall(function() utilConns[i]:Disconnect() end)
    end
    table.clear(utilConns)
    if not on then return end
    local function wipe(folder)
        if not folder then return end
        for _, ch in ipairs(folder:GetChildren()) do
            if ch:IsA("NumberValue") or ch:IsA("IntValue") then
                pcall(function() ch.Value = 0 end)
            end
        end
    end
    local function watch(char)
        local sm = char:FindFirstChild("SpeedMultipliers") or char:WaitForChild("SpeedMultipliers", 2)
        if sm then
            wipe(sm)
            table.insert(utilConns, sm.ChildAdded:Connect(function(ch)
                if ch:IsA("NumberValue") or ch:IsA("IntValue") then
                    pcall(function() ch.Value = 0 end)
                end
            end))
        end
    end
    if LocalChar then watch(LocalChar) end
    table.insert(utilConns, LP.CharacterAdded:Connect(watch))
    table.insert(utilConns, RS.Heartbeat:Connect(function()
        if LocalChar then
            local sm = LocalChar:FindFirstChild("SpeedMultipliers")
            if sm then wipe(sm) end
        end
    end))
end

local function setFOV(on)
    Util.FOVOn = on
    local cam = workspace.CurrentCamera
    if cam then
        cam.FieldOfView = on and Util.FOV or 70
    end
end

