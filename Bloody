local KILLER_HB = {
    CoolKid = {dura=0.05, life=0.05, w=5, l=7, h=6},
    Slasher = {dura=0.35, life=0.35},
    ["1x1x1x1"] = {dura=0.45, life=0.45},
    JohnDoe = {dura=0.45, life=0.45},
    ["John Doe"] = {dura=0.45, life=0.45},
    Nosferatu = {dura=0.42, life=0.42},
    Sixer = {dura=0.42, life=0.42, dist=6},
    Noli = {dura=0.37, life=0.37},
    Azure = {dura=0.35, life=0.35},
}
local DEF_HB = {dura=0.28, life=0.28}

local function getHB(name)
    if not name then return DEF_HB end
    for k,v in pairs(KILLER_HB) do
        if string.find(name, k, 1, true) then return v end
    end
    return DEF_HB
end

local function ClearHB()
    for _, o in ipairs(workspace:GetChildren()) do
        if o:IsA("Part") and (o.Name == "AB_Hitbox" or o.Name == "HDT_Dot") then
            o:Destroy()
        end
    end
end

local function makeHB(killer)
    if not C.AutoBlock or not killer or not killer.Parent then return end
    RefreshFolders()
    if not KillersFolder or not killer:IsDescendantOf(KillersFolder) then return end
    local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart")
    if not root then return end
    local cfg = getHB(killer.Name)
    local m = C.HitboxMult
    local size = Vector3.new((cfg.w or 6)*m, (cfg.h or 6)*m, (cfg.l or 9)*m)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killer}

    task.spawn(function()
        local t0, blocked = tick(), false
        while tick()-t0 < (cfg.dura or 0.28) do
            if blocked or not C.AutoBlock then break end
            local kr = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart")
            if not kr then break end
            local cf = kr.CFrame * CFrame.new(0, 0, -(cfg.dist or C.HitboxDist))
            local hb = Instance.new("Part")
            hb.Name = "AB_Hitbox"
            hb.Size = size; hb.CFrame = cf; hb.Anchored = true
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Material = Enum.Material.ForceField
            hb.Color = Color3.fromRGB(255,255,255)
            hb.Transparency = C.HitboxVis and C.HitboxTrans or 1
            hb.Parent = workspace
            if C.HitboxOutline and C.HitboxVis then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = hb; sb.Color3 = Color3.fromRGB(255,255,255)
                sb.LineThickness = 0.04; sb.Transparency = 0.5; sb.Parent = hb
            end
            Debris:AddItem(hb, cfg.life or 0.28)
            if C.HDT then
                local d = Instance.new("Part")
                d.Name = "HDT_Dot"; d.Shape = Enum.PartType.Ball
                d.Size = Vector3.new(0.35,0.35,0.35)
                d.Color = Color3.fromRGB(255,200,40); d.Material = Enum.Material.Neon
                d.Anchored = true; d.CanCollide = false; d.CFrame = cf; d.Parent = workspace
                Debris:AddItem(d, cfg.life or 0.28)
            end
            for _, p in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = p.Parent and p.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                    blocked = true; hb.Color = Color3.fromRGB(0,255,0)
                    fireBlock(); fireBlock(); fireBlock(); fireBlock()
                    if C.AutoPunch then task.delay(C.PunchDelay, function() FireAbility("Punch") end) end
                    break
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local lastALU, lastAU, locked = nil, nil, false
RunService.Heartbeat:Connect(function()
    if not C.AutoBlock then return end
    RefreshFolders()
    if not KillersFolder then return end
    local killer = KillersFolder:GetChildren()[1]
    if not killer or not killer:IsA("Model") then return end
    local alu = killer:GetAttribute("AbilityLastUsed") or 0
    local au  = killer:GetAttribute("AbilitiesUsed") or 0
    if lastALU == nil then lastALU, lastAU = alu, au return end
    if au > lastAU then locked = true end
    if alu > lastALU then
        if locked then locked = false else makeHB(killer) end
    end
    lastALU, lastAU = alu, au
end)

