local function makeHitboxAndCheck(killerModel, onDetected)
    if not killerModel or not killerModel.Parent then return end
    local root = killerModel:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hbCfg = getKillerHitbox(killerModel.Name)
    local m = AB.HitboxMultiplier
    local size = Vector3.new(
        (hbCfg.width or 6)*m,
        (hbCfg.height or 6)*m,
        (hbCfg.length or 9)*m
    )
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {killerModel}

    task.spawn(function()
        local startT = tick()
        local blockedOnce = false
        while tick() - startT < hbCfg.dura do
            if blockedOnce then break end
            local ckr = killerModel:FindFirstChild("HumanoidRootPart")
            if not ckr then break end
            local cf = ckr.CFrame * CFrame.new(0,0,-(hbCfg.distance or AB.HitboxDistance))
            local hb = Instance.new("Part")
            hb.Name = "AB_Hitbox"
            hb.Transparency = AB.ShowHitbox and AB.HitboxTransparency or 1
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Anchored = true
            hb.Size = size; hb.Color = AB.HitboxColor
            hb.Material = Enum.Material.ForceField
            hb.CFrame = cf; hb.Parent = workspace
            local sb
            if AB.ShowOutline and AB.ShowHitbox then
                sb = Instance.new("SelectionBox")
                sb.Adornee = hb; sb.Color3 = AB.HitboxColor
                sb.LineThickness = AB.OutlineThickness
                sb.Transparency = AB.OutlineTransparency
                sb.Visible = true; sb.Parent = hb
            end
            Debris:AddItem(hb, hbCfg.life)
            local found = false
            for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0
                   and Players:GetPlayerFromCharacter(hum.Parent) == lp then
                    found = true; break
                end
            end
            if found and not blockedOnce then
                blockedOnce = true
                pcall(function()
                    hb.Color = AB.HitboxHitColor
                    if sb then sb.Color3 = AB.HitboxHitColor end
                end)
                fireAbility("Block"); fireAbility("Block")
                fireAbility("Block"); fireAbility("Block")
                spamBlock(0.05)
                if onDetected then onDetected() end
                break
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function checkKillerAttack()
    local killer = KillersFolder:GetChildren()[1]
    if not killer or not killer:IsA("Model") then return end
    hookKillerAnimator(killer)

    local cur = killer:GetAttribute("AbilityLastUsed") or 0
    local used = killer:GetAttribute("AbilitiesUsed") or 0
    if _lastAbilityLastUsed == nil then
        _lastAbilityLastUsed = cur
        _lastAbilitiesUsed = used
        return
    end

    if used > _lastAbilitiesUsed then _blockLocked = true end

    if cur > _lastAbilityLastUsed then
        if _blockLocked then
            _blockLocked = false
        else
            local allowed = true
            if AB.FilterEnabled then
                local name = getKillerAbilityName(killer)
                if name then
                    allowed = matchesAbilityFilter(name)
                else
                    allowed = not AB.FilterStrict
                end
            end
            if allowed then
                task.wait(AB.BlockDelay)
                makeHitboxAndCheck(killer, function() fireAbility("Block") end)
            end
        end
    end
    _lastAbilityLastUsed = cur
    _lastAbilitiesUsed = used
end

RunService.Heartbeat:Connect(function()
    if AB.Enabled then pcall(checkKillerAttack) end
end)

