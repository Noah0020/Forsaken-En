local SA = { Crystal = false, Dusekkar = false, CPred = 2.5, DPred = 0.5, cH = nil, dH = nil }

local function setCrystal(on)
    SA.Crystal = on
    if on and not SA.cH then
        if typeof(hookfunction) ~= "function" or typeof(getcallbackvalue) ~= "function" then
            Notify("SA", "Need hookfunction")
            return
        end
        local ok, rf = pcall(function() return Rep.Modules.Network.Network.RemoteFunction end)
        if not ok or not rf then Notify("SA", "RF missing") return end
        local cam = workspace.CurrentCamera
        SA.cH = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] ~= "GetCameraCF" or not SA.Crystal then
                return SA.cH(table.unpack(args, 1, args.n))
            end
            local killer = nearestKiller(120)
            if killer and LocalRoot then
                local hum = killer:FindFirstChildOfClass("Humanoid")
                local pos = killer.HumanoidRootPart.Position
                if hum and hum.MoveDirection.Magnitude > 0.15 then
                    pos = pos + hum.MoveDirection * SA.CPred
                end
                local cf = CFrame.lookAt(Vector3.zero, (pos - LocalRoot.Position + Vector3.new(0, 1.5, 0)).Unit)
                return CFrame.new(cam.CFrame.Position) * cf.Rotation
            end
            return SA.cH(table.unpack(args, 1, args.n))
        end)
        Notify("SA", "Crystal ON")
    end
end

local function setDusekkar(on)
    SA.Dusekkar = on
    if on and not SA.dH then
        if typeof(hookfunction) ~= "function" or typeof(getcallbackvalue) ~= "function" then
            Notify("SA", "Need hookfunction")
            return
        end
        local ok, rf = pcall(function() return Rep.Modules.Network.Network.RemoteFunction end)
        if not ok or not rf then Notify("SA", "RF missing") return end
        SA.dH = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] == "GetMousePosition" and SA.Dusekkar then
                local killer = nearestKiller(120)
                if killer then
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    local pos = killer.HumanoidRootPart.Position
                    if hum and hum.MoveDirection.Magnitude > 0.05 then
                        pos = pos + hum.MoveDirection * SA.DPred
                    end
                    return pos
                end
            end
            return SA.dH(table.unpack(args, 1, args.n))
        end)
        Notify("SA", "Dusekkar ON")
    end
end

--======= TWO TIME =======
local ABTP = {
    enabled = false, dagger = true, directBehind = false, pred = false,
    rangeMode = "Around", backstabType = "lerp",
    proximity = 8, behindDist = 1.7, lerpSpeed = 0.37,
    delayStab = 0.08, cooldown = 5, duration = 0.35, lastTrigger = 0,
}

task.spawn(function()
    while getgenv().GoldenHubLoaded do
        task.wait(0.12)
        if ABTP.enabled and LocalChar and string.find(LocalChar.Name or "", "TwoTime") and LocalRoot and KillersFolder then
            for _, killer in pairs(KillersFolder:GetChildren()) do
                local khrp = killer:FindFirstChild("HumanoidRootPart")
                if khrp then
                    local dist = (khrp.Position - LocalRoot.Position).Magnitude
                    local should = false
                    if ABTP.rangeMode == "Around" then
                        should = dist <= ABTP.proximity
                    else
                        local rel = LocalRoot.Position - khrp.Position
                        local fwdDot = rel:Dot(khrp.CFrame.LookVector)
                        local angleDot = rel.Magnitude > 0 and rel.Unit:Dot(khrp.CFrame.LookVector) or 0
                        local passed = (ABTP.directBehind and angleDot <= -0.85) or (fwdDot < 0.3)
                        should = passed and (-fwdDot) <= ABTP.proximity and dist <= ABTP.proximity
                    end
                    if should and os.clock() - ABTP.lastTrigger >= ABTP.cooldown then
                        ABTP.lastTrigger = os.clock()
                        task.spawn(function()
                            local targetPos = khrp.Position - khrp.CFrame.LookVector * ABTP.behindDist
                            if ABTP.pred then
                                local hum = killer:FindFirstChildOfClass("Humanoid")
                                if hum and hum.MoveDirection.Magnitude > 0 then
                                    targetPos = targetPos + hum.MoveDirection * 6 * 0.12
                                end
                            end
                            local t0 = os.clock()
                            local conn
                            conn = RS.Heartbeat:Connect(function()
                                if os.clock() - t0 >= ABTP.duration then
                                    conn:Disconnect()
                                    return
                                end
                                if not khrp.Parent or not LocalRoot then return end
                                if ABTP.backstabType == "teleport" then
                                    LocalRoot.CFrame = CFrame.new(targetPos, khrp.Position)
                                else
                                    LocalRoot.CFrame = LocalRoot.CFrame:Lerp(CFrame.new(targetPos, khrp.Position), ABTP.lerpSpeed)
                                end
                            end)
                            if ABTP.dagger then
                                task.wait(ABTP.delayStab)
                                FireAbility("Stab")
                                FireAbility("Backstab")
                            end
                        end)
                        break
                    end
                end
            end
        end
    end
end)

--======= VEE =======
local Vee = { Sk8Control = false, FastSpray = false, SpraySpeed = 0.5, AutoSkate = false }
local ControlActive = false
local ControlConn = nil
local SprayPhase = 0
local SprayBase = nil
local SavedHum = {}

RS.RenderStepped:Connect(function(dt)
    if Vee.Sk8Control then
        if IsPlayingAnim("117058860640843") then
            if not ControlActive and LocalHum then
                ControlActive = true
                SavedHum[LocalHum] = { WalkSpeed = LocalHum.WalkSpeed, AutoRotate = LocalHum.AutoRotate }
                pcall(function()
                    LocalHum.WalkSpeed = 60
                    LocalHum.AutoRotate = false
                end)
                ControlConn = RS.RenderStepped:Connect(function()
                    if not LocalHum or not LocalRoot then return end
                    pcall(function()
                        LocalHum.WalkSpeed = 60
                        LocalHum.AutoRotate = false
                    end)
                    local look = LocalRoot.CFrame.LookVector
                    local flat = Vector3.new(look.X, 0, look.Z)
                    if flat.Magnitude > 0 then LocalHum:Move(flat.Unit) end
                end)
            end
        elseif ControlActive then
            ControlActive = false
            if ControlConn then ControlConn:Disconnect() ControlConn = nil end
            if LocalHum and SavedHum[LocalHum] then
                pcall(function()
                    LocalHum.WalkSpeed = SavedHum[LocalHum].WalkSpeed
                    LocalHum.AutoRotate = true
                    LocalHum:Move(Vector3.zero)
                end)
                SavedHum[LocalHum] = nil
            end
        end
    elseif ControlActive then
        ControlActive = false
        if ControlConn then ControlConn:Disconnect() ControlConn = nil end
    end

    if Vee.FastSpray and IsPlayingAnim("96618767275101") and LocalRoot then
        if not SprayBase or math.abs(math.sin(SprayPhase)) < 0.05 then
            SprayBase = LocalRoot.CFrame
        end
        SprayPhase = SprayPhase + dt * (math.pi * Vee.SpraySpeed)
        LocalRoot.CFrame = SprayBase + SprayBase.LookVector * (-math.sin(SprayPhase) * 2)
    else
        SprayPhase = 0
        SprayBase = nil
    end
end)

