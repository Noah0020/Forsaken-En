local settings = {distance = 100, aimPrediction = 4}
local modules = {}

local function registerTriggerModule(name,enableFunc,disableFunc) modules[name]={enabled=false, enable=enableFunc, disable=disableFunc} end

local function toggleModule(name,state)
    local mod=modules[name]; if not mod then return end
    if state and not mod.enabled then if mod.enable then pcall(mod.enable) end mod.enabled=true
    elseif not state and mod.enabled then if mod.disable then pcall(mod.disable) end mod.enabled=false end
end

