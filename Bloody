    axeEnabled=false, axeLockDur=1.7, axeLocked=false,
    foreverHold=false, foreverThread=nil }
local function jd_buildCamCF(myHRP, kHRP, v0, g)
    local ok, result = pcall(function()
        local hum = myHRP.Parent and myHRP.Parent:FindFirstChildOfClass("Humanoid")
        local hipH = hum and hum.HipHeight or 1.35
        local v238 = (hipH + myHRP.Size.Y/2)/2
        local sp = myHRP.CFrame.Position + Vector3.new(0, v238, 0)
        local vel = getHRPVelocity(kHRP)
        local target = kHRP.Position + vel*jd.prediction + Vector3.new(0, jd.aimOffset, 0)
        local delta = target - sp
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local dx = flat.Magnitude; local dy = delta.Y
        if dx < 0.01 then
            local d = dy >= 0 and Vector3.new(0,1,0) or Vector3.new(0,-1,0)
            return CFrame.new(Workspace.CurrentCamera.CFrame.Position,
                Workspace.CurrentCamera.CFrame.Position + d)
        end
        local flatDir = flat.Unit; local v2 = v0*v0
        local disc = v2*v2 - g*(g*dx*dx + 2*dy*v2)
        local theta = disc < 0 and math.atan2(dy, dx) or math.atan2(v2 - math.sqrt(disc), g*dx)
        local T = math.tan(theta); local denom = 3 + T
        local alpha = math.abs(denom) < 0.0001 and -math.pi/2 or math.atan2(3*T-1, denom)
        local yawCF = CFrame.new(Workspace.CurrentCamera.CFrame.Position,
            Workspace.CurrentCamera.CFrame.Position + flatDir)
        return yawCF * CFrame.Angles(alpha, 0, 0)
    end)
    return ok and result or nil
end

