    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local nearest = nil
    local nearestDist = 40
    -- Ưu tiên killer vừa detect trong NS
    if _lastABKillerRoot and _lastABKillerRoot.Parent then
        nearest = _lastABKillerRoot
    elseif killers then
        for _, k in ipairs(killers:GetChildren()) do
            if k:IsA("Model") then
                local kr = k:FindFirstChild("HumanoidRootPart") or k:FindFirstChild("RootPart")
                if kr then
                    local d = (myRoot.Position - kr.Position).Magnitude
                    if d < nearestDist then nearestDist = d; nearest = kr end
                end
            end
        end
    end
    if not nearest then return end
    local m = Settings.HitboxMultiplier or Settings.RectangleMultiplier or 1
    local size = Vector3.new(6*m, 6*m, 9*m)
    local distVal = Settings.HitboxDistance or Settings.RectangleDistance or 3
    local frozenCFrame = nearest.CFrame * CFrame.new(0, 0, -distVal)
    local hb = Instance.new("Part")
    hb.Name = "AutoBlockHitbox_Green"
    hb.Transparency = Settings.ShowHitboxVisual and (Settings.HitboxTransparency or 0.8) or 1
    hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
    hb.CastShadow = false; hb.Anchored = true
    hb.Size = size
    hb.Color = Color3.fromRGB(0, 255, 0)
    hb.Material = Enum.Material.ForceField
    hb.CFrame = frozenCFrame
    hb.Parent = Workspace
    if Settings.ShowOutline and Settings.ShowHitboxVisual then
        local sb = Instance.new("SelectionBox")
        sb.Adornee = hb
        sb.Color3 = Color3.fromRGB(0, 255, 0)
        sb.LineThickness = 0.04
        sb.Transparency = Settings.OutlineTransparency or 0.6
        sb.Visible = true
        sb.Parent = hb
    end
    Debris:AddItem(hb, 0.45)
end

