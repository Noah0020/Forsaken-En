local function encodeAbility(name)
	local buf = buffer.create(5 + #name)
	buffer.writeu8(buf, 0, 3)
	buffer.writeu32(buf, 1, #name)
	buffer.writestring(buf, 5, name)
	return buf
end
local function useAbility(name)
	RemoteEvent:FireServer("UseActorAbility", { encodeAbility(name) })
end
local function fireRemote(remote, ...)
	if not remote then return end
	if remote:IsA("RemoteFunction") then
		local ok, r = pcall(remote.InvokeServer, remote, ...)
		return ok or r
	end
	if not remote:IsA("RemoteEvent") then return end
	local ok, r = pcall(remote.FireServer, remote, ...)
	return ok or r
end

