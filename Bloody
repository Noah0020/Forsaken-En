safe("Stab", function()
    local IDS={["100725497418533"]=true,["89448354637442"]=true}
    local st={enabled=false,behindStuds=4,lerpDuration=0.4,cooldown=0.6,last=0}
    local function doStab()
        if not st.enabled or IsPlayerKiller() then return end
        local now=tick(); if now-st.last<st.cooldown then return end; st.last=now
        local char=LP.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart")
        local killer=GetNearestKillerModel(40); local kr=killer and killer:FindFirstChild("HumanoidRootPart")
        if not hrp or not kr then return end
        local dur=math.max(0.1,st.lerpDuration); local start=tick()
        while tick()-start<dur do
            if not hrp.Parent or not kr.Parent then break end
            local alpha=math.clamp((tick()-start)/dur,0,1)
            hrp.CFrame=hrp.CFrame:Lerp(kr.CFrame*CFrame.new(0,0,st.behindStuds),alpha)
            RunService.RenderStepped:Wait()
        end
    end
    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.5)
            local char=LP.Character; local hum=char and char:FindFirstChildOfClass("Humanoid")
            local anim=hum and hum:FindFirstChildOfClass("Animator")
            if anim and not char:GetAttribute("NosStabHooked") then
                char:SetAttribute("NosStabHooked",true)
                anim.AnimationPlayed:Connect(function(track)
                    if not st.enabled then return end
                    local id=tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                    if id and IDS[id] then task.spawn(doStab) end
                end)
            end
        end
    end)
    local left=Tabs.Stab:AddLeftGroupbox("Auto Stab","sword")
    left:AddToggle("Stab_Enable",{Text="Enable Auto Stab",Default=false,Callback=function(v) st.enabled=v end})
    left:AddSlider("StabBehind",{Text="Behind Studs",Default=4,Min=1,Max=12,Rounding=1,Callback=function(v) st.behindStuds=v end})
end)

