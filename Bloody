local function solverOn() return MinigameSolver.ManualEnabled or MinigameSolver.Enabled end
local function stillSolving(_, obj) return solverOn() and obj and not obj.Ended end
local function waitForSolver(obj)
    while obj and not obj.Ended and not solverOn() do task.wait(0.05) end
    if not (obj and not obj.Ended and solverOn()) then return false end
    local s = os.clock()
    while obj and not obj.Ended and solverOn() and os.clock()-s < C.genStartDelay do task.wait(0.05) end
    return obj and not obj.Ended and solverOn()
end

local function solveFlowBoard(board)
    if not FlowBoardModule then return nil end
    local size, pairMap = board.Size, board.Pairs
    local occupied, answer = {}, {}
    local dirs = {{-1,0},{1,0},{0,-1},{0,1}}
    local owner = {}
    for color, pair in pairs(pairMap) do owner[pair[1]], owner[pair[2]] = color, color end
    local remaining = {}
    for color in pairs(pairMap) do table.insert(remaining, color) end
    local function cand(color, limit)
        local pair = pairMap[color]; local from, target = pair[1], pair[2]
        local results, path, seen = {}, {from}, {[from]=true}
        local function dist(cell)
            local r,c = FlowBoardModule.ToRowCol(size, cell)
            local tr,tc = FlowBoardModule.ToRowCol(size, target)
            return math.abs(r-tr)+math.abs(c-tc)
        end
        local function walk(cell)
            if #results >= limit then return end
            if cell==target then table.insert(results, table.clone(path)); return end
            local r,c = FlowBoardModule.ToRowCol(size, cell)
            local nxt = {}
            for _,d in ipairs(dirs) do
                local nr,nc = r+d[1], c+d[2]
                if nr>=1 and nr<=size and nc>=1 and nc<=size then
                    local n = FlowBoardModule.ToIndex(size,nr,nc)
                    local o = owner[n]
                    if not seen[n] and not occupied[n] and (not o or (o==color and n==target)) then
                        table.insert(nxt, n)
                    end
                end
            end
            table.sort(nxt, function(a,b) return dist(a)<dist(b) end)
            for _,n in ipairs(nxt) do
                seen[n]=true; table.insert(path,n); walk(n)
                path[#path]=nil; seen[n]=nil
                if #results>=limit then break end
            end
        end
        walk(from)
        table.sort(results, function(a,b) return #a<#b end)
        return results
    end
    local function search(colors)
        if #colors==0 then return true end
        local bi, bp
        for i,color in ipairs(colors) do
            local list = cand(color, 300)
            if #list==0 then return false end
            if not bp or #list<#bp then bi,bp = i,list end
        end
        local color = colors[bi]
        local nc = table.clone(colors); table.remove(nc, bi)
        for _,p in ipairs(bp) do
            for _,cell in ipairs(p) do occupied[cell]=true end
            answer[color]=p
            if search(nc) then return true end
            answer[color]=nil
            for _,cell in ipairs(p) do occupied[cell]=nil end
        end
        return false
    end
    return search(remaining) and answer or nil
end

local function installMinigameHooks()
    if MinigameSolver.Installed then return end
    MinigameSolver.Installed = true
    if LockBoardModule then
        local oldLockNew = LockBoardModule.new
        LockBoardModule.new = function(...)
            local b = oldLockNew(...); MinigameSolver.LockBoard = b; return b
        end
    end
    if FlowInputModule and FlowBoardModule then
        local oldFlowNew = FlowInputModule.new
        FlowInputModule.new = function(board, renderer, callbacks)
            local obj = oldFlowNew(board, renderer, callbacks)
            local tok = MinigameSolver.Generation
            task.spawn(function()
                if not waitForSolver(obj) then return end
                task.wait(C.genFlowDelay)
                local paths = solveFlowBoard(board)
                if not paths then return end
                for color, path in pairs(paths) do
                    if not stillSolving(tok, obj) then return end
                    local draw = board:Begin(path[1]); renderer:Render(); task.wait(C.genFlowDelay)
                    for i=2,#path do
                        if not stillSolving(tok, obj) then return end
                        board:Step(draw, path[i], 0); renderer:Render(); task.wait(C.genFlowDelay)
                    end
                    board:Release(draw, true); renderer:Render(); task.wait(C.genFlowDelay)
                end
                if stillSolving(tok, obj) and board:IsSolved() then
                    obj:__finish(); callbacks.OnSolved()
                end
            end)
            return obj
        end
    end
    if ConnectInputModule then
        local oldC = ConnectInputModule.new
        ConnectInputModule.new = function(board, renderer, callbacks)
            local obj = oldC(board, renderer, callbacks)
            local tok = MinigameSolver.Generation
            task.spawn(function()
                if not waitForSolver(obj) then return end
                task.wait(C.genConnectDelay)
                for blob in pairs(board.Blobs) do
                    if not stillSolving(tok, obj) then return end
                    if not board:GetLink(blob) then
                        local mate = board:GetMate(blob)
                        if mate then board:Connect(blob, mate); renderer:Render(); task.wait(C.genConnectDelay) end
                    end
                end
                if stillSolving(tok, obj) and board:IsSolved() then
                    obj:__finish(); callbacks.OnSolved()
                end
            end)
            return obj
        end
    end
    if GearInputModule then
        local oldG = GearInputModule.new
        GearInputModule.new = function(getCenter, callbacks, enabled)
            local obj = oldG(getCenter, callbacks, enabled)
            local tok = MinigameSolver.Generation
            task.spawn(function()
                if not waitForSolver(obj) then return end
                task.wait(math.max(0.55, C.genGearDelay))
                for _=1,100 do
                    if not stillSolving(tok, obj) then return end
                    callbacks.OnTurn(90); task.wait(C.genGearDelay)
                end
            end)
            return obj
        end
    end
    if LockInputModule then
        local oldL = LockInputModule.new
        LockInputModule.new = function(ui, callbacks)
            local obj = oldL(ui, callbacks)
            local board = MinigameSolver.LockBoard
            local tok = MinigameSolver.Generation
            task.spawn(function()
                if not waitForSolver(obj) then return end
                while stillSolving(tok, obj) and board and not board:IsBroken() do
                    local now = workspace:GetServerTimeNow()
                    if board:IsOnTarget(board:AngleAt(now)) then
                        callbacks.OnPress(); task.wait(math.max(0.08, C.genFlowDelay))
                    else RunService.Heartbeat:Wait() end
                end
            end)
            return obj
        end
    end
end
pcall(installMinigameHooks)

