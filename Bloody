local SPRAY_ID = "96618767275101"
local sprayPhase, sprayBase = 0, nil
local function spraying()
    local h = sk8GetHum(); if not h then return false end
    for _, t in ipairs(h:GetPlayingAnimationTracks()) do
        local ok, id = pcall(function() return tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+") end)
        if ok and id == SPRAY_ID then return true end
