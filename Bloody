local function NoliTrigger()
    if not Settings.Noli_AIM_Enabled or not IsPlayerKiller() then return end
    local target = NoliGetClosestSurvivor(); if not target then return end
    if NoliAim.active then
        NoliAim.endTime = math.max(NoliAim.endTime, tick() + (Settings.Noli_AimDuration or 3.5))
