local Vee = {
    AutoTrick = false, SkateControl = false, CustomStats = false,
    Sk8Speed = 1.15, Sk8StaminaCost = 1.35, Sk8TrickAirborneSpeed = 1.42,
    Sk8BumpPower = 11.9, Sk8TrickStamina = 4, Sk8TrickCooldown = 1,
    _moduleCache = nil, _behaviorModule = nil,
}

local function Vee_GetBehaviorFolder()
    local a = ReplicatedStorage:FindFirstChild("Assets"); if not a then return nil end
    local s = a:FindFirstChild("Survivors"); if not s then return nil end
    return s:FindFirstChild("Veeronica")
end

local function Vee_GetBehaviorModule()
    if Vee._behaviorModule then return Vee._behaviorModule end
    local folder = Vee_GetBehaviorFolder()
    if not folder then return nil end
    local behavior = folder:FindFirstChild("Behavior")
    if not behavior then return nil end
    local ok, m = pcall(function() return require(behavior) end)
    if ok and type(m) == "table" then
        Vee._behaviorModule = m
        return m
    end
    return nil
end

local function Vee_CollectModules()
    local out, seen = {}, {}
    local behavior = Vee_GetBehaviorModule()
    if behavior then
        seen[behavior] = true
        table.insert(out, behavior)
    end
    local folder = Vee_GetBehaviorFolder()
    if folder then
        local cfg = folder:FindFirstChild("Config")
        if cfg and cfg:IsA("ModuleScript") then
            local ok, m = pcall(function() return require(cfg) end)
            if ok and type(m) == "table" and not seen[m] then
                seen[m] = true
                table.insert(out, m)
            end
        end
    end
    if getgc then
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and not seen[t] then
                    if rawget(t, "DisplayName") == "Veeronica" then
                        seen[t] = true
                        table.insert(out, t)
                    end
                end
            end
        end)
    end
    Vee._moduleCache = out
    return out
end

local function Vee_EnsureCache()
    if not Vee._moduleCache then Vee_CollectModules() end
    return Vee._moduleCache
end

local function Vee_SetAll(key, val)
    local mods = Vee._moduleCache or Vee_EnsureCache()
    for _, m in ipairs(mods) do
        pcall(function() m[key] = val end)
        pcall(function() rawset(m, key, val) end)
    end
end

local function Vee_ApplyStats(force)
    if force then
