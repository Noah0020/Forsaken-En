_G.BlockAbilityNames = {
    "PERFORATING", "LACERATE", "EVISCERATE", "CARVING SLASH",
    "STAB", "TAG", "SLASH", "ENRAGED SLASH",
}

local Facing = { enabled = true, required = true, dot = 0.25, maxDist = 40 }
local PunchAfterBlock = { enabled = false, delay = 0.2 }
local _ShuttingDown = false

local BLOCK_NAMES_LOWER = {}
for _, n in ipairs(_G.BlockAbilityNames) do BLOCK_NAMES_LOWER[n:lower()] = true end

local function nameMatchesBlock(raw)
    if type(raw) ~= "string" or raw == "" then return false end
    local l = raw:lower()
    for bn in pairs(BLOCK_NAMES_LOWER) do
        if string.find(l, bn, 1, true) then return true end
    end
    return false
end

local function extractAnimIds(v)
    local out = {}
    if type(v) == "number" then
        table.insert(out, tostring(math.floor(v)))
    elseif type(v) == "string" then
        local id = v:match("%d+")
        if id then table.insert(out, id) end
    elseif type(v) == "table" then
        for _, x in pairs(v) do
            for _, id in ipairs(extractAnimIds(x)) do table.insert(out, id) end
        end
    end
    return out
end

local BLOCK_ANIM_IDS, BLOCK_SOUND_IDS = {}, {}

local function collectBlockAssets(cfg)
    if type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for name, v in pairs(cfg.Animations) do
            if nameMatchesBlock(name) then
                for _, id in ipairs(extractAnimIds(v)) do BLOCK_ANIM_IDS[id] = true end
            end
        end
    end
    for _, field in ipairs({ "Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds" }) do
        if type(cfg[field]) == "table" then
            for name, v in pairs(cfg[field]) do
                if nameMatchesBlock(name) then
                    for _, id in ipairs(extractAnimIds(v)) do BLOCK_SOUND_IDS[id] = true end
                end
            end
        end
    end
end

local function scanKillerFolder(folder)
    if not folder then return end
    for _, sub in ipairs(folder:GetChildren()) do
        if sub:IsA("Folder") then
            for _, cfgName in ipairs({ "Config", "Behavior" }) do
                local mod = sub:FindFirstChild(cfgName)
                if mod and mod:IsA("ModuleScript") then
                    local ok, data = pcall(require, mod)
                    if ok then collectBlockAssets(data) end
                end
            end
        end
    end
end

local function scanAllKillerAssets()
    BLOCK_ANIM_IDS, BLOCK_SOUND_IDS = {}, {}
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    scanKillerFolder(assets:FindFirstChild("Killers"))
    local skins = assets:FindFirstChild("Skins")
    local sk = skins and skins:FindFirstChild("Killers")
    if sk then
        for _, base in ipairs(sk:GetChildren()) do
            if base:IsA("Folder") then scanKillerFolder(base) end
        end
    end
end

task.spawn(scanAllKillerAssets)

local function blockDistanceOK(killer)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not my or not kr then return false end
    return (kr.Position - my.Position).Magnitude < (Facing.maxDist or 40)
end

local function isFacingPlayer(killerRoot, myPos)
    if not Facing.enabled then return true end
    local look = killerRoot.CFrame.LookVector
    local toMe = Vector3.new(myPos.X - killerRoot.Position.X, 0, myPos.Z - killerRoot.Position.Z)
    if toMe.Magnitude < 0.01 then return true end
    return look:Dot(toMe.Unit) >= (Facing.dot or 0.25)
end

local function FireBlockBuffer()
    if IsPlayerKiller() then return end
    FireAbility("Block")
    if PunchAfterBlock.enabled then
        task.delay(PunchAfterBlock.delay or 0.2, function()
            FireAbility("Punch")
        end)
    end
end

local function createBlockBox(killer)
    if IsPlayerKiller() or not killer or killer == LP.Character or not killer.Parent then return end
    local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart")
    if not root then return end
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return end
    if not blockDistanceOK(killer) then return end
    if Facing.required and not isFacingPlayer(root, my.Position) then return end

    local size = Vector3.new(_G.HitboxWidth or 5, _G.HitboxHeight or 6, _G.HitboxLength or 8)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killer }

    task.spawn(function()
        local elapsed = 0
        local duration = _G.HitboxDuration or 0.5
        while killer.Parent and root.Parent and elapsed < duration do
            if IsPlayerKiller() then return end
            local Part = Instance.new("Part")
            Part.Name = "DS_BlockBox"
            Part.Transparency = _G.ShowHitboxVisual and (_G.HitboxTransparency or 0.5) or 1
            Part.CanCollide = false
            Part.CanTouch = false
            Part.CanQuery = true
            Part.Anchored = true
            Part.CastShadow = false
            Part.Size = size
            Part.Color = _G.HitboxColor or Orange
            Part.Material = Enum.Material.ForceField
            local look = root.CFrame.LookVector
            local center = root.Position + look * (size.Z * 0.5)
            Part.CFrame = CFrame.lookAt(center, center + look)
            Part.Parent = Workspace
            if _G.ShowOutline and _G.ShowHitboxVisual then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = Part
                sb.Color3 = Part.Color
                sb.LineThickness = _G.OutlineThickness or 0.01
                sb.Parent = Part
            end
            Debris:AddItem(Part, 0.05)
            for _, v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                local model = v.Parent and (v.Parent:FindFirstAncestorOfClass("Model") or v.Parent)
                local hum = model and model:FindFirstChildOfClass("Humanoid")
                if not hum and v.Parent then
                    hum = v.Parent:FindFirstChildOfClass("Humanoid")
                end
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    if (_G.BlockDelay or 0) > 0 then task.wait(_G.BlockDelay) end
                    FireBlockBuffer()
                    return
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

local blockHookedKillers = {}
local function hookKillerFiltered(killer)
    if not killer or blockHookedKillers[killer] or not killer:IsA("Model") then return end
    if killer == LP.Character then return end
    blockHookedKillers[killer] = true

    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if not id or not BLOCK_ANIM_IDS[id] then return end
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer)
        end)
    end

    local function hookSound(s)
        if not s:IsA("Sound") then return end
        s.Played:Connect(function()
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local sid = tostring(s.SoundId):match("%d+")
            if not sid or not BLOCK_SOUND_IDS[sid] then return end
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer)
        end)
    end
    for _, d in ipairs(killer:GetDescendants()) do hookSound(d) end
    killer.DescendantAdded:Connect(hookSound)

    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        if blockDistanceOK(killer) then createBlockBox(killer) end
    end)
end

task.spawn(function()
    while not _ShuttingDown do
        task.wait(0.5)
        if _G.AutoBlockEnabled and not IsPlayerKiller() then
            local kf = Workspace:FindFirstChild("Players")
            kf = kf and kf:FindFirstChild("Killers")
            if kf then
                for _, k in ipairs(kf:GetChildren()) do
                    if k:IsA("Model") and k ~= LP.Character then
                        hookKillerFiltered(k)
                    end
                end
            end
        end
    end
end)

