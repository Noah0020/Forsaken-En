-- AUTO BLOCK — 3 systems (Flex-inspired)
-- 1) Flux: QueryHitbox / Sound / Anim
-- 2) G1337 Sound react
-- 3) Predictive Box Facing (Box.txt) — block when small box touches you
--═══════════════════════════════════════════════════════════════════
safe("Auto Block", function()
    local State = {
        fluxEnabled = false,
        g1337Enabled = false,
        boxEnabled = false,
        blockDelay = 0,
        lastBlock = 0,
        autoPunch = false,
        punchDelay = 0.3,
        customHitboxSize = Vector3.new(5.2, 6, 5.65),
        customHitboxOffset = CFrame.new(0, 0, -3.5),
        reactTime = 0.01,
    }

    local function canBlock()
        return (os.clock() - State.lastBlock) >= 0.08 and not IsPlayerKiller()
    end

    local function DoBlock(killerOrRoot)
        if not canBlock() then return end
        State.lastBlock = os.clock()
        local root = nil
        if typeof(killerOrRoot) == "Instance" then
            if killerOrRoot:IsA("Model") then
                root = killerOrRoot:FindFirstChild("HumanoidRootPart")
            elseif killerOrRoot:IsA("BasePart") then
                root = killerOrRoot
            end
        end
        if HDT.enabled and root then DragToward(root) end
        local delay = (State.blockDelay or 0)
        if delay > 0 then
            task.delay(delay, function()
                if LP.Character and LP.Character.Parent then FireBlock() end
            end)
        else
            FireBlock()
        end
        if State.autoPunch then
            task.spawn(function()
                task.wait(State.punchDelay or 0.3)
                if not IsPlayerKiller() then FirePunch() end
            end)
        end
    end

    -- Wire BoxFacing touch → block
    BoxFacing.SetTouchCallback(function(killer)
        if State.boxEnabled or State.fluxEnabled then
            DoBlock(killer)
        end
    end)

    -- Attack ID sets (Flex)
    local function IdSet(list)
        local t = {}
        for _, id in ipairs(list) do t[tostring(id)] = true end
        return t
    end
    local AttackSounds = IdSet({
        "100600301396617","101199185291628","101553872555606","105204810054381","108610718831698",
        "111295935549452","113413858159336","117173212095661","119583605486352","12222208","12222216",
        "18511965048","70626755789950","72085713525541","75330693422988","82221759983649","88589682639517",
        "94273783714662","96117920303138","98675142200448","98733709078792",
    })
    local AttackAnimations = IdSet({
        "87259391926321","140703210927645","136007065400978","129843313690921","86709774283672",
        "108807732150251","138040001965654","86096387000557","96959123077498","72722244508749",
    })

    local BlockWatchers = {}
    local function GetLocalQueryHitbox()
        local c = LP.Character
        return c and c:FindFirstChild("QueryHitbox")
    end

    local function TriggerBlockWithHitbox(Killer, QueryHitbox)
        if not State.fluxEnabled or not LP.Character then return end
        local LocalQuery = GetLocalQueryHitbox()
        local my = LP.Character:FindFirstChild("HumanoidRootPart")
        if not my then return end
        local Params = OverlapParams.new()
        Params.FilterType = Enum.RaycastFilterType.Include
        if LocalQuery then
            Params.FilterDescendantsInstances = { LocalQuery }
        else
            Params.FilterDescendantsInstances = { LP.Character }
        end
        for _ = 1, 12 do
            if not State.fluxEnabled or not QueryHitbox.Parent then break end
            local boxCFrame = QueryHitbox.CFrame * State.customHitboxOffset
            local boxSize = State.customHitboxSize * 2.2
            local Hit = Workspace:GetPartBoundsInBox(boxCFrame, boxSize, Params)
            if #Hit > 0 then
                DoBlock(Killer)
                break
            end
            -- also predictive boxes
            if State.boxEnabled or State.fluxEnabled then
                BoxFacing.SetKiller(Killer)
                BoxFacing.TriggerAttack()
            end
            task.wait(0.02)
        end
    end

    local function WatchKiller(Killer)
        if not Killer or BlockWatchers[Killer] or Killer == LP.Character then return end
        local conns = {}
        local QueryHitbox = Killer:FindFirstChild("QueryHitbox")
        if not QueryHitbox then
            task.spawn(function()
                QueryHitbox = Killer:WaitForChild("QueryHitbox", 5)
                if QueryHitbox and State.fluxEnabled then
                    task.spawn(TriggerBlockWithHitbox, Killer, QueryHitbox)
                end
            end)
        elseif State.fluxEnabled then
            task.spawn(TriggerBlockWithHitbox, Killer, QueryHitbox)
        end

        local hum = Killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            table.insert(conns, animator.AnimationPlayed:Connect(function(track)
                if not (State.fluxEnabled or State.g1337Enabled or State.boxEnabled) then return end
                if not track or not track.Animation then return end
                local id = tostring(track.Animation.AnimationId):match("%d+")
                if id and AttackAnimations[id] then
                    BoxFacing.SetKiller(Killer)
                    BoxFacing.TriggerAttack()
                    if State.fluxEnabled and QueryHitbox then
                        task.spawn(TriggerBlockWithHitbox, Killer, QueryHitbox)
                    elseif State.g1337Enabled then
                        task.delay(State.reactTime, function()
