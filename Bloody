-- CHARGE CONTROL (Slash override)
-- ============================================================
local chargeAnimIds = {"106014898538300"}
local ORIGINAL_DASH_SPEED = 60
local chargeControl = { Enabled = false, Active = false, Conn = nil, SavedState = nil }

local function getHumanoid()
    local char = lp.Character
    return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function startChargeOverride()
    if chargeControl.Active then return end
    local hum = getHumanoid()
    if not hum then return end
    chargeControl.Active = true
    local s = { WalkSpeed = hum.WalkSpeed, AutoRotate = hum.AutoRotate }
    pcall(function() s.JumpPower = hum.JumpPower end)
    chargeControl.SavedState = s
    hum.WalkSpeed = ORIGINAL_DASH_SPEED
    hum.AutoRotate = false
    chargeControl.Conn = RunService.RenderStepped:Connect(function()
        local h = getHumanoid()
        if not h then return end
        local rp = h.Parent and h.Parent:FindFirstChild("HumanoidRootPart")
        if not rp then return end
        pcall(function()
            h.WalkSpeed = ORIGINAL_DASH_SPEED
            h.AutoRotate = false
        end)
        local d = rp.CFrame.LookVector
        local hor = Vector3.new(d.X, 0, d.Z)
        h:Move(hor.Magnitude > 0 and hor.Unit or Vector3.new(0,0,0))
    end)
end

local function stopChargeOverride()
    if not chargeControl.Active then return end
    chargeControl.Active = false
    if chargeControl.Conn then chargeControl.Conn:Disconnect(); chargeControl.Conn = nil end
    local hum = getHumanoid()
    if hum and chargeControl.SavedState then
        local s = chargeControl.SavedState
        pcall(function()
            hum.WalkSpeed = s.WalkSpeed or 16
            hum.AutoRotate = s.AutoRotate ~= false
            hum:Move(Vector3.new(0,0,0))
        end)
    end
    chargeControl.SavedState = nil
end

local function detectChargeAnim()
    local hum = getHumanoid()
    if not hum then return false end
    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
        local ok, id = pcall(function()
            return tostring(t.Animation and t.Animation.AnimationId or ""):match("%d+")
        end)
        if ok and id and table.find(chargeAnimIds, id) then return true end
    end
    return false
end

RunService.RenderStepped:Connect(function()
    if not chargeControl.Enabled then
        if chargeControl.Active then stopChargeOverride() end
        return
    end
    local hum = getHumanoid()
    if not hum then
        if chargeControl.Active then stopChargeOverride() end
        return
    end
    if detectChargeAnim() then
        if not chargeControl.Active then startChargeOverride() end
    else
        if chargeControl.Active then stopChargeOverride() end
    end
end)

