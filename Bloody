        local old = mod.new
        hookfunction(mod.new, function(self, vine, ...)
            local qte = old(self, vine, ...)
            task.spawn(function()
                if AZ.inf and qte then pcall(function() qte.FailedAttempts = -math.huge end) end
                if AZ.auto and qte then
                    task.wait(1.2)
                    pcall(function()
                        qte.Progress = 100
                        if qte.Destroy then qte:Destroy() end
                    end)
                end
            end)
            return qte
        end)
        AZ.hooked = true
        return true
    end
