    if not audioBlock.HitboxDragAnim then return end
    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and (hrp.Position - myRoot.Position).Magnitude <= detectionRange then
                if hasLineOfSight(hrp) then
                    local animator = hum:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            local id = tostring(track.Animation.AnimationId):match("%d+")
                            if id and table.find(autoBlockTriggerAnims, id) then
                                if isFacing(myRoot, hrp) then
                                    fireAbility("Block")
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

