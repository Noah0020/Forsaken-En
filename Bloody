                elseif Settings.AutoBlock then
                    local dir = AB.LocalRoot.Position - kr.Position; local mag = dir.Magnitude
                    local abRange = Settings.AntiBaitRange or 15; local abDot = (Settings.AntiBaitFacingCheck == false) and -1 or (Settings.AntiBaitFacingDot or 0.3); local facingOk = true; if abDot > -1 then local fl = Vector3.new(kr.CFrame.LookVector.X,0,kr.CFrame.LookVector.Z); local fd = Vector3.new(dir.X,0,dir.Z); if fl.Magnitude>0.01 and fd.Magnitude>0.01 then facingOk = fl.Unit:Dot(fd.Unit) >= abDot else facingOk = false end end; if mag <= abRange and mag > 0 and facingOk then shouldFire = true end
                end
