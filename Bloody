        Library:Notify({ Title="Stamina", Description="Sprinting module not found", Time=3 })
        return
    end
    Stam.Infinite = v
    if Stam.Infinite then Stam_StartLoop() else Stam_StopLoop() end
end
local function Stam_SetField(field, v)
