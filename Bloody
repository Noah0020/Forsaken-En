    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local kRoot = killer and killer:FindFirstChild("HumanoidRootPart")
    if not kRoot then return end

    if (myRoot.Position - kRoot.Position).Magnitude > Settings.BlockRange then return end
    if not isFacingTarget(myRoot, kRoot) then return end

    local btn = getBlockButton()
    if not btn then return end
    local cd = btn:FindFirstChild("CooldownTime")
    if cd and cd.Text ~= "" then return end

    if Settings.BlockFaceOnBlock then
        myRoot.CFrame = CFrame.lookAt(
            myRoot.Position,
            Vector3.new(kRoot.Position.X, myRoot.Position.Y, kRoot.Position.Z)
        )
    end

    local blockFired = fireBlockNow()
    if blockFired and Settings.HDT and HDT_DragTo then
        task.spawn(function() pcall(HDT_DragTo, kRoot) end)
    end
end

-- Sound hooks
local hookedSounds = setmetatable({}, {__mode = "k"})
local lastSoundFire = setmetatable({}, {__mode = "k"})

local function onSoundTrigger(sound)
    if not AB.running or not Settings.AutoBlock or not Settings.BlockSoundTrigger then return end
    local now = tick()
    if lastSoundFire[sound] and now - lastSoundFire[sound] < 0.04 then return end
    lastSoundFire[sound] = now

    local id = sound.SoundId and tostring(sound.SoundId):match("(%d+)")
    if not id or not TRIGGER_SOUNDS[id] then return end

    local killer = sound:FindFirstAncestorOfClass("Model")
    if killer then tryBlock(killer) end
end

local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    local conn = sound.Played:Connect(function() onSoundTrigger(sound) end)
    sound.Destroying:Once(function()
        hookedSounds[sound] = nil
        lastSoundFire[sound] = nil
        pcall(function() conn:Disconnect() end)
    end)
    if sound.IsPlaying then onSoundTrigger(sound) end
end

-- Anim hooks
local hookedAnims = setmetatable({}, {__mode = "k"})

local function onAnimTrigger(track, killer)
    if not AB.running or not Settings.AutoBlock or not Settings.BlockAnimTrigger then return end
    local anim = track.Animation
    if not anim then return end
    local animId = tostring(anim.AnimationId):match("(%d+)")
    if not animId or not IS_BLOCK_ANIM[animId] then return end
    tryBlock(killer)
end

local function hookKillerAnims(killer)
    if not killer or not killer:IsA("Model") then return end
    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hum then
        task.spawn(function()
            local h = killer:WaitForChild("Humanoid", 5)
            if h and AB.running then hookKillerAnims(killer) end
        end)
        return
    end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        task.spawn(function()
            local a = hum:WaitForChild("Animator", 5)
            if a and AB.running then hookKillerAnims(killer) end
        end)
        return
    end
    if hookedAnims[animator] then return end
    hookedAnims[animator] = true
    table.insert(AB.connections, animator.AnimationPlayed:Connect(function(track)
        onAnimTrigger(track, killer)
    end))
end

