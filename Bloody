RunService.RenderStepped:Connect(function(dt)
    if not v1.fastSpray or not spraying() then sprayPhase = 0; sprayBase = nil; return end
    local hrp = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if not sprayBase or math.abs(math.sin(sprayPhase)) < 0.05 then sprayBase = hrp.CFrame end
    sprayPhase = sprayPhase + dt * (math.pi * v1.spraySpeed)
    local off = math.sin(sprayPhase) * 2
    hrp.CFrame = sprayBase + (sprayBase.LookVector * (-off))
end)

