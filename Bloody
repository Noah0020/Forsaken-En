    end
    for _, name in ipairs({"StatusEffects", "Effects", "Statuses", "Debuffs"}) do
        local container = char:FindFirstChild(name)
        if container and container:FindFirstChild("Helpless") then return true end
    end
    local inGame = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Ingame")
    if inGame then
        local statusFolder = inGame:FindFirstChild("StatusEffects") or inGame:FindFirstChild("Status")
        if statusFolder then
            local myEffects = statusFolder:FindFirstChild(LP.Name) or statusFolder:FindFirstChild(tostring(LP.UserId))
            if myEffects and myEffects:FindFirstChild("Helpless") then return true end
        end
        local myInGame = inGame:FindFirstChild(LP.Name) or inGame:FindFirstChild(tostring(LP.UserId))
        if myInGame and myInGame:FindFirstChild("Helpless") then return true end
    end
    local playerData = LP:FindFirstChild("PlayerData")
    if playerData then
        local status = playerData:FindFirstChild("Status", true)
        if status and status:FindFirstChild("Helpless") then return true end
    end
    return false
end

local function getOrCreateCone(killer)
    local state = ConeState[killer]
    if state and state.folder and state.folder.Parent and #state.parts == ConeConfig.Segments then
        return state
    end
    if state and state.folder then pcall(function() state.folder:Destroy() end) end
    local folder = Instance.new("Folder")
    folder.Name = "Ck_FacingCone"
    folder.Parent = Workspace
    local parts = {}
    for i = 1, ConeConfig.Segments do
        local part = Instance.new("Part")
        part.Name = "ConeSegment"
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Color = ConeConfig.Color
        part.Transparency = 1
        part.Size = Vector3.new(ConeConfig.Thickness, 0.06, 0.5)
        part.Parent = folder
        parts[i] = part
    end
    state = {
        folder = folder, parts = parts,
        currentAngle = ConeConfig.NormalAngle,
        prevYaw = nil, turnDir = 0,
        fired = false, expiresAt = 0,
    }
    ConeState[killer] = state
    return state
end

local function hideCone(state)
    for _, part in ipairs(state.parts) do
        if part and part.Parent then part.Transparency = 1 end
    end
end

local function destroyCone(killer)
    local state = ConeState[killer]
    if state and state.folder then pcall(function() state.folder:Destroy() end) end
    ConeState[killer] = nil
end

local function updateCone(state, killerRoot, dt, colorOverride)
    local cf = killerRoot.CFrame
    local look = cf.LookVector
    local yaw = math.atan2(-look.X, -look.Z)
    if state.prevYaw then
        local diff = math.atan2(math.sin(yaw - state.prevYaw), math.cos(yaw - state.prevYaw))
        if math.abs(diff) > 0.0005 then
            state.turnDir = diff > 0 and 1 or -1
            state.currentAngle = math.min(ConeConfig.MaxAngle, state.currentAngle + math.abs(diff) * ConeConfig.ExpansionSpeed)
        else
            state.currentAngle = math.max(ConeConfig.NormalAngle, state.currentAngle - ConeConfig.RecoverySpeed * dt)
        end
    end
    state.prevYaw = yaw
    local half = ConeConfig.NormalAngle / 2
    local leftAngle, rightAngle = half, half
    if state.turnDir == 1 then leftAngle = state.currentAngle - half
    elseif state.turnDir == -1 then rightAngle = state.currentAngle - half end
    local total = leftAngle + rightAngle
    local segs = ConeConfig.Segments
    local range = ConeConfig.Range
    local center = killerRoot.Position
    local partLen = (range / segs) * 1.6
    for i, part in ipairs(state.parts) do
        local alpha = (i - 0.5) / segs
        local offset = math.rad(-leftAngle + total * alpha)
        local direction = CFrame.Angles(0, yaw + offset, 0).LookVector
        local worldPos = center + direction * range
        part.Size = Vector3.new(ConeConfig.Thickness, 0.06, partLen)
        part.CFrame = CFrame.lookAt(
            Vector3.new(worldPos.X, center.Y + 0.15, worldPos.Z),
            Vector3.new(worldPos.X + direction.X, center.Y + 0.15, worldPos.Z + direction.Z)
        )
        part.Color = colorOverride or ConeConfig.Color
        part.Transparency = ConeConfig.Transparency
    end
    return yaw, leftAngle, rightAngle
end

local function isPlayerInCone(killerRoot, playerPos, yaw, leftAngleDeg, rightAngleDeg)
    local killerPos = killerRoot.Position
    if math.abs(playerPos.Y - killerPos.Y) > ConeConfig.YTolerance then return false end
    local toPlayer = playerPos - killerPos
    local flat = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    local dist = flat.Magnitude
    if dist < 0.5 or dist > ConeConfig.Range then return false end
    local playerYaw = math.atan2(-flat.X, -flat.Z)
    local diff = math.atan2(math.sin(playerYaw - yaw), math.cos(playerYaw - yaw))
    return diff >= -math.rad(leftAngleDeg) and diff <= math.rad(rightAngleDeg)
end

