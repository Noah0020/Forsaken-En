local function HookAnimator(killer, animator)
    if not animator or Watchers.animator[animator] then return end
    Watchers.animator[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        if not killer or not killer.Parent then return end
        local aid = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
        if aid and AutoBlockTriggerAnims[aid] then OnKillerM1(killer, "anim") end
    end)
end

local function HookKillerSound(killer, sound)
    if not sound:IsA("Sound") then return end
    if Watchers.sounds[sound] then return end
    Watchers.sounds[sound] = true
    local function handler()
        if not killer or not killer.Parent then return end
        local sid = tostring(sound.SoundId):match("%d+")
        if sid and AutoBlockTriggerSounds[sid] then OnKillerM1(killer, "sound") end
    end
    sound.Played:Connect(handler)
    sound.Playing:Connect(handler)
    if sound.IsPlaying then handler() end
end

local function HookKillerAll(killer)
    if not killer:IsA("Model") or Watchers.hookedKillers[killer] then return end
    Watchers.hookedKillers[killer] = true

    local hum = killer:FindFirstChildOfClass("Humanoid")
    if hum then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then HookAnimator(killer, animator) end
        hum.ChildAdded:Connect(function(c)
            if c:IsA("Animator") then HookAnimator(killer, c) end
        end)
    end
    for _, d in ipairs(killer:GetDescendants()) do
        if d:IsA("Sound") then HookKillerSound(killer, d) end
    end
    killer.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then HookKillerSound(killer, d) end
        if d:IsA("Humanoid") then
            local a = d:FindFirstChildOfClass("Animator")
            if a then HookAnimator(killer, a) end
            d.ChildAdded:Connect(function(c)
                if c:IsA("Animator") then HookAnimator(killer, c) end
            end)
        end
    end)
    if not AB.perKiller[killer] then AB.perKiller[killer] = { lastFireAt = 0 } end
    pcall(function()
        killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
            OnKillerM1(killer, "attr")
        end)
    end)
end

