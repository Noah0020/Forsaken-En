local HDT = { enabled=false, speed=40, delay=0.05, duration=0.6, debounce=false }
local HDT_BLOCK_ANIM_IDS, HDT_BLOCK_SOUND_IDS = {}, {}
local HDT_animConn, HDT_soundConns = nil, {}

local function HDT_NearestKiller() return GetNearestKillerModel() end

local function HDT_Dash(target)
    if IsPlayerKiller() or not HDT.enabled or HDT.debounce then return end
    if not target or not target.Parent then return end
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local targetHRP=target:FindFirstChild("HumanoidRootPart"); if not targetHRP then return end
    if HDT.delay>0 then task.wait(HDT.delay); if not HDT.enabled or IsPlayerKiller() then return end end
    if (targetHRP.Position-hrp.Position).Magnitude<2.5 then return end
    local originalWS, originalAR = hum.WalkSpeed, hum.AutoRotate
    local speed, duration = math.max(1,HDT.speed), math.max(0.1,HDT.duration)
    local startTime=tick()
    HDT.debounce=true
    hum.WalkSpeed=speed; hum.AutoRotate=false
    local conn
    local function cleanup()
        if conn then pcall(function() conn:Disconnect() end); conn=nil end
        HDT.debounce=false
        if hum and hum.Parent then
            pcall(function() hum.WalkSpeed=originalWS; hum.AutoRotate=originalAR; hum:Move(Vector3.zero,false) end)
        end
    end
    conn=RunService.Heartbeat:Connect(function()
        if IsPlayerKiller() or not HDT.enabled or not char.Parent then cleanup(); return end
        local cur=target:FindFirstChild("HumanoidRootPart"); if not cur then cleanup(); return end
        if tick()-startTime>=duration then cleanup(); return end
        hum.WalkSpeed=speed
        local flat=Vector3.new(cur.Position.X-hrp.Position.X,0,cur.Position.Z-hrp.Position.Z)
        if flat.Magnitude<=2 then cleanup(); return end
        local look=CFrame.lookAt(hrp.Position, hrp.Position+flat.Unit)
        hrp.CFrame=CFrame.new(hrp.Position)*look.Rotation
        hum:Move(flat.Unit,false)
    end)
    task.delay(duration+0.5, function() if HDT.debounce then cleanup() end end)
end

local function HDT_TriggerFromBlock()
    if not HDT.enabled or IsPlayerKiller() or HDT.debounce then return end
    local killer=HDT_NearestKiller(); if not killer then return end
    task.spawn(function() HDT_Dash(killer) end)
end

local function attachHDTWatcher(char)
    if HDT_animConn then pcall(function() HDT_animConn:Disconnect() end); HDT_animConn=nil end
    for _,c in ipairs(HDT_soundConns) do pcall(function() c:Disconnect() end) end
    HDT_soundConns={}
    if IsPlayerKiller() then return end
    local hum=char:WaitForChild("Humanoid",5); if not hum then return end
    local animator=hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator",3)
    if animator then
        HDT_animConn=animator.AnimationPlayed:Connect(function(track)
            if not HDT.enabled or IsPlayerKiller() then return end
            local name=tostring(track.Animation and track.Animation.Name or ""):upper()
            local id=tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if name:find("BLOCK") or (id and HDT_BLOCK_ANIM_IDS[id]) then
                HDT_TriggerFromBlock()
            end
        end)
    end
end

local function HDT_Start()
    if IsPlayerKiller() then return end
    if LP.Character then attachHDTWatcher(LP.Character) end
end
local function HDT_Stop()
    HDT.enabled=false; HDT.debounce=false
    if HDT_animConn then pcall(function() HDT_animConn:Disconnect() end); HDT_animConn=nil end
    for _,c in ipairs(HDT_soundConns) do pcall(function() c:Disconnect() end) end
    HDT_soundConns={}
end

