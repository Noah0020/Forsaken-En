    if Vee.FastSpray and IsPlayingAnim("96618767275101") and root then
        if not SprayBase or math.abs(math.sin(SprayPhase)) < 0.05 then SprayBase = root.CFrame end
        SprayPhase = SprayPhase + dt * (math.pi * (Vee.SpraySpeed or 0.5))
