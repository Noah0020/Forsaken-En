local NOLI_VOIDRUSH_ANIM_IDS = {
    ["93841120533318"] = true, ["91758760621955"] = true, ["85568995953372"] = true,
}
local NoliAim = {
    active=false, endTime=0, conn=nil, pathFolder=nil,
    segments={}, waypoints={}, currentWaypoint=1,
    lastPathUpdate=0, lastRetarget=0, currentTarget=nil,
