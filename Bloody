local function loadDoggysakenConfig()
    if type(readfile) ~= "function" or type(isfile) ~= "function" or not isfile(DOGGYSAKEN_CONFIG_PATH) then
        configNotify("Config not found", "Save a config first, or check executor file API support.")
        return
    end
    local ok, err = pcall(function()
        local decoded = HttpService:JSONDecode(readfile(DOGGYSAKEN_CONFIG_PATH))
        local restored = configRestoreValue(decoded)
        ApplyLoadedConfig(restored)
        syncLoadedControls()
    end)
    if ok then
        configNotify("Config loaded", DOGGYSAKEN_CONFIG_PATH)
    else
        configNotify("Load failed", tostring(err))
        warn("[Doggysaken] Config load failed: " .. tostring(err))
    end
end

