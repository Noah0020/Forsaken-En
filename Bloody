local function safeLoad(url, label)
    local okFetch, src = pcall(function() return game:HttpGet(url) end)
    if not okFetch or not src or #src < 100 then
        warn("[Cupcake] Failed to download " .. label .. ": " .. tostring(src or "empty"))
        return nil
    end
    local okFn, chunkOrErr = pcall(function() return loadstring(src) end)
    if not okFn or not chunkOrErr then
        warn("[Cupcake] Failed to compile " .. label .. ": " .. tostring(chunkOrErr))
        return nil
    end
    local okCall, lib = pcall(chunkOrErr)
    if not okCall or not lib then
        warn("[Cupcake] Failed to init " .. label .. ": " .. tostring(lib))
        return nil
    end
    print("[Cupcake] Loaded " .. label)
    return lib
end

