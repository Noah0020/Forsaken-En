}
local MinigameSolver = {
    Enabled = false, ManualEnabled = false, Generation = 0,
    LockBoard = nil, Installed = false, Available = false,
}
local MinigameFolder, ModulesMinigames
local FlowBoardModule, LockBoardModule
local FlowInputModule, GearInputModule, LockInputModule, ConnectInputModule
pcall(function()
