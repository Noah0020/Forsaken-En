local function NoliClearPath()
    for _, seg in ipairs(NoliAim.segments) do
        if seg and seg.Parent then pcall(function() seg:Destroy() end) end
    end
    NoliAim.segments = {}; NoliAim.waypoints = {}; NoliAim.currentWaypoint = 1
end
local function NoliGroundPos(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignored = {}
    if NoliAim.pathFolder then table.insert(ignored, NoliAim.pathFolder) end
    if LP.Character then table.insert(ignored, LP.Character) end
    params.FilterDescendantsInstances = ignored
    local res = Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -100, 0), params)
    if res then return Vector3.new(pos.X, res.Position.Y + 0.08, pos.Z) end
    return pos
end
local function NoliDrawSegment(a, b)
    local ga = NoliGroundPos(a); local gb = NoliGroundPos(b)
    local diff = gb - ga; local len = diff.Magnitude
    if len < 0.1 then return end
    local color = ParseColor(Settings.Noli_LineColor, 255, 0, 0)
    local thickness = Settings.Noli_LineThickness or 0.22
    local seg = Instance.new("Part")
    seg.Name = "NoliPathSeg"
    seg.Anchored = true; seg.CanCollide = false
    seg.CanTouch = false; seg.CanQuery = false; seg.CastShadow = false
    seg.Material = Enum.Material.Neon; seg.Color = color
    seg.Size = Vector3.new(thickness, 0.035, len)
    seg.CFrame = CFrame.lookAt((ga + gb) / 2, gb) * CFrame.Angles(math.rad(90), 0, 0)
    seg.Parent = NoliAim.pathFolder
    table.insert(NoliAim.segments, seg)
end
local function NoliGetClosestSurvivor()
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local sf = GetSurvivorsFolder(); if not sf then return nil end
    local best, bestD = nil, Settings.Noli_MaxRange or 500
    for _, s in ipairs(sf:GetChildren()) do
        if s:IsA("Model") and s ~= myChar then
            local sHRP = s:FindFirstChild("HumanoidRootPart")
            local sHum = s:FindFirstChildOfClass("Humanoid")
            if sHRP and sHum and sHum.Health > 0 then
                local d = (sHRP.Position - myHRP.Position).Magnitude
                if d < bestD then bestD = d; best = s end
            end
        end
    end
    return best
end
local function NoliBuildPath()
    if not NoliAim.active then return end
    if not NoliAim.currentTarget or not NoliAim.currentTarget.Parent then
        NoliAim.currentTarget = NoliGetClosestSurvivor()
        if not NoliAim.currentTarget then NoliClearPath(); return end
    end
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tgt = NoliAim.currentTarget
    local tgtHRP = tgt and tgt:FindFirstChild("HumanoidRootPart")
    if not myHRP or not tgtHRP then NoliClearPath(); return end
    NoliClearPath()
    if Settings.Noli_UseStraight then NoliDrawSegment(myHRP.Position, tgtHRP.Position); return end
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, AgentHeight = 5,
        AgentCanJump = false, AgentCanClimb = false,
        WaypointSpacing = 2,
    })
    local ok = pcall(function() path:ComputeAsync(myHRP.Position, tgtHRP.Position) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        NoliDrawSegment(myHRP.Position, tgtHRP.Position); return
    end
    NoliAim.waypoints = path:GetWaypoints()
    NoliAim.currentWaypoint = 1
    for i = 1, #NoliAim.waypoints - 1 do
        NoliDrawSegment(NoliAim.waypoints[i].Position, NoliAim.waypoints[i+1].Position)
    end
end
local function NoliGetAimPoint(hrp)
    if Settings.Noli_UseStraight then
        local tgt = NoliAim.currentTarget
        local tHRP = tgt and tgt.Parent and tgt:FindFirstChild("HumanoidRootPart")
        if tHRP then return tHRP.Position end
        return nil
    end
    local wps = NoliAim.waypoints
    if #wps == 0 then
        local tgt = NoliAim.currentTarget
        local tHRP = tgt and tgt.Parent and tgt:FindFirstChild("HumanoidRootPart")
        if tHRP then return tHRP.Position end
        return nil
    end
    local closestIdx, closestD = 1, math.huge
    for i = 1, #wps do
        local d = (wps[i].Position - hrp.Position).Magnitude
        if d < closestD then closestD = d; closestIdx = i end
    end
    while closestIdx < #wps and (wps[closestIdx].Position - hrp.Position).Magnitude < 4 do
        closestIdx = closestIdx + 1
    end
    if closestD < 10 and closestIdx < #wps then return wps[closestIdx + 1].Position end
    return wps[closestIdx].Position
end
local function NoliAimStop()
    if NoliAim.conn then pcall(function() NoliAim.conn:Disconnect() end); NoliAim.conn = nil end
    NoliClearPath()
    NoliAim.active = false; NoliAim.currentTarget = nil
    NoliAim.smoothDir = nil; NoliAim.cameWithin = nil
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum:Move(Vector3.zero, false); hum.AutoRotate = true
            if NoliAim.savedWalkSpeed then hum.WalkSpeed = NoliAim.savedWalkSpeed end
        end)
    end
    NoliAim.savedWalkSpeed = nil
end
local function NoliAimStep(dt)
    if not NoliAim.active then return end
    if tick() >= NoliAim.endTime then NoliAimStop(); return end
    local char = LP.Character; if not char then NoliAimStop(); return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then NoliAimStop(); return end
    hum.AutoRotate = false
    hum.WalkSpeed = Settings.Noli_MoveSpeed or 45
    if tick() - (NoliAim.lastRetarget or 0) > 0.2 then
        NoliAim.lastRetarget = tick()
        local tgt = NoliAim.currentTarget
        local tgtHum = tgt and tgt.Parent and tgt:FindFirstChildOfClass("Humanoid")
        local tgtHRP = tgt and tgt.Parent and tgt:FindFirstChild("HumanoidRootPart")
        local needRetarget = (not tgt) or (not tgtHRP) or (not tgtHum) or (tgtHum.Health <= 0)
        if not needRetarget and tgtHRP then
            local curDist = (tgtHRP.Position - hrp.Position).Magnitude
            if curDist < 10 then NoliAim.cameWithin = curDist
            elseif NoliAim.cameWithin and NoliAim.cameWithin < 10 and curDist > 20 then needRetarget = true end
        end
        if needRetarget then
            local newTgt = NoliGetClosestSurvivor()
            if newTgt and newTgt ~= tgt then
                NoliAim.currentTarget = newTgt
                NoliAim.cameWithin = nil; NoliAim.smoothDir = nil; NoliAim.lastPathUpdate = 0
            end
        end
    end
    if tick() - NoliAim.lastPathUpdate > 0.25 then
        NoliAim.lastPathUpdate = tick(); NoliBuildPath()
    end
    local aimPos = NoliGetAimPoint(hrp)
    if not aimPos then
        local tgt = NoliAim.currentTarget
        local tHRP = tgt and tgt.Parent and tgt:FindFirstChild("HumanoidRootPart")
        if tHRP then aimPos = tHRP.Position end
    end
    if not aimPos then NoliAimStop(); return end
    local targetDir = aimPos - hrp.Position
    targetDir = Vector3.new(targetDir.X, 0, targetDir.Z)
    if targetDir.Magnitude < 0.1 then return end
    targetDir = targetDir.Unit
    if not NoliAim.smoothDir then
        NoliAim.smoothDir = targetDir
    else
        local turnRate = Settings.Noli_TurnSmoothness or 10
        local alpha = 1 - math.exp(-dt * turnRate)
        NoliAim.smoothDir = NoliAim.smoothDir:Lerp(targetDir, alpha)
        if NoliAim.smoothDir.Magnitude > 0.01 then NoliAim.smoothDir = NoliAim.smoothDir.Unit end
    end
    pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + NoliAim.smoothDir) end)
    pcall(function() hum:Move(NoliAim.smoothDir, false) end)
end
