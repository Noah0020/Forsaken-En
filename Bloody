local KillerF = {
    AutoM1 = false,
    FacingCheck = false,
    AutoLock = false,
    AimMethod = "HRP",
    LockDuration = 0.7,
    Smoothness = 0.05,
    Prediction = 0.1,
    Distance = 15,
    AutoDodge = false,
    DodgeRadius = 18,
    DodgeCooldown = 0.8,
    lastDodge = 0,
    HitboxExpander = false,
    HitboxDistance = 10,
    HitboxMode = "Distance",
    lastM1 = 0,
    m1Cooldown = 0.45,
}

local function Killer_GetNearestSurvivor(maxDist)
    local char = LP.Character
    local my = char and char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local sf = Workspace:FindFirstChild("Players")
    sf = sf and sf:FindFirstChild("Survivors")
    if not sf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(sf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best, bd
end

local function Killer_IsFacing(myRoot, targetPos)
    local look = myRoot.CFrame.LookVector
    local to = Vector3.new(targetPos.X - myRoot.Position.X, 0, targetPos.Z - myRoot.Position.Z)
    if to.Magnitude < 0.01 then return true end
    return look:Dot(to.Unit) >= 0.35
end

local function Killer_AimAt(targetRoot, duration)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetRoot then return end
    local t0 = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if os.clock() - t0 > (duration or 0.7) or not targetRoot.Parent then
            if conn then conn:Disconnect() end
            return
        end
        if not hrp.Parent then return end
        local pos = targetRoot.Position + targetRoot.AssemblyLinearVelocity * (KillerF.Prediction or 0.1)
        local flat = Vector3.new(pos.X, hrp.Position.Y, pos.Z)
        local method = KillerF.AimMethod or "HRP"
        if method == "HRP" or method == "HRP + Camera Lock" then
            if (flat - hrp.Position).Magnitude > 0.05 then
                hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, flat), KillerF.Smoothness or 0.05)
            end
        end
        if method == "Camera Lock" or method == "HRP + Camera Lock" then
            local cam = Workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pos), KillerF.Smoothness or 0.05)
            end
        end
    end)
end

local function Killer_FireM1()
    FireAbility("Slash")
    FireAbility("Punch")
    FireAbility("M1")
    FireAbility("Attack")
end

RunService.Heartbeat:Connect(function()
    if not KillerF.AutoM1 or not IsPlayerKiller() then return end
    local now = tick()
    if now - (KillerF.lastM1 or 0) < (KillerF.m1Cooldown or 0.45) then return end
    local target, dist = Killer_GetNearestSurvivor(KillerF.Distance or 15)
    if not target then return end
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local tr = target:FindFirstChild("HumanoidRootPart")
    if not my or not tr then return end
    if KillerF.FacingCheck and not Killer_IsFacing(my, tr.Position) then return end
    KillerF.lastM1 = now
    if KillerF.AutoLock then
        Killer_AimAt(tr, KillerF.LockDuration or 0.7)
    end
    Killer_FireM1()
end)

