local _remote = nil
local function getRemote()
    if _remote and _remote.Parent then return _remote end
    local ok, re = pcall(function()
        return ReplicatedStorage:WaitForChild("Modules", 8)
            :WaitForChild("Network", 5)
            :WaitForChild("Network", 5)
            :WaitForChild("RemoteEvent", 5)
    end)
    if ok and re then _remote = re return re end
    return nil
end

local function FireAbility(name)
    local remote = getRemote()
    if not remote then return false end
    return pcall(function()
        local buf = buffer.create(5 + #name)
        buffer.writeu8(buf, 0, 3)
        buffer.writeu32(buf, 1, #name)
        buffer.writestring(buf, 5, name)
        remote:FireServer("UseActorAbility", {buf})
    end)
end

local function fireBlock()
    return FireAbility("Block")
end

local function FirePunch()
    return FireAbility("Punch")
end

