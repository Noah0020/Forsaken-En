-- SILENT AIM — physics-based projectile prediction
--═══════════════════════════════════════════════════════════
local SilentAimConfig = {
    CorruptNature = {Enabled = false, Speed = 60, Label = "c00lkidd - Corrupt Nature"},
    PlasmaBeam    = {Enabled = false, Speed = 200, Label = "Dusekkar - Plasma Beam"},
    CrystalPitch  = {Enabled = false, Speed = 50, ThrowDistance = 4, ThrowDown = 2.5, Label = "Jane Doe - Crystal Pitch"},
}

local hasHookSupport = (type(hookmetamethod)=="function" and type(getnamecallmethod)=="function" and type(checkcaller)=="function")

local function anySilentEnabled()
    for _,c in pairs(SilentAimConfig) do if c.Enabled then return true end end
    return false
end

local function identifyAbilityInValue(v)
    if type(v)=="string" then
        local l=v:lower()
        if l:find("corrupt") or l:find("corruptnature") then return "CorruptNature" end
        if l:find("plasma") or l:find("plasmabeam") then return "PlasmaBeam" end
        if l:find("crystal") or l:find("crystalpitch") then return "CrystalPitch" end
    elseif typeof(v)=="buffer" then
        local size=buffer.len(v); if size>256 then size=256 end
        local str=""
        for i=0,size-1 do
            local ok,b=pcall(function() return buffer.readu8(v,i) end)
            if ok and b and b>=32 and b<=126 then str=str..string.char(b) end
        end
        return identifyAbilityInValue(str)
    elseif type(v)=="table" then
        for _,item in ipairs(v) do local f=identifyAbilityInValue(item) if f then return f end end
    end
    return nil
end

local function getTargetForAbility(abilityName)
    local char=LP.Character; if not char then return nil end
    local myHRP=char:FindFirstChild("HumanoidRootPart"); if not myHRP then return nil end
    local targetFolder
    if abilityName=="CrystalPitch" then targetFolder=workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Killers")
    else targetFolder=workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Survivors") end
    if not targetFolder then return nil end
    local best,bd=nil,600
    for _,m in ipairs(targetFolder:GetChildren()) do
        if m:IsA("Model") and m~=char then
            local trg=m:FindFirstChild("HumanoidRootPart") local h=m:FindFirstChildOfClass("Humanoid")
            if trg and h and h.Health>0 then local d=(trg.Position-myHRP.Position).Magnitude if d<bd then bd=d best=trg end end
        end
    end
    return best
end

local function computePrediction(targetHRP, projectileSpeed)
    local char = LP.Character; if not char or not targetHRP then return nil end
    local myHRP = char:FindFirstChild("HumanoidRootPart"); if not myHRP then return nil end
    local tp = targetHRP.Position
    local tv = targetHRP.AssemblyLinearVelocity or Vector3.zero
    if tv.Magnitude > 150 then tv = tv.Unit * 150 end
    local leadPos = tp
    for _ = 1, 3 do
        local dist = (leadPos - myHRP.Position).Magnitude
        local t = dist / math.max(projectileSpeed, 1)
        leadPos = tp + tv * t
    end
    return leadPos
end

local function getAimPositionForAbility(ability, targetHRP)
    local cfg = SilentAimConfig[ability]
    if not cfg or not targetHRP then return targetHRP and targetHRP.Position end
    if ability == "CrystalPitch" then
        local kLook = targetHRP.CFrame.LookVector
        local flat = Vector3.new(kLook.X, 0, kLook.Z)
        if flat.Magnitude < 0.01 then
            local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then flat = Vector3.new(targetHRP.Position.X - myHRP.Position.X, 0, targetHRP.Position.Z - myHRP.Position.Z) end
        end
        if flat.Magnitude < 0.01 then flat = Vector3.new(1, 0, 0) else flat = flat.Unit end
        return targetHRP.Position + flat * (cfg.ThrowDistance or 4) - Vector3.new(0, cfg.ThrowDown or 2.5, 0)
    end
    return computePrediction(targetHRP, cfg.Speed) or targetHRP.Position
end

local function rewriteAimInValue(v, aimOrigin, aimTarget)
    local t=typeof(v)
    if t=="CFrame" then
        local origin=v.Position
        local dir=aimTarget-origin
        if dir.Magnitude>0.1 then return CFrame.lookAt(origin,origin+dir.Unit), true end
        return v, false
    elseif t=="Vector3" then
        if v.Magnitude<5 then
            local dir=aimTarget-aimOrigin
            if dir.Magnitude>0.1 then return dir.Unit, true end
        else
            return aimTarget, true
        end
        return v, false
    elseif type(v)=="table" then
        local sub,mod=table.clone(v),false
        for k,item in pairs(sub) do
            local newV,changed=rewriteAimInValue(item,aimOrigin,aimTarget)
            if changed then sub[k]=newV mod=true end
        end
        return sub, mod
    end
    return v, false
end

if hasHookSupport then
    local oldNamecall
    local ok = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if checkcaller() or method ~= "FireServer" then
                return oldNamecall(self, ...)
            end
            if typeof(self) ~= "Instance" or not self:IsA("RemoteEvent") then
                return oldNamecall(self, ...)
            end
            if not anySilentEnabled() then
                return oldNamecall(self, ...)
            end
            local ok2, newArgs = pcall(function()
                local args = {...}
                local ability
                for _, a in ipairs(args) do ability = identifyAbilityInValue(a) if ability then break end end
                if not ability or not SilentAimConfig[ability] or not SilentAimConfig[ability].Enabled then return nil end
                local targetHRP = getTargetForAbility(ability)
                if not targetHRP then return nil end
                local char = LP.Character
                local myHRP = char and char:FindFirstChild("HumanoidRootPart")
                if not myHRP then return nil end
                local aimPos = getAimPositionForAbility(ability, targetHRP)
                local newArgs = {}
                local anyMod = false
                for i, a in ipairs(args) do
                    local newV, changed = rewriteAimInValue(a, myHRP.Position, aimPos)
                    newArgs[i] = changed and newV or a
                    anyMod = anyMod or changed
                end
                if anyMod then return newArgs end
                return nil
            end)
            if ok2 and newArgs then
                return oldNamecall(self, table.unpack(newArgs))
            end
            return oldNamecall(self, ...)
        end)
    end)
    if not ok then hasHookSupport = false end
end

