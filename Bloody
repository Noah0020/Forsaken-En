    GuestAutoParry.character = nil
    GuestAutoParry.monitored = setmetatable({}, { __mode = "k" })
    GuestAutoParry.lastTriggered = setmetatable({}, { __mode = "k" })
end

local function guestFirePunch()
    local remote = AB.RemoteEvent or testRemote
    if not remote then return end
    pcall(function()
        -- Match the supplied Auto Parry snippet's ability payload.
        remote:FireServer("UseActorAbility", { "Punch" })
    end)
end

local function monitorGuestBlockSound(sound, character, triggerWhenAdded)
    if not GuestAutoParry.enabled or not isLocalGuestCharacter(character) then return end
    if not sound or not sound:IsA("Sound") or GuestAutoParry.monitored[sound] then return end
    local soundId = string_match(tostring_ref(sound.SoundId), "%d+")
    if not soundId or not guestBlockStartSounds[soundId] then return end
    GuestAutoParry.monitored[sound] = true
    local function schedulePunch()
        if not GuestAutoParry.enabled or lp.Character ~= character then return end
        if not isLocalGuestCharacter(character) then return end
        local now = os.clock()
        local previous = GuestAutoParry.lastTriggered[sound] or 0
        if now - previous < 2.1 then return end
        GuestAutoParry.lastTriggered[sound] = now
        task.delay(2, function()
            if GuestAutoParry.enabled and lp.Character == character and isLocalGuestCharacter(character) then
                guestFirePunch()
            end
        end)
    end
    if triggerWhenAdded then schedulePunch() end
    -- Existing Sound instances may be reused, so also watch their Played event.
    local connection = sound.Played:Connect(schedulePunch)
    table.insert(GuestAutoParry.connections, connection)
end

local function bindGuestAutoParry(character)
    disconnectGuestAutoParry()
    if not GuestAutoParry.enabled or not character or not isLocalGuestCharacter(character) then return end
    GuestAutoParry.character = character
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Sound") then monitorGuestBlockSound(descendant, character, false) end
    end
    table.insert(GuestAutoParry.connections, character.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Sound") then monitorGuestBlockSound(descendant, character, true) end
    end))
end

function GuestAutoParry.setEnabled(enabled)
    GuestAutoParry.enabled = enabled == true
    bindGuestAutoParry(lp.Character)
end

