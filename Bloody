local function setupESP(cfg)
    local tbl = { Instances = {}, Connections = {} }
    local function try(inst)
        if not cfg.valid(inst) then return end
        if not tbl.Instances[inst] then tbl.Instances[inst] = true; addESP(inst, cfg.highlightType) end
        if not cfg.removalSignal then
            inst.Destroying:Connect(function() tbl.Instances[inst] = nil end)
        elseif cfg.removalSignal == "Changed" then
            local nv = inst:FindFirstChildOfClass("NumberValue")
            if nv then
                nv:Connect(function(v)
                    if cfg.removalCheck and cfg.removalCheck(v) then
                        for _, nm in ipairs({ "__SESP", "__SBB" }) do
                            local c = inst:FindFirstChild(nm, true); if c then c:Destroy() end
                        end
                        tbl.Instances[inst] = nil
                    end
                end)
            end
        end
    end
    for _, d in pairs(cfg.container:GetDescendants()) do v6(); task.spawn(try, d) end
    tbl.Connections.Added = cfg.container[cfg.addedSignal]:Connect(function(d) v6(); task.spawn(try, d) end)
    tbl.Cleanup = function()
        if tbl.Connections.Added then tbl.Connections.Added:Disconnect(); tbl.Connections.Added = nil end
        for _, c in pairs(tbl.Connections) do
            if typeof(c) == "RBXScriptConnection" and c.Connected then c:Disconnect() end
        end
        for k in pairs(tbl.Instances) do
            for _, nm in ipairs({ "__SESP", "__SBB" }) do
                local c = k:FindFirstChild(nm, true); if c then c:Destroy() end
            end
            tbl.Instances[k] = nil
        end
        table.clear(tbl.Connections); table.clear(tbl.Instances)
    end
    return tbl
end

-- AIMBOT HELPERS
local t11 = {
    aimPrediction = 0.3, aimEasing = 0.95, lookAngle = 0.7071, aimCooldown = false,
    GetDistanceFrom = function(self, p)
        if Character and Character.PrimaryPart then
            return (Character.PrimaryPart.Position - p.Position).Magnitude
        end
        return math.huge
    end,
    GetDirectionFrom = function(self, p, rev)
        if Character and Character.PrimaryPart then
            return ((rev and p.Position or Character.PrimaryPart.Position) -
                    (rev and Character.PrimaryPart.Position or p.Position)).Unit
        end
        return -1
    end,
    PredictNextPosition = function(self, p)
        return p.Position + p.AssemblyLinearVelocity * t11.aimPrediction
    end,
    PartLookingAtUser = function(self, p, rev)
        if not Character or not Character.PrimaryPart then return false end
        local d = self:GetDirectionFrom(p, rev)
        return (rev and Character.PrimaryPart.CFrame.LookVector or p.CFrame.LookVector):Dot(d) >= self.lookAngle
    end,
    Aimbot = function(self, target, dur)
        if not Character or not Character.PrimaryPart or not target or not target.Parent then return end
        if self.aimCooldown then return end
        self.aimCooldown = true
        local start = os.clock()
        local root = Character.PrimaryPart
        local conn
        conn = RunService.PostSimulation:Connect(function()
            if os.clock() - start >= dur or not target or not target.Parent then
                self.aimCooldown = false; conn:Disconnect(); return
            end
            local pred = self:PredictNextPosition(target)
            local flat = Vector3.new(pred.X, root.Position.Y, pred.Z)
            if root.Position == flat then return end
            root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, flat), self.aimEasing)
        end)
    end
}

