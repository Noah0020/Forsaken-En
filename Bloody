    conn = RunService.RenderStepped:Connect(function(dt)
        if not ABT.running or not character.Parent or not part.Parent
           or not khrp.Parent or not hum.Parent or hum.Health <= 0 then cleanup(); return end
        character.PrimaryPart = part
        local tgt = khrp.Position + khrp.CFrame.LookVector * 2
        local diff = tgt - part.Position
        local dist = diff.Magnitude
        if reached then
            reachedTime = reachedTime + dt
            bv.Velocity = dist > 0.1 and diff.Unit * speed or Vector3.zero
            if reachedTime >= Settings.ABT_Duration then cleanup() end
            return
        end
        elapsed = elapsed + dt
        if dist <= speed*dt or dist < 0.1 then
            bv.Velocity = Vector3.zero; reached = true; reachedTime = 0; return
        end
        bv.Velocity = diff.Unit * speed
        if elapsed >= 1 then cleanup() end
    end)
