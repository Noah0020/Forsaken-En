local function getBlockAbilityName(killer)
    if not killer then return nil end
    for _, attr in ipairs({
        "AbilityName","LastAbility","CurrentAbility","LastAbilityName",
        "AbilityUsed","Ability","CurrentAttack",
    }) do
        local ok, val = pcall(function() return killer:GetAttribute(attr) end)
        if ok and type(val) == "string" and val ~= "" then return val end
    end
    return nil
end

local function blockDistanceOK(killer)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not my or not kr then return false end
    local dist = (kr.Position - my.Position).Magnitude
    return dist < (Facing.maxDist or 28) or dist < (Nol.SenseRange or 18)
end

local function angleBetween(a, b)
    local d = a:Dot(b)
    d = math.clamp(d, -1, 1)
    return math.deg(math.acos(d))
end

local function playerFacingKiller(myRoot, killerRoot)
    if not Nol.FacingCheck then return true end
    local toK = Vector3.new(killerRoot.Position.X - myRoot.Position.X, 0, killerRoot.Position.Z - myRoot.Position.Z)
    if toK.Magnitude < 0.01 then return true end
    return angleBetween(myRoot.CFrame.LookVector, toK.Unit) <= (Nol.PlayerFacingAngle or 90)
end

local function killerFacingPlayer(killerRoot, myRoot)
    if not Nol.KillerFacingCheck then return true end
    local toP = Vector3.new(myRoot.Position.X - killerRoot.Position.X, 0, myRoot.Position.Z - killerRoot.Position.Z)
    if toP.Magnitude < 0.01 then return true end
    return angleBetween(killerRoot.CFrame.LookVector, toP.Unit) <= (Nol.KillerFacingAngle or 90)
end

local function isFacingPlayer(killerRoot, myPos)
    if not Facing.enabled then return true end
    local look = killerRoot.CFrame.LookVector
    local toMe = Vector3.new(myPos.X - killerRoot.Position.X, 0, myPos.Z - killerRoot.Position.Z)
    if toMe.Magnitude < 0.01 then return true end
    return look:Dot(toMe.Unit) >= (Facing.dot or 0.25)
end

local function OnRealBlock(killer)
    if IsPlayerKiller() then return end
    local now = tick()
    if now - (Nol.lastBlockTime or 0) < (Nol.blockCooldown or 0.15) then return end
    Nol.lastBlockTime = now

    FireAbility("Block")
    -- Nolsaken-style remote too
    pcall(function()
        local re = getRE()
        if re then
            re:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0Block") })
        end
    end)

    if AutoPunch.enabled then
        task.delay(AutoPunch.delay or 0.2, function()
            FireAbility("Punch")
        end)
    end
    if HDT.enabled then
        if now - (HDT.lastTrigger or 0) >= (HDT.cooldown or 27) then
            local root = killer and killer:FindFirstChild("HumanoidRootPart")
            if not root then
                local k = GetNearestKiller(HDT.range or 30)
                root = k and k:FindFirstChild("HumanoidRootPart")
            end
            if root then
                HDT.lastTrigger = now
                DragToward(root)
            end
        end
    end
end

-- Nolsaken-style persistent sense box (editable) + touch block
local senseBoxes = {} -- [killer] = Part

local function updateSenseBox(killer)
    local root = killer and killer:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return end

    local box = senseBoxes[killer]
    if not box or not box.Parent then
        box = Instance.new("Part")
        box.Name = "DS_SenseBox"
        box.Anchored = true
        box.CanCollide = false
        box.CanTouch = false
        box.CanQuery = true
        box.CastShadow = false
        box.Material = Enum.Material.ForceField
        box.Parent = Workspace
        senseBoxes[killer] = box
        local sb = Instance.new("SelectionBox")
        sb.Name = "Outline"
        sb.Adornee = box
        sb.LineThickness = 0.04
        sb.Parent = box
    end

    local size = Vector3.new(
        tonumber(_G.HitboxWidth) or 4.5,
        tonumber(_G.HitboxHeight) or 6,
        tonumber(_G.HitboxLength) or 7.5
    )
    box.Size = size
    local look = root.CFrame.LookVector
    local offset = tonumber(Nol.BoxForwardOffset) or -1.4
    local center = root.Position + look * (size.Z * 0.5 + offset)
    box.CFrame = CFrame.lookAt(center, center + look)

    local dist = (root.Position - my.Position).Magnitude
    local inRange = dist <= (Nol.SenseRange or 18)
    local col = inRange and (Nol.BoxSafeColor or Color3.fromRGB(0,255,0)) or (Nol.BoxDangerColor or Color3.fromRGB(255,0,0))
    box.Color = col
    box.Transparency = (_G.ShowHitboxVisual ~= false) and (tonumber(_G.HitboxTransparency) or 0.7) or 1
    local outline = box:FindFirstChild("Outline")
    if outline then
        outline.Color3 = col
        outline.Visible = _G.ShowOutline ~= false and _G.ShowHitboxVisual ~= false
    end

    return box, inRange
end

local function destroySenseBox(killer)
    local box = senseBoxes[killer]
    if box then pcall(function() box:Destroy() end) end
    senseBoxes[killer] = nil
end

-- Attack reaction box (short-lived, name-filter path)
local function createBlockBox(killer)
    if IsPlayerKiller() or not killer or killer == LP.Character or not killer.Parent then return end
    if activeBoxes[killer] then return end

    local root = killer:FindFirstChild("HumanoidRootPart") or killer:FindFirstChild("RootPart")
    if not root then return end
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return end
    if not blockDistanceOK(killer) then return end
    if Facing.required and not isFacingPlayer(root, my.Position) then return end
    if not playerFacingKiller(my, root) then return end
    if not killerFacingPlayer(root, my) then return end

    activeBoxes[killer] = true

    local size = Vector3.new(
        tonumber(_G.HitboxWidth) or 4.5,
        tonumber(_G.HitboxHeight) or 6,
        tonumber(_G.HitboxLength) or 7.5
    )

    local box = Instance.new("Part")
    box.Name = "DS_BlockBox"
    box.Anchored = true
    box.CanCollide = false
    box.CanTouch = false
    box.CanQuery = true
    box.CastShadow = false
    box.Material = Enum.Material.ForceField
    box.Color = _G.HitboxColor or Orange
    box.Size = size
    box.Transparency = (_G.ShowHitboxVisual ~= false) and (tonumber(_G.HitboxTransparency) or 0.7) or 1
    box.Parent = Workspace

    if _G.ShowOutline and _G.ShowHitboxVisual ~= false then
        local outline = Instance.new("SelectionBox")
        outline.Adornee = box
        outline.Color3 = box.Color
        outline.LineThickness = tonumber(_G.OutlineThickness) or 0.05
        outline.Parent = box
    end

    local duration = tonumber(_G.HitboxDuration) or 0.55
    local start = os.clock()
    local blocked = false
    local offset = tonumber(Nol.BoxForwardOffset) or -1.4

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if blocked or not killer.Parent or not root.Parent or os.clock() - start >= duration then
            if conn then conn:Disconnect() end
            pcall(function() box:Destroy() end)
            activeBoxes[killer] = nil
            return
        end
        if IsPlayerKiller() then
            if conn then conn:Disconnect() end
            pcall(function() box:Destroy() end)
            activeBoxes[killer] = nil
            return
        end

        size = Vector3.new(
            tonumber(_G.HitboxWidth) or 4.5,
            tonumber(_G.HitboxHeight) or 6,
            tonumber(_G.HitboxLength) or 7.5
        )
        box.Size = size
        local look = root.CFrame.LookVector
        local center = root.Position + look * (size.Z * 0.5 + offset)
        box.CFrame = CFrame.lookAt(center, center + look)
        box.Color = _G.HitboxColor or Orange
        box.Transparency = (_G.ShowHitboxVisual ~= false) and (tonumber(_G.HitboxTransparency) or 0.7) or 1

        local char = LP.Character
        if not char then return end

        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Include
        op.FilterDescendantsInstances = { char }
        local hits = Workspace:GetPartsInPart(box, op)
        if #hits > 0 then
            blocked = true
            if conn then conn:Disconnect() end
            pcall(function() box:Destroy() end)
            activeBoxes[killer] = nil
            local delay = tonumber(_G.BlockDelay) or 0
            if delay > 0 then task.wait(delay) end
            OnRealBlock(killer)
        end
    end)
end

-- PATH A: name-filtered anim / sound / ability → createBlockBox
local blockHookedKillers = {}
local soundStart, animStart = {}, {}

local function hookKillerFiltered(killer)
    if not killer or blockHookedKillers[killer] or not killer:IsA("Model") then return end
    if killer == LP.Character then return end
    blockHookedKillers[killer] = true

    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if not id or not BLOCK_ANIM_IDS[id] then return end
            animStart[track] = os.clock()
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer)
        end)
    end

    local function hookSound(s)
        if not s:IsA("Sound") then return end
        s.Played:Connect(function()
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local sid = tostring(s.SoundId):match("%d+")
            if not sid or not BLOCK_SOUND_IDS[sid] then return end
            soundStart[s] = os.clock()
            if not blockDistanceOK(killer) then return end
            createBlockBox(killer)
        end)
    end
    for _, d in ipairs(killer:GetDescendants()) do hookSound(d) end
    killer.DescendantAdded:Connect(hookSound)

    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local function onAbilityChange()
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local name = getBlockAbilityName(killer)
        if name and nameMatchesBlock(name) and blockDistanceOK(killer) then
            createBlockBox(killer)
        end
    end
    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(onAbilityChange)
    for _, attr in ipairs({ "AbilityName","LastAbility","CurrentAbility","LastAbilityName" }) do
        pcall(function() killer:GetAttributeChangedSignal(attr):Connect(onAbilityChange) end)
    end
end

-- PATH B: Nolsaken sense — range + facing + active attack anim/sound age → block
task.spawn(function()
    while not _ShuttingDown do
        task.wait(0.08)
        if not _G.AutoBlockEnabled or IsPlayerKiller() then
            for k in pairs(senseBoxes) do destroySenseBox(k) end
            continue
        end

        local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local kf = Workspace:FindFirstChild("Players")
        kf = kf and kf:FindFirstChild("Killers")
        if not my or not kf then continue end

        local seen = {}
        for _, killer in ipairs(kf:GetChildren()) do
            if killer:IsA("Model") and killer ~= LP.Character then
                seen[killer] = true
                hookKillerFiltered(killer)
                local root = killer:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                local box, inRange = updateSenseBox(killer)
                if not inRange then continue end
                if not playerFacingKiller(my, root) then continue end
                if not killerFacingPlayer(root, my) then continue end

                -- if player inside sense box → block when attack active
                local char = LP.Character
                if char and box then
                    local op = OverlapParams.new()
                    op.FilterType = Enum.RaycastFilterType.Include
                    op.FilterDescendantsInstances = { char }
                    local hits = Workspace:GetPartsInPart(box, op)
                    if #hits > 0 then
                        local attacking = false
                        local hum = killer:FindFirstChildOfClass("Humanoid")
                        local anim = hum and hum:FindFirstChildOfClass("Animator")
                        if anim then
                            for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
                                local id = tostring(tr.Animation and tr.Animation.AnimationId or ""):match("%d+")
                                local age = animStart[tr] and (os.clock() - animStart[tr]) or 0
                                if id and BLOCK_ANIM_IDS[id] and age <= (Nol.MaxAnimAge or 1.5) then
                                    attacking = true
                                    break
                                end
                            end
                        end
                        if not attacking then
                            for _, d in ipairs(killer:GetDescendants()) do
                                if d:IsA("Sound") and d.IsPlaying then
                                    local sid = tostring(d.SoundId):match("%d+")
                                    local age = soundStart[d] and (os.clock() - soundStart[d]) or 0
                                    if sid and BLOCK_SOUND_IDS[sid] and age <= (Nol.MaxSoundAge or 1.5) then
                                        attacking = true
                                        break
                                    end
                                end
                            end
                        end
                        if attacking then
                            OnRealBlock(killer)
                        end
                    end
                end
            end
        end
        for k in pairs(senseBoxes) do
            if not seen[k] then destroySenseBox(k) end
        end
    end
end)

