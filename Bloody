safe("ESP", function()
    local S = {
        killerESP = false, survivorESP = false, generatorESP = false, itemESP = false,
        killerName = true, killerHealth = true, survivorName = true, survivorHealth = true,
        killerSkin = false, survivorSkin = false,
        MaxDist = 250,
        killerColor = Color3.fromRGB(255, 100, 100),
        survivorColor = Color3.fromRGB(100, 255, 100),
        generatorColor = Color3.fromRGB(200, 100, 200),
        itemColor = Color3.fromRGB(200, 200, 0),
        killerFill = 0.7, survivorFill = 0.7,
    }
    local PlayerESPData, ObjectESPData = {}, {}
    local Folder = Instance.new("Folder")
    Folder.Name = "Nos_ESP"
    Folder.Parent = CoreGui

    local function clearModel(model)
        for i = #PlayerESPData, 1, -1 do
            if PlayerESPData[i].model == model then table.remove(PlayerESPData, i) end
        end
        for i = #ObjectESPData, 1, -1 do
            if ObjectESPData[i].model == model then table.remove(ObjectESPData, i) end
        end
        pcall(function()
            if model:FindFirstChild("Nos_HL") then model.Nos_HL:Destroy() end
            if model:FindFirstChild("Nos_BB") then model.Nos_BB:Destroy() end
        end)
    end

    local function createPlayerESP(model, isKiller)
        if not model or model == LP.Character then return end
        if model:FindFirstChild("Nos_HL") then return end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local hum = model:FindFirstChildOfClass("Humanoid")
