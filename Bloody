    getgenv().ActiveLock = { IsActive=false, Target=nil, StartTime=0, Mode="", Track=nil }
    getgenv().LastFinishedTrack = nil
    getgenv().AimEnabled = false
    getgenv().AimMode = "Character Lock"
    getgenv().AimValues = {
        Guest1337={Enabled=false,LockDuration=1.3,Prediction=0},
        Shedlekey={Enabled=false,LockDuration=1.2,Prediction=0},
        TwoTime={Enabled=false,LockDuration=0.9,Prediction=0},
        Chance={Enabled=false,LockDuration=1.5,Prediction=3},
        JaneDoe={Enabled=false,LockDuration=1.1,Prediction=0},
    }
    pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local surv = assets and assets:FindFirstChild("Survivors")
        if surv then
            for _, f in ipairs(surv:GetChildren()) do
                local cfg = f:FindFirstChild("Config")
                if cfg and cfg:IsA("ModuleScript") then
                    local ok, data = pcall(require, cfg)
                    if ok and type(data) == "table" and type(data.Animations) == "table" then
                        local a = data.Animations
                        local function add(key, val)
                            if not val then return end
                            local id = tostring(val):match("%d+")
                            if id and getgenv().AnimationData[key] then getgenv().AnimationData[key][id] = true end
                        end
                        add("Guest1337", a.Punch); add("Guest1337", a.ParryPunch)
                        add("Shedlekey", a.Slash); add("JaneDoe", a.Axe); add("Chance", a.AimGun)
                    end
                end
            end
        end
    end)
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimEnabled or IsPlayerKiller() then
            if getgenv().ActiveLock.IsActive then
                getgenv().ActiveLock.IsActive = false
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = true end
            end
            return
        end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local AL = getgenv().ActiveLock
        if not AL.IsActive then
            local animator = hum:FindFirstChildOfClass("Animator")
            if not animator then return end
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track ~= getgenv().LastFinishedTrack and track.IsPlaying and track.Animation then
                    local id = tostring(track.Animation.AnimationId):match("%d+")
                    if id then
                        for modeKey, idMap in pairs(getgenv().AnimationData) do
                            local cfg = getgenv().AimValues[modeKey]
                            if cfg and cfg.Enabled and idMap[id] then
                                local target = (modeKey == "Chance") and GetNearestKillerModel(9999) or GetNearestKillerModel(50)
                                if target then
                                    AL.IsActive = true; AL.Target = target; AL.StartTime = tick()
                                    AL.Mode = modeKey; AL.Track = track; hum.AutoRotate = false
                                end
                                break
                            end
                        end
                        if AL.IsActive then break end
                    end
                end
            end
            return
        end
        local cfg = getgenv().AimValues[AL.Mode]
        if not cfg then AL.IsActive = false; return end
        local tHRP = AL.Target and AL.Target:FindFirstChild("HumanoidRootPart")
        local tHum = AL.Target and AL.Target:FindFirstChildOfClass("Humanoid")
        if tick() - AL.StartTime > (cfg.LockDuration or 1) or not tHRP or (tHum and tHum.Health <= 0) then
            getgenv().LastFinishedTrack = AL.Track
            AL.IsActive = false; AL.Target = nil; hum.AutoRotate = true
            return
        end
        local position = tHRP.Position
        if (cfg.Prediction or 0) > 0 and tHum and tHum.MoveDirection.Magnitude > 0 then
            position = position + tHum.MoveDirection.Unit * cfg.Prediction
        end
        local look = CFrame.lookAt(hrp.Position, Vector3.new(position.X, hrp.Position.Y, position.Z))
        hrp.CFrame = hrp.CFrame:Lerp(look, 0.65)
    end)
    local left = Tabs.Aimbot:AddLeftGroupbox("Aimbot", "crosshair")
    left:AddToggle("Aim_Enable", {
