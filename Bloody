local function grad(text, a, b)
    local s = ""
    for i = 1, #text do
        local t = (i-1)/math.max(1,#text-1)
        s ..= string.format('<font color="rgb(%d,%d,%d)">%s</font>',
            math.floor((a.R+(b.R-a.R)*t)*255),
            math.floor((a.G+(b.G-a.G)*t)*255),
            math.floor((a.B+(b.B-a.B)*t)*255),
            text:sub(i,i))
    end
    return s
end

