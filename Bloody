local GenConfig = { StartDelay=1.5, ConnectDelay=1.0 }
local MinigameSolver = { Enabled=false, Generation=0, Installed=false }
local function installMinigameHooks()
    if MinigameSolver.Installed then return true end
    local ok, err = pcall(function()
        local MinigameFolder = ReplicatedStorage.Systems.Player.Game.Minigames
        local ConnectInputModule = require(MinigameFolder.ConnectClientMinigame.ConnectInput)
        local oldConnect = ConnectInputModule.new
        ConnectInputModule.new = function(board, renderer, callbacks)
            local object = oldConnect(board, renderer, callbacks)
            local token = MinigameSolver.Generation
            task.spawn(function()
                while object and not object.Ended and not MinigameSolver.Enabled do task.wait(0.05) end
                if not (object and not object.Ended and MinigameSolver.Enabled and token==MinigameSolver.Generation) then return end
                task.wait(GenConfig.ConnectDelay)
                if board.Blobs then
                    for blob in pairs(board.Blobs) do
                        if not MinigameSolver.Enabled then return end
                        if not board:GetLink(blob) then
                            local mate = board:GetMate(blob)
                            if mate then board:Connect(blob, mate); renderer:Render(); task.wait(GenConfig.ConnectDelay) end
                        end
                    end
                end
                if MinigameSolver.Enabled and board.IsSolved and board:IsSolved() then
                    object:__finish()
                    if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                end
            end)
            return object
        end
        MinigameSolver.Installed = true
    end)
    if not ok then warn("[Perfect Gen] "..tostring(err)) end
    return MinigameSolver.Installed
end
