local Vee = { modules = {} }
local function Vee_Collect()
    Vee.modules = {}
    local a = ReplicatedStorage:FindFirstChild("Assets")
    local s = a and a:FindFirstChild("Survivors")
    local v = s and s:FindFirstChild("Veeronica")
    if v then
        local beh = v:FindFirstChild("Behavior")
        if beh then local ok, m = pcall(require, beh); if ok and type(m) == "table" then table.insert(Vee.modules, m) end end
        local cfg = v:FindFirstChild("Config")
        if cfg and cfg:IsA("ModuleScript") then local ok, m = pcall(require, cfg); if ok and type(m) == "table" then table.insert(Vee.modules, m) end end
    end
    if getgc then
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "DisplayName") == "Veeronica" then table.insert(Vee.modules, t) end
            end
        end)
    end
end
local function Vee_Set(key, val)
    if #Vee.modules == 0 then Vee_Collect() end
    for _, m in ipairs(Vee.modules) do pcall(function() m[key] = val end); pcall(function() rawset(m, key, val) end) end
end
