-- DIRECTIONAL AUTO BLOCK (killer-facing semicircle + returning box)
--═══════════════════════════════════════════════════════════════════
local AB = {
    enabled = false,
    delay = 0,
    last = 0,
}

local FacingConfig = {
    enabled = true,
    angle = 120,              -- total cone angle in degrees
    radius = 20,              -- horizontal range from killer
    verticalTolerance = 6,
    projectileSize = Vector3.new(4, 5, 4),
    projectileSpeed = 100,
    projectileTimeout = 0.8,
    hitDistance = 3.5,
    showZone = true,
    showProjectile = true,
    zoneSegments = 32,
    zoneColor = Color3.fromRGB(255, 65, 75),
    projectileColor = Color3.fromRGB(255, 90, 100),
}

local FacingMode = "Semicircle" -- None | Semicircle
local ProjectileFolder = Instance.new("Folder")
ProjectileFolder.Name = "Nos_DirectionalBlock"
ProjectileFolder.Parent = Workspace

local ZoneFolder = Instance.new("Folder")
ZoneFolder.Name = "Nos_DirectionalZones"
ZoneFolder.Parent = Workspace

local activeProjectiles = {}
local zoneParts = {}

local function clearStack()
    for _, projectile in ipairs(activeProjectiles) do
        if projectile.part then
            pcall(function() projectile.part:Destroy() end)
        end
    end
    table.clear(activeProjectiles)

    for killer, parts in pairs(zoneParts) do
        for _, part in ipairs(parts) do
            pcall(function() part:Destroy() end)
        end
        zoneParts[killer] = nil
    end
end

local function getRoot(model)
    return model and model:FindFirstChild("HumanoidRootPart")
end

-- The cone belongs to the KILLER. It is measured from the killer's
-- forward direction, not from the survivor's facing direction.
local function IsPlayerInsideKillerZone(killer)
    local killerRoot = getRoot(killer)
    local playerRoot = getRoot(LP.Character)
    if not killerRoot or not playerRoot then return false end

    local offset = playerRoot.Position - killerRoot.Position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    local distance = horizontal.Magnitude

    if distance > FacingConfig.radius then return false end
    if math.abs(offset.Y) > FacingConfig.verticalTolerance then return false end
    if distance < 0.01 then return true end

    local forward = Vector3.new(
        killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z
    )
    if forward.Magnitude < 0.01 then return false end

    local dot = math.clamp(forward.Unit:Dot(horizontal.Unit), -1, 1)
    local halfAngle = math.rad(math.clamp(FacingConfig.angle, 1, 180) / 2)
    return dot >= math.cos(halfAngle)
end

local function makeZonePart()
    local part = Instance.new("Part")
    part.Name = "Nos_SemicircleOutline"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = FacingConfig.zoneColor
    part.Transparency = 0.12
    part.Size = Vector3.new(0.09, 0.09, 1)
    part.Parent = ZoneFolder
    return part
end

local function updateKillerZone(killer)
    local root = getRoot(killer)
    if not root or not FacingConfig.showZone or FacingMode ~= "Semicircle" then
        local old = zoneParts[killer]
        if old then
            for _, part in ipairs(old) do part:Destroy() end
            zoneParts[killer] = nil
        end
        return
    end

    local parts = zoneParts[killer]
    if not parts then
        parts = {}
        for i = 1, FacingConfig.zoneSegments do
            parts[i] = makeZonePart()
        end
        -- Two radial edges complete the visible semicircle sector.
        parts[#parts + 1] = makeZonePart()
        parts[#parts + 1] = makeZonePart()
        zoneParts[killer] = parts
    end

    local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if forward.Magnitude < 0.01 then return end
    forward = forward.Unit
    local right = Vector3.new(-forward.Z, 0, forward.X)
    local half = math.rad(math.clamp(FacingConfig.angle, 1, 180) / 2)
    local center = root.Position + Vector3.new(0, 0.15, 0)

    local points = {}
    for i = 0, FacingConfig.zoneSegments do
        local a = -half + (2 * half) * (i / FacingConfig.zoneSegments)
        local direction = forward * math.cos(a) + right * math.sin(a)
        points[i + 1] = center + direction * FacingConfig.radius
    end

    for i = 1, FacingConfig.zoneSegments do
        local a, b = points[i], points[i + 1]
        local delta = b - a
        local part = parts[i]
        part.Size = Vector3.new(0.09, 0.09, delta.Magnitude)
        part.CFrame = CFrame.lookAt((a + b) / 2, b)
        part.Color = FacingConfig.zoneColor
        part.Transparency = 0.12
    end

    for i, pointIndex in ipairs({1, #points}) do
        local part = parts[FacingConfig.zoneSegments + i]
        local edge = points[pointIndex] - center
        part.Size = Vector3.new(0.09, 0.09, edge.Magnitude)
        part.CFrame = CFrame.lookAt((center + points[pointIndex]) / 2, points[pointIndex])
        part.Color = FacingConfig.zoneColor
        part.Transparency = 0.12
    end
end

local function removeProjectile(projectile)
    if projectile.part then
        pcall(function() projectile.part:Destroy() end)
    end
    for i = #activeProjectiles, 1, -1 do
        if activeProjectiles[i] == projectile then
            table.remove(activeProjectiles, i)
            break
        end
    end
end

local function launchDirectionalBox(killer)
    if not AB.enabled or IsPlayerKiller() or FacingMode ~= "Semicircle" then return end
    if not killer or not killer.Parent then return end

    local playerRoot = getRoot(LP.Character)
    local killerRoot = getRoot(killer)
    if not playerRoot or not killerRoot then return end

    -- Only spawn when the survivor is inside the killer's forward semicircle
    -- at the instant the M1 signal is received.
    if not IsPlayerInsideKillerZone(killer) then return end

    local part = Instance.new("Part")
    part.Name = "Nos_DirectionalBlockBox"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = FacingConfig.projectileColor
    part.Size = FacingConfig.projectileSize
    part.Transparency = FacingConfig.showProjectile and 0.2 or 1
    part.CFrame = CFrame.new(playerRoot.Position)
    part.Parent = ProjectileFolder

    local projectile = {
        part = part,
        killer = killer,
        started = os.clock(),
        lastPosition = playerRoot.Position,
    }
    table.insert(activeProjectiles, projectile)
end

-- Every active box travels FROM the survivor TOWARD the killer. At contact,
-- the box is destroyed first, then the cone is checked again.
RunService.Heartbeat:Connect(function(dt)
    local killersFolder = Workspace:FindFirstChild("Players")
    killersFolder = killersFolder and killersFolder:FindFirstChild("Killers")

    if killersFolder then
        for _, killer in ipairs(killersFolder:GetChildren()) do
            if killer:IsA("Model") then
                updateKillerZone(killer)
            end
        end
    end

    for i = #activeProjectiles, 1, -1 do
        local projectile = activeProjectiles[i]
        local part = projectile.part
        local killer = projectile.killer
        local playerRoot = getRoot(LP.Character)
        local killerRoot = getRoot(killer)

        if not part or not part.Parent or not playerRoot or not killerRoot
            or not killer.Parent
            or os.clock() - projectile.started >= FacingConfig.projectileTimeout then
            removeProjectile(projectile)
        else
            local current = part.Position
            local target = killerRoot.Position
            local offset = target - current
            local distance = offset.Magnitude
            local step = math.max(FacingConfig.projectileSpeed, 1) * math.max(dt, 0)

            if distance <= math.max(FacingConfig.hitDistance, 0.5) + step then
                -- Contact always removes the box, even if the player moved
                -- outside the killer's cone during its travel.
                removeProjectile(projectile)
                if AB.enabled and IsPlayerInsideKillerZone(killer) then
                    local now = os.clock()
                    if now - AB.last >= 0.08 then
                        AB.last = now
                        if AB.delay > 0 then
                            task.delay(AB.delay, function()
                                if AB.enabled then FireBlock() end
                            end)
                        else
                            FireBlock()
                        end
                    end
                end
            elseif distance > 0.01 then
                local nextPosition = current + offset.Unit * math.min(step, distance)
                part.CFrame = CFrame.lookAt(nextPosition, target)
                projectile.lastPosition = nextPosition
            end
        end
    end
end)

local function triggerBlock(killer)
    if not AB.enabled or IsPlayerKiller() then return end
    if FacingMode == "None" then
        local now = os.clock()
        if now - AB.last < 0.08 then return end
        AB.last = now
        if AB.delay > 0 then
            task.delay(AB.delay, FireBlock)
        else
            FireBlock()
        end
        return
    end
    launchDirectionalBox(killer)
end

-- This uses the same killer attribute signal that the original script used.
-- It must correspond to the game's M1 signal in the current Forsaken build.
local monitored = {}
local function monitorKiller(killer)
    if not killer or monitored[killer] or not killer:IsA("Model") or killer == LP.Character then return end
    monitored[killer] = true
    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local lastUsed = killer:GetAttribute("AbilitiesUsed") or 0

    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        if not AB.enabled or IsPlayerKiller() then return end
        local currentAbility = killer:GetAttribute("AbilityLastUsed") or 0
        if currentAbility == lastAbility then return end
        lastAbility = currentAbility

        local currentUsed = killer:GetAttribute("AbilitiesUsed") or 0
        if currentUsed > lastUsed then
            lastUsed = currentUsed
            return
        end
        triggerBlock(killer)
    end)
end

