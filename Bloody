local stamThread
local function applyStam()
    pcall(function()
        local m = require(ReplicatedStorage.Systems.Character.Game.Sprinting)
        if not m then return end
        if not m.DefaultsSet then pcall(function() m.Init() end) end
        m.StaminaLoss = 0; m.StaminaGain = 999; m.MaxStamina = 999
        m.StaminaLossDisabled = true
        if m.Stamina then m.Stamina = 999 end
        if type(m.StaminaCap) == "number" then m.StaminaCap = 999 end
    end)
end
local function setInfStam(on)
    C.InfStamina = on
    if on then
        applyStam()
        if not stamThread then
            stamThread = task.spawn(function()
                while C.InfStamina do applyStam(); task.wait(0.4) end
                stamThread = nil
            end)
        end
        Notify("Infinite Stamina ON")
    else
        if stamThread then task.cancel(stamThread); stamThread = nil end
        Notify("Infinite Stamina OFF")
    end
end

