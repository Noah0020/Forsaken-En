local function aim_getTarget(modeKey, cfg)
    if modeKey == "Pizza" then
        return GetNearestSurvivorModel(cfg.Distance or 50, cfg.TargetMode == "Lowest HP" and "Lowest HP" or "Nearest")
    elseif modeKey == "Chance" then
        return GetNearestKillerModel(9999)
    else
        local dist = (modeKey == "Guest1337" or modeKey == "JaneDoe") and 9999 or (cfg.Distance or 50)
        return GetNearestKillerModel(dist)
    end
end

-- Main aim loop
RunService.RenderStepped:Connect(function()
    if not Aim.enabled or IsPlayerKiller() then
        if Aim.active.IsActive then
            Aim.active.IsActive = false; Aim.active.Target = nil
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
        end
        return
    end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if not Aim.active.IsActive then
        -- detect playing ability anim
        local animator = hum:FindFirstChildOfClass("Animator"); if not animator then return end
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track ~= Aim.lastFinished and track.IsPlaying and track.Animation then
                local id = tostring(track.Animation.AnimationId):match("%d+")
                if not id then continue end
                for modeKey, idMap in pairs(Aim.animData) do
                    local cfg = Aim.values[modeKey]
                    if cfg and cfg.Enabled and idMap[id] then
                        local target = aim_getTarget(modeKey, cfg)
                        if target then
                            Aim.active.IsActive = true
                            Aim.active.Target = target
                            Aim.active.StartTime = tick()
                            Aim.active.Mode = modeKey
                            Aim.active.Track = track
                            hum.AutoRotate = false
                        end
                        break
                    end
                end
                if Aim.active.IsActive then break end
            end
        end
        return
    end

    local mode = Aim.active.Mode
    local cfg = Aim.values[mode]
    if not cfg then Aim.active.IsActive=false; return end
    local elapsed = tick() - Aim.active.StartTime
    local tHRP = Aim.active.Target and Aim.active.Target:FindFirstChild("HumanoidRootPart")
    local tHum = Aim.active.Target and Aim.active.Target:FindFirstChildOfClass("Humanoid")
    if elapsed > (cfg.LockDuration or 1) or not tHRP or (tHum and tHum.Health <= 0) then
        Aim.lastFinished = Aim.active.Track
        Aim.active.IsActive = false; Aim.active.Target = nil; Aim.active.Track = nil
        hum.AutoRotate = true
        return
    end

    local position = tHRP.Position
    local pred = cfg.Prediction or 0
    if pred > 0 and tHum and tHum.MoveDirection.Magnitude > 0 then
        position = position + tHum.MoveDirection.Unit * pred
    end
    local flat = Vector3.new(position.X, hrp.Position.Y, position.Z)
    local look = CFrame.lookAt(hrp.Position, flat)

    local function applyChar()
        if mode == "Chance" then hrp.CFrame = look
        elseif (tHRP.Position - hrp.Position).Magnitude < 6 then hrp.CFrame = look
        else hrp.CFrame = hrp.CFrame:Lerp(look, 0.65) end
    end

    if Aim.mode == "Char + Cam Lock" then
        applyChar()
        local cam = Workspace.CurrentCamera
        if cam then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, position), 0.75) end
    else
        applyChar()
    end
end)

