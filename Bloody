local function SelectTab(tabName)
    if not Pages[tabName] then return end
    SelectedTab = tabName
    for name, page in pairs(Pages) do page.Visible = name == tabName end
    for name, button in pairs(TabButtons) do
        local active = name == tabName
        Tween(button, { BackgroundColor3 = active and Theme.AccentDark or Theme.Panel, BackgroundTransparency = active and 0.12 or 1 })
        local icon = button:FindFirstChild("TabIcon")
        if icon then Tween(icon, { ImageColor3 = active and Theme.Accent or Theme.Muted }) end
        local label = button:FindFirstChild("TabLabel")
        if label then Tween(label, { TextColor3 = active and Theme.Text or Theme.Muted }) end
    end
end

