local function AB_IsReady()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local btn = ac and ac:FindFirstChild(name)
    if btn then
        local cd = btn:FindFirstChild("CooldownTime")
        if cd then
            local t = tostring(cd.Text or "")
            if t == "" or t == " " or t == "0" or t == "0.0" then return true end
            return false
        end
    end
    return (tick() - (AB.lastBlock or 0)) >= (AB.COOLDOWN - 2)
end

local function AB_FireNetwork(name)
    local ne = ResolveNetwork()
    if not ne then return end
    pcall(function()
        if buffer and buffer.fromstring then
            ne:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0" .. name) })
        end
    end)
    pcall(function() ne:FireServer("UseActorAbility", { name }) end)
    pcall(function() ne:FireServer("UseActorAbility", name) end)
end

local function AB_FireUI(name)
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(name)
    if not btn then return end
    if firesignal then
        pcall(function()
            local sig = btn:FindFirstChildOfClass("MouseButton1Click")
            if sig then firesignal(sig) end
        end)
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(btn.MouseButton1Click) or {}) do
                    pcall(function() c:Fire() end)
                    pcall(function() if c.Function then c.Function() end end)
                end
            end
        end)
    end
    pcall(function()
        local target = btn:IsA("GuiButton") and btn or btn:FindFirstChildWhichIsA("GuiButton", true)
        if target then
            local pos = target.AbsolutePosition + target.AbsoluteSize / 2
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
            task.wait()
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
        end
    end)
end

local function AB_FireOnce()
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    if Settings.AB_UseNetwork then AB_FireNetwork(name) end
    if Settings.AB_UseAnimation then AB_FireUI(name) end
end

local function AB_FireSpam()
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local count = math.clamp(tonumber(Settings.AB_SpamCount) or 6, 1, 15)
    for i = 1, count do
        task.spawn(function()
            if Settings.AB_UseNetwork then AB_FireNetwork(name) end
            if Settings.AB_UseAnimation then AB_FireUI(name) end
        end)
    end
    local dur = tonumber(Settings.AB_SpamDuration) or 0.08
    if dur > 0 then
        task.spawn(function()
            local endT = tick() + dur
            while tick() < endT do
                if Settings.AB_UseNetwork then AB_FireNetwork(name) end
                task.wait(0.001)
            end
        end)
    end
end

local function AB_DoFire()
    if Settings.AB_SpamEnabled then AB_FireSpam() else AB_FireOnce() end
end

local function AB_Try(killer)
    if not AB.running then return end
    local st = AB.perKiller[killer]
    if not st then return end
    if not Settings.AB_Instant then
        if st.pendingUntil <= 0 or tick() > st.pendingUntil then return end
    end
    Box_Show(killer)
    if not AB_IsReady() then return end
    local root = LocalRoot
    local hum = LocalHumanoid
    if not root or not hum or hum.Health <= 0 then return end
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp or not khrp.Parent then return end
    if not AB_ShouldBlock(killer) then return end
    st.pendingUntil = 0
    st.lastFireAt = tick()
    AB.lastBlock = tick()
    AB_DoFire()
end

local function AB_OnAbility(killer)
    if not AB.running then return end
    local st = AB.perKiller[killer]
    if not st then return end
    local aU = killer:GetAttribute("AbilitiesUsed") or 0
    if aU > (st.lastUsed or 0) then st.lastUsed = aU; st.baitFlag = true end
    local aLU = killer:GetAttribute("AbilityLastUsed") or 0
    if aLU <= (st.lastAbility or 0) then return end
    st.lastAbility = aLU
    if st.baitFlag then st.baitFlag = false; return end
    if Settings.AB_Instant then
        st.pendingUntil = tick() + 0.4
        AB_Try(killer)
        task.delay(0.02, function() if AB.running then AB_Try(killer) end end)
        task.delay(0.06, function() if AB.running then AB_Try(killer) end end)
        task.delay(0.12, function() if AB.running then AB_Try(killer) end end)
    else
        st.pendingUntil = tick() + Settings.AB_PendingWindow
        AB_Try(killer)
    end
end

local function AB_Hook(killer)
    if not killer:IsA("Model") or AB.perKiller[killer] then return end
    local st = {
        lastAbility = killer:GetAttribute("AbilityLastUsed") or 0,
        lastUsed = killer:GetAttribute("AbilitiesUsed") or 0,
        baitFlag = false, pendingUntil = 0, lastFireAt = 0, conns = {},
    }
    local ok1, c1 = pcall(function()
        return killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function() AB_OnAbility(killer) end)
    end)
    if ok1 and c1 then table.insert(st.conns, c1) end
    local ok2, c2 = pcall(function()
        return killer:GetAttributeChangedSignal("AbilitiesUsed"):Connect(function() AB_OnAbility(killer) end)
    end)
    if ok2 and c2 then table.insert(st.conns, c2) end
    task.spawn(function()
        local hum = killer:FindFirstChildOfClass("Humanoid") or killer:WaitForChild("Humanoid", 3)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
        if not anim then return end
        local ok3, c3 = pcall(function()
            return anim.AnimationPlayed:Connect(function()
                if AB.running then AB_OnAbility(killer) end
            end)
        end)
        if ok3 and c3 then table.insert(st.conns, c3) end
    end)
    AB.perKiller[killer] = st
end

local function AB_Unhook(killer)
    local st = AB.perKiller[killer]
    if st then for _, c in ipairs(st.conns or {}) do pcall(function() c:Disconnect() end) end end
    AB.perKiller[killer] = nil
end

local function AB_Loop()
    if not AB.running then return end
    local kf = GetKillersFolder()
    if not kf then return end
    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            if not AB.perKiller[killer] then AB_Hook(killer) end
            local st = AB.perKiller[killer]
            if st then
                local aLU = killer:GetAttribute("AbilityLastUsed") or 0
                if aLU > (st.lastAbility or 0) then AB_OnAbility(killer) end
                if st.pendingUntil > 0 then AB_Try(killer) end
            end
        end
    end
    for k in pairs(AB.perKiller) do if not k.Parent then AB_Unhook(k) end end
end

local function AB_Enable()
    if AB.running then return end
    AB.running = true
    Settings.AB_Enabled = true
    AB.perKiller = {}
    AB.lastBlock = 0
