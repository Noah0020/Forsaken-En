-- Menu open state — ONLY controlled by our button
local MenuOpen = true

local _lastForced = true
local function SetMenuOpen(state)
    local want = state and true or false
    if want == MenuOpen and want == _lastForced then
        -- still force UI in case it desynced
    end
    MenuOpen = want
    _lastForced = want

    local ok = false
    if Window.SetVisible then
        ok = pcall(function() Window:SetVisible(want) end)
    end
    if not ok and want and Window.Open then
        ok = pcall(function() Window:Open() end)
    end
    if not ok and (not want) and Window.Close then
        ok = pcall(function() Window:Close() end)
    end
    -- Last resort: WindUI Toggle (no args). Only call when we have no better API.
    if not ok and Window.Toggle then
        pcall(function() Window:Toggle(want) end) -- some builds accept bool
        -- if that ignored args, don't call again — avoids double open on mobile
    end
end

