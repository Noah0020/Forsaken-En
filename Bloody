    local ok = pcall(function()
        local old = rf.OnClientInvoke
        rf.OnClientInvoke = function(name, ...)
            if name == "GetCameraCF" and Silent.crystal and not IsPlayerKiller() then
                local cf = aimCamCF(); if cf then return cf end
            end
            if name == "GetMousePosition" and Silent.dusk and not IsPlayerKiller() then
                local p = aimMousePos(); if p then return p end
            end
            if old then return old(name, ...) end
        end
    end)
    -- namecall fallback
    if not ok and hookmetamethod and getnamecallmethod then
        ok = pcall(function()
            local oldNc
            oldNc = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if self == rf and (method == "InvokeServer" or method == "invokeServer") then
                    -- client invoke is OnClientInvoke; keep namecall for safety
                end
                return oldNc(self, ...)
            end)
        end)
    end
    Silent.hooked = ok and true or false
    return Silent.hooked
