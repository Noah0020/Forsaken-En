local AimbotValues = {
    Guest1337 = { Enabled = false, Distance = 50, LockDuration = 1.3, Prediction = 0 },
    Shedlekey = { Enabled = false, Distance = 29, LockDuration = 1.2, Prediction = 0 },
    TwoTime   = { Enabled = false, Distance = 29, LockDuration = 0.9,  Prediction = 0 },
    Chance    = { Enabled = false, Distance = 50, LockDuration = 1.5,  Prediction = 3 },
    Pizza     = { Enabled = false, Distance = 50, LockDuration = 1.2,  Prediction = 0 },
    JaneDoe   = { Enabled = false, Distance = 50, LockDuration = 1.1,  Prediction = 0 },
}

local AnimationData = {
    Guest1337 = {}, Shedlekey = {}, TwoTime = { ["100725497418533"] = true },
    Chance = {}, Pizza = { ["114155003741146"] = true }, JaneDoe = {},
}

task.spawn(function()
    pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        if not assets then return end
        local folders = { assets:FindFirstChild("Survivors") }
        if assets:FindFirstChild("Skins") then
            table.insert(folders, assets.Skins:FindFirstChild("Survivors"))
        end
        for _, folder in ipairs(folders) do
            if not folder then continue end
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("ModuleScript") and d.Name == "Config" then
                    local ok, res = pcall(require, d)
                    if ok and type(res) == "table" and type(res.Animations) == "table" then
                        local a = res.Animations
                        local function add(mode, val)
                            if val then
                                local m = tostring(val):match("%d+")
                                if m then AnimationData[mode][m] = true end
                            end
                        end
                        add("Guest1337", a.Punch)
                        add("Guest1337", a.ParryPunch)
                        add("Shedlekey", a.Slash)
                        add("JaneDoe", a.Axe)
                        add("Chance", a.AimGun)
                    end
                end
            end
        end
    end)
end)

local GlobalAimbot = false
local SelectedAimbots = {}
local ActiveAnimLookup = {}
local ActiveLock = { IsActive = false, Target = nil, StartTime = 0, Mode = "" }
local AimlockMode = "Character Lock"

local function rebuildAnimLookup()
    ActiveAnimLookup = {}
    for mode, map in pairs(AnimationData) do
        if AimbotValues[mode] and AimbotValues[mode].Enabled then
            for id in pairs(map) do
                ActiveAnimLookup[id] = mode
            end
        end
    end
end

local function applySelectedAimbots()
    for _, v in pairs(AimbotValues) do v.Enabled = false end
    if GlobalAimbot then
        local list = SelectedAimbots
        if not list or #list == 0 then
            list = { "Guest1337", "Shedlekey", "TwoTime", "Chance", "Pizza", "JaneDoe" }
        end
        for _, name in ipairs(list) do
            if AimbotValues[name] then AimbotValues[name].Enabled = true end
        end
    end
    rebuildAnimLookup()
end

local function nearestKiller(maxD)
    if not LocalRoot or not KillersFolder then return nil end
    local best, bd = nil, maxD or 50
    for _, m in ipairs(KillersFolder:GetChildren()) do
        local r = m:FindFirstChild("HumanoidRootPart")
        local h = m:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local d = (r.Position - LocalRoot.Position).Magnitude
            if d < bd then bd = d; best = m end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not ActiveLock.IsActive or not LocalRoot then return end
    local mode = ActiveLock.Mode
    local cfg = AimbotValues[mode]
    if not cfg then ActiveLock.IsActive = false; return end
    local elapsed = tick() - ActiveLock.StartTime
    local target = ActiveLock.Target
    local tr = target and target:FindFirstChild("HumanoidRootPart")
    local th = target and target:FindFirstChildOfClass("Humanoid")
    if elapsed > (cfg.LockDuration or 1) or not tr or (th and th.Health <= 0) then
        ActiveLock.IsActive = false
        if LocalHum then LocalHum.AutoRotate = true end
        return
    end
    local pos = tr.Position
    local pred = cfg.Prediction or 0
    if pred > 0 and th and th.MoveDirection.Magnitude > 0 then
        pos = pos + th.MoveDirection.Unit * pred
    end
    local goal = CFrame.lookAt(LocalRoot.Position, Vector3.new(pos.X, LocalRoot.Position.Y, pos.Z))
    if mode == "Chance" or (pos - LocalRoot.Position).Magnitude < 6 then
        LocalRoot.CFrame = goal
    else
        LocalRoot.CFrame = LocalRoot.CFrame:Lerp(goal, 0.65)
    end
    if AimlockMode == "Char + Cam Lock" then
        local cam = workspace.CurrentCamera
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pos), 0.75)
    end
end)

local function hookAimChar(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4)
    if not anim then return end
    anim.AnimationPlayed:Connect(function(track)
        if not GlobalAimbot or ActiveLock.IsActive then return end
        local id = track.Animation and extractId(track.Animation.AnimationId)
        if not id then return end
        local mode = ActiveAnimLookup[id]
        if not mode then return end
        local cfg = AimbotValues[mode]
        if not cfg or not cfg.Enabled then return end
        local best = nearestKiller(cfg.Distance or 50)
        if best then
            ActiveLock.IsActive = true
            ActiveLock.Target = best
            ActiveLock.StartTime = tick()
            ActiveLock.Mode = mode
            hum.AutoRotate = false
        end
    end)
end
if LocalPlayer.Character then task.spawn(hookAimChar, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(hookAimChar)

-- Silent Aim: Jane (Crystal) + Dusekkar
local SA = {
    Crystal = false,
    Dusekkar = false,
    CrystalPred = 2.5,
    DusekkarPred = 0.5,
    cHook = nil,
    dHook = nil,
}

local function setCrystalSA(on)
    SA.Crystal = on
    if on and not SA.cHook then
        if typeof(hookfunction) ~= "function" or typeof(getcallbackvalue) ~= "function" then
            Notify("Silent Aim", "Need hookfunction + getcallbackvalue")
            return
        end
        local ok, rf = pcall(function()
            return ReplicatedStorage.Modules.Network.Network.RemoteFunction
        end)
        if not ok or not rf then
            Notify("Silent Aim", "RemoteFunction missing")
            return
        end
        local ang = -0.32175
        local cam = workspace.CurrentCamera
        SA.cHook = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] ~= "GetCameraCF" or not SA.Crystal then
                return SA.cHook(table.unpack(args, 1, args.n))
            end
            local killer = nearestKiller(120)
            if killer and LocalRoot then
                local hum = killer:FindFirstChildOfClass("Humanoid")
                local pos = killer.HumanoidRootPart.Position
                if hum and hum.MoveDirection.Magnitude > 0.15 then
                    pos = pos + hum.MoveDirection * SA.CrystalPred
                end
                local cf = CFrame.lookAt(Vector3.zero, (pos - LocalRoot.Position + Vector3.new(0, 1.5, 0)).Unit)
                if LocalPlayer:GetAttribute("Device") == "Mobile" or UserInputService.TouchEnabled then
                    cf = cf * CFrame.Angles(ang, 0, 0)
                end
                return CFrame.new(cam.CFrame.Position) * cf.Rotation
            end
            return SA.cHook(table.unpack(args, 1, args.n))
        end)
        Notify("Silent Aim", "Jane / Crystal ON")
    end
end

local function setDusekkarSA(on)
    SA.Dusekkar = on
    if on and not SA.dHook then
        if typeof(hookfunction) ~= "function" or typeof(getcallbackvalue) ~= "function" then
            Notify("Silent Aim", "Need hookfunction + getcallbackvalue")
            return
        end
        local ok, rf = pcall(function()
            return ReplicatedStorage.Modules.Network.Network.RemoteFunction
        end)
        if not ok or not rf then
            Notify("Silent Aim", "RemoteFunction missing")
            return
        end
        SA.dHook = hookfunction(getcallbackvalue(rf, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] == "GetMousePosition" and SA.Dusekkar then
                local killer = nearestKiller(120)
                if killer then
                    local hum = killer:FindFirstChildOfClass("Humanoid")
                    local pos = killer.HumanoidRootPart.Position
                    if hum and hum.MoveDirection.Magnitude > 0.05 then
                        pos = pos + hum.MoveDirection * SA.DusekkarPred
                    end
                    return pos
                end
            end
            return SA.dHook(table.unpack(args, 1, args.n))
        end)
        Notify("Silent Aim", "Dusekkar ON")
    end
end

