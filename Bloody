-- ADVANCED BOX FACING (giant + small boxes)
--═══════════════════════════════════════════════════════════════════
do
    AdvBox = {
        mode = "None", -- None | Normal | Advanced
        enabled = false,
        count = 3,
        small = Vector3.new(5, 6, 8),
        giant = Vector3.new(16, 10, 22),
        giantForward = 10,
        spawnForward = 4,
        lifetime = 0.55,
        speed = 70,
        showSmall = true,
        showGiant = false,
        fillT = 0.55,
    }

    local Folder = Instance.new("Folder")
    Folder.Name = "Nos_AdvBoxes"
    Folder.Parent = Workspace

    local killerModel = nil
    local boxes = {}
    local lastValid = 0
    local Colors = {
        Out = Color3.fromRGB(255, 55, 55),
        Invalid = Color3.fromRGB(255, 210, 40),
        Valid = Color3.fromRGB(40, 255, 110),
        Bound = Color3.fromRGB(100, 160, 255),
    }

    local function makePart(name)
        local p = Instance.new("Part")
        p.Name = name
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
        p.Material = Enum.Material.ForceField
        p.Transparency = AdvBox.fillT
        p.Parent = Folder
        local sb = Instance.new("SelectionBox")
        sb.Adornee = p
        sb.LineThickness = 0.05
        sb.SurfaceTransparency = 1
        sb.Parent = p
        local pl = Instance.new("PointLight")
        pl.Range = 7
        pl.Brightness = 0.7
        pl.Parent = p
        return p
    end

    local boundary = makePart("Giant")
    boundary.Transparency = 1

    local function syncCount()
        local n = math.clamp(math.floor(AdvBox.count), 1, 10)
        while #boxes < n do
            table.insert(boxes, {
                part = makePart("Small_" .. (#boxes + 1)),
                pos = Vector3.zero,
                active = false,
                age = 0,
                index = #boxes + 1,
            })
        end
        while #boxes > n do
            local o = table.remove(boxes)
            o.part:Destroy()
        end
    end
    syncCount()

    local function rootOf(m)
        return m and m:FindFirstChild("HumanoidRootPart")
    end

    local function boundaryCF(kr)
        return kr.CFrame * CFrame.new(0, 0, -AdvBox.giantForward)
    end

    local function clampIn(world, bcf, bsz, ssz)
        local lp = bcf:PointToObjectSpace(world)
        local hx = math.max(0, bsz.X / 2 - ssz.X / 2)
        local hy = math.max(0, bsz.Y / 2 - ssz.Y / 2)
        local hz = math.max(0, bsz.Z / 2 - ssz.Z / 2)
        lp = Vector3.new(
            math.clamp(lp.X, -hx, hx),
            math.clamp(lp.Y, -hy, hy),
            math.clamp(lp.Z, -hz, hz)
        )
        return bcf:PointToWorldSpace(lp)
    end

    local function inside(world, cf, size)
        local lp = cf:PointToObjectSpace(world)
        return math.abs(lp.X) <= size.X / 2
            and math.abs(lp.Y) <= size.Y / 2
            and math.abs(lp.Z) <= size.Z / 2
    end

    local function style(p, size, cf, col)
        p.Size = size
        p.CFrame = cf
        p.Color = col
        p.Transparency = AdvBox.showSmall and AdvBox.fillT or 1
        local sb = p:FindFirstChildOfClass("SelectionBox")
        if sb then sb.Color3 = col end
        local pl = p:FindFirstChildOfClass("PointLight")
        if pl then pl.Color = col; pl.Enabled = AdvBox.showSmall end
    end

    function AdvBox.SetKiller(m)
        if m and m:IsA("Model") then killerModel = m end
    end

    function AdvBox.Trigger()
        if AdvBox.mode ~= "Advanced" then return end
        local kr = rootOf(killerModel)
        local pr = rootOf(LP.Character)
        if not kr or not pr then return end
        syncCount()
        local bcf = boundaryCF(kr)
        local spawn = kr.Position + kr.CFrame.LookVector * AdvBox.spawnForward
        for i, o in ipairs(boxes) do
            local lane = (i - (#boxes + 1) / 2) * 0.9
            local pos = spawn + bcf.RightVector * lane
            o.pos = clampIn(pos, bcf, AdvBox.giant, AdvBox.small)
            o.age = 0
            o.active = true
        end
    end

    function AdvBox.Clear()
        for _, o in ipairs(boxes) do
            o.active = false
            o.part.Transparency = 1
        end
    end

    RunService.Heartbeat:Connect(function(dt)
        if AdvBox.mode ~= "Advanced" then
            AdvBox.Clear()
            boundary.Transparency = 1
            return
        end
        local kr = rootOf(killerModel)
        local pr = rootOf(LP.Character)
        if not kr or not pr then
            AdvBox.Clear()
            return
        end
        local bcf = boundaryCF(kr)
        boundary.Size = AdvBox.giant
        boundary.CFrame = bcf
        boundary.Color = Colors.Bound
        boundary.Transparency = AdvBox.showGiant and 0.88 or 1

        local target = pr.Position
        local inGiant = inside(target, bcf, AdvBox.giant)
        local dest = clampIn(target, bcf, AdvBox.giant, AdvBox.small)
        local spawnBase = kr.Position + kr.CFrame.LookVector * AdvBox.spawnForward
        local anyGreen = false
        syncCount()

        for i, o in ipairs(boxes) do
            if o.active then
                o.age = o.age + dt
                if o.age >= AdvBox.lifetime then
                    o.active = false
                    o.part.Transparency = 1
                else
                    if inGiant then
                        local diff = dest - o.pos
                        if diff.Magnitude > 0.01 then
                            local step = math.min(AdvBox.speed * dt, 40)
                            o.pos = o.pos + diff.Unit * math.min(diff.Magnitude, step)
                        end
                        o.pos = clampIn(o.pos, bcf, AdvBox.giant, AdvBox.small)
                    else
                        local lane = (i - (#boxes + 1) / 2) * 0.9
                        o.pos = clampIn(spawnBase + bcf.RightVector * lane, bcf, AdvBox.giant, AdvBox.small)
                    end
                    local cf = CFrame.new(o.pos) * (bcf - bcf.Position)
                    local col
                    if not inGiant then
                        col = Colors.Out
                    elseif inside(target, cf, AdvBox.small) then
                        col = Colors.Valid
                        anyGreen = true
                    else
                        col = Colors.Invalid
                    end
                    style(o.part, AdvBox.small, cf, col)
                end
            end
        end

        if anyGreen and AB.enabled then
            local now = tick()
            if now - lastValid > 0.12 then
                lastValid = now
                FireBlock()
            end
        end
    end)

    local left = Tabs.Facing:AddLeftGroupbox("Facing Mode")
    left:AddDropdown("FaceMode", {
        Values = { "None", "Normal", "Advanced" },
        Default = 1,
        Text = "Mode",
        Callback = function(v)
            AdvBox.mode = v
            if v ~= "Advanced" then AdvBox.Clear() end
        end,
    })
    left:AddLabel("Advanced = giant + small boxes. Chase only inside giant.", true)
    left:AddToggle("FaceShowSmall", {
        Text = "Show Small Boxes",
        Default = true,
        Callback = function(v) AdvBox.showSmall = v end,
    })
    left:AddToggle("FaceShowGiant", {
        Text = "Show Giant Boundary",
        Default = false,
        Callback = function(v) AdvBox.showGiant = v end,
    })

    local right = Tabs.Facing:AddRightGroupbox("Box Sizes")
    right:AddSlider("FaceCount", {
        Text = "Small Box Count", Default = 3, Min = 1, Max = 8, Rounding = 0,
        Callback = function(v) AdvBox.count = v end,
    })
    right:AddSlider("FaceLife", {
        Text = "Lifetime", Default = 0.55, Min = 0.2, Max = 2, Rounding = 2,
        Callback = function(v) AdvBox.lifetime = v end,
    })
    right:AddSlider("FaceSpeed", {
        Text = "Chase Speed", Default = 70, Min = 20, Max = 150, Rounding = 0,
        Callback = function(v) AdvBox.speed = v end,
    })
    right:AddSlider("FaceSW", {
        Text = "Small Width", Default = 5, Min = 1, Max = 20, Rounding = 0,
        Callback = function(v) AdvBox.small = Vector3.new(v, AdvBox.small.Y, AdvBox.small.Z) end,
    })
    right:AddSlider("FaceSH", {
        Text = "Small Height", Default = 6, Min = 1, Max = 20, Rounding = 0,
        Callback = function(v) AdvBox.small = Vector3.new(AdvBox.small.X, v, AdvBox.small.Z) end,
    })
    right:AddSlider("FaceSL", {
        Text = "Small Length", Default = 8, Min = 1, Max = 25, Rounding = 0,
        Callback = function(v) AdvBox.small = Vector3.new(AdvBox.small.X, AdvBox.small.Y, v) end,
    })
    right:AddSlider("FaceGW", {
        Text = "Giant Width", Default = 16, Min = 6, Max = 40, Rounding = 0,
        Callback = function(v) AdvBox.giant = Vector3.new(v, AdvBox.giant.Y, AdvBox.giant.Z) end,
    })
    right:AddSlider("FaceGL", {
        Text = "Giant Length", Default = 22, Min = 8, Max = 50, Rounding = 0,
        Callback = function(v) AdvBox.giant = Vector3.new(AdvBox.giant.X, AdvBox.giant.Y, v) end,
    })
    right:AddButton({
        Text = "Test Spawn",
        Func = function()
            local k = GetNearestKiller(80)
            if k then
                AdvBox.mode = "Advanced"
                AdvBox.SetKiller(k)
                AdvBox.Trigger()
            end
        end,
    })
end

--═══════════════════════════════════════════════════════════════════
-- AIMBOT (button-start only, optimized — not laggy Chance scan)
--═══════════════════════════════════════════════════════════════════
do
    local Aim = {
        enabled = false,
        lockTime = 0.9,
        predMin = 2,
        predMax = 3,
        locking = false,
        untilT = 0,
        target = nil,
        last = 0,
        hooked = setmetatable({}, { __mode = "k" }),
    }

    local keywords = {
        "slash", "punch", "axe", "stab", "shoot", "gun", "flint",
        "oneshot", "parry", "block", "knife", "dagger",
    }

    local function predict(root)
        if not root then return nil end
        local vel = root.AssemblyLinearVelocity
        local horiz = Vector3.new(vel.X, 0, vel.Z)
        local pos = root.Position
        if horiz.Magnitude < 1.2 then return pos end
        local lead = Aim.predMin + (Aim.predMax - Aim.predMin) * math.clamp(horiz.Magnitude / 28, 0, 1)
        return pos + horiz.Unit * lead
    end

    local function aimAt(root)
        local me = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not me or not root or not root.Parent then return end
        local at = predict(root)
        if not at then return end
        local p = me.Position
        me.CFrame = CFrame.new(p, Vector3.new(at.X, p.Y, at.Z))
    end

    local function startLock()
        if not Aim.enabled or IsPlayerKiller() then return end
        if os.clock() - Aim.last < 0.12 then return end
        local k = GetNearestKiller(80)
        local root = k and k:FindFirstChild("HumanoidRootPart")
        if not root then return end
        Aim.last = os.clock()
        Aim.locking = true
        Aim.untilT = os.clock() + Aim.lockTime
        Aim.target = root
        aimAt(root)
    end

    local function matches(btn)
        local blob = string.lower(tostring(btn.Name or ""))
        pcall(function()
            if btn:IsA("TextButton") or btn:IsA("TextLabel") then
                blob = blob .. " " .. string.lower(tostring(btn.Text or ""))
            end
            for _, d in ipairs(btn:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    blob = blob .. " " .. string.lower(tostring(d.Text or ""))
                end
            end
        end)
        for _, kw in ipairs(keywords) do
            if blob:find(kw, 1, true) then return true end
        end
        return false
    end

    local function hookButton(btn)
        if Aim.hooked[btn] then return end
        if not (btn:IsA("GuiButton") or btn:IsA("ImageButton") or btn:IsA("TextButton")) then
            return
        end
        if not matches(btn) then return end
        Aim.hooked[btn] = true
        local function fire()
            if Aim.enabled then startLock() end
        end
        pcall(function() btn.Activated:Connect(fire) end)
        pcall(function() btn.MouseButton1Click:Connect(fire) end)
        pcall(function() btn.MouseButton1Down:Connect(fire) end)
    end

    -- Lightweight scan: only AbilityContainer / MainUI, not full PlayerGui spam
    local function scan()
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        local main = pg:FindFirstChild("MainUI")
        local ac = main and main:FindFirstChild("AbilityContainer")
        if ac then
            for _, b in ipairs(ac:GetDescendants()) do
                hookButton(b)
            end
            return
        end
        -- fallback: shallow scan MainUI only
        if main then
            for _, b in ipairs(main:GetDescendants()) do
                if b:IsA("GuiButton") or b:IsA("ImageButton") then
                    hookButton(b)
                end
            end
        end
    end

    RunService.RenderStepped:Connect(function()
        if not Aim.locking then return end
        if os.clock() > Aim.untilT then
            Aim.locking = false
            Aim.target = nil
            return
        end
        local k = GetNearestKiller(80)
        local root = k and k:FindFirstChild("HumanoidRootPart")
        if root then Aim.target = root end
        if Aim.target and Aim.target.Parent then
            aimAt(Aim.target)
