-- Strip WindUI's default open / minimize / "cylinder" UI if present
task.spawn(function()
    local function nukeDefaultOpeners(root)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            local n = string.lower(d.Name or "")
            if d:IsA("GuiObject") then
                if n:find("openbutton") or n:find("open_btn") or n:find("togglebutton")
                    or n:find("minimize") or n:find("windui_open") or n:find("circlebutton")
                    or n:find("floatingbutton") or n:find("sidebarbtn") then
                    pcall(function() d.Visible = false end)
                    pcall(function() d:Destroy() end)
                end
            end
        end
    end
    for _ = 1, 8 do
        task.wait(0.25)
        pcall(function()
            if typeof(gethui) == "function" then nukeDefaultOpeners(gethui()) end
        end)
        pcall(function() nukeDefaultOpeners(CoreGui) end)
        pcall(function() nukeDefaultOpeners(PlayerGui) end)
        pcall(function()
            if Window and Window.UI then nukeDefaultOpeners(Window.UI) end
            if Window and Window.Root then nukeDefaultOpeners(Window.Root) end
        end)
    end
end)

