        bb.Adornee = part
        bb.Size = UDim2.new(0, 100, 0, 28)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = model
        local lab = Instance.new("TextLabel")
        lab.Size = UDim2.fromScale(1, 1)
        lab.BackgroundTransparency = 1
        lab.Font = Enum.Font.GothamBold
        lab.TextSize = 11
        lab.TextColor3 = S.generatorColor
        lab.TextStrokeTransparency = 0.5
        lab.Text = "Generator"
        lab.Parent = bb
        local prog = model:FindFirstChild("Progress")
        if prog then
            local function upd()
                lab.Text = string.format("Gen %d%%", math.floor(prog.Value or 0))
            end
            upd()
            prog:GetPropertyChangedSignal("Value"):Connect(upd)
        end
        table.insert(ObjectESPData, { model = model })
    end

    task.spawn(function()
        while not _ShuttingDown do
            task.wait(0.45)
            local pf = Workspace:FindFirstChild("Players")
