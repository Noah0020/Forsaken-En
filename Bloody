local function _IsKillerTargetingOther(killer)
    if not Settings.AntiWrongBlockEnabled then return false end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    local kh = killer:FindFirstChildOfClass("Humanoid")
    if not kr or not kh then return false end
    local mr = Character and Character:FindFirstChild("HumanoidRootPart")
    if not mr then return false end
    local tp = kh.TargetPoint
    if not tp or tp.Magnitude < 0.1 then return false end
    if (tp - mr.Position).Magnitude > (Settings.AntiWrongBlockRange or 15) then return false end
    return (tp - mr.Position).Magnitude > (tp - kr.Position).Magnitude * (1 + (Settings.AntiWrongBlockTolerance or 0.15))
end

local function _UpdateSpinData(killer)
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local now = tick(); local d = _spinData[killer]; local look = kr.CFrame.LookVector
    if not d then _spinData[killer] = { lastLook = look, lastTime = now, angles = {} }; return end
    local dt = now - d.lastTime
    if dt > 0 then
        local dot = math.clamp(d.lastLook:Dot(look), -1, 1)
        local angle = math.deg(math.acos(dot))
        table.insert(d.angles, { angle = angle, speed = angle / dt, time = now })
        local dur = Settings.AntiSpinBaitCheckDuration or 0.5
        while #d.angles > 0 and now - d.angles[1].time > dur do table.remove(d.angles, 1) end
    end
    d.lastLook = look; d.lastTime = now
end

local function _IsKillerSpinning(killer)
    if not Settings.AntiSpinBaitEnabled then return false end
    local d = _spinData[killer]; if not d or #d.angles < 2 then return false end
    local total, mx = 0, 0
    for _, a in ipairs(d.angles) do total += a.angle; if a.speed > mx then mx = a.speed end end
    return mx > (Settings.AntiSpinBaitMaxAngularSpeed or 300)
        or total > (Settings.AntiSpinBaitMaxAngle or 100)
end

local function _UpdateFallData(killer)
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local d = _fallData[killer]
    if not d then _fallData[killer] = { lastY = kr.Position.Y }; return end
    d.deltaY = kr.Position.Y - d.lastY; d.lastY = kr.Position.Y
end

local function FireAbilityByMode(skipSafety, forcedKiller)
    local mode = GetActiveMode()
    local myChar = Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    local killer, kRoot = nil, nil
    if forcedKiller and forcedKiller.Parent then
        killer, kRoot = forcedKiller, forcedKiller:FindFirstChild("HumanoidRootPart")
    elseif kf and myRoot then
        local bd = math.huge
        for _, k in ipairs(kf:GetChildren()) do
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local d = (kr.Position - myRoot.Position).Magnitude
                if d < bd then bd, killer, kRoot = d, k, kr end
            end
        end
    end
    if not skipSafety and killer and kRoot then
        if _IsKillerTargetingOther(killer) then return end
        if _IsKillerSpinning(killer) then return end
    end
    if Settings.WallCheckEnabled and killer and kRoot and myRoot and myChar then
        if IsWallBetween(myRoot, kRoot, myChar, killer) then return end
    end
    if Settings.FacingCheckEnabled and killer and kRoot and myRoot then
        if not PassesFacingCheck(myRoot, kRoot) then return end
    end
    if mode == "hitbox" then
        if Settings.RectangleABMode == "007n7" then FireClone() else FireBlock() end
    elseif mode == "zone" then
        if Settings.CustomABMode == "007n7" then FireClone() else FireBlock() end
    else
        if Settings.ABMode == "007n7" then FireClone() else FireBlock() end
    end
end

