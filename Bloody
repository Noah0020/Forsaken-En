-- AIMBOT (Guesting ActiveLock)
--═══════════════════════════════════════════════════════════════════
do
    getgenv().AimbotValues = {
        Guest1337 = { Enabled = false, Distance = 50, LockDuration = 1.3, Prediction = 0 },
        Shedlekey = { Enabled = false, Distance = 29, LockDuration = 1.2, Prediction = 0 },
        TwoTime = { Enabled = false, Distance = 29, LockDuration = 0.9, Prediction = 0 },
        Chance = { Enabled = false, Distance = 80, LockDuration = 1.5, Prediction = 3 },
        JaneDoe = { Enabled = false, Distance = 50, LockDuration = 1.1, Prediction = 0 },
        Pizza = { Enabled = false, Distance = 50, LockDuration = 1.2, Prediction = 0 },
    }
    getgenv().AnimationData = {
        Guest1337 = {},
        Shedlekey = {},
        TwoTime = { ["100725497418533"] = true, ["89448354637442"] = true },
        Chance = {},
        JaneDoe = {},
        Pizza = { ["114155003741146"] = true },
    }

    pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        if not assets then return end
        local folders = { assets:FindFirstChild("Survivors") }
        local skins = assets:FindFirstChild("Skins")
        if skins then table.insert(folders, skins:FindFirstChild("Survivors")) end
        for _, folder in ipairs(folders) do
            if folder then
                for _, d in ipairs(folder:GetDescendants()) do
                    if d:IsA("ModuleScript") and d.Name == "Config" then
                        local ok, result = pcall(require, d)
                        if ok and type(result) == "table" and type(result.Animations) == "table" then
                            local a = result.Animations
                            local function add(key, val)
                                if not val then return end
                                local id = tostring(val):match("%d+")
                                if id and getgenv().AnimationData[key] then
                                    getgenv().AnimationData[key][id] = true
                                end
                            end
                            add("Guest1337", a.Punch)
                            add("Guest1337", a.ParryPunch)
                            add("Shedlekey", a.Slash)
                            add("JaneDoe", a.Axe)
                            add("Chance", a.AimGun)
                            add("Chance", a.Shoot)
                        end
                    end
                end
            end
        end
    end)

    getgenv().ActiveLock = { IsActive = false, Target = nil, StartTime = 0, Mode = "", Track = nil }
    getgenv().LastFinishedTrack = nil
    getgenv().GlobalAimbotToggle = false
    getgenv().GlobalAimlockMode = "Character Lock"

    local function startLock(modeKey, track)
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then return end
        local cfg = getgenv().AimbotValues[modeKey]
        if not cfg or not cfg.Enabled then return end
        if getgenv().ActiveLock.IsActive then return end
        if track and track == getgenv().LastFinishedTrack then return end
        local target = GetNearestKiller(cfg.Distance or 50)
        if not target then return end
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        getgenv().ActiveLock.IsActive = true
        getgenv().ActiveLock.Target = target
        getgenv().ActiveLock.StartTime = tick()
        getgenv().ActiveLock.Mode = modeKey
        getgenv().ActiveLock.Track = track
        if hum then hum.AutoRotate = false end
    end

    local function onAnim(track)
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then return end
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId):match("%d+")
        if not id then return end
        for modeKey, idMap in pairs(getgenv().AnimationData) do
            local cfg = getgenv().AimbotValues[modeKey]
            if cfg and cfg.Enabled and idMap[id] then
                startLock(modeKey, track)
                return
            end
        end
    end

    local function hookChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 8)
            if not hum then return end
            local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)
            if not animator then return end
            animator.AnimationPlayed:Connect(onAnim)
        end)
    end
    if LP.Character then hookChar(LP.Character) end
    LP.CharacterAdded:Connect(hookChar)

    RunService.RenderStepped:Connect(function()
        if not getgenv().ActiveLock.IsActive then return end
        if not getgenv().GlobalAimbotToggle or IsPlayerKiller() then
            getgenv().ActiveLock.IsActive = false
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
            return
        end
        local character = LP.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then
            getgenv().ActiveLock.IsActive = false
            return
        end
        local mode = getgenv().ActiveLock.Mode
        local cfg = getgenv().AimbotValues[mode]
        if not cfg then
            getgenv().ActiveLock.IsActive = false
            humanoid.AutoRotate = true
            return
        end
        local elapsed = tick() - getgenv().ActiveLock.StartTime
        local target = getgenv().ActiveLock.Target
        local tHRP = target and target:FindFirstChild("HumanoidRootPart")
        local tHum = target and target:FindFirstChildOfClass("Humanoid")
        if not tHRP or (tHum and tHum.Health <= 0) then
            target = GetNearestKiller(cfg.Distance or 50)
            getgenv().ActiveLock.Target = target
            tHRP = target and target:FindFirstChild("HumanoidRootPart")
            tHum = target and target:FindFirstChildOfClass("Humanoid")
        end
        if elapsed > (cfg.LockDuration or 1) or not tHRP then
            getgenv().LastFinishedTrack = getgenv().ActiveLock.Track
            getgenv().ActiveLock.IsActive = false
            getgenv().ActiveLock.Target = nil
            getgenv().ActiveLock.Track = nil
            humanoid.AutoRotate = true
            return
        end
        local position = tHRP.Position
        local pred = cfg.Prediction or 0
        if pred > 0 and tHum and tHum.MoveDirection.Magnitude > 0.05 then
            position = position + tHum.MoveDirection.Unit * pred
        end
        local lookAt = Vector3.new(position.X, hrp.Position.Y, position.Z)
        local cframe = CFrame.lookAt(hrp.Position, lookAt)
        if mode == "Chance" or (tHRP.Position - hrp.Position).Magnitude < 6 then
            hrp.CFrame = cframe
        else
            hrp.CFrame = hrp.CFrame:Lerp(cframe, 0.65)
        end
        if getgenv().GlobalAimlockMode == "Char + Cam Lock" then
            local cam = Workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, position), 0.75)
            end
        end
    end)

    local left = Tabs.Aimbot:AddLeftGroupbox("Aimbot")
    left:AddToggle("Aim_Enable", {
        Text = "Enable Aimbot",
        Default = false,
        Callback = function(v)
            if v and IsPlayerKiller() then
                pcall(function() Toggles.Aim_Enable:SetValue(false) end)
                return
            end
            getgenv().GlobalAimbotToggle = v
            if not v then
                getgenv().ActiveLock.IsActive = false
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = true end
            end
        end,
    })
    left:AddDropdown("Aim_Pick", {
