local VeeAutoTrick = { running=false, thread=nil, last=0 }
local function IsVeeronica(c) if not c then return false end; return (c:GetAttribute("CharacterName") or c.Name) == "Veeronica" end
local function IsTrickZoneActive(c)
    if not c then return false end
    for _, d in ipairs(c:GetDescendants()) do if d:IsA("Highlight") and d.Enabled and d.Adornee and (d.Adornee == c or d.Adornee:IsDescendantOf(c)) then return true end end
    for _, d in ipairs(Workspace:GetChildren()) do if d:IsA("Highlight") and d.Enabled and d.Adornee and (d.Adornee == c or d:IsDescendantOf(c)) then return true end end
    return false
end
local function VeerFireTrick()
    local now = tick(); if now - VeeAutoTrick.last < 0.15 then return end; VeeAutoTrick.last = now
    pcall(function() local VIM = game:GetService("VirtualInputManager"); VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game) end)
    task.delay(0.05, function() pcall(function() local VIM = game:GetService("VirtualInputManager"); VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end) end)
