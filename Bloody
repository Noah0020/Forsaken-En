local flightLoop
local function startFlight()
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); local head = char:FindFirstChild("Head")
    if not hum or not head then return end
    if flightLoop then flightLoop:Disconnect() end
    flightLoop = RunService.Heartbeat:Connect(function(dt)
        if not char.Parent or not hum.Parent or not head.Parent then flightLoop:Disconnect(); flightLoop = nil; return end
        if not hum.PlatformStand then hum.PlatformStand = true end
        if not head.Anchored then head.Anchored = true end
        local md = hum.MoveDirection * (v1.flightSpeed * dt)
        local cam = workspace.CurrentCamera; local hCF = head.CFrame; local cCF = cam.CFrame
        local off = hCF:ToObjectSpace(cCF).Position
        cCF = cCF * CFrame.new(-off.X, -off.Y, -off.Z + 1)
        local cp = cCF.Position; local hp = hCF.Position
        local ov = CFrame.new(cp, Vector3.new(hp.X, cp.Y, hp.Z)):VectorToObjectSpace(md)
        head.CFrame = CFrame.new(hp) * (cCF - cp) * CFrame.new(ov)
    end)
end
local function stopFlight()
    if flightLoop then flightLoop:Disconnect(); flightLoop = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid"); local head = char:FindFirstChild("Head")
        if hum then hum.PlatformStand = false end
        if head then head.Anchored = false end
    end
end
RunService.Heartbeat:Connect(function()
    if v1.flightEnabled and not flightLoop then startFlight()
    elseif not v1.flightEnabled and flightLoop then stopFlight() end
end)
