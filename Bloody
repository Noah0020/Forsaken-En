local function hasHelplessEffect()
    local char = LocalPlayer.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    if char:GetAttribute("Helpless") or char:GetAttribute("Grabbed")
       or char:GetAttribute("Incapacitated") or char:GetAttribute("BeingCarried") then
        return true
    end
    return false
end

local function isFacingTarget(myRoot, targetRoot)
    if not Settings.BlockFaceCheck then return true end
    local d = myRoot.Position - targetRoot.Position
    local mag = d.Magnitude
    if mag < 0.001 then return true end
    return targetRoot.CFrame.LookVector:Dot(d / mag) > Settings.BlockFacingDot
end

