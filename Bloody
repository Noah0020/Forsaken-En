local _velHistory = setmetatable({}, {__mode="k"})
local function getHRPVelocity(hrp)
    if not hrp or not hrp.Parent then return Vector3.zero end
    local now = tick()
    local d = _velHistory[hrp]
    if not d then _velHistory[hrp] = {p=hrp.Position,t=now,v=Vector3.zero,s={}}; return Vector3.zero end
    local dt = now - d.t
    if dt > 0.001 then
        local iv = (hrp.Position - d.p) / dt
        table.insert(d.s, iv)
        if #d.s > 6 then table.remove(d.s, 1) end
        local sum = Vector3.zero
        for _,v in ipairs(d.s) do sum = sum + v end
        d.v = sum / #d.s; d.p = hrp.Position; d.t = now
    end
    return d.v
end

local function extractAnimIds(v, depth)
    depth = depth or 0
    if depth > 6 then return {} end
    local o = {}
    local t = type(v)
    if t == "string" or t == "number" then
        local id = tostring(v):match("%d+")
        if id then table.insert(o, id) end
    elseif t == "table" then
        for _, x in pairs(v) do
            for _, id in ipairs(extractAnimIds(x, depth+1)) do table.insert(o, id) end
        end
    end
    return o
end

local function GetNearestKillerHrp()
    local char = LP.Character; if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart"); if not my then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = r end
            end
        end
    end
    return best
end

