--═══════════════════════════════════════════════════════════════════
-- KILLER WATCHDOG (disable on Killer, restore when back to Survivor)
--═══════════════════════════════════════════════════════════════════
task.spawn(function()
    local wasKiller = false
    local snapshot = nil
    while not _ShuttingDown do
        task.wait(0.4)
        local nowKiller = IsPlayerKiller()

        if nowKiller and not wasKiller then
            -- Snapshot what was on, then turn everything off
            snapshot = {
                autoBlock = _G.AutoBlockEnabled == true,
                hdt       = HDT.enabled == true,
                stab      = stabState.enabled == true,
                sa        = SA.active == true,
                elliot    = elliot.enabled == true,
                chance    = chance.enabled == true,
                jane      = (jd.enabled == true) or (jd.aimbotOn == true),
                dusk      = dusekkar.enabled == true,
                veeAT     = VeerState.atRunning == true,
                veeSkate  = (Vee and Vee.SkateControl) == true,
                veeStats  = (Vee and Vee.CustomStats) == true,
            }

            if snapshot.autoBlock then
                _G.AutoBlockEnabled = false
                pcall(function() Options.AutoBlockToggle:Set(false) end)
            end
            if snapshot.hdt then
                HDT_Stop()
                pcall(function() Options.HDT_En_T:Set(false) end)
            end
            if snapshot.stab then
                stabState.enabled = false
                pcall(function() Options.EnableStabLerp:Set(false) end)
            end
            if snapshot.sa then
                SA.active = false
                if SA.animConn then pcall(function() SA.animConn:Disconnect() end); SA.animConn = nil end
                for _, c in ipairs(SA.soundConns) do pcall(function() c:Disconnect() end) end
                SA.soundConns = {}
                SURVIVOR_ANIM_IDS = {}
                SURVIVOR_SOUND_IDS = {}
                pcall(function() Options.SA_En_T:Set(false) end)
            end
            if snapshot.elliot then
                elliot_stop()
                pcall(function() Options.Ell_En_T:Set(false) end)
            end
            if snapshot.chance then
                chance.enabled = false
                if chance.bodyGyro and chance.bodyGyro.Parent then chance.bodyGyro:Destroy() end
                chance.bodyGyro = nil
                pcall(function() Options.Ch_En_T:Set(false) end)
            end
            if snapshot.jane then
                jd.enabled = false; jd.aimbotOn = false
                pcall(jd_removePatch)
                pcall(function() Options.Jane_En_T:Set(false) end)
            end
            if snapshot.dusk then
                dusekkar.enabled = false
                pcall(function() Options.Dusk_En_T:Set(false) end)
            end
            if snapshot.veeAT then
                VeerATStop()
                pcall(function() Options.Vee_AT_T:Set(false) end)
            end
            if snapshot.veeSkate and Vee then
                Vee.SkateControl = false
                pcall(function() Vee_SkateControl(false) end)
                pcall(function() Options.Vee_Skate_T:Set(false) end)
            end

            Library:Notify({Title = "Vortex", Description = "Survivor features suspended (Killer). Will restore when you are Survivor again.", Time = 5})

        elseif not nowKiller and wasKiller and snapshot then
            -- Restore what was previously enabled
            task.wait(0.6)
            local restored = {}

            if snapshot.autoBlock then
                _G.AutoBlockEnabled = true
                pcall(function() Options.AutoBlockToggle:Set(true) end)
                pcall(EnableAutoBlock)
                table.insert(restored, "AutoBlock")
            end
            if snapshot.hdt then
                HDT.enabled = true
                pcall(function() Options.HDT_En_T:Set(true) end)
                pcall(HDT_Start)
                table.insert(restored, "HDT")
            end
            if snapshot.stab then
                stabState.enabled = true
                pcall(function() Options.EnableStabLerp:Set(true) end)
                table.insert(restored, "Stab")
            end
            if snapshot.sa then
                SA.active = true
                pcall(function() Options.SA_En_T:Set(true) end)
                if LP.Character then pcall(attachSurvivorWatcher, LP.Character) end
                table.insert(restored, "SurvivorAim")
            end
            if snapshot.elliot then
                elliot.enabled = true
                pcall(function() Options.Ell_En_T:Set(true) end)
                pcall(elliot_start)
                table.insert(restored, "Elliot")
            end
            if snapshot.chance then
                chance.enabled = true
                pcall(function() Options.Ch_En_T:Set(true) end)
                table.insert(restored, "Chance")
            end
            if snapshot.jane then
                jd.enabled = true
                jd.aimbotOn = true
                pcall(jd_applyPatch)
                pcall(function() Options.Jane_En_T:Set(true) end)
                table.insert(restored, "Jane")
            end
            if snapshot.dusk then
                dusekkar.enabled = true
                pcall(function() Options.Dusk_En_T:Set(true) end)
                table.insert(restored, "Dusekkar")
            end
            if snapshot.veeAT then
                pcall(VeerATStart)
                pcall(function() Options.Vee_AT_T:Set(true) end)
                table.insert(restored, "Vee-AutoTrick")
            end
            if snapshot.veeSkate and Vee then
                Vee.SkateControl = true
                pcall(function() Vee_SkateControl(true) end)
                pcall(function() Options.Vee_Skate_T:Set(true) end)
                table.insert(restored, "Vee-Skate")
            end
            if snapshot.veeStats and Vee then
                Vee.CustomStats = true
                pcall(function() Vee_ApplyStats(true) end)
                pcall(function() Options.Vee_Stats_T:Set(true) end)
                table.insert(restored, "Vee-Stats")
            end

            Library:Notify({
                Title = "Vortex",
                Description = #restored > 0 and ("Restored: " .. table.concat(restored, ", ")) or "Back as Survivor",
                Time = 5,
            })
            snapshot = nil
        end

        wasKiller = nowKiller
    end
end)

