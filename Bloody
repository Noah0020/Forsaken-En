local function Box_GetRootFolder()
    local f = BoxState.rootFolder
    if f and f.Parent then return f end
    if f and not f.Parent then pcall(function() f:Destroy() end) end
    local folder = Instance.new("Folder")
    folder.Name = "GS_BoxVisuals"; folder.Parent = Workspace
    BoxState.rootFolder = folder
    return folder
end

local function Box_DestroyRootFolder()
    local f = BoxState.rootFolder
    if f then pcall(function() f:Destroy() end); BoxState.rootFolder = nil end
end

local function Box_Alpha(dt)
    return 1 - math.exp(-dt / math.max(Settings.BoxFollowDelay, 0.001))
end

local function Box_UpdateSmoothing(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if not BoxState.player then BoxState.player = hrp.Position
        else BoxState.player = BoxState.player:Lerp(hrp.Position, Box_Alpha(dt)) end
    else
        BoxState.player = nil
    end
    local kf = GetKillersFolder()
    if kf then
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") then
                local khrp = k:FindFirstChild("HumanoidRootPart")
                if khrp then
                    local st = BoxState.killers[k]
                    if not st then
                        st = { pos = khrp.Position, look = khrp.CFrame.LookVector }
                        BoxState.killers[k] = st
                    else
                        local a = Box_Alpha(dt)
                        st.pos = st.pos:Lerp(khrp.Position, a)
                        local nl = khrp.CFrame.LookVector
                        st.look = st.look:Lerp(nl, a)
                        if st.look.Magnitude > 0.01 then st.look = st.look.Unit else st.look = nl.Unit end
                    end
                else
                    BoxState.killers[k] = nil
                end
            end
        end
    end
    for k in pairs(BoxState.killers) do
        if not k.Parent then BoxState.killers[k] = nil end
    end
end

local function AB_IsPlayerInFront(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end
    local toPlayer = BoxState.player - st.pos
    local flatTo = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    if flatTo.Magnitude < 0.5 then return false end
    if flatTo.Magnitude > Settings.BoxRange then return false end
    local flatLook = Vector3.new(st.look.X, 0, st.look.Z)
    if flatLook.Magnitude < 0.01 then return false end
    return flatLook.Unit:Dot(flatTo.Unit) >= Settings.BoxMinFacing
end

local function Box_GetFanDir(look, index, total)
    if total <= 1 then
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then return Vector3.new(0, 0, -1) end
        return flat.Unit
    end
    local t = (index - 1) / (total - 1)
    local angle = math.rad((t - 0.5) * Settings.BoxArc)
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
    flat = flat.Unit
    local c, s = math.cos(angle), math.sin(angle)
    return Vector3.new(flat.X * c - flat.Z * s, 0, flat.X * s + flat.Z * c)
end

local function AB_IsPlayerConnected(killer)
    local st = BoxState.killers[killer]
    if not st or not BoxState.player then return false end
    local halfW = Settings.BoxWidth / 2
    local halfH = Settings.BoxHeight / 2
    local halfL = Settings.BoxLength / 2
    local pHalf = Settings.BoxPlayerW / 2
    local count = math.clamp(math.floor(Settings.BoxCount), 1, 10)

    for i = 1, count do
        local dir = Box_GetFanDir(st.look, i, count)
        if dir.Magnitude > 0.01 then
            dir = dir.Unit
            local boxCenter = st.pos + dir * halfL
            local right = Vector3.new(-dir.Z, 0, dir.X)
            local rel = BoxState.player - boxCenter
            local localX = rel:Dot(right)
            local localY = rel.Y
            local localZ = rel.Dot and rel:Dot(dir) or rel:Dot(dir)
            if math.abs(localX) <= halfW + pHalf
               and math.abs(localY) <= halfH + pHalf
               and math.abs(localZ) <= halfL + pHalf then
                return true
            end
        end
    end
    return false
end

local function AB_ShouldBlock(killer)
    if not AB_IsPlayerInFront(killer) then return false end
    if not AB_IsPlayerConnected(killer) then return false end
    return true
end

local _WIRE = nil
local function GetWire()
    if _WIRE then return _WIRE end
    local c = {
        Vector3.new(-0.5, -0.5, -0.5), Vector3.new(0.5, -0.5, -0.5),
        Vector3.new(0.5, -0.5, 0.5),   Vector3.new(-0.5, -0.5, 0.5),
        Vector3.new(-0.5, 0.5, -0.5),  Vector3.new(0.5, 0.5, -0.5),
        Vector3.new(0.5, 0.5, 0.5),    Vector3.new(-0.5, 0.5, 0.5),
    }
    local e = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    _WIRE = { corners = c, edges = e }
    return _WIRE
end

local function Box_CreateWireframe(parent)
    local wire = GetWire()
    local parts = {}
    for i, e in ipairs(wire.edges) do
        local part = Instance.new("Part")
        part.Name = "GS_BoxEdge"
        part.Anchored = true; part.CanCollide = false
        part.CanTouch = false; part.CanQuery = false
        part.CastShadow = false; part.Material = Enum.Material.Neon
        part.Transparency = 1; part.Parent = parent
        parts[i] = { part = part, c1 = wire.corners[e[1]], c2 = wire.corners[e[2]] }
    end
    return parts
end

local function Box_IsWireframeValid(parts)
    if not parts or #parts == 0 then return false end
    for _, p in ipairs(parts) do
        if not p.part or not p.part.Parent then return false end
    end
    return true
end

local function Box_DestroyWireframe(parts)
    if not parts then return end
    for _, p in ipairs(parts) do
        if p.part then pcall(function() p.part:Destroy() end) end
    end
end

local function Box_UpdateWireframe(parts, cf, size, color)
    for _, p in ipairs(parts) do
        if p.part and p.part.Parent then
            local a = cf:PointToWorldSpace(Vector3.new(p.c1.X*size.X, p.c1.Y*size.Y, p.c1.Z*size.Z))
            local b = cf:PointToWorldSpace(Vector3.new(p.c2.X*size.X, p.c2.Y*size.Y, p.c2.Z*size.Z))
            local len = (b - a).Magnitude
            if len > 0.001 then
                p.part.Transparency = 0.35
                p.part.Color = color
                p.part.Size = Vector3.new(0.06, 0.06, len)
                p.part.CFrame = CFrame.lookAt((a+b)/2, b)
            else
                p.part.Transparency = 1
            end
        end
    end
end

local function Box_HideWireframe(parts)
    if not parts then return end
    for _, p in ipairs(parts) do
        if p.part and p.part.Parent then p.part.Transparency = 1 end
    end
end

local function Box_GetPlayerBox()
    local pb = BoxState.playerBox
    if pb and Box_IsWireframeValid(pb.parts) then return pb end
    if pb then Box_DestroyWireframe(pb.parts) end
    local parts = Box_CreateWireframe(Box_GetRootFolder())
    pb = { parts = parts }
    BoxState.playerBox = pb
    return pb
end

local function Box_GetKillerBoxSet(killer, count)
    local set = BoxState.killerBoxSets[killer]
    if set and #set.boxes == count then
        local allValid = true
        for _, b in ipairs(set.boxes) do
            if not Box_IsWireframeValid(b.parts) then allValid = false; break end
        end
        if allValid then return set end
    end
    if set then
        for _, b in ipairs(set.boxes) do Box_DestroyWireframe(b.parts) end
    end
    local boxes = {}
    for i = 1, count do
        boxes[i] = { parts = Box_CreateWireframe(Box_GetRootFolder()) }
    end
    set = { boxes = boxes }
    BoxState.killerBoxSets[killer] = set
    return set
end

local function Box_RenderAll()
    if not Settings.AB_ShowZone then
        for _, set in pairs(BoxState.killerBoxSets) do
            for _, b in ipairs(set.boxes) do Box_HideWireframe(b.parts) end
        end
        if BoxState.playerBox then Box_HideWireframe(BoxState.playerBox.parts) end
        return
    end

    for killer, set in pairs(BoxState.killerBoxSets) do
        if not killer.Parent then
            for _, b in ipairs(set.boxes) do Box_DestroyWireframe(b.parts) end
            BoxState.killerBoxSets[killer] = nil
        end
    end

    local kf = GetKillersFolder()
    if not kf or not BoxState.player then
        for _, set in pairs(BoxState.killerBoxSets) do
            for _, b in ipairs(set.boxes) do Box_HideWireframe(b.parts) end
        end
        if BoxState.playerBox then Box_HideWireframe(BoxState.playerBox.parts) end
        return
    end

    local count = math.clamp(math.floor(Settings.BoxCount), 1, 10)
    local size = Vector3.new(Settings.BoxWidth, Settings.BoxHeight, Settings.BoxLength)
    local halfL = Settings.BoxLength / 2
    local anyKillerVisible = false

    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            local st = BoxState.killers[killer]
            local visible = AB_IsPlayerInFront(killer)
            if not visible then
                local set = BoxState.killerBoxSets[killer]
                if set then
                    for _, b in ipairs(set.boxes) do Box_HideWireframe(b.parts) end
                end
            elseif st then
                anyKillerVisible = true
                local set = Box_GetKillerBoxSet(killer, count)
                local connected = AB_IsPlayerConnected(killer)
                local color = connected and GREEN or BLUE
                for i = 1, count do
                    local dir = Box_GetFanDir(st.look, i, count)
                    if dir.Magnitude > 0.01 then
                        dir = dir.Unit
                        local boxCenter = st.pos + dir * halfL
                        local cf = CFrame.lookAt(boxCenter, boxCenter + dir)
                        Box_UpdateWireframe(set.boxes[i].parts, cf, size, color)
                    else
                        Box_HideWireframe(set.boxes[i].parts)
                    end
                end
            end
        end
    end

    if anyKillerVisible then
        local pb = Box_GetPlayerBox()
        local s = Settings.BoxPlayerW
        Box_UpdateWireframe(pb.parts, CFrame.new(BoxState.player), Vector3.new(s, s, s), BLUE)
    elseif BoxState.playerBox then
        Box_HideWireframe(BoxState.playerBox.parts)
    end
end

local function Box_StartRender()
    if BoxState.renderConn then return end
    BoxState.renderConn = RunService.RenderStepped:Connect(function(dt)
        Box_UpdateSmoothing(dt or 0.016)
        Box_RenderAll()
    end)
end

local function Box_StopRender()
    if BoxState.renderConn then
        pcall(function() BoxState.renderConn:Disconnect() end)
        BoxState.renderConn = nil
    end
end

