-- SAVE / LOAD
local CONFIG_NAME = "ForsakenMinusOne_Config.json"
local function Config_Save()
    local data = {}
    for k, v in pairs(Settings) do
        if type(v) == "number" or type(v) == "string" or type(v) == "boolean" then data[k] = v end
    end
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then return false end
    if writefile then return pcall(writefile, CONFIG_NAME, encoded) end
    return false
end
local function Config_Load()
    if not (isfile and readfile) then return false, "no file API" end
    local ok, body = pcall(readfile, CONFIG_NAME)
    if not ok or not body then return false, "no file" end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok2 or type(data) ~= "table" then return false, "bad json" end
    for k, v in pairs(data) do if Settings[k] ~= nil then Settings[k] = v end end
    if Settings.AB_Enabled then AB_Enable() else AB_Disable() end
    if Settings.AIM_Enabled then Aim_SetupHook() end
    return true
end
local function Config_Delete()
    if delfile and isfile and isfile(CONFIG_NAME) then pcall(delfile, CONFIG_NAME); return true end
    return false
end

