-- Patch 2: OnKillerM1 retries within AB_PendingWindow, logs each rejection
local function OnKillerM1(killer)
    if not AB.running then return end
    if not killer or not killer.Parent then return end

    Box_ShowOnM1(killer)

    local deadline = tick() + (Settings.AB_PendingWindow or 0.25)

    local function attempt()
        if not AB.running or not killer or not killer.Parent then return end

        if not AB_IsBlockReady() then
            AB_Log("retry", "cooldown")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end

        if not AB_ShouldBlock(killer) then
            AB_Log("retry", "facing/range/velocity")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end

        if not AB.perKiller[killer] then AB_HookKiller(killer) end
        local st = AB.perKiller[killer]
        if not st then return end

        if tick() - (st.lastFireAt or 0) < 0.05 then
            AB_Log("retry", "fire-debounce")
            if tick() < deadline then task.delay(0.02, attempt) end
            return
        end

        st.lastFireAt = tick()
        AB.lastBlock = tick()
        AB_Log("fire", "ok")
        AB_Fire()
    end

    attempt()
end

