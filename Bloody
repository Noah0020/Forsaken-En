    end
    if ESP.survivor and survivors then
        for _, s in ipairs(survivors:GetChildren()) do if s:IsA("Model") and s ~= LP.Character then seen[s]=true; ensureESP(s,"survivor",s.Name) end end
    end
    if ESP.generator or ESP.item or ESP.minion or ESP.trap or ESP.spray then
        local map = Workspace:FindFirstChild("Map")
        local ingame = map and map:FindFirstChild("Ingame")
        local scanRoots = {}
        if ingame then table.insert(scanRoots, ingame) end
        if map then table.insert(scanRoots, map) end
        if #scanRoots==0 then
            local pFolder = Workspace:FindFirstChild("Players")
            if pFolder then table.insert(scanRoots, pFolder) end
        end
        for _, root in ipairs(scanRoots) do
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("Model") and not seen[obj] then
                    if ESP.generator and obj.Name=="Generator" then seen[obj]=true; ensureESP(obj,"generator")
                    elseif ESP.item and (obj.Name=="Item" or obj:GetAttribute("Item") or obj.Name=="BloxyCola" or obj.Name=="Medkit") then seen[obj]=true; ensureESP(obj,"item")
                    elseif ESP.minion and (obj.Name=="PizzaDeliveryRig" or obj.Name=="1x1x1x1Zombie") then seen[obj]=true; ensureESP(obj,"minion")
                    elseif ESP.trap and (obj.Name=="SubspaceTripmine" or obj.Name:find("TaphTripwire")) then seen[obj]=true; ensureESP(obj,"trap")
                    elseif ESP.spray and obj.Name:find("Spray") then seen[obj]=true; ensureESP(obj,"spray")
                    end
                end
            end
        end
    end
    for inst in pairs(ESP.tracked) do if not seen[inst] or not inst.Parent then clearOne(inst) end end
end
