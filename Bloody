--// Attack labels requested. TAB is matched as a whole word so that the
--// letters inside unrelated names do not cause accidental triggers.
local ATTACK_CUES = {
    "carving slash",
    "eviscerate",
    "perforating",
    "lacerate",
    "stab",
    "slash",
    "tab",
}

local function hasWholeWord(text, word)
    local padded = " " .. string.lower(tostring(text or "")):gsub("[^%w]+", " ") .. " "
    return string.find(padded, " " .. word .. " ", 1, true) ~= nil
end

local function matchesAttackCue(text)
    local value = string.lower(tostring(text or ""))
    if value == "" then return false end
    for _, cue in ipairs(ATTACK_CUES) do
        if cue == "tab" then
            if hasWholeWord(value, "tab") then return true end
        elseif string.find(value, cue, 1, true) then
            return true
        end
    end
    return false
end

local function isWatchedKiller(model)
    if not model or not model:IsA("Model") then return false end
    local name = string.lower(model.Name)
    for _, wanted in ipairs(WATCHED_KILLERS) do
        if string.find(name, wanted, 1, true) then return true end
    end
    return false
end

local function getKillersFolder()
    local folder = Workspace:FindFirstChild("Players")
    return folder and folder:FindFirstChild("Killers") or nil
end

local function getKillerFromInstance(instance)
    local folder = getKillersFolder()
    if not folder or not instance then return nil end
    local cursor = instance
    while cursor and cursor ~= folder do
        if cursor:IsA("Model") and isWatchedKiller(cursor) then
            return cursor
        end
        cursor = cursor.Parent
    end
    return nil
end

local function getRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("RootPart") or model.PrimaryPart
end

local function localPlayerIsKiller()
    local state = G("KillerState")
    if type(state) == "table" and state.isKiller == true then return true end
    local check = G("IsLocalPlayerKiller")
    if type(check) == "function" then
        local ok, result = pcall(check)
        if ok and result == true then return true end
    end
    return false
end

local function getLocalParts()
    local character = LocalPlayer and LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or humanoid.Health <= 0 or not root then
        return nil, nil, nil
    end
    return character, humanoid, root
end

local function getPingSeconds()
    local ping = 0.08
    pcall(function()
        ping = (Stats.Network.ServerStatsItem["Data Ping"]:GetValue() or 80) / 1000
    end)
    return math.clamp(tonumber(ping) or 0.08, 0, 0.60)
end

