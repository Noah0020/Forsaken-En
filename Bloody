RunService.RenderStepped:Connect(function(dt)
    if Vee.Sk8Control then
        if IsPlayingAnim("117058860640843") then
            if not ControlActive and LocalHum then
                ControlActive=true; SavedHum[LocalHum]={WalkSpeed=LocalHum.WalkSpeed,AutoRotate=LocalHum.AutoRotate}
                pcall(function() LocalHum.WalkSpeed=60; LocalHum.AutoRotate=false end)
                ControlConnection=RunService.RenderStepped:Connect(function()
                    if not LocalHum or not LocalRoot then return end
                    pcall(function() LocalHum.WalkSpeed=60; LocalHum.AutoRotate=false end)
                    local look=LocalRoot.CFrame.LookVector; local flat=Vector3.new(look.X,0,look.Z)
                    if flat.Magnitude>0 then LocalHum:Move(flat.Unit) end
                end)
            end
        elseif ControlActive then
            ControlActive=false
            if ControlConnection then ControlConnection:Disconnect(); ControlConnection=nil end
            if LocalHum and SavedHum[LocalHum] then
                pcall(function() LocalHum.WalkSpeed=SavedHum[LocalHum].WalkSpeed; LocalHum.AutoRotate=true; LocalHum:Move(Vector3.zero) end)
