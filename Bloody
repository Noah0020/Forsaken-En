                    "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"}).Body)
            if data and data.errors and #data.errors>0 and tonumber(data.errors[1].code)==0 then
                notify("Dogsaken","Rate limited. Wait 20s.",20); return end
            local bid, bp, bpl = nil, math.huge, -math.huge
            if data and data.data then
                for _,s in pairs(data.data) do
