        end,
    })
end

-- Syncsaken compatibility layer: source callbacks now target dedicated Obsidian tabs.
local SyncControlCounts, SyncUsedIds = {}, {}
local function SyncSlug(value)
    local cleaned = tostring(value or "Control"):gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", "")
    return cleaned ~= "" and cleaned or "Control"
end
local function SyncUniqueId(category, config)
    local baseId = "SS_" .. SyncSlug(category) .. "_" .. SyncSlug(config.Flag or config.Name or "Control")
    local count = (SyncControlCounts[baseId] or 0) + 1
    SyncControlCounts[baseId] = count
    local id = count == 1 and baseId or (baseId .. "_" .. tostring(count))
    while SyncUsedIds[id] do count += 1; id = baseId .. "_" .. tostring(count) end
    SyncUsedIds[id] = true
    return id
end
local function SyncHandle(control)
    local handle = { _control = control }
    function handle:Set(value)
        local c = self._control
        if not c then return end
        if type(c.SetValue) == "function" then c:SetValue(value)
        elseif type(c.Set) == "function" then c:Set(value)
        elseif type(c.SetText) == "function" then c:SetText(tostring(value)) end
    end
    return setmetatable(handle, {
        __index = function(self, key)
            local c = rawget(self, "_control")
            if c then return c[key] end
        end,
    })
end
local SyncTabConfig = {
    Visual = { tab = Tabs.ESP, group = "Syncsaken ESP", side = "Left", icon = "eye" },
    Aimbot = { tab = Tabs.Aim, group = "Syncsaken Aim", side = "Left", icon = "crosshair" },
    Prediction = { tab = Tabs.Aim, group = "Aim Prediction", side = "Right", icon = "sliders-horizontal" },
    Other = { tab = Tabs.Utilities, group = "Syncsaken Utilities", side = "Left", icon = "wrench" },
}
local function MakeSyncTab(category)
    local cfg = SyncTabConfig[category]
    assert(cfg and cfg.tab, "Unknown Syncsaken section: " .. tostring(category))
    local group = addGroup(cfg.tab, cfg.side, cfg.group, "Imported from the original Syncsaken feature section", cfg.icon)
    local shim = { Group = group }
    function shim:CreateLabel(text) return SyncHandle(group:AddLabel(tostring(text or ""), true)) end
    function shim:CreateSection(text) return SyncHandle(group:AddLabel(tostring(text or ""), true)) end
    function shim:CreateDivider() return group:AddDivider() end
    function shim:CreateToggle(info)
        info = info or {}
        local id = SyncUniqueId(category, info)
        local control = group:AddToggle(id, {
            Text = tostring(info.Name or id),
            Default = info.CurrentValue == true,
            Tooltip = info.Tooltip,
            Callback = function(value)
                if type(info.Callback) == "function" then
                    local ok, err = pcall(info.Callback, value)
                    if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
                end
            end,
        })
        return SyncHandle(control)
    end
    function shim:CreateSlider(info)
        info = info or {}
        local id = SyncUniqueId(category, info)
        local range = info.Range or { 0, 100 }
        local minimum, maximum = tonumber(range[1]) or 0, tonumber(range[2]) or 100
        local step = tonumber(info.Increment) or 1
        local rounding = step > 0 and step < 1 and math.clamp(math.ceil(-math.log10(step)), 0, 4) or 0
        local control = group:AddSlider(id, {
            Text = tostring(info.Name or id),
            Default = math.clamp(tonumber(info.CurrentValue) or minimum, minimum, maximum),
            Min = minimum, Max = maximum, Rounding = rounding, Suffix = tostring(info.Suffix or ""),
            Callback = function(value)
                if type(info.Callback) == "function" then
                    local ok, err = pcall(info.Callback, value)
                    if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
                end
            end,
        })
        return SyncHandle(control)
    end
    function shim:CreateDropdown(info)
        info = info or {}
        local id = SyncUniqueId(category, info)
        local current = info.CurrentOption
        local default = current
        if type(current) == "table" and info.MultipleOptions ~= true then default = current[1] end
        local control = group:AddDropdown(id, {
            Text = tostring(info.Name or id), Values = info.Options or {}, Default = default,
            Multi = info.MultipleOptions == true, MaxVisibleDropdownItems = 10,
            Callback = function(value)
                if type(info.Callback) == "function" then
                    local callbackValue = value
                    if info.MultipleOptions ~= true and type(value) ~= "table" then callbackValue = { value } end
                    local ok, err = pcall(info.Callback, callbackValue)
                    if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
                end
            end,
        })
        return SyncHandle(control)
    end
    function shim:CreateButton(info)
        info = info or {}
        local control = group:AddButton({ Text = tostring(info.Name or "Button"), Func = function()
            if type(info.Callback) == "function" then
                local ok, err = pcall(info.Callback)
                if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
            end
        end })
        return SyncHandle(control)
    end
    function shim:CreateInput(info)
        info = info or {}
        local id = SyncUniqueId(category, info)
        local control = group:AddInput(id, {
            Text = tostring(info.Name or id), Default = tostring(info.CurrentValue or ""),
            Placeholder = tostring(info.PlaceholderText or ""), ClearTextOnFocus = info.RemoveTextAfterFocusLost ~= false,
            Callback = function(value)
                if type(info.Callback) == "function" then
                    local ok, err = pcall(info.Callback, value)
                    if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
                end
            end,
        })
        return SyncHandle(control)
    end
    function shim:CreateColorPicker(info)
        info = info or {}
        local id = SyncUniqueId(category, info)
        local label = group:AddLabel(tostring(info.Name or id), true)
        local control = label:AddColorPicker(id, {
            Default = info.Color or Color3.new(1, 1, 1), Title = tostring(info.Name or id),
            Callback = function(value)
                if type(info.Callback) == "function" then
                    local ok, err = pcall(info.Callback, value)
                    if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
                end
            end,
        })
        return SyncHandle(control)
    end
    function shim:CreateKeybind(info)
        info = info or {}
        local id = SyncUniqueId(category, info)
        local label = group:AddLabel(tostring(info.Name or "Keybind"), true)
        local control = label:AddKeyPicker(id, {
            Default = info.CurrentKeybind or "RightShift",
            Mode = info.HoldToInteract and "Hold" or "Press",
            Text = tostring(info.Name or "Keybind"),
            Callback = function(value)
                if type(info.Callback) == "function" then
                    local ok, err = pcall(info.Callback, value)
                    if not ok then warn("[Doggysaken/Sync] " .. tostring(err)) end
                end
            end,
        })
        return SyncHandle(control)
    end
    function shim:CreateParagraph(info)
        info = info or {}
        local title = tostring(info.Title or "")
        local content = tostring(info.Content or "")
        return SyncHandle(group:AddLabel((title ~= "" and (title .. "\n") or "") .. content, true))
    end
    return shim
end
