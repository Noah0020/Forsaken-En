local TwoTime = {
    running = false, conn = nil,
    hooked = false, origNamecall = nil,
    animWatchers = {},
}

local TwoTimeKillerNames = {
    azurewrath=true, jason=true, c00lkidd=true, johndoe=true,
    ["1x1x1x1"]=true, noli=true, slasher=true, nosferatu=true,
    azure=true, coolkid=true, coolkidd=true, sixer=true,
    ["666"]=true, guest666=true, doombringer=true, ["zombie king"]=true,
}

local function TwoTimeIsKiller(name)
    name = string.lower(tostring(name or ""))
    if TwoTimeKillerNames[name] then return true end
    for k in pairs(TwoTimeKillerNames) do
        if name:find(k, 1, true) then return true end
    end
    return false
end

local function TwoTimeNearestKiller()
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local nearest, shortest = nil, math.huge
    local function check(model)
        if not model or not TwoTimeIsKiller(model.Name) then return end
        local root = model:FindFirstChild("HumanoidRootPart")
        local hum = model:FindFirstChildOfClass("Humanoid")
        if root and hum and hum.Health > 0 then
            local d = (myRoot.Position - root.Position).Magnitude
            if d < shortest then shortest = d; nearest = model end
        end
    end
    local kf = GetKillersFolder()
    if kf then
        for _, k in ipairs(kf:GetChildren()) do
            check(k)
            for _, d in ipairs(k:GetDescendants()) do
                if d:IsA("Model") then check(d) end
            end
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then check(plr.Character) end
    end
    return nearest
end

local function TwoTimeCleanup()
    if TwoTime.conn then pcall(function() TwoTime.conn:Disconnect() end); TwoTime.conn = nil end
    TwoTime.running = false
end

local function TwoTimeRunSequence()
    if not Settings.TT_Enabled then return end
    if TwoTime.running then return end
    if IsPlayerKiller() then return end
    if NA.active and Settings.AIM_Enabled then return end
    TwoTime.running = true

    local character = LP.Character
    if not character then TwoTimeCleanup(); return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then TwoTimeCleanup(); return end

    task.wait(Settings.TT_Delay or 0.007)
    if not character.Parent then TwoTimeCleanup(); return end

    local killer = TwoTimeNearestKiller()
    if not killer then TwoTimeCleanup(); return end

    local place = Instance.new("Part")
    place.Name = "Cupcake_TT_Place"
    place.Size = Vector3.new(5.5, 5.5, 5.5)
    place.Transparency = 1
    place.CanCollide = false
    place.Anchored = true
    place.Massless = true
    place.Parent = character

    local originalPrimary = character.PrimaryPart
    character.PrimaryPart = place

    local startTime = os.clock()
    local dur = Settings.TT_Duration or 1.35
    local behind = Settings.TT_Behind or 3.45

    TwoTime.conn = RunService.RenderStepped:Connect(function()
        if not character.Parent or not place.Parent or os.clock() - startTime > dur then
            TwoTimeCleanup()
            if place and place.Parent then place:Destroy() end
            if character and character.Parent then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                    character.PrimaryPart = root
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                elseif originalPrimary and originalPrimary.Parent then
                    character.PrimaryPart = originalPrimary
                end
            end
            return
        end
        local killerHrp = killer and killer.Parent and killer:FindFirstChild("HumanoidRootPart")
        local kHum = killer and killer.Parent and killer:FindFirstChildOfClass("Humanoid")
        if killerHrp and kHum and kHum.Health > 0 then
            place.CFrame = killerHrp.CFrame * CFrame.new(0, 0, behind)
            place.AssemblyLinearVelocity = Vector3.zero
            place.AssemblyAngularVelocity = Vector3.zero
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        else
            killer = TwoTimeNearestKiller()
        end
    end)
end

local function TwoTimeIsDaggerAbility(name)
    if type(name) ~= "string" then return false end
    local l = name:lower()
    return l:find("dagger", 1, true) ~= nil or l:find("stab", 1, true) ~= nil or l:find("backstab", 1, true) ~= nil
