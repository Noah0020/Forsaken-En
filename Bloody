local AP = { running=false, conn=nil, soundConns={}, soundDebounce={} }
local function AP_Hook(sound)
    if not sound:IsA("Sound") or sound:GetAttribute("GS_AP") then return end
    sound:SetAttribute("GS_AP", true)
    table.insert(AP.soundConns, sound.Played:Connect(function()
        if not AP.running or not ParrySounds[sound.SoundId] then return end
        local now = tick()
        if now - (AP.soundDebounce[sound] or 0) < 0.3 then return end
        AP.soundDebounce[sound] = now
        task.wait(Settings.AP_Delay)
        if not AP.running then return end
        AB_FireBlock()
        if NetworkEvent then pcall(function() NetworkEvent:FireServer("UseActorAbility", {"Punch"}) end) end
    end))
end
local function AP_Enable()
    if AP.running then return end
    AP.running = true
    local char = LocalPlayer.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do AP_Hook(d) end
        table.insert(AP.soundConns, char.DescendantAdded:Connect(AP_Hook))
    end
    AP.conn = LocalPlayer.CharacterAdded:Connect(function(c)
        if not AP.running then return end
        for _, d in ipairs(c:GetDescendants()) do AP_Hook(d) end
        table.insert(AP.soundConns, c.DescendantAdded:Connect(AP_Hook))
    end)
end
local function AP_Disable()
    AP.running = false
    for _, c in ipairs(AP.soundConns) do pcall(function() c:Disconnect() end) end
    AP.soundConns = {}; AP.soundDebounce = {}
    if AP.conn then pcall(function() AP.conn:Disconnect() end); AP.conn=nil end
end

--═══ PUNCH AIM ═══
local PA = { running=false, looking=false, lookStarted=nil, loop=nil }
local function PA_AimOnce(humanoid, root, hrp)
    if not humanoid or not humanoid.Parent or not root or not root.Parent or not hrp or not hrp.Parent then return end
    local oldAuto = humanoid.AutoRotate
    pcall(function() humanoid.AutoRotate = false end)
    local endT = tick() + 0.5
    while tick() < endT and PA.running do
        if not humanoid.Parent or not root.Parent or not hrp.Parent then break end
        local km = hrp.Parent
        local kh = km and km:FindFirstChildOfClass("Humanoid")
        local target = hrp.Position
        if kh then
            local md = kh.MoveDirection
            if md and md.Magnitude > 0.01 then target = target + md * Settings.PA_Prediction end
        end
        pcall(function() root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.X, root.Position.Y, target.Z)) end)
        RunService.Heartbeat:Wait()
    end
    if humanoid.Parent then pcall(function() humanoid.AutoRotate = oldAuto end) end
end
local function PA_Loop()
    while PA.running do
        RunService.Heartbeat:Wait()
        if PA.looking and PA.lookStarted and (tick() - PA.lookStarted) > 2 then PA.looking = false; PA.lookStarted = nil end
        if not PA.looking then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root and root.Parent and hum.Health > 0 then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    local aid = track.Animation and track.Animation.AnimationId
