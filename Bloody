local rfDispatch = { hooks = {}, installed = false, originalCallback = nil }
function rfDispatch:register(id, cb) self.hooks[id] = cb end
function rfDispatch:install(rf)
    if self.installed or not rf then return end
    if typeof(getcallbackvalue) == "function" then
        self.originalCallback = getcallbackvalue(rf, "OnClientInvoke")
    else
        self.originalCallback = rf.OnClientInvoke
    end
    rf.OnClientInvoke = function(name, ...)
        if name == "GetMousePosition" or name == "GetCameraCF" then
            for _, cb in pairs(self.hooks) do
                local ok, res = pcall(cb, name, ...)
                if ok and res ~= nil then return res end
            end
        end
        if self.originalCallback then
            local ok, res = pcall(self.originalCallback, name, ...)
            if ok then return res end
        end
    end
    self.installed = true
end
if NetworkRF then pcall(function() rfDispatch:install(NetworkRF) end) end

local function GetNearestKillerModel(maxDist)
    local char = LP.Character
    if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(kf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

local function GetNearestSurvivorModel(maxDist)
    local char = LP.Character
    if not char then return nil end
    local my = char:FindFirstChild("HumanoidRootPart")
    if not my then return nil end
    local sf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not sf then return nil end
    local best, bd = nil, maxDist or math.huge
    for _, m in ipairs(sf:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local r = m:FindFirstChild("HumanoidRootPart")
            local h = m:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - my.Position).Magnitude
                if d < bd then bd = d; best = m end
            end
        end
    end
    return best
end

-- Facing helper (Nerg-style)
local function IsFacingTarget(fromHRP, toHRP, maxAngleDeg)
    if not fromHRP or not toHRP then return false end
    local flatLook = Vector3.new(fromHRP.CFrame.LookVector.X, 0, fromHRP.CFrame.LookVector.Z)
    local flatTo = Vector3.new(toHRP.Position.X - fromHRP.Position.X, 0, toHRP.Position.Z - fromHRP.Position.Z)
    if flatLook.Magnitude < 0.01 or flatTo.Magnitude < 0.01 then return false end
    local dot = flatLook.Unit:Dot(flatTo.Unit)
    local ang = math.deg(math.acos(math.clamp(dot, -1, 1)))
    return ang <= (maxAngleDeg or 85)
end

