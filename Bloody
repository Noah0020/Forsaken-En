local SAim = CONFIG.SURVIVOR_AIM
local Aim = { active=false, startT=0, lastTrig=0, hookDone=false, endT=0 }

local function ExtractAbility(arg)
    if arg == nil then return nil end
    local t = type(arg)
    if t == "string" then return arg end
    if t == "buffer" then
        local ok, s = pcall(function()
            local len = buffer.readu8(arg, 1)
            if len < 1 or len > 64 then return nil end
            local out = ""
            for i = 5, 5+len-1 do
                local b = buffer.readu8(arg, i)
                if b >= 32 and b <= 126 then out = out .. string.char(b) end
            end
            return out
        end)
        return ok and s or nil
    end
    if t == "table" then return ExtractAbility(arg[1]) end
    return nil
end

local function IsOffensiveAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local l = name:lower()
    if SAim.OnSlash and l == "slash" then return true end
    if SAim.OnBlock and (l == "block" or l == "parry" or l == "punch") then return true end
    if SAim.OnDagger and l:find("dagger", 1, true) then return true end
    if SAim.OnAxe and (l == "axe" or l == "hatchet") then return true end
    if SAim.OnShoot then
        if l == "shoot" then return true end
        if l:find("oneshot", 1, true) or l:find("flintlock",1,true) then return true end
        if l:find("sixshot",1,true) or l:find("sixshooter",1,true) then return true end
        if l:find("gun",1,true) or l:find("shot",1,true) then return true end
    end
    return false
end

local function GetLockTime(name)
    local base = SAim.LockTime
    if type(name) ~= "string" then return base end
    local l = name:lower()
    if l == "shoot" then return math.max(base, 1.15) end
    if l == "slash" then return math.max(base, 0.65) end
    if l:find("dagger", 1, true) then return math.max(base, 0.85) end
    if l == "axe" or l == "hatchet" then return math.max(base, 0.70) end
    return base
end

local function Aim_GetTarget()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not kf then return nil, nil end
    local killer, kr, dist = nil, nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local krp = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if krp and kh and kh.Health > 0 then
            local d = (krp.Position - hrp.Position).Magnitude
            if d < dist then dist = d; killer = k; kr = krp end
        end
    end
    if not killer or dist > SAim.Range or dist < SAim.MinDist then return nil, nil end
    local vel = kr.AssemblyLinearVelocity or Vector3.zero
    if vel.Magnitude > 50 then vel = vel.Unit * 50 end
    local predN = math.clamp(SAim.Prediction, 1, 10)
    return hrp, kr.Position + vel * (predN * 0.05)
end

local function Aim_InstantRotate(abilityName)
    local hrp, target = Aim_GetTarget()
    if not hrp or not target then return false end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = false end
    pcall(function()
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z))
    end)
    local now = tick()
    Aim.active = true
    Aim.startT = now
    Aim.endT = now + GetLockTime(abilityName)
    return true
end

local NetworkEventForAim = nil
do
    local m  = ReplicatedStorage:FindFirstChild("Modules")
    local n1 = m and m:FindFirstChild("Network", true)
    local n2 = n1 and n1:FindFirstChild("Network", true)
    NetworkEventForAim = n2 and n2:FindFirstChild("RemoteEvent")
    if not NetworkEventForAim then NetworkEventForAim = ReplicatedStorage:FindFirstChild("RemoteEvent", true) end
end

local function Aim_SetupHook()
    if Aim.hookDone or not NetworkEventForAim or not hookmetamethod then return false end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if SAim.Enabled and getnamecallmethod() == "FireServer" and self == NetworkEventForAim then
                local args = {...}
                if args[1] == "UseActorAbility" then
                    local n = ExtractAbility(args[2])
                    if IsOffensiveAbility(n) then Aim_InstantRotate(n) end
                end
            end
            return old(self, ...)
        end)
    end)
    if ok then Aim.hookDone = true end
    return ok
end

RunService.RenderStepped:Connect(function()
    if not SAim.Enabled then
        if Aim.active then
            Aim.active = false
            local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = true end
        end
        return
    end
    if not Aim.active or tick() > Aim.endT then
        if Aim.active then
            Aim.active = false
            local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = true end
        end
        return
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local h = char:FindFirstChildOfClass("Humanoid"); if h then h.AutoRotate = false end
    local _, target = Aim_GetTarget()
    if not target then return end
    if SAim.Mode == "Character" or SAim.Mode == "Both" then
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z)) end)
    end
    if SAim.Mode == "Camera" or SAim.Mode == "Both" then
        local cam = Workspace.CurrentCamera
        if cam then pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target) end) end
    end
end)

