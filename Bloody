    AB.KillersFolder = p and p:FindFirstChild("Killers")
    table.insert(AB.connections, RunService.Heartbeat:Connect(function()
        if not AB.running or AB.generation ~= myG then return end
        AttrHeartbeat()
    end))
    EnsureRectLoop()
end
local function StopAutoBlock()
    AB.running = false; AB.generation = AB.generation + 1; AB.attrStates = {}
    for _, c in ipairs(AB.connections) do pcall(function() c:Disconnect() end) end
    AB.connections = {}
    StopRectLoop()
    DestroyAllBoxes()
end

