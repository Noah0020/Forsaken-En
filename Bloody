-- ═══════════════════════════════════════════════════════════
--  AUTO BLOCK CORE  (SyncSaken spatial-overlap engine)
-- ═══════════════════════════════════════════════════════════
local BLOCK_NAMES_LOWER = {}
for _, n in ipairs(_G.BlockAbilityNames) do BLOCK_NAMES_LOWER[n:lower()] = true end

local function nameMatchesBlock(rawName)
    if type(rawName) ~= "string" or rawName == "" then return false end
    local lname = rawName:lower()
    for bn in pairs(BLOCK_NAMES_LOWER) do
        if string.find(lname, bn, 1, true) then return true end
    end
    return false
end

local function extractAnimIds(v)
    local out = {}
    if type(v) == "number" then
        table.insert(out, tostring(math.floor(v)))
    elseif type(v) == "string" then
        local id = v:match("%d+")
        if id then table.insert(out, id) end
    elseif type(v) == "table" then
        for _, x in pairs(v) do
            for _, id in ipairs(extractAnimIds(x)) do table.insert(out, id) end
        end
    end
    return out
end

local BLOCK_ANIM_IDS  = {}
local BLOCK_SOUND_IDS = {}
local SOUND_FIELDS    = { "Sounds","Sound","SFX","Sfx","SoundEffects","SoundIds" }

local function collectBlockAssets(cfg)
    if type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for name, v in pairs(cfg.Animations) do
            if nameMatchesBlock(name) then
                for _, id in ipairs(extractAnimIds(v)) do BLOCK_ANIM_IDS[id] = true end
            end
        end
    end
    for _, field in ipairs(SOUND_FIELDS) do
        if type(cfg[field]) == "table" then
            for name, v in pairs(cfg[field]) do
                if nameMatchesBlock(name) then
                    for _, id in ipairs(extractAnimIds(v)) do BLOCK_SOUND_IDS[id] = true end
                end
            end
        end
    end
end

local function scanFolderForBlockAssets(folder)
    if not folder then return end
    for _, sub in ipairs(folder:GetChildren()) do
        if sub:IsA("Folder") then
            for _, cfgName in ipairs({ "Config","Behavior" }) do
                local mod = sub:FindFirstChild(cfgName)
                if mod and mod:IsA("ModuleScript") then
                    local ok, data = pcall(require, mod)
                    if ok then collectBlockAssets(data) end
                end
            end
        end
    end
end

local function scanAllKillerAssets()
    BLOCK_ANIM_IDS  = {}
    BLOCK_SOUND_IDS = {}
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    scanFolderForBlockAssets(assets:FindFirstChild("Killers"))
    local skins       = assets:FindFirstChild("Skins")
    local skinKillers = skins and skins:FindFirstChild("Killers")
    if skinKillers then
        for _, base in ipairs(skinKillers:GetChildren()) do
            if base:IsA("Folder") then scanFolderForBlockAssets(base) end
        end
    end
end
scanAllKillerAssets()

local function shouldBlockAbility(name)
    if type(name) ~= "string" or name == "" then return false end
    local upper = string.upper(name)
    for _, bn in ipairs(_G.BlockAbilityNames) do
        if string.find(upper, string.upper(bn), 1, true) then return true end
    end
    return false
end

local function getAbilityName(killer)
    if not killer then return nil end
    for _, attr in ipairs({
        "AbilityName","LastAbility","CurrentAbility",
        "LastAbilityName","AbilityUsed","Ability","CurrentAttack"
    }) do
        local ok, val = pcall(function() return killer:GetAttribute(attr) end)
        if ok and type(val) == "string" and val ~= "" then return val end
    end
    return nil
end

-- ── Block fire ──────────────────────────────────────────────
local function FireBlockBuffer()
    if IsPlayerKiller() then return end
    if HDT.enabled then
        local k    = GetNearestKiller(HDT.range or 30)
        local root = k and k:FindFirstChild("HumanoidRootPart")
        if root then DragToward(root) end
    end
    FireAbility("Block")
end

-- ── Facing check ────────────────────────────────────────────
local function isFacingPlayer(killerRoot, myPos)
    if not Facing.enabled then return true end
    local look = killerRoot.CFrame.LookVector
    local toMe = myPos - killerRoot.Position
    toMe = Vector3.new(toMe.X, 0, toMe.Z)
    if toMe.Magnitude < 0.01 then return true end
    return look:Dot(toMe.Unit) >= (Facing.dot or 0.25)
end

-- ── Spatial overlap box (core SyncSaken hitbox logic) ───────
--   Creates a part at the killer's front. If the local player
--   is inside the overlap zone, FireBlockBuffer() is called.
local function createSpatialOverlapBox(killerChar, size, onHit)
    if IsPlayerKiller() then return end
    if not killerChar or killerChar == LP.Character then return end

    local root = killerChar:FindFirstChild("HumanoidRootPart")
                 or killerChar:FindFirstChild("RootPart")
    if not root then return end

    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my then return end

    if (root.Position - my.Position).Magnitude > (Facing.maxDist or 40) then return end
    if Facing.required and not isFacingPlayer(root, my.Position) then return end

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killerChar }

    task.spawn(function()
        local elapsed = 0
        while killerChar.Parent and root.Parent and elapsed < _G.HitboxDuration do
            if IsPlayerKiller() then return end

            -- Create the visual/query part
            local Part           = Instance.new("Part")
            Part.Name            = "FM_BlockBox"
            Part.Transparency    = _G.ShowHitboxVisual and _G.HitboxTransparency or 1
            Part.CanCollide      = false
            Part.CanTouch        = false
            Part.CanQuery        = true
            Part.CastShadow      = false
            Part.Anchored        = true
            Part.Size            = size
            Part.Color           = _G.HitboxColor
            Part.Material        = Enum.Material.ForceField
            Part.CFrame          = root.CFrame * CFrame.new(0, 0, _G.HitboxOffset)
            Part.Parent          = Workspace

            if _G.ShowOutline and _G.ShowHitboxVisual then
                local sb           = Instance.new("SelectionBox")
                sb.Adornee         = Part
                sb.Color3          = _G.HitboxColor
                sb.LineThickness   = _G.OutlineThickness
                sb.Transparency    = 0.1
                sb.Visible         = true
                sb.Parent          = Part
            end

            Debris:AddItem(Part, 0.05)

            -- Check if player is inside the box
            for _, v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                local model = v.Parent and v.Parent:FindFirstAncestorOfClass("Model") or v.Parent
                local hum   = model and model:FindFirstChildOfClass("Humanoid")
                if not hum and v.Parent then hum = v.Parent:FindFirstChildOfClass("Humanoid") end
                if hum and hum.Health > 0 then
                    local plr = Players:GetPlayerFromCharacter(hum.Parent)
                    if plr == LP then
                        if _G.BlockDelay > 0 then task.wait(_G.BlockDelay) end
                        if onHit then onHit() end   -- → FireBlockBuffer → FireAbility("Block")
                        return
                    end
                end
            end

            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end

-- ── Trigger box ─────────────────────────────────────────────
local lastTrigger = 0
local function triggerBoxCheck(killer)
    if IsPlayerKiller() then return end
    if not killer or killer == LP.Character or not killer.Parent then return end
    local now = tick()
    if now - lastTrigger < 0.03 then return end
    lastTrigger = now
    createSpatialOverlapBox(
        killer,
        Vector3.new(_G.HitboxWidth, _G.HitboxHeight, _G.HitboxLength),
        FireBlockBuffer
    )
end

-- ── PreRender poll ──────────────────────────────────────────
local AB_poll = {
    lastAbility = setmetatable({}, { __mode = "k" }),
    lastUsed    = setmetatable({}, { __mode = "k" }),
}

RunService.PreRender:Connect(function()
    if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if not kf then return end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") and k ~= LP.Character then
            local cur  = k:GetAttribute("AbilityLastUsed") or 0
            local prev = AB_poll.lastAbility[k] or 0
            if cur > prev then
                AB_poll.lastAbility[k] = cur
                local curU  = k:GetAttribute("AbilitiesUsed") or 0
                local prevU = AB_poll.lastUsed[k] or 0
                AB_poll.lastUsed[k] = curU
                if curU == prevU then triggerBoxCheck(k) end
            end
        end
    end
end)

-- ── Remote hook ─────────────────────────────────────────────
local remoteHooked = false
local function hookAbilityRemote()
    if remoteHooked then return end
    remoteHooked = true
    local remote = getRE()
    if not remote then return end

    local function argMatches(arg)
        if type(arg) == "string" then return shouldBlockAbility(arg) end
        if typeof(arg) == "buffer" then
            local ok, str = pcall(buffer.tostring, arg)
            if ok and str then return shouldBlockAbility(str) end
        end
        return false
    end

    local function fireOnMatch(...)
        for _, arg in ipairs({ ... }) do
            if argMatches(arg) then
                local kf = Workspace:FindFirstChild("Players")
                kf = kf and kf:FindFirstChild("Killers")
                if kf then
                    for _, k in ipairs(kf:GetChildren()) do
                        if k:IsA("Model") and k ~= LP.Character then
                            triggerBoxCheck(k)
                            return
                        end
                    end
                end
                return
            end
        end
    end

    if getconnections then
        local ok, conns = pcall(getconnections, remote.OnClientEvent)
        if ok and conns then
            for _, conn in pairs(conns) do
                pcall(function()
                    local orig = conn.Function
                    if not orig then return end
                    conn.Function = function(...)
                        if _G.AutoBlockEnabled and not IsPlayerKiller() then fireOnMatch(...) end
                        return orig(...)
                    end
                end)
            end
        end
    end

    remote.OnClientEvent:Connect(function(...)
        if _G.AutoBlockEnabled and not IsPlayerKiller() then fireOnMatch(...) end
    end)
end

-- ── Animation / Sound hook ──────────────────────────────────
local hookedKillers = {}
local function hookKillerM1(killer)
    if not killer or hookedKillers[killer] or not killer:IsA("Model") then return end
    if killer == LP.Character then return end
    hookedKillers[killer] = true

    local hum      = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local id = tostring(
                track.Animation and track.Animation.AnimationId or ""
            ):match("%d+")
            if id and BLOCK_ANIM_IDS[id] then triggerBoxCheck(killer) end
        end)
    end

    local function hookSound(s)
        if not s:IsA("Sound") then return end
        s.Played:Connect(function()
            if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
            local sid = tostring(s.SoundId):match("%d+")
            if sid and BLOCK_SOUND_IDS[sid] then triggerBoxCheck(killer) end
        end)
    end

    for _, d in ipairs(killer:GetDescendants()) do hookSound(d) end
    killer.DescendantAdded:Connect(function(d) hookSound(d) end)
end

-- ── Attribute monitor ───────────────────────────────────────
local monitoredKillers = {}
local function monitorKiller(killer)
    if not killer or monitoredKillers[killer] or not killer:IsA("Model") then return end
    if killer == LP.Character then return end
    monitoredKillers[killer] = true
    hookKillerM1(killer)

    local lastAbility = killer:GetAttribute("AbilityLastUsed") or 0
    local lastUsed    = killer:GetAttribute("AbilitiesUsed") or 0

    local function onNewAbility()
        if not _G.AutoBlockEnabled or IsPlayerKiller() then return end
        local name = getAbilityName(killer)
        if name == nil or shouldBlockAbility(name) then triggerBoxCheck(killer) end
    end

    killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
        local cur = killer:GetAttribute("AbilityLastUsed") or 0
        if cur == lastAbility then return end
        lastAbility = cur
        local curUsed = killer:GetAttribute("AbilitiesUsed") or 0
        if curUsed > lastUsed then lastUsed = curUsed; return end
        onNewAbility()
    end)

    for _, attr in ipairs({ "AbilityName","LastAbility","CurrentAbility","LastAbilityName" }) do
        pcall(function()
            killer:GetAttributeChangedSignal(attr):Connect(onNewAbility)
        end)
    end
end

-- ── Polling loop ─────────────────────────────────────────────
task.spawn(function()
    while true do
        task.wait(0.25)
        if _G.AutoBlockEnabled and not IsPlayerKiller() then
            local kf = Workspace:FindFirstChild("Players")
            kf = kf and kf:FindFirstChild("Killers")
            if kf then
                for _, k in ipairs(kf:GetChildren()) do
                    if k:IsA("Model") and k ~= LP.Character then monitorKiller(k) end
                end
            end
        end
    end
end)

-- ── Enable entry point ───────────────────────────────────────
local function EnableAutoBlock()
    if IsPlayerKiller() then return end
    scanAllKillerAssets()
    hookAbilityRemote()
    local kf = Workspace:FindFirstChild("Players")
    kf = kf and kf:FindFirstChild("Killers")
    if kf then
        for _, k in ipairs(kf:GetChildren()) do
            if k:IsA("Model") and k ~= LP.Character then monitorKiller(k) end
        end
    end
end

-- ═══════════════════════════════════════════════════════════
--  ESP SYSTEM
-- ═══════════════════════════════════════════════════════════
local ESP = {
    Enabled   = false,
    BoxESP    = true,
    NameESP   = true,
    HealthBar = true,
    Distance  = true,
    MaxDist   = 500,
    ColorSurv = Color3.fromRGB(100, 200, 255),
    ColorKill = Color3.fromRGB(255, 60, 60),
    Objects   = {},
}

local function newDraw(kind, props)
    local d = Drawing.new(kind)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function removeEspObj(plr)
    if not ESP.Objects[plr] then return end
    for _, d in pairs(ESP.Objects[plr]) do pcall(function() d:Remove() end) end
    ESP.Objects[plr] = nil
end

local function worldToVP(pos)
    local vp, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(vp.X, vp.Y), onScreen, vp.Z
end

local function updateESP()
    if not ESP.Enabled then
        for plr in pairs(ESP.Objects) do removeEspObj(plr) end
        return
    end
    local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then removeEspObj(plr); continue end
        local char = plr.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not hrp or not hum or hum.Health <= 0 then
            removeEspObj(plr); continue
        end

        local dist = myHRP and (hrp.Position - myHRP.Position).Magnitude or 0
        if dist > ESP.MaxDist then removeEspObj(plr); continue end

        local top2D, onTop = worldToVP(hrp.Position + Vector3.new(0, 3.5,  0))
        local bot2D, onBot = worldToVP(hrp.Position + Vector3.new(0, -3,   0))
        if not (onTop or onBot) then removeEspObj(plr); continue end

        local height = math.abs(top2D.Y - bot2D.Y)
        local width  = height * 0.5
        local cx     = (top2D.X + bot2D.X) * 0.5
        local color  = isKillerChar(char) and ESP.ColorKill or ESP.ColorSurv

        if not ESP.Objects[plr] then
            ESP.Objects[plr] = {
                Box      = newDraw("Square", { Filled=false, Visible=false, Color=color, Thickness=1.5, ZIndex=2 }),
                Name     = newDraw("Text",   { Text=plr.Name, Visible=false, Color=color, Size=14, Outline=true, Font=2, Center=true, ZIndex=3 }),
                HealthBG = newDraw("Square", { Filled=true,  Visible=false, Color=Color3.fromRGB(0,0,0), Transparency=0.5, ZIndex=1 }),
                HealthFG = newDraw("Square", { Filled=true,  Visible=false, Color=Color3.fromRGB(80,255,80), ZIndex=2 }),
                Dist     = newDraw("Text",   { Visible=false, Color=Color3.fromRGB(220,220,220), Size=12, Outline=true, Font=2, Center=true, ZIndex=3 }),
            }
        end

        local obj = ESP.Objects[plr]

        -- Box
        if ESP.BoxESP then
            obj.Box.Position = Vector2.new(cx - width/2, top2D.Y)
            obj.Box.Size     = Vector2.new(width, height)
            obj.Box.Color    = color
            obj.Box.Visible  = true
        else obj.Box.Visible = false end

        -- Name
        if ESP.NameESP then
            obj.Name.Position = Vector2.new(cx, top2D.Y - 17)
            obj.Name.Text     = plr.Name
            obj.Name.Color    = color
            obj.Name.Visible  = true
        else obj.Name.Visible = false end

        -- Health bar
        if ESP.HealthBar then
            local pct  = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bw   = 4
            local bx   = cx - width/2 - bw - 2
            obj.HealthBG.Position = Vector2.new(bx, top2D.Y)
            obj.HealthBG.Size     = Vector2.new(bw, height)
            obj.HealthBG.Visible  = true
            obj.HealthFG.Position = Vector2.new(bx, top2D.Y + height * (1 - pct))
            obj.HealthFG.Size     = Vector2.new(bw, height * pct)
            obj.HealthFG.Color    = Color3.fromRGB(math.floor(255*(1-pct)), math.floor(255*pct), 0)
            obj.HealthFG.Visible  = true
        else
            obj.HealthBG.Visible = false
            obj.HealthFG.Visible = false
        end

        -- Distance
        if ESP.Distance then
            obj.Dist.Position = Vector2.new(cx, bot2D.Y + 3)
            obj.Dist.Text     = string.format("[%d]", math.floor(dist))
            obj.Dist.Visible  = true
        else obj.Dist.Visible = false end
    end
end

-- ═══════════════════════════════════════════════════════════
--  AUTO AIM SYSTEM
-- ═══════════════════════════════════════════════════════════
local AA = {
    Enabled     = false,
    FOV         = 150,
    Smoothness  = 0.15,
    Part        = "Head",
    WallCheck   = false,
    KillersOnly = false,
}

local FovCircle           = Drawing.new("Circle")
FovCircle.Color           = Color3.fromRGB(210, 30, 30)
FovCircle.Thickness       = 1.5
FovCircle.Transparency    = 0.6
FovCircle.Filled          = false
FovCircle.Visible         = false
FovCircle.NumSides        = 64
FovCircle.Radius          = AA.FOV
FovCircle.Position        = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

local function getClosestTarget()
    local center  = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best, bestDist = nil, AA.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local part = char and char:FindFirstChild(AA.Part)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end
        if AA.KillersOnly and not isKillerChar(char) then continue end
        local vp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local sPos = Vector2.new(vp.X, vp.Y)
        local d    = (sPos - center).Magnitude
        if d < bestDist then
            if AA.WallCheck then
                local rp  = RaycastParams.new()
                rp.FilterDescendantsInstances = { LP.Character }
                local ray = Workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), rp)
                if ray and not ray.Instance:IsDescendantOf(char) then continue end
            end
            best, bestDist = part, d
        end
    end
    return best
end

-- ═══════════════════════════════════════════════════════════
--  STAMINA DISPLAY
-- ═══════════════════════════════════════════════════════════
local Stam = {
    Enabled = false,
    Label   = Drawing.new("Text"),
    BarBG   = Drawing.new("Square"),
    BarFG   = Drawing.new("Square"),
}
Stam.Label.Visible  = false; Stam.Label.Color  = Color3.fromRGB(255,255,255)
Stam.Label.Size     = 14;    Stam.Label.Outline = true; Stam.Label.Font = 2
Stam.BarBG.Visible  = false; Stam.BarBG.Filled  = true
Stam.BarFG.Visible  = false; Stam.BarFG.Filled  = true

local function getStamina()
    local char = LP.Character
    if not char then return nil, nil end
    for _, attr in ipairs({ "Stamina","CurrentStamina","Stam" }) do
        local ok, v = pcall(function() return char:GetAttribute(attr) end)
        if ok and type(v) == "number" then
            local maxOk, maxV = pcall(function() return char:GetAttribute("MaxStamina") end)
            return v, (maxOk and type(maxV) == "number") and maxV or 100
        end
    end
    return nil, nil
end

-- ═══════════════════════════════════════════════════════════
--  RENDER STEP (ESP + AA + Stamina + FOV circle)
-- ═══════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    -- FOV circle
    FovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FovCircle.Radius   = AA.FOV
    FovCircle.Visible  = AA.Enabled

    -- ESP
    updateESP()

    -- Auto Aim
    if AA.Enabled then
        local target = getClosestTarget()
        if target then
            local vp = Camera:WorldToViewportPoint(target.Position)
            local sPos   = Vector2.new(vp.X, vp.Y)
            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            local delta  = sPos - center
            Camera.CFrame = Camera.CFrame * CFrame.Angles(
                math.rad(-delta.Y * AA.Smoothness * 0.1),
                math.rad(-delta.X * AA.Smoothness * 0.1),
                0
            )
        end
    end

    -- Stamina bar
    if Stam.Enabled then
        local stam, maxS = getStamina()
        if stam then
            local vp   = Camera.ViewportSize
            local barW = 220
            local barH = 10
            local bx   = (vp.X - barW) / 2
            local by   = vp.Y - 60
            local pct  = math.clamp(stam / maxS, 0, 1)

            Stam.Label.Text     = string.format("Stamina   %.0f / %.0f", stam, maxS)
            Stam.Label.Position = Vector2.new(vp.X/2, by - 20)
            Stam.Label.Center   = true
            Stam.Label.Visible  = true

            Stam.BarBG.Position = Vector2.new(bx, by)
            Stam.BarBG.Size     = Vector2.new(barW, barH)
            Stam.BarBG.Color    = Color3.fromRGB(25, 25, 25)
            Stam.BarBG.Visible  = true

            Stam.BarFG.Position = Vector2.new(bx, by)
            Stam.BarFG.Size     = Vector2.new(barW * pct, barH)
            Stam.BarFG.Color    = Color3.fromRGB(210, 30, 30)
            Stam.BarFG.Visible  = true
        else
            Stam.Label.Visible = false
            Stam.BarBG.Visible = false
            Stam.BarFG.Visible = false
        end
    else
        Stam.Label.Visible = false
        Stam.BarBG.Visible = false
        Stam.BarFG.Visible = false
    end
end)

