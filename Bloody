local function placeLine(a, b, col, trans, thick)
    local mag = (b - a).Magnitude
    if mag < 0.05 then return end
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = col
    p.Transparency = trans or 0.15
    p.Size = Vector3.new(thick or 0.12, thick or 0.12, mag)
    p.CFrame = CFrame.lookAt((a + b) * 0.5, b)
    p.Parent = VisFolder
    Debris:AddItem(p, 0.08)
end

local RAD_SEGMENTS = 32
local radLUT = {}
for m = 0, RAD_SEGMENTS do
    radLUT[m] = Vector2.new(math.cos(m / RAD_SEGMENTS * 2 * math.pi), math.sin(m / RAD_SEGMENTS * 2 * math.pi))
end

local function evalCircle(killer)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local kr = killer and killer:FindFirstChild("HumanoidRootPart")
    if not my or not kr then return false, false, 0 end
    local kpos = kr.Position
    local mpos = my.Position
    local flat = Vector3.new(kpos.X - mpos.X, 0, kpos.Z - mpos.Z)
    local flatDist = flat.Magnitude
    local dy = math.abs(kpos.Y - mpos.Y)
    local circleRadius = math.max(RangeGate.circleRange, RangeGate.visionRange + 1)
    local coneRadius = RangeGate.visionRange
    local inCircle = (flatDist <= circleRadius) and (dy <= 15)
    local lookFlat = Vector3.new(kr.CFrame.LookVector.X, 0, kr.CFrame.LookVector.Z)
    if lookFlat.Magnitude < 0.01 then lookFlat = Vector3.new(0, 0, -1) else lookFlat = lookFlat.Unit end
    local toMe = Vector3.new(mpos.X - kpos.X, 0, mpos.Z - kpos.Z)
    local frontDot = 0
    if toMe.Magnitude > 0.01 then frontDot = lookFlat:Dot(toMe.Unit) end
    local cosHalf = math.cos(math.rad(math.clamp(RangeGate.visionAngle, 15, 180) * 0.5))
    local inCone = (flatDist <= coneRadius) and (frontDot >= cosHalf)
    return inCircle, inCone, flatDist, lookFlat, kpos, circleRadius, coneRadius
end

local function drawCircleVisual(killer)
    if not RangeGate.showVisual or RangeGate.mode ~= "Circle" then return end
    local inCircle, inCone, _, lookFlat, kpos, circleRadius, coneRadius = evalCircle(killer)
    if not kpos then return end
    local cy = Vector3.new(kpos.X, kpos.Y - 2.5, kpos.Z)
    local rColor = inCircle and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(160, 80, 220)
    local rTrans = inCircle and 0.08 or 0.25
    for m = 0, RAD_SEGMENTS - 1 do
        local a = radLUT[m]
        local b = radLUT[m + 1]
        placeLine(
            cy + Vector3.new(a.X, 0, a.Y) * circleRadius,
            cy + Vector3.new(b.X, 0, b.Y) * circleRadius,
            rColor, rTrans, 0.12
        )
    end
    -- cone wings
    local half = math.rad(math.clamp(RangeGate.visionAngle, 15, 180) * 0.5)
    local function rotY(v, a)
        local c, s = math.cos(a), math.sin(a)
        return Vector3.new(v.X * c - v.Z * s, 0, v.X * s + v.Z * c)
    end
    if lookFlat then
        local cColor = inCone and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(160, 80, 220)
        local wingL = rotY(lookFlat, half) * coneRadius
        local wingR = rotY(lookFlat, -half) * coneRadius
        placeLine(cy, cy + wingL, cColor, 0.1, 0.12)
        placeLine(cy, cy + wingR, cColor, 0.1, 0.12)
        placeLine(cy + wingL, cy + wingR, cColor, 0.2, 0.1)
    end
end

local function createHitboxPart(killer)
    local root = killer and killer:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local Part = Instance.new("Part")
    Part.Name = "Perfect_Hitbox"
    Part.Anchored = true
    Part.CanCollide = false
    Part.CanTouch = false
    Part.CanQuery = true
    Part.CastShadow = false
    Part.Material = Enum.Material.ForceField
    Part.Color = RangeGate.color
    Part.Transparency = RangeGate.showVisual and RangeGate.transparency or 1
    Part.Size = Vector3.new(RangeGate.width, RangeGate.height, RangeGate.length)
    Part.CFrame = root.CFrame * CFrame.new(0, 0, RangeGate.offset)
    Part.Parent = VisFolder
    if RangeGate.showVisual then
        local sb = Instance.new("SelectionBox")
        sb.Adornee = Part
        sb.Color3 = RangeGate.color
        sb.LineThickness = 0.03
        sb.Transparency = 0.1
        sb.Parent = Part
    end
    return Part, root
end

-- Returns true if player is inside gate for this killer
local function PassesRangeGate(killer)
    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not my or not killer then return false end
    if RangeGate.mode == "Circle" then
        local inCircle, inCone = evalCircle(killer)
        drawCircleVisual(killer)
        -- Nerg-like: in circle AND (in cone OR very close vision)
        if inCircle and inCone then return true end
        local kr = killer:FindFirstChild("HumanoidRootPart")
        if kr and (kr.Position - my.Position).Magnitude <= RangeGate.visionRange then
            return inCircle
        end
        return false
    end
    -- Hitbox mode: spatial overlap (checked by caller with live part)
    return true -- actual overlap done in runHitboxCheck
end

local function runHitboxCheck(killer, onHit)
    local myChar = LP.Character
    if not myChar or not killer then return end
    local root = killer:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killer }
    task.spawn(function()
        local elapsed = 0
        local dur = math.max(0.1, RangeGate.duration)
        while killer.Parent and root.Parent and elapsed < dur and not _ShuttingDown do
            if IsPlayerKiller() then return end
            local Part = Instance.new("Part")
            Part.Name = "Perfect_Hitbox"
            Part.Anchored = true
            Part.CanCollide = false
            Part.CanTouch = false
            Part.CanQuery = true
            Part.CastShadow = false
            Part.Material = Enum.Material.ForceField
            Part.Color = RangeGate.color
            Part.Transparency = RangeGate.showVisual and RangeGate.transparency or 1
            Part.Size = Vector3.new(RangeGate.width, RangeGate.height, RangeGate.length)
            Part.CFrame = root.CFrame * CFrame.new(0, 0, RangeGate.offset)
            Part.Parent = VisFolder
            if RangeGate.showVisual then
                local sb = Instance.new("SelectionBox")
                sb.Adornee = Part
                sb.Color3 = RangeGate.color
                sb.LineThickness = 0.03
                sb.Transparency = 0.15
                sb.Parent = Part
            end
            Debris:AddItem(Part, 0.06)
            for _, v in ipairs(Workspace:GetPartsInPart(Part, op)) do
                local hum = v.Parent and v.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LP then
                    if onHit then onHit() end
                    return
                end
            end
            elapsed = elapsed + RunService.Heartbeat:Wait()
        end
    end)
end


