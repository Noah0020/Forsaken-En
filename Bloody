    stroke.Thickness = 2
    stroke.Transparency = 0.2
    stroke.Parent = btn

    -- Drag vs click: only toggle if finger/mouse barely moved
    local pressPos = nil
    local pressGuiPos = nil
    local dragged = false
    local DRAG_THRESHOLD = 12 -- pixels

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            pressPos = input.Position
            pressGuiPos = btn.Position
            dragged = false
        end
    end)

    btn.InputChanged:Connect(function(input)
        if not pressPos then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - pressPos
            if delta.Magnitude > DRAG_THRESHOLD then
                dragged = true
                btn.Position = UDim2.new(
                    pressGuiPos.X.Scale, pressGuiPos.X.Offset + delta.X,
                    pressGuiPos.Y.Scale, pressGuiPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    local function onRelease(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if not pressPos then return end
        local wasDrag = dragged
        pressPos = nil
        pressGuiPos = nil
        dragged = false
        if wasDrag then return end -- drag only, do not toggle
        -- pure click on the button → toggle menu
        SetMenuOpen(not MenuOpen)
    end

    btn.InputEnded:Connect(onRelease)

    -- Do NOT bind MouseButton1Click / Activated (double-fires with InputEnded on some devices)
    -- Do NOT bind UserInputService globally — that caused mobile "tap anywhere opens"
end

