local Pages, NavBtns, NavIcons, NavTitles = {}, {}, {}, {}
local CurrentPage

local function CreatePage(name)
    local p = Create("ScrollingFrame", {
        Name = name, Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = Config.Red,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, PageHolder)
    Create("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, p)
    Pages[name] = p
    return p
end

local function SwitchPage(name)
    if not Pages[name] then return end
    if CurrentPage then Pages[CurrentPage].Visible = false end
    CurrentPage = name
    Pages[name].Visible = true
    PageTitle.Text = name
    for pageName, button in pairs(NavBtns) do
        local active = pageName == name
        Tween(button, { BackgroundColor3 = active and Color3.fromRGB(65, 22, 35) or Config.Sidebar }, 0.2)
        if NavIcons[pageName] then
            NavIcons[pageName].TextColor3 = active and Config.BrightRed or Config.Muted
        end
        if NavTitles[pageName] then
            NavTitles[pageName].TextColor3 = active and Config.BrightRed or Config.Muted
        end
    end
end

local function AddNavigation(name, symbol, subtitle)
    local Button = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Config.Sidebar, Text = "", AutoButtonColor = false,
