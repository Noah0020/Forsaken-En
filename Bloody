-- TWO TIME
local TT = {
    enabled=false, normalRange=3, crouchRange=3, duration=0.5, delay=0.05,
    method="Teleport", speed=100, tpBack=false, pivotTo=false, primaryMode="Character",
}
local STAB = { ["106086955212611"]=true, ["100725497418533"]=true }
local CROUCH = { ["89448354637442"]=true, ["107640065977686"]=true }
local function getKillerRootTT()
    local k = GetNearestKiller(math.huge)
    return k and k:FindFirstChild("HumanoidRootPart")
end
local function doTeleport(behind)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local target = getKillerRootTT()
    if not hrp or not target then return end
    task.wait(TT.delay)
    local saved = hrp.CFrame
    local untilT = tick() + TT.duration
    while tick() < untilT and target.Parent do
        hrp.CFrame = CFrame.new((target.CFrame * CFrame.new(0, 0, behind)).Position) * (target.CFrame - target.CFrame.Position)
        task.wait()
    end
    if TT.tpBack then hrp.CFrame = saved end
end
local function doLerp(behind)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local target = getKillerRootTT()
    if not hrp or not target then return end
    task.wait(TT.delay)
    local t0 = tick()
    while tick() - t0 < TT.duration and target and target.Parent do
        local goal = target.Position - target.CFrame.LookVector * behind
        local dist = (goal - hrp.Position).Magnitude
        if dist > 0.01 then
            local alpha = math.min((TT.speed * task.wait()) / dist, 1)
            hrp.CFrame = CFrame.new(hrp.Position:Lerp(goal, alpha), hrp.Position:Lerp(goal, alpha) + target.CFrame.LookVector)
        else task.wait() end
    end
end
local function doPrimary(behind)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local target = getKillerRootTT()
    if not hrp or not target or not char then return end
    task.wait(TT.delay)
    local attach = TT.primaryMode == "Character" and char or hrp
    local part = Instance.new("Part")
    part.Size = Vector3.new(1,1,1)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.Parent = attach
    local old = char.PrimaryPart
    char.PrimaryPart = part
    local t0 = tick()
    while tick() - t0 < TT.duration do
        target = getKillerRootTT()
        if not target then break end
        hrp.AssemblyLinearVelocity = Vector3.zero
        local goal = CFrame.new((target.CFrame * CFrame.new(0, 0, behind)).Position) * (target.CFrame - target.CFrame.Position)
        part.CFrame = part.CFrame:Lerp(goal, math.clamp(TT.speed * 0.016, 0, 1))
        if TT.pivotTo then pcall(function() attach:PivotTo(part.CFrame) end) end
        task.wait()
    end
    char.PrimaryPart = old
    part:Destroy()
end
local function runBackstab(behind)
    if not TT.enabled or IsPlayerKiller() then return end
    if TT.method == "Teleport" then doTeleport(behind)
    elseif TT.method == "Lerp" then doLerp(behind)
    else doPrimary(behind) end
end
local function onAnimTT(track)
    if not TT.enabled or not track or not track.Animation then return end
    local id = tostring(track.Animation.AnimationId):match("%d+")
    if not id then return end
    if STAB[id] then task.spawn(runBackstab, TT.normalRange)
    elseif CROUCH[id] then task.spawn(runBackstab, TT.crouchRange) end
end
local function hookCharTT(char)
