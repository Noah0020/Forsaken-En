local killerAimModules = {}
local function RegKillerAim(n, on, off) killerAimModules[n] = { enabled = false, on = on, off = off } end
local function ToggleKillerAim(n, s)
    local m = killerAimModules[n]; if not m then return end
    if s and not m.enabled then if m.on then pcall(m.on) end m.enabled = true
    elseif not s and m.enabled then if m.off then pcall(m.off) end m.enabled = false end
end
