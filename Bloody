local function extractAnimIds(v)
    local o = {}
    if type(v) == "string" or type(v) == "number" then
        local id = tostring(v):match("%d+"); if id then table.insert(o, id) end
    elseif type(v) == "table" then
        for _, x in pairs(v) do for _, id in ipairs(extractAnimIds(x)) do table.insert(o, id) end end
    end
    return o
end

local function isStunName(n)
    if type(n) ~= "string" then return false end
    if STUN_ABILITY_NAMES[n] then return true end
    local l = n:lower():gsub("[%s_%-]", "")
    for s in pairs(STUN_ABILITY_NAMES) do if l == s:lower():gsub("[%s_%-]", "") then return true end end
    return false
end

local function readConfig(mod)
    local ok, cfg = pcall(require, mod)
    if not ok or type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for n, v in pairs(cfg.Animations) do
            if isStunName(n) then for _, id in ipairs(extractAnimIds(v)) do STUN_ANIM_IDS[id] = n end end
        end
    end
    for _, f in ipairs(STUN_SOUND_FIELDS) do
        if type(cfg[f]) == "table" then
            for n, v in pairs(cfg[f]) do
                if isStunName(n) then for _, id in ipairs(extractAnimIds(v)) do STUN_SOUND_IDS[id] = n end end
            end
        end
    end
end

local function LoadAbilityIds(char)
    STUN_ANIM_IDS, STUN_SOUND_IDS = {}, {}
    for id, n in pairs(STATIC_STUN_ANIM_IDS) do STUN_ANIM_IDS[id] = n end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    local cn = char:GetAttribute("CharacterName") or char.Name
    local sn = char:GetAttribute("SkinName") or "Default"
    for _, role in ipairs({"Survivors", "Killers"}) do
        local rf = assets:FindFirstChild(role)
        local cf = rf and rf:FindFirstChild(cn)
        if cf then
            local c = cf:FindFirstChild("Config"); if c then readConfig(c) end
            local b = cf:FindFirstChild("Behavior"); if b then readConfig(b) end
        end
    end
    if sn ~= "Default" then
        local sr = assets:FindFirstChild("Skins")
        if sr then
            for _, role in ipairs({"Survivors", "Killers"}) do
                local r = sr:FindFirstChild(role); local c = r and r:FindFirstChild(cn); local s = c and c:FindFirstChild(sn)
                if s then
                    local cc = s:FindFirstChild("Config"); if cc then readConfig(cc) end
                    local bb = s:FindFirstChild("Behavior"); if bb then readConfig(bb) end
                end
            end
        end
    end
end

