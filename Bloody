local activeSnapConn=nil local activeSnapHum=nil local activeSnapWasAuto=true

local function findClosestTargetHRP(targetType,excludeChar,fromPos,maxDist)
    local folder=workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(targetType); if not folder then return nil end
    local best,bd=nil,maxDist
    for _,m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m~=excludeChar then
            local trg=m:FindFirstChild("HumanoidRootPart") local h=m:FindFirstChildOfClass("Humanoid")
            if trg and h and h.Health>0 then local d=(trg.Position-fromPos).Magnitude if d<bd then bd=d best=trg end end
        end
    end
    return best
end

local function stopSnapLock()
    if activeSnapConn then pcall(function() activeSnapConn:Disconnect() end); activeSnapConn=nil end
    if activeSnapHum and activeSnapHum.Parent then pcall(function() activeSnapHum.AutoRotate=activeSnapWasAuto end) end
    activeSnapHum=nil
end

local function performSnap(targetType,useCamera)
    local char=game.Players.LocalPlayer.Character; if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid") local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local trgHRP=findClosestTargetHRP(targetType,char,hrp.Position,settings.distance); if not trgHRP then return end
    stopSnapLock()
    if useCamera then
        local cam=workspace.CurrentCamera
        local vel=trgHRP.AssemblyLinearVelocity or Vector3.zero; if vel.Magnitude>60 then vel=vel.Unit*60 end
        local pred=trgHRP.Position+vel*(settings.aimPrediction*0.03)
        if cam then cam.CFrame=CFrame.lookAt(cam.CFrame.Position,pred) end
        if hum then activeSnapHum=hum activeSnapWasAuto=hum.AutoRotate hum.AutoRotate=false task.delay(0.35,stopSnapLock) end
        return
    end
    if hum then activeSnapHum=hum activeSnapWasAuto=hum.AutoRotate hum.AutoRotate=false end
    local startT=tick() local dur=0.5
    activeSnapConn=RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp.Parent then stopSnapLock(); return end
        if tick()-startT>dur then stopSnapLock(); return end
        local t=findClosestTargetHRP(targetType,char,hrp.Position,settings.distance); if not t then return end
        local vel=t.AssemblyLinearVelocity or Vector3.zero; if vel.Magnitude>60 then vel=vel.Unit*60 end
        local pred=t.Position+vel*(settings.aimPrediction*0.03)
        local dx,dz=pred.X-hrp.Position.X,pred.Z-hrp.Position.Z
        if dx*dx+dz*dz>0.01 then local len=math.sqrt(dx*dx+dz*dz) hrp.CFrame=CFrame.lookAt(hrp.Position,hrp.Position+Vector3.new(dx/len,0,dz/len)) end
    end)
end

