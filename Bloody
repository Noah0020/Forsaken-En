-- SILENT AIM
--═══════════════════════════════════════════════════════════════════
local SilentAim = {
    Enabled=false, Selected={}, LeadTime=0.15,
    _installed=false, _velCache=setmetatable({}, {__mode="k"})
}

local function SA_SmoothVel(part)
    local now = os.clock()
    local v = part.AssemblyLinearVelocity
    if v.Magnitude > 120 then v = Vector3.zero end
    local c = SilentAim._velCache[part]
    if not c then SilentAim._velCache[part] = {t=now, v=v}; return v end
    c.v = c.v:Lerp(v, math.clamp(1 - math.exp(-math.max(now - c.t, 0.001) * 12), 0, 1))
    c.t = now
    return c.v
end

local function SA_GetFirstSurvivor()
    local sf = GetSurvivorsFolder()
    if not sf then return nil end
    for _, m in ipairs(sf:GetChildren()) do
        local hrp = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return m end
    end
    return nil
end

local function SA_GetNearestSurvivor(origin)
    local sf = GetSurvivorsFolder()
    if not sf then return nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(sf:GetChildren()) do
        local hrp = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - origin).Magnitude
            if d < bd then bd = d; best = m end
        end
    end
    return best
end

local function SA_Predict(target)
    if not target then return nil end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local lead = SilentAim.LeadTime
    pcall(function() lead = lead + LocalPlayer:GetNetworkPing() * 0.5 end)
    return hrp.Position + SA_SmoothVel(hrp) * lead
end

local function SA_CheckAbility(name)
    return SilentAim.Enabled and SilentAim.Selected[name] == true
end

local function SA_GetPlayerCharName()
    local c = LocalPlayer.Character
    return c and (c:GetAttribute("CharacterName") or c.Name) or ""
end

local function SA_Install()
    if SilentAim._installed then return end
    if not hookfunction then return end
    local ok1 = pcall(function()
        local GetPlayerMousePosition = require(ReplicatedStorage.Systems.Player.Miscellaneous.GetPlayerMousePosition)
        local orig = GetPlayerMousePosition.GetMousePos
        hookfunction(orig, function(...)
            local cn = SA_GetPlayerCharName()
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local originPos = root and root.Position or Vector3.zero

            if cn == "Noli" and SA_CheckAbility("Void Star") then
                local m = SA_GetNearestSurvivor(originPos)
                if m then local pp = SA_Predict(m); if pp then return pp end end
            end
            if cn == "c00lkidd" and SA_CheckAbility("Corrupt Nature") then
                local m = SA_GetNearestSurvivor(originPos)
                if m then local pp = SA_Predict(m); if pp then return pp end end
            end
            if cn == "Sixer" and SA_CheckAbility("Infernal Cry") then
                local m = SA_GetNearestSurvivor(originPos)
                if m then local pp = SA_Predict(m); if pp then return pp end end
            end
            if cn == "Nosferatu" and SA_CheckAbility("Hunter's Feast") then
                local m = SA_GetNearestSurvivor(originPos)
                if m then local pp = SA_Predict(m); if pp then return pp end end
            end
            if cn == "JaneDoe" and SA_CheckAbility("Crystal Pitch") then
                local m = SA_GetFirstSurvivor()
                if m then local pp = SA_Predict(m); if pp then return pp end end
            end
            if cn == "Dusekkar" and SA_CheckAbility("Plasma Beam") then
                local m = SA_GetFirstSurvivor()
                if m then local pp = SA_Predict(m); if pp then return pp end end
            end
            return orig(...)
        end)
    end)

    local ok2 = pcall(function()
        local Network = require(ReplicatedStorage.Modules.Network.Network)
        local orig = Network.FireServerConnection
        hookfunction(orig, function(self, name, evt, ...)
            if name == LocalPlayer.Name .. "AzureUpdateCameraLookVector" and evt == "UREMOTE_EVENT"
               and SA_CheckAbility("Tentacles (Grab)") then
                local args = table.pack(...)
                if typeof(args[1]) == "Vector3" then
                    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local target = SA_GetNearestSurvivor(root and root.Position or Vector3.zero)
                    if target then
                        local pp = SA_Predict(target)
                        if pp then args[1] = pp end
                    end
                end
                return orig(self, name, evt, table.unpack(args, 1, args.n))
            end
            return orig(self, name, evt, ...)
        end)
    end)

    if ok1 or ok2 then SilentAim._installed = true end
end

