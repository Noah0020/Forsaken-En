    addSurv("Guest1337", "Guest 1337", 1.3, 0)
    addSurv("Shedlekey", "Shedletsky", 1.2, 0)
    addSurv("TwoTime", "Two Time Aim", 0.9, 0)
    addSurv("Chance", "Chance", 1.5, 3)
    addSurv("JaneDoe", "Jane Doe", 1.1, 0)
