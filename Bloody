-- Rectangle state
local Rectangle = { folder=nil, boxes={}, showBoxes={}, loop=nil }

local function EnsureRectFolder()
    if not Rectangle.folder or not Rectangle.folder.Parent then
        local f = Instance.new("Folder"); f.Name="Cupcake_RectVisuals"; f.Parent=Workspace
        Rectangle.folder = f
    end
    return Rectangle.folder
end
local function CalcRectCF(kr)
    local p = kr.Position
    local lv = kr.CFrame.LookVector
    local f = Vector3.new(lv.X, 0, lv.Z)
    if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    local d = Settings.RectDistance or 3
    return CFrame.lookAt(p + f*d, p + f*d + f)
end
local function GetRectSize()
    local m = Settings.RectMultiplier or 1
    return Vector3.new(4*m, 4*m, 6*m)
end
local function IsInRect(myPos, cf, size)
    local hw = size.X/2 + PLAYER_R
    local hl = size.Z/2 + PLAYER_R
    local hh = size.Y/2 + PLAYER_R
    local lp = cf:PointToObjectSpace(myPos)
    return math.abs(lp.X) <= hw and math.abs(lp.Z) <= hl and math.abs(lp.Y) <= hh
end
local function BuildBoxEdges(box, cf, size)
    if not box or not box.model or not box.model.Parent then return end
    local L, W, H = size.Z, size.X, size.Y
    local c = {
        Vector3.new(-W/2,-H/2,-L/2), Vector3.new(W/2,-H/2,-L/2),
        Vector3.new(W/2,-H/2,L/2), Vector3.new(-W/2,-H/2,L/2),
        Vector3.new(-W/2,H/2,-L/2), Vector3.new(W/2,H/2,-L/2),
        Vector3.new(W/2,H/2,L/2), Vector3.new(-W/2,H/2,L/2),
    }
    local pairs_ = { {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8} }
    local T = Settings.RectEdgeThickness or 0.05
    for i, pr in ipairs(pairs_) do
        local e = box.edges[i]
        if e and e.Parent then
            local p1 = cf:PointToWorldSpace(c[pr[1]])
            local p2 = cf:PointToWorldSpace(c[pr[2]])
            local mid = (p1+p2)/2
            local diff = p2-p1
            local len = diff.Magnitude
            if len > 0.01 then
                local dir = diff.Unit
                local up = Vector3.new(0,1,0)
                if math.abs(dir.Y) > 0.95 then up = Vector3.new(0,0,1) end
                local rgt = dir:Cross(up)
                if rgt.Magnitude < 0.01 then rgt = Vector3.new(1,0,0) end
                rgt = rgt.Unit
                local uf = rgt:Cross(dir).Unit
                e.Size = Vector3.new(T, T, len)
                e.CFrame = CFrame.fromMatrix(mid, rgt, uf, dir)
            end
        end
    end
    if box.fog and box.fog.Parent then
        box.fog.CFrame = cf; box.fog.Size = size
    end
    if box.fogGlow and box.fogGlow.Parent then
        box.fogGlow.CFrame = cf; box.fogGlow.Size = size + Vector3.new(T,T,T)
    end
end
local function CreateBox(k, type_, color, trans, dur)
    if not k or not k.Parent then return nil end
    local kr = k:FindFirstChild("HumanoidRootPart"); if not kr then return nil end
    EnsureRectFolder()
    local m = Instance.new("Model"); m.Name="Cupcake_RectBox_"..type_; m.Parent=Rectangle.folder
    local T = Settings.RectEdgeThickness or 0.05
    local edges = {}
    for i = 1, 12 do
        local e = Instance.new("Part")
        e.Name = "Edge"..i
        e.Anchored = true; e.CanCollide = false; e.CanQuery = false; e.CanTouch = false
        e.CastShadow = false; e.Material = Enum.Material.Neon
        e.Color = color; e.Transparency = trans
        e.Size = Vector3.new(T, T, 1); e.CFrame = CFrame.new(0, -5000, 0)
        e.Parent = m; edges[i] = e
    end
    local fog = Instance.new("Part")
    fog.Name = "FogFill"; fog.Anchored = true; fog.CanCollide = false
    fog.CanQuery = false; fog.CanTouch = false; fog.CastShadow = false
    fog.Material = Enum.Material.ForceField; fog.Color = color; fog.Transparency = 0.55
    fog.Size = Vector3.new(0,0,0); fog.CFrame = CFrame.new(0,-5000,0); fog.Parent = m
    local fogGlow = Instance.new("Part")
    fogGlow.Name = "FogGlow"; fogGlow.Anchored = true; fogGlow.CanCollide = false
    fogGlow.CanQuery = false; fogGlow.CanTouch = false; fogGlow.CastShadow = false
    fogGlow.Material = Enum.Material.Neon; fogGlow.Color = color; fogGlow.Transparency = 0.92
    fogGlow.Size = Vector3.new(0,0,0); fogGlow.CFrame = CFrame.new(0,-5000,0); fogGlow.Parent = m
    local box = {
        type=type_, model=m, edges=edges, fog=fog, fogGlow=fogGlow, killer=k,
        startTime=tick(), duration=dur or (Settings.RectDuration or 0.25),
        color=color, transparency=trans
    }
    BuildBoxEdges(box, CalcRectCF(kr), GetRectSize())
    return box
end
local function DestroyBox(b)
    if not b then return end
    if b.model and b.model.Parent then pcall(function() b.model:Destroy() end) end
end
local function ClearAllBoxes()
    for _, b in ipairs(Rectangle.boxes) do DestroyBox(b) end
    Rectangle.boxes = {}
end
local function EnsureRectLoop()
    if Rectangle.loop then return end
    Rectangle.loop = RunService.RenderStepped:Connect(function()
        local now = tick()
        for i = #Rectangle.boxes, 1, -1 do
            local b = Rectangle.boxes[i]
            if not b or not b.killer or not b.killer.Parent then
                if b then DestroyBox(b) end
                table.remove(Rectangle.boxes, i)
            elseif not b.model or not b.model.Parent then
                table.remove(Rectangle.boxes, i)
            elseif now - b.startTime > b.duration then
                DestroyBox(b); table.remove(Rectangle.boxes, i)
            else
                local kr = b.killer:FindFirstChild("HumanoidRootPart")
                if kr then
                    local size = GetRectSize(); local cf = CalcRectCF(kr)
                    BuildBoxEdges(b, cf, size)
                    local rem = math.clamp(1 - (now - b.startTime) / b.duration, 0, 1)
                    for _, e in ipairs(b.edges) do
                        if e and e.Parent then
                            e.Transparency = b.transparency + (1 - b.transparency) * (1 - rem)
                        end
                    end
                    if b.fog and b.fog.Parent then
                        b.fog.Color = b.color
                        b.fog.Transparency = 0.55 + (1 - 0.55) * (1 - rem)
                    end
                    if b.fogGlow and b.fogGlow.Parent then
                        b.fogGlow.Color = b.color
                        b.fogGlow.Transparency = 0.92 + (1 - 0.92) * (1 - rem)
                    end
                end
            end
        end
        -- Show-rect-always mode
        if Settings.ShowRectAlways then
            local kf = GetKillersFolder()
            local sc = GetRectColor()
            local seen = {}
            if kf then
                for _, k in ipairs(kf:GetChildren()) do
                    if k:IsA("Model") and k.Parent then
                        seen[k] = true
                        local kr = k:FindFirstChild("HumanoidRootPart")
                        if kr then
                            local trans = Settings.RectEdgeTransparency or 0.2
                            local sb = Rectangle.showBoxes[k]
                            if not sb or not sb.model or not sb.model.Parent then
                                if sb then DestroyBox(sb) end
                                sb = CreateBox(k, "show", sc, trans, math.huge)
                                if sb then
                                    for _, e in ipairs(sb.edges) do
                                        if e and e.Parent then e.Color = sc; e.Transparency = trans end
                                    end
                                    Rectangle.showBoxes[k] = sb
                                end
                            else
                                for _, e in ipairs(sb.edges) do
                                    if e and e.Parent then e.Color = sc; e.Transparency = trans end
                                end
                                BuildBoxEdges(sb, CalcRectCF(kr), GetRectSize())
                            end
                        end
                    end
                end
            end
            for k, sb in pairs(Rectangle.showBoxes) do
                if not seen[k] then DestroyBox(sb); Rectangle.showBoxes[k] = nil end
            end
        else
            if next(Rectangle.showBoxes) then
                for _, sb in pairs(Rectangle.showBoxes) do DestroyBox(sb) end
                Rectangle.showBoxes = {}
            end
        end
    end)
end
local function StopRectLoop()
    if Rectangle.loop then
        pcall(function() Rectangle.loop:Disconnect() end)
        Rectangle.loop = nil
    end
end

-- Core trigger
local function TriggerRect(k)
    if KillerState_isKiller() then return end
    if not k or not k.Parent then return end
    local kr = k:FindFirstChild("HumanoidRootPart"); if not kr then return end
    local c = LP.Character; local mr = c and c:FindFirstChild("HumanoidRootPart"); if not mr then return end
    local cf = CalcRectCF(kr); local size = GetRectSize()
    local inRect = IsInRect(mr.Position, cf, size)
    local distToKiller = (kr.Position - mr.Position).Magnitude
    local inEmergency = false
    if distToKiller <= 8 and distToKiller > 0.1 then
        local dirToPlayer = (mr.Position - kr.Position).Unit
        local facingDot = kr.CFrame.LookVector:Dot(dirToPlayer)
        inEmergency = facingDot >= 0.3
    end
    if inRect or inEmergency then
        ClearAllBoxes()
        local real = CreateBox(k, "real", GetRectColor(), Settings.RectEdgeTransparency or 0.2, Settings.RectDuration or 0.25)
        if real then table.insert(Rectangle.boxes, real) end
        EnsureRectLoop()
        FireByMode()
    end
end

-- Detection loop
function KillerState_isKiller()
    local char = LP.Character; if not char then return false end
    local p = Workspace:FindFirstChild("Players"); local k = p and p:FindFirstChild("Killers")
    if not k then return false end
    local a = char
    while a do if a == k then return true end; a = a.Parent end
    return false
end

local function AttrHeartbeat()
    if not AB.running or KillerState_isKiller() then return end
    if not AB.KillersFolder or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    for _, k in ipairs(AB.KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local alu = k:GetAttribute("AbilityLastUsed") or 0
                local au = k:GetAttribute("AbilitiesUsed") or 0
                local st = AB.attrStates[k]
                if st then
                    local inc = alu > st.lastAbility
                    if au > st.lastUsed then st.isBait = true end
                    if inc then
                        local n = tick()
                        if st.castLockUntil and n < st.castLockUntil then
                            st.lastAbility = alu; st.lastUsed = au
                        else
                            if st.isBait then
                                st.isBait = false
                            else
                                st.castLockUntil = n + 0.1
                                if n - AB.attrDebounce >= (Settings.AB_Debounce or 0.08) then
                                    AB.attrDebounce = n
                                    pcall(TriggerRect, k)
                                end
                            end
                            st.lastAbility = alu; st.lastUsed = au
                        end
                    else
                        st.lastAbility = alu; st.lastUsed = au
                    end
                else
                    AB.attrStates[k] = { lastAbility=alu, lastUsed=au, isBait=false, castLockUntil=0 }
                end
            end
        end
    end
end

local function StartAutoBlock()
    if AB.running then return end
    AB.running = true; AB.generation = AB.generation + 1
    local myG = AB.generation; AB.attrStates = {}
    local c = LP.Character
    if c then AB.LocalRoot = c:FindFirstChild("HumanoidRootPart") end
    table.insert(AB.connections, LP.CharacterAdded:Connect(function(cc)
        AB.LocalRoot = cc:WaitForChild("HumanoidRootPart", 5)
    end))
    local p = Workspace:FindFirstChild("Players")
    AB.KillersFolder = p and p:FindFirstChild("Killers")
    table.insert(AB.connections, RunService.Heartbeat:Connect(function()
        if not AB.running or AB.generation ~= myG then return end
        AttrHeartbeat()
    end))
    EnsureRectLoop()
end
local function StopAutoBlock()
    AB.running = false; AB.generation = AB.generation + 1; AB.attrStates = {}
    for _, c in ipairs(AB.connections) do pcall(function() c:Disconnect() end) end
    AB.connections = {}
    if not Settings.ShowRectAlways then
        ClearAllBoxes()
        StopRectLoop()
    end
end

