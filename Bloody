local GenS = { enabled=false, gen=0, installed=false, startDelay=1.2 }

local function installGen()
    if GenS.installed then return end
    GenS.installed = true
    pcall(function()
        local folder = ReplicatedStorage.Systems.Player.Game.Minigames
        local Connect = require(folder.ConnectClientMinigame.ConnectInput)
        local old = Connect.new
        Connect.new = function(board, renderer, callbacks)
            local object = old(board, renderer, callbacks)
            local token = GenS.gen
            task.spawn(function()
                while object and not object.Ended and not GenS.enabled do task.wait(0.05) end
                if not object or object.Ended then return end
                local t0 = os.clock()
                while object and not object.Ended and os.clock() - t0 < GenS.startDelay do task.wait(0.05) end
                if not board.Blobs then return end
                for blob in pairs(board.Blobs) do
                    if object.Ended or token ~= GenS.gen then return end
                    if not board:GetLink(blob) then
                        local mate = board:GetMate(blob)
                        if mate then board:Connect(blob, mate); renderer:Render(); task.wait(0.8) end
                    end
                end
                if token == GenS.gen and board.IsSolved and board:IsSolved() then
                    object:__finish()
                    if callbacks and callbacks.OnSolved then callbacks.OnSolved() end
                end
            end)
            return object
        end
    end)
end

