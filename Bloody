local premiumUnlocked = false
local keyInput, verifyBtn, statusLbl

local function premiumUnlock()
    if premiumUnlocked then return end
    premiumUnlocked = true
    statusLbl:Set("Unlocked — thanks for supporting Dogsaken <3")

    local t15 = {"never lol","1 billion years","1 trillion years","when veeronica gets buffed"}
    local expStr = expires and durStr(expires - os.time()) or t15[math.random(#t15)]
    local expiry = TabSupport:Section({Title="Your key expires in: "..expStr, Box=true, Opened=true})
    if expires then task.defer(function()
        RunService.Heartbeat:Connect(function()
            expStr = expires and durStr(expires - os.time()) or t15[math.random(#t15)]
            pcall(function() expiry:SetTitle("Your key expires in: "..expStr) end) end) end) end

    if caps.filesystem then
        local lms = {connection=nil,song=nil,processing=false,oldSoundId=nil,timePosition=nil,
            lastSoundObject=nil,path="Dogsaken/custom_lms/",name="LastSurvivor",
            allowed={mp3=true,ogg=true,wav=true}}
        if isfolder("Dogsaken") then
            if isfolder("Dogsaken/custom_lms/") then lms.path="Dogsaken/custom_lms/"
            elseif isfolder("Dogsaken\\custom_lms\\") then lms.path="Dogsaken\\custom_lms\\" end end
        function lms.refresh()
            if not isfolder(lms.path) then makefolder(lms.path) end
            local out = {}
            for _,f in ipairs(listfiles(lms.path)) do
                local name = tostring(f):match("[^/\\]+$")
                local ext = tostring(f):match("%.([^%.]+)$")
                if lms.allowed[string.lower(ext or "")] then out[#out+1]=name end end
            return table.unpack(out) end
        function lms.swap(sound, file)
            local ok, id = pcall(getcustomasset, lms.path..file)
            if not ok then logError(id,2012); return end
            lms.timePosition = sound.TimePosition
            if not lms.oldSoundId then
                lms.oldSoundId = sound.SoundId; lms.lastSoundObject = sound
            elseif sound ~= lms.lastSoundObject then
                lms.oldSoundId = sound.SoundId; lms.lastSoundObject = sound
                sound.SoundId = id; sound:Stop(); sound:Play()
                sound.TimePosition = lms.timePosition; return true end
            sound.SoundId = id; sound:Stop(); sound:Play()
            sound.TimePosition = lms.timePosition; return true end

        local PremSect = TabSupport:Section({Title="Custom LMS", Box=true, Opened=false})
        PremSect:Paragraph({Title="Put LMS themes in "..lms.path,
            Desc="Supported: mp3, ogg, wav",Image="rbxassetid://70550617164319",ImageSize=24})
        local lmsDropdown = PremSect:Dropdown({Title="Theme",Values={"Default",lms.refresh()},Default="Default",
            Callback=function(v)
                local choice = type(v)=="table" and v[1] or v
                while lms.processing do task.wait() end
                lms.processing = true
                lms.song = choice
                if choice ~= "Default" then
                    local th = workspace.Themes:FindFirstChild(lms.name)
                    if th then lms.swap(th, choice) end
                    if not lms.connection then
                        lms.connection = workspace.Themes.ChildAdded:Connect(function(o)
                            if not lms.connection then return end
                            if o.Name==lms.name then
                                repeat task.wait() until o.SoundId~="" or not o.Parent
                                lms.swap(o, lms.song) end end) end
                    lms.processing = false
                    return end
                if lms.connection then lms.connection:Disconnect(); lms.connection=nil end
                local th = workspace.Themes:FindFirstChild(lms.name)
                if th and lms.oldSoundId then
                    lms.timePosition = th.TimePosition; th.SoundId = lms.oldSoundId
                    th:Stop(); th:Play(); th.TimePosition = lms.timePosition
                    lms.oldSoundId = nil end
                lms.processing = false end})
        PremSect:Button({Title="Refresh",Callback=function()
            lmsDropdown:Refresh({"Default",lms.refresh()}) end})
    else
        TabSupport:Section({Title="Custom LMS", Box=true, Opened=false}):Paragraph({
            Title="Filesystem unsupported",Desc="Your executor cannot load custom files."})
    end

    -- Block generator animation
    local genAnimConn
    TabSupport:Section({Title="Generator", Box=true, Opened=true}):Toggle({
        Title="Block generator animation",Default=false,Callback=function(v)
            if v then
                genAnimConn = RunService.Heartbeat:Connect(function()
                    combat.blockAnimations(combat.Generator) end)
            elseif genAnimConn then genAnimConn:Disconnect(); genAnimConn=nil end end})

    -- Better invisibility / Freeze position
    if caps.requiring then
        TabSupport:Section({Title="Stealth", Box=true, Opened=true}):Toggle({
            Title="Better invisibility",Default=false,Callback=function(v)
                if v then
                    netHook:AddTask("SpoofMovement",function(a)
                        if inLobby() then netHook.spoofed = false end
                        if a[2]=="UpdateCharacterPosition" and typeof(a[4])=="buffer" then
                            if netHook.spoofed then return "exit" end
                            netHook.spoofed = true
                            local ok, res, res2 = pcall(function()
                                return CharacterReplication.Deserialize(a[4]) end)
                            if ok and res then
                                a[4] = CharacterReplication.Serialize(res + Vector3.new(0,-100,0), res2) end
                        end end)
                else netHook:RemoveTask("SpoofMovement"); netHook.spoofed=nil end end})

        local pivot
        TabSupport:Section({Title="Stealth", Box=true, Opened=false}):Toggle({
            Title="Freeze position for other people",Default=false,Callback=function(v)
                if v then
                    repeat task.wait() until Character
                    pivot = Character:GetPivot()
                    netHook:AddTask("BlockMovement",function(a)
                        if a[2]=="UpdateCharacterPosition" and typeof(a[4])=="buffer" then
                            return "exit" end end)
                else
                    if Character and Character.Parent and Character.PrimaryPart then
                        if Character.Parent~=Spectating then Character:PivotTo(pivot) end
                        Character.PrimaryPart.Anchored = true
                        task.wait(1)
                        Character.PrimaryPart.Anchored = false end
                    netHook:RemoveTask("BlockMovement")
                    while true do task.wait()
                        if not Character then continue end
                        if Character.PrimaryPart then break end end end end})
    end
end

