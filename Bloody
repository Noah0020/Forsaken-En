local function AB_IsBlockReady()
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(Settings.AB_Mode == "007n7" and "Clone" or "Block")
    if btn then
        local cd = btn:FindFirstChild("CooldownTime")
        if cd then
            local t = cd.Text
            if t == nil or t == "" or t == " " then return true end
            return false
        end
    end
    return (tick() - (AB.lastBlock or 0)) >= (AB.BLOCK_COOLDOWN - 1)
end

local function AB_FireBlock()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    if buffer and buffer.fromstring then
        pcall(function() NetworkEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0"..name) }) end)
    end
    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(name)
    if btn and firesignal then
        local sig = btn:FindFirstChildOfClass("MouseButton1Click")
        if sig then pcall(firesignal, sig) end
    end
end

local function AB_FireSpam()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    local count = math.max(1, tonumber(Settings.AB_SpamCount) or 4)
    if buffer and buffer.fromstring then
        local buf = buffer.fromstring("\3\5\0\0\0"..name)
        for i = 1, count do
            task.spawn(function() pcall(function() NetworkEvent:FireServer("UseActorAbility", {buf}) end) end)
        end
    end
    local dur = tonumber(Settings.AB_SpamDuration) or 0.05
    if dur > 0 then
        task.spawn(function()
            local endT = tick() + dur
            while tick() < endT do
                pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
                task.wait(0.001)
            end
        end)
    end
end

local function AB_Fire() if Settings.AB_SpamEnabled then AB_FireSpam() else AB_FireBlock() end end

--═══ HDT (BodyVelocity + BodyGyro) ═══
local HDT = {
    running = false,
    debounce = false,
    lastUse = 0,
    COOLDOWN = 27,
    Speed = Settings.HDT_Speed,
    Duration = Settings.HDT_Duration,
    bindId = 0,
}

local function HDT_Fire(killer)
    if not Settings.HDT_Enabled then return end
    if HDT.debounce then return end
    if tick() - HDT.lastUse < HDT.COOLDOWN then return end
    if not killer or not killer.Parent then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local kr = killer:FindFirstChild("HumanoidRootPart")
    if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end

    HDT.debounce = true
    HDT.lastUse = tick()
    HDT.bindId = HDT.bindId + 1
    local bindName = "GS_HDT_" .. tostring(HDT.bindId)
    local startT = tick()
    local speed = HDT.Speed
    local duration = HDT.Duration
    local active = true

    local bv = Instance.new("BodyVelocity")
    bv.Name = "GS_HDT_BV"
    bv.MaxForce = Vector3.new(1e6, 0, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name = "GS_HDT_BG"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 3000
    bg.D = 500
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    local function stop()
        if not active then return end
        active = false
        HDT.debounce = false
        pcall(function() RunService:UnbindFromRenderStep(bindName) end)
        if bv and bv.Parent then bv:Destroy() end
        if bg and bg.Parent then bg:Destroy() end
    end

    RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health <= 0 then stop(); return end
        if not kr.Parent then stop(); return end
        if tick() - startT > duration then stop(); return end

        local toK = kr.Position - hrp.Position
        local flat = Vector3.new(toK.X, 0, toK.Z)
        if flat.Magnitude < 1 then stop(); return end

        if bv and bv.Parent then
            bv.Velocity = flat.Unit * speed
        end
        if bg and bg.Parent then
            bg.CFrame = CFrame.new(hrp.Position, Vector3.new(kr.Position.X, hrp.Position.Y, kr.Position.Z))
        end
    end)

    task.delay(duration + 0.3, stop)
end

local function HDT_SetSpeed(v) HDT.Speed = math.clamp(tonumber(v) or 40, 5, 500); Settings.HDT_Speed = HDT.Speed end
local function HDT_SetDuration(v) HDT.Duration = math.clamp(tonumber(v) or 0.6, 0.05, 3); Settings.HDT_Duration = HDT.Duration end

local function AB_TryFire(killer)
    local st = AB.perKiller[killer]
    if not st or st.pendingUntil <= 0 or tick() > st.pendingUntil then return end
    if not AB_IsBlockReady() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not hum or hum.Health <= 0 then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp or not hrp.Parent then return end
    if not AB_ShouldBlock(killer) then return end
    st.pendingUntil = 0; st.lastFireAt = tick(); AB.lastBlock = tick()
    AB_Fire()
    HDT_Fire(killer)
end

local function AB_OnAttributeChanged(killer)
    if not AB.running then return end
    local st = AB.perKiller[killer]; if not st then return end
    local aU = killer:GetAttribute("AbilitiesUsed") or 0
    if aU > st.lastUsed then st.lastUsed = aU; st.baitFlag = true end
    local aLU = killer:GetAttribute("AbilityLastUsed") or 0
    if aLU <= st.lastAbility then return end
    st.lastAbility = aLU
    if st.baitFlag then st.baitFlag = false; return end
    st.pendingUntil = tick() + Settings.AB_PendingWindow
    AB_TryFire(killer)
end

local function AB_HookKiller(killer)
    if not killer:IsA("Model") or AB.perKiller[killer] then return end
    local st = {
        lastAbility = killer:GetAttribute("AbilityLastUsed") or 0,
        lastUsed = killer:GetAttribute("AbilitiesUsed") or 0,
        baitFlag = false, pendingUntil = 0, lastFireAt = 0,
    }
    local ok, conn = pcall(function()
        return killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function() AB_OnAttributeChanged(killer) end)
    end)
    if ok and conn then st.signalConn = conn end
    AB.perKiller[killer] = st
end

local function AB_UnhookKiller(killer)
    local st = AB.perKiller[killer]
    if st and st.signalConn then pcall(function() st.signalConn:Disconnect() end) end
    AB.perKiller[killer] = nil
end

local function AB_FrameLoop()
    if not AB.running then return end
    local kf = GetKillersFolder(); if not kf then return end
    for _, killer in ipairs(kf:GetChildren()) do
        if killer:IsA("Model") and killer.Parent then
            if not AB.perKiller[killer] then AB_HookKiller(killer) end
            local st = AB.perKiller[killer]
            if st then
                local aU = killer:GetAttribute("AbilitiesUsed") or 0
                if aU > st.lastUsed then st.lastUsed = aU; st.baitFlag = true end
