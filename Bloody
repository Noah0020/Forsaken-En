                for _, a in ipairs(args) do ability = identifyAbility(a) if ability then break end end
                if not ability or not SilentAimCfg[ability] or not SilentAimCfg[ability].Enabled then return nil end
                local trg = getTargetForAbility(ability); if not trg then return nil end
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return nil end
                local aimPos = getAimPos(ability, trg)
                local out, anyMod = {}, false
                for i, a in ipairs(args) do
                    local nv, ch = rewriteValue(a, hrp.Position, aimPos)
                    out[i] = ch and nv or a; anyMod = anyMod or ch
                end
                if anyMod then return out end
                return nil
            end)
            if ok and newArgs then return old(self, table.unpack(newArgs)) end
            return old(self, ...)
        end)
    end)
end

